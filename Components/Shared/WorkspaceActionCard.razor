<a href="@Href"
   class="workspace-action-card">

    <div class="workspace-action-icon">
        <i class="@Icon"></i>
    </div>

    <div class="workspace-action-content">
        <div class="workspace-action-heading">
            <h5>@Title</h5>

            @if (BadgeCount > 0)
            {
                <span class="workspace-action-badge">
                    @FormatBadge(BadgeCount)
                </span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p>@Description</p>
        }
    </div>

    <div class="workspace-action-arrow">
        <i class="fas fa-chevron-right"></i>
    </div>
</a>

@code {
    [Parameter]
    public string Href { get; set; } = "#";

    [Parameter]
    public string Icon { get; set; } =
        "fas fa-circle";

    [Parameter]
    public string Title { get; set; } =
        string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public int BadgeCount { get; set; }

    private static string FormatBadge(int count)
    {
        return count > 99
            ? "99+"
            : count.ToString();
    }
}

<style>
    .workspace-action-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 15px;
        min-height: 118px;
        padding: 18px;
        color: inherit;
        text-decoration: none;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, 0.05);
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .workspace-action-card:hover {
            color: inherit;
            text-decoration: none;
            border-color: #c7d2fe;
            box-shadow: 0 12px 26px rgba(15, 23, 42, 0.1);
            transform: translateY(-3px);
        }

    .workspace-action-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 52px;
        width: 52px;
        height: 52px;
        color: #4338ca;
        background: #eef2ff;
        border-radius: 15px;
        font-size: 1.25rem;
    }

    .workspace-action-content {
        flex: 1;
        min-width: 0;
    }

    .workspace-action-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 6px;
    }

        .workspace-action-heading h5 {
            margin: 0;
            color: #0f172a;
            font-size: 1rem;
            font-weight: 800;
        }

    .workspace-action-content p {
        margin: 0;
        color: #64748b;
        font-size: 0.86rem;
        line-height: 1.5;
    }

    .workspace-action-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 24px;
        height: 24px;
        padding: 0 7px;
        color: #ffffff;
        background: #dc2626;
        border-radius: 999px;
        font-size: 0.73rem;
        font-weight: 800;
    }

    .workspace-action-arrow {
        flex-shrink: 0;
        color: #94a3b8;
        font-size: 0.88rem;
    }

    @@media (max-width: 576px) {
        .workspace-action-card {
            min-height: 104px;
            padding: 15px;
        }

        .workspace-action-icon {
            flex-basis: 46px;
            width: 46px;
            height: 46px;
            border-radius: 13px;
        }

        .workspace-action-content p {
            font-size: 0.8rem;
        }
    }
</style>