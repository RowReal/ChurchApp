@page "/Offering/report"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services

@inject AuthService AuthService
@inject ChurchOfferingService OfferingService
@inject ChurchOfferingAccessService OfferingAccessService
@inject NavigationManager Navigation

<PageTitle>Offering Report - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access offering reports.</p>
        <a href="/login" class="bcc-btn bcc-btn-primary">Go to Login</a>
    </div>
}
else if (isLoading)
{
    <div class="worker360-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-4">
                <div class="spinner-border text-primary"></div>
                <div class="mt-2 text-muted">Loading offering report...</div>
            </div>
        </div>
    </div>
}
else if (!canViewReport)
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>
        <p>You are not authorised to view offering reports.</p>
        <button type="button"
                class="bcc-btn bcc-btn-primary"
                @onclick="GoBack">
            Return to Service Records
        </button>
    </div>
}
else
{
    <div class="worker360-page offering-report-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        <div class="bcc-page-header report-page-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-chart-bar me-2"></i>
                    Offering Management
                </div>

                <div class="bcc-page-title">Offering Report</div>

                <div class="bcc-page-subtitle">
                    Search and review offering records.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        @onclick="RefreshReport">
                    <i class="fas fa-sync-alt me-2"></i>
                    Refresh
                </button>

                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        @onclick="GoBack">
                    <i class="fas fa-arrow-left me-2"></i>
                    Back
                </button>
            </div>
        </div>

        <div class="bcc-card mb-3 compact-filter-card">
            <div class="bcc-card-body p-3">

                <div class="compact-filter-heading">
                    <h6>Search Filters</h6>

                    <button type="button"
                            class="btn btn-sm btn-link text-decoration-none"
                            @onclick="ToggleMoreFilters">
                        @(showMoreFilters ? "Hide More Filters" : "More Filters")
                    </button>
                </div>

                <div class="row g-2">

                    <div class="col-6 col-md-3">
                        <label class="form-label compact-label">Date From</label>
                        <InputDate class="form-control form-control-sm"
                                   @bind-Value="filter.DateFrom" />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label compact-label">Date To</label>
                        <InputDate class="form-control form-control-sm"
                                   @bind-Value="filter.DateTo" />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label compact-label">Service</label>
                        <InputSelect class="form-select form-select-sm"
                                     @bind-Value="filter.ServiceId">
                            <option value="">All Services</option>
                            @foreach (var service in services)
                            {
                                <option value="@service.Id">@service.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label compact-label">Offering Type</label>
                        <InputSelect class="form-select form-select-sm"
                                     @bind-Value="filter.OfferingTypeId">
                            <option value="">All Types</option>
                            @foreach (var type in offeringTypes)
                            {
                                <option value="@type.Id">@type.Name</option>
                            }
                        </InputSelect>
                    </div>

                    @if (showMoreFilters)
                    {
                        <div class="col-6 col-md-3">
                            <label class="form-label compact-label">Currency</label>
                            <InputSelect class="form-select form-select-sm"
                                         @bind-Value="filter.Currency">
                                <option value="">All Currencies</option>
                                <option value="NGN">NGN</option>
                                <option value="USD">USD</option>
                                <option value="GBP">GBP</option>
                                <option value="EUR">EUR</option>
                            </InputSelect>
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label compact-label">Payment Mode</label>
                            <InputSelect class="form-select form-select-sm"
                                         @bind-Value="filter.PaymentMode">
                                <option value="">All Modes</option>
                                <option value="Cash">Cash</option>
                                <option value="Transfer">Bank Transfer</option>
                                <option value="POS">POS</option>
                                <option value="Cheque">Cheque</option>
                                <option value="Mixed">Mixed Payment</option>
                            </InputSelect>
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label compact-label">Status</label>
                            <InputSelect class="form-select form-select-sm"
                                         @bind-Value="filter.Status">
                                <option value="">All Statuses</option>
                                <option value="PendingApproval">Pending Approval</option>
                                <option value="Approved">Approved</option>
                                <option value="ReturnedForCorrection">Returned</option>
                                <option value="Removed">Removed</option>
                            </InputSelect>
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="form-label compact-label">Recorder ID</label>
                            <InputText class="form-control form-control-sm"
                                       @bind-Value="filter.RecordedByWorkerId"
                                       placeholder="Worker ID" />
                        </div>

                        <div class="col-12 col-md-9">
                            <label class="form-label compact-label">General Search</label>
                            <InputText class="form-control form-control-sm"
                                       @bind-Value="filter.SearchText"
                                       placeholder="Service, type, recorder, payment or remarks" />
                        </div>

                        <div class="col-12 col-md-3 d-flex align-items-end">
                            <div class="form-check compact-check">
                                <InputCheckbox class="form-check-input"
                                               @bind-Value="filter.IncludeRemoved" />
                                <label class="form-check-label">
                                    Include removed
                                </label>
                            </div>
                        </div>
                    }

                    <div class="col-12 d-flex justify-content-end gap-2 pt-1">
                        <button type="button"
                                class="bcc-btn profile-form-secondary-btn compact-btn"
                                disabled="@isSearching"
                                @onclick="ClearFilters">
                            Clear
                        </button>

                        <button type="button"
                                class="bcc-btn bcc-btn-primary compact-btn"
                                disabled="@isSearching"
                                @onclick="SearchReport">
                            @if (isSearching)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Searching...</span>
                            }
                            else
                            {
                                <i class="fas fa-search me-2"></i>
                                <span>Search</span>
                            }
                        </button>
                    </div>

                </div>
            </div>
        </div>

        <div class="report-summary-strip mb-3">
            <div>
                <span>Total</span>
                <strong>@records.Count</strong>
            </div>

            <div>
                <span>Approved</span>
                <strong>@records.Count(x => x.Status == ChurchOfferingService.StatusApproved)</strong>
            </div>

            <div>
                <span>Pending</span>
                <strong>@records.Count(x => x.Status == ChurchOfferingService.StatusPendingApproval)</strong>
            </div>

            <div>
                <span>Returned</span>
                <strong>@records.Count(x => x.Status == ChurchOfferingService.StatusReturnedForCorrection)</strong>
            </div>

            @foreach (var total in GetCurrencyTotals())
            {
                <div class="currency-summary">
                    <span>@total.Currency</span>
                    <strong>@FormatAmount(total.Amount, total.Currency)</strong>
                </div>
            }
        </div>

        <div class="bcc-card">
            <div class="bcc-card-body p-3">

                <div class="result-heading">
                    <h6>Offering Records</h6>
                    <span>@records.Count record(s)</span>
                </div>

                @if (!records.Any())
                {
                    <div class="bcc-empty py-4">
                        <i class="fas fa-search"></i>
                        <h4>No Records Found</h4>
                        <p>No offering records match the selected filters.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 offering-report-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Service</th>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Payment</th>
                                    <th>Recorder</th>
                                    <th>Status</th>
                                    <th>Approval</th>
                                    <th class="text-end">View</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var record in records)
                                {
                                    <tr>
                                        <td>
                                            @(record.OfferingDate.ToString("dd MMM yyyy"))
                                        </td>

                                        <td>
                                            @(record.Service?.Name ?? "Not available")
                                        </td>

                                        <td>
                                            @(record.OfferingType?.Name ?? "Not available")
                                        </td>

                                        <td class="fw-bold">
                                            @FormatAmount(record.Amount, record.Currency)
                                        </td>

                                        <td>@record.PaymentMode</td>

                                        <td>
                                            @GetWorkerName(record.RecordedByWorker)
                                        </td>

                                        <td>
                                            <span class="@GetStatusClass(record.Status)">
                                                @FormatStatus(record.Status)
                                            </span>
                                        </td>

                                        <td>
                                            @if (record.Status == ChurchOfferingService.StatusApproved)
                                            {
                                                <div class="approval-info">
                                                    <strong>
                                                        @GetWorkerName(record.ApprovedByWorker)
                                                    </strong>

                                                    @if (record.ApprovedAt.HasValue)
                                                    {
                                                        <span>
                                                            @(record.ApprovedAt.Value
                                                                .ToLocalTime()
                                                                .ToString("dd MMM yyyy"))
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else if (record.Status ==
                                                     ChurchOfferingService.StatusReturnedForCorrection)
                                            {
                                                <span class="text-danger small">
                                                    Returned
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>

                                        <td class="text-end">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => OpenDetails(record)">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>
    </div>
}

@if (showDetailsPopup && selectedRecord != null)
{
    <div class="offering-popup-backdrop">
        <div class="offering-popup-card">

            <div class="offering-popup-header">
                <div>
                    <h4>Offering Details</h4>
                    <p>Full details of the selected offering.</p>
                </div>

                <button type="button"
                        class="btn-close"
                        @onclick="CloseDetails">
                </button>
            </div>

            <div class="offering-detail-grid">

                <div>
                    <span>Service</span>
                    <strong>
                        @(selectedRecord.Service?.Name ?? "Not available")
                    </strong>
                </div>

                <div>
                    <span>Offering Type</span>
                    <strong>
                        @(selectedRecord.OfferingType?.Name ?? "Not available")
                    </strong>
                </div>

                <div>
                    <span>Offering Date</span>
                    <strong>
                        @(selectedRecord.OfferingDate.ToString("dd MMMM yyyy"))
                    </strong>
                </div>

                <div>
                    <span>Amount</span>
                    <strong class="text-success">
                        @FormatAmount(selectedRecord.Amount, selectedRecord.Currency)
                    </strong>
                </div>

                <div>
                    <span>Payment Mode</span>
                    <strong>@selectedRecord.PaymentMode</strong>
                </div>

                <div>
                    <span>Status</span>
                    <strong>@FormatStatus(selectedRecord.Status)</strong>
                </div>

                <div>
                    <span>Recorded By</span>
                    <strong>
                        @GetWorkerName(selectedRecord.RecordedByWorker)
                    </strong>
                </div>

                <div>
                    <span>Recorded At</span>
                    <strong>
                        @(selectedRecord.RecordedAt
                            .ToLocalTime()
                            .ToString("dd MMM yyyy, hh:mm tt"))
                    </strong>
                </div>

                <div class="detail-wide">
                    <span>Remarks</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(selectedRecord.Remarks)
                            ? "None"
                            : selectedRecord.Remarks)
                    </strong>
                </div>

                @if (!string.IsNullOrWhiteSpace(selectedRecord.ReturnComment))
                {
                    <div class="detail-wide returned-detail">
                        <span>Return Comment</span>
                        <strong>@selectedRecord.ReturnComment</strong>
                    </div>
                }

                @if (selectedRecord.IsRemoved)
                {
                    <div class="detail-wide removed-detail">
                        <span>Removal Reason</span>
                        <strong>
                            @(selectedRecord.RemovalReason ?? "No reason provided")
                        </strong>
                    </div>
                }

            </div>
        </div>
    </div>
}

@code {
    private ChurchOfferingSearchFilter filter = new();

    private List<Service> services = new();
    private List<ChurchOfferingTypeN> offeringTypes = new();
    private List<ChurchOfferingRecord> records = new();

    private ChurchOfferingRecord? selectedRecord;

    private bool isLoading = true;
    private bool isSearching;
    private bool canViewReport;
    private bool showDetailsPopup;
    private bool showMoreFilters;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            if (AuthService.CurrentWorker == null)
            {
                canViewReport = false;
                return;
            }

            var workerId = AuthService.CurrentWorker.Id;

            canViewReport =
                await OfferingAccessService
                    .CanViewOfferingReportAsync(workerId);

            if (!canViewReport)
                return;

            services =
                await OfferingService.GetServicesAsync();

            offeringTypes =
                await OfferingService.GetActiveOfferingTypesAsync();

            records =
                await OfferingService.SearchOfferingsAsync(
                    filter,
                    workerId);
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load offering report: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchReport()
    {
        if (AuthService.CurrentWorker == null)
            return;

        if (filter.DateFrom.HasValue &&
            filter.DateTo.HasValue &&
            filter.DateTo.Value.Date < filter.DateFrom.Value.Date)
        {
            errorMessage =
                "Date To cannot be earlier than Date From.";
            return;
        }

        try
        {
            isSearching = true;
            errorMessage = null;

            records =
                await OfferingService.SearchOfferingsAsync(
                    filter,
                    AuthService.CurrentWorker.Id);
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to search offering records: {ex.Message}";
        }
        finally
        {
            isSearching = false;
        }
    }

    private async Task ClearFilters()
    {
        filter = new ChurchOfferingSearchFilter();
        await SearchReport();
    }

    private async Task RefreshReport()
    {
        await SearchReport();
    }

    private void ToggleMoreFilters()
    {
        showMoreFilters = !showMoreFilters;
    }

    private void OpenDetails(ChurchOfferingRecord record)
    {
        selectedRecord = record;
        showDetailsPopup = true;
    }

    private void CloseDetails()
    {
        showDetailsPopup = false;
        selectedRecord = null;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/workspace/service-records");
    }

    private IEnumerable<CurrencyTotal> GetCurrencyTotals()
    {
        return records
            .Where(x => !x.IsRemoved)
            .GroupBy(x => x.Currency)
            .Select(x => new CurrencyTotal
            {
                Currency = x.Key,
                Amount = x.Sum(y => y.Amount)
            })
            .OrderBy(x => x.Currency);
    }

    private static string GetWorkerName(Worker? worker)
    {
        if (worker == null)
            return "Not available";

        return $"{worker.FirstName} {worker.LastName}".Trim();
    }

    private static string FormatStatus(string status)
    {
        return status switch
        {
            "PendingApproval" => "Pending Approval",
            "Approved" => "Approved",
            "ReturnedForCorrection" => "Returned",
            "Removed" => "Removed",
            _ => status
        };
    }

    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "Approved" =>
                "offering-status offering-status-approved",

            "PendingApproval" =>
                "offering-status offering-status-pending",

            "ReturnedForCorrection" =>
                "offering-status offering-status-returned",

            "Removed" =>
                "offering-status offering-status-removed",

            _ => "offering-status"
        };
    }

    private static string FormatAmount(
        decimal amount,
        string currency)
    {
        var symbol = currency switch
        {
            "NGN" => "₦",
            "USD" => "$",
            "GBP" => "£",
            "EUR" => "€",
            _ => $"{currency} "
        };

        return $"{symbol}{amount:N2}";
    }

    private sealed class CurrencyTotal
    {
        public string Currency { get; set; } = string.Empty;
        public decimal Amount { get; set; }
    }
}

<style>
    .offering-report-page {
        max-width: 1400px;
        margin: 0 auto;
    }

    .report-page-header {
        margin-bottom: 14px;
    }

    .compact-filter-card {
        border-radius: 12px;
    }

    .compact-filter-heading,
    .result-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 10px;
    }

    .compact-filter-heading h6,
    .result-heading h6 {
        margin: 0;
        color: #0f172a;
        font-size: 0.9rem;
        font-weight: 800;
    }

    .result-heading span {
        color: #64748b;
        font-size: 0.75rem;
    }

    .compact-label {
        margin-bottom: 3px;
        color: #475569;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .compact-filter-card .form-control,
    .compact-filter-card .form-select {
        min-height: 32px;
        font-size: 0.78rem;
    }

    .compact-check {
        padding: 6px 8px 4px 28px;
        font-size: 0.78rem;
    }

    .compact-btn {
        min-height: 32px;
        padding: 6px 11px;
        font-size: 0.78rem;
    }

    .report-summary-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .report-summary-strip > div {
        min-width: 110px;
        padding: 9px 11px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 9px;
    }

    .report-summary-strip span {
        display: block;
        margin-bottom: 1px;
        color: #64748b;
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .report-summary-strip strong {
        color: #0f172a;
        font-size: 0.92rem;
        font-weight: 800;
    }

    .currency-summary {
        background: #f0fdf4 !important;
        border-color: #bbf7d0 !important;
    }

    .currency-summary strong {
        color: #166534;
    }

    .offering-report-table thead th {
        padding: 8px 9px;
        color: #475569;
        background: #f8fafc;
        font-size: 0.64rem;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .offering-report-table tbody td {
        padding: 8px 9px;
        font-size: 0.77rem;
        vertical-align: middle;
    }

    .approval-info strong,
    .approval-info span {
        display: block;
        font-size: 0.72rem;
    }

    .approval-info span {
        color: #64748b;
    }

    .offering-status {
        display: inline-flex;
        padding: 3px 7px;
        border-radius: 999px;
        font-size: 0.65rem;
        font-weight: 800;
    }

    .offering-status-approved {
        color: #166534;
        background: #dcfce7;
    }

    .offering-status-pending {
        color: #92400e;
        background: #fef3c7;
    }

    .offering-status-returned {
        color: #b91c1c;
        background: #fee2e2;
    }

    .offering-status-removed {
        color: #475569;
        background: #e2e8f0;
    }

    .offering-popup-backdrop {
        position: fixed;
        inset: 0;
        z-index: 4000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 14px;
        background: rgba(15, 23, 42, 0.58);
    }

    .offering-popup-card {
        width: 100%;
        max-width: 540px;
        max-height: 84vh;
        padding: 19px;
        overflow-y: auto;
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.24);
    }

    .offering-popup-header {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .offering-popup-header h4 {
        margin: 0 0 2px;
        font-size: 1rem;
        font-weight: 800;
    }

    .offering-popup-header p {
        margin: 0;
        color: #64748b;
        font-size: 0.75rem;
    }

    .offering-detail-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 7px;
    }

    .offering-detail-grid > div {
        padding: 8px 10px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
    }

    .offering-detail-grid span {
        display: block;
        margin-bottom: 2px;
        color: #64748b;
        font-size: 0.63rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .offering-detail-grid strong {
        color: #0f172a;
        font-size: 0.8rem;
        white-space: pre-wrap;
    }

    .detail-wide {
        grid-column: 1 / -1;
    }

    .returned-detail {
        border-left: 4px solid #dc2626 !important;
    }

    .removed-detail {
        border-left: 4px solid #64748b !important;
    }

    @@media (max-width: 768px) {
        .report-summary-strip > div {
            flex: 1 1 calc(50% - 8px);
        }

        .offering-detail-grid {
            grid-template-columns: 1fr;
        }

        .detail-wide {
            grid-column: auto;
        }

        .offering-report-table thead th,
        .offering-report-table tbody td {
            white-space: normal;
        }
    }

    @@media (max-width: 576px) {
        .report-summary-strip > div {
            flex-basis: 100%;
        }

        .offering-popup-card {
            max-width: 96vw;
            padding: 16px;
        }
    }
</style>
