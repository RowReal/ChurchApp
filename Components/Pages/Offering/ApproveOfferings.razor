@page "/Offering/approvals"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services

@inject AuthService AuthService
@inject ChurchOfferingService OfferingService
@inject ChurchOfferingAccessService OfferingAccessService
@inject NavigationManager Navigation

<PageTitle>Offering Approvals - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access offering approvals.</p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else if (isLoading)
{
    <div class="worker360-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-4">
                <div class="spinner-border text-primary"></div>
                <div class="mt-2 text-muted">
                    Loading offering approvals...
                </div>
            </div>
        </div>
    </div>
}
else if (!canApproveOffering)
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>
        <p>You do not have the Approve Offerings privilege.</p>

        <button type="button"
                class="bcc-btn bcc-btn-primary"
                @onclick="GoBack">
            Return to Dashboard
        </button>
    </div>
}
else
{
    <div class="worker360-page compact-approval-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success py-2">
                <i class="fas fa-check-circle me-2"></i>
                @successMessage
            </div>
        }

        <div class="bcc-page-header compact-page-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-check-double me-2"></i>
                    Offering Management
                </div>

                <div class="bcc-page-title">
                    Offering Approvals
                </div>

                <div class="bcc-page-subtitle">
                    Review offerings awaiting approval.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn"
                        @onclick="RefreshPage">
                    <i class="fas fa-sync-alt me-2"></i>
                    Refresh
                </button>

                <button type="button"
                        class="bcc-btn profile-form-secondary-btn"
                        @onclick="GoBack">
                    <i class="fas fa-arrow-left me-2"></i>
                    Back
                </button>
            </div>
        </div>

        <div class="offering-approval-summary mb-3">

            <div class="offering-approval-summary-card">
                <div class="summary-icon pending">
                    <i class="fas fa-hourglass-half"></i>
                </div>

                <div>
                    <span>Pending Approval</span>
                    <strong>@pendingRecords.Count</strong>
                </div>
            </div>

            <div class="offering-approval-summary-card">
                <div class="summary-icon amount">
                    <i class="fas fa-money-bill-wave"></i>
                </div>

                <div>
                    <span>Pending NGN Total</span>
                    <strong>
                        @FormatAmount(
                            pendingRecords
                                .Where(x => x.Currency == "NGN")
                                .Sum(x => x.Amount),
                            "NGN")
                    </strong>
                </div>
            </div>

        </div>

        <div class="bcc-card">
            <div class="bcc-card-body p-3">

                <div class="row g-2 mb-3">

                    <div class="col-md-4">
                        <label class="form-label fw-bold small mb-1">
                            Date From
                        </label>

                        <InputDate class="form-control form-control-sm"
                                   @bind-Value="dateFrom" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold small mb-1">
                            Date To
                        </label>

                        <InputDate class="form-control form-control-sm"
                                   @bind-Value="dateTo" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold small mb-1">
                            Search
                        </label>

                        <InputText class="form-control form-control-sm"
                                   @bind-Value="searchText"
                                   placeholder="Service, type or recorder" />
                    </div>

                    <div class="col-12 d-flex justify-content-end gap-2 mt-2">
                        <button type="button"
                                class="bcc-btn profile-form-secondary-btn compact-btn"
                                @onclick="ClearFilters">
                            Clear
                        </button>

                        <button type="button"
                                class="bcc-btn bcc-btn-primary compact-btn"
                                @onclick="ApplyFilters">
                            <i class="fas fa-search me-2"></i>
                            Search
                        </button>
                    </div>

                </div>

                @if (!filteredRecords.Any())
                {
                    <div class="bcc-empty py-4">
                        <i class="fas fa-check-circle"></i>
                        <h4>No Pending Offerings</h4>
                        <p>There are currently no offering records waiting for approval.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 offering-approval-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Service</th>
                                    <th>Offering Type</th>
                                    <th>Amount</th>
                                    <th>Payment</th>
                                    <th>Recorded By</th>
                                    <th>Recorded At</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var record in filteredRecords)
                                {
                                    <tr>
                                        <td>
                                            @(record.OfferingDate.ToString("dd MMM yyyy"))
                                        </td>

                                        <td>
                                            @(record.Service?.Name ?? "Not available")
                                        </td>

                                        <td>
                                            @(record.OfferingType?.Name ?? "Not available")
                                        </td>

                                        <td class="fw-bold">
                                            @FormatAmount(
                                                record.Amount,
                                                record.Currency)
                                        </td>

                                        <td>
                                            @record.PaymentMode
                                        </td>

                                        <td>
                                            @GetWorkerName(record.RecordedByWorker)
                                        </td>

                                        <td>
                                            @(record.RecordedAt
                                                .ToLocalTime()
                                                .ToString("dd MMM yyyy, hh:mm tt"))
                                        </td>

                                        <td class="text-end">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => OpenReview(record)">
                                                <i class="fas fa-eye me-1"></i>
                                                Review
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>
    </div>
}

@if (showReviewPopup && selectedRecord != null)
{
    <div class="offering-popup-backdrop">
        <div class="offering-popup-card">

            <div class="offering-popup-header">
                <div>
                    <h4>Review Offering</h4>
                    <p>Review the offering details before taking action.</p>
                </div>

                <button type="button"
                        class="btn-close"
                        @onclick="ClosePopup">
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(popupErrorMessage))
            {
                <div class="alert alert-danger py-2">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    @popupErrorMessage
                </div>
            }

            <div class="offering-detail-grid">

                <div>
                    <span>Service</span>
                    <strong>
                        @(selectedRecord.Service?.Name ?? "Not available")
                    </strong>
                </div>

                <div>
                    <span>Offering Type</span>
                    <strong>
                        @(selectedRecord.OfferingType?.Name ?? "Not available")
                    </strong>
                </div>

                <div>
                    <span>Offering Date</span>
                    <strong>
                        @(selectedRecord.OfferingDate
                            .ToString("dd MMMM yyyy"))
                    </strong>
                </div>

                <div>
                    <span>Amount</span>
                    <strong class="offering-amount">
                        @FormatAmount(
                            selectedRecord.Amount,
                            selectedRecord.Currency)
                    </strong>
                </div>

                <div>
                    <span>Payment Mode</span>
                    <strong>
                        @selectedRecord.PaymentMode
                    </strong>
                </div>

                <div>
                    <span>Recorded By</span>
                    <strong>
                        @GetWorkerName(selectedRecord.RecordedByWorker)
                    </strong>
                </div>

                <div>
                    <span>Recorded At</span>
                    <strong>
                        @(selectedRecord.RecordedAt
                            .ToLocalTime()
                            .ToString("dd MMM yyyy, hh:mm tt"))
                    </strong>
                </div>

                <div>
                    <span>Status</span>
                    <strong class="text-warning">
                        Pending Approval
                    </strong>
                </div>

                <div class="detail-wide">
                    <span>Remarks</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(selectedRecord.Remarks)
                            ? "None"
                            : selectedRecord.Remarks)
                    </strong>
                </div>

            </div>

            @if (showReturnSection)
            {
                <div class="return-section mt-3">
                    <label class="form-label fw-bold small">
                        Reason for Returning the Record
                        <span class="text-danger">*</span>
                    </label>

                    <InputTextArea class="form-control form-control-sm"
                                   rows="3"
                                   @bind-Value="returnComment"
                                   placeholder="Explain the correction required from the recorder." />

                    <div class="form-text small">
                        The original recorder will see this comment and can correct or remove the record.
                    </div>
                </div>
            }

            <div class="mt-3 d-flex justify-content-end gap-2 popup-actions">

                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        disabled="@isProcessing"
                        @onclick="ClosePopup">
                    Cancel
                </button>

                @if (!showReturnSection)
                {
                    <button type="button"
                            class="btn btn-outline-danger btn-sm"
                            disabled="@isProcessing"
                            @onclick="ShowReturnForm">
                        <i class="fas fa-reply me-2"></i>
                        Return
                    </button>

                    <button type="button"
                            class="btn btn-success btn-sm"
                            disabled="@isProcessing"
                            @onclick="ApproveSelectedOffering">

                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="fas fa-check me-2"></i>
                        }

                        Approve
                    </button>
                }
                else
                {
                    <button type="button"
                            class="bcc-btn profile-form-secondary-btn compact-btn"
                            disabled="@isProcessing"
                            @onclick="CancelReturn">
                        Back
                    </button>

                    <button type="button"
                            class="btn btn-danger btn-sm"
                            disabled="@isProcessing"
                            @onclick="ReturnSelectedOffering">

                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="fas fa-reply me-2"></i>
                        }

                        Confirm Return
                    </button>
                }

            </div>
        </div>
    </div>
}

@code {
    private List<ChurchOfferingRecord> pendingRecords = new();
    private List<ChurchOfferingRecord> filteredRecords = new();

    private ChurchOfferingRecord? selectedRecord;

    private DateTime? dateFrom;
    private DateTime? dateTo;
    private string searchText = string.Empty;
    private string returnComment = string.Empty;

    private bool isLoading = true;
    private bool isProcessing;
    private bool canApproveOffering;
    private bool showReviewPopup;
    private bool showReturnSection;

    private string? errorMessage;
    private string? successMessage;
    private string? popupErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            if (AuthService.CurrentWorker == null)
            {
                canApproveOffering = false;
                return;
            }

            var workerId = AuthService.CurrentWorker.Id;

            canApproveOffering =
                await OfferingAccessService
                    .CanApproveOfferingAsync(workerId);

            if (!canApproveOffering)
                return;

            pendingRecords =
                await OfferingService
                    .GetPendingApprovalsAsync(workerId);

            filteredRecords = pendingRecords.ToList();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load offering approvals: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<ChurchOfferingRecord> query =
            pendingRecords;

        if (dateFrom.HasValue)
        {
            query = query.Where(x =>
                x.OfferingDate.Date >=
                dateFrom.Value.Date);
        }

        if (dateTo.HasValue)
        {
            query = query.Where(x =>
                x.OfferingDate.Date <=
                dateTo.Value.Date);
        }

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var search = searchText.Trim();

            query = query.Where(x =>
                (x.Service?.Name?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                    ?? false) ||

                (x.OfferingType?.Name?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                    ?? false) ||

                (x.PaymentMode?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                    ?? false) ||

                (x.RecordedByWorker?.FirstName?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                    ?? false) ||

                (x.RecordedByWorker?.LastName?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                    ?? false));
        }

        filteredRecords = query
            .OrderBy(x => x.OfferingDate)
            .ThenBy(x => x.RecordedAt)
            .ToList();
    }

    private void ClearFilters()
    {
        dateFrom = null;
        dateTo = null;
        searchText = string.Empty;
        filteredRecords = pendingRecords.ToList();
    }

    private void OpenReview(
        ChurchOfferingRecord record)
    {
        selectedRecord = record;
        returnComment = string.Empty;
        popupErrorMessage = null;
        showReturnSection = false;
        showReviewPopup = true;
    }

    private void ShowReturnForm()
    {
        popupErrorMessage = null;
        returnComment = string.Empty;
        showReturnSection = true;
    }

    private void CancelReturn()
    {
        popupErrorMessage = null;
        returnComment = string.Empty;
        showReturnSection = false;
    }

    private async Task ApproveSelectedOffering()
    {
        if (selectedRecord == null ||
            AuthService.CurrentWorker == null)
        {
            return;
        }

        try
        {
            isProcessing = true;
            popupErrorMessage = null;

            await OfferingService.ApproveOfferingAsync(
                selectedRecord.Id,
                AuthService.CurrentWorker.Id,
                null);

            successMessage =
                $"The offering of {FormatAmount(selectedRecord.Amount, selectedRecord.Currency)} was approved successfully.";

            ClosePopup();
            await LoadPageAsync();
        }
        catch (Exception ex)
        {
            popupErrorMessage =
                $"Unable to approve offering: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ReturnSelectedOffering()
    {
        if (selectedRecord == null ||
            AuthService.CurrentWorker == null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(returnComment))
        {
            popupErrorMessage =
                "Please provide the reason for returning this offering.";

            return;
        }

        try
        {
            isProcessing = true;
            popupErrorMessage = null;

            await OfferingService
                .ReturnForCorrectionAsync(
                    selectedRecord.Id,
                    AuthService.CurrentWorker.Id,
                    returnComment);

            successMessage =
                "The offering record was returned to the recorder for correction.";

            ClosePopup();
            await LoadPageAsync();
        }
        catch (Exception ex)
        {
            popupErrorMessage =
                $"Unable to return offering: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        successMessage = null;
        await LoadPageAsync();
    }

    private void ClosePopup()
    {
        showReviewPopup = false;
        showReturnSection = false;
        selectedRecord = null;
        returnComment = string.Empty;
        popupErrorMessage = null;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/workspace/service-records");
    }

    private static string GetWorkerName(
        Worker? worker)
    {
        if (worker == null)
            return "Not available";

        return $"{worker.FirstName} {worker.LastName}".Trim();
    }

    private static string FormatAmount(
        decimal amount,
        string currency)
    {
        var symbol = currency switch
        {
            "NGN" => "₦",
            "USD" => "$",
            "GBP" => "£",
            "EUR" => "€",
            _ => $"{currency} "
        };

        return $"{symbol}{amount:N2}";
    }
}

<style>
    .compact-approval-page {
        max-width: 1400px;
        margin: 0 auto;
    }

    .compact-page-header {
        margin-bottom: 14px;
    }

    .offering-approval-summary {
        display: grid;
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .offering-approval-summary-card {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
    }

    .summary-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        font-size: 0.9rem;
    }

    .summary-icon.pending {
        color: #b45309;
        background: #fef3c7;
    }

    .summary-icon.amount {
        color: #166534;
        background: #dcfce7;
    }

    .offering-approval-summary-card span {
        display: block;
        margin-bottom: 2px;
        color: #64748b;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .offering-approval-summary-card strong {
        color: #0f172a;
        font-size: 1.05rem;
        font-weight: 800;
    }

    .compact-btn {
        min-height: 34px;
        padding: 7px 12px;
        font-size: 0.82rem;
    }

    .offering-approval-table thead th {
        padding: 10px;
        color: #475569;
        background: #f8fafc;
        font-size: 0.68rem;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .offering-approval-table tbody td {
        padding: 10px;
        font-size: 0.82rem;
        white-space: nowrap;
    }

    .offering-popup-backdrop {
        position: fixed;
        inset: 0;
        z-index: 4000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        background: rgba(15, 23, 42, 0.58);
    }

    .offering-popup-card {
        width: 100%;
        max-width: 620px;
        max-height: 85vh;
        padding: 22px;
        overflow-y: auto;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.24);
    }

    .offering-popup-header {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 14px;
    }

    .offering-popup-header h4 {
        margin: 0 0 2px;
        font-size: 1.1rem;
        font-weight: 800;
    }

    .offering-popup-header p {
        margin: 0;
        color: #64748b;
        font-size: 0.8rem;
    }

    .offering-detail-grid {
        display: grid;
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
        gap: 9px;
    }

    .offering-detail-grid > div {
        padding: 10px 12px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
    }

    .offering-detail-grid span {
        display: block;
        margin-bottom: 3px;
        color: #64748b;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .offering-detail-grid strong {
        color: #0f172a;
        font-size: 0.85rem;
        white-space: pre-wrap;
    }

    .detail-wide {
        grid-column: 1 / -1;
    }

    .offering-amount {
        color: #166534 !important;
        font-size: 0.95rem !important;
    }

    .return-section {
        padding: 14px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        border-radius: 10px;
    }

    @@media (max-width: 768px) {
        .offering-approval-summary,
        .offering-detail-grid {
            grid-template-columns: 1fr;
        }

        .detail-wide {
            grid-column: auto;
        }

        .offering-approval-table tbody td,
        .offering-approval-table thead th {
            white-space: normal;
        }
    }

    @@media (max-width: 576px) {
        .offering-popup-card {
            max-width: 96vw;
            padding: 18px;
        }

        .popup-actions {
            flex-direction: column;
        }

        .popup-actions .btn,
        .popup-actions .bcc-btn {
            width: 100%;
        }
    }
</style>
