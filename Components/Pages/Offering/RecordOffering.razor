@page "/Offering/record"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services

@inject AuthService AuthService
@inject ChurchOfferingService OfferingService
@inject ChurchOfferingAccessService OfferingAccessService
@inject NavigationManager Navigation

<PageTitle>Record Offering - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to record an offering.</p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else if (isLoading)
{
    <div class="worker360-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-4">
                <div class="spinner-border text-primary"></div>
                <div class="mt-2 text-muted">
                    Loading offering records...
                </div>
            </div>
        </div>
    </div>
}
else if (!canRecordOffering)
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>
        <p>
            You must belong to the Ushering Department and have
            the Access Offering privilege to record offerings.
        </p>

        <button type="button"
                class="bcc-btn bcc-btn-primary"
                @onclick="GoBack">
            Return to Service Records
        </button>
    </div>
}
else
{
    <div class="worker360-page offering-register-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        <div class="bcc-page-header offering-page-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-hand-holding-usd me-2"></i>
                    Service Records
                </div>

                <div class="bcc-page-title">
                    Offering Record
                </div>

                <div class="bcc-page-subtitle">
                    Record offerings and review your recent entries.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        @onclick="ClearForm">
                    <i class="fas fa-redo me-2"></i>
                    Reset
                </button>

                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        @onclick="GoBack">
                    <i class="fas fa-arrow-left me-2"></i>
                    Back
                </button>
            </div>
        </div>

        <div class="row g-3">

            <div class="col-12 col-xl-4">
                <div class="bcc-card h-100">
                    <div class="bcc-card-body p-3">

                        <div class="compact-section-heading">
                            <div>
                                <h6>
                                    <i class="fas fa-money-bill-wave me-2"></i>
                                    New Offering
                                </h6>

                                <p>
                                    Enter offering details for a church service.
                                </p>
                            </div>
                        </div>

                        @if (shouldAutoApprove)
                        {
                            <div class="compact-status-note auto-approved">
                                <i class="fas fa-check-circle"></i>
                                Auto-approved for Church Admin
                            </div>
                        }
                        else
                        {
                            <div class="compact-status-note pending">
                                <i class="fas fa-clock"></i>
                                Will be sent for approval
                            </div>
                        }

                        <EditForm Model="@offeringModel"
                                  OnValidSubmit="SubmitOffering">

                            <DataAnnotationsValidator />

                            <div class="row g-2 mt-1">

                                <div class="col-12">
                                    <label class="form-label compact-label">
                                        Service
                                        <span class="text-danger">*</span>
                                    </label>

                                    <InputSelect class="form-select form-select-sm"
                                                 @bind-Value="offeringModel.ServiceId">
                                        <option value="">
                                            Select Service
                                        </option>

                                        @foreach (var service in services)
                                        {
                                            <option value="@service.Id">
                                                @service.Name
                                            </option>
                                        }
                                    </InputSelect>

                                    <ValidationMessage For="@(() => offeringModel.ServiceId)" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label compact-label">
                                        Offering Type
                                        <span class="text-danger">*</span>
                                    </label>

                                    <InputSelect class="form-select form-select-sm"
                                                 @bind-Value="offeringModel.OfferingTypeId">
                                        <option value="">
                                            Select Offering Type
                                        </option>

                                        @foreach (var type in offeringTypes)
                                        {
                                            <option value="@type.Id">
                                                @type.Name
                                            </option>
                                        }
                                    </InputSelect>

                                    <ValidationMessage For="@(() => offeringModel.OfferingTypeId)" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label compact-label">
                                        Offering Date
                                        <span class="text-danger">*</span>
                                    </label>

                                    <InputDate class="form-control form-control-sm"
                                               @bind-Value="offeringModel.OfferingDate" />

                                    <ValidationMessage For="@(() => offeringModel.OfferingDate)" />
                                </div>

                                <div class="col-7">
                                    <label class="form-label compact-label">
                                        Amount
                                        <span class="text-danger">*</span>
                                    </label>

                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">
                                            @GetCurrencySymbol()
                                        </span>

                                        <InputNumber class="form-control"
                                                     @bind-Value="offeringModel.Amount"
                                                     placeholder="0.00" />
                                    </div>

                                    <ValidationMessage For="@(() => offeringModel.Amount)" />
                                </div>

                                <div class="col-5">
                                    <label class="form-label compact-label">
                                        Currency
                                    </label>

                                    <InputSelect class="form-select form-select-sm"
                                                 @bind-Value="offeringModel.Currency">
                                        <option value="NGN">NGN</option>
                                        <option value="USD">USD</option>
                                        <option value="GBP">GBP</option>
                                        <option value="EUR">EUR</option>
                                    </InputSelect>
                                </div>

                                <div class="col-12">
                                    <label class="form-label compact-label">
                                        Payment Mode
                                        <span class="text-danger">*</span>
                                    </label>

                                    <InputSelect class="form-select form-select-sm"
                                                 @bind-Value="offeringModel.PaymentMode">
                                        <option value="">
                                            Select Payment Mode
                                        </option>
                                        <option value="Cash">Cash</option>
                                        <option value="Transfer">Bank Transfer</option>
                                        <option value="POS">POS</option>
                                        <option value="Cheque">Cheque</option>
                                        <option value="Mixed">Mixed Payment</option>
                                    </InputSelect>

                                    <ValidationMessage For="@(() => offeringModel.PaymentMode)" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label compact-label">
                                        Remarks
                                        <span class="text-muted fw-normal">
                                            (Optional)
                                        </span>
                                    </label>

                                    <InputTextArea class="form-control form-control-sm"
                                                   rows="3"
                                                   @bind-Value="offeringModel.Remarks"
                                                   placeholder="Add a short note if required." />
                                </div>

                            </div>

                            <div class="offering-total-panel mt-3">
                                <span>Amount</span>
                                <strong>
                                    @FormatAmount(
                                    offeringModel.Amount,
                                                                offeringModel.Currency)
                            </strong>
                        </div>

                        <div class="mt-3 d-flex justify-content-end gap-2">

                            <button type="button"
                                    class="bcc-btn profile-form-secondary-btn compact-btn"
                                    disabled="@isSubmitting"
                                    @onclick="ClearForm">
                                Clear
                            </button>

                            <button type="submit"
                                    class="bcc-btn bcc-btn-primary compact-btn"
                                    disabled="@isSubmitting">

                                @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Recording...</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-save me-2"></i>
                                        <span>Record Offering</span>
                                    }

                                </button>

                            </div>

                        </EditForm>

                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-8">
                <div class="bcc-card">
                    <div class="bcc-card-body p-3">

                        <div class="offering-register-heading">
                            <div>
                                <h6>My Offering Register</h6>
                                <p>@filteredRecords.Count record(s)</p>
                            </div>

                            <div class="offering-search">
                                <i class="fas fa-search"></i>

                                <InputText class="form-control form-control-sm"
                                           @bind-Value="searchText"
                                           @bind-Value:event="oninput"
                                           placeholder="Search service, type or payment mode" />
                            </div>
                        </div>

                        <div class="offering-filter-row mb-3">

                            <div>
                                <label class="form-label compact-label">
                                    Date From
                                </label>

                                <InputDate class="form-control form-control-sm"
                                           @bind-Value="dateFrom" />
                            </div>

                            <div>
                                <label class="form-label compact-label">
                                    Date To
                                </label>

                                <InputDate class="form-control form-control-sm"
                                           @bind-Value="dateTo" />
                            </div>

                            <div>
                                <label class="form-label compact-label">
                                    Status
                                </label>

                                <select class="form-select form-select-sm"
                                        @bind="selectedStatus">
                                    <option value="">All Statuses</option>
                                    <option value="PendingApproval">Pending</option>
                                    <option value="Approved">Approved</option>
                                    <option value="ReturnedForCorrection">Returned</option>
                                    <option value="Removed">Removed</option>
                                </select>
                            </div>

                            <div class="offering-filter-actions">
                                <button type="button"
                                        class="bcc-btn profile-form-secondary-btn compact-btn"
                                        @onclick="ClearFilters">
                                    Clear
                                </button>

                                <button type="button"
                                        class="bcc-btn bcc-btn-primary compact-btn"
                                        @onclick="ApplyFilters">
                                    Search
                                </button>
                            </div>

                        </div>

                        @if (!filteredRecords.Any())
                        {
                            <div class="bcc-empty py-4">
                                <i class="fas fa-receipt"></i>
                                <h4>No Offering Records</h4>
                                <p>No records match the current search.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0 offering-register-table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Service</th>
                                            <th>Type</th>
                                            <th>Amount</th>
                                            <th>Payment</th>
                                            <th>Status</th>
                                            <th class="text-end">View</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var record in filteredRecords)
                                        {
                                            <tr>
                                                <td>
                                                    @(record.OfferingDate
                                                                                            .ToString("dd MMM yyyy"))
                                                                                                                 </td>

                                                <td>
                                                    @(record.Service?.Name
                                                                                            ?? "Not available")
                                                                                                           </td>

                                                <td>
                                                    @(record.OfferingType?.Name
                                                                                            ?? "Not available")
                                    </td>

                                                                                        <td class="fw-bold">
                                                                                            @FormatAmount(
                                                                                            record.Amount,
                                                                                            record.Currency)
                                    </td>

                                                <td>
                                                    @record.PaymentMode
                                                </td>

                                                <td>
                                                    <span class="@GetStatusClass(record.Status)">
                                                        @FormatStatus(record.Status)
                                                    </span>
                                                </td>

                                                <td class="text-end">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary"
                                                            @onclick="() => OpenDetails(record)">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                                                }
                                    </tbody>
                                </table>
                            </div>
                        }

                    </div>
                </div>
            </div>

        </div>
    </div>
}

@if (showDetailsPopup && selectedRecord != null)
{
    <div class="offering-popup-backdrop">
        <div class="offering-popup-card">

            <div class="offering-popup-header">
                <div>
                    <h4>Offering Details</h4>
                    <p>
                        @(selectedRecord.OfferingDate
                                            .ToString("dd MMMM yyyy"))
                                                                  </p>
                                                              </div>

                <button type="button"
                        class="btn-close"
                        @onclick="CloseDetails">
                </button>
            </div>

            <div class="offering-detail-grid">

                <div>
                    <span>Service</span>
                    <strong>
                        @(selectedRecord.Service?.Name
                                            ?? "Not available")
                                                           </strong>
                                                       </div>

                <div>
                    <span>Offering Type</span>
                    <strong>
                        @(selectedRecord.OfferingType?.Name
                                            ?? "Not available")
                </strong>
            </div>

                                    <div>
                                        <span>Amount</span>
                                        <strong class="text-success">
                                            @FormatAmount(
                                            selectedRecord.Amount,
                                            selectedRecord.Currency)
                                                                 </strong>
                                                             </div>

                <div>
                    <span>Payment Mode</span>
                    <strong>
                        @selectedRecord.PaymentMode
                    </strong>
                </div>

                <div>
                    <span>Status</span>
                    <strong>
                        @FormatStatus(selectedRecord.Status)
                    </strong>
                </div>

                <div>
                    <span>Recorded At</span>
                    <strong>
                        @(selectedRecord.RecordedAt
                                            .ToLocalTime()
                                            .ToString("dd MMM yyyy, hh:mm tt"))
                                                                           </strong>
                                                                       </div>

                <div class="detail-wide">
                    <span>Remarks</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(selectedRecord.Remarks)
                                            ? "None"
                                            : selectedRecord.Remarks)
                </strong>
            </div>

            @if (!string.IsNullOrWhiteSpace(selectedRecord.ReturnComment))
                {
                    <div class="detail-wide returned-detail">
                        <span>Return Comment</span>
                        <strong>@selectedRecord.ReturnComment</strong>
                    </div>
                }

            </div>
        </div>
    </div>
}

@if (showSuccessPopup)
{
    <div class="offering-popup-backdrop">
        <div class="result-popup-card">

            <div class="result-popup-icon">
                <i class="fas fa-check-circle"></i>
            </div>

            <h4>Offering Recorded</h4>
            <p>@popupMessage</p>

            <div class="d-flex justify-content-center gap-2">
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        @onclick="RecordAnother">
                    Record Another
                </button>

                <button type="button"
                        class="bcc-btn bcc-btn-primary compact-btn"
                        @onclick="ViewMyRecords">
                    Full Register
                </button>
            </div>

        </div>
    </div>
}

@code {
    private ChurchOfferingFormModel offeringModel =
        new()
        {
            OfferingDate = DateTime.Today,
            Currency = "NGN"
        };

    private List<Service> services = new();
    private List<ChurchOfferingTypeN> offeringTypes = new();

    private List<ChurchOfferingRecord> allRecords = new();
    private List<ChurchOfferingRecord> filteredRecords = new();

    private ChurchOfferingRecord? selectedRecord;

    private DateTime? dateFrom;
    private DateTime? dateTo;
    private string selectedStatus = string.Empty;
    private string searchText = string.Empty;

    private bool isLoading = true;
    private bool isSubmitting;
    private bool canRecordOffering;
    private bool shouldAutoApprove;
    private bool showSuccessPopup;
    private bool showDetailsPopup;

    private string? errorMessage;
    private string popupMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            if (AuthService.CurrentWorker == null)
            {
                canRecordOffering = false;
                return;
            }

            var workerId =
                AuthService.CurrentWorker.Id;

            canRecordOffering =
                await OfferingAccessService
                    .CanRecordOfferingAsync(workerId);

            if (!canRecordOffering)
                return;

            shouldAutoApprove =
                await OfferingAccessService
                    .ShouldAutoApproveAsync(workerId);

            services =
                await OfferingService.GetServicesAsync();

            offeringTypes =
                await OfferingService
                    .GetActiveOfferingTypesAsync();

            await ReloadMyRecordsAsync();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load offering records: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SubmitOffering()
    {
        if (isSubmitting)
            return;

        errorMessage = null;

        if (AuthService.CurrentWorker == null)
        {
            errorMessage =
                "Unable to identify the current worker.";
            return;
        }

        try
        {
            isSubmitting = true;

            var recordId =
                await OfferingService.RecordOfferingAsync(
                    offeringModel,
                    AuthService.CurrentWorker.Id);

            var savedRecord =
                await OfferingService.GetRecordByIdAsync(
                    recordId,
                    AuthService.CurrentWorker.Id);

            if (savedRecord?.Status ==
                ChurchOfferingService.StatusApproved)
            {
                popupMessage =
                    $"The offering of {FormatAmount(savedRecord.Amount, savedRecord.Currency)} " +
                    "was recorded and approved successfully.";
            }
            else
            {
                popupMessage =
                    $"The offering of {FormatAmount(savedRecord?.Amount, savedRecord?.Currency)} " +
                    "was recorded and sent for approval.";
            }

            await ReloadMyRecordsAsync();
            showSuccessPopup = true;
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to record offering: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ReloadMyRecordsAsync()
    {
        if (AuthService.CurrentWorker == null)
            return;

        allRecords =
            await OfferingService.GetMyRecordsAsync(
                AuthService.CurrentWorker.Id);

        ApplyFilters();
    }

    private void ApplyFilters()
    {
        IEnumerable<ChurchOfferingRecord> query =
            allRecords;

        if (dateFrom.HasValue)
        {
            query = query.Where(x =>
                x.OfferingDate.Date >=
                dateFrom.Value.Date);
        }

        if (dateTo.HasValue)
        {
            query = query.Where(x =>
                x.OfferingDate.Date <=
                dateTo.Value.Date);
        }

        if (!string.IsNullOrWhiteSpace(selectedStatus))
        {
            query = query.Where(x =>
                x.Status == selectedStatus);
        }

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var search = searchText.Trim();

            query = query.Where(x =>
                (x.Service?.Name?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                    ?? false) ||

                (x.OfferingType?.Name?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                    ?? false) ||

                (x.PaymentMode?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                    ?? false) ||

                (x.Remarks?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                    ?? false));
        }

        filteredRecords = query
            .OrderByDescending(x => x.OfferingDate)
            .ThenByDescending(x => x.RecordedAt)
            .ToList();
    }

    private void ClearFilters()
    {
        dateFrom = null;
        dateTo = null;
        selectedStatus = string.Empty;
        searchText = string.Empty;
        filteredRecords = allRecords.ToList();
    }

    private void OpenDetails(
        ChurchOfferingRecord record)
    {
        selectedRecord = record;
        showDetailsPopup = true;
    }

    private void CloseDetails()
    {
        showDetailsPopup = false;
        selectedRecord = null;
    }

    private void ClearForm()
    {
        offeringModel =
            new ChurchOfferingFormModel
            {
                OfferingDate = DateTime.Today,
                Currency = "NGN"
            };

        errorMessage = null;
    }

    private void RecordAnother()
    {
        showSuccessPopup = false;
        ClearForm();
    }

    private void ViewMyRecords()
    {
        showSuccessPopup = false;
        Navigation.NavigateTo("/Offering/my-records");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/workspace/service-records");
    }

    private string GetCurrencySymbol()
    {
        return offeringModel.Currency switch
        {
            "NGN" => "₦",
            "USD" => "$",
            "GBP" => "£",
            "EUR" => "€",
            _ => offeringModel.Currency
        };
    }

    private static string FormatStatus(
        string status)
    {
        return status switch
        {
            "PendingApproval" => "Pending",
            "Approved" => "Approved",
            "ReturnedForCorrection" => "Returned",
            "Removed" => "Removed",
            _ => status
        };
    }

    private static string GetStatusClass(
        string status)
    {
        return status switch
        {
            "Approved" =>
                "offering-status offering-status-approved",

            "PendingApproval" =>
                "offering-status offering-status-pending",

            "ReturnedForCorrection" =>
                "offering-status offering-status-returned",

            "Removed" =>
                "offering-status offering-status-removed",

            _ => "offering-status"
        };
    }

    private static string FormatAmount(
        decimal? amount,
        string? currency)
    {
        if (!amount.HasValue)
            return "Not entered";

        var symbol = currency switch
        {
            "NGN" => "₦",
            "USD" => "$",
            "GBP" => "£",
            "EUR" => "€",
            _ => $"{currency} "
        };

        return $"{symbol}{amount.Value:N2}";
    }
}

<style>
    .offering-register-page {
        max-width: 1450px;
        margin: 0 auto;
    }

    .offering-page-header {
        margin-bottom: 14px;
    }

    .compact-btn {
        min-height: 32px;
        padding: 6px 11px;
        font-size: 0.78rem;
    }

    .compact-section-heading,
    .offering-register-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

        .compact-section-heading h6,
        .offering-register-heading h6 {
            margin: 0 0 2px;
            color: #0f172a;
            font-size: 0.9rem;
            font-weight: 800;
        }

        .compact-section-heading p,
        .offering-register-heading p {
            margin: 0;
            color: #64748b;
            font-size: 0.72rem;
        }

    .compact-label {
        margin-bottom: 3px;
        color: #475569;
        font-size: 0.69rem;
        font-weight: 700;
    }

    .offering-register-page .form-control,
    .offering-register-page .form-select {
        min-height: 32px;
        font-size: 0.78rem;
    }

    .compact-status-note {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 10px;
        padding: 7px 9px;
        border-radius: 8px;
        font-size: 0.7rem;
        font-weight: 700;
    }

        .compact-status-note.auto-approved {
            color: #166534;
            background: #dcfce7;
        }

        .compact-status-note.pending {
            color: #92400e;
            background: #fef3c7;
        }

    .offering-total-panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 12px;
        color: #ffffff;
        background: #0f172a;
        border-radius: 9px;
    }

        .offering-total-panel span {
            font-size: 0.72rem;
            font-weight: 700;
        }

        .offering-total-panel strong {
            font-size: 1rem;
        }

    .offering-search {
        position: relative;
        width: 100%;
        max-width: 300px;
    }

        .offering-search > i {
            position: absolute;
            top: 50%;
            left: 11px;
            z-index: 2;
            color: #94a3b8;
            transform: translateY(-50%);
        }

        .offering-search .form-control {
