</style>

@code {
    private List<ServiceNote> allServiceNotes = new();
    private List<ServiceNote> filteredNotes = new();
    private List<Service> allServices = new();

    private bool isLoading = true;
    private bool isAuthorized = false;
    private bool isAccessChecked = false;

    private string filterStartDateString = "";
    private string filterEndDateString = "";
    private int filterServiceId = 0;

    private bool hasFilters =>
        !string.IsNullOrEmpty(filterStartDateString) ||
        !string.IsNullOrEmpty(filterEndDateString) ||
        filterServiceId > 0;

    protected override async Task OnInitializedAsync()
    {
        var worker = AuthService.CurrentWorker;

        if (worker == null)
        {
            isAuthorized = false;
            isAccessChecked = true;
            isLoading = false;
            return;
        }

        isAuthorized =
            await PrivilegeService.HasPrivilegeAsync(
                worker.Id,
                "Access-Service-Notes");

        isAccessChecked = true;

        if (!isAuthorized)
        {
            isLoading = false;
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        try
        {
            allServices =
                await ServiceService.GetActiveServicesAsync();

            allServiceNotes =
                await ServiceNoteService.GetAllServiceNotesAsync();

            allServiceNotes = allServiceNotes
                .OrderByDescending(n => n.ServiceDate)
                .ToList();

            filteredNotes = allServiceNotes.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error loading service notes: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        isLoading = true;

        await Task.Delay(100);

        try
        {
            var query = allServiceNotes.AsQueryable();

            if (!string.IsNullOrEmpty(filterStartDateString) &&
                DateTime.TryParse(
                    filterStartDateString,
                    out var startDate))
            {
                query = query.Where(
                    n => n.ServiceDate >= startDate);
            }

            if (!string.IsNullOrEmpty(filterEndDateString) &&
                DateTime.TryParse(
                    filterEndDateString,
                    out var endDate))
            {
                query = query.Where(
                    n => n.ServiceDate <= endDate);
            }

            if (filterServiceId > 0)
            {
                query = query.Where(
                    n => n.ServiceId == filterServiceId);
            }

            filteredNotes = query.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error applying service note filters: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetFilters()
    {
        filterStartDateString = "";
        filterEndDateString = "";
        filterServiceId = 0;

        filteredNotes = allServiceNotes.ToList();
    }

    private void AddNewNote()
    {
        Navigation.NavigateTo("/Offering/CreateNote");
    }

    private void ViewNote(int id)
    {
        Navigation.NavigateTo($"/Offering/ViewNote/{id}");
    }

    private void EditNote(int id)
    {
        Navigation.NavigateTo($"/Offering/EditNote/{id}");
    }

    private bool CanEditNote(ServiceNote note)
    {
        if (AuthService.CurrentWorker == null)
            return false;

        return note.RecordedByWorkerId ==
               AuthService.CurrentWorker.Id;
    }

    private static string Shorten(
        string? value,
        int maximumLength)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "—";

        return value.Length <= maximumLength
            ? value
            : value[..maximumLength] + "...";
    }

    private static string GetFlowBadgeClass(
        string? serviceFlow)
    {
        return serviceFlow?.Trim().ToLowerInvariant() switch
        {
            "smooth" =>
                "sn-flow sn-flow-smooth",

            "delayed" =>
                "sn-flow sn-flow-delayed",

            "extended" =>
                "sn-flow sn-flow-extended",

            "rushed" =>
                "sn-flow sn-flow-rushed",

            _ =>
                "sn-flow sn-flow-other"
        };
    }
}