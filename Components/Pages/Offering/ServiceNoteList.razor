@page "/Offering/NoteList"
@using ChurchApp.Models
@using ChurchApp.Services
@inject ServiceNoteService ServiceNoteService
@inject ServiceService ServiceService
@inject AuthService AuthService
@inject PrivilegeService PrivilegeService
@inject NavigationManager Navigation

@if (!isAccessChecked)
{
    <div class="d-flex justify-content-center align-items-center py-5">
        <div class="spinner-border spinner-border-sm text-primary"
             role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!isAuthorized)
{
    <PageHero Title="Service Notes"
              Subtitle="View and manage notes recorded for church services."
              Kicker="Service Records"
              Icon="fas fa-clipboard-list" />

    <div class="alert alert-danger mt-3">
        <i class="fas fa-lock me-2"></i>
        You are not authorised to access Service Notes.
    </div>
}
else
{
    <PageHero Title="Service Notes"
              Subtitle="View and manage notes recorded for church services."
              Kicker="Service Records"
              Icon="fas fa-clipboard-list">

        <ActionContent>
            <button type="button"
                    class="btn btn-light"
                    @onclick="AddNewNote">
                <i class="fas fa-plus me-1"></i>
                Add Service Note
            </button>
        </ActionContent>

    </PageHero>

    <!-- Compact Filter Bar -->
    <div class="sn-filter-card">
        <div class="sn-filter-title">
            <i class="fas fa-filter"></i>
            <span>Filter Notes</span>
        </div>

        <div class="row g-2 align-items-end">
            <div class="col-12 col-sm-6 col-lg-3">
                <label for="startDate" class="form-label">From Date</label>
                <input type="date"
                       id="startDate"
                       class="form-control form-control-sm"
                       value="@filterStartDateString"
                       @onchange="@(async (e) =>
                       {
                           filterStartDateString = e.Value?.ToString() ?? "";
                           await ApplyFilters();
                       })" />
              </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <label for="endDate" class="form-label">To Date</label>
                <input type="date"
                       id="endDate"
                       class="form-control form-control-sm"
                       value="@filterEndDateString"
                       @onchange="@(async (e) =>
                       {
                           filterEndDateString = e.Value?.ToString() ?? "";
                           await ApplyFilters();
                       })" />
              </div>

            <div class="col-12 col-sm-8 col-lg-4">
                <label for="serviceFilter" class="form-label">Service</label>
                <select id="serviceFilter"
                        class="form-select form-select-sm"
                        value="@filterServiceId"
                        @onchange="@(async (e) =>
                        {
                            if (int.TryParse(e.Value?.ToString(), out var id))
                                filterServiceId = id;
                            else
                                filterServiceId = 0;

                            await ApplyFilters();
                        })">
                      <option value="0">All Services</option>

                    @foreach (var service in allServices)
                    {
                        <option value="@service.Id">
                            @service.Name
                        </option>
                    }
                </select>
            </div>

            <div class="col-12 col-sm-4 col-lg-2">
                <button type="button"
                        class="btn btn-outline-secondary btn-sm w-100"
                        @onclick="ResetFilters">
                    <i class="fas fa-rotate-left me-1"></i>
                    Reset
                </button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="sn-state">
            <div class="spinner-border spinner-border-sm text-primary"
                 role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <span>Loading service notes...</span>
        </div>
    }
    else if (!filteredNotes.Any())
    {
        <div class="sn-empty">
            <div class="sn-empty-icon">
                <i class="fas fa-clipboard"></i>
            </div>

            <div>
                <strong>No service notes found</strong>
                <div>
                    @(hasFilters
                                ? "Try adjusting or resetting the filters."
                                : "No service note has been recorded yet.")
        </div>
    </div>
</div>
    }
    else
    {
        <div class="sn-list-card">
            <div class="sn-list-header">
                <div>
                    <i class="fas fa-list-ul me-1"></i>
                    Service Notes
                </div>

                <span class="sn-count">
                    @filteredNotes.Count
                    @(filteredNotes.Count == 1 ? "record" : "records")
                </span>
            </div>

            <div class="table-responsive">
                <table class="table sn-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Service</th>
                            <th>Theme / Sermon</th>
                            <th>Minister</th>
                            <th>Flow</th>
                            <th>Recorded By</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var note in filteredNotes)
                        {
                            <tr>
                                <td class="sn-date-cell">
                                    <strong>
                                        @note.ServiceDate.ToString("dd MMM yyyy")
                                    </strong>
                                    <span>
                                        @note.ServiceDate.ToString("ddd")
                                    </span>
                                </td>

                                <td>
                                    <span class="sn-service-name">
                                        @(note.Service?.Name ?? "—")
                                    </span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(note.ThemeOrSermonTitle))
                                    {
                                        <span title="@note.ThemeOrSermonTitle">
                                            @Shorten(note.ThemeOrSermonTitle, 32)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(note.MinisterOrGuestSpeaker))
                                    {
                                        <span>
                                            @Shorten(note.MinisterOrGuestSpeaker, 26)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    <span class="@GetFlowBadgeClass(note.ServiceFlow)">
                                        @note.ServiceFlow
                                    </span>
                                </td>

                                <td>
                                    <div class="sn-recorder">
                                        <i class="fas fa-user-circle"></i>
                                        <span>
                                            @(note.RecordedBy?.FullName ?? "—")
                                        </span>
                                    </div>
                                </td>

                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary sn-action-btn"
                                                title="View Service Note"
                                                @onclick="() => ViewNote(note.Id)">
                                            <i class="fas fa-eye"></i>
                                        </button>

                                        @if (CanEditNote(note))
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary sn-action-btn"
                                                    title="Edit Service Note"
                                                    @onclick="() => EditNote(note.Id)">
                                                <i class="fas fa-pen"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="sn-list-footer">
                Showing <strong>@filteredNotes.Count</strong>
                of <strong>@allServiceNotes.Count</strong> service notes

                @if (hasFilters)
                {
                    <span class="ms-1">with applied filters</span>
                }
            </div>
        </div>
    }
}

