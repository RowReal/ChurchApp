@page "/Offering/Attendance-record"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services

@inject AttendanceService AttendanceService
@inject AuthService AuthService
@inject ServiceService ServiceService
@inject ServiceRecordAccessService ServiceRecordAccessService
@inject NavigationManager Navigation

<PageTitle>Attendance Record - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>
            To access attendance records, you must have the
            Record Attendance privilege and either belong to the
            FIG Directorate or be a Church Administrator.
        </p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else if (isLoading)
{
    <div class="worker360-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-4">
                <div class="spinner-border text-primary"></div>
                <div class="mt-2 text-muted">
                    Loading attendance records...
                </div>
            </div>
        </div>
    </div>
}
else if (!canRecordAttendance)
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>
        <p>
            You need the Record Attendance privilege to access this page.
        </p>

        <button type="button"
                class="bcc-btn bcc-btn-primary"
                @onclick="GoBack">
            Return to Service Records
        </button>
    </div>
}
else
{
    <div class="worker360-page attendance-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

    <div class="bcc-page-header attendance-page-header">
        <div>
            <div class="bcc-page-subtitle">
                <i class="fas fa-users me-2"></i>
                Service Records
            </div>

            <div class="bcc-page-title">
                Attendance Record
            </div>

            <div class="bcc-page-subtitle">
                Record and manage church service attendance.
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="button"
                    class="bcc-btn profile-form-secondary-btn compact-btn"
                    @onclick="ResetForm">
                <i class="fas fa-redo me-2"></i>
                Reset
            </button>

            <button type="button"
                    class="bcc-btn profile-form-secondary-btn compact-btn"
                    @onclick="GoBack">
                <i class="fas fa-arrow-left me-2"></i>
                Back
            </button>
        </div>
    </div>

    <div class="row g-3">

        <div class="col-12 col-xl-4">
            <div class="bcc-card h-100">
                <div class="bcc-card-body p-3">

                    <div class="compact-section-heading">
                        <div>
                            <h6>
                                <i class="fas fa-user-plus me-2"></i>
                                @(isEditMode ? "Edit Attendance" : "New Attendance")
                            </h6>

                            <p>
                                @(isEditMode
                                                                ? "Update the selected record."
                                                                : "Enter attendance figures for a service.")
                            </p>
                        </div>
                    </div>

                        <div class="row g-2">

                            <div class="col-12">
                                <label class="form-label compact-label">
                                    Service
                                    <span class="text-danger">*</span>
                                </label>

                                <InputSelect class="form-select form-select-sm"
                                             @bind-Value="formModel.ServiceId">
                                    <option value="0">Select Service</option>

                                @foreach (var service in services)
                                    {
                                        <option value="@service.Id">
                                            @service.Name
                                        </option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-12">
                                <label class="form-label compact-label">
                                    Attendance Date
                                    <span class="text-danger">*</span>
                                </label>

                                <InputDate class="form-control form-control-sm"
                                           @bind-Value="formModel.AttendanceDate" />
                            </div>

                            <div class="col-6">
                                <label class="form-label compact-label">
                                    Men
                                </label>

                                <InputNumber class="form-control form-control-sm text-center"
                                             @bind-Value="formModel.Men"
                                             min="0" />
                            </div>

                            <div class="col-6">
                                <label class="form-label compact-label">
                                    Women
                                </label>

                                <InputNumber class="form-control form-control-sm text-center"
                                             @bind-Value="formModel.Women"
                                             min="0" />
                            </div>

                            <div class="col-6">
                                <label class="form-label compact-label">
                                    Teenagers
                                </label>

                                <InputNumber class="form-control form-control-sm text-center"
                                             @bind-Value="formModel.Teenagers"
                                             min="0" />
                            </div>

                            <div class="col-6">
                                <label class="form-label compact-label">
                                    Children
                                </label>

                                <InputNumber class="form-control form-control-sm text-center"
                                             @bind-Value="formModel.Children"
                                             min="0" />
                            </div>

                            <div class="col-12">
                                <label class="form-label compact-label">
                                    Notes
                                    <span class="text-muted fw-normal">
                                        (Optional)
                                    </span>
                                </label>

                                <InputTextArea class="form-control form-control-sm"
                                               rows="3"
                                               @bind-Value="formModel.Notes"
                                               placeholder="Add a short note if required." />
                            </div>

                        </div>

                        <div class="attendance-total-panel mt-3">
                            <span>Total Attendance</span>
                            <strong>@GetFormTotal()</strong>
                        </div>

                        <div class="mt-3 d-flex justify-content-end gap-2">

                            @if (isEditMode)
                            {
                                <button type="button"
                                        class="bcc-btn profile-form-secondary-btn compact-btn"
                                        disabled="@isSaving"
                                        @onclick="CancelEdit">
                                    Cancel
                                </button>
                            }

                            <button type="button"
                                    class="bcc-btn bcc-btn-primary compact-btn"
                                    disabled="@isSaving"
                                    @onclick="SaveAttendance">

                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <i class="fas fa-save me-2"></i>
                                    <span>@(isEditMode ? "Update" : "Save")</span>
                                }

                            </button>

                        </div>

                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-8">
                <div class="bcc-card">
                    <div class="bcc-card-body p-3">

                        <div class="attendance-register-heading">
                            <div>
                                <h6>Attendance Register</h6>
                                <p>@filteredRecords.Count record(s)</p>
                            </div>

                            <div class="attendance-search">
                                <i class="fas fa-search"></i>

                                <InputText class="form-control form-control-sm"
                                           @bind-Value="searchText"
                                           @bind-Value:event="oninput"
                                           placeholder="Search service, recorder or notes" />
                            </div>
                        </div>

                        <div class="attendance-filter-row mb-3">

                            <div>
                                <label class="form-label compact-label">Date From</label>
                                <InputDate class="form-control form-control-sm"
                                           @bind-Value="dateFrom" />
                            </div>

                            <div>
                                <label class="form-label compact-label">Date To</label>
                                <InputDate class="form-control form-control-sm"
                                           @bind-Value="dateTo" />
                            </div>

                            <div class="attendance-filter-actions">
                                <button type="button"
                                        class="bcc-btn profile-form-secondary-btn compact-btn"
                                        @onclick="ClearFilters">
                                    Clear
                                </button>

                                <button type="button"
                                        class="bcc-btn bcc-btn-primary compact-btn"
                                        @onclick="ApplyFilters">
                                    Search
                                </button>
                            </div>

                        </div>

                        @if (!filteredRecords.Any())
                        {
                            <div class="bcc-empty py-4">
                                <i class="fas fa-users"></i>
                                <h4>No Attendance Records</h4>
                                <p>No records match the current search.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0 attendance-table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Service</th>
                                            <th>Men</th>
                                            <th>Women</th>
                                            <th>Teens</th>
                                            <th>Children</th>
                                            <th>Total</th>
                                            <th>Recorder</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var record in filteredRecords)
                                        {
                                            <tr>
                                                <td>
                                                    @(record.AttendanceDate
                                                                                            .ToString("dd MMM yyyy"))
                                                                                                                 </td>

                                                <td>
                                                    @(record.Service?.Name
                                                                                            ?? record.ServiceName
                                                                                            ?? "Not available")
                                    </td>

                                                <td>@record.Men</td>
                                                <td>@record.Women</td>
                                                <td>@record.Teenagers</td>
                                                <td>@record.Children</td>

                                                <td>
                                                    <span class="attendance-total-badge">
                                                        @record.Total
                                                    </span>
                                                </td>

                                                <td>
                                                    @GetWorkerName(record.RecordedBy)
                                                </td>

                                                <td class="text-end">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary me-1"
                                                            title="View"
                                                            @onclick="() => OpenDetails(record)">
                                                        <i class="fas fa-eye"></i>
                                                    </button>

                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-warning me-1"
                                                            title="Edit"
                                                            @onclick="() => StartEdit(record)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>

                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Remove"
                                                            @onclick="() => OpenRemovePopup(record)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                                                }
                                    </tbody>
                                </table>
                            </div>
                        }

                    </div>
                </div>
            </div>

        </div>
    </div>
}

@if (showDetailsPopup && selectedRecord != null)
{
    <div class="attendance-popup-backdrop">
        <div class="attendance-popup-card">

            <div class="attendance-popup-header">
                <div>
                    <h4>Attendance Details</h4>
                    <p>
                        @(selectedRecord.AttendanceDate
                                            .ToString("dd MMMM yyyy"))
                                                                  </p>
                                                              </div>

                <button type="button"
                        class="btn-close"
                        @onclick="ClosePopups">
                </button>
            </div>

            <div class="attendance-detail-grid">

                <div>
                    <span>Service</span>
                    <strong>
                        @(selectedRecord.Service?.Name
                                            ?? selectedRecord.ServiceName
                                            ?? "Not available")
                                                           </strong>
                                                       </div>

                <div>
                    <span>Total</span>
                    <strong class="text-success">
                        @selectedRecord.Total
                    </strong>
                </div>

                <div>
                    <span>Men</span>
                    <strong>@selectedRecord.Men</strong>
                </div>

                <div>
                    <span>Women</span>
                    <strong>@selectedRecord.Women</strong>
                </div>

                <div>
                    <span>Teenagers</span>
                    <strong>@selectedRecord.Teenagers</strong>
                </div>

                <div>
                    <span>Children</span>
                    <strong>@selectedRecord.Children</strong>
                </div>

                <div>
                    <span>Recorded By</span>
                    <strong>
                        @GetWorkerName(selectedRecord.RecordedBy)
                    </strong>
                </div>

                <div>
                    <span>Recorded At</span>
                    <strong>
                        @(selectedRecord.RecordedDate
                                            .ToLocalTime()
                                            .ToString("dd MMM yyyy, hh:mm tt"))
                                                                           </strong>
                                                                       </div>

                <div class="detail-wide">
                    <span>Notes</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(selectedRecord.Notes)
                                            ? "None"
                                            : selectedRecord.Notes)
                </strong>
            </div>

            </div>

        </div>
    </div>
}

@if (showRemovePopup && selectedRecord != null)
{
    <div class="attendance-popup-backdrop">
        <div class="attendance-popup-card remove-popup">

            <div class="remove-popup-icon">
                <i class="fas fa-exclamation-triangle"></i>
            </div>

            <h4>Remove Attendance Record?</h4>

            <p>
                This will permanently remove the attendance record for
                <strong>
                    @(selectedRecord.Service?.Name
                                    ?? selectedRecord.ServiceName
                                    ?? "this service")
                                                  </strong>
                                                  on
                                                  <strong>
                    @(selectedRecord.AttendanceDate
                                    .ToString("dd MMM yyyy"))
            </strong>.
        </p>

            <div class="mt-3 d-flex justify-content-center gap-2">
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        disabled="@isRemoving"
                        @onclick="ClosePopups">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-danger btn-sm"
                        disabled="@isRemoving"
                        @onclick="RemoveRecord">

                @if (isRemoving)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Removing...</span>
                    }
                    else
                    {
                        <i class="fas fa-trash me-2"></i>
                        <span>Remove</span>
                    }

                </button>
            </div>

        </div>
    </div>
}

@if (showResultPopup)
{
    <div class="attendance-popup-backdrop">
        <div class="result-popup-card">

            <div class="result-popup-icon
                            @(resultPopupSuccess ? "success" : "error")">
                <i class="fas
                        @(resultPopupSuccess
                                           ? "fa-check-circle"
                                           : "fa-exclamation-circle")">
            </i>
        </div>

            <h4>@resultPopupTitle</h4>
            <p>@resultPopupMessage</p>

            <button type="button"
                    class="bcc-btn bcc-btn-primary compact-btn"
                    @onclick="CloseResultPopup">
                OK
            </button>

        </div>
    </div>
}

@code {
    private AttendanceRecord formModel = NewAttendanceRecord();

    private List<Service> services = new();
    private List<AttendanceRecord> allRecords = new();
    private List<AttendanceRecord> filteredRecords = new();

    private AttendanceRecord? selectedRecord;

    private bool isLoading = true;
    private bool isSaving;
    private bool isRemoving;
    private bool isEditMode;
    private bool canRecordAttendance;

    private bool showDetailsPopup;
    private bool showRemovePopup;
    private bool showResultPopup;
    private bool resultPopupSuccess;

    private int editingRecordId;

    private DateTime? dateFrom;
    private DateTime? dateTo;
    private string searchText = string.Empty;

    private string? errorMessage;
    private string resultPopupTitle = string.Empty;
    private string resultPopupMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            if (AuthService.CurrentWorker == null)
            {
                canRecordAttendance = false;
                return;
            }

            var worker = AuthService.CurrentWorker;

            var access =
                await ServiceRecordAccessService.GetAccessAsync(
                    worker.Id);

            canRecordAttendance =
                access.CanRecordAttendance &&
                (
                    IsFigDirectorate(worker) ||
                    IsChurchAdmin(worker)
                );

            if (!canRecordAttendance)
                return;

            services =
                await ServiceService.GetActiveServicesAsync();

            allRecords =
                (await AttendanceService.GetAllAttendanceAsync())
                    .OrderByDescending(x => x.AttendanceDate)
                    .ThenByDescending(x => x.RecordedDate)
                    .ToList();

            filteredRecords = allRecords.ToList();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load attendance records: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAttendance()
    {
        if (isSaving)
            return;

        if (!ValidateForm())
            return;

        if (AuthService.CurrentWorker == null)
        {
            errorMessage =
                "Unable to identify the current worker.";
            return;
        }

        try
        {
            isSaving = true;
            errorMessage = null;

            var selectedService =
                services.FirstOrDefault(x =>
                    x.Id == formModel.ServiceId);

            if (selectedService == null)
            {
                throw new Exception(
                    "The selected service could not be found.");
            }

            var duplicateExists =
                allRecords.Any(x =>
                    x.Id != editingRecordId &&
                    x.ServiceId == formModel.ServiceId &&
                    x.AttendanceDate.Date ==
                    formModel.AttendanceDate.Date);

            if (duplicateExists)
            {
                throw new Exception(
                    "Attendance has already been recorded for this service and date.");
            }

            formModel.ServiceName =
                selectedService.Name;

            if (isEditMode)
            {
                formModel.Id = editingRecordId;

                var success =
                    await AttendanceService
                        .UpdateAttendanceAsync(formModel);

                if (!success)
                {
                    throw new Exception(
                        "The attendance record could not be updated.");
                }

                ShowResultPopup(
                    true,
                    "Attendance Updated",
                    "The attendance record was updated successfully.");
            }
            else
            {
                formModel.RecordedByWorkerId =
                    AuthService.CurrentWorker.WorkerId;

                formModel.RecordedDate =
                    DateTime.UtcNow;

                var success =
                    await AttendanceService
                        .CreateAttendanceAsync(formModel);

                if (!success)
                {
                    throw new Exception(
                        "The attendance record could not be saved.");
                }

                ShowResultPopup(
                    true,
                    "Attendance Recorded",
                    $"Attendance was recorded successfully. Total: {GetFormTotal()}.");
            }

            ResetForm();
            await ReloadRecordsAsync();
        }
        catch (Exception ex)
        {
            ShowResultPopup(
                false,
                "Unable to Save Attendance",
                ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void StartEdit(
        AttendanceRecord record)
    {
        editingRecordId = record.Id;
        isEditMode = true;

        formModel = new AttendanceRecord
        {
            Id = record.Id,
            ServiceId = record.ServiceId,
            ServiceName = record.ServiceName,
            AttendanceDate = record.AttendanceDate.Date,
            Men = record.Men,
            Women = record.Women,
            Teenagers = record.Teenagers,
            Children = record.Children,
            Notes = record.Notes,
            RecordedByWorkerId =
                record.RecordedByWorkerId,
            RecordedDate =
                record.RecordedDate
        };

        errorMessage = null;
    }

    private void CancelEdit()
    {
        ResetForm();
    }

    private void OpenDetails(
        AttendanceRecord record)
    {
        selectedRecord = record;
        showDetailsPopup = true;
    }

    private void OpenRemovePopup(
        AttendanceRecord record)
    {
        selectedRecord = record;
        showRemovePopup = true;
    }

    private async Task RemoveRecord()
    {
        if (selectedRecord == null ||
            isRemoving)
        {
            return;
        }

        try
        {
            isRemoving = true;

            var success =
                await AttendanceService
                    .DeleteAttendanceAsync(
                        selectedRecord.Id);

            if (!success)
            {
                throw new Exception(
                    "The attendance record could not be removed.");
            }

            ClosePopups();
            await ReloadRecordsAsync();

            ShowResultPopup(
                true,
                "Attendance Removed",
                "The attendance record was removed successfully.");
        }
        catch (Exception ex)
        {
            ClosePopups();

            ShowResultPopup(
                false,
                "Unable to Remove Attendance",
                ex.Message);
        }
        finally
        {
            isRemoving = false;
        }
    }

    private async Task ReloadRecordsAsync()
    {
        allRecords =
            (await AttendanceService.GetAllAttendanceAsync())
                .OrderByDescending(x => x.AttendanceDate)
                .ThenByDescending(x => x.RecordedDate)
                .ToList();

        ApplyFilters();
    }

    private void ApplyFilters()
    {
        IEnumerable<AttendanceRecord> query =
            allRecords;

        if (dateFrom.HasValue)
        {
            query = query.Where(x =>
                x.AttendanceDate.Date >=
                dateFrom.Value.Date);
        }

        if (dateTo.HasValue)
        {
            query = query.Where(x =>
                x.AttendanceDate.Date <=
                dateTo.Value.Date);
        }

        if (!string.IsNullOrWhiteSpace(
            searchText))
        {
            var search = searchText.Trim();

            query = query.Where(x =>
                (x.Service?.Name?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                    ?? false) ||

                (x.ServiceName?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                    ?? false) ||

                (x.Notes?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                    ?? false) ||

                (x.RecordedBy?.FirstName?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                    ?? false) ||

                (x.RecordedBy?.LastName?.Contains(
                    search,
                    StringComparison.OrdinalIgnoreCase)
                    ?? false));
        }

        filteredRecords = query
            .OrderByDescending(x =>
                x.AttendanceDate)
            .ThenByDescending(x =>
                x.RecordedDate)
            .ToList();
    }

    private void ClearFilters()
    {
        dateFrom = null;
        dateTo = null;
        searchText = string.Empty;
        filteredRecords = allRecords.ToList();
    }

    private bool ValidateForm()
    {
        if (formModel.ServiceId <= 0)
        {
            errorMessage =
                "Please select a service.";
            return false;
        }

        if (formModel.AttendanceDate.Date >
            DateTime.Today)
        {
            errorMessage =
                "Attendance date cannot be in the future.";
            return false;
        }

        if (formModel.Men < 0 ||
            formModel.Women < 0 ||
            formModel.Teenagers < 0 ||
            formModel.Children < 0)
        {
            errorMessage =
                "Attendance figures cannot be negative.";
            return false;
        }

        if (GetFormTotal() <= 0)
        {
            errorMessage =
                "Please enter attendance for at least one category.";
            return false;
        }

        return true;
    }

    private int GetFormTotal()
    {
        return formModel.Men +
               formModel.Women +
               formModel.Teenagers +
               formModel.Children;
    }

    private void ResetForm()
    {
        formModel = NewAttendanceRecord();
        editingRecordId = 0;
        isEditMode = false;
        errorMessage = null;
    }

    private static AttendanceRecord NewAttendanceRecord()
    {
        return new AttendanceRecord
        {
            AttendanceDate = DateTime.Today
        };
    }

    private void ClosePopups()
    {
        showDetailsPopup = false;
        showRemovePopup = false;
        selectedRecord = null;
    }

    private void ShowResultPopup(
        bool success,
        string title,
        string message)
    {
        resultPopupSuccess = success;
        resultPopupTitle = title;
        resultPopupMessage = message;
        showResultPopup = true;
    }

    private void CloseResultPopup()
    {
        showResultPopup = false;
        resultPopupTitle = string.Empty;
        resultPopupMessage = string.Empty;
    }

    private void GoBack()
    {
        Navigation.NavigateTo(
            "/workspace/service-records");
    }

    private static string GetWorkerName(
        Worker? worker)
    {
        if (worker == null)
            return "Not available";

        return $"{worker.FirstName} {worker.LastName}"
            .Trim();
    }
    private static bool IsFigDirectorate(
    Worker worker)
    {
        var directorateName =
            worker.Directorate?.Name?.Trim();

        if (string.IsNullOrWhiteSpace(
            directorateName))
        {
            return false;
        }

        return string.Equals(
                   directorateName,
                   "FIG",
                   StringComparison.OrdinalIgnoreCase)
               ||
               directorateName.Contains(
                   "FIG",
                   StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsChurchAdmin(
        Worker worker)
    {
        var role = worker.Role?.Trim();

        if (string.IsNullOrWhiteSpace(role))
            return false;

        return string.Equals(
                   role,
                   "Church Admin",
                   StringComparison.OrdinalIgnoreCase)
               ||
               role.Contains(
                   "Church Administrator",
                   StringComparison.OrdinalIgnoreCase);
    }
}

