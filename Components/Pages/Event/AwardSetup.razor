@page "/event/award-setup"
@layout Components.Layout.MainLayout
@using ChurchApp.Models.Event
@using ChurchApp.Services.Event
@inject AwardService Awards
@inject NavigationManager Nav

<PageTitle>Award Setup - BCC ServiceHub</PageTitle>

<div class="award-setup-page worker360-page">
    <div class="bcc-page-header service-records-page-header award-hero">
        <div>
            <div class="bcc-page-subtitle">
                <i class="fas fa-trophy me-2"></i>EVENT HUB / WORKERS' RECOGNITION
            </div>
            <div class="bcc-page-title">Award Setup</div>
            <div class="bcc-page-subtitle">
                Configure award categories, nomination limits, eligibility and opening dates.
            </div>
        </div>
        <button type="button"
                class="bcc-btn profile-form-secondary-btn award-back"
                @onclick='() => Nav.NavigateTo("/workspace/event-hub")'>
            <i class="fas fa-arrow-left me-2"></i>Event Hub
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger py-2">@error</div>
    }

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-success py-2">@message</div>
    }

    @if (!allowed)
    {
        <div class="award-panel">You are not authorised to manage awards.</div>
    }
    else
    {
        <section class="award-panel programme-panel">
            <div class="award-panel-head">
                <span><i class="fas fa-calendar-check me-2"></i>Award programme</span>
                <span class="award-hint">Select an existing programme or create a new one</span>
            </div>

            <div class="award-programme-grid">
                <div class="award-field">
                    <label for="programme-select">Existing programmes</label>
                    <select id="programme-select"
                            class="form-select form-select-sm"
                            value="@programme.Id"
                            @onchange="SelectProgrammeAsync">
                        <option value="0">New programme</option>
                        @foreach (var item in programmes)
                        {
                            <option value="@item.Id">@item.Name (@item.Year)</option>
                        }
                    </select>
                </div>

                <div class="award-field">
                    <label for="programme-name">Programme name</label>
                    <input id="programme-name"
                           class="form-control form-control-sm"
                           maxlength="160"
                           @bind="programme.Name" />
                </div>

                <div class="award-field">
                    <label for="programme-year">Year</label>
                    <input id="programme-year"
                           class="form-control form-control-sm"
                           type="number"
                           @bind="programme.Year" />
                </div>

                <div class="award-field">
                    <label for="programme-active">Status</label>
                    <select id="programme-active"
                            class="form-select form-select-sm"
                            value="@(programme.IsActive ? "true" : "false")"
                            @onchange="OnProgrammeActiveChanged">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>

                <button type="button" class="award-primary" @onclick="SaveProgrammeAsync">
                    <i class="fas fa-save me-1"></i>Save
                </button>
            </div>
        </section>

        @if (programme.Id > 0)
        {
            <div class="award-summary">
                <div>
                    <strong>@categories.Count</strong>
                    <span>Categories</span>
                </div>
                <div>
                    <strong>@categories.Count(x => x.NominationAllowed)</strong>
                    <span>Nomination enabled</span>
                </div>
                <div>
                    <strong>@categories.Count(x => x.IsActive)</strong>
                    <span>Active awards</span>
                </div>
            </div>

            <div class="award-content-grid">
                <section class="award-panel">
                    <div class="award-panel-head">
                        <span>
                            <i class="fas fa-sliders-h me-2"></i>
                            @(award.Id == 0 ? "New award category" : "Edit award category")
                        </span>
                        @if (award.Id > 0)
                        {
                            <button type="button" class="award-text-button" @onclick="NewAward">
                                + New
                            </button>
                        }
                    </div>

                    <div class="award-form-grid">
                        <div class="award-field award-wide">
                            <label for="award-name">Award name</label>
                            <input id="award-name"
                                   class="form-control form-control-sm"
                                   maxlength="160"
                                   placeholder="e.g. Sunday Swag Award"
                                   @bind="award.Name" />
                        </div>

                        <div class="award-field award-wide">
                            <label for="award-description">Description</label>
                            <textarea id="award-description"
                                      class="form-control form-control-sm"
                                      rows="2"
                                      maxlength="2500"
                                      @bind="award.Description"></textarea>
                        </div>

                        <div class="award-field">
                            <label for="award-audience">Who can nominate?</label>
                            <select id="award-audience"
                                    class="form-select form-select-sm"
                                    @bind="award.NominationAudience"
                                    @bind:after="AudienceChanged">
                                <option value="AllWorkers">All workers</option>
                                <option value="Leaders">Leader (Head of Directorate)</option>
                                <option value="PastorInCharge">Pastor in Charge</option>
                            </select>
                        </div>

                        <div class="award-field">
                            <label for="award-scope">Nomination scope</label>
                            <select id="award-scope"
                                    class="form-select form-select-sm"
                                    value="@NominationScope"
                                    @onchange="OnScopeChanged">
                                <option value="ChurchWide">Church-wide workers</option>
                                @if (award.NominationAudience == "Leaders")
                                {
                                    <option value="OwnDirectorate">Own-directorate workers</option>
                                    <option value="OtherDirectorates">Other directorates</option>
                                }
                            </select>
                        </div>

                        <div class="award-field">
                            <label for="award-max">Maximum nominations per worker</label>
                            <input id="award-max"
                                   class="form-control form-control-sm"
                                   type="number"
                                   min="1"
                                   max="20"
                                   @bind="award.MaxNominationsPerWorker" />
                        </div>

                        <div class="award-field">
                            <label for="award-rule">Selection rule</label>
                            <select id="award-rule"
                                    class="form-select form-select-sm"
                                    @bind="award.SelectionRule"
                                    @bind:after="SelectionRuleChanged">
                                <option value="Any">Any eligible nominee (no duplicates)</option>
                                <option value="OneMaleOneFemale">One male + one female</option>
                            </select>
                        </div>

                        <div class="award-field">
                            <label for="award-gender">Gender filter</label>
                            <select id="award-gender"
                                    class="form-select form-select-sm"
                                    @bind="award.GenderFilter">
                                <option value="Any">Any</option>
                                <option value="Male">Male only</option>
                                <option value="Female">Female only</option>
                            </select>
                        </div>

                        <div class="award-field">
                            <label for="award-nomination-allowed">Nomination allowed?</label>
                            <select id="award-nomination-allowed"
                                    class="form-select form-select-sm"
                                    value="@(award.NominationAllowed ? "true" : "false")"
                                    @onchange="OnNominationAllowedChanged">
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>

                        <div class="award-field">
                            <label for="award-active">Active?</label>
                            <select id="award-active"
                                    class="form-select form-select-sm"
                                    value="@(award.IsActive ? "true" : "false")"
                                    @onchange="OnAwardActiveChanged">
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                        </div>

                        <div class="award-field">
                            <label for="award-order">Display order</label>
                            <input id="award-order"
                                   class="form-control form-control-sm"
                                   type="number"
                                   @bind="award.SortOrder" />
                        </div>

                        <div class="award-field">
                            <label for="award-opens">Opens (UTC)</label>
                            <input id="award-opens"
                                   class="form-control form-control-sm"
                                   type="datetime-local"
                                   @bind="award.OpensAtUtc"
                                   @bind:format="yyyy-MM-ddTHH:mm" />
                        </div>

                        <div class="award-field">
                            <label for="award-closes">Closes (UTC)</label>
                            <input id="award-closes"
                                   class="form-control form-control-sm"
                                   type="datetime-local"
                                   @bind="award.ClosesAtUtc"
                                   @bind:format="yyyy-MM-ddTHH:mm" />
                        </div>
                    </div>

                    <div class="award-rule-note">
                        <i class="fas fa-info-circle me-1"></i>@RuleDescription()
                    </div>

                    <div class="award-actions">
                        <button type="button" class="award-primary" @onclick="SaveAwardAsync">
                            <i class="fas fa-save me-1"></i>
                            @(award.Id == 0 ? "Create award" : "Save changes")
                        </button>
                        <button type="button" class="award-secondary" @onclick="NewAward">
                            Clear form
                        </button>
                    </div>
                </section>

                <section class="award-panel award-list-panel">
                    <div class="award-panel-head">
                        <span><i class="fas fa-list-ul me-2"></i>Configured awards</span>
                        <span class="award-hint">@categories.Count total</span>
                    </div>

                    @if (categories.Count == 0)
                    {
                        <div class="award-empty">
                            No categories yet. Create the first award using the form.
                        </div>
                    }
                    else
                    {
                        @foreach (var item in categories)
                        {
                            <div class="award-list-item @(award.Id == item.Id ? "selected" : "")"
                                 @key="item.Id">
                                <div class="award-list-icon">
                                    <i class="fas fa-award"></i>
                                </div>
                                <div class="award-list-details">
                                    <strong>@item.Name</strong>
                                    <div class="award-tags">
                                        <span>@AudienceLabel(item.NominationAudience)</span>
                                        <span>@(item.NomineeType == "Directorate"
                                            ? "Other directorates"
                                            : item.RestrictNomineesToOwnDirectorate
                                                ? "Own directorate"
                                                : "Church-wide")</span>
                                        <span>
                                            @item.MaxNominationsPerWorker
                                            nomination@(item.MaxNominationsPerWorker == 1 ? "" : "s")
                                        </span>
                                        @if (item.SelectionRule == "OneMaleOneFemale")
                                        {
                                            <span>Male + Female</span>
                                        }
                                        <span>@(item.NominationAllowed ? "Nomination allowed" : "No nomination")</span>
                                        <span>@(item.IsActive ? "Active" : "Inactive")</span>
                                    </div>
                                </div>
                                <button type="button"
                                        class="award-edit"
                                        title="Edit award"
                                        @onclick="() => Edit(item)">
                                    <i class="fas fa-pen"></i>
                                </button>
                            </div>
                        }
                    }
                </section>
            </div>
        }
    }
</div>

@code {
    private bool allowed;
    private string error = string.Empty;
    private string message = string.Empty;

    private AwardProgramme programme = new();
    private AwardCategory award = new();
    private List<AwardProgramme> programmes = new();
    private List<AwardCategory> categories = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allowed = await Awards.CanManageAsync();

            if (!allowed)
            {
                return;
            }

            programmes = await Awards.ProgrammesAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task SelectProgrammeAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int id) || id == 0)
        {
            programme = new AwardProgramme();
            categories.Clear();
            NewAward();
            return;
        }

        programme = programmes.First(x => x.Id == id);
        NewAward();
        categories = await Awards.SetupAwardsAsync(id);
    }

    private async Task SaveProgrammeAsync()
    {
        try
        {
            error = string.Empty;
            message = string.Empty;

            await Awards.SaveProgrammeAsync(programme);
            programmes = await Awards.ProgrammesAsync();
            NewAward();
            categories = await Awards.SetupAwardsAsync(programme.Id);
            message = "Programme saved successfully.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void NewAward()
    {
        award = new AwardCategory
        {
            AwardProgrammeId = programme.Id
        };
    }

    private static bool IsTrue(ChangeEventArgs e)
    {
        return string.Equals(
            e.Value?.ToString(),
            "true",
            StringComparison.OrdinalIgnoreCase);
    }

    private void OnProgrammeActiveChanged(ChangeEventArgs e)
    {
        programme.IsActive = IsTrue(e);
    }

    private void OnNominationAllowedChanged(ChangeEventArgs e)
    {
        award.NominationAllowed = IsTrue(e);
    }

    private void OnAwardActiveChanged(ChangeEventArgs e)
    {
        award.IsActive = IsTrue(e);
    }

    // This is a UI-only scope. Existing database fields store the selection.
    // ChurchWide = Worker + no restriction.
    // OwnDirectorate = Worker + restriction.
    // OtherDirectorates = Directorate + no restriction.
    private string NominationScope => award.NomineeType == "Directorate"
        ? "OtherDirectorates"
        : award.RestrictNomineesToOwnDirectorate
            ? "OwnDirectorate"
            : "ChurchWide";

    private void AudienceChanged()
    {
        // All Workers and Pastor in Charge always nominate church-wide workers.
        if (award.NominationAudience != "Leaders")
        {
            ApplyNominationScope("ChurchWide");
        }
    }

    private void OnScopeChanged(ChangeEventArgs e)
    {
        ApplyNominationScope(e.Value?.ToString() ?? "ChurchWide");
    }

    private void ApplyNominationScope(string scope)
    {
        if (award.NominationAudience != "Leaders")
        {
            scope = "ChurchWide";
        }

        switch (scope)
        {
            case "OwnDirectorate":
                award.NomineeType = "Worker";
                award.RestrictNomineesToOwnDirectorate = true;
                award.SelectionRule = "Any";
                award.GenderFilter = "Any";
                award.MaxNominationsPerWorker = 3;
                break;

            case "OtherDirectorates":
                award.NomineeType = "Directorate";
                award.RestrictNomineesToOwnDirectorate = false;
                award.SelectionRule = "Any";
                award.GenderFilter = "Any";
                award.MaxNominationsPerWorker = 1;
                break;

            default:
                var wasDirectorate = award.NomineeType == "Directorate";
                award.NomineeType = "Worker";
                award.RestrictNomineesToOwnDirectorate = false;

                if (wasDirectorate)
                {
                    award.MaxNominationsPerWorker = 1;
                }
                break;
        }
    }

    private void SelectionRuleChanged()
    {
        if (award.SelectionRule == "OneMaleOneFemale")
        {
            award.NomineeType = "Worker";
            award.MaxNominationsPerWorker = 2;
            award.GenderFilter = "Any";
        }
    }

    private string RuleDescription()
    {
        if (NominationScope == "OtherDirectorates")
        {
            return "Heads of Directorates nominate one other directorate; their own is excluded.";
        }

        if (NominationScope == "OwnDirectorate")
        {
            return "Only Heads of Directorates may nominate workers in their own directorate, including secondary members. Set the maximum to three.";
        }

        if (award.SelectionRule == "OneMaleOneFemale")
        {
            return "Church-wide selection: two slots, one male and one female. Duplicate nominees are rejected.";
        }

        return "Church-wide selection: any active worker from any directorate, excluding yourself. The configured audience determines who may nominate.";
    }

    private static string AudienceLabel(string audience)
    {
        return audience switch
        {
            "Leaders" => "Leader",
            "PastorInCharge" => "Pastor in Charge",
            _ => "All workers"
        };
    }

    private void Edit(AwardCategory item)
    {
        error = string.Empty;
        message = string.Empty;

        award = new AwardCategory
        {
            Id = item.Id,
            AwardProgrammeId = item.AwardProgrammeId,
            Name = item.Name,
            Description = item.Description,
            NominationAudience = item.NominationAudience,
            NomineeType = item.NomineeType,
            GenderFilter = item.GenderFilter,
            NominationAllowed = item.NominationAllowed,
            RestrictNomineesToOwnDirectorate = item.RestrictNomineesToOwnDirectorate,
            IsActive = item.IsActive,
            OpensAtUtc = item.OpensAtUtc,
            ClosesAtUtc = item.ClosesAtUtc,
            SortOrder = item.SortOrder,
            MaxNominationsPerWorker = item.MaxNominationsPerWorker,
            SelectionRule = item.SelectionRule
        };
    }

    private async Task SaveAwardAsync()
    {
        try
        {
            error = string.Empty;
            message = string.Empty;

            await Awards.SaveAwardAsync(award);
            categories = await Awards.SetupAwardsAsync(programme.Id);
            NewAward();
            message = "Award category saved successfully.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}

<style>
    .award-setup-page {
        max-width: 1420px;
        margin: 0 auto;
        padding: 6px 10px 30px;
    }

    .award-hero {
        margin-bottom: 14px !important;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .award-back {
        font-size: 0.78rem !important;
    }

    .award-panel {
        background: #ffffff;
        border: 1px solid #e2e9e5;
        border-radius: 12px;
        padding: 15px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.035);
        min-width: 0;
    }

    .award-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        font-weight: 800;
        font-size: 0.88rem;
        color: #183b2c;
        margin-bottom: 12px;
    }

    .award-hint {
        font-weight: 400;
        color: #718076;
        font-size: 0.71rem;
    }

    .award-programme-grid {
        display: grid;
        grid-template-columns: 1.3fr 1.7fr 90px 105px auto;
        gap: 9px;
        align-items: end;
    }

    .award-field {
        min-width: 0;
    }

    .award-field label {
        display: block;
        font-size: 0.7rem;
        color: #53675c;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .award-field .form-control,
    .award-field .form-select {
        border-color: #dbe5df;
        font-size: 0.78rem;
        min-height: 34px;
    }

    .award-primary,
    .award-secondary,
    .award-edit,
    .award-text-button {
        border: 0;
        cursor: pointer;
    }

    .award-primary {
        background: #167347;
        color: #ffffff;
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 9px 15px;
        white-space: nowrap;
    }

    .award-primary:hover {
        background: #0f5d39;
    }

    .award-secondary {
        background: #f0f5f2;
        color: #286345;
        border-radius: 8px;
        padding: 9px 13px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .award-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin: 12px 0;
    }

    .award-summary > div {
        background: #f0f8f3;
        border: 1px solid #dceee2;
        border-radius: 10px;
        padding: 10px 14px;
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .award-summary strong {
        font-size: 1.35rem;
        color: #17683f;
    }

    .award-summary span {
        font-size: 0.73rem;
        color: #4c6b59;
    }

    .award-content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
        gap: 12px;
        align-items: start;
    }

    .award-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px 12px;
    }

    .award-wide {
        grid-column: 1 / -1;
    }

    .award-rule-note {
        background: #f0f8f3;
        color: #38634c;
        border-radius: 8px;
        font-size: 0.72rem;
        padding: 10px;
        margin-top: 12px;
    }

    .award-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        margin-top: 12px;
    }

    .award-list-panel {
        max-height: 790px;
        overflow-y: auto;
    }

    .award-list-item {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 10px 3px;
        border-bottom: 1px solid #edf1ee;
    }

    .award-list-item.selected {
        background: #f1f8f3;
        border-radius: 8px;
    }

    .award-list-icon {
        display: grid;
        place-items: center;
        flex: none;
        width: 34px;
        height: 34px;
        background: #e8f5ed;
        color: #167347;
        border-radius: 9px;
    }

    .award-list-details {
        flex: 1;
        min-width: 0;
    }

    .award-list-details strong {
        font-size: 0.78rem;
        color: #20362a;
    }

    .award-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 4px;
    }

    .award-tags span {
        font-size: 0.62rem;
        background: #f1f5f2;
        border-radius: 4px;
        padding: 3px 5px;
        color: #567060;
    }

    .award-edit {
        background: #e8f5ed;
        color: #167347;
        border-radius: 7px;
        padding: 8px 10px;
    }

    .award-text-button {
        color: #167347;
        background: transparent;
        font-size: 0.73rem;
        font-weight: 700;
    }

    .award-empty {
        padding: 30px 12px;
        text-align: center;
        color: #718076;
        font-size: 0.8rem;
    }

    @@media (max-width: 1000px) {
        .award-programme-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .award-content-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 580px) {
        .award-programme-grid,
        .award-form-grid {
            grid-template-columns: 1fr;
        }

        .award-summary {
            gap: 5px;
        }

        .award-summary > div {
            padding: 8px;
            display: block;
        }

        .award-summary strong,
        .award-summary span {
            display: block;
        }

        .award-hero {
            align-items: flex-start;
            flex-wrap: wrap;
        }
    }
</style>

