    }

    .award-nom-limit {
        color: #728577;
        font-size: .7rem;
    }

    .award-nom-done {
        color: #18824d;
        font-size: .8rem;
    }

    .award-nom-description {
        margin: 10px 0;
        color: #607367;
        font-size: .76rem;
        line-height: 1.5;
    }

    .award-nom-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: 10px 0 12px;
        color: #617968;
        font-size: .7rem;
    }

    .award-nom-rule {
        padding: 2px 7px;
        border-radius: 5px;
        background: #edf7f0;
        color: #256b43;
    }

    .award-nom-label {
        display: block;
        margin-bottom: 5px;
        color: #355541;
        font-size: .73rem;
        font-weight: 700;
    }

    .award-nom-choice,
    .award-nom-slot .form-control,
    .award-nom-slot .form-select {
        min-height: 34px;
