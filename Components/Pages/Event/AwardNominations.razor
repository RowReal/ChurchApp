@page "/event/award-nominations"
@layout Components.Layout.MainLayout
@using ChurchApp.Models.Event
@using ChurchApp.Models
@using ChurchApp.Services.Event
@inject AwardService Awards
@inject NavigationManager Nav

<PageTitle>Award Nominations - BCC ServiceHub</PageTitle>

<div class="award-nom-page worker360-page">
    <header class="award-nom-hero">
        <div class="award-nom-hero-copy">
            <div class="award-nom-eyebrow">
                <i class="fas fa-award" aria-hidden="true"></i>
                PERSONAL WORKSPACE
            </div>
            <h1>Award Nominations</h1>
            <span class="award-nom-hero-accent">Celebrate service. Honour dedication.</span>
            <p>Recognise deserving workers. Review your choices and submit before nominations close.</p>
        </div>
        <button type="button" class="award-nom-back" @onclick="GoToWorkspace">
            <i class="fas fa-arrow-left" aria-hidden="true"></i>
            My Workspace
        </button>
    </header>

    @if (loading)
    {
        <div class="award-nom-empty">
            <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
            Loading available awards...
        </div>
    }
    else if (cards.Count == 0)
    {
        <div class="award-nom-empty">
            <i class="fas fa-calendar-check" aria-hidden="true"></i>
            <strong>No nominations available</strong>
            <span>There are currently no awards open for your nomination.</span>
        </div>
    }
    else
    {
        <section class="award-nom-overview" aria-label="Nomination progress">
            <div>
                <span class="award-nom-overview-label">Your progress</span>
                <div class="award-nom-overview-count">
                    <strong>@AnsweredCount</strong>
                    <span>of @cards.Count awards answered</span>
                </div>
            </div>
            <div class="award-nom-progress" role="progressbar" aria-valuenow="@AnsweredCount" aria-valuemin="0" aria-valuemax="@cards.Count">
                <div class="award-nom-progress-fill" style="width: @(ProgressPercent)%"></div>
            </div>
            <span class="award-nom-overview-help">You can revise your submission while nominations are open.</span>
        </section>

        <div class="award-nom-grid">
            @foreach (var card in cards)
            {
                <section class="award-nom-card" @key="card.Award.Id">
                    <div class="award-nom-card-top">
                        <div class="award-nom-icon"><i class="fas fa-trophy" aria-hidden="true"></i></div>
                        <div class="award-nom-heading">
                            <h2>@card.Award.Name</h2>
                            <span class="award-nom-limit">
                                Up to @card.Award.MaxNominationsPerWorker nominee(s)
                                · @(card.Award.NomineeType == "Directorate"
                                    ? "Other directorates"
                                    : card.Award.RestrictNomineesToOwnDirectorate
                                        ? "Own directorate"
                                        : "Church-wide")
                            </span>
                        </div>
                        @if (card.Choice != "")
                        {
                            <span class="award-nom-done" title="Answered"><i class="fas fa-check" aria-hidden="true"></i></span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(card.Award.Description))
                    {
                        <p class="award-nom-description">@card.Award.Description</p>
                    }

                    <div class="award-nom-meta">
                        <span><i class="far fa-clock" aria-hidden="true"></i> Closes @card.Award.ClosesAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                        @if (card.Award.SelectionRule == "OneMaleOneFemale")
                        {
                            <span class="award-nom-rule">One male and one female</span>
                        }
                    </div>

                    <label class="award-nom-label" for="@($"choice-{card.Award.Id}")">Your response</label>
                    <select id="@($"choice-{card.Award.Id}")" class="form-select form-select-sm award-nom-choice" @bind="card.Choice">
                        <option value="">Select a response</option>
                        <option value="nominate">Nominate worker(s)</option>
                        <option value="none">No nomination</option>
                    </select>

                    @if (card.Choice == "nominate")
                    {
                        <div class="award-nom-slots">
                            @foreach (var slot in card.Slots)
                            {
                                <div class="award-nom-slot" @key="slot.Number">
                                    <div class="award-nom-slot-head">
                                        <strong>Nominee @slot.Number</strong>
                                        @if (card.Award.SelectionRule == "OneMaleOneFemale")
                                        {
                                            <span>@(slot.Number == 1 ? "Male" : "Female")</span>
                                        }
                                        else if (slot.Number > 1)
                                        {
                                            <span>Optional</span>
                                        }
                                    </div>

                                    @if (card.Award.NomineeType == "Worker")
                                    {
                                        <div class="award-nom-search">
                                            <input class="form-control form-control-sm"
                                                   aria-label="Search worker"
                                                   placeholder="Filter workers by name or ID"
                                                   @bind="slot.Search"
                                                   @bind:event="oninput" />
                                            <button type="button" class="award-nom-search-btn" @onclick="() => SearchAsync(card, slot)">
                                                <i class="fas fa-search" aria-hidden="true"></i>
                                                Filter
                                            </button>
                                        </div>
                                        <select class="form-select form-select-sm" aria-label="Select nominee" @bind="slot.WorkerId">
                                            <option value="">Select worker</option>
                                            @foreach (var worker in slot.Workers.Where(w => IsAllowedForSlot(card, slot, w)))
                                            {
                                                <option value="@worker.Id">@worker.FullName (@worker.WorkerId) - @worker.Sex</option>
                                            }
                                        </select>
                                        <small class="award-nom-field-hint">
                                            @GetNomineeScope(card)
                                            (@slot.Workers.Count(w => IsAllowedForSlot(card, slot, w)) eligible workers loaded)
                                        </small>
                                    }
                                    else
                                    {
                                        <select class="form-select form-select-sm" aria-label="Select directorate" @bind="slot.DirectorateId">
                                            <option value="">Select another directorate (not your own)</option>
                                            @foreach (var directorate in card.Directorates)
                                            {
                                                <option value="@directorate.Id">@directorate.Name</option>
                                            }
                                        </select>
                                    }

                                    <textarea class="form-control form-control-sm award-nom-reason"
                                              rows="2"
                                              maxlength="2000"
                                              aria-label="Nomination justification"
                                              placeholder="Why does this nominee deserve the award?"
                                              @bind="slot.Reason"></textarea>
                                </div>
                            }
                        </div>
                    }
                    else if (card.Choice == "none")
                    {
                        <p class="award-nom-none"><i class="fas fa-info-circle" aria-hidden="true"></i> No nominee will be submitted for this award.</p>
                    }
                </section>
            }
        </div>

        <div class="award-nom-actions">
            <div>
                <strong>Ready to submit?</strong>
                <span>Only answered awards will be saved.</span>
            </div>
            <button type="button" class="award-nom-submit" @onclick="Review" disabled="@submitting">
                <i class="fas fa-check-circle" aria-hidden="true"></i>
                Review &amp; submit
            </button>
        </div>


    }
</div>

@if (ShowDialog)
{
    <div class="award-nom-dialog-backdrop" role="presentation">
        <div class="award-nom-dialog"
             role="alertdialog"
             aria-modal="true"
             aria-labelledby="award-nom-dialog-title"
             aria-describedby="award-nom-dialog-message">
            <div class="award-nom-dialog-heading">
                <span class="award-nom-dialog-icon @DialogIconClass">
                    <i class="fas @DialogIcon" aria-hidden="true"></i>
                </span>
                <h2 id="award-nom-dialog-title">@DialogTitle</h2>
            </div>

            <p id="award-nom-dialog-message">@DialogMessage</p>

            <div class="award-nom-dialog-actions">
                @if (confirm)
                {
                    <button type="button"
                            class="award-nom-submit"
                            @onclick="SubmitAsync"
                            disabled="@submitting">
                        @(submitting ? "Submitting..." : "Yes, submit")
                    </button>

                    <button type="button"
                            class="award-nom-cancel"
                            @onclick="CancelReview"
                            disabled="@submitting">
                        Go back
                    </button>
                }
                else
                {
                    <button type="button"
                            class="award-nom-submit"
                            @onclick="DismissDialog">
                        OK
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private sealed class Slot
    {
        public int Number { get; set; }
        public string Search { get; set; } = "";
        public int? WorkerId { get; set; }
        public int? DirectorateId { get; set; }
        public string Reason { get; set; } = "";
        public List<Worker> Workers { get; set; } = new();
    }

    private sealed class Card
    {
        public AwardCategory Award { get; set; } = new();
        public string Choice { get; set; } = "";
        public List<Slot> Slots { get; set; } = new();
        public List<Directorate> Directorates { get; set; } = new();
    }

    private readonly List<Card> cards = new();
    private bool loading = true;
    private bool confirm;
    private bool submitting;
    private int unanswered;
    private string error = "";
    private string message = "";

    private int AnsweredCount => cards.Count(c => c.Choice != "");
    private int ProgressPercent => cards.Count == 0 ? 0 : (int)Math.Round(100.0 * AnsweredCount / cards.Count);

    private void GoToWorkspace() => Nav.NavigateTo("/");
    private bool ShowDialog => confirm ||
                               !string.IsNullOrWhiteSpace(error) ||
                               !string.IsNullOrWhiteSpace(message);

    private string DialogTitle => confirm
        ? "Confirm your nominations"
        : !string.IsNullOrWhiteSpace(error)
            ? "Action required"
            : "Nominations saved";

    private string DialogMessage => confirm
        ? $"{unanswered} award(s) remain unanswered and will not be changed. Submit your completed responses?"
        : !string.IsNullOrWhiteSpace(error)
            ? error
            : message;

    private string DialogIcon => confirm
        ? "fa-question-circle"
        : !string.IsNullOrWhiteSpace(error)
            ? "fa-exclamation-triangle"
            : "fa-check-circle";

    private string DialogIconClass => confirm
        ? "award-nom-dialog-question"
        : !string.IsNullOrWhiteSpace(error)
            ? "award-nom-dialog-error"
            : "award-nom-dialog-success";

    private void CancelReview()
    {
        confirm = false;
    }

    private void DismissDialog()
    {
        error = "";
        message = "";
    }

    private static bool IsAllowedForSlot(Card card, Slot slot, Worker worker)
    {
        return card.Award.SelectionRule != "OneMaleOneFemale" ||
               string.Equals(worker.Sex, slot.Number == 1 ? "Male" : "Female", StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var open = await Awards.MyOpenAwardsAsync();
            var existing = await Awards.MyNominationsAsync();

            foreach (var award in open)
            {
                var card = new Card { Award = award };
                for (var number = 1; number <= award.MaxNominationsPerWorker; number++)
                {
                    card.Slots.Add(new Slot { Number = number });
                }

                var saved = existing.Where(n => n.AwardCategoryId == award.Id && n.IsSubmitted).ToList();
                if (saved.Count > 0)
                {
                    card.Choice = saved.All(n => n.NoNomination) ? "none" : "nominate";
                }

                foreach (var nomination in saved)
                {
                    var slot = card.Slots.FirstOrDefault(s => s.Number == nomination.SlotNumber);
                    if (slot == null) continue;

                    slot.WorkerId = nomination.NomineeWorkerId;
                    slot.DirectorateId = nomination.NomineeDirectorateId;
                    slot.Reason = nomination.Justification;

                    if (nomination.NomineeWorkerId.HasValue)
                    {
                        var worker = await Awards.MySelectedWorkerAsync(award.Id, nomination.NomineeWorkerId.Value);
                        if (worker != null) slot.Workers.Add(worker);
                    }
                }

                if (award.NomineeType == "Directorate")
                {
                    card.Directorates = await Awards.OtherDirectoratesAsync(award.Id);
                }

                if (award.NomineeType == "Worker")
                {
                    var availableWorkers = await Awards.SearchWorkersAsync(award.Id, "");

                    foreach (var slot in card.Slots)
                    {
                        var selectedWorker = slot.Workers.FirstOrDefault();
                        slot.Workers = availableWorkers.ToList();

                        if (selectedWorker != null &&
                            slot.Workers.All(w => w.Id != selectedWorker.Id))
                        {
                            slot.Workers.Insert(0, selectedWorker);
                        }
                    }
                }

                cards.Add(card);
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SearchAsync(Card card, Slot slot)
    {
        try
        {
            error = "";
            var selected = slot.Workers.FirstOrDefault(w => w.Id == slot.WorkerId);
            slot.Workers = await Awards.SearchWorkersAsync(card.Award.Id, slot.Search);

            if (selected != null && slot.Workers.All(w => w.Id != selected.Id))
            {
                slot.Workers.Insert(0, selected);
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private static string GetNomineeScope(Card card)
    {
        return card.Award.RestrictNomineesToOwnDirectorate
            ? "Own directorate only: active workers assigned to your directorate, including secondary members."
            : "Church-wide: active workers from all directorates, excluding yourself.";
    }

    private void Review()
    {
        error = "";
        message = "";
        confirm = false;
        unanswered = cards.Count(c => c.Choice == "");

        if (AnsweredCount == 0)
        {
            error = "Please respond to at least one award.";
            return;
        }

        foreach (var card in cards.Where(c => c.Choice == "nominate"))
        {
            var selectedSlots = card.Slots.Where(s => s.WorkerId.HasValue || s.DirectorateId.HasValue).ToList();
            if (selectedSlots.Count == 0)
            {
                error = $"Select at least one nominee for {card.Award.Name}, or choose No nomination.";
                return;
            }

            if (selectedSlots.Any(s => string.IsNullOrWhiteSpace(s.Reason)))
            {
                error = $"Enter a justification for every selected nominee in {card.Award.Name}.";
                return;
            }

            var workerIds = selectedSlots.Where(s => s.WorkerId.HasValue).Select(s => s.WorkerId!.Value).ToList();
            if (workerIds.Count != workerIds.Distinct().Count())
            {
                error = $"The same worker cannot be selected twice for {card.Award.Name}.";
                return;
            }

            var directorateIds = selectedSlots.Where(s => s.DirectorateId.HasValue).Select(s => s.DirectorateId!.Value).ToList();
            if (directorateIds.Count != directorateIds.Distinct().Count())
            {
                error = $"The same directorate cannot be selected twice for {card.Award.Name}.";
                return;
            }

            if (card.Award.SelectionRule == "OneMaleOneFemale")
            {
                foreach (var slot in selectedSlots.Where(s => s.WorkerId.HasValue))
                {
                    var worker = slot.Workers.FirstOrDefault(w => w.Id == slot.WorkerId);
                    if (worker == null || !IsAllowedForSlot(card, slot, worker))
                    {
                        error = $"{card.Award.Name}: nominee 1 must be male and nominee 2 must be female.";
                        return;
                    }
                }
            }
        }

        confirm = true;
    }

    private async Task SubmitAsync()
    {
        if (submitting) return;
        submitting = true;

        try
        {
            error = "";
            var inputs = new List<AwardService.NominationInput>();

            foreach (var card in cards.Where(c => c.Choice != ""))
            {
                foreach (var slot in card.Slots)
                {
                    var isNoNomination = card.Choice == "none" ||
                                         (!slot.WorkerId.HasValue && !slot.DirectorateId.HasValue);

                    inputs.Add(new AwardService.NominationInput(
                        card.Award.Id,
                        slot.Number,
                        isNoNomination ? null : slot.WorkerId,
                        isNoNomination ? null : slot.DirectorateId,
                        isNoNomination,
                        isNoNomination ? "" : slot.Reason));
                }
            }

            await Awards.SubmitAsync(inputs);
            message = "Your nominations have been saved successfully.";
            confirm = false;
        }
        catch (Exception ex)
        {
            error = ex.Message;
            confirm = false;
        }
        finally
        {
            submitting = false;
        }
    }
}

<style>
    .award-nom-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 12px 16px 36px;
    }

    .award-nom-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 22px 26px;
        margin-bottom: 18px;
        border-radius: 14px;
        background: linear-gradient(120deg, #063d2a 0%, #0c6741 52%, #259b5c 100%);
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 22px rgba(8, 83, 49, .16);
        color: #fff;
    }

    .award-nom-hero::after {
        content: "";
        position: absolute;
        right: -65px;
        top: -105px;
        width: 285px;
        height: 285px;
        border: 1px solid rgba(255, 255, 255, .17);
        border-radius: 50%;
        box-shadow: 0 0 0 42px rgba(255, 255, 255, .035),
                    0 0 0 95px rgba(255, 255, 255, .025);
        pointer-events: none;
    }

    .award-nom-hero-copy,
    .award-nom-back {
        position: relative;
        z-index: 1;
    }

    .award-nom-hero-accent {
        display: inline-block;
        margin: 0 0 6px;
        color: #c8f3d7;
        font-size: .75rem;
        font-weight: 600;
    }

    .award-nom-field-hint {
        display: block;
        margin-top: 5px;
        color: #647b6d;
        font-size: .7rem;
    }

    .award-nom-hero-copy h1 {
        margin: 5px 0;
        color: #fff;
        font-size: 1.4rem;
        font-weight: 750;
    }

    .award-nom-hero-copy p {
        margin: 0;
        color: #e1f1e8;
        font-size: .83rem;
    }

    .award-nom-eyebrow {
        color: #d0eddb;
        font-size: .68rem;
        font-weight: 750;
        letter-spacing: .11em;
    }

    .award-nom-eyebrow i {
        margin-right: 6px;
    }

    .award-nom-back {
