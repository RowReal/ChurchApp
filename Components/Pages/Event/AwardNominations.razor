    }

    .award-nom-slots {
        display: grid;
        gap: 9px;
        margin-top: 11px;
    }

    .award-nom-slot {
        padding: 11px;
        border: 1px solid #e7eee9;
        border-radius: 9px;
        background: #f8fbf9;
    }

    .award-nom-slot-head {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        color: #28583d;
        font-size: .75rem;
    }

    .award-nom-slot-head span {
        color: #728578;
        font-size: .7rem;
    }

    .award-nom-search {
        display: flex;
        gap: 6px;
        margin-bottom: 7px;
    }

    .award-nom-search input {
        min-width: 0;
    }

    .award-nom-search-btn {
        flex-shrink: 0;
        padding: 5px 9px;
        border: 1px solid #bddbc7;
        border-radius: 6px;
        background: #e8f5ed;
        color: #176b40;
        font-size: .72rem;
        font-weight: 650;
    }

    .award-nom-reason {
        margin-top: 8px;
        resize: vertical;
    }

    .award-nom-none {
        margin: 9px 0 0;
        color: #66796b;
        font-size: .73rem;
    }

    .award-nom-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-top: 18px;
        padding: 15px 18px;
        border: 1px solid #dce9e0;
        border-radius: 11px;
        background: #fff;
    }

    .award-nom-actions strong,
    .award-nom-actions span {
        display: block;
    }

    .award-nom-actions strong {
        color: #28543b;
        font-size: .85rem;
    }

    .award-nom-actions span {
        color: #718276;
        font-size: .73rem;
    }

    .award-nom-submit {
        padding: 10px 15px;
        border: 0;
        border-radius: 8px;
        background: #177647;
        color: #fff;
        font-size: .78rem;
        font-weight: 700;
    }

    .award-nom-submit i {
        margin-right: 6px;
    }

