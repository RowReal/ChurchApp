        display: flex;
        align-items: baseline;
        gap: 6px;
        white-space: nowrap;
    }

    .award-nom-overview-count strong {
        color: #176d43;
        font-size: 1.25rem;
    }

    .award-nom-overview-count span {
        color: #526a59;
        font-size: .76rem;
    }

    .award-nom-progress {
        flex: 1;
        min-width: 60px;
        height: 8px;
        overflow: hidden;
        border-radius: 10px;
        background: #d9e9df;
    }

    .award-nom-progress-fill {
        height: 100%;
        border-radius: inherit;
        background: #198754;
        transition: width .2s ease;
    }

    .award-nom-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        align-items: start;
        gap: 14px;
    }

    .award-nom-card {
        min-width: 0;
        padding: 16px;
