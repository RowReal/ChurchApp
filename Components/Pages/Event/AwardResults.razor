    .award-results-evidence small {
        color: #85978b;
        font-size: 10px;
    }

    @@media (max-width: 1100px) {
        .award-results-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .award-results-page {
            padding: 12px;
        }

        .award-results-hero {
            padding: 22px;
            flex-direction: column;
        }

        .award-results-grid {
            grid-template-columns: 1fr;
        }

        .award-results-stats {
            gap: 16px;
        }

        .award-results-dialog-head, .award-results-dialog-body {
            padding-left: 16px;
            padding-right: 16px;
        }
    }
</style>

