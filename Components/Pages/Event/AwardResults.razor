        font-size: 12px;
        color: #d8eee4;
    }

    .award-results-back {
        position: relative;
        z-index: 1;
        white-space: nowrap;
        border: 1px solid rgba(255,255,255,.4);
        border-radius: 9px;
        padding: 9px 13px;
        background: rgba(255,255,255,.12);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
    }

        .award-results-back i {
            margin-right: 6px;
        }

    .award-results-toolbar {
        display: flex;
        align-items: end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        padding: 17px 19px;
