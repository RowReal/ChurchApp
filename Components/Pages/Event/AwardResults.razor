    .award-results-card-title {
        min-width: 0;
    }

        .award-results-card-title h2 {
            margin: 0 0 4px;
            color: #183d30;
            font-size: 14px;
            font-weight: 800;
        }

        .award-results-card-title span {
            font-size: 10px;
            color: #75887d;
