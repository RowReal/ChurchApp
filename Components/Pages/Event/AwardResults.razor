        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        font-size: 12px;
        color: #234d39;
    }

        .award-results-evidence-head span {
            color: #6c8175;
            font-size: 11px;
        }

    .award-results-evidence-quote {
        padding: 13px 15px;
        margin: 9px 0;
        background: #f4f8f5;
