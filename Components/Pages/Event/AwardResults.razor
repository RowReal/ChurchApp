        }

    .award-results-rank-row {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
        padding: 7px 0;
        border-bottom: 1px solid #f0f3f1;
    }

    .award-results-rank {
        flex: 0 0 23px;
        height: 23px;
        display: grid;
        place-items: center;
        border-radius: 7px;
        background: #edf5f0;
        color: #276b4f;
        font-size: 11px;
        font-weight: 800;
    }

    .award-results-name {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: #2c4237;
        font-size: 11px;
    }

    .award-results-votes {
        flex: 0 0 auto;
        min-width: 24px;
        text-align: center;
        padding: 4px 6px;
        border-radius: 7px;
        background: #edf3f1;
        color: #255b47;
        font-size: 11px;
        font-weight: 800;
    }

    .award-results-no-votes {
        color: #889a90;
        font-size: 11px;
        padding: 9px 0;
    }

    .award-results-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 11px 16px;
        margin-top: auto;
        border-top: 1px solid #edf1ee;
        background: #fbfdfb;
    }

        .award-results-card-footer span {
            color: #7a8c82;
            font-size: 10px;
        }

    .award-results-view {
        padding: 7px 10px;
        border: 0;
        border-radius: 7px;
        background: #e5f3eb;
        color: #126243;
        font-size: 11px;
        font-weight: 800;
    }

        .award-results-view:hover {
            background: #cce9d9;
        }

        .award-results-view i {
            margin-left: 5px;
        }

    .award-results-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 170px;
        color: #738a7d;
        font-size: 12px;
    }

        .award-results-empty i {
            font-size: 22px;
            color: #44866b;
        }

    .award-results-overlay {
        position: fixed;
        z-index: 2000;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background: rgba(9,32,23,.63);
    }

    .award-results-dialog {
        width: min(720px, 100%);
        max-height: min(86vh, 850px);
        display: flex;
        flex-direction: column;
        border-radius: 15px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 22px 65px rgba(0,0,0,.22);
    }

    .award-results-dialog-head {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 22px 24px 15px;
