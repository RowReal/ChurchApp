@page "/event/award-results"
@layout Components.Layout.MainLayout
@using ChurchApp.Models.Event
@using ChurchApp.Services.Event
@inject AwardService Awards
@inject NavigationManager Nav

<PageTitle>Award Results - BCC ServiceHub</PageTitle>

<div class="award-results-page worker360-page">
    <header class="award-results-hero">
        <div class="award-results-hero-copy">
            <div class="award-results-eyebrow"><i class="fas fa-trophy"></i> EVENT HUB</div>
            <h1>Award Results</h1>
            <span class="award-results-hero-accent">Celebrating outstanding service.</span>
            <p>Review top nominees, their nominators and the supporting nomination justifications.</p>
        </div>
        <button type="button" class="award-results-back" @onclick='() => Nav.NavigateTo("/workspace/event-hub")'>
            <i class="fas fa-arrow-left"></i> Event Hub
        </button>
    </header>

    @if (loading)
    {
        <div class="award-results-empty"><i class="fas fa-spinner fa-spin"></i> Loading award results...</div>
    }
    else if (allowed)
    {
        <section class="award-results-toolbar">
            <div class="award-results-programme">
                <label for="results-programme">Award programme</label>
                <select id="results-programme" class="form-select form-select-sm" @bind="programmeId" @bind:after="LoadAsync">
                    <option value="0">Select a programme</option>
                    @foreach (var programme in programmes)
                    {
                        <option value="@programme.Id">@programme.Name (@programme.Year)</option>
                    }
                </select>
            </div>
            <div class="award-results-stats">
                <div><strong>@results.Count</strong><span>Awards</span></div>
                <div><strong>@results.Sum(x => x.TotalNominations)</strong><span>Nominations</span></div>
                <div><strong>@results.Sum(x => x.Nominees.Count)</strong><span>Nominees</span></div>
            </div>
        </section>

        @if (results.Count == 0)
        {
            <div class="award-results-empty">
                <i class="fas fa-award"></i>
                <strong>No results to display</strong>
                <span>Select a programme or check back after nominations are submitted.</span>
            </div>
        }
        else
        {
            <div class="award-results-grid">
                @foreach (var award in results)
                {
                    <section class="award-results-card" style="--award-line: @LineColour(award.AwardId)" @key="award.AwardId">
                        <div class="award-results-card-head">
                            <div class="award-results-card-icon"><i class="fas fa-award"></i></div>
                            <div class="award-results-card-title">
                                <h2>@award.AwardName</h2>
                                <span>@(award.NomineeType == "Directorate" ? "Directorate award" : IsPaired(award) ? "Male & female rankings" : "Worker award")</span>
                            </div>
                        </div>

                        @if (award.IsOwnDirectorateAward)
                        {
                            <div class="award-results-directorate-list">
                                @foreach (var group in award.DirectorateGroups)
                                {
                                    <div class="award-results-group">
                                        <div class="award-results-group-title">
                                            <i class="fas fa-building"></i> @group.DirectorateName
                                        </div>
                                        @foreach (var nominee in group.Nominees.Take(3))
                                        {
                                            <button type="button" class="award-results-rank-row award-results-clickable"
                                                    @onclick="() => ShowNominee(award, nominee, group.DirectorateName)">
                                                <span class="award-results-rank">@nominee.Rank</span>
                                                <span class="award-results-name">@nominee.Name</span>
                                                <span class="award-results-votes">@nominee.Count</span>
                                                <i class="fas fa-chevron-right"></i>
                                            </button>
                                        }
                                    </div>
                                }
                                @if (award.DirectorateGroups.Count == 0)
                                {
                                    <div class="award-results-no-votes">No nominations yet</div>
                                }
                            </div>
                        }
                        else if (IsPaired(award))
                        {
                            <div class="award-results-pair">
                                @foreach (var gender in new[] { "Male", "Female" })
                                {
                                    <div class="award-results-group">
                                        <div class="award-results-group-title">Top 3 @gender</div>
                                        @foreach (var nominee in TopThree(award, gender))
                                        {
                                            <button type="button" class="award-results-rank-row award-results-clickable"
                                                    @onclick="() => ShowNominee(award, nominee, gender)">
                                                <span class="award-results-rank">@GroupRank(award, nominee, gender)</span>
                                                <span class="award-results-name">@nominee.Name</span>
                                                <span class="award-results-votes">@nominee.Count</span>
                                                <i class="fas fa-chevron-right"></i>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="award-results-group">
                                <div class="award-results-group-title">Top 3 nominees</div>
                                @foreach (var nominee in award.Nominees.Take(3))
                                {
                                    <button type="button" class="award-results-rank-row award-results-clickable"
                                            @onclick='() => ShowNominee(award, nominee, "")'>
                                        <span class="award-results-rank">@nominee.Rank</span>
                                        <span class="award-results-name">@nominee.Name</span>
                                        <span class="award-results-votes">@nominee.Count</span>
                                        <i class="fas fa-chevron-right"></i>
                                    </button>
                                }
                                @if (award.Nominees.Count == 0)
                                {
                                    <div class="award-results-no-votes">No nominations yet</div>
                                }
                            </div>
                        }

                        <div class="award-results-card-footer">
                            <span>@award.TotalNominations nomination(s)</span>
                            <span class="award-results-review-hint">Select a nominee to review evidence</span>
                        </div>
                    </section>
                }
            </div>
        }
    }
</div>

@if (selectedNominee is not null)
{
    <div class="award-results-overlay" @onclick="CloseDetails">
        <section class="award-results-dialog" role="dialog" aria-modal="true"
                 aria-labelledby="award-results-detail-title" @onclick:stopPropagation="true">
            <div class="award-results-dialog-head">
                <div>
                    <span class="award-results-dialog-kicker">NOMINATION REVIEW EVIDENCE</span>
                    <h2 id="award-results-detail-title">@selectedNominee.Name</h2>
                    <p>
                        @selectedAward?.AwardName
                        @if (!string.IsNullOrWhiteSpace(selectedGroup))
                        {
                            <span> · @selectedGroup</span>
                        }
                    </p>
                    <p><strong>@selectedNominee.Count nomination(s)</strong> · Individual nominators and justifications</p>
                </div>
                <button type="button" class="award-results-close" aria-label="Close details" @onclick="CloseDetails">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="award-results-dialog-body">
                @foreach (var entry in selectedNominee.Entries)
                {
                    <article class="award-results-evidence">
                        <div class="award-results-evidence-head">
                            <strong><i class="fas fa-user-check"></i> @entry.NominatorName</strong>
                            <span>@entry.NominatorDirectorate</span>
                        </div>
                        <div class="award-results-evidence-quote">
                            @if (string.IsNullOrWhiteSpace(entry.Justification))
                            {
                                <em>No justification recorded.</em>
                            }
                            else
                            {
                                @entry.Justification
                            }
                        </div>
                        <small>Submitted @entry.SubmittedAtUtc.ToString("dd MMM yyyy, HH:mm") UTC</small>
                    </article>
                }
            </div>
            <div class="award-results-dialog-footer">
                <button type="button" class="award-results-done" @onclick="CloseDetails">Close</button>
            </div>
        </section>
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="award-results-overlay">
        <section class="award-results-error" role="alertdialog" aria-modal="true">
            <i class="fas fa-exclamation-circle"></i>
            <h2>Action required</h2>
            <p>@error</p>
            <button type="button" class="award-results-done" @onclick='() => error = ""'>OK</button>
        </section>
    </div>
}

@code {
    private bool allowed;
    private bool loading = true;
    private int programmeId;
    private string error = "";
    private List<AwardProgramme> programmes = new();
    private List<AwardService.AwardResultDetail> results = new();
    private AwardService.AwardResultDetail? selectedAward;
    private AwardService.ResultNominee? selectedNominee;
    private string selectedGroup = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allowed = await Awards.CanSeeResultsAsync();
            if (!allowed)
            {
                error = "You are not authorised to view award results.";
                return;
            }

            programmes = await Awards.ResultsProgrammesAsync();
            programmeId = programmes.FirstOrDefault()?.Id ?? 0;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            error = "";
            CloseDetails();
            results = programmeId > 0
                ? await Awards.ResultsDashboardAsync(programmeId)
                : new();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private static bool IsPaired(AwardService.AwardResultDetail award) =>
        award.NomineeType == "Worker" && award.SelectionRule == "OneMaleOneFemale";

    private static IEnumerable<AwardService.ResultNominee> GenderNominees(
        AwardService.AwardResultDetail award,
        string gender) =>
        award.Nominees
            .Where(x => string.Equals(x.Gender, gender, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Name);

    private static IEnumerable<AwardService.ResultNominee> TopThree(
        AwardService.AwardResultDetail award,
        string gender) => GenderNominees(award, gender).Take(3);

    private static int GroupRank(
        AwardService.AwardResultDetail award,
        AwardService.ResultNominee nominee,
        string gender) =>
        GenderNominees(award, gender).TakeWhile(x => x.NomineeId != nominee.NomineeId).Count() + 1;

    private static string LineColour(int id)
    {
        string[] colours = { "#14836b", "#3c75ad", "#9b6bb0", "#d38b37", "#3697a2", "#a66b79" };
        return colours[(int)((uint)id % (uint)colours.Length)];
    }

    private void ShowNominee(
        AwardService.AwardResultDetail award,
        AwardService.ResultNominee nominee,
        string group)
    {
        selectedAward = award;
        selectedNominee = nominee;
        selectedGroup = group;
    }

    private void CloseDetails()
    {
        selectedAward = null;
        selectedNominee = null;
        selectedGroup = "";
    }
}

<style>
    .award-results-page {
        padding: 18px 22px 34px;
        max-width: 1600px;
        margin: 0 auto;
    }

    .award-results-hero {
        position: relative;
