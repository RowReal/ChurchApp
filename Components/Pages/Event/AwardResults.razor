        font-size: clamp(23px, 2.5vw, 32px);
        font-weight: 800;
        margin: 0 0 5px;
    }

    .award-results-hero-accent {
        font-size: 14px;
        font-weight: 650;
        color: #d2f0a4;
    }

    .award-results-hero p {
