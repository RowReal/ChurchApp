    }

/* BCC 2026 | unified event and awards design | presentation only */
.bcc-event-checkin-refresh { --bcc-event-green: #145c39; --bcc-event-bright: #278354; --bcc-event-soft: #edf7f0; --bcc-event-border: #d8e7dd; color: #213b2d; }
.bcc-event-checkin-refresh .bcc-page-header {
    background: linear-gradient(105deg,#124f32 0%,#187245 72%,#268756 100%) !important;
    color: #fff !important;
    border: 1px solid #217b4e !important;
    border-radius: 7px !important;
    padding: 17px 21px !important;
    margin-bottom: 14px !important;
    box-shadow: 0 4px 14px rgba(14,76,45,.12) !important;
}
.bcc-event-checkin-refresh .bcc-page-title, .bcc-event-checkin-refresh .bcc-page-header h1, .bcc-event-checkin-refresh .bcc-page-header h2,
.bcc-event-checkin-refresh .award-nom-hero h1, .bcc-event-checkin-refresh .award-results-hero h1, .bcc-event-checkin-refresh .assisted-hero h2,
.bcc-event-checkin-refresh .checkin-report-hero h2 { font-size: clamp(1.24rem,2vw,1.7rem) !important; font-weight: 750 !important; letter-spacing: -.025em; line-height: 1.2; }
.bcc-event-checkin-refresh .bcc-page-header .bcc-page-subtitle, .bcc-event-checkin-refresh .award-nom-hero p,
.bcc-event-checkin-refresh .award-results-hero p, .bcc-event-checkin-refresh .assisted-hero p,
.bcc-event-checkin-refresh .checkin-report-hero .checkin-report-subtitle { color: #e5f5ea !important; }
.bcc-event-checkin-refresh .bcc-card, .bcc-event-checkin-refresh .award-panel, .bcc-event-checkin-refresh .award-results-toolbar,
.bcc-event-checkin-refresh .award-nom-panel, .bcc-event-checkin-refresh .event-setup-section {
    border: 1px solid var(--bcc-event-border) !important;
    border-radius: 8px !important;
    box-shadow: 0 2px 9px rgba(20,92,57,.055);
}
.bcc-event-checkin-refresh .bcc-card-body, .bcc-event-checkin-refresh .card-body { padding: 14px 16px; }
.bcc-event-checkin-refresh .form-control, .bcc-event-checkin-refresh .form-select, .bcc-event-checkin-refresh .form-check-input,
.bcc-event-checkin-refresh input:not([type=checkbox]):not([type=radio]), .bcc-event-checkin-refresh select, .bcc-event-checkin-refresh textarea { border-radius: 5px; }
.bcc-event-checkin-refresh .form-control:focus, .bcc-event-checkin-refresh .form-select:focus, .bcc-event-checkin-refresh input:focus, .bcc-event-checkin-refresh select:focus, .bcc-event-checkin-refresh textarea:focus { border-color: #43a572; box-shadow: 0 0 0 .15rem rgba(39,131,84,.14); }
.bcc-event-checkin-refresh .btn, .bcc-event-checkin-refresh .bcc-btn { border-radius: 5px !important; font-weight: 600; }
.bcc-event-checkin-refresh .btn-primary, .bcc-event-checkin-refresh .btn-success, .bcc-event-checkin-refresh .bcc-btn-primary { background: #187347 !important; border-color: #187347 !important; color: #fff !important; }
.bcc-event-checkin-refresh .btn-primary:hover, .bcc-event-checkin-refresh .btn-success:hover, .bcc-event-checkin-refresh .bcc-btn-primary:hover { background: #105c37 !important; border-color: #105c37 !important; }
.bcc-event-checkin-refresh .table thead th, .bcc-event-checkin-refresh table thead th { background: #e8f4ec; color: #185536; border-bottom-color: #c8e0d0; font-size: .81rem; font-weight: 750; }
.bcc-event-checkin-refresh .table td, .bcc-event-checkin-refresh .table th { padding-top: .48rem; padding-bottom: .48rem; vertical-align: middle; }
.bcc-event-checkin-refresh .badge.bg-primary, .bcc-event-checkin-refresh .badge.bg-success { background: #218451 !important; }
@@media (max-width: 767px) {
    .bcc-event-checkin-refresh .bcc-page-header { padding: 14px 15px !important; gap: 10px !important; }
    .bcc-event-checkin-refresh .bcc-card-body, .bcc-event-checkin-refresh .card-body { padding: 12px !important; }
}

/* Digital pass is a separate overlay, outside the page container. */
.event-pass-overlay { background: rgba(6,36,22,.76) !important; }
.event-pass-modal { border-radius: 9px !important; }
.event-pass-modal .btn-primary { background: #187347 !important; border-color: #187347 !important; }
</style>


@if (error && !string.IsNullOrWhiteSpace(message))
{
    <div class="bcc-error-overlay" role="presentation">
        <div class="bcc-error-dialog" role="alertdialog" aria-modal="true" aria-labelledby="bcc-error-title" aria-describedby="bcc-error-body">
            <div class="bcc-error-heading" id="bcc-error-title"><i class="fas fa-exclamation-circle" aria-hidden="true"></i> Action could not be completed</div>
            <div class="bcc-error-content" id="bcc-error-body">@message</div>
            <div class="bcc-error-actions"><button type="button" class="bcc-error-close" @onclick="DismissError">OK, Close</button></div>
        </div>
    </div>
}
<style>
    .bcc-error-overlay { position:fixed; inset:0; z-index:20000; background:rgba(10,25,20,.65); display:flex; align-items:center; justify-content:center; padding:18px; }
    .bcc-error-dialog { width:100%; max-width:440px; background:white; color:#202b25; border-radius:16px; box-shadow:0 18px 65px rgba(0,0,0,.3); overflow:hidden; }
    .bcc-error-heading { background:#fff1f0; color:#a22121; padding:18px 22px; display:flex; align-items:center; gap:10px; font-weight:700; }
    .bcc-error-content { padding:22px; white-space:pre-wrap; overflow-wrap:anywhere; max-height:45vh; overflow-y:auto; }
    .bcc-error-actions { display:flex; justify-content:flex-end; padding:0 22px 22px; }
    .bcc-error-close { background:#176b45; color:white; border:0; border-radius:8px; padding:9px 24px; font-weight:600; }
</style>


@code {
    private void DismissError() { error = false; message = ""; }

    private bool loading = true, busy, error, showPass, showMealEditor;
    private string qrImage = "";
    private string WorkerName => AuthService.CurrentWorker?.FullName ?? "Registered Worker";
    private void ShowPass() { showMealEditor = false; showPass = checkIn != null; }
    private void ClosePass() => showPass = false;
    private void OpenMealEditor() { if (!CanChangeMeal) return; showPass = false; showMealEditor = true; message = ""; }
    private void CloseMealEditor() { showMealEditor = false; showPass = true; message = ""; }
    private async Task SaveMealFromPassAsync()
    {
        await ChangeMealAsync();
        if (!error) { showMealEditor = false; showPass = true; }
    }
    private void BuildQr()
    {
        qrImage = "";
        if (string.IsNullOrEmpty(checkIn?.VerificationToken)) return;
        var url = Navigation.BaseUri.TrimEnd('/') + "/event/verify/" + checkIn.VerificationToken;
        using var generator = new QRCodeGenerator();
        using var qrData = generator.CreateQrCode(url, QRCodeGenerator.ECCLevel.Q);
        var png = new PngByteQRCode(qrData).GetGraphic(5);
        qrImage = "data:image/png;base64," + Convert.ToBase64String(png);
    }
    private string message = "";
    private List<ChurchEvent> events = new();
    private List<EventMenuOption> meals = new();
    private ChurchEvent? selectedEvent;
    private ChurchApp.Models.Event.EventCheckIn? checkIn;
    private int selectedEventId, mealId, spouseMealId;
    private bool isMarried, spouseAttending, spouseIsWorker = true, hasReservedSpouseSeat;
    private void OnSpouseAttendingChanged(ChangeEventArgs args)
    {
        spouseAttending = string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (!spouseAttending)
        {
            spouseIsWorker = true;
            spouseWorkerId = "";
            spouseGuestName = "";
            spouseMealId = 0;
        }
    }

    private void OnSpouseWorkerChanged(ChangeEventArgs args)
    {
        spouseIsWorker = string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        spouseWorkerId = "";
        spouseGuestName = "";
        spouseMealId = 0;
    }


    private string spouseWorkerId = "", spouseGuestName = "";
    private EventCheckInService.SpouseSeatInfo? spouseSeat;
    private EventCheckInService.SpouseCheckInRequest? SpouseRequest => hasReservedSpouseSeat || !isMarried || !spouseAttending ? null :
        new(true, spouseIsWorker, spouseIsWorker ? spouseWorkerId : null,
            spouseIsWorker ? null : spouseGuestName, spouseIsWorker ? null : spouseMealId);

    private bool CanChangeMeal => selectedEvent?.MenuChangesCloseAtUtc > DateTime.UtcNow;

    protected override async Task OnInitializedAsync() { if (AuthService.IsAuthenticated) await LoadAsync(); else loading = false; }
    private async Task LoadAsync()
    {
        loading = true; message = "";
        try
        {
            events = await CheckInService.OpenEventsAsync();
            selectedEventId = events.Any(e => e.Id == selectedEventId) ? selectedEventId : events.FirstOrDefault()?.Id ?? 0;
            await RefreshSelectedAsync();
        }
        catch (Exception ex) { error = true; message = ex.Message; }
        finally { loading = false; }
    }
    private async Task EventChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id)) { selectedEventId = id; await RefreshSelectedAsync(); }
    }
    private async Task RefreshSelectedAsync()
    {
        selectedEvent = events.FirstOrDefault(e => e.Id == selectedEventId);
        meals = selectedEvent == null ? new() : await CheckInService.MealsAsync(selectedEventId);
        checkIn = selectedEvent == null ? null : await CheckInService.MyCheckInAsync(selectedEventId);
        mealId = checkIn?.EventMenuOptionId ?? 0;
        isMarried = AuthService.CurrentWorker != null && await CheckInService.IsMarriedAsync(AuthService.CurrentWorker.WorkerId);
        hasReservedSpouseSeat = selectedEvent != null && AuthService.CurrentWorker != null &&
            await CheckInService.HasReservedSpouseSeatAsync(selectedEventId, AuthService.CurrentWorker.WorkerId);
        if (hasReservedSpouseSeat) spouseAttending = false;
        spouseSeat = selectedEvent == null || AuthService.CurrentWorker == null ? null :
            await CheckInService.SpouseSeatAsync(selectedEventId, AuthService.CurrentWorker.WorkerId);
        BuildQr();
        if (checkIn != null) ShowPass(); else { showPass = false; showMealEditor = false; }
    }
    private async Task CheckInAsync()
    {
        busy = true; message = "";
        try
        {
            var accuracyLimit = await CheckInService.MaximumGpsAccuracyAsync();
            BrowserLocationResult? bestLocation = null;
            string? lastLocationError = null;
            for (var attempt = 1; attempt <= 3; attempt++)
            {
                if (attempt > 1) await Task.Delay(3000);
                var candidate = await JS.InvokeAsync<BrowserLocationResult>("workerAttendance.getCurrentPosition");
                if (candidate.Success &&
                    double.IsFinite(candidate.Latitude) && double.IsFinite(candidate.Longitude) &&
                    double.IsFinite(candidate.Accuracy) && candidate.Accuracy >= 0 &&
                    candidate.Latitude >= -90 && candidate.Latitude <= 90 &&
                    candidate.Longitude >= -180 && candidate.Longitude <= 180)
                {
                    if (bestLocation == null || candidate.Accuracy < bestLocation.Accuracy)
                        bestLocation = candidate;
                    if (candidate.Accuracy <= accuracyLimit) break;
                }
                else
                {
                    lastLocationError = candidate.Message ?? "Could not obtain a valid location.";
                }
            }
            if (bestLocation == null)
                throw new InvalidOperationException($"Unable to obtain your location after 3 attempts. {lastLocationError}");
            if (bestLocation.Accuracy > accuracyLimit)
                throw new InvalidOperationException(
                    $"Location accuracy is insufficient after 3 attempts (best: {bestLocation.Accuracy:0}m; required: {accuracyLimit:0}m). Enable high-accuracy location services or move to an open area and try again.");
            await CheckInService.CheckInAsync(selectedEventId, mealId, bestLocation.Latitude, bestLocation.Longitude, bestLocation.Accuracy, SpouseRequest);
            await RefreshSelectedAsync(); error = false; message = "Check-in successful. Your seat has been allocated.";
        }
        catch (Exception ex) { error = true; message = ex.Message; }
        finally { busy = false; }
    }
    private async Task ChangeMealAsync()
    {
        busy = true; message = "";
        try { await CheckInService.ChangeMealAsync(selectedEventId, mealId); await RefreshSelectedAsync(); error = false; message = "Meal updated successfully."; }
        catch (Exception ex) { error = true; message = ex.Message; }
        finally { busy = false; }
    }
    private sealed class BrowserLocationResult
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public double Accuracy { get; set; }
    }
    private void GoToDashboard()
    {
        Navigation.NavigateTo("/");
    }
