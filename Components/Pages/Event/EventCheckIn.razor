    }

    .event-pass-qr {
        display: block;
        margin: 0 auto;
        width: 118px;
        height: 118px;
        object-fit: contain;
        padding: 4px;
        background: #fff;
        border: 1px solid #e4d8f3;
        border-radius: 9px
    }

    .event-pass-scan {
