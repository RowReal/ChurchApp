@page "/event/assisted-check-in"
@layout Components.Layout.MainLayout
@using ChurchApp.Models.Event
@using ChurchApp.Services
@using ChurchApp.Services.Event
@using QRCoder
@inject AuthService AuthService
@inject EventCheckInService CheckInService
@inject PrivilegeService PrivilegeService
@inject NavigationManager Navigation

<PageTitle>Assisted Event Check-In - BCC ServiceHub</PageTitle>
<div class="worker360-page assisted-page">
    <div class="assisted-hero"><div class="small text-uppercase">Event Management</div><h2>Assisted Check-In</h2><p>Help a registered worker check in without using their own phone.</p></div>
    @if (loading)
    {
        <div class="bcc-card"><div class="bcc-card-body">Loading...</div></div>
    }
    else if (!authorised)
    {

        <div class="alert alert-danger">Access denied. You need both Event Management and Assisted Check-In privileges.</div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }
        <div class="bcc-card">
            <div class="bcc-card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Event</label>
                        <select class="form-select" value="@eventId" @onchange="OnEventChanged">
                            <option value="0">-- Select an open event --</option>
                            @foreach (var e in events)
                            {
                                <option value="@e.Id">@e.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Worker ID</label>
                        <div class="input-group">
                            <input class="form-control" placeholder="Enter Worker ID" @bind="workerId" @bind:event="oninput" />
                            <button class="btn btn-outline-secondary" disabled="@(busy || eventId == 0 || string.IsNullOrWhiteSpace(workerId))" @onclick="SearchAsync">@(busy ? "Please wait" : "Find Worker")</button>
                        </div>
                    </div>
                </div>
                @if (found != null)
                {
                    <div class="assisted-worker mt-3"><div class="fw-bold">@found.WorkerName</div><div class="small">Worker ID: @found.WorkerId</div><div class="small text-success">Registration confirmed</div></div>
                    @if (found.ExistingCheckIn != null)
                    {
                        <div class="alert alert-info mt-3">This worker has already checked in. Their existing seat is shown below.</div>
                        <button class="btn assisted-primary" @onclick="OpenExistingPass">View Existing Pass</button>
         }
                    else
                    {
                        <div class="mt-3">
                            <label class="form-label fw-bold">Worker's Food Option</label>
                            <select class="form-select" @bind="mealId">
                                <option value="0">-- Choose a meal --</option>
                                @foreach (var meal in meals)
                                {
                                    <option value="@meal.Id">@meal.Name</option>
                                }
                            </select>
                        </div>
                        @if (isMarried && !hasReservedSpouseSeat)
                        {
                            <div class="border rounded p-3 mt-3" style="background:#f6fbf7;border-color:#268756!important">
                                <strong>Will the worker attend with their spouse?</strong>
                                <select class="form-select mt-2" style="max-width:220px" value="@spouseAttending.ToString().ToLowerInvariant()" @onchange="OnSpouseAttendingChanged"><option value="false">No</option><option value="true">Yes</option></select>
                                @if (spouseAttending)
                                {
                                    <label class="form-label mt-3">Is the spouse a BCC worker?</label>
                                    <select class="form-select" style="max-width:220px" value="@spouseIsWorker.ToString().ToLowerInvariant()" @onchange="OnSpouseWorkerChanged"><option value="true">Yes</option><option value="false">No</option></select>
                                    @if (spouseIsWorker)
                                    {
                                        <label class="form-label mt-3">Spouse Worker ID</label>
                                        <input class="form-control" @bind="spouseWorkerId" placeholder="Spouse Worker ID" />
                                    }
                                    else
                                    {
                                        <label class="form-label mt-3">Spouse Name</label>
                                        <input class="form-control" @bind="spouseGuestName" />
                                        <label class="form-label mt-3">Spouse Meal</label>
                                        <select class="form-select" @bind="spouseMealId"><option value="0">-- Choose meal --</option>
                                            @foreach (var meal in meals) { <option value="@meal.Id">@meal.Name</option> }
                                        </select>
                                    }
                                }
                            </div>
                        }
                        @if (hasReservedSpouseSeat)
                        {
                            <div class="alert alert-info mt-3">The worker's spouse has already reserved a seat. Select a meal and confirm check-in to use the reserved seat.</div>
                        }
                        <button class="btn assisted-primary mt-3" disabled="@(busy || mealId == 0)" @onclick="SubmitAsync">@(busy ? "Checking in..." : "Confirm & Check In")</button>
                    }
                }
            </div>
        </div>
    }
</div>
@if (showPass && pass != null && found != null)
{
    <div class="assisted-overlay" @onclick="ClosePass">
        <div class="assisted-pass" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="assisted-pass-head"><button type="button" class="assisted-x" @onclick="ClosePass">×</button><div style="font-size:26px">✓</div><strong>CHECK-IN VERIFIED</strong><div>@events.FirstOrDefault(e => e.Id == eventId)?.Name</div></div>
            <div class="assisted-pass-body">
                @if (!string.IsNullOrEmpty(qrImage))
                {
                    <img class="assisted-qr" src="@qrImage" alt="Verification QR code" />
                    <div class="small text-muted">Scan to verify pass</div>
     }
                <h4>@found.WorkerName</h4><div class="assisted-grid"><div><small>TABLE</small><strong>@pass.EventTable?.TableName</strong></div><div><small>SEAT</small><strong>@pass.SeatNumber</strong></div></div>
                <div class="assisted-meal"><small>SELECTED MENU</small><strong>@pass.EventMenuOption?.Name</strong></div>
                @if (spouseSeat != null)
                {
                    <div class="alert alert-info mt-3"><strong>Spouse: @spouseSeat.Name</strong><div>Table: @spouseSeat.TableName | Seat: @spouseSeat.SeatNumber</div><div>Status: @spouseSeat.Status @if (!string.IsNullOrWhiteSpace(spouseSeat.MealName)) { <span> | Meal: @spouseSeat.MealName</span> }</div></div>
                }
                <p class="assisted-note">Kindly show this to the hostess to direct you to your seat.</p>
                <button class="btn assisted-primary w-100" @onclick="ClosePass">Close Pass</button>
            </div>
        </div>
    </div>
}
<style>
    .assisted-page {
        max-width: 970px;
        margin: auto
    }

    .assisted-hero {
        background: linear-gradient(115deg,#43216e,#8251b4);
        border-radius: 17px;
        color: white;
        padding: 24px;
        margin-bottom: 16px
    }

        .assisted-hero h2 {
            font-weight: 800;
            margin: 5px 0
        }

        .assisted-hero p {
            margin: 0;
            opacity: .9
        }

    .assisted-primary {
        background: #6736a1;
        color: white;
        border: 0;
        padding: 10px 18px;
        font-weight: 700
    }

        .assisted-primary:hover {
            background: #4a2578;
            color: white
        }

    .assisted-worker {
        border-radius: 12px;
        background: #f3eefa;
        padding: 14px;
        color: #4a267b
    }

    .assisted-overlay {
        position: fixed;
        inset: 0;
        background: #1d1035b9;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px
    }

    .assisted-pass {
        position: relative;
        width: min(390px,100%);
        max-height: calc(100dvh - 20px);
        overflow: auto;
        background: white;
        border-radius: 17px
    }

    .assisted-pass-head {
        background: linear-gradient(115deg,#43216e,#8251b4);
        color: white;
        text-align: center;
        padding: 13px 35px;
        font-size: 13px
    }

        .assisted-pass-head strong {
            display: block;
            font-size: 16px
        }

    .assisted-x {
        position: absolute;
        right: 10px;
        top: 8px;
        background: none;
        border: 0;
        color: white;
        font-size: 24px
    }

    .assisted-pass-body {
        text-align: center;
        padding: 12px 17px;
        color: #422765
    }

    .assisted-qr {
        height: 112px;
        width: 112px;
        object-fit: contain
    }

    .assisted-pass-body h4 {
        font-weight: 800;
        margin: 8px 0
    }

    .assisted-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin: 10px 0
    }

        .assisted-grid > div {
            background: #f3eefa;
            padding: 9px;
            border-radius: 10px
        }

        .assisted-grid small, .assisted-meal small {
            display: block;
            color: #765b93;
            font-size: 10px
        }

        .assisted-grid strong {
            display: block;
            font-size: 20px
        }

    .assisted-meal {
        border: 1px solid #e5d7f4;
        padding: 8px;
        border-radius: 10px
    }

        .assisted-meal strong {
            display: block
        }

    .assisted-note {
        background: #f3eefa;
        padding: 8px;
        border-radius: 9px;
        font-size: 12px;
        margin: 9px 0
    }
    @@media(max - height:650px)

    {
        .assisted-pass-head

    {
        padding: 7px 30px
    }

    .assisted-qr {
        height: 90px;
        width: 90px
    }

    .assisted-pass-body {
        padding: 8px 12px
    }

    }


/* BCC 2026 | unified event and awards design | presentation only */
.assisted-page { --bcc-event-green: #145c39; --bcc-event-bright: #278354; --bcc-event-soft: #edf7f0; --bcc-event-border: #d8e7dd; color: #213b2d; }
.assisted-page .assisted-hero {
    background: linear-gradient(105deg,#124f32 0%,#187245 72%,#268756 100%) !important;
    color: #fff !important;
    border: 1px solid #217b4e !important;
    border-radius: 7px !important;
    padding: 17px 21px !important;
    margin-bottom: 14px !important;
    box-shadow: 0 4px 14px rgba(14,76,45,.12) !important;
}
.assisted-page .bcc-page-title, .assisted-page .bcc-page-header h1, .assisted-page .bcc-page-header h2,
.assisted-page .award-nom-hero h1, .assisted-page .award-results-hero h1, .assisted-page .assisted-hero h2,
.assisted-page .checkin-report-hero h2 { font-size: clamp(1.24rem,2vw,1.7rem) !important; font-weight: 750 !important; letter-spacing: -.025em; line-height: 1.2; }
.assisted-page .bcc-page-header .bcc-page-subtitle, .assisted-page .award-nom-hero p,
.assisted-page .award-results-hero p, .assisted-page .assisted-hero p,
.assisted-page .checkin-report-hero .checkin-report-subtitle { color: #e5f5ea !important; }
.assisted-page .bcc-card, .assisted-page .award-panel, .assisted-page .award-results-toolbar,
.assisted-page .award-nom-panel, .assisted-page .event-setup-section {
    border: 1px solid var(--bcc-event-border) !important;
    border-radius: 8px !important;
    box-shadow: 0 2px 9px rgba(20,92,57,.055);
}
.assisted-page .bcc-card-body, .assisted-page .card-body { padding: 14px 16px; }
.assisted-page .form-control, .assisted-page .form-select, .assisted-page .form-check-input,
.assisted-page input:not([type=checkbox]):not([type=radio]), .assisted-page select, .assisted-page textarea { border-radius: 5px; }
.assisted-page .form-control:focus, .assisted-page .form-select:focus, .assisted-page input:focus, .assisted-page select:focus, .assisted-page textarea:focus { border-color: #43a572; box-shadow: 0 0 0 .15rem rgba(39,131,84,.14); }
.assisted-page .btn, .assisted-page .bcc-btn { border-radius: 5px !important; font-weight: 600; }
.assisted-page .btn-primary, .assisted-page .btn-success, .assisted-page .bcc-btn-primary { background: #187347 !important; border-color: #187347 !important; color: #fff !important; }
.assisted-page .btn-primary:hover, .assisted-page .btn-success:hover, .assisted-page .bcc-btn-primary:hover { background: #105c37 !important; border-color: #105c37 !important; }
.assisted-page .table thead th, .assisted-page table thead th { background: #e8f4ec; color: #185536; border-bottom-color: #c8e0d0; font-size: .81rem; font-weight: 750; }
.assisted-page .table td, .assisted-page .table th { padding-top: .48rem; padding-bottom: .48rem; vertical-align: middle; }
.assisted-page .badge.bg-primary, .assisted-page .badge.bg-success { background: #218451 !important; }
@@media (max-width: 767px) {
    .assisted-page .assisted-hero { padding: 14px 15px !important; gap: 10px !important; }
    .assisted-page .bcc-card-body, .assisted-page .card-body { padding: 12px !important; }
}

.assisted-page .assisted-hero { background: linear-gradient(105deg,#124f32,#268756) !important; }
</style>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="bcc-error-overlay" role="presentation">
        <div class="bcc-error-dialog" role="alertdialog" aria-modal="true" aria-labelledby="bcc-error-title" aria-describedby="bcc-error-body">
            <div class="bcc-error-heading" id="bcc-error-title"><i class="fas fa-exclamation-circle" aria-hidden="true"></i> Action could not be completed</div>
            <div class="bcc-error-content" id="bcc-error-body">@errorMessage</div>
            <div class="bcc-error-actions"><button type="button" class="bcc-error-close" @onclick="DismissError">OK, Close</button></div>
        </div>
    </div>
}
<style>
    .bcc-error-overlay { position:fixed; inset:0; z-index:20000; background:rgba(10,25,20,.65); display:flex; align-items:center; justify-content:center; padding:18px; }
    .bcc-error-dialog { width:100%; max-width:440px; background:white; color:#202b25; border-radius:16px; box-shadow:0 18px 65px rgba(0,0,0,.3); overflow:hidden; }
    .bcc-error-heading { background:#fff1f0; color:#a22121; padding:18px 22px; display:flex; align-items:center; gap:10px; font-weight:700; }
    .bcc-error-content { padding:22px; white-space:pre-wrap; overflow-wrap:anywhere; max-height:45vh; overflow-y:auto; }
    .bcc-error-actions { display:flex; justify-content:flex-end; padding:0 22px 22px; }
    .bcc-error-close { background:#176b45; color:white; border:0; border-radius:8px; padding:9px 24px; font-weight:600; }
</style>


@code {
    private void DismissError() { errorMessage = ""; }

    private bool loading = true, authorised, busy, showPass;
    private string workerId = "", errorMessage = "", successMessage = "", qrImage = "";
    private int eventId, mealId, spouseMealId;
    private bool isMarried, spouseAttending, spouseIsWorker = true, hasReservedSpouseSeat;
    private void OnSpouseAttendingChanged(ChangeEventArgs args)
    {
        spouseAttending = string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (!spouseAttending)
        {
            spouseIsWorker = true;
            spouseWorkerId = "";
            spouseGuestName = "";
            spouseMealId = 0;
        }
    }

    private void OnSpouseWorkerChanged(ChangeEventArgs args)
    {
        spouseIsWorker = string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        spouseWorkerId = "";
        spouseGuestName = "";
        spouseMealId = 0;
    }


    private string spouseWorkerId = "", spouseGuestName = "";
    private EventCheckInService.SpouseSeatInfo? spouseSeat;
    private EventCheckInService.SpouseCheckInRequest? SpouseRequest => hasReservedSpouseSeat || !isMarried || !spouseAttending ? null :
        new(true, spouseIsWorker, spouseIsWorker ? spouseWorkerId : null,
            spouseIsWorker ? null : spouseGuestName, spouseIsWorker ? null : spouseMealId);

    private List<ChurchEvent> events = new();
    private List<EventMenuOption> meals = new();
    private EventCheckInService.AssistedWorkerResult? found;
    private ChurchApp.Models.Event.EventCheckIn? pass;
    protected override async Task OnInitializedAsync()
    {
        try { authorised = await CheckInService.CanAssistAsync(); if (authorised) events = await CheckInService.AssistedEventsAsync(); }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { loading = false; }
    }
    private async Task OnEventChanged(ChangeEventArgs e)
    {
        eventId = int.TryParse(e.Value?.ToString(), out var value) ? value : 0;
        found = null; pass = null; mealId = 0; spouseSeat = null; isMarried = false; hasReservedSpouseSeat = false;
        spouseAttending = false; spouseWorkerId = ""; spouseGuestName = ""; spouseMealId = 0;
        errorMessage = ""; successMessage = "";
        meals = eventId == 0 ? new() : await CheckInService.MealsAsync(eventId);
    }
    private async Task SearchAsync()
    {
        busy = true; errorMessage = ""; successMessage = ""; found = null; pass = null;
        try
        {
            found = await CheckInService.FindAssistedWorkerAsync(eventId, workerId);
            mealId = 0; spouseAttending = false; spouseSeat = null;
            isMarried = await CheckInService.IsMarriedAsync(found.WorkerId);
            hasReservedSpouseSeat = await CheckInService.HasReservedSpouseSeatAsync(eventId, found.WorkerId);
            if (found.ExistingCheckIn != null)
                spouseSeat = await CheckInService.SpouseSeatAsync(eventId, found.WorkerId);
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { busy = false; }
    }
    private async Task SubmitAsync()
    {
        if (found == null) return;
        busy = true; errorMessage = ""; successMessage = "";
        try
        {
            pass = await CheckInService.AssistedCheckInAsync(eventId, found.WorkerId, mealId, SpouseRequest);
            found = await CheckInService.FindAssistedWorkerAsync(eventId, found.WorkerId);
            pass = found.ExistingCheckIn;
            spouseSeat = await CheckInService.SpouseSeatAsync(eventId, found.WorkerId);
            BuildQr(); showPass = true; successMessage = "Worker checked in successfully.";
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { busy = false; }
    }
    private void OpenExistingPass() { pass = found?.ExistingCheckIn; BuildQr(); showPass = pass != null; }
    private void ClosePass() { showPass = false; }
    private void BuildQr()
    {
        qrImage = "";
        if (string.IsNullOrWhiteSpace(pass?.VerificationToken)) return;
        var url = Navigation.BaseUri.TrimEnd('/') + "/event/verify/" + pass.VerificationToken;
        using var generator = new QRCodeGenerator();
        using var data = generator.CreateQrCode(url, QRCodeGenerator.ECCLevel.Q);
        qrImage = "data:image/png;base64," + Convert.ToBase64String(new PngByteQRCode(data).GetGraphic(5));
    }
}
