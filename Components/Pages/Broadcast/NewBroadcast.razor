</style>

@code {

    private bool isLoading = true;
    private bool hasAccess;
    private bool isPreviewing;
    private bool isSending;
    private bool showConfirmation;

    private string subject = string.Empty;
    private string messageBody = string.Empty;
    private string audienceType = string.Empty;

    private string senderDisplayLabel = string.Empty;
    private string senderType = string.Empty;

    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string previewMessage =
        "Select an audience to preview recipients.";

    private int recipientCount;

    private BroadcastSenderAccess? senderAccess;

    private List<BroadcastDirectorateOption>
        availableDirectorates = new();

    private HashSet<int>
        selectedDirectorateIds = new();


    private bool IsPSO =>
        string.Equals(
            senderType,
            "PSO",
            StringComparison.OrdinalIgnoreCase);

    private bool IsMeatHead =>
        string.Equals(
            senderType,
            "MEAT",
            StringComparison.OrdinalIgnoreCase);

    private bool IsClusterHead =>
        string.Equals(
            senderType,
            "ClusterHead",
            StringComparison.OrdinalIgnoreCase);

    private bool IsDirectorateHead =>
        string.Equals(
            senderType,
            "DirectorateHead",
            StringComparison.OrdinalIgnoreCase);


    private bool CanChooseAllWorkers =>
        IsPSO || IsMeatHead;

    private bool CanChooseAllLeaders =>
        IsPSO || IsMeatHead;

    private bool CanChooseDirectorates =>
        IsPSO ||
        IsMeatHead ||
        IsClusterHead;


    private bool previewSuccess =>
        recipientCount > 0;


    private bool AllDirectoratesSelected =>
        availableDirectorates.Count > 0 &&
        availableDirectorates.All(
            x => selectedDirectorateIds.Contains(x.Id));


    private bool CanSend =>
        !isSending &&
        !string.IsNullOrWhiteSpace(subject) &&
        !string.IsNullOrWhiteSpace(messageBody) &&
        !string.IsNullOrWhiteSpace(audienceType) &&
        previewSuccess;


    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated ||
            AuthService.CurrentWorker == null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        try
        {
            senderAccess =
                await BroadcastService.GetSenderAccessAsync(
                    AuthService.CurrentWorker.Id);

            hasAccess = senderAccess.CanSend;

            if (!hasAccess)
                return;

            senderType =
                senderAccess.SenderType ?? string.Empty;

            senderDisplayLabel =
                senderAccess.SenderDisplayLabel
                ?? senderType;

            availableDirectorates =
                await BroadcastService
                    .GetAvailableDirectoratesAsync(
                        AuthService.CurrentWorker.Id);

            await SetDefaultAudienceAsync();
        }
        catch (Exception ex)
        {
            hasAccess = false;

            errorMessage =
                $"Unable to load broadcast permissions: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task SetDefaultAudienceAsync()
    {
        if (IsPSO || IsMeatHead)
        {
            await SelectAudienceAsync("AllWorkers");
        }
        else if (IsClusterHead)
        {
            audienceType =
                "SelectedDirectorates";

            selectedDirectorateIds =
                availableDirectorates
                    .Select(x => x.Id)
                    .ToHashSet();

            await RefreshPreviewAsync();
        }
        else if (IsDirectorateHead)
        {
            await SelectAudienceAsync(
                "OwnDirectorate");
        }
    }


    private async Task SelectAudienceAsync(
        string value)
    {
        audienceType = value;

        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (audienceType !=
            "SelectedDirectorates")
        {
            selectedDirectorateIds.Clear();
        }

        await RefreshPreviewAsync();
    }


    private async Task ToggleDirectorateAsync(
        int directorateId,
        bool isSelected)
    {
        if (isSelected)
        {
            selectedDirectorateIds.Add(
                directorateId);
        }
        else
        {
            selectedDirectorateIds.Remove(
                directorateId);
        }

        await RefreshPreviewAsync();
    }


    private async Task ToggleAllDirectoratesAsync()
    {
        if (AllDirectoratesSelected)
        {
            selectedDirectorateIds.Clear();
        }
        else
        {
            selectedDirectorateIds =
                availableDirectorates
                    .Select(x => x.Id)
                    .ToHashSet();
        }

        await RefreshPreviewAsync();
    }


    private async Task RefreshPreviewAsync()
    {
        recipientCount = 0;
        previewMessage = string.Empty;

        if (AuthService.CurrentWorker == null ||
            string.IsNullOrWhiteSpace(
                audienceType))
        {
            previewMessage =
                "Select an audience to preview recipients.";

            return;
        }

        if (audienceType ==
                "SelectedDirectorates" &&
            selectedDirectorateIds.Count == 0)
        {
            previewMessage =
                "Select at least one Directorate.";

            return;
        }

        isPreviewing = true;

        try
        {
            var result =
                await BroadcastService
                    .PreviewRecipientsAsync(
                        AuthService.CurrentWorker.Id,
                        audienceType,
                        selectedDirectorateIds);

            recipientCount =
                result.RecipientCount;

            previewMessage =
                result.Message;
        }
        catch (Exception ex)
        {
            recipientCount = 0;

            previewMessage =
                $"Unable to preview recipients: {ex.Message}";
        }
        finally
        {
            isPreviewing = false;
        }
    }


    private void ShowConfirmation()
    {
        errorMessage = string.Empty;

        if (!CanSend)
        {
            errorMessage =
                "Please complete the message and select a valid audience.";

            return;
        }

        showConfirmation = true;
    }


    private void CloseConfirmation()
    {
        if (!isSending)
        {
            showConfirmation = false;
        }
    }


    private async Task SendBroadcastAsync()
    {
        if (AuthService.CurrentWorker == null ||
            !CanSend)
        {
            return;
        }

        isSending = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            // Recheck the recipients immediately
            // before the actual send.
            await RefreshPreviewAsync();

            if (recipientCount <= 0)
            {
                showConfirmation = false;

                errorMessage =
                    "There are no eligible recipients for this broadcast.";

                return;
            }

            var request =
                new SendBroadcastRequest
                {
                    SenderWorkerId =
                        AuthService.CurrentWorker.Id,

                    Subject =
                        subject.Trim(),

                    MessageBody =
                        messageBody.Trim(),

                    AudienceType =
                        audienceType,

                    SelectedDirectorateIds =
                        selectedDirectorateIds.ToList(),

                    ExpiresAt = null
                };

            var result =
                await BroadcastService
                    .SendBroadcastAsync(request);

            if (!result.Success)
            {
                showConfirmation = false;

                errorMessage =
                    result.Message;

                return;
            }

            showConfirmation = false;

            successMessage =
                $"Broadcast sent successfully to {result.RecipientCount} " +
                (result.RecipientCount == 1
                    ? "recipient."
                    : "recipients.");

            // Return to Broadcast Centre so the
            // sender can immediately see the sent
            // message and its read/unread statistics.
            Navigation.NavigateTo(
                "/broadcast/broadcast-centre");
        }
        catch (Exception ex)
        {
            showConfirmation = false;

            errorMessage =
                $"Unable to send broadcast: {ex.Message}";
        }
        finally
        {
            isSending = false;
        }
    }


    private string GetAudienceCardClass(
        string value)
    {
        return audienceType == value
            ? "audience-card selected"
            : "audience-card";
    }


    private string GetRecipientText()
    {
        return recipientCount == 1
            ? "eligible recipient"
            : "eligible recipients";
    }


    private string GetAudienceDisplayName()
    {
        return audienceType switch
        {
            "AllWorkers" =>
                "All Workers",

            "AllLeaders" =>
                "All Leaders",

            "SelectedDirectorates" =>
                selectedDirectorateIds.Count == 1
                    ? "Selected Directorate"
                    : $"{selectedDirectorateIds.Count} Selected Directorates",

            "OwnDirectorate" =>
                "My Directorate",

            _ =>
                audienceType
        };
    }
}
