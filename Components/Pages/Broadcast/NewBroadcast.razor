@page "/broadcast/new-broadcast"
@layout Components.Layout.MainLayout
@rendermode InteractiveServer

@using ChurchApp.Services
@using ChurchApp.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms

@inject AuthService AuthService
@inject BroadcastService BroadcastService
@inject NavigationManager Navigation

<PageTitle>New Broadcast - BCC ServiceHub</PageTitle>

<div class="new-broadcast-page">

    <div class="broadcast-hero">
        <div>
            <div class="broadcast-kicker">
                COMMUNICATION
            </div>

            <h1>New Broadcast</h1>

            <p>
                Send an official message to workers within your authorised scope.
            </p>
        </div>

        <a href="/broadcast/broadcast-centre"
           class="back-btn">
            <i class="fas fa-arrow-left"></i>
            Broadcast Centre
        </a>
    </div>

    @if (isLoading)
    {
        <div class="page-state">
            <i class="fas fa-spinner fa-spin"></i>
            Loading broadcast permissions...
        </div>
    }
    else if (!hasAccess)
    {
        <div class="page-state">
            <i class="fas fa-lock"></i>

            <div>
                <strong>Access restricted</strong>
                <p>
                    You are not authorised to create broadcasts.
                </p>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle me-2"></i>
                @successMessage
            </div>
        }

        <div class="compose-grid">

            <!-- LEFT: MESSAGE -->
            <div class="compose-card">

                <div class="card-heading">
                    <div class="heading-icon">
                        <i class="fas fa-pen"></i>
                    </div>

                    <div>
                        <h2>Message</h2>
                        <p>Enter the broadcast information.</p>
                    </div>
                </div>

                <div class="form-group">
                    <label>
                        Subject
                        <span class="required">*</span>
                    </label>

                    <InputText class="form-control"
                               @bind-Value="subject"
                               maxlength="200"
                               placeholder="Enter broadcast subject" />

                    <div class="field-hint">
                        @subject.Length / 200 characters
                    </div>
                </div>

                <div class="form-group">
                    <label>
                        Message
                        <span class="required">*</span>
                    </label>

                    <InputTextArea class="form-control message-box"
                                   @bind-Value="messageBody"
                                   placeholder="Type your message here..." />

                    <div class="field-hint">
                        The message will be stored in ServiceHub for recipients to read.
                    </div>
                </div>

            </div>

            <!-- RIGHT: AUDIENCE -->
            <div class="compose-card">

                <div class="card-heading">
                    <div class="heading-icon">
                        <i class="fas fa-users"></i>
                    </div>

                    <div>
                        <h2>Audience</h2>
                        <p>Select who should receive this broadcast.</p>
                    </div>
                </div>

                <div class="sender-scope">
                    <span>Sending as</span>
                    <strong>@senderDisplayLabel</strong>
                </div>

                @if (CanChooseAllWorkers)
                {
                    <label class="@GetAudienceCardClass("AllWorkers")">
                        <input type="radio"
                               name="audience"
                               value="AllWorkers"
                               checked="@(audienceType == "AllWorkers")"
                               @onchange="@(() => SelectAudienceAsync("AllWorkers"))" />

                        <div>
                            <strong>All Workers</strong>
                            <span>
                                Send to all eligible active workers.
                            </span>
                        </div>
                    </label>
                }

                @if (CanChooseAllLeaders)
                {
                    <label class="@GetAudienceCardClass("AllLeaders")">
                        <input type="radio"
                               name="audience"
                               value="AllLeaders"
                               checked="@(audienceType == "AllLeaders")"
                               @onchange="@(() => SelectAudienceAsync("AllLeaders"))" />

                        <div>
                            <strong>All Leaders</strong>
                            <span>
                                Cluster Heads, Directorate leadership
                                and Service leadership.
                            </span>
                        </div>
                    </label>
                }

                @if (CanChooseDirectorates)
                {
                    <label class="@GetAudienceCardClass("SelectedDirectorates")">
                        <input type="radio"
                               name="audience"
                               value="SelectedDirectorates"
                               checked="@(audienceType == "SelectedDirectorates")"
                               @onchange="@(() => SelectAudienceAsync("SelectedDirectorates"))" />

                        <div>
                            <strong>
                                @(IsClusterHead
                                    ? "Directorates in My Cluster"
                                    : "Selected Directorates")
                            </strong>

                            <span>
                                Select one or more Directorates.
                            </span>
                        </div>
                    </label>
                }

                @if (IsDirectorateHead)
                {
                    <label class="@GetAudienceCardClass("OwnDirectorate")">
                        <input type="radio"
                               name="audience"
                               value="OwnDirectorate"
                               checked="@(audienceType == "OwnDirectorate")"
                               @onchange="@(() => SelectAudienceAsync("OwnDirectorate"))" />

                        <div>
                            <strong>My Directorate</strong>
                            <span>
                                Send to eligible workers in your Directorate.
                            </span>
                        </div>
                    </label>
                }

                @if (audienceType == "SelectedDirectorates")
                {
                    <div class="directorate-section">

                        <div class="directorate-heading">
                            <strong>Select Directorates</strong>

                            @if (availableDirectorates.Count > 1)
                            {
                                <button type="button"
                                        class="select-all-btn"
                                        @onclick="ToggleAllDirectoratesAsync">
                                    @(AllDirectoratesSelected
                                        ? "Clear All"
                                        : "Select All")
                                </button>
                            }
                        </div>

                        @if (availableDirectorates.Count == 0)
                        {
                            <div class="no-directorates">
                                No Directorates are available within your scope.
                            </div>
                        }
                        else
                        {
                            <div class="directorate-options">

                                @foreach (var directorate
                                    in availableDirectorates)
                                {
                                    <label class="directorate-option">

                                        <input type="checkbox"
                                               checked="@selectedDirectorateIds.Contains(directorate.Id)"
                                               @onchange="@(async e => await ToggleDirectorateAsync(
                                                   directorate.Id,
                                                   (bool)(e.Value ?? false)))" />

                                        <span>
                                            @directorate.Name
                                        </span>

                                    </label>
                                }

                            </div>
                        }

                    </div>
                }

                <div class="recipient-preview
                            @(previewSuccess ? "ready" : "")">

                    <div class="preview-icon">
                        <i class="fas fa-user-check"></i>
                    </div>

                    <div>
                        <span>Eligible Recipients</span>

                        @if (isPreviewing)
                        {
                            <strong>
                                <i class="fas fa-spinner fa-spin"></i>
                                Checking...
                            </strong>
                        }
                        else if (previewSuccess)
                        {
                            <strong>@recipientCount</strong>
                            <small>
                                @GetRecipientText()
                            </small>
                        }
                        else
                        {
                            <strong>—</strong>
                            <small>
                                @previewMessage
                            </small>
                        }
                    </div>

                </div>

            </div>

        </div>

        <div class="send-panel">

            <div class="send-note">
                <i class="fas fa-info-circle"></i>

                <span>
                    Review the subject, message and audience before sending.
                    A sent broadcast cannot be recalled from recipients' inboxes.
                </span>
            </div>

            <div class="send-actions">

                <a href="/broadcast/broadcast-centre"
                   class="cancel-btn">
                    Cancel
                </a>

                <button type="button"
                        class="send-btn"
                        disabled="@(!CanSend)"
                        @onclick="ShowConfirmation">
                    <i class="fas fa-paper-plane"></i>
                    Send Broadcast
                </button>

            </div>

        </div>

        @if (showConfirmation)
        {
            <div class="confirm-overlay">

                <div class="confirm-card">

                    <div class="confirm-icon">
                        <i class="fas fa-paper-plane"></i>
                    </div>

                    <h3>Send this broadcast?</h3>

                    <p>
                        You are about to send
                        <strong>@recipientCount</strong>
                        @(recipientCount == 1 ? "message" : "messages")
                        to the selected audience.
                    </p>

                    <div class="confirm-summary">

                        <div>
                            <span>Subject</span>
                            <strong>@subject.Trim()</strong>
                        </div>

                        <div>
                            <span>Audience</span>
                            <strong>@GetAudienceDisplayName()</strong>
                        </div>

                        <div>
                            <span>Recipients</span>
                            <strong>@recipientCount</strong>
                        </div>

                    </div>

                    <div class="confirm-actions">

                        <button type="button"
                                class="confirm-cancel"
                                disabled="@isSending"
                                @onclick="CloseConfirmation">
                            Go Back
                        </button>

                        <button type="button"
                                class="confirm-send"
                                disabled="@isSending"
                                @onclick="SendBroadcastAsync">

                            @if (isSending)
                            {
                                <i class="fas fa-spinner fa-spin"></i>
                                <span>Sending...</span>
                            }
                            else
                            {
                                <i class="fas fa-paper-plane"></i>
                                <span>Confirm &amp; Send</span>
                            }

                        </button>

                    </div>

                </div>

            </div>
        }
    }

</div>

<style>

