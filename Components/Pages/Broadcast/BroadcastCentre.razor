@code {

    private bool isLoading = true;
    private bool isRefreshing;
    private bool hasAccess;

    private string pageMessage = string.Empty;
    private bool pageMessageIsError;

    private List<SentBroadcastListItem> sentBroadcasts = new();

    private string searchText = string.Empty;
    private string selectedAudience = "All";
    private string selectedMonth = string.Empty;
    private string fromDate = string.Empty;
    private string toDate = string.Empty;

    private bool showDetailsModal;
    private bool isLoadingDetails;
    private bool isEditMode;
    private bool isSaving;

    private SentBroadcastDetails? selectedBroadcast;

    private string modalError = string.Empty;

    private string editSubject = string.Empty;
    private string editMessageBody = string.Empty;
    private string editAudienceType = string.Empty;

    private HashSet<int> editDirectorateIds = new();
    private List<BroadcastDirectorateOption> availableDirectorates = new();

    private int editRecipientCount;
    private bool isPreviewingEdit;
    private string editPreviewMessage = string.Empty;

    private string senderType = string.Empty;

    private bool showRemoveConfirmation;
    private bool isRemoving;


    private int TotalRecipients =>
        sentBroadcasts.Sum(x => x.RecipientCount);

    private int TotalRead =>
        sentBroadcasts.Sum(x => x.ReadCount);

    private int TotalUnread =>
        sentBroadcasts.Sum(x => x.UnreadCount);


    private bool HasActiveFilter =>
        !string.IsNullOrWhiteSpace(searchText) ||
        selectedAudience != "All" ||
        !string.IsNullOrWhiteSpace(selectedMonth) ||
        !string.IsNullOrWhiteSpace(fromDate) ||
        !string.IsNullOrWhiteSpace(toDate);


    private bool IsEditingPSO =>
        string.Equals(senderType, "PSO",
            StringComparison.OrdinalIgnoreCase);

    private bool IsEditingMeatHead =>
        string.Equals(senderType, "MEAT",
            StringComparison.OrdinalIgnoreCase);

    private bool IsEditingClusterHead =>
        string.Equals(senderType, "ClusterHead",
            StringComparison.OrdinalIgnoreCase);

    private bool IsEditingDirectorateHead =>
        string.Equals(senderType, "DirectorateHead",
            StringComparison.OrdinalIgnoreCase);

    private bool CanEditAllWorkers =>
        IsEditingPSO || IsEditingMeatHead;

    private bool CanEditAllLeaders =>
        IsEditingPSO || IsEditingMeatHead;

    private bool CanEditSelectedDirectorates =>
        IsEditingPSO ||
        IsEditingMeatHead ||
        IsEditingClusterHead;

    private bool CanEditOwnDirectorate =>
        IsEditingDirectorateHead;


    private bool AllEditDirectoratesSelected =>
        availableDirectorates.Count > 0 &&
        availableDirectorates.All(
            x => editDirectorateIds.Contains(x.Id));


    private bool CanSaveEdit =>
        !isSaving &&
        !isPreviewingEdit &&
        !string.IsNullOrWhiteSpace(editSubject) &&
        !string.IsNullOrWhiteSpace(editMessageBody) &&
        !string.IsNullOrWhiteSpace(editAudienceType) &&
        editRecipientCount > 0;


    private List<MonthFilterOption> AvailableMonths =>
        sentBroadcasts
            .Select(x => ConvertToNigeriaTime(x.SentAt))
            .GroupBy(x => new { x.Year, x.Month })
            .OrderByDescending(x => x.Key.Year)
            .ThenByDescending(x => x.Key.Month)
            .Select(x => new MonthFilterOption
            {
                Value = $"{x.Key.Year:D4}-{x.Key.Month:D2}",
                Label = new DateTime(
                    x.Key.Year,
                    x.Key.Month,
                    1).ToString("MMMM yyyy")
            })
            .ToList();


    private List<SentBroadcastListItem> FilteredBroadcasts
    {
        get
        {
            IEnumerable<SentBroadcastListItem> query =
                sentBroadcasts;

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var value = searchText.Trim();

                query = query.Where(x =>
                    x.Subject.Contains(
                        value,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    x.DirectorateNames.Any(d =>
                        d.Contains(
                            value,
                            StringComparison.OrdinalIgnoreCase)));
            }

            if (selectedAudience != "All")
            {
                query = query.Where(x =>
                    x.AudienceType == selectedAudience);
            }

            if (!string.IsNullOrWhiteSpace(selectedMonth))
            {
                query = query.Where(x =>
                {
                    var date =
                        ConvertToNigeriaTime(x.SentAt);

                    return
                        $"{date.Year:D4}-{date.Month:D2}"
                        == selectedMonth;
                });
            }

            if (DateTime.TryParse(fromDate, out var from))
            {
                query = query.Where(x =>
                    ConvertToNigeriaTime(x.SentAt).Date
                    >= from.Date);
            }

            if (DateTime.TryParse(toDate, out var to))
            {
                query = query.Where(x =>
                    ConvertToNigeriaTime(x.SentAt).Date
                    <= to.Date);
            }

            return query
                .OrderByDescending(x => x.SentAt)
                .ToList();
        }
    }


    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated ||
            AuthService.CurrentWorker == null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        try
        {
            var access =
                await BroadcastService.GetSenderAccessAsync(
                    AuthService.CurrentWorker.Id);

            hasAccess = access.CanSend;

            if (!hasAccess)
                return;

            senderType =
                access.SenderType ?? string.Empty;

            availableDirectorates =
                await BroadcastService
                    .GetAvailableDirectoratesAsync(
                        AuthService.CurrentWorker.Id);

            await LoadBroadcastsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Unable to load Broadcast Centre: {ex.Message}");

            hasAccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task LoadBroadcastsAsync()
    {
        if (AuthService.CurrentWorker == null)
            return;

        isRefreshing = true;

        try
        {
            sentBroadcasts =
                await BroadcastService
                    .GetSentBroadcastsAsync(
                        AuthService.CurrentWorker.Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            sentBroadcasts = new();
        }
        finally
        {
            isRefreshing = false;
        }
    }


    /* VIEW */

    private async Task OpenBroadcastAsync(int broadcastId)
    {
        if (AuthService.CurrentWorker == null)
            return;

        showDetailsModal = true;
        isLoadingDetails = true;
        isEditMode = false;
        modalError = string.Empty;
        selectedBroadcast = null;

        try
        {
            selectedBroadcast =
                await BroadcastService
                    .GetBroadcastDetailsAsync(
                        AuthService.CurrentWorker.Id,
                        broadcastId);

            if (selectedBroadcast == null)
            {
                modalError =
                    "The broadcast could not be found.";
            }
        }
        catch (Exception ex)
        {
            modalError =
                $"Unable to load broadcast: {ex.Message}";
        }
        finally
        {
            isLoadingDetails = false;
        }
    }


    private void CloseDetailsModal()
    {
        if (isSaving || isRemoving)
            return;

        showDetailsModal = false;
        isEditMode = false;
        selectedBroadcast = null;
        modalError = string.Empty;
    }


    /* EDIT */

    private async Task BeginEditAsync()
    {
        if (selectedBroadcast == null)
            return;

        modalError = string.Empty;

        editSubject =
            selectedBroadcast.Subject;

        editMessageBody =
            selectedBroadcast.MessageBody;

        editAudienceType =
            selectedBroadcast.AudienceType;

        editDirectorateIds =
            selectedBroadcast
                .SelectedDirectorateIds
                .ToHashSet();

        isEditMode = true;

        await RefreshEditPreviewAsync();
    }


    private void CancelEdit()
    {
        if (isSaving)
            return;

        isEditMode = false;
        modalError = string.Empty;
    }


    private async Task OnEditAudienceChanged(
        ChangeEventArgs e)
    {
        editAudienceType =
            e.Value?.ToString()
            ?? string.Empty;

        if (editAudienceType !=
            "SelectedDirectorates")
        {
            editDirectorateIds.Clear();
        }

        await RefreshEditPreviewAsync();
    }


    private async Task ToggleEditDirectorateAsync(
        int directorateId,
        bool selected)
    {
        if (selected)
            editDirectorateIds.Add(directorateId);
        else
            editDirectorateIds.Remove(directorateId);

        await RefreshEditPreviewAsync();
    }


    private async Task ToggleAllEditDirectoratesAsync()
    {
        if (AllEditDirectoratesSelected)
        {
            editDirectorateIds.Clear();
        }
        else
        {
            editDirectorateIds =
                availableDirectorates
                    .Select(x => x.Id)
                    .ToHashSet();
        }

        await RefreshEditPreviewAsync();
    }


    private async Task RefreshEditPreviewAsync()
    {
        editRecipientCount = 0;
        editPreviewMessage = string.Empty;

        if (AuthService.CurrentWorker == null)
            return;

        if (string.IsNullOrWhiteSpace(
            editAudienceType))
        {
            editPreviewMessage =
                "Select an audience.";
            return;
        }

        if (editAudienceType ==
                "SelectedDirectorates" &&
            editDirectorateIds.Count == 0)
        {
            editPreviewMessage =
                "Select at least one Directorate.";
            return;
        }

        isPreviewingEdit = true;

        try
        {
            var result =
                await BroadcastService
                    .PreviewRecipientsAsync(
                        AuthService.CurrentWorker.Id,
                        editAudienceType,
                        editDirectorateIds);

            editRecipientCount =
                result.RecipientCount;

            editPreviewMessage =
                result.Message;
        }
        catch (Exception ex)
        {
            editPreviewMessage =
                $"Unable to preview recipients: {ex.Message}";
        }
        finally
        {
            isPreviewingEdit = false;
        }
    }


    private async Task SaveEditAsync()
    {
        if (AuthService.CurrentWorker == null ||
            selectedBroadcast == null ||
            !CanSaveEdit)
        {
            return;
        }

        isSaving = true;
        modalError = string.Empty;

        try
        {
            // Revalidate recipients immediately
            // before updating.
            await RefreshEditPreviewAsync();

            if (editRecipientCount <= 0)
            {
                modalError =
                    "There are no eligible recipients for this audience.";
                return;
            }

            var result =
                await BroadcastService
                    .UpdateBroadcastAsync(
                        new UpdateBroadcastRequest
                        {
                            BroadcastMessageId =
                                selectedBroadcast.BroadcastMessageId,

                            SenderWorkerId =
                                AuthService.CurrentWorker.Id,

                            Subject =
                                editSubject.Trim(),

                            MessageBody =
                                editMessageBody.Trim(),

                            AudienceType =
                                editAudienceType,

                            SelectedDirectorateIds =
                                editDirectorateIds.ToList()
                        });

            if (!result.Success)
            {
                modalError = result.Message;
                return;
            }

            var id =
                selectedBroadcast.BroadcastMessageId;

            await LoadBroadcastsAsync();

            selectedBroadcast =
                await BroadcastService
                    .GetBroadcastDetailsAsync(
                        AuthService.CurrentWorker.Id,
                        id);

            isEditMode = false;

            pageMessage =
                result.Message;

            pageMessageIsError = false;
        }
        catch (Exception ex)
        {
            modalError =
                $"Unable to update broadcast: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }


    /* REMOVE */

    private void ShowRemoveConfirmation()
    {
        showRemoveConfirmation = true;
    }


    private void CancelRemove()
    {
        if (!isRemoving)
            showRemoveConfirmation = false;
    }


    private async Task RemoveBroadcastAsync()
    {
        if (AuthService.CurrentWorker == null ||
            selectedBroadcast == null)
        {
            return;
        }

        isRemoving = true;

        try
        {
            var removed =
                await BroadcastService
                    .RemoveBroadcastAsync(
                        AuthService.CurrentWorker.Id,
                        selectedBroadcast.BroadcastMessageId);

            if (!removed)
            {
                showRemoveConfirmation = false;

                modalError =
                    "The broadcast could not be removed.";

                return;
            }

            showRemoveConfirmation = false;
            showDetailsModal = false;
            selectedBroadcast = null;

            await LoadBroadcastsAsync();

            pageMessage =
                "Broadcast removed successfully.";

            pageMessageIsError = false;
        }
        catch (Exception ex)
        {
            showRemoveConfirmation = false;

            modalError =
                $"Unable to remove broadcast: {ex.Message}";
        }
        finally
        {
            isRemoving = false;
        }
    }


    /* FILTER */

    private void OnSearchChanged(ChangeEventArgs e)
        => searchText =
            e.Value?.ToString() ?? string.Empty;

    private void SetAudienceFilter(string value)
        => selectedAudience = value;

    private void OnMonthChanged(ChangeEventArgs e)
        => selectedMonth =
            e.Value?.ToString() ?? string.Empty;

    private void OnFromDateChanged(ChangeEventArgs e)
        => fromDate =
            e.Value?.ToString() ?? string.Empty;

    private void OnToDateChanged(ChangeEventArgs e)
        => toDate =
            e.Value?.ToString() ?? string.Empty;


    private void ClearFilters()
    {
        searchText = string.Empty;
        selectedAudience = "All";
        selectedMonth = string.Empty;
        fromDate = string.Empty;
        toDate = string.Empty;
    }


  private RenderFragment AudienceFilterButton(
    string value,
    string icon,
    string label,
    int count)
{
    return builder =>
    {
        var sequence = 0;

        builder.OpenElement(sequence++, "button");
        builder.AddAttribute(sequence++, "type", "button");

        builder.AddAttribute(
            sequence++,
            "class",
            selectedAudience == value
                ? "audience-filter-btn active"
                : "audience-filter-btn");

        builder.AddAttribute(
            sequence++,
            "onclick",
            EventCallback.Factory.Create(
                this,
                () => SetAudienceFilter(value)));

        builder.OpenElement(sequence++, "span");

        builder.OpenElement(sequence++, "i");
        builder.AddAttribute(sequence++, "class", icon);
        builder.CloseElement();

        builder.AddContent(sequence++, label);

        builder.CloseElement();

        builder.OpenElement(sequence++, "strong");
        builder.AddContent(sequence++, count);
        builder.CloseElement();

        builder.CloseElement();
    };
}

    private int GetAudienceCount(string type)
        => sentBroadcasts.Count(
            x => x.AudienceType == type);


    private string GetResultDescription()
        => !HasActiveFilter
            ? $"All {sentBroadcasts.Count} sent broadcasts"
            : $"{FilteredBroadcasts.Count} matching broadcast" +
              (FilteredBroadcasts.Count == 1 ? "" : "s");


    private static string GetAudienceLabel(string type)
        => type switch
        {
            "AllWorkers" => "All Workers",
            "AllLeaders" => "All Leaders",
            "SelectedDirectorates" => "Selected Directorates",
            "OwnDirectorate" => "Own Directorate",
            _ => type
        };


    private static DateTime ConvertToNigeriaTime(
        DateTime utcDate)
    {
        try
        {
            var zone =
                TimeZoneInfo.FindSystemTimeZoneById(
                    "Africa/Lagos");

            var utc =
                DateTime.SpecifyKind(
                    utcDate,
                    DateTimeKind.Utc);

            return TimeZoneInfo.ConvertTimeFromUtc(
                utc,
                zone);
        }
        catch
        {
            return utcDate.AddHours(1);
        }
    }


    private static string FormatNigeriaDate(
        DateTime utcDate)
        => ConvertToNigeriaTime(utcDate)
            .ToString("dd MMM yyyy, h:mm tt");


    private class MonthFilterOption
    {
        public string Value { get; set; }
            = string.Empty;

        public string Label { get; set; }
            = string.Empty;
    }
}