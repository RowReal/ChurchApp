@page "/broadcast/broadcast-centre"
@rendermode InteractiveServer

@using ChurchApp.Services
@using ChurchApp.Models
@using Microsoft.AspNetCore.Components

@inject AuthService AuthService
@inject BroadcastService BroadcastService
@inject NavigationManager Navigation

<PageTitle>Broadcast Centre</PageTitle>

<div class="broadcast-page">

    <!-- HERO -->
    <div class="broadcast-hero">
        <div>
            <div class="broadcast-kicker">COMMUNICATION</div>
            <h1>Broadcast Centre</h1>
            <p>Create, review and manage messages you have sent.</p>
        </div>

        <a href="/broadcast/new-broadcast"
           class="new-broadcast-btn">
            <i class="fas fa-plus"></i>
            New Broadcast
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(pageMessage))
    {
        <div class="alert @(pageMessageIsError ? "alert-danger" : "alert-success") compact-alert">
            <i class="fas @(pageMessageIsError ? "fa-exclamation-circle" : "fa-check-circle") me-2"></i>
            @pageMessage
        </div>
    }

    @if (isLoading)
    {
        <div class="broadcast-state">
            <i class="fas fa-spinner fa-spin"></i>
            <span>Loading Broadcast Centre...</span>
        </div>
    }
    else if (!hasAccess)
    {
        <div class="broadcast-state">
            <i class="fas fa-lock"></i>
            <div>
                <strong>Access restricted</strong>
                <p>You are not authorised to send broadcasts.</p>
            </div>
        </div>
    }
    else
    {
        <!-- SUMMARY -->
        <div class="summary-grid">

            <div class="summary-card">
                <div class="summary-icon">
                    <i class="fas fa-paper-plane"></i>
                </div>
                <div>
                    <span>Broadcasts</span>
                    <strong>@sentBroadcasts.Count</strong>
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    <span>Recipients</span>
                    <strong>@TotalRecipients</strong>
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-icon">
                    <i class="fas fa-envelope-open"></i>
                </div>
                <div>
                    <span>Read</span>
                    <strong>@TotalRead</strong>
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-icon">
                    <i class="fas fa-envelope"></i>
                </div>
                <div>
                    <span>Unread</span>
                    <strong>@TotalUnread</strong>
                </div>
            </div>

        </div>

        <!-- TWO COLUMN AREA -->
        <div class="broadcast-workspace">

            <!-- LEFT FILTER -->
            <aside class="filter-panel">

                <div class="filter-header">
                    <div>
                        <h2>
                            <i class="fas fa-filter"></i>
                            Filter
                        </h2>
                        <p>Find sent broadcasts</p>
                    </div>

                    @if (HasActiveFilter)
                    {
                        <button type="button"
                                class="clear-filter-btn"
                                @onclick="ClearFilters">
                            Clear
                        </button>
                    }
                </div>

                <div class="filter-section">
                    <label>Search Message</label>

                    <div class="search-box">
                        <i class="fas fa-search"></i>

                        <input type="text"
                               class="form-control"
                               value="@searchText"
                               @oninput="OnSearchChanged"
                               placeholder="Search subject..." />
                    </div>
                </div>

                <div class="filter-section">
                    <label>Audience</label>

                    <div class="audience-filter-list">

                        @AudienceFilterButton(
                            "All",
                            "fas fa-inbox",
                            "All Messages",
                            sentBroadcasts.Count)

                        @AudienceFilterButton(
                            "AllWorkers",
                            "fas fa-users",
                            "All Workers",
                            GetAudienceCount("AllWorkers"))

                        @AudienceFilterButton(
                            "AllLeaders",
                            "fas fa-user-tie",
                            "All Leaders",
                            GetAudienceCount("AllLeaders"))

                        @AudienceFilterButton(
                            "SelectedDirectorates",
                            "fas fa-layer-group",
                            "Directorates",
                            GetAudienceCount("SelectedDirectorates"))

                        @AudienceFilterButton(
                            "OwnDirectorate",
                            "fas fa-building",
                            "My Directorate",
                            GetAudienceCount("OwnDirectorate"))

                    </div>
                </div>

                <div class="filter-section">
                    <label>Month</label>

                    <select class="form-select"
                            value="@selectedMonth"
                            @onchange="OnMonthChanged">

                        <option value="">All Months</option>

                        @foreach (var month in AvailableMonths)
                        {
                            <option value="@month.Value">
                                @month.Label
                            </option>
                        }

                    </select>
                </div>

                <div class="filter-section">
                    <label>Date Range</label>

                    <div class="date-grid">

                        <div>
                            <span>From</span>
                            <input type="date"
                                   class="form-control"
                                   value="@fromDate"
                                   @onchange="OnFromDateChanged" />
                        </div>

                        <div>
                            <span>To</span>
                            <input type="date"
                                   class="form-control"
                                   value="@toDate"
                                   @onchange="OnToDateChanged" />
                        </div>

                    </div>
                </div>

                <div class="filter-result-box">
                    <span>Showing</span>
                    <strong>@FilteredBroadcasts.Count</strong>
                    <small>of @sentBroadcasts.Count broadcasts</small>
                </div>

            </aside>


            <!-- RIGHT RESULTS -->
            <section class="results-panel">

                <div class="results-header">
                    <div>
                        <h2>Sent Broadcasts</h2>
                        <p>@GetResultDescription()</p>
                    </div>

                    <button type="button"
                            class="refresh-btn"
                            @onclick="LoadBroadcastsAsync"
                            disabled="@isRefreshing">
                        <i class="fas fa-sync-alt @(isRefreshing ? "fa-spin" : "")"></i>
                        Refresh
                    </button>
                </div>

                @if (sentBroadcasts.Count == 0)
                {
                    <div class="empty-state">
                        <i class="fas fa-bullhorn"></i>
                        <h3>No broadcasts yet</h3>
                        <p>Your sent broadcasts will appear here.</p>

                        <a href="/broadcast/new-broadcast"
                           class="empty-action">
                            Create your first broadcast
                        </a>
                    </div>
                }
                else if (FilteredBroadcasts.Count == 0)
                {
                    <div class="empty-state">
                        <i class="fas fa-search"></i>
                        <h3>No matching broadcasts</h3>
                        <p>Try changing or clearing your filters.</p>

                        <button type="button"
                                class="empty-action"
                                @onclick="ClearFilters">
                            Clear Filters
                        </button>
                    </div>
                }
                else
                {
                    <div class="broadcast-list">

                        @foreach (var item in FilteredBroadcasts)
                        {
                            <div class="broadcast-item">

                                <div class="broadcast-main">

                                    <div class="broadcast-subject">
                                        @item.Subject
                                    </div>

                                    <div class="broadcast-meta">
                                        <span>
                                            <i class="fas fa-layer-group"></i>
                                            @GetAudienceLabel(item.AudienceType)
                                        </span>

                                        <span>
                                            <i class="far fa-clock"></i>
                                            @FormatNigeriaDate(item.SentAt)
                                        </span>
                                    </div>

                                    @if (item.DirectorateNames.Any())
                                    {
                                        <div class="directorate-list">
                                            @foreach (var name in item.DirectorateNames)
                                            {
                                                <span class="directorate-tag">
                                                    @name
                                                </span>
                                            }
                                        </div>
                                    }

                                </div>

                                <div class="broadcast-right">

                                    <div class="broadcast-stats">
                                        <div class="stat-block">
                                            <strong>@item.RecipientCount</strong>
                                            <span>Recipients</span>
                                        </div>

                                        <div class="stat-block">
                                            <strong>@item.ReadCount</strong>
                                            <span>Read</span>
                                        </div>

                                        <div class="stat-block unread">
                                            <strong>@item.UnreadCount</strong>
                                            <span>Unread</span>
                                        </div>
                                    </div>

                                    <button type="button"
                                            class="view-btn"
                                            @onclick="() => OpenBroadcastAsync(item.BroadcastMessageId)">
                                        <i class="fas fa-eye"></i>
                                        View
                                    </button>

                                </div>

                            </div>
                        }

                    </div>
                }

            </section>

        </div>
    }

</div>


<!-- =========================================================
     VIEW / EDIT POPUP
     ========================================================= -->

@if (showDetailsModal)
{
    <div class="modal-overlay">

        <div class="message-modal">

            @if (isLoadingDetails)
            {
                <div class="modal-loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    Loading message...
                </div>
            }
            else if (selectedBroadcast != null)
            {
                <div class="modal-header">

                    <div>
                        <div class="modal-kicker">
                            @(isEditMode ? "EDIT BROADCAST" : "BROADCAST DETAILS")
                        </div>

                        <h3>
                            @(isEditMode
                                ? "Edit Broadcast"
                                : selectedBroadcast.Subject)
                        </h3>
                    </div>

                    <button type="button"
                            class="modal-close"
                            disabled="@isSaving"
                            @onclick="CloseDetailsModal">
                        <i class="fas fa-times"></i>
                    </button>

                </div>

                @if (!string.IsNullOrWhiteSpace(modalError))
                {
                    <div class="modal-alert error">
                        <i class="fas fa-exclamation-circle"></i>
                        @modalError
                    </div>
                }

                @if (!isEditMode)
                {
                    <!-- VIEW MODE -->

                    <div class="message-summary">

                        <div>
                            <span>Audience</span>
                            <strong>
                                @GetAudienceLabel(selectedBroadcast.AudienceType)
                            </strong>
                        </div>

                        <div>
                            <span>Sent</span>
                            <strong>
                                @FormatNigeriaDate(selectedBroadcast.SentAt)
                            </strong>
                        </div>

                        <div>
                            <span>Recipients</span>
                            <strong>@selectedBroadcast.RecipientCount</strong>
                        </div>

                        <div>
                            <span>Read / Unread</span>
                            <strong>
                                @selectedBroadcast.ReadCount /
                                @selectedBroadcast.UnreadCount
                            </strong>
                        </div>

                    </div>

                    @if (selectedBroadcast.DirectorateNames.Any())
                    {
                        <div class="modal-directorates">
                            <span class="detail-label">Directorates</span>

                            <div class="directorate-list">
                                @foreach (var name in selectedBroadcast.DirectorateNames)
                                {
                                    <span class="directorate-tag">
                                        @name
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    <div class="message-content-box">
                        <div class="detail-label">Message</div>

                        <div class="message-content">
                            @selectedBroadcast.MessageBody
                        </div>
                    </div>

                    <div class="modal-actions">

                        <button type="button"
                                class="remove-btn"
                                @onclick="ShowRemoveConfirmation">
                            <i class="fas fa-trash-alt"></i>
                            Remove
                        </button>

                        <div class="modal-actions-right">

                            <button type="button"
                                    class="secondary-btn"
                                    @onclick="CloseDetailsModal">
                                Close
                            </button>

                            <button type="button"
                                    class="edit-btn"
                                    @onclick="BeginEditAsync">
                                <i class="fas fa-pen"></i>
                                Edit
                            </button>

                        </div>

                    </div>
                }
                else
                {
                    <!-- EDIT MODE -->

                    <div class="edit-form">

                        <div class="edit-field">
                            <label>
                                Subject
                                <span>*</span>
                            </label>

                            <input type="text"
                                   class="form-control"
                                   maxlength="200"
                                   @bind="editSubject" />
                        </div>

                        <div class="edit-field">
                            <label>
                                Message
                                <span>*</span>
                            </label>

                            <textarea class="form-control edit-message"
                                      @bind="editMessageBody"></textarea>
                        </div>

                        <div class="edit-field">
                            <label>
                                Audience
                                <span>*</span>
                            </label>

                            <select class="form-select"
                                    value="@editAudienceType"
                                    @onchange="OnEditAudienceChanged">

                                @if (CanEditAllWorkers)
                                {
                                    <option value="AllWorkers">
                                        All Workers
                                    </option>
                                }

                                @if (CanEditAllLeaders)
                                {
                                    <option value="AllLeaders">
                                        All Leaders
                                    </option>
                                }

                                @if (CanEditSelectedDirectorates)
                                {
                                    <option value="SelectedDirectorates">
                                        @(IsEditingClusterHead
                                            ? "Directorates in My Cluster"
                                            : "Selected Directorates")
                                    </option>
                                }

                                @if (CanEditOwnDirectorate)
                                {
                                    <option value="OwnDirectorate">
                                        My Directorate
                                    </option>
                                }

                            </select>
                        </div>

                        @if (editAudienceType == "SelectedDirectorates")
                        {
                            <div class="edit-field">

                                <div class="directorate-edit-heading">
                                    <label>Directorates</label>

                                    @if (availableDirectorates.Count > 1)
                                    {
                                        <button type="button"
                                                class="select-all-btn"
                                                @onclick="ToggleAllEditDirectoratesAsync">
                                            @(AllEditDirectoratesSelected
                                                ? "Clear All"
                                                : "Select All")
                                        </button>
                                    }
                                </div>

                                <div class="edit-directorates">

                                    @foreach (var directorate in availableDirectorates)
                                    {
                                        <label class="directorate-check">

                                            <input type="checkbox"
                                                   checked="@editDirectorateIds.Contains(directorate.Id)"
                                                   @onchange="@(async e =>
                                                       await ToggleEditDirectorateAsync(
                                                           directorate.Id,
                                                           (bool)(e.Value ?? false)))" />

                                            <span>@directorate.Name</span>

                                        </label>
                                    }

                                </div>

                            </div>
                        }

                        <div class="edit-preview">

                            <div>
                                <span>Eligible Recipients</span>

                                @if (isPreviewingEdit)
                                {
                                    <strong>
                                        <i class="fas fa-spinner fa-spin"></i>
                                        Checking...
                                    </strong>
                                }
                                else
                                {
                                    <strong>@editRecipientCount</strong>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(editPreviewMessage))
                            {
                                <small>@editPreviewMessage</small>
                            }

                        </div>

                        <div class="edit-warning">
                            <i class="fas fa-info-circle"></i>

                            <span>
                                If you change the subject or message,
                                existing recipients will be marked unread
                                so they can review the revised message.
                            </span>
                        </div>

                    </div>

                    <div class="modal-actions">

                        <button type="button"
                                class="secondary-btn"
                                disabled="@isSaving"
                                @onclick="CancelEdit">
                            Cancel
                        </button>

                        <button type="button"
                                class="save-btn"
                                disabled="@(!CanSaveEdit)"
                                @onclick="SaveEditAsync">

                            @if (isSaving)
                            {
                                <i class="fas fa-spinner fa-spin"></i>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="fas fa-save"></i>
                                <span>Save Changes</span>
                            }

                        </button>

                    </div>
                }
            }

        </div>

    </div>
}


<!-- =========================================================
     REMOVE CONFIRMATION
     ========================================================= -->

@if (showRemoveConfirmation && selectedBroadcast != null)
{
    <div class="modal-overlay confirm-layer">

        <div class="confirm-modal">

            <div class="danger-icon">
                <i class="fas fa-trash-alt"></i>
            </div>

            <h3>Remove this broadcast?</h3>

            <p>
                <strong>@selectedBroadcast.Subject</strong>
                will be removed from recipients' inboxes.
            </p>

            <div class="remove-note">
                The underlying record is retained for audit purposes.
            </div>

            <div class="confirm-actions">

                <button type="button"
                        class="secondary-btn"
                        disabled="@isRemoving"
                        @onclick="CancelRemove">
                    Cancel
                </button>

                <button type="button"
                        class="danger-btn"
                        disabled="@isRemoving"
                        @onclick="RemoveBroadcastAsync">

                    @if (isRemoving)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                        <span>Removing...</span>
                    }
                    else
                    {
                        <i class="fas fa-trash-alt"></i>
                        <span>Remove Broadcast</span>
                    }

                </button>

            </div>

        </div>

    </div>
}


<style>

    .broadcast-page {
        width: 100%;
    }

    .broadcast-hero {
        min-height: 135px;
        padding: 22px 28px;
        border-radius: 18px;
        background: linear-gradient(135deg,#35115f 0%,#5b218d 55%,#7131a5 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 14px;
        box-shadow: 0 8px 24px rgba(53,17,95,.14);
    }

    .broadcast-kicker,
    .modal-kicker {
        font-size: .67rem;
        font-weight: 700;
        letter-spacing: .12em;
        opacity: .78;
        margin-bottom: 4px;
    }

    .broadcast-hero h1 {
        margin: 0 0 4px;
        font-size: 1.55rem;
        font-weight: 700;
    }

    .broadcast-hero p {
        margin: 0;
        opacity: .86;
        font-size: .84rem;
    }

    .new-broadcast-btn {
        text-decoration: none;
        background: white;
        color: #4c187b;
        padding: 9px 15px;
        border-radius: 9px;
        font-size: .82rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

    .compact-alert {
        padding: 9px 12px;
        font-size: .76rem;
        border-radius: 9px;
        margin-bottom: 12px;
    }

    .broadcast-state {
        min-height: 220px;
        background: white;
        border: 1px solid #eee9f3;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 30px;
        color: #6f6877;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 9px;
        margin-bottom: 12px;
    }

    .summary-card {
        background: white;
        border: 1px solid #eee9f3;
        border-radius: 11px;
        padding: 10px 12px;
        display: flex;
        align-items: center;
        gap: 9px;
        min-height: 64px;
    }

    .summary-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: #f4edfa;
        color: #5b218d;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .summary-card span {
        display: block;
        color: #77707d;
        font-size: .68rem;
    }

    .summary-card strong {
        display: block;
        color: #29232e;
        font-size: 1.1rem;
    }

    .broadcast-workspace {
        display: grid;
        grid-template-columns: minmax(220px,.27fr) minmax(0,.73fr);
        gap: 12px;
        align-items: start;
    }

    .filter-panel,
    .results-panel {
        background: white;
        border: 1px solid #eee9f3;
        border-radius: 13px;
    }

    .filter-panel {
        padding: 15px;
        position: sticky;
        top: 12px;
    }

    .filter-header,
    .results-header {
        display: flex;
        justify-content: space-between;
        gap: 10px;
    }

    .filter-header {
        padding-bottom: 11px;
        margin-bottom: 12px;
        border-bottom: 1px solid #eee9f3;
    }

    .filter-header h2,
    .results-header h2 {
        margin: 0;
        color: #302938;
        font-size: .91rem;
        font-weight: 700;
    }

    .filter-header p,
    .results-header p {
        margin: 2px 0 0;
        color: #8a828f;
        font-size: .68rem;
    }

    .clear-filter-btn,
    .select-all-btn {
        border: 0;
        background: #f5effa;
        color: #5b218d;
        border-radius: 6px;
        padding: 4px 7px;
        font-size: .64rem;
        font-weight: 700;
    }

    .filter-section {
        margin-bottom: 14px;
    }

    .filter-section > label,
    .edit-field > label,
    .directorate-edit-heading label {
        display: block;
        color: #4b424f;
        font-size: .7rem;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .edit-field label span {
        color: #b42318;
    }

    .search-box {
        position: relative;
    }

    .search-box i {
        position: absolute;
        left: 10px;
        top: 50%;
        transform: translateY(-50%);
        color: #99919e;
        font-size: .7rem;
    }

    .search-box input {
        padding-left: 29px;
    }

    .form-control,
    .form-select {
        border-color: #ded8e3;
        border-radius: 7px;
        font-size: .72rem;
    }

    .audience-filter-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .audience-filter-btn {
        border: 0;
        background: transparent;
        color: #5f5664;
        border-radius: 7px;
        padding: 7px 8px;
        display: flex;
        justify-content: space-between;
        gap: 7px;
        font-size: .7rem;
    }

    .audience-filter-btn.active {
        background: #f4edfa;
        color: #521c7d;
        font-weight: 700;
    }

    .audience-filter-btn span {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .audience-filter-btn strong {
        min-width: 22px;
        text-align: center;
        padding: 2px 5px;
        border-radius: 12px;
        background: #f0ebf3;
        font-size: .61rem;
    }

    .date-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
    }

    .date-grid span {
        display: block;
        font-size: .61rem;
        color: #918996;
        margin-bottom: 3px;
    }

    .filter-result-box {
        padding: 10px;
        background: #f8f4fb;
        border-radius: 8px;
        text-align: center;
        font-size: .63rem;
        color: #837a88;
    }

    .filter-result-box strong {
        color: #501a7a;
        font-size: 1rem;
        margin: 0 3px;
    }

    .results-panel {
        overflow: hidden;
        min-width: 0;
    }

    .results-header {
        padding: 12px 15px;
        border-bottom: 1px solid #eee9f3;
    }

    .refresh-btn,
    .view-btn {
        border: 1px solid #ddd4e5;
        background: white;
        color: #5b218d;
        border-radius: 7px;
        padding: 6px 9px;
        font-size: .68rem;
        font-weight: 600;
    }

    .broadcast-item {
        padding: 10px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        border-bottom: 1px solid #f0edf2;
    }

    .broadcast-main {
        flex: 1;
        min-width: 0;
    }

    .broadcast-subject {
        color: #2f2933;
        font-weight: 700;
        font-size: .8rem;
        margin-bottom: 4px;
    }

    .broadcast-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
