@page "/workforce/worker-details/{workerId:int}"
@layout Components.Layout.MainLayout
@using ChurchApp.Services
@using ChurchApp.Models
@using ChurchApp.Components
@inject WorkerService WorkerService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Worker 360 - BCC ServiceHub</PageTitle>

@if (AuthService.IsAuthenticated && CanAccessWorkerDetails())
{
    <div class="worker360-page">

        @if (worker != null)
        {
            <div class="bcc-page-header">
                <div>
                    <div class="bcc-page-subtitle">
                        <i class="fas fa-id-card me-2"></i>
                        Worker 360°
                    </div>
                    <div class="bcc-page-title">Worker Profile</div>
                    <div class="bcc-page-subtitle">
                        Complete personal, ministry, qualification and system view of this worker.
                    </div>
                </div>

                <button class="bcc-btn bcc-btn-primary" @onclick="NavigateBack">
                    <i class="fas fa-arrow-left me-2"></i>
                    Back to Team
                </button>
            </div>

            <div class="bcc-card worker360-hero">
                <div class="bcc-card-body">
                    <div class="row align-items-center g-4">

                        <div class="col-md-auto text-center">
                            @if (!string.IsNullOrEmpty(worker.PassportPhotoPath))
                            {
                                <img src="/uploads/@worker.PassportPhotoPath"
                                     alt="@worker.FirstName"
                                     class="worker360-photo" />
                            }
                            else
                            {
                                <div class="worker360-photo-placeholder">
                                    <i class="fas fa-user"></i>
                                </div>
                            }
                        </div>

                        <div class="col">
                            <h3 class="worker360-name">
                                @worker.FirstName @worker.MiddleName @worker.LastName
                            </h3>

                            <div class="worker360-meta">
                                <span><i class="fas fa-id-badge"></i>@worker.WorkerId</span>
                                <span><i class="fas fa-user-tag"></i>@worker.Role</span>
                                <span><i class="fas fa-sitemap"></i>@(worker.Directorate?.Name ?? "No Directorate")</span>
                                <span><i class="fas fa-users"></i>@(worker.Department?.Name ?? "No Department")</span>
                            </div>

                            <div class="worker360-progress mt-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span>Compliance</span>
                                    <strong>@worker.CompliancePercentage% - @GetComplianceText(worker.CompliancePercentage)</strong>
                                </div>
                                <div class="progress">
                                    <div class="progress-bar @GetComplianceClass(worker.CompliancePercentage)"
                                         style="width:@worker.CompliancePercentage%">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-auto">
                            <div class="worker360-status-box">
                                <span>Status</span>
                                <strong class="@(worker.IsActive ? "text-success" : "text-secondary")">
                                    @(worker.IsActive ? "Active" : "Inactive")
                                </strong>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="team-summary-card">
                        <span>Years in BCC</span>
                        <strong>@CalculateYearsInBCC()</strong>
                        <i class="fas fa-calendar-check"></i>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="team-summary-card active">
                        <span>Qualifications</span>
                        <strong>@GetTotalQualifications()/4</strong>
                        <i class="fas fa-award"></i>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="team-summary-card directorate">
                        <span>Approval</span>
                        <strong>@GetApprovalStatus()</strong>
                        <i class="fas fa-check-double"></i>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="team-summary-card inactive">
                        <span>First Login</span>
                        <strong>@(worker.IsFirstLogin ? "Pending" : "Done")</strong>
                        <i class="fas fa-key"></i>
                    </div>
                </div>
            </div>

            <div class="bcc-card">
                <div class="profile-form-v2-tabs">
                    <button type="button" class="@GetTabClass("overview")" @onclick='() => SetTab("overview")'>
                        <i class="fas fa-user"></i> Overview
                    </button>

                    <button type="button" class="@GetTabClass("ministry")" @onclick='() => SetTab("ministry")'>
                        <i class="fas fa-church"></i> Ministry
                    </button>

                    <button type="button" class="@GetTabClass("qualifications")" @onclick='() => SetTab("qualifications")'>
                        <i class="fas fa-award"></i> Qualifications
                    </button>

                    <button type="button" class="@GetTabClass("documents")" @onclick='() => SetTab("documents")'>
                        <i class="fas fa-folder-open"></i> Documents
                    </button>

                    <button type="button" class="@GetTabClass("timeline")" @onclick='() => SetTab("timeline")'>
                        <i class="fas fa-stream"></i> Timeline
                    </button>

                    <button type="button" class="@GetTabClass("system")" @onclick='() => SetTab("system")'>
                        <i class="fas fa-cog"></i> System
                    </button>
                </div>

                <div class="bcc-card-body">

                    @if (activeTab == "overview")
                    {
                        <div class="row g-4">
                            <div class="col-lg-8">
                                <div class="worker360-section">
                                    <h5><i class="fas fa-address-card"></i> Personal Information</h5>

                                    <div class="worker360-grid">
                                        @InfoRow("Worker ID", worker.WorkerId)
                                        @InfoRow("Full Name", $"{worker.FirstName} {worker.MiddleName} {worker.LastName}")
                                        @InfoRow("Sex", worker.Sex ?? "Not provided")
                                        @InfoRow("Email", worker.Email ?? "Not provided")
                                        @InfoRow("Phone", worker.Phone ?? "Not provided")
                                        @InfoRow("Date of Birth", worker.DateOfBirth?.ToString("dd MMMM yyyy") ?? "Not provided")
                                        @InfoRow("Age", GetAgeText())
                                        @InfoRow("Marital Status", worker.MaritalStatus)
                                        @InfoRow("Wedding Anniversary", worker.WeddingAnniversary?.ToString("dd MMMM yyyy") ?? "Not applicable")
                                        @InfoRow("Profession", worker.Profession ?? "Not provided")
                                        @InfoRow("Organization", worker.Organization ?? "Not provided")
                                        @InfoRow("Address", worker.Address ?? "Not provided")
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <div class="worker360-side-card">
                                    <h5>Quick Actions</h5>

                                    <button class="worker360-action" @onclick="PrintProfile">
                                        <i class="fas fa-print"></i>
                                        Print Profile
                                    </button>

                                    <button class="worker360-action" @onclick="ViewFullHistory">
                                        <i class="fas fa-history"></i>
                                        View Full History
                                    </button>

                                    @if (!string.IsNullOrEmpty(worker.PassportPhotoPath))
                                    {
                                        <button class="worker360-action" @onclick="DownloadPhoto">
                                            <i class="fas fa-download"></i>
                                            Download Photo
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (activeTab == "ministry")
                    {
                        <div class="row g-4">
                            <div class="col-lg-6">
                                <div class="worker360-section">
                                    <h5><i class="fas fa-church"></i> Current Ministry Assignment</h5>

                                    <div class="worker360-grid">
                                        @InfoRow("Directorate", worker.Directorate?.Name ?? "Not assigned")
                                        @InfoRow("Department", worker.Department?.Name ?? "Not assigned")
                                        @InfoRow("Unit", worker.Unit?.Name ?? "Not assigned")
                                        @InfoRow("Secondary Directorate", worker.SecondaryDirectorate?.Name ?? "None")
@InfoRow("Secondary Department", worker.SecondaryDepartment?.Name ?? "None")
                                        @InfoRow("Role", worker.Role)
                                        @InfoRow("Worker Status", worker.WorkerStatus)
                                        @InfoRow("Supervisor", worker.Supervisor != null ? $"{worker.Supervisor.FirstName} {worker.Supervisor.LastName}" : "Not assigned")
                                        @InfoRow("Date Joined BCC", worker.DateJoinedChurch?.ToString("dd MMMM yyyy") ?? "Not provided")
                                        @InfoRow("Years in BCC", $"{CalculateYearsInBCC()} years")
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="worker360-section">
                                    <h5><i class="fas fa-history"></i> Previous Church Experience</h5>

                                    <div class="worker360-grid">
                                        @InfoRow("Previous Church", worker.PreviousChurch ?? "Not provided")
                                        @InfoRow("Previous Role", worker.PreviousChurchRole ?? "Not provided")
                                        @InfoRow("Previous Unit", worker.PreviousChurchUnit ?? "Not provided")
                                        @InfoRow("Experience", HasPreviousChurchExperience() ? "Has Previous Experience" : "No previous experience recorded")
                                    </div>

                                    @if (HasPreviousChurchExperience())
                                    {
                                        <div class="worker360-note">
                                            <i class="fas fa-info-circle"></i>
                                            This worker has previous church experience that may support current ministry responsibilities.
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div class="worker360-section">
                                    <h5><i class="fas fa-hands-praying"></i> Ordination</h5>

                                    <div class="worker360-grid two">
                                        @InfoRow("Ordination Status", worker.OrdinationStatus)
                                        @InfoRow("Ordination Level", worker.OrdinationLevel)
                                        @InfoRow("Last Ordination", worker.LastOrdinationDate?.ToString("dd MMMM yyyy") ?? "N/A")
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (activeTab == "qualifications")
                    {
                        <div class="worker360-section">
                            <h5><i class="fas fa-award"></i> Qualifications & Certificates</h5>

                            <div class="row g-3">
                                @QualificationCard("Believer's Baptism", worker.HasBelieverBaptism, worker.BelieverBaptismCertificatePath)
                                @QualificationCard("Worker in Training", worker.HasWorkerInTraining, worker.WorkerInTrainingCertificatePath)
                                @QualificationCard("School of Discipleship", worker.HasSOD, worker.SODCertificatePath)
                                @QualificationCard("Bible College", worker.HasBibleCollege, worker.BibleCollegeCertificatePath)
                            </div>

                            <div class="worker360-note mt-3">
                                <i class="fas fa-certificate"></i>
                                Total Qualifications: <strong>@GetTotalQualifications() out of 4</strong>
                            </div>
                        </div>
                    }

                    @if (activeTab == "documents")
                    {
                        <div class="row g-4">
                            <div class="col-lg-5">
                                <div class="worker360-section text-center">
                                    <h5><i class="fas fa-image"></i> Passport Photo</h5>

                                    @if (!string.IsNullOrEmpty(worker.PassportPhotoPath))
                                    {
                                        <img src="/uploads/@worker.PassportPhotoPath"
                                             class="worker360-document-photo" />

                                        <div class="mt-3">
                                            <a href="/uploads/@worker.PassportPhotoPath"
                                               target="_blank"
                                               class="team-action-btn">
                                                <i class="fas fa-expand me-1"></i>
                                                View Full Size
                                            </a>

                                            <button class="team-success-btn ms-2" @onclick="DownloadPhoto">
                                                <i class="fas fa-download me-1"></i>
                                                Download
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="bcc-empty py-4">
                                            <i class="fas fa-user-circle"></i>
                                            <p>No passport photo uploaded.</p>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="col-lg-7">
                                <div class="worker360-section">
                                    <h5><i class="fas fa-file-alt"></i> Certificate Documents</h5>

                                    <div class="worker360-doc-list">
                                        @DocumentRow("Believer Baptism Certificate", worker.BelieverBaptismCertificatePath)
                                        @DocumentRow("Worker in Training Certificate", worker.WorkerInTrainingCertificatePath)
                                        @DocumentRow("SOD Certificate", worker.SODCertificatePath)
                                        @DocumentRow("Bible College Certificate", worker.BibleCollegeCertificatePath)
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (activeTab == "timeline")
                    {
                        <div class="worker360-section">
                            <h5><i class="fas fa-stream"></i> Ministry Journey Timeline</h5>

                            <div class="worker360-timeline">
                                @TimelineItem(worker.CreatedDate, "Worker profile created", "System record was created.")
                                @if (worker.DateJoinedChurch.HasValue)
                                {
                                    @TimelineItem(worker.DateJoinedChurch.Value, "Joined BCC", "Worker joined the church.")
                                }
                                @if (worker.HasBelieverBaptism)
                                {
                                    @TimelineItem(worker.CreatedDate, "Believer's Baptism", "Baptism qualification recorded.")
                                }
                                @if (worker.HasWorkerInTraining)
                                {
                                    @TimelineItem(worker.CreatedDate, "Worker in Training", "Worker training qualification recorded.")
                                }
                                @if (worker.HasSOD)
                                {
                                    @TimelineItem(worker.CreatedDate, "School of Discipleship", "SOD qualification recorded.")
                                }
                                @if (worker.HasBibleCollege)
                                {
                                    @TimelineItem(worker.CreatedDate, "Bible College", "Bible College qualification recorded.")
                                }
                                @if (worker.LastOrdinationDate.HasValue)
                                {
                                    @TimelineItem(worker.LastOrdinationDate.Value, "Ordination", $"{worker.OrdinationLevel} recorded.")
                                }
                                @if (worker.LastUpdated.HasValue)
                                {
                                    @TimelineItem(worker.LastUpdated.Value, "Profile Updated", "Worker profile was last updated.")
                                }
                            </div>
                        </div>
                    }

                    @if (activeTab == "system")
                    {
                        <div class="worker360-section">
                            <h5><i class="fas fa-cog"></i> System Information</h5>

                            <div class="worker360-grid two">
                                @InfoRow("Created Date", worker.CreatedDate.ToString("dd MMMM yyyy HH:mm"))
                                @InfoRow("Last Updated", worker.LastUpdated?.ToString("dd MMMM yyyy HH:mm") ?? "Never")
                                @InfoRow("Last Login", worker.LastLoginDate?.ToString("dd MMMM yyyy HH:mm") ?? "Never")
                                @InfoRow("First Login", worker.IsFirstLogin ? "Pending" : "Completed")
                                @InfoRow("Profile Submitted", worker.ProfileSubmitted ? "Yes" : "No")
                                @InfoRow("Approval Status", GetApprovalStatus())
                                @InfoRow("Compliance", $"{worker.CompliancePercentage}% - {GetComplianceText(worker.CompliancePercentage)}")
                            </div>

                            @if (AuthService.CanAccessAdminPanel())
                            {
                                <div class="mt-4">
                                    <h5><i class="fas fa-clipboard-list"></i> Audit Trail</h5>
                                    <AuditTrailView WorkerId="worker.Id" />
                                </div>
                            }
                        </div>
                    }

                </div>
            </div>
        }
        else if (isLoading)
        {
            <div class="bcc-empty">
                <div class="spinner-border text-primary"></div>
                <p class="mt-3">Loading worker details...</p>
            </div>
        }
        else
        {
            <div class="bcc-empty">
                <i class="fas fa-user-slash"></i>
                <h4>Worker Not Found</h4>
                <p>The requested worker profile could not be found.</p>
                <button class="bcc-btn bcc-btn-primary" @onclick="NavigateBack">
                    Back to Team
                </button>
            </div>
        }

    </div>
}
else if (AuthService.IsAuthenticated && !CanAccessWorkerDetails())
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>
        <p>You don't have permission to access this page.</p>
        <a href="/" class="bcc-btn bcc-btn-primary">Return to Dashboard</a>
    </div>
}
else
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access this page.</p>
        <a href="/login" class="bcc-btn bcc-btn-primary">Go to Login</a>
    </div>
}

@code {
    [Parameter] public int workerId { get; set; }

    private Worker? worker = null;
    private bool isLoading = true;
    private string activeTab = "overview";

    protected override async Task OnParametersSetAsync()
    {
        await LoadWorkerData();
    }

    private void SetTab(string tab) => activeTab = tab;

    private string GetTabClass(string tab)
    {
        return activeTab == tab ? "profile-form-tab active" : "profile-form-tab";
    }

    private async Task LoadWorkerData()
    {
        try
        {
            isLoading = true;
            worker = await WorkerService.GetWorkerByIdAsync(workerId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading worker: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private RenderFragment InfoRow(string label, string value) => @<div class="bcc-info-row">
        <div class="bcc-info-label">@label</div>
        <div class="bcc-info-value">@value</div>
    </div>;

    private RenderFragment QualificationCard(string title, bool completed, string? path) => @<div class="col-md-6">
        <div class="worker360-qualification-card">
            <div class="worker360-qualification-icon @(completed ? "done" : "missing")">
                <i class="fas @(completed ? "fa-check" : "fa-times")"></i>
            </div>

            <div>
                <strong>@title</strong>
                <span>@(completed ? "Completed" : "Not completed")</span>

                @if (!string.IsNullOrEmpty(path))
                {
                    <a href="/uploads/@path" target="_blank">
                        <i class="fas fa-download me-1"></i>
                        View Certificate
                    </a>
                }
                else
                {
                    <small>No certificate uploaded</small>
                }
            </div>
        </div>
    </div>;

    private RenderFragment DocumentRow(string title, string? path) => @<div class="worker360-document-row">
        <div>
            <i class="fas fa-file-alt"></i>
            <span>@title</span>
        </div>

        @if (!string.IsNullOrEmpty(path))
        {
            <a href="/uploads/@path" target="_blank">View</a>
        }
        else
        {
            <small>Not uploaded</small>
        }
    </div>;

    private RenderFragment TimelineItem(DateTime date, string title, string description) => @<div class="worker360-timeline-item">
        <div class="worker360-timeline-dot"></div>
        <div>
            <span>@date.ToString("dd MMM yyyy")</span>
            <strong>@title</strong>
            <p>@description</p>
        </div>
    </div>;

    private string GetAgeText()
    {
        if (worker?.DateOfBirth.HasValue != true)
            return "-";

        var today = DateTime.Today;
        var age = today.Year - worker.DateOfBirth.Value.Year;

        if (worker.DateOfBirth.Value.Date > today.AddYears(-age))
            age--;

        return $"{age} years";
    }

    private int GetTotalQualifications()
    {
        if (worker == null) return 0;

        int total = 0;
        if (worker.HasBelieverBaptism) total++;
        if (worker.HasWorkerInTraining) total++;
        if (worker.HasSOD) total++;
        if (worker.HasBibleCollege) total++;

        return total;
    }

    private string GetApprovalStatus()
    {
        if (worker == null) return "Unknown";

        if (worker.Stage1Approved && worker.Stage2Approved) return "Fully Approved";
        if (worker.Stage1Approved) return "Stage 1 Approved";
        if (worker.ProfileSubmitted) return "Pending";
        return "Not Submitted";
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/workforce/my-team-v2");
    }

    private string GetComplianceClass(int percentage)
    {
        return percentage switch
        {
            >= 80 => "bg-success",
            >= 50 => "bg-warning",
            _ => "bg-danger"
        };
    }

    private string GetComplianceText(int percentage)
    {
        return percentage switch
        {
            >= 90 => "Excellent",
            >= 80 => "Good",
            >= 50 => "Fair",
            _ => "Poor"
        };
    }

    private int CalculateYearsInBCC()
    {
        if (worker?.DateJoinedChurch.HasValue != true)
            return 0;

        var years = DateTime.Now.Year - worker.DateJoinedChurch.Value.Year;

        if (worker.DateJoinedChurch.Value.Date > DateTime.Now.AddYears(-years))
            years--;

        return Math.Max(0, years);
    }

    private bool HasPreviousChurchExperience()
    {
        return !string.IsNullOrEmpty(worker?.PreviousChurch) ||
               !string.IsNullOrEmpty(worker?.PreviousChurchRole) ||
               !string.IsNullOrEmpty(worker?.PreviousChurchUnit);
    }

    private async Task DownloadPhoto()
    {
        if (!string.IsNullOrEmpty(worker?.PassportPhotoPath))
        {
            var fileName = $"{worker.FirstName}_{worker.LastName}_Passport{Path.GetExtension(worker.PassportPhotoPath)}";
            Navigation.NavigateTo($"/download-file/{worker.PassportPhotoPath}/{fileName}", true);
        }
    }

    private void ViewFullHistory()
    {
        if (worker != null)
        {
            Navigation.NavigateTo($"/admin/worker-history/{worker.Id}");
        }
    }

    private void PrintProfile()
    {
        if (worker != null)
        {
            Navigation.NavigateTo($"/admin/worker-print/{worker.Id}", true);
        }
    }

    private bool CanAccessWorkerDetails()
    {
        var worker = AuthService.CurrentWorker;
        if (worker == null) return false;

        var role = worker.Role?.ToLowerInvariant() ?? "";

        return role.Contains("head of directorate") ||
               role.Contains("asst head of directorate") ||
               role.Contains("head of service") ||
               role.Contains("pastor in charge") ||
               role.Contains("senior pastor");
    }
}