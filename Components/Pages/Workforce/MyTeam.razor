@page "/workforce/my-team"
@layout Components.Layout.MainLayout

@using ChurchApp.Services
@using ChurchApp.Models

@inject WorkerService WorkerService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>My Team - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to view your team.</p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else if (!CanAccessMyTeam())
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>
        <p>You do not have permission to view a team register.</p>

        <a href="/"
           class="bcc-btn bcc-btn-primary">
            Return to Dashboard
        </a>
    </div>
}
else
{
    <div class="worker360-page my-team-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success py-2">
                <i class="fas fa-check-circle me-2"></i>
                @successMessage
            </div>
        }

        <div class="bcc-page-header my-team-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-users-cog me-2"></i>
                    Team Management
                </div>

                <div class="bcc-page-title">
                    My Team
                </div>

                <div class="bcc-page-subtitle">
                    View workers under your supervision and review their current status.
                </div>
            </div>

            <button type="button"
                    class="bcc-btn profile-form-secondary-btn compact-btn"
                    @onclick="GoBack">
                <i class="fas fa-arrow-left me-2"></i>
                Back
            </button>
        </div>

        <div class="row g-3 align-items-start">

            <div class="col-12 col-xl-4">
                <div class="bcc-card team-filter-card">

                    <div class="team-panel-header">
                        <div class="team-panel-icon">
                            <i class="fas fa-filter"></i>
                        </div>

                        <div>
                            <h6>Team Search</h6>
                            <p>Summary and search controls.</p>
                        </div>
                    </div>

                    <div class="bcc-card-body p-3">

                        <div class="team-summary-grid mb-3">

                            <div>
                                <span>Total Workers</span>
                                <strong>@workers.Count</strong>
                            </div>

                            <div class="active">
                                <span>Active</span>
                                <strong>@workers.Count(w => w.IsActive)</strong>
                            </div>

                            <div class="inactive">
                                <span>Inactive</span>
                                <strong>@workers.Count(w => !w.IsActive)</strong>
                            </div>

                            <div class="result">
                                <span>Filtered</span>
                                <strong>@filteredTotalCount</strong>
                            </div>

                        </div>

                        <div class="team-search-tip">
                            <i class="fas fa-lightbulb"></i>

                            <span>
                                Search by name, Worker ID, role, directorate or department.
                            </span>
                        </div>

                        <div class="row g-2">

                            <div class="col-12">
                                <label class="form-label compact-label">
                                    Search Worker
                                </label>

                                <div class="team-search-input">
                                    <i class="fas fa-search"></i>

                                    <input type="text"
                                           class="form-control form-control-sm"
                                           placeholder="Name, Worker ID or role"
                                           @bind-value="searchText"
                                           @bind-value:event="oninput"
                                           @onkeyup="ApplyFilters" />
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label compact-label">
                                    Directorate
                                </label>

                                <select class="form-select form-select-sm"
                                        @bind="selectedDirectorate"
                                        @bind:after="ApplyFilters">
                                    <option value="">All Directorates</option>

                                    @foreach (var directorate in directorates)
                                    {
                                        <option value="@directorate">
                                            @directorate
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label compact-label">
                                    Department
                                </label>

                                <select class="form-select form-select-sm"
                                        @bind="selectedDepartment"
                                        @bind:after="ApplyFilters">
                                    <option value="">All Departments</option>

                                    @foreach (var department in availableDepartments)
                                    {
                                        <option value="@department">
                                            @department
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label compact-label">
                                    Worker Status
                                </label>

                                <select class="form-select form-select-sm"
                                        @bind="selectedStatus"
                                        @bind:after="ApplyFilters">
                                    <option value="">All Workers</option>
                                    <option value="active">Active Workers</option>
                                    <option value="inactive">Inactive Workers</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label compact-label">
                                    Sort Team
                                </label>

                                <select class="form-select form-select-sm"
                                        @bind="selectedSort"
                                        @bind:after="ApplyFilters">
                                    <option value="name">Name A-Z</option>
                                    <option value="worker-id">Worker ID</option>
                                    <option value="directorate">Directorate</option>
                                    <option value="status">Status</option>
                                </select>
                            </div>

                        </div>

                        <div class="mt-3 d-flex justify-content-end gap-2">
                            <button type="button"
                                    class="bcc-btn profile-form-secondary-btn compact-btn"
                                    @onclick="ClearFilters">
                                <i class="fas fa-filter-circle-xmark me-1"></i>
                                Clear
                            </button>

                            <button type="button"
                                    class="bcc-btn bcc-btn-primary compact-btn"
                                    @onclick="ApplyFilters">
                                <i class="fas fa-filter me-1"></i>
                                Apply
                            </button>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-8">
                <div class="bcc-card team-list-card">

                    <div class="team-list-header">
                        <div>
                            <h6>
                                <i class="fas fa-address-card me-2"></i>
                                Team Members
                            </h6>

                            <p>
                                @filteredTotalCount worker(s) match the current filter.
                            </p>
                        </div>

                        <span class="team-result-count">
                            @filteredTotalCount
                        </span>
                    </div>

                    <div class="bcc-card-body p-0">

                        @if (isLoading)
                        {
                            <div class="bcc-empty py-4">
                                <div class="spinner-border text-primary"></div>
                                <p class="mt-2">Loading team members...</p>
                            </div>
                        }
                        else if (!filteredWorkers.Any())
                        {
                            <div class="bcc-empty py-4">
                                <i class="fas fa-users-slash"></i>
                                <h4>No Team Members Found</h4>

                                <p>
                                    @(workers.Count == 0
                                                                ? "No team members are assigned to you."
                                                                : "No workers match the current search criteria.")
                        </p>

                        @if (workers.Any())
                                {
                                    <button type="button"
                                            class="bcc-btn bcc-btn-primary compact-btn"
                                            @onclick="ClearFilters">
                                        Clear Filters
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive team-table-wrapper">
                                <table class="table align-middle mb-0 team-table">
                                    <thead>
                                        <tr>
                                            <th>Worker</th>
                                            <th>Role</th>
                                            <th>Status</th>
                                            <th class="text-end">View</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var teamWorker in filteredWorkers)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="team-worker-cell">

                                                        @if (!string.IsNullOrWhiteSpace(
                                                                                                    teamWorker.PassportPhotoPath))
                                                        {
                                                            <img src="/uploads/@(teamWorker.PassportPhotoThumbPath ?? teamWorker.PassportPhotoPath)"
                                                                 alt="@teamWorker.FirstName"
                                                                 class="team-worker-avatar"
                                                                 loading="lazy"
                                                                 @onclick="() => OpenWorkerPreview(teamWorker)" />
                                                        }
                                                        else
                                                        {
                                                            <button type="button"
                                                                    class="team-worker-avatar-placeholder"
                                                                    @onclick="() => OpenWorkerPreview(teamWorker)">
                                                                <i class="fas fa-user"></i>
                                                            </button>
                                                        }

                                                        <div>
                                                            <strong>
                                                                @teamWorker.FirstName
                                                                @teamWorker.LastName
                                                            </strong>

                                                            <span>
                                                                @teamWorker.WorkerId
                                                            </span>
                                                        </div>

                                                    </div>
                                                </td>

                                                <td>
                                                    <span class="team-role-badge">
                                                        @DisplayValue(teamWorker.Role)
                                                    </span>
                                                </td>

                                                <td>
                                                    <span class="team-status-badge
                                                                    @(teamWorker.IsActive ? "active" : "inactive")">
                                                        <i class="fas @(teamWorker.IsActive
                                                                                                                       ? "fa-circle-check"
                                                                                                                       : "fa-circle-xmark")"></i>

                                                        @(teamWorker.IsActive
                                                                                                    ? "Active"
                                                                                                    : "Inactive")
                                        </span>
                                    </td>

                                                <td class="text-end">
                                                    <button type="button"
                                                            class="btn btn-sm btn-primary"
                                                            @onclick="() => OpenWorkerPreview(teamWorker)">
                                                        <i class="fas fa-eye me-1"></i>
                                                        View
                                                    </button>
                                                </td>
                                            </tr>
                                                                }
                                    </tbody>
                                </table>
                            </div>

                            @if (totalPages > 1)
                            {
                                <div class="team-pagination">

                                    <button type="button"
                                            class="team-page-btn"
                                            disabled="@(currentPage == 1)"
                                            @onclick="() => ChangePage(currentPage - 1)">
                                        <i class="fas fa-chevron-left"></i>
                                    </button>

                                    <span>
                                        Page @currentPage of @totalPages
                                    </span>

                                    <button type="button"
                                            class="team-page-btn"
                                            disabled="@(currentPage == totalPages)"
                                            @onclick="() => ChangePage(currentPage + 1)">
                                        <i class="fas fa-chevron-right"></i>
                                    </button>

                                </div>
                            }
                        }

                    </div>
                </div>
            </div>

        </div>
    </div>
}

@if (showWorkerPreview && selectedWorker != null)
{
    <div class="team-preview-backdrop"
         @onclick="CloseWorkerPreview">

        <div class="team-preview-card"
             @onclick:stopPropagation="true">

            <div class="team-preview-header">
                <div>
                    <h4>Team Member</h4>
                    <p>@selectedWorker.WorkerId</p>
                </div>

                <button type="button"
                        class="btn-close"
                        disabled="@isChangingStatus"
                        @onclick="CloseWorkerPreview">
                </button>
            </div>

            <div class="team-preview-profile">

                @if (!string.IsNullOrWhiteSpace(
                            selectedWorker.PassportPhotoPath))
                {
                    <img src="/uploads/@selectedWorker.PassportPhotoPath"
                         class="team-preview-photo"
                         alt="@selectedWorker.FirstName" />
                }
                else
                {
                    <div class="team-preview-photo-placeholder">
                        <i class="fas fa-user"></i>
                    </div>
                }

            <div>
                <h5>
                    @selectedWorker.FirstName
                    @selectedWorker.LastName
                </h5>

                <span>
                    @DisplayValue(selectedWorker.Role)
                </span>

                <small class="team-status-badge
                        @(selectedWorker.IsActive ? "active" : "inactive")">
                    @(selectedWorker.IsActive
                                        ? "Active"
                                        : "Inactive")
                                                 </small>
                                             </div>

        </div>

        <div class="team-preview-grid">

            <div>
                <span>Directorate</span>
                <strong>
                    @(selectedWorker.Directorate?.Name
                                        ?? "Not assigned")
                                                      </strong>
                                                  </div>

            <div>
                <span>Department</span>
                <strong>
                    @(selectedWorker.Department?.Name
                                        ?? "Not assigned")
                </strong>
            </div>

                <div>
                    <span>Phone</span>
                    <strong>
                        @DisplayValue(selectedWorker.Phone)
                    </strong>
                </div>

                <div>
                    <span>Email</span>
                    <strong>
                        @DisplayValue(selectedWorker.Email)
                    </strong>
                </div>

            </div>

            <div class="team-preview-actions">

                <button type="button"
                        class="btn btn-sm btn-primary"
                        @onclick="() => ViewWorkerDetails(selectedWorker.Id)">
                    <i class="fas fa-user me-1"></i>
                    View Details
                </button>

            @if (selectedWorker.IsActive)
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            disabled="@isChangingStatus"
                            @onclick="() => ChangeWorkerStatus(selectedWorker, false)">

                        @if (isChangingStatus)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="fas fa-user-slash me-1"></i>
                        }

                        Deactivate
                    </button>
                }
                else
                {
                    <button type="button"
                            class="btn btn-sm btn-outline-success"
                            disabled="@isChangingStatus"
                            @onclick="() => ChangeWorkerStatus(selectedWorker, true)">

                        @if (isChangingStatus)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="fas fa-user-check me-1"></i>
                        }

                        Activate
                    </button>
                }

            </div>

        </div>
    </div>
}

@code {
    private List<Worker> workers = new();
    private List<Worker> filteredWorkers = new();

    private List<string> directorates = new();
    private List<string> departments = new();
    private List<string> availableDepartments = new();

    private Worker? selectedWorker;

    private bool isLoading = true;
    private bool showWorkerPreview;
    private bool isChangingStatus;

    private string searchText = string.Empty;
    private string selectedDirectorate = string.Empty;
    private string selectedDepartment = string.Empty;
    private string selectedStatus = string.Empty;
    private string selectedSort = "name";

    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private int currentPage = 1;
    private const int pageSize = 10;
    private int totalPages = 1;
    private int filteredTotalCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadTeamMembers();
    }

    private async Task LoadTeamMembers()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var currentWorker =
                AuthService.CurrentWorker;

            if (currentWorker == null)
            {
                workers = new List<Worker>();
                return;
            }

            if (HasRole(
                    currentWorker,
                    "Pastor in Charge") ||
                HasRole(
                    currentWorker,
                    "Head of Service") ||
                HasRole(
                    currentWorker,
                    "Senior Pastor"))
            {
                workers =
                    await WorkerService
                        .GetAllWorkersAsync();
            }
            else if (
                HasRole(
                    currentWorker,
                    "Head of Directorate") ||
                HasRole(
                    currentWorker,
                    "Asst Head of Directorate"))
            {
                workers =
                    currentWorker.DirectorateId.HasValue
                        ? await WorkerService
                            .GetWorkersByDirectorateAsync(
                                currentWorker.DirectorateId.Value)
                        : new List<Worker>();
            }
            else
            {
                workers =
                    new List<Worker>();
            }

            ExtractFilterOptions();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            workers = new List<Worker>();
            filteredWorkers = new List<Worker>();

            errorMessage =
                $"Unable to load team members: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ExtractFilterOptions()
    {
        directorates =
            workers
                .Where(worker =>
                    worker.Directorate != null)
                .Select(worker =>
                    worker.Directorate!.Name)
                .Where(name =>
                    !string.IsNullOrWhiteSpace(name))
                .Distinct(
                    StringComparer.OrdinalIgnoreCase)
                .OrderBy(name => name)
                .ToList();

        departments =
            workers
                .Where(worker =>
                    worker.Department != null)
                .Select(worker =>
                    worker.Department!.Name)
                .Where(name =>
                    !string.IsNullOrWhiteSpace(name))
                .Distinct(
                    StringComparer.OrdinalIgnoreCase)
                .OrderBy(name => name)
                .ToList();

        UpdateAvailableDepartments();
    }

    private void ApplyFilters()
    {
        UpdateAvailableDepartments();

        IEnumerable<Worker> filtered =
            workers;

        if (!string.IsNullOrWhiteSpace(
            searchText))
        {
            var search =
                searchText.Trim();

            filtered =
                filtered.Where(worker =>
                    ($"{worker.FirstName} " +
                     $"{worker.MiddleName} " +
                     $"{worker.LastName}")
                        .Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase) ||

                    (worker.WorkerId ?? string.Empty)
                        .Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase) ||

                    (worker.Role ?? string.Empty)
                        .Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase) ||

                    (worker.Directorate?.Name ?? string.Empty)
                        .Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase) ||

                    (worker.Department?.Name ?? string.Empty)
                        .Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(
            selectedDirectorate))
        {
            filtered =
                filtered.Where(worker =>
                    string.Equals(
                        worker.Directorate?.Name,
                        selectedDirectorate,
                        StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(
            selectedDepartment))
        {
            filtered =
                filtered.Where(worker =>
                    string.Equals(
                        worker.Department?.Name,
                        selectedDepartment,
                        StringComparison.OrdinalIgnoreCase));
        }

        filtered =
            selectedStatus switch
            {
                "active" =>
                    filtered.Where(worker =>
                        worker.IsActive),

                "inactive" =>
                    filtered.Where(worker =>
                        !worker.IsActive),

                _ =>
                    filtered
            };

        filtered =
            selectedSort switch
            {
                "worker-id" =>
                    filtered
                        .OrderBy(worker =>
                            GetWorkerPriority(
                                worker.WorkerId))
                        .ThenBy(worker =>
                            ExtractWorkerNumber(
                                worker.WorkerId)),

                "directorate" =>
                    filtered
                        .OrderBy(worker =>
                            worker.Directorate?.Name)
                        .ThenBy(worker =>
                            worker.LastName)
                        .ThenBy(worker =>
                            worker.FirstName),

                "status" =>
                    filtered
                        .OrderByDescending(worker =>
                            worker.IsActive)
                        .ThenBy(worker =>
                            worker.LastName)
                        .ThenBy(worker =>
                            worker.FirstName),

                _ =>
                    filtered
                        .OrderBy(worker =>
                            worker.LastName)
                        .ThenBy(worker =>
                            worker.FirstName)
            };

        var filteredList =
            filtered.ToList();

        filteredTotalCount =
            filteredList.Count;

        totalPages =
            Math.Max(
                1,
                (int)Math.Ceiling(
                    filteredTotalCount /
                    (double)pageSize));

        if (currentPage > totalPages)
            currentPage = totalPages;

        filteredWorkers =
            filteredList
                .Skip(
                    (currentPage - 1) *
                    pageSize)
                .Take(pageSize)
                .ToList();

        StateHasChanged();
    }

    private void UpdateAvailableDepartments()
    {
        IEnumerable<Worker> departmentSource =
            workers;

        if (!string.IsNullOrWhiteSpace(
            selectedDirectorate))
        {
            departmentSource =
                departmentSource.Where(worker =>
                    string.Equals(
                        worker.Directorate?.Name,
                        selectedDirectorate,
                        StringComparison.OrdinalIgnoreCase));
        }

        availableDepartments =
            departmentSource
                .Where(worker =>
                    worker.Department != null)
                .Select(worker =>
                    worker.Department!.Name)
                .Where(name =>
                    !string.IsNullOrWhiteSpace(name))
                .Distinct(
                    StringComparer.OrdinalIgnoreCase)
                .OrderBy(name => name)
                .ToList();

        if (!string.IsNullOrWhiteSpace(
                selectedDepartment) &&
            !availableDepartments.Contains(
                selectedDepartment,
                StringComparer.OrdinalIgnoreCase))
        {
            selectedDepartment =
                string.Empty;
        }
    }

    private void ClearFilters()
    {
        searchText = string.Empty;
        selectedDirectorate = string.Empty;
        selectedDepartment = string.Empty;
        selectedStatus = string.Empty;
        selectedSort = "name";
        currentPage = 1;

        UpdateAvailableDepartments();
        ApplyFilters();
    }

    private void ChangePage(
        int page)
    {
        if (page < 1 ||
            page > totalPages)
        {
            return;
        }

        currentPage = page;
        ApplyFilters();
    }

    private void OpenWorkerPreview(
        Worker worker)
    {
        selectedWorker = worker;
        showWorkerPreview = true;
        successMessage = string.Empty;
        errorMessage = string.Empty;
    }

    private void CloseWorkerPreview()
    {
        if (isChangingStatus)
            return;

        showWorkerPreview = false;
        selectedWorker = null;
    }

    private async Task ChangeWorkerStatus(
        Worker worker,
        bool newStatus)
    {
        if (isChangingStatus)
            return;

        var previousStatus =
            worker.IsActive;

        try
        {
            isChangingStatus = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            worker.IsActive =
                newStatus;

            worker.LastUpdated =
                DateTime.UtcNow;

            await WorkerService
                .UpdateWorkerAsync(worker);

            successMessage =
                newStatus
                    ? $"{worker.FirstName} {worker.LastName} was activated successfully."
                    : $"{worker.FirstName} {worker.LastName} was deactivated successfully.";

            ApplyFilters();
        }
        catch (Exception ex)
        {
            worker.IsActive =
                previousStatus;

            errorMessage =
                $"Unable to change worker status: {ex.Message}";
        }
        finally
        {
            isChangingStatus = false;
            CloseWorkerPreview();
        }
    }

    private void ViewWorkerDetails(
        int workerId)
    {
        Navigation.NavigateTo(
            $"/workforce/worker-details/{workerId}");
    }

    private void GoBack()
    {
        Navigation.NavigateTo(
            "/workspace/my-team");
    }

    private bool CanAccessMyTeam()
    {
        var currentWorker =
            AuthService.CurrentWorker;

        if (currentWorker == null)
            return false;

        return
            HasRole(
                currentWorker,
                "Head of Directorate") ||

            HasRole(
                currentWorker,
                "Asst Head of Directorate") ||

            HasRole(
                currentWorker,
                "Head of Service") ||

            HasRole(
                currentWorker,
                "Pastor in Charge") ||

            HasRole(
                currentWorker,
                "Senior Pastor");
    }

    private static bool HasRole(
        Worker worker,
        string roleName)
    {
        return
            worker.Role?.Contains(
                roleName,
                StringComparison.OrdinalIgnoreCase)
            == true;
    }

    private static string DisplayValue(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Not provided"
            : value.Trim();
    }

    private static int GetWorkerPriority(
        string? workerId)
    {
        if (string.IsNullOrWhiteSpace(workerId))
            return 99;

        var normalized =
            workerId.Trim().ToUpperInvariant();

        if (normalized.StartsWith("P"))
            return 1;

        if (normalized.StartsWith("C"))
            return 2;

        if (normalized.StartsWith("D"))
            return 3;

        if (normalized.StartsWith("W"))
            return 4;

        return 99;
    }

    private static int ExtractWorkerNumber(
        string? workerId)
    {
        if (string.IsNullOrWhiteSpace(workerId))
            return int.MaxValue;

        var digits =
            new string(
                workerId
                    .Where(char.IsDigit)
                    .ToArray());

        return int.TryParse(
            digits,
            out var number)
                ? number
                : int.MaxValue;
    }
}

<style>
