@page "/workforce/update-profile"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.Processing
@using SixLabors.ImageSharp.Formats.Jpeg

@inject WorkforceService WorkforceService
@inject WorkerService WorkerService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment
@inject ImageOptimizationService imageOptimizationService

<PageTitle>Update My Profile - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to update your profile.</p>

        <a href="/login" class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else if (isLoading)
{
    <div class="worker360-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-4">
                <div class="spinner-border text-primary"></div>
                <div class="mt-2 text-muted">Loading profile update...</div>
            </div>
        </div>
    </div>
}
else if (worker == null)
{
    <div class="bcc-empty">
        <i class="fas fa-user-slash"></i>
        <h4>Worker Not Found</h4>
        <p>Your worker profile could not be found.</p>

        <button type="button"
                class="bcc-btn bcc-btn-primary"
                @onclick="NavigateBack">
            Back to Profile
        </button>
    </div>
}
else
{
    <div class="worker360-page profile-update-page">

        <div class="bcc-page-header profile-update-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-user-edit me-2"></i>
                    Workforce Profile Update
                </div>

                <div class="bcc-page-title">
                    Update My Profile
                </div>

                <div class="bcc-page-subtitle">
                    Update your information and submit the changes for approval.
                </div>
            </div>

            <button type="button"
                    class="bcc-btn profile-form-secondary-btn compact-btn"
                    @onclick="NavigateBack">
                <i class="fas fa-arrow-left me-2"></i>
                Back to Profile
            </button>
        </div>

        <div class="profile-update-summary mb-3">

            <div class="profile-update-person">
                @if (!string.IsNullOrWhiteSpace(worker.PassportPhotoPath))
                {
                    <img src="@($"/uploads/{worker.PassportPhotoThumbPath ?? worker.PassportPhotoPath}")"
                         class="profile-update-photo"
                         alt="Profile photograph"
                         loading="lazy" />
                }
                else
                {
                    <div class="profile-update-photo-placeholder">
                        <i class="fas fa-user"></i>
                    </div>
                }

                <div>
                    <h5>@worker.FirstName @worker.LastName</h5>

                    <div class="profile-update-meta">
                        <span>
                            <i class="fas fa-id-badge"></i>
                            @worker.WorkerId
                        </span>

                        <span>
                            <i class="fas fa-user-tag"></i>
                            @worker.Role
                        </span>

                        <span>
                            <i class="fas fa-sitemap"></i>
                            @(worker.Directorate?.Name ?? "No Directorate")
                        </span>
                    </div>
                </div>
            </div>

            <div class="approval-summary">
                <span>Approval Goes To</span>
                <strong>@approverInfo</strong>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success py-2">
                <i class="fas fa-check-circle me-2"></i>
                @successMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        <EditForm Model="@profileModel"
                  OnValidSubmit="SubmitForApproval">

            <DataAnnotationsValidator />

            <div class="profile-group-tabs mb-3">

                <button type="button"
                        class="@GetTabClass("personal-church")"
                        @onclick='() => SetTab("personal-church")'>
                    <i class="fas fa-user-church"></i>
                    <span>Personal & Church</span>
                </button>

                <button type="button"
                        class="@GetTabClass("ordination-qualification")"
                        @onclick='() => SetTab("ordination-qualification")'>
                    <i class="fas fa-award"></i>
                    <span>Ordination & Qualifications</span>
                </button>

                <button type="button"
                        class="@GetTabClass("documents-review")"
                        @onclick='() => SetTab("documents-review")'>
                    <i class="fas fa-file-signature"></i>
                    <span>Documents & Review</span>
                </button>

            </div>

            @if (activeTab == "personal-church")
            {
                <div class="row g-3">

                    <div class="col-12 col-xl-6">
                        <div class="bcc-card update-section-card h-100">
                            <div class="update-section-header">
                                <div class="update-section-icon personal">
                                    <i class="fas fa-user"></i>
                                </div>

                                <div>
                                    <h6>Personal Information</h6>
                                    <p>Identity, contact and personal details.</p>
                                </div>
                            </div>

                            <div class="bcc-card-body p-3">
                                <div class="compact-form-grid">

                                    @Field("First Name", worker.FirstName, @<InputText @bind-Value="profileModel.FirstName" class="form-control form-control-sm" />, true)
                                    @Field("Middle Name", worker.MiddleName, @<InputText @bind-Value="profileModel.MiddleName" class="form-control form-control-sm" />)
                                    @Field("Last Name", worker.LastName, @<InputText @bind-Value="profileModel.LastName" class="form-control form-control-sm" />, true)

                                    @Field("Title", worker.Title, @<select @bind="profileModel.Title" class="form-select form-select-sm">
                                        <option value="">Select Title</option>
                                        <option value="Mr">Mr</option>
                                        <option value="Mrs">Mrs</option>
                                        <option value="Miss">Miss</option>
                                        <option value="Dr">Dr</option>
                                        <option value="Prof">Prof</option>
                                        <option value="Rev">Rev</option>
                                        <option value="Pastor">Pastor</option>
                                        <option value="Deacon">Deacon</option>
                                        <option value="Deaconess">Deaconess</option>
                                    </select>)

                                    @Field("Sex", worker.Sex, @<select @bind="profileModel.Sex" class="form-select form-select-sm">
                                        <option value="">Select Sex</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                        <option value="Other">Other</option>
                                    </select>, true)

                                    @Field("Date of Birth", FormatDate(worker.DateOfBirth), @<InputDate @bind-Value="profileModel.DateOfBirth" class="form-control form-control-sm" />)
                                    @Field("Email", worker.Email, @<InputText @bind-Value="profileModel.Email" class="form-control form-control-sm" />)
                                    @Field("Phone", worker.Phone, @<InputText @bind-Value="profileModel.Phone" class="form-control form-control-sm" />)

                                    @Field("Marital Status", worker.MaritalStatus, @<select @bind="profileModel.MaritalStatus" class="form-select form-select-sm">
                                        <option value="Single">Single</option>
                                        <option value="Married">Married</option>
                                        <option value="Divorced">Divorced</option>
                                        <option value="Widowed">Widowed</option>
                                    </select>)

                                    @Field("Wedding Anniversary", FormatDate(worker.WeddingAnniversary), @<InputDate @bind-Value="profileModel.WeddingAnniversary" class="form-control form-control-sm" />)
                                    @Field("Profession", worker.Profession, @<InputText @bind-Value="profileModel.Profession" class="form-control form-control-sm" />)
                                    @Field("Organisation", worker.Organization, @<InputText @bind-Value="profileModel.Organization" class="form-control form-control-sm" />)

                                    @Field("Address", worker.Address, @<InputTextArea @bind-Value="profileModel.Address" class="form-control form-control-sm" rows="2" />, false, true)

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-6">
                        <div class="bcc-card update-section-card h-100">
                            <div class="update-section-header">
                                <div class="update-section-icon church">
                                    <i class="fas fa-church"></i>
                                </div>

                                <div>
                                    <h6>Church Information</h6>
                                    <p>BCC membership and previous church experience.</p>
                                </div>
                            </div>

                            <div class="bcc-card-body p-3">
                                <div class="compact-form-grid">

                                    @Field("Date Joined BCC", FormatDate(worker.DateJoinedChurch), @<InputDate @bind-Value="profileModel.DateJoinedChurch" class="form-control form-control-sm" />)

                                    @Field("Worker Status", worker.WorkerStatus, @<select @bind="profileModel.WorkerStatus" class="form-select form-select-sm">
                                        <option value="Temp Worker">Temp Worker</option>
                                        <option value="Ordained">Ordained</option>
                                        <option value="Non-Ordained">Non-Ordained</option>
                                    </select>, true)

                                    @Field("Previous Church", worker.PreviousChurch, @<InputText @bind-Value="profileModel.PreviousChurch" class="form-control form-control-sm" />)
                                    @Field("Previous Role", worker.PreviousChurchRole, @<InputText @bind-Value="profileModel.PreviousChurchRole" class="form-control form-control-sm" />)
                                    @Field("Previous Unit", worker.PreviousChurchUnit, @<InputText @bind-Value="profileModel.PreviousChurchUnit" class="form-control form-control-sm" />)

                                    @Field("Previous Experience", profileModel.PreviousExperience, @<InputTextArea @bind-Value="profileModel.PreviousExperience" class="form-control form-control-sm" rows="3" />, false, true)

                                </div>

                                <div class="tab-navigation-footer">
                                    <span>
                                        Continue to ordination and qualifications.
                                    </span>

                                    <button type="button"
                                            class="bcc-btn bcc-btn-primary compact-btn"
                                            @onclick='() => SetTab("ordination-qualification")'>
                                        Next
                                        <i class="fas fa-arrow-right ms-2"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            }

            @if (activeTab == "ordination-qualification")
            {
                <div class="row g-3">

                    <div class="col-12 col-xl-5">
                        <div class="bcc-card update-section-card h-100">
                            <div class="update-section-header">
                                <div class="update-section-icon ordination">
                                    <i class="fas fa-hands-praying"></i>
                                </div>

                                <div>
                                    <h6>Ordination Information</h6>
                                    <p>Current ordination status and history.</p>
                                </div>
                            </div>

                            <div class="bcc-card-body p-3">
                                <div class="compact-form-grid one-column">

                                    @Field("Ordination Status", worker.OrdinationStatus, @<select @bind="profileModel.OrdinationStatus" class="form-select form-select-sm">
                                        <option value="Not Ordained">Not Ordained</option>
                                        <option value="Ordained">Ordained</option>
                                        <option value="Under Consideration">Under Consideration</option>
                                        <option value="Eligible">Eligible</option>
                                    </select>, true)

                                    @Field("Ordination Level", worker.OrdinationLevel, @<select @bind="profileModel.OrdinationLevel" class="form-select form-select-sm">
                                        <option value="Not Ordained">Not Ordained</option>
                                        <option value="Deacon">Deacon</option>
                                        <option value="Deaconess">Deaconess</option>
                                        <option value="Asst Pastor">Asst Pastor</option>
                                        <option value="Pastor">Pastor</option>
                                    </select>)

                                    @Field("Last Ordination Date", FormatDate(worker.LastOrdinationDate), @<InputDate @bind-Value="profileModel.LastOrdinationDate" class="form-control form-control-sm" />)

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-7">
                        <div class="bcc-card update-section-card h-100">
                            <div class="update-section-header">
                                <div class="update-section-icon qualification">
                                    <i class="fas fa-graduation-cap"></i>
                                </div>

                                <div>
                                    <h6>Qualifications & Certificates</h6>
                                    <p>Select completed programmes and upload certificates.</p>
                                </div>
                            </div>

                            <div class="bcc-card-body p-3">

                                @if (isUploadingCertificate)
                                {
                                    <div class="alert alert-info py-2">
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        Uploading certificate...
                                    </div>
                                }

                                <div class="qualification-update-grid">
                                    @QualificationUpload(
                                        "Believer's Baptism",
                                        profileModel.HasBelieverBaptism,
                                        "HasBelieverBaptism",
                                        profileModel.BelieverBaptismCertificatePath,
                                        "BelieverBaptism")

                                    @QualificationUpload(
                                        "Worker in Training",
                                        profileModel.HasWorkerInTraining,
                                        "HasWorkerInTraining",
                                        profileModel.WorkerInTrainingCertificatePath,
                                        "WorkerInTraining")

                                    @QualificationUpload(
                                        "School of Discipleship",
                                        profileModel.HasSOD,
                                        "HasSOD",
                                        profileModel.SODCertificatePath,
                                        "SOD")

                                    @QualificationUpload(
                                        "Bible College",
                                        profileModel.HasBibleCollege,
                                        "HasBibleCollege",
                                        profileModel.BibleCollegeCertificatePath,
                                        "BibleCollege")
                                </div>

                                <div class="tab-navigation-footer">
                                    <button type="button"
                                            class="bcc-btn profile-form-secondary-btn compact-btn"
                                            @onclick='() => SetTab("personal-church")'>
                                        <i class="fas fa-arrow-left me-2"></i>
                                        Previous
                                    </button>

                                    <button type="button"
                                            class="bcc-btn bcc-btn-primary compact-btn"
                                            @onclick='() => SetTab("documents-review")'>
                                        Next
                                        <i class="fas fa-arrow-right ms-2"></i>
                                    </button>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            }

            @if (activeTab == "documents-review")
            {
                <div class="row g-3">

                    <div class="col-12 col-xl-4">
                        <div class="bcc-card update-section-card h-100">
                            <div class="update-section-header">
                                <div class="update-section-icon document">
                                    <i class="fas fa-camera"></i>
                                </div>

                                <div>
                                    <h6>Passport Photo</h6>
                                    <p>Upload or replace your profile photograph.</p>
                                </div>
                            </div>

                            <div class="bcc-card-body p-3">

                                <div class="passport-upload-panel">
                                    @if (!string.IsNullOrWhiteSpace(profileModel.PassportPhotoPath))
                                    {
                                        <img src="/uploads/@profileModel.PassportPhotoPath"
                                             class="passport-preview"
                                             alt="Passport photograph preview" />
                                    }
                                    else
                                    {
                                        <div class="passport-preview-placeholder">
                                            <i class="fas fa-user"></i>
                                        </div>
                                    }

                                    <div class="passport-upload-content">
                                        <label class="form-label compact-label">
                                            Upload Passport Photo
                                        </label>

                                        <InputFile OnChange="@OnPassportPhotoChanged"
                                                   class="form-control form-control-sm"
                                                   accept=".jpg,.jpeg,.png,.gif" />

                                        <small>
                                            Maximum 2MB. JPG, PNG or GIF.
                                        </small>

                                        @if (isUploading)
                                        {
                                            <div class="uploading-line">
                                                <span class="spinner-border spinner-border-sm"></span>
                                                Uploading...
                                            </div>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-8">
                        <div class="bcc-card update-section-card h-100">
                            <div class="update-section-header">
                                <div class="update-section-icon review">
                                    <i class="fas fa-paper-plane"></i>
                                </div>

                                <div>
                                    <h6>Review & Submit</h6>
                                    <p>Review the information before submitting.</p>
                                </div>
                            </div>

                            <div class="bcc-card-body p-3">

                                <div class="review-grid">

                                    <div class="review-card">
                                        <h6>
                                            <i class="fas fa-user"></i>
                                            Personal
                                        </h6>

                                        @ReviewLine("Name", $"{profileModel.Title} {profileModel.FirstName} {profileModel.MiddleName} {profileModel.LastName}")
                                        @ReviewLine("Sex", profileModel.Sex)
                                        @ReviewLine("Email", profileModel.Email)
                                        @ReviewLine("Phone", profileModel.Phone)
                                        @ReviewLine("Marital Status", profileModel.MaritalStatus)
                                    </div>

                                    <div class="review-card">
                                        <h6>
                                            <i class="fas fa-church"></i>
                                            Church
                                        </h6>

                                        @ReviewLine("Date Joined", FormatDate(profileModel.DateJoinedChurch))
                                        @ReviewLine("Worker Status", profileModel.WorkerStatus)
                                        @ReviewLine("Previous Church", profileModel.PreviousChurch)
                                        @ReviewLine("Previous Role", profileModel.PreviousChurchRole)
                                    </div>

                                    <div class="review-card">
                                        <h6>
                                            <i class="fas fa-hands-praying"></i>
                                            Ordination
                                        </h6>

                                        @ReviewLine("Status", profileModel.OrdinationStatus)
                                        @ReviewLine("Level", profileModel.OrdinationLevel)
                                        @ReviewLine("Last Date", FormatDate(profileModel.LastOrdinationDate))
                                    </div>

                                    <div class="review-card">
                                        <h6>
                                            <i class="fas fa-graduation-cap"></i>
                                            Qualifications
                                        </h6>

                                        @ReviewLine("Believer's Baptism", YesNo(profileModel.HasBelieverBaptism))
                                        @ReviewLine("Worker in Training", YesNo(profileModel.HasWorkerInTraining))
                                        @ReviewLine("SOD", YesNo(profileModel.HasSOD))
                                        @ReviewLine("Bible College", YesNo(profileModel.HasBibleCollege))
                                    </div>

                                </div>

                                <div class="approval-information-box mt-3">
                                    <div>
                                        <i class="fas fa-user-check"></i>
                                    </div>

                                    <div>
                                        <strong>Approval Information</strong>

                                        <span>
                                            @if (string.Equals(
                                                approverInfo,
                                                "No approval required",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <text>
                                                    Your profile changes will be applied immediately.
                                                </text>
                                            }
                                            else
                                            {
                                                <text>
                                                    Your changes will be sent to
                                                    <b>@approverInfo</b>
                                                    for approval.
                                                </text>
                                            }
                                        </span>
                                    </div>
                                </div>

                                <ValidationSummary class="compact-validation-summary" />

                                <div class="profile-submit-actions">
                                    <button type="button"
                                            class="bcc-btn profile-form-secondary-btn compact-btn"
                                            @onclick='() => SetTab("ordination-qualification")'>
                                        <i class="fas fa-arrow-left me-2"></i>
                                        Previous
                                    </button>

                                    <div class="d-flex gap-2">
                                        <button type="button"
                                                class="bcc-btn profile-form-secondary-btn compact-btn"
                                                @onclick="NavigateBack">
                                            Cancel
                                        </button>

                                        <button type="submit"
                                                class="bcc-btn bcc-btn-primary compact-btn"
                                                disabled="@isSubmitting">

                                            @if (isSubmitting)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                                <span>Submitting...</span>
                                            }
                                            else
                                            {
                                                <i class="fas fa-paper-plane me-2"></i>
                                                <span>Submit for Approval</span>
                                            }

                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            }

        </EditForm>
    </div>
}

@code {
    private Worker? worker;
    private ProfileUpdateModel profileModel = new();

    private bool isLoading = true;
    private bool isSubmitting;
    private bool isUploading;
    private bool isUploadingCertificate;

    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private string approverInfo = string.Empty;
    private string activeTab = "personal-church";

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated &&
            AuthService.CurrentWorker != null)
        {
            await LoadWorkerData();
            await DetermineApproverInfo();
        }

        isLoading = false;
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private string GetTabClass(string tab)
    {
        return activeTab == tab
            ? "profile-group-tab active"
            : "profile-group-tab";
    }

    private RenderFragment Field(
        string label,
        string? currentValue,
        RenderFragment control,
        bool required = false,
        bool fullWidth = false) => @<div class="compact-field @(fullWidth ? "full-width" : "")">
            <div class="compact-field-top">
                <label>
                    @label
                    @if (required)
                    {
                        <span class="text-danger">*</span>
                    }
                </label>

                <small>
                    Current:
                    <strong>@DisplayValue(currentValue)</strong>
                </small>
            </div>

            @control
        </div>;

    private RenderFragment QualificationUpload(
        string title,
        bool isChecked,
        string propertyName,
        string certificatePath,
        string certificateType) => @<div class="qualification-update-card">

            <div class="qualification-check-line">
                @if (propertyName == "HasBelieverBaptism")
                {
                    <input class="form-check-input"
                           type="checkbox"
                           @bind="profileModel.HasBelieverBaptism" />
                }
                else if (propertyName == "HasWorkerInTraining")
                {
                    <input class="form-check-input"
                           type="checkbox"
                           @bind="profileModel.HasWorkerInTraining" />
                }
                else if (propertyName == "HasSOD")
                {
                    <input class="form-check-input"
                           type="checkbox"
                           @bind="profileModel.HasSOD" />
                }
                else if (propertyName == "HasBibleCollege")
                {
                    <input class="form-check-input"
                           type="checkbox"
                           @bind="profileModel.HasBibleCollege" />
                }

                <strong>@title</strong>
            </div>

            @if (isChecked)
            {
                <InputFile OnChange="@(e => OnCertificateChanged(e, certificateType))"
                           class="form-control form-control-sm"
                           accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />

                <small>Maximum 5MB. PDF, JPG, PNG, DOC or DOCX.</small>

                @if (!string.IsNullOrWhiteSpace(certificatePath))
                {
                    <a href="/uploads/@certificatePath"
                       target="_blank"
                       class="certificate-current-link">
                        <i class="fas fa-file-alt me-1"></i>
                        View Current Certificate
                    </a>
                }
            }
            else
            {
                <span class="qualification-disabled-text">
                    Mark as completed to upload a certificate.
                </span>
            }
        </div>;

    private RenderFragment ReviewLine(
        string label,
        string? value) => @<div class="review-line">
            <span>@label</span>
            <strong>@DisplayValue(value)</strong>
        </div>;

    private async Task LoadWorkerData()
    {
        try
        {
            worker =
                await WorkforceService
                    .GetMyProfileAsync(
                        AuthService.CurrentWorker!.Id);

            if (worker == null)
                return;

            profileModel =
                new ProfileUpdateModel
                {
                    FirstName = worker.FirstName,
                    MiddleName = worker.MiddleName ?? string.Empty,
                    LastName = worker.LastName,
                    Sex = worker.Sex ?? string.Empty,
                    Title = worker.Title ?? string.Empty,
                    Email = worker.Email ?? string.Empty,
                    Phone = worker.Phone ?? string.Empty,
                    DateOfBirth = worker.DateOfBirth,
                    MaritalStatus = worker.MaritalStatus ?? "Single",
                    WeddingAnniversary = worker.WeddingAnniversary,
                    Address = worker.Address ?? string.Empty,
                    Profession = worker.Profession ?? string.Empty,
                    Organization = worker.Organization ?? string.Empty,
                    DateJoinedChurch = worker.DateJoinedChurch,
                    WorkerStatus = worker.WorkerStatus ?? "Temp Worker",
                    PreviousChurch = worker.PreviousChurch ?? string.Empty,
                    PreviousChurchRole = worker.PreviousChurchRole ?? string.Empty,
                    PreviousChurchUnit = worker.PreviousChurchUnit ?? string.Empty,
                    OrdinationStatus = worker.OrdinationStatus ?? "Not Ordained",
                    OrdinationLevel = worker.OrdinationLevel ?? "Not Ordained",
                    LastOrdinationDate = worker.LastOrdinationDate,
                    HasBelieverBaptism = worker.HasBelieverBaptism,
                    HasWorkerInTraining = worker.HasWorkerInTraining,
                    HasSOD = worker.HasSOD,
                    HasBibleCollege = worker.HasBibleCollege,
                    BelieverBaptismCertificatePath = worker.BelieverBaptismCertificatePath ?? string.Empty,
                    WorkerInTrainingCertificatePath = worker.WorkerInTrainingCertificatePath ?? string.Empty,
                    SODCertificatePath = worker.SODCertificatePath ?? string.Empty,
                    BibleCollegeCertificatePath = worker.BibleCollegeCertificatePath ?? string.Empty,
                    PassportPhotoPath = worker.PassportPhotoPath ?? string.Empty,
                    PassportPhotoThumbPath = worker.PassportPhotoThumbPath ?? string.Empty
                };
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Error loading worker data: {ex.Message}";
        }
    }

    private async Task DetermineApproverInfo()
    {
        if (worker == null)
            return;

        try
        {
            approverInfo =
                await WorkforceService
                    .GetProfileUpdateApprovalDescriptionAsync(
                        worker.Id);
        }
        catch (Exception ex)
        {
            approverInfo =
                "Unable to determine approver";

            Console.WriteLine(
                $"Approver lookup failed: {ex.Message}");
        }
    }

    private async Task SubmitForApproval()
    {
        if (worker == null ||
            isSubmitting)
        {
            return;
        }

        try
        {
            isSubmitting = true;
            successMessage = string.Empty;
            errorMessage = string.Empty;

            var changes =
                new ProposedChanges
                {
                    FirstName = profileModel.FirstName,
                    MiddleName = profileModel.MiddleName,
                    LastName = profileModel.LastName,
                    Sex = profileModel.Sex,
                    Title = profileModel.Title,
                    Email = profileModel.Email,
                    Phone = profileModel.Phone,
                    DateOfBirth = profileModel.DateOfBirth,
                    MaritalStatus = profileModel.MaritalStatus,
                    WeddingAnniversary = profileModel.WeddingAnniversary,
                    Address = profileModel.Address,
                    Profession = profileModel.Profession,
                    Organization = profileModel.Organization,
                    DateJoinedChurch = profileModel.DateJoinedChurch,
                    WorkerStatus = profileModel.WorkerStatus,
                    PreviousChurch = profileModel.PreviousChurch,
                    PreviousChurchRole = profileModel.PreviousChurchRole,
                    PreviousChurchUnit = profileModel.PreviousChurchUnit,
                    PreviousExperience = profileModel.PreviousExperience,
                    OrdinationStatus = profileModel.OrdinationStatus,
                    OrdinationLevel = profileModel.OrdinationLevel,
                    LastOrdinationDate = profileModel.LastOrdinationDate,
                    HasBelieverBaptism = profileModel.HasBelieverBaptism,
                    HasWorkerInTraining = profileModel.HasWorkerInTraining,
                    HasSOD = profileModel.HasSOD,
                    HasBibleCollege = profileModel.HasBibleCollege,
                    BelieverBaptismCertificatePath = profileModel.BelieverBaptismCertificatePath,
                    WorkerInTrainingCertificatePath = profileModel.WorkerInTrainingCertificatePath,
                    SODCertificatePath = profileModel.SODCertificatePath,
                    BibleCollegeCertificatePath = profileModel.BibleCollegeCertificatePath,
                    PassportPhotoPath = profileModel.PassportPhotoPath
                };

            var request =
                await WorkforceService
                    .SubmitProfileUpdateAsync(
                        worker.Id,
                        changes,
                        AuthService);

            successMessage =
                request.Id == -1
                    ? "Your profile was updated successfully."
                    : "Your profile changes were submitted for approval.";

            Navigation.NavigateTo(
                "/workforce/my-profile");
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Error submitting profile update: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task OnPassportPhotoChanged(
        InputFileChangeEventArgs e)
    {
        if (worker == null)
            return;

        try
        {
            isUploading = true;
            errorMessage = string.Empty;

            var file = e.File;

            if (file.Size > 2 * 1024 * 1024)
            {
                throw new Exception(
                    "File size must be less than 2MB.");
            }

            var allowedExtensions =
                new[]
                {
                    ".jpg",
                    ".jpeg",
                    ".png",
                    ".gif"
                };

            var extension =
                Path.GetExtension(file.Name)
                    .ToLowerInvariant();

            if (!allowedExtensions.Contains(extension))
            {
                throw new Exception(
                    "Only JPG, PNG and GIF files are allowed.");
            }

            var folder =
                Environment.IsDevelopment()
                    ? Path.Combine(
                        Environment.ContentRootPath,
                        "wwwroot",
                        "uploads")
                    : "/var/data/uploads";

            Directory.CreateDirectory(folder);

            var fileName =
                $"{worker.WorkerId}_passport_" +
                $"{Guid.NewGuid()}{extension}";

            var filePath =
                Path.Combine(folder, fileName);

            using var image =
                await Image.LoadAsync(
                    file.OpenReadStream(
                        5 * 1024 * 1024));

            image.Mutate(x =>
                x.Resize(
                    new ResizeOptions
                    {
                        Size = new Size(800, 800),
                        Mode = ResizeMode.Max
                    }));

            await image.SaveAsJpegAsync(
                filePath,
                new JpegEncoder
                {
                    Quality = 75
                });

            var mobileName =
                $"{Path.GetFileNameWithoutExtension(fileName)}_mobile.webp";

            await imageOptimizationService
                .CreateMobileVersion(
                    filePath,
                    Path.Combine(folder, mobileName));

            profileModel.PassportPhotoPath =
                fileName;

            profileModel.PassportPhotoThumbPath =
                mobileName;

            successMessage =
                "Passport photo uploaded successfully.";
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Error uploading photo: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task OnCertificateChanged(
        InputFileChangeEventArgs e,
        string certificateType)
    {
        if (worker == null)
            return;

        try
        {
            isUploadingCertificate = true;
            errorMessage = string.Empty;

            var file = e.File;

            if (file.Size > 5 * 1024 * 1024)
            {
                throw new Exception(
                    "Certificate file size must be less than 5MB.");
            }

            var allowedExtensions =
                new[]
                {
                    ".pdf",
                    ".jpg",
                    ".jpeg",
                    ".png",
                    ".doc",
                    ".docx"
                };

            var extension =
                Path.GetExtension(file.Name)
                    .ToLowerInvariant();

            if (!allowedExtensions.Contains(extension))
            {
                throw new Exception(
                    "Only PDF, JPG, PNG, DOC and DOCX files are allowed.");
            }

            var folder =
                Environment.IsDevelopment()
                    ? Path.Combine(
                        Environment.ContentRootPath,
                        "wwwroot",
                        "uploads")
                    : "/var/data/uploads";

            Directory.CreateDirectory(folder);

            var fileName =
                $"{worker.WorkerId}_" +
                $"{certificateType.ToLowerInvariant()}_" +
                $"{Guid.NewGuid()}{extension}";

            var filePath =
                Path.Combine(folder, fileName);

            await using var stream =
                new FileStream(
                    filePath,
                    FileMode.Create);

            await file
                .OpenReadStream(5 * 1024 * 1024)
                .CopyToAsync(stream);

            switch (certificateType)
            {
                case "BelieverBaptism":
                    profileModel.BelieverBaptismCertificatePath =
                        fileName;
                    break;

                case "WorkerInTraining":
                    profileModel.WorkerInTrainingCertificatePath =
                        fileName;
                    break;

                case "SOD":
                    profileModel.SODCertificatePath =
                        fileName;
                    break;

                case "BibleCollege":
                    profileModel.BibleCollegeCertificatePath =
                        fileName;
                    break;
            }

            successMessage =
                $"{certificateType} certificate uploaded successfully.";
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Error uploading {certificateType} certificate: {ex.Message}";
        }
        finally
        {
            isUploadingCertificate = false;
        }
    }

    private static string DisplayValue(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Not provided"
            : value.Trim();
    }

    private static string FormatDate(
        DateTime? value)
    {
        return value?.ToString(
            "dd MMM yyyy") ?? string.Empty;
    }

    private static string YesNo(bool value)
    {
        return value ? "Yes" : "No";
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo(
            "/workforce/my-profile");
    }

    public class ProfileUpdateModel
    {
        [Required(ErrorMessage = "First name is required")]
        [MaxLength(50)]
        public string FirstName { get; set; } = string.Empty;

        [MaxLength(50)]
        public string MiddleName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last name is required")]
        [MaxLength(50)]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Sex is required")]
        [MaxLength(10)]
        public string Sex { get; set; } = string.Empty;

        [MaxLength(20)]
        public string Title { get; set; } = string.Empty;

        [EmailAddress]
        [MaxLength(100)]
        public string Email { get; set; } = string.Empty;

        [MaxLength(20)]
        public string Phone { get; set; } = string.Empty;

        public DateTime? DateOfBirth { get; set; }

        public string MaritalStatus { get; set; } = "Single";

        public DateTime? WeddingAnniversary { get; set; }

        [MaxLength(500)]
        public string Address { get; set; } = string.Empty;

        [MaxLength(100)]
        public string Profession { get; set; } = string.Empty;

        [MaxLength(100)]
        public string Organization { get; set; } = string.Empty;

        public DateTime? DateJoinedChurch { get; set; }

        [Required]
        public string WorkerStatus { get; set; } = "Temp Worker";

        [MaxLength(200)]
        public string PreviousChurch { get; set; } = string.Empty;

        [MaxLength(100)]
        public string PreviousChurchRole { get; set; } = string.Empty;

        [MaxLength(100)]
        public string PreviousChurchUnit { get; set; } = string.Empty;

        [MaxLength(500)]
        public string PreviousExperience { get; set; } = string.Empty;

        [Required]
        public string OrdinationStatus { get; set; } = "Not Ordained";

        [MaxLength(50)]
        public string OrdinationLevel { get; set; } = "Not Ordained";

        public DateTime? LastOrdinationDate { get; set; }

        public bool HasBelieverBaptism { get; set; }
        public bool HasWorkerInTraining { get; set; }
        public bool HasSOD { get; set; }
        public bool HasBibleCollege { get; set; }

        public string BelieverBaptismCertificatePath { get; set; } = string.Empty;
        public string WorkerInTrainingCertificatePath { get; set; } = string.Empty;
        public string SODCertificatePath { get; set; } = string.Empty;
        public string BibleCollegeCertificatePath { get; set; } = string.Empty;

        public string PassportPhotoPath { get; set; } = string.Empty;
        public string? PassportPhotoThumbPath { get; set; } = string.Empty;
    }
}

