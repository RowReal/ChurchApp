@page "/workforce/my-inbox"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services
@using System.Text.Json

@inject WorkforceService WorkforceService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>My Inbox - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access your profile approval inbox.</p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else if (isLoading)
{
    <div class="worker360-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-4">
                <div class="spinner-border text-primary"></div>

                <div class="mt-2 text-muted">
                    Loading profile approval inbox...
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="worker360-page workforce-inbox-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success py-2">
                <i class="fas fa-check-circle me-2"></i>
                @successMessage
            </div>
        }

        <div class="bcc-page-header workforce-inbox-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-inbox me-2"></i>
                    Team Management
                </div>

                <div class="bcc-page-title">
                    Profile Approval Inbox
                </div>

                <div class="bcc-page-subtitle">
                    Review and decide profile update requests assigned to you.
                </div>
            </div>

            <div class="inbox-header-actions">
                <span class="pending-count-badge">
                    @pendingRequests.Count Pending
                </span>

                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        @onclick="GoBack">
                    <i class="fas fa-arrow-left me-2"></i>
                    Back
                </button>
            </div>
        </div>

        @if (!pendingRequests.Any())
        {
            <div class="bcc-card">
                <div class="bcc-card-body">
                    <div class="bcc-empty py-4">
                        <i class="fas fa-inbox"></i>
                        <h4>No Pending Requests</h4>
                        <p>You do not have any profile update request awaiting review.</p>

                        <a href="/workforce/my-profile"
                           class="bcc-btn bcc-btn-primary compact-btn">
                            <i class="fas fa-user me-2"></i>
                            Go to My Profile
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">

                <div class="col-12 col-xl-4">
                    <div class="bcc-card inbox-list-card">
                        <div class="inbox-panel-header">
                            <div>
                                <h6>
                                    <i class="fas fa-list me-2"></i>
                                    Pending Requests
                                </h6>

                                <p>
                                    Select a request to review.
                                </p>
                            </div>
                        </div>

                        <div class="inbox-list">

                            @foreach (var request in pendingRequests
                                .OrderBy(r => r.SubmittedDate))
                            {
                                <button type="button"
                                        class="@GetRequestItemClass(request)"
                                        @onclick="() => SelectRequest(request)">

                                    <div class="request-avatar">
                                        @GetWorkerInitials(request.Worker)
                                    </div>

                                    <div class="request-list-content">
                                        <strong>
                                            @request.Worker.FirstName
                                            @request.Worker.LastName
                                        </strong>

                                        <span>
                                            @request.Worker.WorkerId
                                            ·
                                            @(request.Worker.Directorate?.Name
                                                ?? "No Directorate")
                                        </span>

                                        <small>
                                            Submitted
                                            @request.SubmittedDate.ToString("dd MMM yyyy")
                                        </small>
                                    </div>

                                    <div class="request-age">
                                        @GetDaysPending(request)
                                    </div>

                                </button>
                            }

                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-8">

                    @if (selectedRequest == null)
                    {
                        <div class="bcc-card">
                            <div class="bcc-card-body">
                                <div class="bcc-empty py-4">
                                    <i class="fas fa-hand-pointer"></i>
                                    <h4>Select a Request</h4>
                                    <p>Choose a pending profile update from the left.</p>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        var proposedChanges =
                            DeserializeChanges(selectedRequest);

                        var displayChanges =
                            GetChangesForDisplay(selectedRequest);

                        <div class="bcc-card request-detail-card">

                            <div class="selected-request-header">
                                <div class="selected-worker-main">

                                    <div class="request-avatar large">
                                        @GetWorkerInitials(selectedRequest.Worker)
                                    </div>

                                    <div>
                                        <h5>
                                            @selectedRequest.Worker.FirstName
                                            @selectedRequest.Worker.LastName
                                        </h5>

                                        <div class="selected-worker-meta">
                                            <span>
                                                <i class="fas fa-id-badge"></i>
                                                @selectedRequest.Worker.WorkerId
                                            </span>

                                            <span>
                                                <i class="fas fa-user-tag"></i>
                                                @selectedRequest.Worker.Role
                                            </span>

                                            <span>
                                                <i class="fas fa-building"></i>
                                                @(selectedRequest.Worker.Directorate?.Name
                                                    ?? "No Directorate")
                                            </span>

                                            <span>
                                                <i class="fas fa-sitemap"></i>
                                                @(selectedRequest.Worker.Department?.Name
                                                    ?? "No Department")
                                            </span>
                                        </div>
                                    </div>

                                </div>

                                <div class="selected-request-status">
                                    <span>Pending Approval</span>

                                    <strong>
                                        @GetDaysPending(selectedRequest)
                                    </strong>

                                    <small>
                                        Submitted
                                        @selectedRequest.SubmittedDate
                                            .ToString("dd MMM yyyy, hh:mm tt")
                                    </small>
                                </div>
                            </div>

                            <div class="bcc-card-body p-3">

                                <div class="request-section-heading">
                                    <div>
                                        <h6>
                                            <i class="fas fa-exchange-alt me-2"></i>
                                            Proposed Changes
                                        </h6>

                                        <p>
                                            @displayChanges.Count field(s) changed.
                                        </p>
                                    </div>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            @onclick="() => ViewWorkerProfile(selectedRequest.WorkerId)">
                                        <i class="fas fa-eye me-1"></i>
                                        View Full Profile
                                    </button>
                                </div>

                                @if (!displayChanges.Any())
                                {
                                    <div class="empty-changes">
                                        No changed fields were detected.
                                    </div>
                                }
                                else
                                {
                                    <div class="changes-grid">

                                        @foreach (var change in displayChanges)
                                        {
                                            <div class="change-card">
                                                <div class="change-field">
                                                    @change.FieldName
                                                </div>

                                                <div class="change-values">

                                                    <div class="change-current">
                                                        <span>Current</span>
                                                        <strong>
                                                            @DisplayValue(change.CurrentValue)
                                                        </strong>
                                                    </div>

                                                    <div class="change-arrow">
                                                        <i class="fas fa-arrow-right"></i>
                                                    </div>

                                                    <div class="change-proposed">
                                                        <span>Proposed</span>
                                                        <strong>
                                                            @DisplayValue(change.ProposedValue)
                                                        </strong>
                                                    </div>

                                                </div>
                                            </div>
                                        }

                                    </div>
                                }

                                @if (proposedChanges != null &&
                                     HasUploadedDocuments(proposedChanges))
                                {
                                    <div class="request-section-heading documents-heading">
                                        <div>
                                            <h6>
                                                <i class="fas fa-file-upload me-2"></i>
                                                Uploaded Documents
                                            </h6>

                                            <p>
                                                New files submitted with this request.
                                            </p>
                                        </div>
                                    </div>

                                    <div class="document-grid">

                                        @if (!string.IsNullOrWhiteSpace(
                                            proposedChanges.PassportPhotoPath))
                                        {
                                            <div class="document-card passport-document">
                                                <img src="/uploads/@proposedChanges.PassportPhotoPath"
                                                     alt="New passport photograph" />

                                                <div>
                                                    <strong>Passport Photo</strong>

                                                    <a href="/uploads/@proposedChanges.PassportPhotoPath"
                                                       target="_blank">
                                                        View Full Size
                                                    </a>
                                                </div>
                                            </div>
                                        }

                                        @DocumentItem(
                                            "Believer's Baptism Certificate",
                                            proposedChanges.BelieverBaptismCertificatePath)

                                        @DocumentItem(
                                            "Worker in Training Certificate",
                                            proposedChanges.WorkerInTrainingCertificatePath)

                                        @DocumentItem(
                                            "School of Discipleship Certificate",
                                            proposedChanges.SODCertificatePath)

                                        @DocumentItem(
                                            "Bible College Certificate",
                                            proposedChanges.BibleCollegeCertificatePath)

                                    </div>
                                }

                                <div class="request-action-bar">

                                    <span>
                                        Request ID:
                                        <strong>@selectedRequest.Id</strong>
                                    </span>

                                    <div class="d-flex gap-2">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                @onclick="() => ShowRejectModal(selectedRequest)">
                                            <i class="fas fa-times me-1"></i>
                                            Reject
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-success"
                                                @onclick="() => ShowApproveModal(selectedRequest)">
                                            <i class="fas fa-check me-1"></i>
                                            Approve
                                        </button>
                                    </div>

                                </div>

                            </div>
                        </div>
                    }

                </div>

            </div>
        }
    </div>
}

@if (showApproveModal && selectedRequest != null)
{
    <div class="inbox-popup-backdrop"
         @onclick="CloseModal">

        <div class="inbox-popup-card"
             @onclick:stopPropagation="true">

            <div class="inbox-popup-header approve">
                <div>
                    <h4>Approve Profile Update</h4>

                    <p>
                        @selectedRequest.Worker.FirstName
                        @selectedRequest.Worker.LastName
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        @onclick="CloseModal">
                </button>
            </div>

            <div class="decision-note approve">
                <i class="fas fa-check-circle"></i>

                <span>
                    Approving will apply all proposed changes to the worker’s profile.
                </span>
            </div>

            <label class="form-label compact-label">
                Approval Notes
                <span class="text-muted fw-normal">(Optional)</span>
            </label>

            <textarea class="form-control form-control-sm"
                      rows="3"
                      @bind="approvalNotes"
                      placeholder="Add an approval note if required.">
            </textarea>

            <div class="popup-actions">
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        disabled="@isProcessing"
                        @onclick="CloseModal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-success btn-sm"
                        disabled="@isProcessing"
                        @onclick="ApproveRequest">

                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Approving...</span>
                    }
                    else
                    {
                        <i class="fas fa-check me-2"></i>
                        <span>Approve Changes</span>
                    }

                </button>
            </div>

        </div>
    </div>
}

@if (showRejectModal && selectedRequest != null)
{
    <div class="inbox-popup-backdrop"
         @onclick="CloseModal">

        <div class="inbox-popup-card"
             @onclick:stopPropagation="true">

            <div class="inbox-popup-header reject">
                <div>
                    <h4>Reject Profile Update</h4>

                    <p>
                        @selectedRequest.Worker.FirstName
                        @selectedRequest.Worker.LastName
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        @onclick="CloseModal">
                </button>
            </div>

            <div class="decision-note reject">
                <i class="fas fa-exclamation-triangle"></i>

                <span>
                    The worker should receive a clear reason for the rejection.
                </span>
            </div>

            <label class="form-label compact-label">
                Rejection Reason
                <span class="text-danger">*</span>
            </label>

            <textarea class="form-control form-control-sm"
                      rows="3"
                      @bind="rejectionNotes"
                      placeholder="Explain what the worker needs to correct.">
            </textarea>

            @if (showRejectionValidation)
            {
                <div class="text-danger small mt-1">
                    Rejection reason is required.
                </div>
            }

            <div class="popup-actions">
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        disabled="@isProcessing"
                        @onclick="CloseModal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-danger btn-sm"
                        disabled="@isProcessing"
                        @onclick="RejectRequest">

                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Rejecting...</span>
                    }
                    else
                    {
                        <i class="fas fa-times me-2"></i>
                        <span>Reject Changes</span>
                    }

                </button>
            </div>

        </div>
    </div>
}

@code {
    private List<ProfileUpdateRequest> pendingRequests = new();

    private ProfileUpdateRequest? selectedRequest;

    private bool isLoading = true;
    private bool showApproveModal;
    private bool showRejectModal;
    private bool isProcessing;
    private bool showRejectionValidation;

    private string approvalNotes = string.Empty;
    private string rejectionNotes = string.Empty;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPendingRequests();
    }

    private async Task LoadPendingRequests(
        int? preferredRequestId = null)
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            if (!AuthService.IsAuthenticated ||
                AuthService.CurrentWorker == null)
            {
                return;
            }

            pendingRequests =
                await WorkforceService
                    .GetPendingApprovalsAsync(
                        AuthService.CurrentWorker.Id);

            selectedRequest =
                preferredRequestId.HasValue
                    ? pendingRequests.FirstOrDefault(
                        x => x.Id == preferredRequestId.Value)
                    : selectedRequest != null
                        ? pendingRequests.FirstOrDefault(
                            x => x.Id == selectedRequest.Id)
                        : pendingRequests
                            .OrderBy(x => x.SubmittedDate)
                            .FirstOrDefault();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load profile approval requests: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectRequest(
        ProfileUpdateRequest request)
    {
        selectedRequest = request;
        successMessage = string.Empty;
        errorMessage = string.Empty;
    }

    private string GetRequestItemClass(
        ProfileUpdateRequest request)
    {
        return selectedRequest?.Id == request.Id
            ? "inbox-request-item active"
            : "inbox-request-item";
    }

    private static ProposedChanges? DeserializeChanges(
        ProfileUpdateRequest request)
    {
        if (string.IsNullOrWhiteSpace(
            request.ProposedChanges))
        {
            return null;
        }

        try
        {
            return JsonSerializer
                .Deserialize<ProposedChanges>(
                    request.ProposedChanges);
        }
        catch
        {
            return null;
        }
    }

    private bool HasUploadedDocuments(
        ProposedChanges changes)
    {
        return
            !string.IsNullOrWhiteSpace(
                changes.PassportPhotoPath) ||

            !string.IsNullOrWhiteSpace(
                changes.BelieverBaptismCertificatePath) ||

            !string.IsNullOrWhiteSpace(
                changes.WorkerInTrainingCertificatePath) ||

            !string.IsNullOrWhiteSpace(
                changes.SODCertificatePath) ||

            !string.IsNullOrWhiteSpace(
                changes.BibleCollegeCertificatePath);
    }

    private List<ChangeDisplay> GetChangesForDisplay(
        ProfileUpdateRequest request)
    {
        var changes =
            new List<ChangeDisplay>();

        var proposedChanges =
            DeserializeChanges(request);

        if (proposedChanges == null)
            return changes;

        AddChangeIfDifferent(
            changes,
            "First Name",
            request.Worker.FirstName,
            proposedChanges.FirstName);

        AddChangeIfDifferent(
            changes,
            "Middle Name",
            request.Worker.MiddleName,
            proposedChanges.MiddleName);

        AddChangeIfDifferent(
            changes,
            "Last Name",
            request.Worker.LastName,
            proposedChanges.LastName);

        AddChangeIfDifferent(
            changes,
            "Title",
            request.Worker.Title,
            proposedChanges.Title);

        AddChangeIfDifferent(
            changes,
            "Sex",
            request.Worker.Sex,
            proposedChanges.Sex);

        AddChangeIfDifferent(
            changes,
            "Email",
            request.Worker.Email,
            proposedChanges.Email);

        AddChangeIfDifferent(
            changes,
            "Phone",
            request.Worker.Phone,
            proposedChanges.Phone);

        AddDateChangeIfDifferent(
            changes,
            "Date of Birth",
            request.Worker.DateOfBirth,
            proposedChanges.DateOfBirth);

        AddChangeIfDifferent(
            changes,
            "Marital Status",
            request.Worker.MaritalStatus,
            proposedChanges.MaritalStatus);

        AddDateChangeIfDifferent(
            changes,
            "Wedding Anniversary",
            request.Worker.WeddingAnniversary,
            proposedChanges.WeddingAnniversary);

        AddChangeIfDifferent(
            changes,
            "Address",
            request.Worker.Address,
            proposedChanges.Address);

        AddChangeIfDifferent(
            changes,
            "Profession",
            request.Worker.Profession,
            proposedChanges.Profession);

        AddChangeIfDifferent(
            changes,
            "Organisation",
            request.Worker.Organization,
            proposedChanges.Organization);

        AddDateChangeIfDifferent(
            changes,
            "Date Joined BCC",
            request.Worker.DateJoinedChurch,
            proposedChanges.DateJoinedChurch);

        AddChangeIfDifferent(
            changes,
            "Worker Status",
            request.Worker.WorkerStatus,
            proposedChanges.WorkerStatus);

        AddChangeIfDifferent(
            changes,
            "Previous Church",
            request.Worker.PreviousChurch,
            proposedChanges.PreviousChurch);

        AddChangeIfDifferent(
            changes,
            "Previous Role",
            request.Worker.PreviousChurchRole,
            proposedChanges.PreviousChurchRole);

        AddChangeIfDifferent(
            changes,
            "Previous Unit",
            request.Worker.PreviousChurchUnit,
            proposedChanges.PreviousChurchUnit);

        AddChangeIfDifferent(
            changes,
            "Ordination Status",
            request.Worker.OrdinationStatus,
            proposedChanges.OrdinationStatus);

        AddChangeIfDifferent(
            changes,
            "Ordination Level",
            request.Worker.OrdinationLevel,
            proposedChanges.OrdinationLevel);

        AddDateChangeIfDifferent(
            changes,
            "Last Ordination Date",
            request.Worker.LastOrdinationDate,
            proposedChanges.LastOrdinationDate);

        AddBoolChangeIfDifferent(
            changes,
            "Believer's Baptism",
            request.Worker.HasBelieverBaptism,
            proposedChanges.HasBelieverBaptism);

        AddBoolChangeIfDifferent(
            changes,
            "Worker in Training",
            request.Worker.HasWorkerInTraining,
            proposedChanges.HasWorkerInTraining);

        AddBoolChangeIfDifferent(
            changes,
            "School of Discipleship",
            request.Worker.HasSOD,
            proposedChanges.HasSOD);

        AddBoolChangeIfDifferent(
            changes,
            "Bible College",
            request.Worker.HasBibleCollege,
            proposedChanges.HasBibleCollege);

        AddFileChangeIfDifferent(
            changes,
            "Passport Photo",
            request.Worker.PassportPhotoPath,
            proposedChanges.PassportPhotoPath);

        AddFileChangeIfDifferent(
            changes,
            "Baptism Certificate",
            request.Worker.BelieverBaptismCertificatePath,
            proposedChanges.BelieverBaptismCertificatePath);

        AddFileChangeIfDifferent(
            changes,
            "Training Certificate",
            request.Worker.WorkerInTrainingCertificatePath,
            proposedChanges.WorkerInTrainingCertificatePath);

        AddFileChangeIfDifferent(
            changes,
            "SOD Certificate",
            request.Worker.SODCertificatePath,
            proposedChanges.SODCertificatePath);

        AddFileChangeIfDifferent(
            changes,
            "Bible College Certificate",
            request.Worker.BibleCollegeCertificatePath,
            proposedChanges.BibleCollegeCertificatePath);

        return changes;
    }

    private static void AddChangeIfDifferent(
        ICollection<ChangeDisplay> changes,
        string fieldName,
        string? currentValue,
        string? proposedValue)
    {
        var current =
            currentValue?.Trim() ?? string.Empty;

        var proposed =
            proposedValue?.Trim() ?? string.Empty;

        if (string.Equals(
            current,
            proposed,
            StringComparison.Ordinal))
        {
            return;
        }

        changes.Add(
            new ChangeDisplay
            {
                FieldName = fieldName,
                CurrentValue = current,
                ProposedValue = proposed
            });
    }

    private static void AddDateChangeIfDifferent(
        ICollection<ChangeDisplay> changes,
        string fieldName,
        DateTime? currentValue,
        DateTime? proposedValue)
    {
        if (currentValue?.Date ==
            proposedValue?.Date)
        {
            return;
        }

        changes.Add(
            new ChangeDisplay
            {
                FieldName = fieldName,
                CurrentValue =
                    currentValue?
                        .ToString("dd MMM yyyy")
                    ?? string.Empty,

                ProposedValue =
                    proposedValue?
                        .ToString("dd MMM yyyy")
                    ?? string.Empty
            });
    }

    private static void AddBoolChangeIfDifferent(
        ICollection<ChangeDisplay> changes,
        string fieldName,
        bool currentValue,
        bool proposedValue)
    {
        if (currentValue == proposedValue)
            return;

        changes.Add(
            new ChangeDisplay
            {
                FieldName = fieldName,
                CurrentValue =
                    currentValue ? "Yes" : "No",

                ProposedValue =
                    proposedValue ? "Yes" : "No"
            });
    }

    private static void AddFileChangeIfDifferent(
        ICollection<ChangeDisplay> changes,
        string fieldName,
        string? currentValue,
        string? proposedValue)
    {
        if (string.IsNullOrWhiteSpace(
            proposedValue) ||
            string.Equals(
                currentValue,
                proposedValue,
                StringComparison.Ordinal))
        {
            return;
        }

        changes.Add(
            new ChangeDisplay
            {
                FieldName = fieldName,
                CurrentValue =
                    string.IsNullOrWhiteSpace(currentValue)
                        ? "No file"
                        : "Existing file",

                ProposedValue =
                    "New file uploaded"
            });
    }

    private RenderFragment DocumentItem(
        string title,
        string? path) => builder =>
    {
        if (string.IsNullOrWhiteSpace(path))
            return;

        var sequence = 0;

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(
            sequence++,
            "class",
            "document-card certificate-document");

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(
            sequence++,
            "class",
            "document-file-icon");

        builder.OpenElement(sequence++, "i");
        builder.AddAttribute(
            sequence++,
            "class",
            "fas fa-file-alt");
        builder.CloseElement();

        builder.CloseElement();

        builder.OpenElement(sequence++, "div");

        builder.OpenElement(sequence++, "strong");
        builder.AddContent(sequence++, title);
        builder.CloseElement();

        builder.OpenElement(sequence++, "a");
        builder.AddAttribute(
            sequence++,
            "href",
            $"/uploads/{path}");
        builder.AddAttribute(
            sequence++,
            "target",
            "_blank");
        builder.AddContent(sequence++, "View Document");
        builder.CloseElement();

        builder.CloseElement();
        builder.CloseElement();
    };

    private void ShowApproveModal(
        ProfileUpdateRequest request)
    {
        selectedRequest = request;
        approvalNotes = string.Empty;
        showApproveModal = true;
        showRejectModal = false;
    }

    private void ShowRejectModal(
        ProfileUpdateRequest request)
    {
        selectedRequest = request;
        rejectionNotes = string.Empty;
        showRejectionValidation = false;
        showRejectModal = true;
        showApproveModal = false;
    }

    private void CloseModal()
    {
        if (isProcessing)
            return;

        showApproveModal = false;
        showRejectModal = false;
        showRejectionValidation = false;
        approvalNotes = string.Empty;
        rejectionNotes = string.Empty;
    }

    private async Task ApproveRequest()
    {
        if (selectedRequest == null ||
            AuthService.CurrentWorker == null ||
            isProcessing)
        {
            return;
        }

        try
        {
            isProcessing = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            var requestId =
                selectedRequest.Id;

            var success =
                await WorkforceService
                    .ProcessProfileUpdateAsync(
                        requestId,
                        AuthService.CurrentWorker.Id,
                        true,
                        approvalNotes.Trim());

            if (!success)
            {
                throw new Exception(
                    "The profile update could not be approved.");
            }

            CloseModal();

            successMessage =
                "The profile update was approved successfully.";

            await LoadPendingRequests();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to approve the request: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            showApproveModal = false;
        }
    }

    private async Task RejectRequest()
    {
        if (selectedRequest == null ||
            AuthService.CurrentWorker == null ||
            isProcessing)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(
            rejectionNotes))
        {
            showRejectionValidation = true;
            return;
        }

        try
        {
            isProcessing = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            var success =
                await WorkforceService
                    .ProcessProfileUpdateAsync(
                        selectedRequest.Id,
                        AuthService.CurrentWorker.Id,
                        false,
                        rejectionNotes.Trim());

            if (!success)
            {
                throw new Exception(
                    "The profile update could not be rejected.");
            }

            CloseModal();

            successMessage =
                "The profile update was rejected successfully.";

            await LoadPendingRequests();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to reject the request: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            showRejectModal = false;
        }
    }

    private void ViewWorkerProfile(
        int workerId)
    {
        if (AuthService.CanAccessAdminPanel())
        {
            Navigation.NavigateTo(
                $"/admin/worker-details/{workerId}");
        }
        else
        {
            Navigation.NavigateTo(
                $"/workforce/view-worker/{workerId}");
        }
    }

    private static string GetWorkerInitials(
        Worker worker)
    {
        var first =
            string.IsNullOrWhiteSpace(worker.FirstName)
                ? string.Empty
                : worker.FirstName[..1];

        var last =
            string.IsNullOrWhiteSpace(worker.LastName)
                ? string.Empty
                : worker.LastName[..1];

        var initials =
            $"{first}{last}".ToUpperInvariant();

        return string.IsNullOrWhiteSpace(initials)
            ? "W"
            : initials;
    }

    private static string GetDaysPending(
        ProfileUpdateRequest request)
    {
        var submitted =
            request.SubmittedDate.Kind ==
                DateTimeKind.Utc
                    ? request.SubmittedDate
                    : request.SubmittedDate
                        .ToUniversalTime();

        var days =
            Math.Max(
                0,
                (DateTime.UtcNow - submitted).Days);

        return days == 1
            ? "1 day"
            : $"{days} days";
    }

    private static string DisplayValue(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Empty"
            : value.Trim();
    }

    private void GoBack()
    {
        Navigation.NavigateTo(
            "/workspace/my-team");
    }

    private sealed class ChangeDisplay
    {
        public string FieldName { get; init; } =
            string.Empty;

        public string CurrentValue { get; init; } =
            string.Empty;

        public string ProposedValue { get; init; } =
            string.Empty;
    }
}

