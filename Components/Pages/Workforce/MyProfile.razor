@page "/workforce/my-profile"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services

@inject WorkforceService WorkforceService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>My Profile - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access your profile.</p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else if (isLoading)
{
    <div class="worker360-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-4">
                <div class="spinner-border text-primary"></div>
                <div class="mt-2 text-muted">
                    Loading your profile...
                </div>
            </div>
        </div>
    </div>
}
else if (worker == null)
{
    <div class="bcc-empty">
        <i class="fas fa-user-slash"></i>
        <h4>Profile Not Found</h4>
        <p>Your worker profile could not be loaded.</p>

        <button type="button"
                class="bcc-btn bcc-btn-primary"
                @onclick="GoBack">
            Return to Dashboard
        </button>
    </div>
}
else
{
    <div class="worker360-page my-profile-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        <div class="bcc-page-header my-profile-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-user-circle me-2"></i>
                    Workforce Profile
                </div>

                <div class="bcc-page-title">
                    My Profile
                </div>

                <div class="bcc-page-subtitle">
                    Personal, church, qualification and service information.
                </div>
            </div>

            <button type="button"
                    class="bcc-btn bcc-btn-primary compact-btn"
                    disabled="@hasPendingUpdate"
                    @onclick="NavigateToUpdate">
                <i class="fas fa-edit me-2"></i>
                @(hasPendingUpdate ? "Update Pending" : "Update Profile")
            </button>
        </div>

        @if (hasPendingUpdate)
        {
            <div class="pending-update-banner mb-3">
                <div>
                    <i class="fas fa-clock"></i>
                </div>

                <div class="flex-grow-1">
                    <strong>Profile Update Pending Approval</strong>

                    <span>
                        Your proposed changes are waiting for
                        @(string.IsNullOrWhiteSpace(approverNames)
                                        ? "the assigned approver"
                                        : approverNames).
            </span>
        </div>

                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        disabled="@isCancelling"
                        @onclick="CancelUpdateRequest">
            @if (isCancelling)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Cancelling...</span>
                    }
                    else
                    {
                        <i class="fas fa-times me-1"></i>
                        <span>Cancel Request</span>
                    }
                </button>
            </div>
        }

        <div class="profile-identity-card mb-3">

            <div class="profile-identity-main">

                @if (!string.IsNullOrWhiteSpace(worker.PassportPhotoPath))
                {
                    <img src="/uploads/@worker.PassportPhotoPath"
                         alt="Profile photograph"
                         class="profile-photo" />
                }
                else
                {
                    <div class="profile-photo-placeholder">
                        <i class="fas fa-user"></i>
                    </div>
                }

                <div class="profile-identity-content">
                    <h2>
                        @BuildFullName(worker)
                    </h2>

                    <div class="profile-meta">
                        <span>
                            <i class="fas fa-id-badge"></i>
                            @DisplayValue(worker.WorkerId)
                        </span>

                        <span>
                            <i class="fas fa-user-tag"></i>
                            @DisplayValue(worker.Role)
                        </span>

                        <span>
                            <i class="fas fa-building"></i>
                            @DisplayValue(worker.Directorate?.Name)
                        </span>

                        <span>
                            <i class="fas fa-sitemap"></i>
                            @DisplayValue(worker.Department?.Name)
                        </span>
                    </div>
                </div>

            </div>

            <div class="profile-completion-panel">
                @{
                    var completeness = CalculateCompleteness(worker);
                }

                <div class="profile-completion-top">
                    <span>Profile Completion</span>
                    <strong>@completeness%</strong>
                </div>

                <div class="progress profile-progress">
                    <div class="progress-bar @GetCompletenessClass(completeness)"
                         style="width: @completeness%">
                    </div>
                </div>

                <div class="profile-status-line">
                    <span>Status</span>

                    <strong class="@(worker.IsActive
                                                    ? "text-success"
                                                    : "text-secondary")">
                    @(worker.IsActive ? "Active" : "Inactive")
                </strong>
            </div>
        </div>

        </div>

        <div class="row g-3 align-items-start">

            <div class="col-12 col-xl-6">

                <div class="bcc-card profile-section-card">
                    <div class="profile-section-header">
                        <div class="profile-section-icon personal">
                            <i class="fas fa-user"></i>
                        </div>

                        <div>
                            <h6>Personal Information</h6>
                            <p>Identity, contact and personal details.</p>
                        </div>
                    </div>

                    <div class="bcc-card-body p-3">
                        <div class="profile-info-grid">
                            @InfoItem("Worker ID", worker.WorkerId)
                            @InfoItem("Title", worker.Title, proposedChanges?.Title)

                            @InfoItem(
                                                "Full Name",
                                                BuildFullName(worker),
                                                BuildPendingFullName())

                        @InfoItem("Sex", worker.Sex, proposedChanges?.Sex)
                        @InfoItem("Email", worker.Email, proposedChanges?.Email)
                        @InfoItem("Phone", worker.Phone, proposedChanges?.Phone)

                        @InfoItem(
                                                "Date of Birth",
                                                FormatDate(worker.DateOfBirth),
                                                FormatDate(proposedChanges?.DateOfBirth))

                        @InfoItem(
                                                "Marital Status",
                                                worker.MaritalStatus,
                                                proposedChanges?.MaritalStatus)

                        @InfoItem(
                                                "Wedding Anniversary",
                                                FormatDate(worker.WeddingAnniversary),
                                                FormatDate(proposedChanges?.WeddingAnniversary))

                        @InfoItem(
                                                "Profession",
                                                worker.Profession,
                                                proposedChanges?.Profession)

                        @InfoItem(
                                                "Organisation",
                                                worker.Organization,
                                                proposedChanges?.Organization)

                        @InfoItem(
                                                "Address",
                                                worker.Address,
                                                proposedChanges?.Address,
                                                true)
                    </div>
                </div>
            </div>

            <div class="bcc-card profile-section-card">
                <div class="profile-section-header">
                    <div class="profile-section-icon experience">
                        <i class="fas fa-history"></i>
                    </div>

                    <div>
                        <h6>Previous Church Experience</h6>
                        <p>Service experience before joining BCC.</p>
                    </div>
                </div>

                <div class="bcc-card-body p-3">
                    <div class="profile-info-grid">
                        @InfoItem(
                                                "Previous Church",
                                                worker.PreviousChurch,
                                                proposedChanges?.PreviousChurch)

                        @InfoItem(
                                                "Previous Role",
                                                worker.PreviousChurchRole,
                                                proposedChanges?.PreviousChurchRole)

                        @InfoItem(
                                                "Previous Unit",
                                                worker.PreviousChurchUnit,
                                                proposedChanges?.PreviousChurchUnit)

                        @InfoItem(
                                                "Experience Status",
                                                HasPreviousChurchExperience()
                                                ? "Previous experience recorded"
                                                : "No previous experience recorded",
                                                null,
                                                true)
                    </div>
                </div>
            </div>

        </div>

        <div class="col-12 col-xl-6">

            <div class="bcc-card profile-section-card">
                <div class="profile-section-header">
                    <div class="profile-section-icon church">
                        <i class="fas fa-church"></i>
                    </div>

                    <div>
                        <h6>Church & Service Information</h6>
                        <p>Current assignment, status and service history.</p>
                    </div>
                </div>

                <div class="bcc-card-body p-3">
                    <div class="profile-info-grid">
                        @InfoItem("Directorate", worker.Directorate?.Name)
                        @InfoItem("Department", worker.Department?.Name)
                        @InfoItem("Unit", worker.Unit?.Name)
                        @InfoItem("Role", worker.Role)
                        @InfoItem("Worker Status", worker.WorkerStatus)
                        @InfoItem("Supervisor", GetSupervisorName())

                        @InfoItem(
                                                "Date Joined BCC",
                                                FormatDate(worker.DateJoinedChurch))

                        @InfoItem(
                                                "Years in BCC",
                                                $"{CalculateYearsInBCC()} year(s)")

                        @InfoItem(
                                                "Ordination Status",
                                                worker.OrdinationStatus)

                        @InfoItem(
                                                "Ordination Level",
                                                worker.OrdinationLevel)

                        @InfoItem(
                                                "Last Ordination",
                                                FormatDate(worker.LastOrdinationDate))

                        @InfoItem(
                                                "Last Login",
                                                worker.LastLoginDate?.ToString(
                                                "dd MMM yyyy, hh:mm tt"),
                                                null,
                                                true)
                    </div>
                </div>
            </div>

            <div class="bcc-card profile-section-card">
                <div class="profile-section-header">
                    <div class="profile-section-icon qualification">
                        <i class="fas fa-award"></i>
                    </div>

                    <div>
                        <h6>Qualifications & Certificates</h6>
                        <p>Church training and uploaded certificates.</p>
                    </div>
                </div>

                <div class="bcc-card-body p-3">
                    <div class="qualification-grid">
                        @QualificationItem(
                                                "Believer's Baptism",
                                                worker.HasBelieverBaptism,
                                                worker.BelieverBaptismCertificatePath)

                        @QualificationItem(
                                                "Worker in Training",
                                                worker.HasWorkerInTraining,
                                                worker.WorkerInTrainingCertificatePath)

                        @QualificationItem(
                                                "School of Discipleship",
                                                worker.HasSOD,
                                                worker.SODCertificatePath)

                        @QualificationItem(
                                                "Bible College",
                                                worker.HasBibleCollege,
                                                worker.BibleCollegeCertificatePath)
                    </div>
                </div>
            </div>

            @if (hasPendingUpdate)
                {
                    <div class="bcc-card profile-section-card">
                        <div class="profile-section-header">
                            <div class="profile-section-icon pending">
                                <i class="fas fa-clock"></i>
                            </div>

                            <div>
                                <h6>Update Request</h6>
                                <p>Current profile-change approval status.</p>
                            </div>
                        </div>

                        <div class="bcc-card-body p-3">
                            <div class="profile-info-grid">
                                @InfoItem(
                                "Submitted",
                                                pendingRequest?.SubmittedDate
                                                .ToString("dd MMM yyyy, hh:mm tt"))

                        @InfoItem(
                                                "Waiting For",
                                                approverNames,
                                                null,
                                                true)
                    </div>
                </div>
            </div>
                        }

            </div>

        </div>
    </div>
}

@code {
    private Worker? worker;
    private ProposedChanges? proposedChanges;
    private ProfileUpdateRequest? pendingRequest;

    private bool isLoading = true;
    private bool hasPendingUpdate;
    private bool isCancelling;

    private string approverNames = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfileData();
    }

    private async Task LoadProfileData()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            approverNames = string.Empty;

            if (!AuthService.IsAuthenticated ||
                AuthService.CurrentWorker == null)
            {
                return;
            }

            var workerId =
                AuthService.CurrentWorker.Id;

            var result =
                await WorkforceService
                    .GetWorkerWithProposedChangesAsync(workerId);

            worker = result.worker;
            proposedChanges = result.proposedChanges;

            if (worker == null)
            {
                errorMessage =
                    "Your worker profile could not be found.";

                return;
            }

            pendingRequest =
                await WorkforceService
                    .GetPendingUpdateRequestAsync(workerId);

            hasPendingUpdate =
                pendingRequest != null;

            if (pendingRequest == null)
            {
                approverNames = string.Empty;
                return;
            }

            var eligibleApproverNames =
                pendingRequest.EligibleApprovers?
                    .Where(x =>
                        x != null &&
                        x.ApproverWorker != null)
                    .Select(x =>
                        string.Join(
                            " ",
                            new[]
                            {
                            x.ApproverWorker.FirstName,
                            x.ApproverWorker.LastName
                            }
                            .Where(name =>
                                !string.IsNullOrWhiteSpace(name))))
                    .Where(name =>
                        !string.IsNullOrWhiteSpace(name))
                    .Distinct(
                        StringComparer.OrdinalIgnoreCase)
                    .ToList()
                ?? new List<string>();

            if (eligibleApproverNames.Count > 0)
            {
                approverNames =
                    string.Join(
                        " or ",
                        eligibleApproverNames);
            }
            else if (pendingRequest.ApproverWorker != null)
            {
                approverNames =
                    string.Join(
                        " ",
                        new[]
                        {
                        pendingRequest.ApproverWorker.FirstName,
                        pendingRequest.ApproverWorker.LastName
                        }
                        .Where(name =>
                            !string.IsNullOrWhiteSpace(name)));
            }
            else
            {
                approverNames =
                    "the assigned approval authority";
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load your profile: {ex.Message}";

            Console.WriteLine(
                $"Workforce Profile error: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToUpdate()
    {
        if (hasPendingUpdate)
            return;

        Navigation.NavigateTo(
            "/workforce/update-profile");
    }

    private async Task CancelUpdateRequest()
    {
        if (pendingRequest == null ||
            isCancelling)
        {
            return;
        }

        try
        {
            isCancelling = true;
            errorMessage = string.Empty;

            var success =
                await WorkforceService
                    .CancelUpdateRequestAsync(
                        pendingRequest.Id);

            if (!success)
            {
                throw new Exception(
                    "The update request could not be cancelled.");
            }

            await LoadProfileData();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to cancel the update request: {ex.Message}";
        }
        finally
        {
            isCancelling = false;
        }
    }

    private RenderFragment InfoItem(
        string label,
        string? value,
        string? pendingValue = null,
        bool fullWidth = false) => builder =>
    {
        var sequence = 0;

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(
            sequence++,
            "class",
            fullWidth
                ? "profile-info-item full-width"
                : "profile-info-item");

        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(
            sequence++,
            "class",
            "profile-info-label");
        builder.AddContent(sequence++, label);
        builder.CloseElement();

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(
            sequence++,
            "class",
            "profile-info-value");

        if (!string.IsNullOrWhiteSpace(pendingValue) &&
            !string.Equals(
                value?.Trim(),
                pendingValue.Trim(),
                StringComparison.OrdinalIgnoreCase))
        {
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(
                sequence++,
                "class",
                "profile-current-value");
            builder.OpenElement(sequence++, "s");
            builder.AddContent(
                sequence++,
                DisplayValue(value));
            builder.CloseElement();
            builder.CloseElement();

            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(
                sequence++,
                "class",
                "profile-pending-value");

            builder.OpenElement(sequence++, "span");
            builder.AddContent(
                sequence++,
                pendingValue);
            builder.CloseElement();

            builder.OpenElement(sequence++, "small");
            builder.AddAttribute(
                sequence++,
                "class",
                "profile-pending-badge");
            builder.AddContent(sequence++, "Pending");
            builder.CloseElement();

            builder.CloseElement();
        }
        else
        {
            builder.AddContent(
                sequence++,
                DisplayValue(value));
        }

        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment QualificationItem(
        string title,
        bool hasQualification,
        string? certificatePath) => builder =>
    {
        var sequence = 0;

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(
            sequence++,
            "class",
            "qualification-item");

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(
            sequence++,
            "class",
            hasQualification
                ? "qualification-icon active"
                : "qualification-icon inactive");

        builder.OpenElement(sequence++, "i");
        builder.AddAttribute(
            sequence++,
            "class",
            hasQualification
                ? "fas fa-check"
                : "fas fa-times");
        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(
            sequence++,
            "class",
            "qualification-content");

        builder.OpenElement(sequence++, "strong");
        builder.AddContent(sequence++, title);
        builder.CloseElement();

        builder.OpenElement(sequence++, "span");
        builder.AddContent(
            sequence++,
            hasQualification
                ? "Completed"
                : "Not completed");
        builder.CloseElement();

        builder.CloseElement();

        if (!string.IsNullOrWhiteSpace(
            certificatePath))
        {
            builder.OpenElement(sequence++, "a");
            builder.AddAttribute(
                sequence++,
                "href",
                $"/uploads/{certificatePath}");
            builder.AddAttribute(
                sequence++,
                "target",
                "_blank");
            builder.AddAttribute(
                sequence++,
                "class",
                "certificate-link");
            builder.AddAttribute(
                sequence++,
                "title",
                "View certificate");

            builder.OpenElement(sequence++, "i");
            builder.AddAttribute(
                sequence++,
                "class",
                "fas fa-file-alt");
            builder.CloseElement();

            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(
                sequence++,
                "class",
                "certificate-missing");
            builder.AddAttribute(
                sequence++,
                "title",
                "No certificate uploaded");

            builder.OpenElement(sequence++, "i");
            builder.AddAttribute(
                sequence++,
                "class",
                "fas fa-minus");
            builder.CloseElement();

            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private static string BuildFullName(
        Worker worker)
    {
        return string.Join(
            " ",
            new[]
            {
                worker.Title,
                worker.FirstName,
                worker.MiddleName,
                worker.LastName
            }
            .Where(x =>
                !string.IsNullOrWhiteSpace(x)));
    }

    private string? BuildPendingFullName()
    {
        if (proposedChanges == null)
            return null;

        var hasNameChange =
            !string.IsNullOrWhiteSpace(
                proposedChanges.FirstName) ||
            !string.IsNullOrWhiteSpace(
                proposedChanges.MiddleName) ||
            !string.IsNullOrWhiteSpace(
                proposedChanges.LastName);

        if (!hasNameChange)
            return null;

        return string.Join(
            " ",
            new[]
            {
                proposedChanges.FirstName,
                proposedChanges.MiddleName,
                proposedChanges.LastName
            }
            .Where(x =>
                !string.IsNullOrWhiteSpace(x)));
    }

    private string GetSupervisorName()
    {
        if (worker?.Supervisor == null)
            return "Not assigned";

        return $"{worker.Supervisor.FirstName} " +
               $"{worker.Supervisor.LastName}".Trim();
    }

    private static string FormatDate(
        DateTime? value)
    {
        return value?.ToString(
            "dd MMMM yyyy") ?? string.Empty;
    }

    private static string DisplayValue(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Not provided"
            : value.Trim();
    }

    private int CalculateCompleteness(
        Worker worker)
    {
        var filledFields = 0;
        const int totalFields = 27;

        if (!string.IsNullOrWhiteSpace(worker.Sex)) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.Title)) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.FirstName)) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.MiddleName)) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.LastName)) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.Email)) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.Phone)) filledFields++;
        if (worker.DateOfBirth.HasValue) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.Address)) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.Profession)) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.Organization)) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.MaritalStatus)) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.PassportPhotoPath)) filledFields++;
        if (worker.DirectorateId.HasValue) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.Role)) filledFields++;
        if (worker.DateJoinedChurch.HasValue) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.OrdinationStatus)) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.OrdinationLevel)) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.WorkerStatus)) filledFields++;

        if (worker.LastOrdinationDate.HasValue &&
            !string.Equals(
                worker.OrdinationLevel,
                "Not Ordained",
                StringComparison.OrdinalIgnoreCase))
        {
            filledFields++;
        }

        if (worker.HasBelieverBaptism) filledFields++;
        if (worker.HasWorkerInTraining) filledFields++;
        if (worker.HasSOD) filledFields++;
        if (worker.HasBibleCollege) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.PreviousChurch)) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.PreviousChurchRole)) filledFields++;
        if (!string.IsNullOrWhiteSpace(worker.PreviousChurchUnit)) filledFields++;

        return (int)Math.Round(
            (double)filledFields /
            totalFields * 100);
    }

    private static string GetCompletenessClass(
        int percentage)
    {
        if (percentage < 50)
            return "bg-danger";

        if (percentage < 80)
            return "bg-warning";

        return "bg-success";
    }

    private int CalculateYearsInBCC()
    {
        if (worker?.DateJoinedChurch.HasValue != true)
            return 0;

        var joined =
            worker.DateJoinedChurch.Value;

        var years =
            DateTime.Today.Year -
            joined.Year;

        if (joined.Date >
            DateTime.Today.AddYears(-years))
        {
            years--;
        }

        return Math.Max(0, years);
    }

    private bool HasPreviousChurchExperience()
    {
        return
            !string.IsNullOrWhiteSpace(
                worker?.PreviousChurch) ||
            !string.IsNullOrWhiteSpace(
                worker?.PreviousChurchRole) ||
            !string.IsNullOrWhiteSpace(
                worker?.PreviousChurchUnit);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}

<style>
    .my-profile-page {
        max-width: 1450px;
        margin: 0 auto;
    }

    .my-profile-header {
        margin-bottom: 14px;
    }

    .compact-btn {
        min-height: 32px;
        padding: 6px 11px;
        font-size: 0.78rem;
    }

    .pending-update-banner {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 10px 12px;
        color: #92400e;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 10px;
    }

        .pending-update-banner > div:first-child {
            font-size: 1.2rem;
        }

        .pending-update-banner strong,
        .pending-update-banner span {
            display: block;
        }

        .pending-update-banner strong {
            font-size: 0.78rem;
            font-weight: 800;
        }

        .pending-update-banner span {
            margin-top: 1px;
            font-size: 0.68rem;
        }

    .profile-identity-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 14px 16px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, 0.04);
    }

    .profile-identity-main {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
    }

    .profile-photo,
    .profile-photo-placeholder {
        flex: 0 0 66px;
        width: 66px;
        height: 66px;
        border-radius: 16px;
    }

    .profile-photo {
        object-fit: cover;
