@page "/workforce/my-profile"
@layout Components.Layout.MainLayout
@using ChurchApp.Services
@using ChurchApp.Models
@inject WorkforceService WorkforceService
@inject AuthService AuthService
@inject NavigationManager Navigation

@if (AuthService.IsAuthenticated)
{
    <PageTitle>My Profile - BCC ServiceHub</PageTitle>

    @if (worker != null)
    {
        <div class="profile-v2-page">

            <div class="bcc-page-header">
                <div>
                    <div class="bcc-page-subtitle">
                        <i class="fas fa-user-circle me-2"></i>
                        Workforce Profile
                    </div>
                    <div class="bcc-page-title">My Profile</div>
                    <div class="bcc-page-subtitle">
                        View your personal, church, qualification and service information.
                    </div>
                </div>

                <button class="bcc-btn bcc-btn-primary" @onclick="NavigateToUpdate" disabled="@hasPendingUpdate">
                    <i class="fas fa-edit me-2"></i>
                    @(hasPendingUpdate ? "Update Pending" : "Update Profile")
                </button>
            </div>

            @if (hasPendingUpdate)
            {
                <div class="alert alert-warning profile-v2-alert">
                    <i class="fas fa-clock me-2"></i>
                    <strong>Update Pending Approval</strong>
                    <div>Your profile changes are waiting for approval from @approverName.</div>
                </div>
            }

            <div class="bcc-card profile-v2-hero">
                <div class="bcc-card-body">
                    <div class="row align-items-center g-4">
                        <div class="col-md-auto text-center">
                            @if (!string.IsNullOrEmpty(worker.PassportPhotoPath))
                            {
                                <img src="/uploads/@worker.PassportPhotoPath" alt="Profile Photo" class="profile-v2-photo" />
                            }
                            else
                            {
                                <div class="profile-v2-photo-placeholder">
                                    <i class="fas fa-user"></i>
                                </div>
                            }
                        </div>

                        <div class="col">
                            <h3 class="profile-v2-name">
                                @worker.Title @worker.FirstName @worker.MiddleName @worker.LastName
                            </h3>

                            <div class="profile-v2-meta">
                                <span><i class="fas fa-id-badge"></i> @worker.WorkerId</span>
                                <span><i class="fas fa-user-tag"></i> @worker.Role</span>

                                @if (worker.Directorate != null)
                                {
                                    <span><i class="fas fa-building"></i> @worker.Directorate.Name</span>
                                }

                                @if (worker.Department != null)
                                {
                                    <span><i class="fas fa-sitemap"></i> @worker.Department.Name</span>
                                }
                            </div>

                            @{
                                var completeness = CalculateCompleteness(worker);
                            }

                            <div class="profile-v2-progress mt-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span>Profile Completion</span>
                                    <strong>@completeness%</strong>
                                </div>

                                <div class="progress">
                                    <div class="progress-bar @GetCompletenessClass(completeness)" style="width:@completeness%"></div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-auto">
                            <div class="profile-v2-status-box">
                                <span>Status</span>
                                <strong class="@(worker.IsActive ? "text-success" : "text-secondary")">
                                    @(worker.IsActive ? "Active" : "Inactive")
                                </strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">

                    <div class="bcc-card">
                        <div class="bcc-card-header">
                            <i class="fas fa-user text-primary"></i>
                            <div class="bcc-card-title">Personal Information</div>
                        </div>

                        <div class="bcc-card-body">
                            <div class="profile-v2-grid">
                                @InfoRow("Worker ID", worker.WorkerId)
                                @InfoRow("Title", worker.Title, proposedChanges?.Title)
                                @InfoRow("Full Name", $"{worker.FirstName} {worker.MiddleName} {worker.LastName}", proposedChanges?.FirstName != null ? $"{proposedChanges.FirstName} {proposedChanges.MiddleName} {proposedChanges.LastName}" : null)
                                @InfoRow("Sex", worker.Sex, proposedChanges?.Sex)
                                @InfoRow("Email", worker.Email, proposedChanges?.Email)
                                @InfoRow("Phone", worker.Phone, proposedChanges?.Phone)
                                @InfoRow("Date of Birth", worker.DateOfBirth?.ToString("dd MMMM yyyy"), proposedChanges?.DateOfBirth?.ToString("dd MMMM yyyy"))
                                @InfoRow("Marital Status", worker.MaritalStatus, proposedChanges?.MaritalStatus)
                                @InfoRow("Wedding Anniversary", worker.WeddingAnniversary?.ToString("dd MMMM yyyy"), proposedChanges?.WeddingAnniversary?.ToString("dd MMMM yyyy"))
                                @InfoRow("Profession", worker.Profession, proposedChanges?.Profession)
                                @InfoRow("Organization", worker.Organization, proposedChanges?.Organization)
                                @InfoRow("Address", worker.Address, proposedChanges?.Address)
                            </div>
                        </div>
                    </div>

                    <div class="bcc-card">
                        <div class="bcc-card-header">
                            <i class="fas fa-church text-success"></i>
                            <div class="bcc-card-title">Church Information</div>
                        </div>

                        <div class="bcc-card-body">
                            <div class="profile-v2-grid">
                                @InfoRow("Directorate", worker.Directorate?.Name)
                                @InfoRow("Department", worker.Department?.Name)
                                @InfoRow("Unit", worker.Unit?.Name)
                                @InfoRow("Role", worker.Role)
                                @InfoRow("Worker Status", worker.WorkerStatus)
                                @InfoRow("Ordination Status", worker.OrdinationStatus)
                                @InfoRow("Ordination Level", worker.OrdinationLevel)
                                @InfoRow("Last Ordination", worker.LastOrdinationDate?.ToString("dd MMMM yyyy"))
                                @InfoRow("Date Joined BCC", worker.DateJoinedChurch?.ToString("dd MMMM yyyy"))
                            </div>
                        </div>
                    </div>

                    <div class="bcc-card">
                        <div class="bcc-card-header">
                            <i class="fas fa-award text-warning"></i>
                            <div class="bcc-card-title">Qualifications & Certificates</div>
                        </div>

                        <div class="bcc-card-body">
                            <div class="row g-3">
                                @QualificationCard("Believer's Baptism", worker.HasBelieverBaptism, worker.BelieverBaptismCertificatePath)
                                @QualificationCard("Worker in Training", worker.HasWorkerInTraining, worker.WorkerInTrainingCertificatePath)
                                @QualificationCard("School of Discipleship", worker.HasSOD, worker.SODCertificatePath)
                                @QualificationCard("Bible College", worker.HasBibleCollege, worker.BibleCollegeCertificatePath)
                            </div>
                        </div>
                    </div>

                    <div class="bcc-card">
                        <div class="bcc-card-header">
                            <i class="fas fa-history text-info"></i>
                            <div class="bcc-card-title">Previous Church Experience</div>
                        </div>

                        <div class="bcc-card-body">
                            <div class="profile-v2-grid">
                                @InfoRow("Previous Church", worker.PreviousChurch, proposedChanges?.PreviousChurch)
                                @InfoRow("Previous Role", worker.PreviousChurchRole, proposedChanges?.PreviousChurchRole)
                                @InfoRow("Previous Unit", worker.PreviousChurchUnit, proposedChanges?.PreviousChurchUnit)
                                @InfoRow("Experience", HasPreviousChurchExperience() ? "Has Previous Experience" : "No previous experience recorded")
                            </div>
                        </div>
                    </div>

                </div>

                <div class="col-lg-4">

                    <div class="bcc-card">
                        <div class="bcc-card-header">
                            <i class="fas fa-chart-pie text-primary"></i>
                            <div class="bcc-card-title">My Summary</div>
                        </div>

                        <div class="bcc-card-body">
                            @InfoRow("Supervisor", worker.Supervisor != null ? $"{worker.Supervisor.FirstName} {worker.Supervisor.LastName}" : "Not assigned")
                            @InfoRow("Years in BCC", $"{CalculateYearsInBCC()} years")
                            @InfoRow("Last Login", worker.LastLoginDate?.ToString("dd MMM yyyy") ?? "Never")
                            @InfoRow("Previous Experience", HasPreviousChurchExperience() ? "Yes" : "No")
                        </div>
                    </div>

                    @if (hasPendingUpdate)
                    {
                        <div class="bcc-card">
                            <div class="bcc-card-header">
                                <i class="fas fa-clock text-warning"></i>
                                <div class="bcc-card-title">Update Status</div>
                            </div>

                            <div class="bcc-card-body">
                                @InfoRow("Submitted", pendingRequest?.SubmittedDate.ToString("MMM dd, yyyy"))
                                @InfoRow("Waiting For", approverName)

                                <button class="btn btn-outline-danger btn-sm mt-3 w-100" @onclick="CancelUpdateRequest">
                                    <i class="fas fa-times me-1"></i>
                                    Cancel Request
                                </button>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    }
}
else
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access this page.</p>
        <a href="/login" class="bcc-btn bcc-btn-primary">Go to Login</a>
    </div>
}

@code {
    private Worker? worker = null;
    private ProposedChanges? proposedChanges = null;
    private ProfileUpdateRequest? pendingRequest = null;
    private bool hasPendingUpdate = false;
    private string approverName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated && AuthService.CurrentWorker != null)
        {
            await LoadProfileData();
        }
    }

    private async Task LoadProfileData()
    {
        try
        {
            var workerId = AuthService.CurrentWorker!.Id;
            var (workerData, changes) = await WorkforceService.GetWorkerWithProposedChangesAsync(workerId);

            worker = workerData;
            proposedChanges = changes;

            pendingRequest = await WorkforceService.GetPendingUpdateRequestAsync(workerId);
            hasPendingUpdate = pendingRequest != null;

            if (hasPendingUpdate && pendingRequest.ApproverWorker != null)
            {
                approverName = $"{pendingRequest.ApproverWorker.FirstName} {pendingRequest.ApproverWorker.LastName}";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading profile: {ex.Message}");
        }
    }

    private void NavigateToUpdate()
    {
        if (hasPendingUpdate) return;
        Navigation.NavigateTo("/workforce/update-profile");
    }

    private async Task CancelUpdateRequest()
    {
        if (pendingRequest != null)
        {
            try
            {
                var success = await WorkforceService.CancelUpdateRequestAsync(pendingRequest.Id);
                if (success)
                {
                    await LoadProfileData();
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error canceling request: {ex.Message}");
            }
        }
    }

    private RenderFragment InfoRow(string label, string? value, string? pendingValue = null) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "bcc-info-row");

        builder.OpenElement(2, "div");
        builder.AddAttribute(3, "class", "bcc-info-label");
        builder.AddContent(4, label);
        builder.CloseElement();

        builder.OpenElement(5, "div");
        builder.AddAttribute(6, "class", "bcc-info-value");

        if (!string.IsNullOrWhiteSpace(pendingValue))
        {
            builder.OpenElement(7, "div");
            builder.AddAttribute(8, "class", "profile-v2-old-value");
            builder.OpenElement(9, "s");
            builder.AddContent(10, string.IsNullOrWhiteSpace(value) ? "Not provided" : value);
            builder.CloseElement();
            builder.CloseElement();

            builder.OpenElement(11, "div");
            builder.AddAttribute(12, "class", "profile-v2-pending-value");
            builder.AddContent(13, pendingValue);
            builder.OpenElement(14, "span");
            builder.AddAttribute(15, "class", "profile-v2-pending-badge");
            builder.AddContent(16, "Pending");
            builder.CloseElement();
            builder.CloseElement();
        }
        else
        {
            builder.AddContent(17, string.IsNullOrWhiteSpace(value) ? "Not provided" : value);
        }

        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment QualificationCard(string title, bool hasQualification, string? certificatePath) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "col-md-6");

        builder.OpenElement(2, "div");
        builder.AddAttribute(3, "class", "profile-v2-qualification-card");

        builder.OpenElement(4, "div");
        builder.AddAttribute(5, "class", hasQualification ? "profile-v2-qual-icon active" : "profile-v2-qual-icon inactive");
        builder.OpenElement(6, "i");
        builder.AddAttribute(7, "class", hasQualification ? "fas fa-check" : "fas fa-times");
        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(8, "div");
        builder.OpenElement(9, "strong");
        builder.AddContent(10, title);
        builder.CloseElement();

        if (!string.IsNullOrEmpty(certificatePath))
        {
            builder.OpenElement(11, "a");
            builder.AddAttribute(12, "href", $"/uploads/{certificatePath}");
            builder.AddAttribute(13, "target", "_blank");
            builder.AddAttribute(14, "class", "profile-v2-cert-link");
            builder.AddContent(15, "View Certificate");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(16, "span");
            builder.AddAttribute(17, "class", "text-muted small");
            builder.AddContent(18, "No certificate");
            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    };

    private int CalculateCompleteness(Worker worker)
    {
        var filledFields = 0;
        var totalFields = 27;

        if (!string.IsNullOrEmpty(worker.Sex)) filledFields++;
        if (!string.IsNullOrEmpty(worker.Title)) filledFields++;
        if (!string.IsNullOrEmpty(worker.FirstName)) filledFields++;
        if (!string.IsNullOrEmpty(worker.MiddleName)) filledFields++;
        if (!string.IsNullOrEmpty(worker.LastName)) filledFields++;
        if (!string.IsNullOrEmpty(worker.Email)) filledFields++;
        if (!string.IsNullOrEmpty(worker.Phone)) filledFields++;
        if (worker.DateOfBirth.HasValue) filledFields++;
        if (!string.IsNullOrEmpty(worker.Address)) filledFields++;
        if (!string.IsNullOrEmpty(worker.Profession)) filledFields++;
        if (!string.IsNullOrEmpty(worker.Organization)) filledFields++;
        if (!string.IsNullOrEmpty(worker.MaritalStatus)) filledFields++;
        if (!string.IsNullOrEmpty(worker.PassportPhotoPath)) filledFields++;
        if (worker.DirectorateId.HasValue) filledFields++;
        if (!string.IsNullOrEmpty(worker.Role)) filledFields++;
        if (worker.DateJoinedChurch.HasValue) filledFields++;
        if (!string.IsNullOrEmpty(worker.OrdinationStatus)) filledFields++;
        if (!string.IsNullOrEmpty(worker.OrdinationLevel)) filledFields++;
        if (!string.IsNullOrEmpty(worker.WorkerStatus)) filledFields++;
        if (worker.LastOrdinationDate.HasValue && worker.OrdinationLevel != "Not Ordained") filledFields++;
        if (worker.HasBelieverBaptism) filledFields++;
        if (worker.HasWorkerInTraining) filledFields++;
        if (worker.HasSOD) filledFields++;
        if (worker.HasBibleCollege) filledFields++;
        if (!string.IsNullOrEmpty(worker.PreviousChurch)) filledFields++;
        if (!string.IsNullOrEmpty(worker.PreviousChurchRole)) filledFields++;
        if (!string.IsNullOrEmpty(worker.PreviousChurchUnit)) filledFields++;

        return totalFields > 0 ? (int)Math.Round((double)filledFields / totalFields * 100) : 0;
    }

    private string GetCompletenessClass(int percentage)
    {
        if (percentage < 50) return "bg-danger";
        if (percentage < 80) return "bg-warning";
        return "bg-success";
    }

    private int CalculateYearsInBCC()
    {
        if (worker?.DateJoinedChurch.HasValue != true)
            return 0;

        var years = DateTime.Now.Year - worker.DateJoinedChurch.Value.Year;
        if (worker.DateJoinedChurch.Value.Date > DateTime.Now.AddYears(-years))
            years--;

        return Math.Max(0, years);
    }

    private bool HasPreviousChurchExperience()
    {
        return !string.IsNullOrEmpty(worker?.PreviousChurch) ||
               !string.IsNullOrEmpty(worker?.PreviousChurchRole) ||
               !string.IsNullOrEmpty(worker?.PreviousChurchUnit);
    }
}
