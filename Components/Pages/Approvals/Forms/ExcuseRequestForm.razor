@using ChurchApp.Models

<div class="profile-review-card excuse-request-card">

    <div class="request-specific-heading">
        <div class="request-specific-icon excuse-icon">
            <i class="fas fa-calendar-times"></i>
        </div>

        <div>
            <h6>Excuse Request Information</h6>
            <p>
                Select the service, excuse date and worker who will
                cover your responsibility.
            </p>
        </div>
    </div>

    <div class="excuse-deadline-warning">
        <i class="fas fa-triangle-exclamation"></i>

        <div>
            <strong>Important notice</strong>
            <span>
                An off-service request must be submitted at least
                five hours before the selected service starts.
                Requests submitted within five hours of the service
                start time will not be accepted.
            </span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ServiceTimingMessage))
    {
        <div class="@ServiceTimingCssClass">
            <i class="fas @ServiceTimingIcon"></i>
            <span>@ServiceTimingMessage</span>
        </div>
    }

    @if (IsLoading)
    {
        <div class="text-center py-3">
            <span class="spinner-border spinner-border-sm text-primary"></span>
            <div class="small text-muted mt-2">
                Loading form information...
            </div>
        </div>
    }
    else
    {
        <div class="row g-3 align-items-start">

            <div class="col-12 col-lg-6">
                <div class="excuse-form-panel">

                    <div class="excuse-panel-heading">
                        <i class="fas fa-calendar-check"></i>

                        <div>
                            <h6>Service Information</h6>
                            <p>Select the service and date.</p>
                        </div>
                    </div>

                    <div class="excuse-panel-body">

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Service
                                <span class="text-danger">*</span>
                            </label>

                            <InputSelect class="form-select"
                                         @bind-Value="Model.ServiceId"
                                         @bind-Value:after="OnServiceOrDateChangedAsync">
                                <option value="">-- Select Service --</option>

                                @foreach (var service in Services)
                                {
                                    <option value="@service.Id">
                                        @service.Name — @GetServiceSchedule(service)
                                    </option>
                                }
                            </InputSelect>

                            <ValidationMessage For="@(() => Model.ServiceId)"
                                               class="text-danger small" />
                        </div>

                        <div>
                            <label class="form-label fw-bold">
                                Excuse Date
                                <span class="text-danger">*</span>
                            </label>

                            <InputDate class="form-control"
                                       @bind-Value="Model.RequestedDate"
                                       @bind-Value:after="OnServiceOrDateChangedAsync" />

                            <ValidationMessage For="@(() => Model.RequestedDate)"
                                               class="text-danger small" />

                            <div class="form-text">
                                The selected date is used to determine the
                                service start time and submission deadline.
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="excuse-form-panel">

                    <div class="excuse-panel-heading backup-heading">
                        <i class="fas fa-user-shield"></i>

                        <div>
                            <h6>Cover Arrangement</h6>
                            <p>Nominate a backup and state your reason.</p>
                        </div>
                    </div>

                    <div class="excuse-panel-body">

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Backup Worker (Relieve Officer)
                                <span class="text-danger">*</span>
                            </label>

                            <InputSelect class="form-select"
                                         @bind-Value="Model.NominatedBackupId">
                                <option value="0">
                                    -- Select Backup Worker --
                                </option>

                                @foreach (var worker in AvailableBackups)
                                {
                                    <option value="@worker.Id">
                                        @GetWorkerDisplayName(worker)
                                    </option>
                                }
                            </InputSelect>

                            <ValidationMessage For="@(() => Model.NominatedBackupId)"
                                               class="text-danger small" />

                            <div class="form-text">
                                Select the worker who will cover your
                                responsibility for the service.
                            </div>
                        </div>

                        <div>
                            <div class="d-flex justify-content-between
                                            align-items-center gap-2">
                                <label class="form-label fw-bold">
                                    Reason for Excuse
                                    <span class="text-danger">*</span>
                                </label>

                                <span class="reason-counter">
                                    @ReasonLength/500
                                </span>
                            </div>

                            <InputTextArea class="form-control"
                                           rows="4"
                                           maxlength="500"
                                           @bind-Value="Model.Reason"
                                           placeholder="Briefly explain why you need to be excused." />

                            <ValidationMessage For="@(() => Model.Reason)"
                                               class="text-danger small" />
                        </div>

                    </div>
                </div>
            </div>

        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ExcuseRequestModel Model { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<Service> Services { get; set; } =
        Array.Empty<Service>();

    [Parameter]
    public IReadOnlyList<Worker> AvailableBackups { get; set; } =
        Array.Empty<Worker>();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback RefreshBackups { get; set; }

    private int ReasonLength =>
        Model?.Reason?.Length ?? 0;

    private DateTime? SelectedServiceStart =>
        TryGetSelectedServiceStart();

    private bool IsWithinRestrictedPeriod
    {
        get
        {
            var serviceStart = SelectedServiceStart;

            return serviceStart.HasValue &&
                   serviceStart.Value > DateTime.Now &&
                   serviceStart.Value - DateTime.Now <
                       TimeSpan.FromHours(5);
        }
    }

    private bool HasServiceStarted =>
        SelectedServiceStart.HasValue &&
        SelectedServiceStart.Value <= DateTime.Now;

    private string ServiceTimingMessage
    {
        get
        {
            var serviceStart = SelectedServiceStart;

            if (!serviceStart.HasValue)
                return string.Empty;

            if (HasServiceStarted)
            {
                return
                    $"The selected service started on " +
                    $"{serviceStart.Value:dd MMM yyyy 'at' h:mm tt}. " +
                    "You cannot submit an excuse request for a service " +
                    "that has already started.";
            }

            var remaining =
                serviceStart.Value - DateTime.Now;

            if (remaining < TimeSpan.FromHours(5))
            {
                return
                    $"This service starts on " +
                    $"{serviceStart.Value:dd MMM yyyy 'at' h:mm tt}. " +
                    $"Only {FormatRemainingTime(remaining)} remains. " +
                    "The request cannot be submitted because the " +
                    "five-hour notice requirement has not been met.";
            }

            var deadline =
                serviceStart.Value.AddHours(-5);

            return
                $"Service starts on " +
                $"{serviceStart.Value:dd MMM yyyy 'at' h:mm tt}. " +
                $"The submission deadline is " +
                $"{deadline:dd MMM yyyy 'at' h:mm tt}.";
        }
    }

    private string ServiceTimingCssClass =>
        HasServiceStarted || IsWithinRestrictedPeriod
            ? "service-timing-alert danger"
            : "service-timing-alert safe";

    private string ServiceTimingIcon =>
        HasServiceStarted || IsWithinRestrictedPeriod
            ? "fa-circle-exclamation"
            : "fa-circle-check";

    public void Validate()
    {
        if (!Model.ServiceId.HasValue ||
            Model.ServiceId.Value <= 0)
        {
            throw new InvalidOperationException(
                "Please select a service.");
        }

        if (Model.RequestedDate == default)
        {
            throw new InvalidOperationException(
                "Please select the excuse date.");
        }

        if (Model.RequestedDate.Date < DateTime.Today)
        {
            throw new InvalidOperationException(
                "The excuse date cannot be in the past.");
        }

        var serviceStart =
            TryGetSelectedServiceStart();

        if (!serviceStart.HasValue)
        {
            throw new InvalidOperationException(
                "The selected service does not have a valid start date " +
                "and time.");
        }

        if (serviceStart.Value <= DateTime.Now)
        {
            throw new InvalidOperationException(
                "You cannot request to be excused from a service that " +
                "has already started.");
        }

        if (serviceStart.Value - DateTime.Now <
            TimeSpan.FromHours(5))
        {
            throw new InvalidOperationException(
                "An off-service request must be submitted at least " +
                "five hours before the selected service starts.");
        }

        if (Model.NominatedBackupId <= 0)
        {
            throw new InvalidOperationException(
                "Please select the backup worker.");
        }

        if (string.IsNullOrWhiteSpace(Model.Reason))
        {
            throw new InvalidOperationException(
                "Please provide the reason for the excuse.");
        }

        if (Model.Reason.Trim().Length > 500)
        {
            throw new InvalidOperationException(
                "Reason cannot exceed 500 characters.");
        }
    }

    public string BuildCommonDetails()
    {
        Validate();

        var selectedService =
            Services.FirstOrDefault(x =>
                x.Id == Model.ServiceId);

        var backup =
            AvailableBackups.FirstOrDefault(x =>
                x.Id == Model.NominatedBackupId);

        var serviceName =
            selectedService?.Name ?? "Selected Service";

        var date =
            Model.RequestedDate.ToString("dd MMM yyyy");

        var start =
            TryGetSelectedServiceStart();

        var backupName =
            backup == null
                ? "Selected Backup Worker"
                : $"{backup.FirstName} {backup.LastName}".Trim();

        return
            $"Service: {serviceName}\n" +
            $"Excuse Date: {date}\n" +
            $"Service Start: " +
            $"{start:dd MMM yyyy 'at' h:mm tt}\n" +
            $"Backup Worker: {backupName}\n" +
            $"Reason: {Model.Reason.Trim()}";
    }

    private async Task OnServiceOrDateChangedAsync()
    {
        // Do not recreate Model here. Recreating it wipes the
        // user's selected service, date, reason and backup worker.
        Model.NominatedBackupId = 0;

        if (RefreshBackups.HasDelegate)
        {
            await RefreshBackups.InvokeAsync();
        }

        StateHasChanged();
    }

    private DateTime? TryGetSelectedServiceStart()
    {
        if (!Model.ServiceId.HasValue ||
            Model.ServiceId.Value <= 0 ||
            Model.RequestedDate == default)
        {
            return null;
        }

        var service =
            Services.FirstOrDefault(x =>
                x.Id == Model.ServiceId.Value);

        if (service == null)
            return null;

        if (string.Equals(
                service.RecurrencePattern,
                "OneTime",
                StringComparison.OrdinalIgnoreCase))
        {
            if (!service.SpecificDate.HasValue ||
                !service.SpecificStartTime.HasValue)
            {
                return null;
            }

            return
                service.SpecificDate.Value.Date +
                service.SpecificStartTime.Value;
        }

        if (!service.StartTime.HasValue)
            return null;

        return
            Model.RequestedDate.Date +
            service.StartTime.Value;
    }

    private static string FormatRemainingTime(
        TimeSpan remaining)
    {
        if (remaining <= TimeSpan.Zero)
            return "no time";

        if (remaining.TotalHours >= 1)
        {
            var hours = (int)remaining.TotalHours;
            var minutes = remaining.Minutes;

            return minutes > 0
                ? $"{hours} hour(s) and {minutes} minute(s)"
                : $"{hours} hour(s)";
        }

        return $"{Math.Max(1, remaining.Minutes)} minute(s)";
    }

    private static string GetWorkerDisplayName(
        Worker worker)
    {
        var name =
            $"{worker.FirstName} {worker.LastName}".Trim();

        return string.IsNullOrWhiteSpace(worker.WorkerId)
            ? name
            : $"{name} ({worker.WorkerId})";
    }

    private static string GetServiceSchedule(
        Service service)
    {
        if (string.Equals(
                service.RecurrencePattern,
                "OneTime",
                StringComparison.OrdinalIgnoreCase))
        {
            var date =
                service.SpecificDate?.ToString("dd MMM yyyy")
                ?? "Date not set";

            var time =
                service.SpecificStartTime?.ToString(@"hh\:mm")
                ?? "Time not set";

            return $"{date}, {time}";
        }

        var day =
            service.DayOfWeek?.ToString()
            ?? "Day not set";

        var start =
            service.StartTime?.ToString(@"hh\:mm")
            ?? "Time not set";

        return $"{day}, {start}";
    }
    public string BuildApprovalSought()
    {
        var service =
            Services.FirstOrDefault(x => x.Id == Model.ServiceId);

        var serviceName =
            service?.Name ?? "the selected service";

        var serviceStart =
            TryGetSelectedServiceStart();

        if (serviceStart.HasValue)
        {
            return
                $"Kindly approve my request to be excused from {serviceName} scheduled for {serviceStart.Value:dddd, dd MMMM yyyy} at {serviceStart.Value:hh:mm tt}.";
        }

        return
            $"Kindly approve my request to be excused from {serviceName}.";
    }
}

<style>
    .excuse-request-card {
        padding: 14px;
        border: 1px solid #e5e7eb;
        border-left: 4px solid #7c3aed;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.035);
    }

    .request-specific-heading {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin-bottom: 10px;
    }

    .request-specific-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 36px;
        width: 36px;
        height: 36px;
        border-radius: 9px;
    }

    .excuse-icon {
        color: #6d28d9;
        background: #ede9fe;
    }

    .request-specific-heading h6 {
        margin: 0 0 2px;
        color: #0f172a;
        font-size: 0.82rem;
        font-weight: 800;
    }

    .request-specific-heading p {
        margin: 0;
        color: #64748b;
        font-size: 0.66rem;
        line-height: 1.4;
    }

    .excuse-deadline-warning {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin-bottom: 10px;
        padding: 9px 10px;
        color: #991b1b;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-left: 4px solid #dc2626;
        border-radius: 8px;
    }

        .excuse-deadline-warning > i {
            margin-top: 2px;
            font-size: 0.76rem;
        }

        .excuse-deadline-warning strong,
        .excuse-deadline-warning span {
            display: block;
        }

        .excuse-deadline-warning strong {
            margin-bottom: 1px;
            font-size: 0.69rem;
            font-weight: 800;
        }

        .excuse-deadline-warning span {
            font-size: 0.62rem;
            line-height: 1.4;
        }

    .service-timing-alert {
        display: flex;
        align-items: flex-start;
        gap: 7px;
        margin-bottom: 10px;
        padding: 8px 9px;
        border-radius: 8px;
        font-size: 0.62rem;
        line-height: 1.4;
    }

        .service-timing-alert.danger {
            color: #991b1b;
            background: #fff1f2;
            border: 1px solid #fecdd3;
        }

        .service-timing-alert.safe {
            color: #166534;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
        }

        .service-timing-alert i {
            margin-top: 2px;
        }

    .excuse-form-panel {
        height: 100%;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
    }

    .excuse-panel-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 10px;
        color: #4338ca;
        background: #eef2ff;
        border-bottom: 1px solid #c7d2fe;
    }

        .excuse-panel-heading.backup-heading {
            color: #6d28d9;
            background: #f5f3ff;
            border-bottom-color: #ddd6fe;
        }

        .excuse-panel-heading > i {
            font-size: 0.7rem;
        }

        .excuse-panel-heading h6 {
            margin: 0 0 1px;
            color: #0f172a;
            font-size: 0.7rem;
            font-weight: 800;
        }

        .excuse-panel-heading p {
            margin: 0;
            color: #64748b;
            font-size: 0.57rem;
        }

    .excuse-panel-body {
        padding: 11px;
    }

    .excuse-request-card .form-control,
    .excuse-request-card .form-select {
        min-height: 33px;
        font-size: 0.73rem;
    }

    .excuse-request-card textarea.form-control {
        min-height: 88px;
        resize: vertical;
    }

    .excuse-request-card .form-label {
        margin-bottom: 3px;
        color: #334155;
        font-size: 0.66rem;
    }

    .excuse-request-card .form-text {
        margin-top: 3px;
        font-size: 0.56rem;
        line-height: 1.35;
    }

    .excuse-request-card .validation-message,
    .excuse-request-card .text-danger.small {
        font-size: 0.57rem;
    }

    .reason-counter {
        color: #64748b;
        font-size: 0.56rem;
        font-weight: 700;
    }

    @@media (max-width: 991.98px) {
        .excuse-form-panel {
            height: auto;
        }
    }
</style>
