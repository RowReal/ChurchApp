@page "/approvals/new"
@layout Components.Layout.MainLayout

@using Microsoft.AspNetCore.Components.Forms
@using ChurchApp.Models
@using ChurchApp.Services
@using ChurchApp.Components.Pages.Approvals.Forms

@inject ApprovalRequestService ApprovalRequestService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HtmlCleanService HtmlCleanService
@inject LeaveRequestService LeaveRequestService
@inject ExcuseService ExcuseService
@inject LatePermissionService LatePermissionService

<PageTitle>New Approval Request - BCC ServiceHub</PageTitle>

@if (AuthService.IsAuthenticated)
{
    <div class="worker360-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        <div class="bcc-page-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-clipboard-check me-2"></i>
                    Approval Hub
                </div>

                <div class="bcc-page-title">
                    New Approval Request
                </div>

                <div class="bcc-page-subtitle">
                    Submit leave, off-service, late permission, activity, financial, or general approval requests.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn"
                        @onclick="GoBack">
                    <i class="fas fa-arrow-left me-2"></i>
                    Back
                </button>
            </div>
        </div>

        <div class="bcc-card">
            <div class="bcc-card-body">
                <div class="worker360-section">
                    <h5>
                        <i class="fas fa-file-signature"></i>
                        Request Information
                    </h5>

                    <EditForm Model="@requestModel">

                        <DataAnnotationsValidator />

                        <div class="row g-3">

                            <!-- Request type -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Request Type
                                    <span class="text-danger">*</span>
                                </label>

                                <select class="form-select"
                                        value="@requestModel.RequestTypeId"
                                        @onchange="OnRequestTypeChanged">
                                    <option value="0">
                                        -- Select Request Type --
                                    </option>

                                    @foreach (var type in requestTypes)
                                    {
                                        <option value="@type.Id">
                                            @type.Name
                                        </option>
                                    }
                                </select>
                            </div>

                            <!-- Subject -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Subject
                                    <span class="text-danger">*</span>
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="requestModel.Subject"
                                           placeholder="Brief title of the request" />
                            </div>
                            @if (selectedRequestType != null)
{
    <div class="col-12">
        <div class="@GetRequestTypeHeroCssClass()">

            <div class="request-type-hero-icon">
                <i class="@GetRequestTypeHeroIcon()"></i>
            </div>

            <div class="request-type-hero-content">
                <div class="request-type-hero-label">
                    @selectedRequestType.Name
                </div>

                <div class="request-type-hero-title">
                    @GetRequestTypeHeroTitle()
                </div>

                <div class="request-type-hero-description">
                    @GetRequestTypeHeroDescription()
                </div>
            </div>

        </div>
    </div>
}

                            <!-- Rich-text details -->
                            @if (!IsLeaveRequest && !IsExcuseRequest && !IsLatePermissionRequest)
{
    <div class="col-12 col-lg-6">
        <label class="form-label fw-bold">
            Details / Background
            <span class="text-danger">*</span>
        </label>

        <div class="rich-editor-wrapper">
            <div id="detailsEditor"
                 class="bcc-rich-editor"></div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <label class="form-label fw-bold">
            Approval Sought
            <span class="text-danger">*</span>
        </label>

        <div class="rich-editor-wrapper">
            <div id="approvalSoughtEditor"
                 class="bcc-rich-editor"></div>
        </div>
    </div>
}

                            <!-- Financial request fields -->
                            @if (IsFinancialRequest)
                            {
                                <div class="col-12">
                                    <div class="profile-review-card financial-request-card">
                                        <h6 class="mb-3">
                                            <i class="fas fa-coins me-2"></i>
                                            Financial Request Information
                                        </h6>

                                        <div class="row g-3">

                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">
                                                    Amount Requested
                                                    <span class="text-danger">*</span>
                                                </label>

                                                <div class="input-group">
                                                    <span class="input-group-text">₦</span>

                                                    <InputNumber class="form-control"
                                                                 @bind-Value="requestModel.AmountRequested"
                                                                 placeholder="0.00" />
                                                </div>
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">
                                                    Budget Line
                                                    <span class="text-muted fw-normal">
                                                        (Optional)
                                                    </span>
                                                </label>

                                                <InputText class="form-control"
                                                           @bind-Value="requestModel.BudgetLine"
                                                           placeholder="Example: Directorate programme budget" />
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label fw-bold">
                                                    Financial Purpose
                                                    <span class="text-danger">*</span>
                                                </label>

                                                <InputTextArea class="form-control"
                                                               rows="3"
                                                               @bind-Value="requestModel.FinancialPurpose"
                                                               placeholder="Briefly state what the requested funds will be used for." />
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label fw-bold">
                                                    Payment Details
                                                    <span class="text-muted fw-normal">
                                                        (Optional)
                                                    </span>
                                                </label>

                                                <InputTextArea class="form-control"
                                                               rows="3"
                                                               @bind-Value="requestModel.PaymentDetails"
                                                               placeholder="Provide relevant payment or disbursement instructions, where applicable." />
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            }
                            @if (IsLeaveRequest)
                            {
                             <div class="col-12">
                           <LeaveRequestForm
                              Model="@leaveRequestModel"
                                 AvailableOfficers="@availableRelieveOfficers" />
                                </div>
                             }

                            @if (IsExcuseRequest)
                            {
                                <div class="col-12">
                                    <ExcuseRequestForm
                                        @ref="excuseRequestForm"
                                        Model="@excuseRequestModel"
                                        Services="@availableExcuseServices"
                                        AvailableBackups="@availableExcuseBackups"
                                        IsLoading="@isExcuseDataLoading"
                                        RefreshBackups="@LoadExcuseBackupsAsync" />
                                </div>
                            }

                            @if (IsLatePermissionRequest)
                            {
                                <div class="col-12">
                                    <div class="profile-review-card late-permission-card">
                                        <h6 class="mb-2"><i class="fas fa-clock me-2"></i>Late Permission Request Information</h6>
                                        <p class="text-muted small mb-3">Use this form when you expect to arrive after the scheduled start of an upcoming church service. The request must be submitted before the service starts.</p>
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Service <span class="text-danger">*</span></label>
                                                <select class="form-select" value="@latePermissionModel.ServiceId" @onchange="OnLatePermissionServiceChanged">
                                                    <option value="0">-- Select Service --</option>
                                                    @foreach (var service in availableLatePermissionServices)
                                                    {
                                                        <option value="@service.Id">@service.Name</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Next Service Date</label>
                                                <input type="text" class="form-control" value="@GetLatePermissionServiceDateDisplay()" readonly />
                                                <div class="form-text">Automatically selected as the next immediate occurrence of this service.</div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Scheduled Start Time</label>
                                                <input type="text" class="form-control" value="@GetLatePermissionScheduledStartDisplay()" readonly />
                                                <div class="form-text">Taken automatically from the selected service schedule.</div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Expected Arrival Time <span class="text-danger">*</span></label>
                                                <select class="form-select" @bind="latePermissionExpectedArrivalTime">
                                                    <option value="">-- Select Expected Arrival Time --</option>
                                                    @foreach (var option in latePermissionArrivalTimeOptions)
                                                    {
                                                        <option value="@option.Value">@option.Display</option>
                                                    }
                                                </select>
                                                <div class="form-text">Times begin from the scheduled commencement of the selected service.</div>
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label fw-bold">Reason for Late Arrival <span class="text-danger">*</span></label>
                                                <InputTextArea class="form-control" rows="4" maxlength="2000" @bind-Value="latePermissionModel.Reason" placeholder="Briefly explain why you expect to arrive late." />
                                            </div>
                                            <div class="col-12">
                                                <div class="alert alert-info mb-0"><i class="fas fa-circle-info me-2"></i><strong>Important:</strong> Late Permission does not excuse absence from the service. It records approval for an expected late arrival.</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Attachments -->
                            <div class="col-12">
                                <label class="form-label fw-bold">
                                    Supporting Documents
                                    <span class="text-muted fw-normal">
                                        (Optional)
                                    </span>
                                </label>

                                <div class="approval-upload-box">
                                    <InputFile OnChange="HandleFilesSelected"
                                               multiple
                                               accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />

                                    <div class="mt-2 text-muted small">
                                        Allowed files: PDF, Word, Excel and images.
                                        Maximum 10 MB per file and 10 files per request.
                                    </div>
                                </div>

                                @if (selectedFiles.Any())
                                {
                                    <div class="approval-selected-files mt-3">
                                        @foreach (var file in selectedFiles)
                                        {
                                            <div class="approval-selected-file">
                                                <div class="approval-selected-file-info">
                                                    <i class="@GetFileIcon(file.Name)"></i>

                                                    <span>
                                                        <strong>@file.Name</strong>
                                                        <small>@FormatFileSize(file.Size)</small>
                                                    </span>
                                                </div>

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Remove file"
                                                        @onclick="() => RemoveSelectedFile(file)">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                        </div>

                        <div class="mt-4 d-flex justify-content-end gap-2">
                            <button type="button"
                                    class="bcc-btn profile-form-secondary-btn"
                                    disabled="@isSubmitting"
                                    @onclick="ClearForm">
                                <i class="fas fa-times me-2"></i>
                                Clear
                            </button>

                            <button type="button"
                                    class="bcc-btn bcc-btn-primary"
                                    disabled="@isSubmitting"
                                    @onclick="SubmitRequest">

                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Submitting...</span>
                                }
                                else
                                {
                                    <i class="fas fa-paper-plane me-2"></i>
                                    <span>Submit Request</span>
                                }
                            </button>
                        </div>

                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to submit an approval request.</p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}

@if (showSuccessPopup)
{
    <div class="approval-popup-backdrop">
        <div class="approval-popup-card">
            <div class="approval-popup-icon">
                <i class="fas fa-check-circle"></i>
            </div>

            <h4>Request Submitted</h4>
            <p>@popupMessage</p>

            <button type="button"
                    class="bcc-btn bcc-btn-primary"
                    @onclick="CloseSuccessPopup">
                OK
            </button>
        </div>
    </div>
}
@if (showValidationPopup)
{
    <div class="approval-popup-backdrop">
        <div class="approval-popup-card validation-popup-card">

            <div class="approval-popup-icon validation-popup-icon">
                <i class="fas fa-exclamation-triangle"></i>
            </div>

            <h4>Request Cannot Be Submitted</h4>

            <p>@validationPopupMessage</p>

            <button type="button"
                    class="bcc-btn bcc-btn-primary"
                    @onclick="CloseValidationPopup">
                OK
            </button>

        </div>
    </div>
}
@if (showRequestTypeWarningPopup)
{
    <div class="approval-popup-backdrop">
        <div class="approval-popup-card request-type-warning-card">

            <div class="approval-popup-icon request-type-warning-icon">
                <i class="fas fa-triangle-exclamation"></i>
            </div>

            <h4>Possible Incorrect Request Type</h4>

            <p>
                Your request appears to relate to being absent from church
                or requesting permission not to attend a service.
            </p>

            <div class="request-type-warning-guidance">
                <div>
                    <strong>Leave Request</strong><br />
                    Use this if you will be unavailable for a period of time.
                </div>

                <div>
                    <strong>Off Service Request</strong><br />
                    Use this if you only need permission to be absent from
                    one particular service.
                </div>
            </div>

            <p class="request-type-warning-note">
                Using the correct request type is important because approved
                Leave and Off Service requests may be considered when your
                attendance record is reviewed.
            </p>

            <div class="d-flex justify-content-center gap-2 flex-wrap">

                <button type="button"
                        class="bcc-btn profile-form-secondary-btn"
                        @onclick="ChangeRequestTypeFromWarning">
                    <i class="fas fa-rotate-left me-2"></i>
                    Change Request Type
                </button>

                <button type="button"
                        class="bcc-btn bcc-btn-primary"
                        @onclick="ContinueCurrentRequest">
                    Continue with Current Request
                </button>

            </div>
        </div>
    </div>
}
@code {
    private List<ApprovalRequestType> requestTypes = new();
    private List<IBrowserFile> selectedFiles = new();
    private bool showRequestTypeWarningPopup;
private bool requestTypeWarningAcknowledged;

    private ApprovalRequestFormModel requestModel = new();
    private ApprovalRequestType? selectedRequestType;

    private string? errorMessage;
private string popupMessage = string.Empty;

private string validationPopupMessage = string.Empty;

private bool showSuccessPopup;
private bool showValidationPopup;
private bool isSubmitting;
    private bool richTextEditorsInitialized;

    private const long MaximumFileSize = 10 * 1024 * 1024;
    private const int MaximumFileCount = 10;
    private LeaveRequestFormModel leaveRequestModel = new();
    private ExcuseRequestModel excuseRequestModel = new();
    private ExcuseRequestForm? excuseRequestForm;
    private LatePermissionFormModel latePermissionModel = new();
    private string latePermissionExpectedArrivalTime = string.Empty;
    private DateTime? latePermissionScheduledStart;
    private List<LatePermissionTimeOption> latePermissionArrivalTimeOptions = new();

    private List<Worker> availableRelieveOfficers = new();
    private List<Service> availableExcuseServices = new();
    private List<Worker> availableExcuseBackups = new();
    private List<Service> availableLatePermissionServices = new();
    private bool isExcuseDataLoading;

    private bool IsLeaveRequest =>
        string.Equals(
            selectedRequestType?.Code,
            "Leave-Request",
            StringComparison.OrdinalIgnoreCase);

    private bool IsExcuseRequest =>
        string.Equals(
            selectedRequestType?.Code,
            "Off-Service-Request",
            StringComparison.OrdinalIgnoreCase) ||
        string.Equals(
            selectedRequestType?.Code,
            "Excuse-Request",
            StringComparison.OrdinalIgnoreCase);

    private bool IsLatePermissionRequest =>
        string.Equals(selectedRequestType?.Code, "Late-Permission-Request", StringComparison.OrdinalIgnoreCase);

    private bool IsFinancialRequest =>
        string.Equals(
            selectedRequestType?.Code,
            "Financial-Request",
            StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            requestTypes =
                await ApprovalRequestService
                    .GetActiveRequestTypesAsync();

            if (AuthService.CurrentWorker != null)
            {
                availableRelieveOfficers =
                    await LeaveRequestService
                        .GetAvailableRelieveOfficersAsync(
                            AuthService.CurrentWorker.Id);

                availableExcuseServices =
                    await ExcuseService.GetServicesAsync();

                availableLatePermissionServices =
                    await LatePermissionService.GetServicesAsync();

                await LoadExcuseBackupsAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load the request page: {ex.Message}";
        }
    }
 private bool IsGeneralOrActivityRequest
{
    get
    {
        if (selectedRequestType == null)
            return false;

        var code =
            selectedRequestType.Code?.Trim()
            ?? string.Empty;

        var name =
            selectedRequestType.Name?.Trim()
            ?? string.Empty;

        return
            // General Request
            code.Equals(
                "General-Request",
                StringComparison.OrdinalIgnoreCase) ||
            code.Equals(
                "General",
                StringComparison.OrdinalIgnoreCase) ||
            name.Equals(
                "General Request",
                StringComparison.OrdinalIgnoreCase) ||
            name.Equals(
                "General Approval",
                StringComparison.OrdinalIgnoreCase) ||

            // Activity Request
            code.Equals(
                "Activity-Request",
                StringComparison.OrdinalIgnoreCase) ||
            code.Equals(
                "Activity",
                StringComparison.OrdinalIgnoreCase) ||
            name.Equals(
                "Activity Request",
                StringComparison.OrdinalIgnoreCase) ||
            name.Equals(
                "Activity Approval",
                StringComparison.OrdinalIgnoreCase);
    }
}
   protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (!AuthService.IsAuthenticated ||
        richTextEditorsInitialized ||
        (IsLeaveRequest || IsExcuseRequest || IsLatePermissionRequest))
    {
        return;
    }

    try
    {
        await JS.InvokeVoidAsync(
            "bccQuill.init",
            "detailsEditor",
            requestModel.Details);

        await JS.InvokeVoidAsync(
            "bccQuill.init",
            "approvalSoughtEditor",
            requestModel.ApprovalSought);

        richTextEditorsInitialized = true;
    }
    catch (Exception ex)
    {
        errorMessage =
            $"Rich text editor could not be initialized: {ex.Message}";

        StateHasChanged();
    }
}
private static bool LooksLikeAbsenceRequest(
    string? subject,
    string? details,
    string? approvalSought)
{
    var combined =
        $"{subject} {details} {approvalSought}";

    combined = System.Net.WebUtility.HtmlDecode(combined);

    combined = System.Text.RegularExpressions.Regex.Replace(
        combined,
        "<.*?>",
        " ");

    combined = System.Text.RegularExpressions.Regex.Replace(
        combined,
        @"\s+",
        " ")
        .Trim()
        .ToLowerInvariant();

    if (string.IsNullOrWhiteSpace(combined))
        return false;

    /*
     * Strong expressions that clearly suggest that the worker
     * may actually be requesting Leave or Off Service.
     */
    string[] strongIndicators =
    {
        // Leave / holiday
        "going on leave",
        "go on leave",
        "request for leave",
        "leave request",
        "annual leave",
        "personal leave",
        "going on holiday",
        "go on holiday",
        "on holiday",
        "holiday request",
        "vacation",
        "going on vacation",

        // Absence
        "permission to be absent",
        "permission to be away",
        "permission to miss",
        "permission from service",
        "excuse me from service",
        "excused from service",
        "absent from service",
        "absence from service",
        "absent from church",
        "absence from church",

        // Availability
        "will not be around",
        "won't be around",
        "would not be around",
        "not going to be around",
        "will not be available",
        "won't be available",
        "would not be available",
        "not available for service",
        "unavailable for service",
        "away from church",
        "away during this period",

        // Attendance
        "unable to attend",
        "cannot attend",
        "can't attend",
        "will not attend",
        "won't attend",
        "would not attend",
        "unable to make it",
        "cannot make it",
        "can't make it",
        "miss service",
        "miss the service",
        "missing service",
        "miss church",
        "miss the church service",

        // Location / being away
        "out of town",
        "out of abuja"
    };

    if (strongIndicators.Any(indicator =>
        combined.Contains(
            indicator,
            StringComparison.OrdinalIgnoreCase)))
    {
        return true;
    }

    /*
     * Travel alone should not trigger the warning because a genuine
     * Activity Request may concern travel arrangements.
     *
     * However, travel combined with wording suggesting personal
     * absence should trigger the warning.
     */
    var containsTravel =
        combined.Contains("travel") ||
        combined.Contains("travelling") ||
        combined.Contains("traveling") ||
        combined.Contains("trip") ||
        combined.Contains("journey");

    var containsPersonalAbsenceContext =
        combined.Contains("holiday") ||
        combined.Contains("leave") ||
        combined.Contains("absent") ||
        combined.Contains("absence") ||
        combined.Contains("away") ||
        combined.Contains("not around") ||
        combined.Contains("not available") ||
        combined.Contains("unavailable") ||
        combined.Contains("unable to attend") ||
        combined.Contains("cannot attend") ||
        combined.Contains("can't attend") ||
        combined.Contains("miss service") ||
        combined.Contains("miss church");

    if (containsTravel && containsPersonalAbsenceContext)
    {
        return true;
    }

    return false;
}
private void ChangeRequestTypeFromWarning()
{
    showRequestTypeWarningPopup = false;
    requestTypeWarningAcknowledged = false;

    /*
     * Keep everything the worker has typed.
     * They can simply change the Request Type dropdown.
     */
}

private async Task ContinueCurrentRequest()
{
    showRequestTypeWarningPopup = false;
    requestTypeWarningAcknowledged = true;

    await SubmitRequest();
}
 private void OnRequestTypeChanged(ChangeEventArgs e)
{
    errorMessage = null;
requestTypeWarningAcknowledged = false;
showRequestTypeWarningPopup = false;

    if (int.TryParse(
            e.Value?.ToString(),
            out var requestTypeId) &&
        requestTypeId > 0)
    {
        requestModel.RequestTypeId = requestTypeId;

        selectedRequestType = requestTypes
            .FirstOrDefault(x => x.Id == requestTypeId);
    }
    else
    {
        requestModel.RequestTypeId = 0;
        selectedRequestType = null;
    }

    if (!IsFinancialRequest)
    {
        ClearFinancialFields();
    }

    if (!IsLeaveRequest)
    {
        leaveRequestModel.Clear();
    }

    if (!IsExcuseRequest)
    {
        excuseRequestModel = new ExcuseRequestModel();
        availableExcuseBackups.Clear();
    }
    else
    {
        _ = LoadExcuseBackupsAsync();
    }

    if (!IsLatePermissionRequest)
    {
        latePermissionModel = new LatePermissionFormModel();
        latePermissionExpectedArrivalTime = string.Empty;
        latePermissionScheduledStart = null;
        latePermissionArrivalTimeOptions.Clear();
    }

    /*
     * The editor elements may be removed or recreated when
     * changing between Leave and other request types.
     */
    richTextEditorsInitialized = false;
}
  
    private async Task OnLatePermissionServiceChanged(ChangeEventArgs e)
    {
        errorMessage = null;
        latePermissionScheduledStart = null;
        latePermissionExpectedArrivalTime = string.Empty;
        latePermissionArrivalTimeOptions.Clear();

        latePermissionModel.ServiceId =
            int.TryParse(e.Value?.ToString(), out var serviceId)
                ? serviceId
                : 0;

        if (latePermissionModel.ServiceId <= 0)
        {
            latePermissionModel.RequestedDate = default;
            return;
        }

        try
        {
            latePermissionScheduledStart =
                await LatePermissionService.GetNextServiceDateTimeAsync(
                    latePermissionModel.ServiceId);

            latePermissionModel.RequestedDate =
                latePermissionScheduledStart.Value.Date;

            BuildLatePermissionArrivalTimeOptions();
        }
        catch (Exception ex)
        {
            latePermissionModel.RequestedDate = default;
            latePermissionScheduledStart = null;
            errorMessage = ex.Message;
        }
    }

    private void BuildLatePermissionArrivalTimeOptions()
    {
        latePermissionArrivalTimeOptions.Clear();
        latePermissionExpectedArrivalTime = string.Empty;

        if (!latePermissionScheduledStart.HasValue)
            return;

        var service = availableLatePermissionServices
            .FirstOrDefault(x => x.Id == latePermissionModel.ServiceId);

        if (service == null)
            return;

        var start = latePermissionScheduledStart.Value;
        var configuredEndTime =
            string.Equals(service.RecurrencePattern, "OneTime", StringComparison.OrdinalIgnoreCase)
                ? service.SpecificEndTime ?? service.EndTime
                : service.EndTime;

        var end = configuredEndTime.HasValue
            ? start.Date + configuredEndTime.Value
            : start.AddHours(4);

        if (end <= start)
            end = start.AddHours(4);

        // Keep the configured commencement time exactly, then offer 5-minute choices.
        var current = start;
        while (current <= end)
        {
            latePermissionArrivalTimeOptions.Add(
                new LatePermissionTimeOption
                {
                    Value = current.TimeOfDay.ToString(@"hh\:mm"),
                    Display = current.ToString("h:mm tt")
                });

            current = current.AddMinutes(5);
        }
    }

