  private async Task SubmitRequest()
{
    if (isSubmitting)
        return;

    errorMessage = null;

    if (AuthService.CurrentWorker == null)
    {
        errorMessage =
            "Unable to identify the current worker.";

        return;
    }

    if (requestModel.RequestTypeId <= 0)
    {
        errorMessage =
            "Please select a request type.";

        return;
    }

    if (string.IsNullOrWhiteSpace(requestModel.Subject))
    {
        errorMessage =
            "Subject is required.";

        return;
    }

    /*
     * Validate Financial Request-specific fields.
     */
    if (IsFinancialRequest)
    {
        if (!requestModel.AmountRequested.HasValue ||
            requestModel.AmountRequested.Value <= 0)
        {
            errorMessage =
                "Please enter a valid amount requested.";

            return;
        }

        if (string.IsNullOrWhiteSpace(
            requestModel.FinancialPurpose))
        {
            errorMessage =
                "Please state the financial purpose.";

            return;
        }
    }

    /*
     * Validate Leave Request-specific fields.
     */
    if (IsLeaveRequest)
    {
        try
        {
            LeaveRequestService.Validate(
                leaveRequestModel);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            return;
        }
    }

  if (IsExcuseRequest)
{
    if (excuseRequestForm == null)
    {
        ShowValidationPopup(
            "The Off Service Request form is not ready. Please try again.");

        return;
    }

    try
    {
        excuseRequestForm.Validate();
    }
    catch (Exception ex)
    {
        ShowValidationPopup(ex.Message);
        return;
    }
}
    if (IsLatePermissionRequest)
    {
        if (latePermissionModel.ServiceId <= 0)
        {
            ShowValidationPopup("Please select the service for which you expect to arrive late.");
            return;
        }
        if (latePermissionModel.RequestedDate == default)
        {
            ShowValidationPopup("Please select the service date.");
            return;
        }
        if (!TimeSpan.TryParse(latePermissionExpectedArrivalTime, out var expectedArrivalTime))
        {
            ShowValidationPopup("Please enter a valid expected arrival time.");
            return;
        }
        latePermissionModel.ExpectedArrivalTime = expectedArrivalTime;
        try
        {
            await LatePermissionService.ValidateAsync(
                AuthService.CurrentWorker.Id,
                latePermissionModel.ServiceId,
                latePermissionModel.RequestedDate,
                latePermissionModel.ExpectedArrivalTime,
                latePermissionModel.Reason);
        }
        catch (Exception ex)
        {
            ShowValidationPopup(ex.Message);
            return;
        }
    }

    try
    {
        isSubmitting = true;

        /*
         * Leave Request does not display the common
         * Details and Approval Sought editors.
         *
         * Populate the common fields automatically so that
         * the core ApprovalRequest record remains complete.
         */
        if (IsLeaveRequest)
        {
            requestModel.Details =
                HtmlCleanService.Clean(
                    leaveRequestModel.Purpose.Trim());

            requestModel.ApprovalSought =
                HtmlCleanService.Clean(
                    "Kindly approve my leave as requested.");
        }
        else if (IsExcuseRequest)
        {
            requestModel.Details =
                HtmlCleanService.Clean(
                    excuseRequestForm!.BuildCommonDetails());

            requestModel.ApprovalSought =
    HtmlCleanService.Clean(
        excuseRequestForm!.BuildApprovalSought());
        }
        else if (IsLatePermissionRequest)
        {
            var selectedService = availableLatePermissionServices.FirstOrDefault(x => x.Id == latePermissionModel.ServiceId);
            var serviceName = selectedService?.Name ?? "Selected Service";
            var expectedArrivalDisplay =
                latePermissionModel.ExpectedArrivalTime.ToString(@"h\:mm");

            requestModel.Details = HtmlCleanService.Clean(
                $"Late Permission Request for {serviceName} on {latePermissionModel.RequestedDate:dd MMMM yyyy}. " +
                $"Expected arrival time: {expectedArrivalDisplay}. " +
                $"Reason: {latePermissionModel.Reason.Trim()}");
            requestModel.ApprovalSought = HtmlCleanService.Clean(
                "Kindly approve my request to arrive late for this service.");
        }
        else
        {
            var rawDetails =
                await JS.InvokeAsync<string>(
                    "bccQuill.getHtml",
                    "detailsEditor");

            var rawApprovalSought =
                await JS.InvokeAsync<string>(
                    "bccQuill.getHtml",
                    "approvalSoughtEditor");

            requestModel.Details =
                HtmlCleanService.Clean(rawDetails);

            requestModel.ApprovalSought =
                HtmlCleanService.Clean(
                    rawApprovalSought);
        }

        /*
         * Common validation after either:
         * - reading Quill; or
         * - generating Leave defaults.
         */
        if (IsRichTextEmpty(requestModel.Details))
        {
            errorMessage =
                "Details / Background is required.";

            return;
        }

        if (IsRichTextEmpty(
            requestModel.ApprovalSought))
        {
            errorMessage =
                "Approval Sought is required.";

            return;
        }

        /*
 * General and Activity requests should not normally be used
 * to request permission for absence or non-attendance.
 *
 * Warn the worker, but allow them to continue deliberately.
 */
if (IsGeneralOrActivityRequest &&
    !requestTypeWarningAcknowledged &&
    LooksLikeAbsenceRequest(
        requestModel.Subject,
        requestModel.Details,
        requestModel.ApprovalSought))
{
    showRequestTypeWarningPopup = true;
    return;
}
        /*
         * 1. Create the common Approval Request.
         */
        var newRequestId =
            await ApprovalRequestService
                .CreateAndSubmitRequestAsync(
                    requestModel.RequestTypeId,
                    requestModel.Subject,
                    requestModel.Details,
                    requestModel.ApprovalSought,
                    AuthService.CurrentWorker.Id);

        /*
         * 2. Save Financial Request-specific details.
         */
        if (IsFinancialRequest &&
            requestModel.AmountRequested.HasValue)
        {
            await ApprovalRequestService
                .SaveFinancialRequestDetailsAsync(
                    newRequestId,
                    requestModel.AmountRequested.Value,
                    requestModel.FinancialPurpose,
                    requestModel.BudgetLine,
                    requestModel.PaymentDetails);
        }

        /*
         * 3. Save Leave Request-specific details.
         */
        if (IsLeaveRequest)
        {
            await LeaveRequestService
                .SaveLeaveRequestDetailsAsync(
                    newRequestId,
                    leaveRequestModel);
        }

        /*
         * 4. Save Excuse Request-specific details.
         */
        if (IsExcuseRequest)
        {
            await ApprovalRequestService
                .SaveOffServiceRequestDetailsAsync(
                    newRequestId,
                    excuseRequestModel);
        }

        /* Save Late Permission-specific details. */
        if (IsLatePermissionRequest)
        {
            await LatePermissionService.SaveLatePermissionRequestDetailsAsync(
                newRequestId,
                AuthService.CurrentWorker.Id,
                latePermissionModel.ServiceId,
                latePermissionModel.RequestedDate,
                latePermissionModel.ExpectedArrivalTime,
                latePermissionModel.Reason);
        }

        /*
         * 5. Save supporting attachments.
         */
        if (selectedFiles.Any())
        {
            await ApprovalRequestService
                .SaveAttachmentsAsync(
                    newRequestId,
                    AuthService.CurrentWorker.Id,
                    selectedFiles);
        }

        /*
         * 6. Reload the request to obtain
         * the actual assigned approver.
         */
        var submittedRequest =
            await ApprovalRequestService
                .GetRequestByIdAsync(
                    newRequestId);

        var approverName =
            submittedRequest?.CurrentApproverWorker != null
                ? $"{submittedRequest.CurrentApproverWorker.FirstName} " +
                  $"{submittedRequest.CurrentApproverWorker.LastName}"
                : FormatApproverType(
                    submittedRequest?.CurrentApproverType);

        popupMessage =
            $"Your request has been sent to {approverName} for approval.";

        showSuccessPopup = true;
    }
   catch (Exception ex)
{
    errorMessage = null;

    ShowValidationPopup(
        $"Error submitting request: {ex.Message}");
}
finally
{
    isSubmitting = false;
}
}

    private async Task LoadExcuseBackupsAsync()
    {
        if (AuthService.CurrentWorker == null)
        {
            availableExcuseBackups.Clear();
            return;
        }

        try
        {
            isExcuseDataLoading = true;

            availableExcuseBackups =
                await ExcuseService.GetAvailableBackupsAsync(
                    AuthService.CurrentWorker.Id,
                    excuseRequestModel.ServiceId,
                  excuseRequestModel.RequestedDate == default
    ? DateTime.Today
    : excuseRequestModel.RequestedDate);
        }
        catch (Exception ex)
        {
            availableExcuseBackups.Clear();
            errorMessage =
                $"Unable to load available backup workers: {ex.Message}";
        }
        finally
        {
            isExcuseDataLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsRichTextEmpty(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return true;

        var text = System.Text.RegularExpressions.Regex.Replace(
            html,
            "<.*?>",
            string.Empty);

        text = System.Net.WebUtility.HtmlDecode(text)
            .Replace("\u00A0", " ")
            .Trim();

        return string.IsNullOrWhiteSpace(text);
    }

    private async Task ClearForm()
{
    requestModel = new ApprovalRequestFormModel();
    selectedRequestType = null;
    selectedFiles.Clear();

    leaveRequestModel.Clear();
    excuseRequestModel = new ExcuseRequestModel();
    availableExcuseBackups.Clear();
    latePermissionModel = new LatePermissionFormModel();
    latePermissionExpectedArrivalTime = string.Empty;
    latePermissionScheduledStart = null;

    errorMessage = null;
    richTextEditorsInitialized = false;

    try
    {
        await JS.InvokeVoidAsync(
            "bccQuill.clear",
            "detailsEditor");

        await JS.InvokeVoidAsync(
            "bccQuill.clear",
            "approvalSoughtEditor");
    }
    catch
    {
        // Editors may not exist when Leave Request is selected.
    }
}

