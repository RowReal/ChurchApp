@page "/approvals/permission-report"
@layout Components.Layout.MainLayout
@using ChurchApp.Services
@inject PermissionRequestReportService ReportService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Permission Requests Report - BCC ServiceHub</PageTitle>

@if (AuthService.IsAuthenticated)
{
    <div class="worker360-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i>@errorMessage
            </div>
        }

        <div class="bcc-page-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-file-alt me-2"></i>
                    Approval Hub
                </div>
                <div class="bcc-page-title">Permission Requests Report</div>
                <div class="bcc-page-subtitle">
                    Leave, Off Service and Late Permission requests within your authorised organisational scope.
                </div>
            </div>
        </div>

        <div class="bcc-card mb-3">
            <div class="bcc-card-body">
                <div class="worker360-section">
                    <h5>
                        <i class="fas fa-filter"></i>
                        Report Filters
                    </h5>

                    <div class="filter-grid">
                        <div>
                            <label class="form-label">Month</label>
                            <select class="form-select" @bind="selectedMonth">
                                @foreach (var month in months)
                                {
                                    <option value="@month.Number">@month.Name</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="form-label">Year</label>
                            <select class="form-select" @bind="selectedYear">
                                @foreach (var year in AvailableYears)
                                {
                                    <option value="@year">@year</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="form-label">Name</label>
                            <input class="form-control"
                                   @bind="searchText"
                                   @bind:event="oninput"
                                   placeholder="Search worker or request code" />
                        </div>

                        <div>
                            <label class="form-label">Request Type</label>
                            <select class="form-select" @bind="selectedRequestType">
                                <option value="All">All</option>
                                @foreach (var type in AvailableRequestTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="form-label">Directorate</label>
                            <select class="form-select"
                                    value="@selectedDirectorate"
                                    @onchange="OnDirectorateChanged">
                                <option value="All">All</option>
                                @foreach (var directorate in AvailableDirectorates)
                                {
                                    <option value="@directorate">@directorate</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="form-label">Department</label>
                            <select class="form-select" @bind="selectedDepartment">
                                <option value="All">All</option>
                                @foreach (var department in AvailableDepartments)
                                {
                                    <option value="@department">@department</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="form-label">Status</label>
                            <select class="form-select" @bind="selectedStatus">
                                <option value="All">All</option>
                                <option value="Approved">Approved</option>
                                <option value="Pending">Pending</option>
                                <option value="Rejected">Rejected</option>
                                <option value="MoreInfoRequested">More Information Requested</option>
                                <option value="Closed">Closed</option>
                            </select>
                        </div>

                        <div class="filter-actions">
                            <button class="bcc-btn bcc-btn-primary"
                                    disabled="@isLoading"
                                    @onclick="GenerateReport">
                                <i class="fas fa-search me-2"></i>
                                @(isLoading ? "Generating..." : "Generate Report")
                            </button>

                            <button class="bcc-btn bcc-btn-secondary"
                                    @onclick="ResetFilters">
                                <i class="fas fa-undo me-2"></i>Reset
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (reportGenerated)
        {
            <div class="summary-grid">
                <div class="summary-card">
                    <div class="summary-icon">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <div>
                        <div class="summary-value">@FilteredResults.Count</div>
                        <div class="summary-label">Total Requests</div>
                    </div>
                </div>

                <div class="summary-card summary-approved">
                    <div class="summary-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div>
                        <div class="summary-value">@CountStatus("Approved")</div>
                        <div class="summary-label">Approved</div>
                    </div>
                </div>

                <div class="summary-card summary-pending">
                    <div class="summary-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div>
                        <div class="summary-value">@CountStatus("Pending")</div>
                        <div class="summary-label">Pending</div>
                    </div>
                </div>

                <div class="summary-card summary-rejected">
                    <div class="summary-icon">
                        <i class="fas fa-times-circle"></i>
                    </div>
                    <div>
                        <div class="summary-value">@CountStatus("Rejected")</div>
                        <div class="summary-label">Rejected</div>
                    </div>
                </div>
            </div>

            <div class="type-summary">
                <span>
                    <strong>@CountRequestType("Leave")</strong> Leave
                </span>
                <span>
                    <strong>@CountRequestType("Off Service")</strong> Off Service
                </span>
                <span>
                    <strong>@CountRequestType("Late Permission")</strong> Late Permission
                </span>
            </div>

            @if (FilteredResults.Any())
            {
                <div class="bcc-card">
                    <div class="bcc-card-body">
                        <div class="worker360-section">
                            <div class="report-heading">
                                <h5>
                                    <i class="fas fa-list"></i>
                                    Permission Requests
                                </h5>

                                <span class="result-count">
                                    @FilteredResults.Count record@(FilteredResults.Count == 1 ? "" : "s")
                                </span>
                            </div>

                            <div class="table-responsive">
                                <table class="table align-middle permission-table">
                                    <thead>
                                        <tr>
                                            <th>Submitted</th>
                                            <th>Request Code</th>
                                            <th>Worker</th>
                                            <th>Directorate</th>
                                            <th>Department</th>
                                            <th>Permission Type</th>
                                            <th>Subject</th>
                                            <th>Status</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in FilteredResults)
                                        {
                                            <tr>
                                                <td class="date-cell">
                                                    @(item.SubmittedAt?.ToString("dd MMM yyyy") ?? "-")
                                                    <small>
                                                        @(item.SubmittedAt?.ToString("hh:mm tt") ?? "")
                                                    </small>
                                                </td>

                                                <td>
                                                    <strong>@item.RequestCode</strong>
                                                </td>

                                                <td>
                                                    <strong>@item.WorkerName</strong>
                                                </td>

                                                <td>
                                                    @(string.IsNullOrWhiteSpace(item.DirectorateName)
                                                        ? "-"
                                                        : item.DirectorateName)
                                                </td>

                                                <td>
                                                    @(string.IsNullOrWhiteSpace(item.DepartmentName)
                                                        ? "-"
                                                        : item.DepartmentName)
                                                </td>

                                                <td>
                                                    <span class="request-type-badge">
                                                        @GetFriendlyRequestType(item.RequestTypeName)
                                                    </span>
                                                </td>

                                                <td class="subject-cell">
                                                    @item.Subject
                                                </td>

                                                <td>
                                                    <span class="@GetStatusBadgeClass(item.StatusCategory)">
                                                        @item.StatusDisplay
                                                    </span>
                                                </td>

                                                <td class="text-end">
                                                    <button class="team-action-btn"
                                                            @onclick="() => ViewDetails(item.RequestId)">
                                                        <i class="fas fa-eye me-1"></i>View
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="bcc-empty">
                    <i class="fas fa-folder-open"></i>
                    <h4>No Permission Requests Found</h4>
                    <p>No Leave, Off Service or Late Permission request matches the selected filters.</p>
                </div>
            }
        }
    </div>
}
else
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to view this report.</p>
        <a href="/login" class="bcc-btn bcc-btn-primary">Go to Login</a>
    </div>
}

<style>
    .filter-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        align-items: end;
    }

    .filter-actions {
        display: flex;
        gap: 8px;
        align-items: end;
        flex-wrap: wrap;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 14px;
    }

    .summary-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
    }

    .summary-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .summary-value {
        font-size: 1.55rem;
        font-weight: 800;
        line-height: 1;
        color: #111827;
    }

    .summary-label {
        margin-top: 5px;
        color: #6b7280;
        font-size: .82rem;
        font-weight: 600;
    }

    .summary-approved .summary-icon {
        color: #15803d;
        background: #dcfce7;
    }

    .summary-pending .summary-icon {
        color: #a16207;
        background: #fef9c3;
    }

    .summary-rejected .summary-icon {
        color: #b91c1c;
        background: #fee2e2;
    }

    .type-summary {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .type-summary span {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 999px;
        padding: 7px 12px;
        color: #4b5563;
        font-size: .8rem;
    }

    .type-summary strong {
        color: #111827;
        margin-right: 4px;
    }

    .report-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

    .report-heading h5 {
        margin-bottom: 0;
    }

    .result-count {
        color: #6b7280;
        font-size: .78rem;
        font-weight: 700;
    }

    .permission-table {
        font-size: .82rem;
    }

    .permission-table th {
        white-space: nowrap;
    }

    .date-cell {
        white-space: nowrap;
    }

    .date-cell small {
        display: block;
        color: #6b7280;
        margin-top: 2px;
    }

    .subject-cell {
        min-width: 180px;
        max-width: 280px;
    }

    .request-type-badge {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 999px;
        background: #eef2ff;
        color: #3730a3;
        font-weight: 700;
        white-space: nowrap;
    }

    .permission-status {
        display: inline-block;
        border-radius: 999px;
        padding: 5px 9px;
        font-size: .72rem;
        font-weight: 800;
        line-height: 1.25;
        white-space: normal;
    }

    .permission-status-approved {
        background: #dcfce7;
        color: #166534;
    }

    .permission-status-pending {
        background: #fef9c3;
        color: #854d0e;
    }

    .permission-status-rejected {
        background: #fee2e2;
        color: #991b1b;
    }

    .permission-status-info {
        background: #dbeafe;
        color: #1e40af;
    }

    .permission-status-closed {
        background: #e5e7eb;
        color: #374151;
    }

    .permission-status-default {
        background: #f3f4f6;
        color: #374151;
    }

    @@media (max-width: 1100px) {
        .filter-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 650px) {
        .filter-grid,
        .summary-grid {
            grid-template-columns: 1fr;
        }

        .filter-actions {
            width: 100%;
        }

        .filter-actions .bcc-btn {
            flex: 1;
        }
    }
</style>

@code {
    private List<PermissionRequestReportRow> reportResults = new();

    private string? errorMessage;
    private bool isLoading;
    private bool reportGenerated;

    private int selectedMonth = DateTime.Now.Month;
    private int selectedYear = DateTime.Now.Year;

    private string searchText = string.Empty;
    private string selectedRequestType = "All";
    private string selectedDirectorate = "All";
    private string selectedDepartment = "All";
    private string selectedStatus = "All";

    private readonly List<MonthOption> months =
        Enumerable.Range(1, 12)
            .Select(x => new MonthOption
            {
                Number = x,
                Name = new DateTime(2000, x, 1)
                    .ToString("MMMM")
            })
            .ToList();

    private IEnumerable<int> AvailableYears
    {
        get
        {
            var currentYear = DateTime.Now.Year;

            return Enumerable.Range(
                    Math.Max(2024, currentYear - 5),
                    7)
                .OrderByDescending(x => x);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated ||
            AuthService.CurrentWorker == null)
        {
            return;
        }

        await LoadReportAsync();
    }

    private async Task GenerateReport()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        try
        {
            errorMessage = null;
            isLoading = true;

            if (AuthService.CurrentWorker == null)
            {
                reportResults = new();
                reportGenerated = true;
                return;
            }

            reportResults =
                await ReportService.GetReportAsync(
                    AuthService.CurrentWorker.Id,
                    selectedYear,
                    selectedMonth);

            NormaliseFilterSelections();

            reportGenerated = true;
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to generate Permission Requests Report: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<PermissionRequestReportRow> FilteredResults
    {
        get
        {
            IEnumerable<PermissionRequestReportRow> query =
                reportResults;

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var term = searchText.Trim();

                query = query.Where(x =>
                    x.WorkerName.Contains(
                        term,
                        StringComparison.OrdinalIgnoreCase) ||
                    x.RequestCode.Contains(
                        term,
                        StringComparison.OrdinalIgnoreCase) ||
                    x.Subject.Contains(
                        term,
                        StringComparison.OrdinalIgnoreCase));
            }

            if (selectedRequestType != "All")
            {
                query = query.Where(x =>
                    string.Equals(
                        GetFriendlyRequestType(
                            x.RequestTypeName),
                        selectedRequestType,
                        StringComparison.OrdinalIgnoreCase));
            }

            if (selectedDirectorate != "All")
            {
                query = query.Where(x =>
                    string.Equals(
                        x.DirectorateName,
                        selectedDirectorate,
                        StringComparison.OrdinalIgnoreCase));
            }

            if (selectedDepartment != "All")
            {
                query = query.Where(x =>
                    string.Equals(
                        x.DepartmentName,
                        selectedDepartment,
                        StringComparison.OrdinalIgnoreCase));
            }

            if (selectedStatus != "All")
            {
                query = query.Where(x =>
                    string.Equals(
                        x.StatusCategory,
                        selectedStatus,
                        StringComparison.OrdinalIgnoreCase));
            }

            return query
                .OrderByDescending(x => x.SubmittedAt)
                .ThenByDescending(x => x.RequestId)
                .ToList();
        }
    }

    private List<string> AvailableRequestTypes =>
        reportResults
            .Select(x =>
                GetFriendlyRequestType(
                    x.RequestTypeName))
            .Where(x =>
                !string.IsNullOrWhiteSpace(x))
            .Distinct(
                StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();

    private List<string> AvailableDirectorates =>
        reportResults
            .Select(x => x.DirectorateName)
            .Where(x =>
                !string.IsNullOrWhiteSpace(x))
            .Distinct(
                StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();

    private List<string> AvailableDepartments
    {
        get
        {
            IEnumerable<PermissionRequestReportRow> query =
                reportResults;

            if (selectedDirectorate != "All")
            {
                query = query.Where(x =>
                    string.Equals(
                        x.DirectorateName,
                        selectedDirectorate,
                        StringComparison.OrdinalIgnoreCase));
            }

            return query
                .Select(x => x.DepartmentName)
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x))
                .Distinct(
                    StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .ToList();
        }
    }

    private void OnDirectorateChanged(
        ChangeEventArgs e)
    {
        selectedDirectorate =
            e.Value?.ToString() ?? "All";

        selectedDepartment = "All";
    }

    private void ResetFilters()
    {
        selectedMonth = DateTime.Now.Month;
        selectedYear = DateTime.Now.Year;
        searchText = string.Empty;
        selectedRequestType = "All";
        selectedDirectorate = "All";
        selectedDepartment = "All";
        selectedStatus = "All";

        _ = LoadReportAsync();
    }

    private void NormaliseFilterSelections()
    {
        if (selectedRequestType != "All" &&
            !AvailableRequestTypes.Contains(
                selectedRequestType,
                StringComparer.OrdinalIgnoreCase))
        {
            selectedRequestType = "All";
        }

        if (selectedDirectorate != "All" &&
            !AvailableDirectorates.Contains(
                selectedDirectorate,
                StringComparer.OrdinalIgnoreCase))
        {
            selectedDirectorate = "All";
            selectedDepartment = "All";
        }

        if (selectedDepartment != "All" &&
            !AvailableDepartments.Contains(
                selectedDepartment,
                StringComparer.OrdinalIgnoreCase))
        {
            selectedDepartment = "All";
        }
    }

    private int CountStatus(string status)
    {
        return FilteredResults.Count(x =>
            string.Equals(
                x.StatusCategory,
                status,
                StringComparison.OrdinalIgnoreCase));
    }

    private int CountRequestType(string type)
    {
        return FilteredResults.Count(x =>
            string.Equals(
                GetFriendlyRequestType(
                    x.RequestTypeName),
                type,
                StringComparison.OrdinalIgnoreCase));
    }

    private static string GetFriendlyRequestType(
        string? requestTypeName)
    {
        var value =
            (requestTypeName ?? string.Empty).Trim();

        if (value.Equals(
                "Leave Request",
                StringComparison.OrdinalIgnoreCase))
        {
            return "Leave";
        }

        if (value.Equals(
                "Off Service Request",
                StringComparison.OrdinalIgnoreCase))
        {
            return "Off Service";
        }

        if (value.Equals(
                "Late Permission Request",
                StringComparison.OrdinalIgnoreCase))
        {
            return "Late Permission";
        }

        return value;
    }

    private static string GetStatusBadgeClass(
        string statusCategory)
    {
        if (statusCategory.Equals(
                "Approved",
                StringComparison.OrdinalIgnoreCase))
        {
            return "permission-status permission-status-approved";
        }

        if (statusCategory.Equals(
                "Pending",
                StringComparison.OrdinalIgnoreCase))
        {
            return "permission-status permission-status-pending";
        }

        if (statusCategory.Equals(
                "Rejected",
                StringComparison.OrdinalIgnoreCase))
        {
            return "permission-status permission-status-rejected";
        }

        if (statusCategory.Equals(
                "MoreInfoRequested",
                StringComparison.OrdinalIgnoreCase))
        {
            return "permission-status permission-status-info";
        }

        if (statusCategory.Equals(
                "Closed",
                StringComparison.OrdinalIgnoreCase))
        {
            return "permission-status permission-status-closed";
        }

        return "permission-status permission-status-default";
    }

    private void ViewDetails(int requestId)
    {
        Navigation.NavigateTo(
            $"/approvals/details/{requestId}");
    }

    private sealed class MonthOption
    {
        public int Number { get; set; }
        public string Name { get; set; } =
            string.Empty;
    }
}
