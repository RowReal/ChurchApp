    --approval-green-hover: #1d7549;
    --approval-green-soft: #eaf5ee;
    --approval-border: #d8e7dc;
    color: #203b2d;
    font-size: .93rem;
}
.worker360-page .bcc-page-header,
.worker360-page .worker360-hero {
    background: #145c39 !important;
    background-image: none !important;
    border: 1px solid #0f4b2e !important;
    border-radius: 7px !important;
    box-shadow: 0 5px 14px rgba(20,92,57,.12) !important;
    color: #fff !important;
    padding: 16px 20px !important;
    margin-bottom: 15px !important;
}
.worker360-page .bcc-page-header *,
.worker360-page .worker360-hero .bcc-page-title,
.worker360-page .worker360-hero .bcc-page-subtitle {
    color: #fff !important;
}
.worker360-page .bcc-page-title {
    font-size: 1.42rem !important;
    font-weight: 750 !important;
    line-height: 1.2 !important;
    letter-spacing: -.025em;
}
.worker360-page .bcc-page-subtitle { font-size: .84rem !important; opacity: .93; }
.worker360-page .bcc-card,
.worker360-page .card {
    border: 1px solid var(--approval-border) !important;
    border-radius: 7px !important;
    box-shadow: 0 3px 12px rgba(20,92,57,.055) !important;
    background: #fff;
}
.worker360-page .bcc-card-body,
.worker360-page .card-body { padding: 14px 16px !important; }
.worker360-page .bcc-btn-primary,
.worker360-page .btn-primary,
.worker360-page .btn-success {
    background: var(--approval-green) !important;
    border-color: var(--approval-green) !important;
    color: #fff !important;
}
.worker360-page .bcc-btn-primary:hover,
.worker360-page .btn-primary:hover,
.worker360-page .btn-success:hover {
    background: var(--approval-green-hover) !important;
    border-color: var(--approval-green-hover) !important;
