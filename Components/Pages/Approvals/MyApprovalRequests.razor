}
.worker360-page .btn-outline-primary:hover,
.worker360-page .bcc-btn-outline-primary:hover { color: #fff !important; background: var(--approval-green) !important; }
.worker360-page .form-control,
.worker360-page .form-select,
.worker360-page input:not([type=checkbox]):not([type=radio]),
.worker360-page textarea,
.worker360-page select {
    border-radius: 5px !important;
    border-color: #cbded1;
}
.worker360-page .form-control:focus,
.worker360-page .form-select:focus {
    border-color: #31845a !important;
    box-shadow: 0 0 0 .15rem rgba(49,132,90,.15) !important;
}
.worker360-page .table { font-size: .88rem; }
.worker360-page .table thead th,
.worker360-page .bcc-table thead th {
    background: var(--approval-green-soft) !important;
    color: #145c39 !important;
    border-bottom: 1px solid #c9dfd0 !important;
    font-weight: 700;
    padding: 9px 10px !important;
}
.worker360-page .table tbody td { padding: 8px 10px !important; vertical-align: middle; }
.worker360-page .table tbody tr:hover { background: #f4faf6; }
.worker360-page a:not(.btn):not(.bcc-btn) { color: #17643d; }
.worker360-page a:not(.btn):not(.bcc-btn):hover { color: #0c4328; }
.worker360-page .nav-pills .nav-link.active,
.worker360-page .nav-tabs .nav-link.active { color: #145c39 !important; border-color: #31845a !important; font-weight: 700; }
.worker360-page .badge.bg-primary,
.worker360-page .bg-primary { background-color: #247a4d !important; }
.worker360-page .text-primary { color: #145c39 !important; }
.worker360-page .alert { border-radius: 6px; padding: 9px 12px; }
@@media (max-width: 767px) {
    .worker360-page .bcc-page-header,
    .worker360-page .worker360-hero { padding: 14px !important; }
    .worker360-page .bcc-card-body,
    .worker360-page .card-body { padding: 12px !important; }
    .worker360-page .bcc-page-title { font-size: 1.23rem !important; }
}
</style>
