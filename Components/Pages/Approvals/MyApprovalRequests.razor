@page "/approvals/my-requests"
@layout Components.Layout.MainLayout
@using ChurchApp.Models
@using ChurchApp.Services
@inject ApprovalRequestService ApprovalRequestService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>My Requests - BCC ServiceHub</PageTitle>

@if (AuthService.IsAuthenticated)
{
    <div class="worker360-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i>@errorMessage
            </div>
        }

        <div class="bcc-page-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-clipboard-list me-2"></i>
                    Approval Hub
                </div>
                <div class="bcc-page-title">My Requests</div>
                <div class="bcc-page-subtitle">
                    View and track all approval requests you have submitted.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button class="bcc-btn bcc-btn-primary" @onclick="CreateNewRequest">
                    <i class="fas fa-plus-circle me-2"></i>New Request
                </button>
            </div>
        </div>

        @if (requests.Any())
        {
            <div class="bcc-card">
                <div class="bcc-card-body">
                    <div class="worker360-section">
                        <h5>
                            <i class="fas fa-list"></i>
                            Submitted Requests
                        </h5>

                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Request Code</th>
                                        <th>Type</th>
                                        <th>Subject</th>
                                        <th>Status</th>
                                        <th>Submitted</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in requests)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@item.RequestCode</strong>
                                            </td>
                                            <td>@item.RequestType?.Name</td>
                                            <td>@item.Subject</td>
                                            <td>
                                                <span class="@GetStatusBadgeClass(item.Status)">
                                                    @item.Status
                                                </span>
                                            </td>
                                            <td>
                                                @(item.SubmittedAt?.ToString("dd MMM yyyy HH:mm") ?? "-")
                                            </td>
                                            <td class="text-end">
                                                <button class="team-action-btn"
                                                        @onclick="() => ViewDetails(item.Id)">
                                                    <i class="fas fa-eye me-1"></i>View
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="bcc-empty">
                <i class="fas fa-folder-open"></i>
                <h4>No Requests Yet</h4>
                <p>You have not submitted any approval request.</p>
                <button class="bcc-btn bcc-btn-primary" @onclick="CreateNewRequest">
                    Create First Request
                </button>
            </div>
        }
    </div>
}
else
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to view your approval requests.</p>
        <a href="/login" class="bcc-btn bcc-btn-primary">Go to Login</a>
    </div>
}

@code {
    private List<ApprovalRequest> requests = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadRequests();
    }

    private async Task LoadRequests()
    {
        try
        {
            if (AuthService.CurrentWorker == null)
            {
                errorMessage = "Unable to identify current worker.";
                return;
            }

            requests = await ApprovalRequestService.GetMyRequestsAsync(AuthService.CurrentWorker.Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading requests: {ex.Message}";
        }
    }

    private void CreateNewRequest()
    {
        Navigation.NavigateTo("/approvals/new");
    }

    private void ViewDetails(int requestId)
    {
        Navigation.NavigateTo($"/approvals/details/{requestId}");
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Approved" => "badge bg-success",
            "Rejected" => "badge bg-danger",
            "MoreInfoRequested" => "badge bg-warning text-dark",
            "Submitted" => "badge bg-primary",
            "Pending" => "badge bg-info text-dark",
            "Closed" => "badge bg-secondary",
            _ => "badge bg-light text-dark"
        };
    }
}
