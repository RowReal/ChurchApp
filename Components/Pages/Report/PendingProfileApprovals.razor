@page "/reports/pending-profile-approvals"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services
@using System.Text.Json

@inject WorkforceService WorkforceService
@inject AuthService AuthService

<PageTitle>Pending Profile Approvals - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="ppa-page">
        <div class="ppa-empty">
            <i class="fas fa-lock"></i>
            <h4>Please Log In</h4>
            <p>You need to be logged in to access this report.</p>
            <a href="/login" class="btn btn-primary btn-sm">Go to Login</a>
        </div>
    </div>
}
else if (!CanAccessReport())
{
    <div class="ppa-page">
        <div class="ppa-empty">
            <i class="fas fa-shield-alt"></i>
            <h4>Access Restricted</h4>
            <p>This report is available only to authorised MEAT leadership and the Senior Pastor.</p>
        </div>
    </div>
}
else if (isLoading)
{
    <div class="ppa-page">
        <div class="ppa-card text-center p-4">
            <div class="spinner-border text-primary"></div>
            <div class="mt-2 text-muted">Loading pending profile approvals...</div>
        </div>
    </div>
}
else
{
    <div class="ppa-page">
        <div class="ppa-hero">
            <div>
                <div class="ppa-eyebrow">WORKFORCE OVERSIGHT</div>
                <h2>Pending Profile Approvals</h2>
                <p>Monitor profile update requests awaiting action and how long each request has remained on the current approver's desk.</p>
            </div>
            <button class="btn btn-light btn-sm" @onclick="LoadReportAsync">
                <i class="fas fa-sync-alt me-1"></i> Refresh
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2 mt-3">@errorMessage</div>
        }

        <div class="ppa-summary-grid">
            <div class="ppa-summary">
                <span>Total Pending</span>
                <strong>@pendingRequests.Count</strong>
            </div>
            <div class="ppa-summary">
                <span>1–3 Days</span>
                <strong>@CountByAge(1, 3)</strong>
            </div>
            <div class="ppa-summary">
                <span>4–7 Days</span>
                <strong>@CountByAge(4, 7)</strong>
            </div>
            <div class="ppa-summary">
                <span>Over 7 Days</span>
                <strong>@CountOverDays(7)</strong>
            </div>
        </div>

        <div class="ppa-card">
            <div class="ppa-toolbar">
                <div class="ppa-search">
                    <i class="fas fa-search"></i>
                    <input class="form-control form-control-sm"
                           placeholder="Search worker, directorate or approver..."
                           @bind="searchText"
                           @bind:event="oninput" />
                </div>
                <div class="ppa-count">@FilteredRequests.Count() request(s)</div>
            </div>

            @if (!FilteredRequests.Any())
            {
                <div class="ppa-empty compact">
                    <i class="fas fa-check-circle"></i>
                    <h5>No Pending Profile Approvals</h5>
                    <p>There are no pending requests matching the current search.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 ppa-table">
                        <thead>
                            <tr>
                                <th>Worker</th>
                                <th>Directorate</th>
                                <th>Request Date</th>
                                <th>Pending With</th>
                                <th>Pending Since</th>
                                <th>Time on Desk</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in FilteredRequests)
                            {
                                <tr>
                                    <td>
                                        <div class="ppa-worker-name">@GetWorkerName(request.Worker)</div>
                                        <div class="ppa-muted">@request.Worker?.WorkerId</div>
                                    </td>
                                    <td>@(request.Worker?.Directorate?.Name ?? "Not assigned")</td>
                                    <td>
                                        <div>@ToLocal(request.SubmittedDate).ToString("dd MMM yyyy")</div>
                                        <div class="ppa-muted">@ToLocal(request.SubmittedDate).ToString("hh:mm tt")</div>
                                    </td>
                                    <td>
                                        <div class="ppa-approver">@GetPendingWith(request)</div>
                                    </td>
                                    <td>
                                        <div>@ToLocal(request.LastUpdated).ToString("dd MMM yyyy")</div>
                                        <div class="ppa-muted">@ToLocal(request.LastUpdated).ToString("hh:mm tt")</div>
                                    </td>
                                    <td>
                                        <span class="@GetAgeBadgeClass(request)">
                                            @GetTimeOnDesk(request)
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-outline-primary btn-sm"
                                                @onclick="() => OpenDetails(request)">
                                            <i class="fas fa-eye me-1"></i> View
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (selectedRequest != null)
{
    <div class="ppa-modal-backdrop" @onclick="CloseDetails">
        <div class="ppa-modal" @onclick:stopPropagation="true">
            <div class="ppa-modal-header">
                <div>
                    <div class="ppa-eyebrow">PROFILE UPDATE REQUEST</div>
                    <h4>@GetWorkerName(selectedRequest.Worker)</h4>
                    <div class="ppa-muted">Request #@selectedRequest.Id</div>
                </div>
                <button type="button" class="ppa-close" @onclick="CloseDetails">&times;</button>
            </div>

            <div class="ppa-modal-body">
                <div class="ppa-detail-grid">
                    <div>
                        <span>Directorate</span>
                        <strong>@(selectedRequest.Worker?.Directorate?.Name ?? "Not assigned")</strong>
                    </div>
                    <div>
                        <span>Role</span>
                        <strong>@(selectedRequest.Worker?.Role ?? "Worker")</strong>
                    </div>
                    <div>
                        <span>Requested</span>
                        <strong>@ToLocal(selectedRequest.SubmittedDate).ToString("dd MMM yyyy, hh:mm tt")</strong>
                    </div>
                    <div>
                        <span>Pending With</span>
                        <strong>@GetPendingWith(selectedRequest)</strong>
                    </div>
                    <div>
                        <span>Pending Since</span>
                        <strong>@ToLocal(selectedRequest.LastUpdated).ToString("dd MMM yyyy, hh:mm tt")</strong>
                    </div>
                    <div>
                        <span>Time on Desk</span>
                        <strong>@GetTimeOnDesk(selectedRequest)</strong>
                    </div>
                </div>

                <div class="ppa-section-title">Requested Changes</div>

                @if (selectedChanges.Count == 0)
                {
                    <div class="ppa-empty compact">
                        <p>No changed fields could be identified.</p>
                    </div>
                }
                else
                {
                    <div class="ppa-change-list">
                        @foreach (var change in selectedChanges)
                        {
                            <div class="ppa-change">
                                <div class="ppa-change-label">@change.Label</div>
                                <div class="ppa-change-values">
                                    <div>
                                        <span>Current</span>
                                        <strong>@change.CurrentValue</strong>
                                    </div>
                                    <i class="fas fa-arrow-right"></i>
                                    <div>
                                        <span>Requested</span>
                                        <strong>@change.ProposedValue</strong>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="ppa-modal-footer">
                <button class="btn btn-secondary btn-sm" @onclick="CloseDetails">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private List<ProfileUpdateRequest> pendingRequests = new();
    private ProfileUpdateRequest? selectedRequest;
    private List<ChangeDisplay> selectedChanges = new();
    private string searchText = string.Empty;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated && CanAccessReport())
            await LoadReportAsync();
        else
            isLoading = false;
    }

    private bool CanAccessReport()
    {
        var worker = AuthService.CurrentWorker;
        if (worker == null)
            return false;

        var role = worker.Role?.Trim() ?? string.Empty;
        var directorateCode = worker.Directorate?.Code?.Trim() ?? string.Empty;

        if (role.Equals("Senior Pastor", StringComparison.OrdinalIgnoreCase))
            return true;

        var isMeat =
            directorateCode.Equals("MEAT", StringComparison.OrdinalIgnoreCase);

        if (!isMeat)
            return false;

        return role.Equals("Head of Directorate", StringComparison.OrdinalIgnoreCase)
            || role.Equals("Assistant Head of Directorate", StringComparison.OrdinalIgnoreCase)
            || role.Equals("Asst Head of Directorate", StringComparison.OrdinalIgnoreCase);
    }

    private async Task LoadReportAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            pendingRequests =
                await WorkforceService.GetAllPendingProfileApprovalsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load pending profile approvals: {ex.Message}";
            pendingRequests = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<ProfileUpdateRequest> FilteredRequests
    {
        get
        {
            IEnumerable<ProfileUpdateRequest> query = pendingRequests;

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var term = searchText.Trim();

                query = query.Where(r =>
                    GetWorkerName(r.Worker).Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (r.Worker?.WorkerId?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (r.Worker?.Directorate?.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    GetPendingWith(r).Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return query
                .OrderByDescending(r => GetDeskAge(r));
        }
    }

    private void OpenDetails(ProfileUpdateRequest request)
    {
        selectedRequest = request;
        selectedChanges = BuildChangeList(request);
    }

    private void CloseDetails()
    {
        selectedRequest = null;
        selectedChanges = new();
    }

    private static string GetWorkerName(Worker? worker)
    {
        if (worker == null)
            return "Unknown Worker";

        var values = new[]
        {
            worker.Title,
            worker.FirstName,
            worker.MiddleName,
            worker.LastName
        };

        var name = string.Join(" ",
            values.Where(x => !string.IsNullOrWhiteSpace(x)));

        return string.IsNullOrWhiteSpace(name)
            ? worker.WorkerId ?? "Unknown Worker"
            : name;
    }

    private static string GetPendingWith(ProfileUpdateRequest request)
    {
        var names = request.EligibleApprovers
            .Where(a => !a.HasActed && a.ApproverWorker != null)
            .Select(a => GetWorkerName(a.ApproverWorker))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (names.Count > 0)
            return string.Join(", ", names);

        if (request.ApproverWorker != null)
            return GetWorkerName(request.ApproverWorker);

        return "Not assigned";
    }

    private static DateTime ToLocal(DateTime value)
    {
        return value.Kind == DateTimeKind.Unspecified
            ? DateTime.SpecifyKind(value, DateTimeKind.Utc).ToLocalTime()
            : value.ToLocalTime();
    }

    private static TimeSpan GetDeskAge(ProfileUpdateRequest request)
    {
        var since = request.LastUpdated;

        if (since.Kind == DateTimeKind.Unspecified)
            since = DateTime.SpecifyKind(since, DateTimeKind.Utc);

        var age = DateTime.UtcNow - since.ToUniversalTime();
        return age < TimeSpan.Zero ? TimeSpan.Zero : age;
    }

    private static string GetTimeOnDesk(ProfileUpdateRequest request)
    {
        var age = GetDeskAge(request);

        if (age.TotalDays >= 1)
        {
            var days = (int)Math.Floor(age.TotalDays);
            var hours = age.Hours;
            return hours > 0
                ? $"{days}d {hours}h"
                : $"{days} day{(days == 1 ? "" : "s")}";
        }

        if (age.TotalHours >= 1)
            return $"{(int)Math.Floor(age.TotalHours)}h {age.Minutes}m";

        return $"{Math.Max(0, age.Minutes)}m";
    }

    private static string GetAgeBadgeClass(ProfileUpdateRequest request)
    {
        var days = GetDeskAge(request).TotalDays;

        if (days > 7)
            return "ppa-age ppa-age-danger";

        if (days >= 4)
            return "ppa-age ppa-age-warning";

        return "ppa-age ppa-age-normal";
    }

    private int CountByAge(int minimumDay, int maximumDay)
    {
        return pendingRequests.Count(r =>
        {
            var days = GetDeskAge(r).TotalDays;
            return days >= minimumDay && days < maximumDay + 1;
        });
    }

    private int CountOverDays(int days)
    {
        return pendingRequests.Count(r =>
            GetDeskAge(r).TotalDays > days);
    }

    private static List<ChangeDisplay> BuildChangeList(
        ProfileUpdateRequest request)
    {
        var result = new List<ChangeDisplay>();

        if (request.Worker == null ||
            string.IsNullOrWhiteSpace(request.ProposedChanges))
            return result;

        ProposedChanges? proposed;

        try
        {
            proposed =
                JsonSerializer.Deserialize<ProposedChanges>(
                    request.ProposedChanges);
        }
        catch
        {
            return result;
        }

        if (proposed == null)
            return result;

        var worker = request.Worker;

        AddIfChanged(result, "Title", worker.Title, proposed.Title);
        AddIfChanged(result, "First Name", worker.FirstName, proposed.FirstName);
        AddIfChanged(result, "Middle Name", worker.MiddleName, proposed.MiddleName);
        AddIfChanged(result, "Last Name", worker.LastName, proposed.LastName);
        AddIfChanged(result, "Sex", worker.Sex, proposed.Sex);
        AddIfChanged(result, "Email", worker.Email, proposed.Email);
        AddIfChanged(result, "Phone", worker.Phone, proposed.Phone);
        AddIfChanged(result, "Date of Birth",
            FormatDate(worker.DateOfBirth), FormatDate(proposed.DateOfBirth));
        AddIfChanged(result, "Marital Status",
            worker.MaritalStatus, proposed.MaritalStatus);
        AddIfChanged(result, "Wedding Anniversary",
            FormatDate(worker.WeddingAnniversary),
            FormatDate(proposed.WeddingAnniversary));
        AddIfChanged(result, "Address", worker.Address, proposed.Address);
        AddIfChanged(result, "Profession",
            worker.Profession, proposed.Profession);
        AddIfChanged(result, "Organization",
            worker.Organization, proposed.Organization);
        AddIfChanged(result, "Date Joined Church",
            FormatDate(worker.DateJoinedChurch),
            FormatDate(proposed.DateJoinedChurch));
        AddIfChanged(result, "Worker Status",
            worker.WorkerStatus, proposed.WorkerStatus);
        AddIfChanged(result, "Previous Church",
            worker.PreviousChurch, proposed.PreviousChurch);
        AddIfChanged(result, "Previous Church Role",
            worker.PreviousChurchRole, proposed.PreviousChurchRole);
        AddIfChanged(result, "Previous Church Unit",
            worker.PreviousChurchUnit, proposed.PreviousChurchUnit);
        AddIfChanged(result, "Ordination Status",
            worker.OrdinationStatus, proposed.OrdinationStatus);
        AddIfChanged(result, "Ordination Level",
            worker.OrdinationLevel, proposed.OrdinationLevel);
        AddIfChanged(result, "Last Ordination Date",
            FormatDate(worker.LastOrdinationDate),
            FormatDate(proposed.LastOrdinationDate));

        AddIfChanged(result, "Believer Baptism",
            YesNo(worker.HasBelieverBaptism),
            YesNo(proposed.HasBelieverBaptism));
        AddIfChanged(result, "Worker in Training",
            YesNo(worker.HasWorkerInTraining),
            YesNo(proposed.HasWorkerInTraining));
        AddIfChanged(result, "School of Disciples",
            YesNo(worker.HasSOD),
            YesNo(proposed.HasSOD));
        AddIfChanged(result, "Bible College",
            YesNo(worker.HasBibleCollege),
            YesNo(proposed.HasBibleCollege));

        if (!string.IsNullOrWhiteSpace(proposed.PassportPhotoPath) &&
            !string.Equals(worker.PassportPhotoPath,
                proposed.PassportPhotoPath,
                StringComparison.OrdinalIgnoreCase))
        {
            result.Add(new ChangeDisplay(
                "Passport Photograph",
                string.IsNullOrWhiteSpace(worker.PassportPhotoPath)
                    ? "Not uploaded"
                    : "Existing photograph",
                "New photograph uploaded"));
        }

        return result;
    }

    private static void AddIfChanged(
        List<ChangeDisplay> list,
        string label,
        string? currentValue,
        string? proposedValue)
    {
        var current = Normalize(currentValue);
        var proposed = Normalize(proposedValue);

        if (string.Equals(
            current,
            proposed,
            StringComparison.OrdinalIgnoreCase))
            return;

        list.Add(new ChangeDisplay(
            label,
            DisplayValue(currentValue),
            DisplayValue(proposedValue)));
    }

    private static string Normalize(string? value) =>
        value?.Trim() ?? string.Empty;

    private static string DisplayValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();

    private static string FormatDate(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd MMM yyyy") : string.Empty;

    private static string YesNo(bool value) =>
        value ? "Yes" : "No";

    private sealed record ChangeDisplay(
        string Label,
        string CurrentValue,
        string ProposedValue);
}

