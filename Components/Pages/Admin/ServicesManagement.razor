@page "/admin/services"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services

@inject ExcuseService ExcuseService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Service Management - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access Service Management.</p>
        <a href="/login" class="bcc-btn bcc-btn-primary">Go to Login</a>
    </div>
}
else if (!isAuthorized)
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>
        <p>Service Management is available to authorised church leadership and administrators.</p>
        <a href="/" class="bcc-btn bcc-btn-primary">Return to Dashboard</a>
    </div>
}
else
{
    <div class="worker360-page service-management-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage) && !showServiceModal)
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        <div class="bcc-page-header service-management-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-calendar-check me-2"></i>
                    Worker Management
                </div>
                <div class="bcc-page-title">Service Management</div>
                <div class="bcc-page-subtitle">
                    Create and manage church services, schedules and worker attendance windows.
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        @onclick="GoBack">
                    <i class="fas fa-arrow-left me-2"></i>
                    Back
                </button>

                <button type="button"
                        class="bcc-btn bcc-btn-primary compact-btn"
                        @onclick="ShowAddServiceModal">
                    <i class="fas fa-plus me-2"></i>
                    Add Service
                </button>
            </div>
        </div>

        <div class="row g-3 align-items-start">
            <div class="col-12 col-xl-4">
                <div class="bcc-card service-filter-card">
                    <div class="service-panel-header">
                        <div class="service-panel-icon">
                            <i class="fas fa-filter"></i>
                        </div>
                        <div>
                            <h6>Service Filters</h6>
                            <p>Summary and search controls.</p>
                        </div>
                    </div>

                    <div class="bcc-card-body p-3">
                        <div class="service-summary-grid mb-3">
                            <div>
                                <span>Total</span>
                                <strong>@allServices.Count</strong>
                            </div>
                            <div class="active">
                                <span>Active</span>
                                <strong>@allServices.Count(x => x.IsActive)</strong>
                            </div>
                            <div class="attendance">
                                <span>Attendance</span>
                                <strong>@allServices.Count(x => x.EnableWorkerAttendance)</strong>
                            </div>
                            <div class="result">
                                <span>Filtered</span>
                                <strong>@filteredServices.Count</strong>
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-12 col-md-6 col-xl-12">
                                <label class="form-label compact-label">Status</label>
                                <select value="@selectedStatusFilter"
                                        @onchange='@(e => OnFilterChanged(e, "status"))'
                                        class="form-select form-select-sm">
                                    <option value="all">All Services</option>
                                    <option value="active">Active Only</option>
                                    <option value="inactive">Inactive Only</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-6 col-xl-12">
                                <label class="form-label compact-label">Recurrence</label>
                                <select value="@selectedRecurrenceFilter"
                                        @onchange='@(e => OnFilterChanged(e, "recurrence"))'
                                        class="form-select form-select-sm">
                                    <option value="all">All Types</option>
                                    <option value="Weekly">Weekly</option>
                                    <option value="Monthly">Monthly</option>
                                    <option value="OneTime">One Time</option>
                                </select>
                            </div>
                        </div>

                        <div class="mt-3 d-flex justify-content-end gap-2">
                            <button type="button"
                                    class="bcc-btn profile-form-secondary-btn compact-btn"
                                    @onclick="ResetFilters">
                                <i class="fas fa-rotate-left me-1"></i>
                                Reset
                            </button>
                            <button type="button"
                                    class="bcc-btn bcc-btn-primary compact-btn"
                                    @onclick="ShowAddServiceModal">
                                <i class="fas fa-plus me-1"></i>
                                Add
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-8">
                <div class="bcc-card service-list-card">
                    <div class="service-list-header">
                        <div>
                            <h6>
                                <i class="fas fa-list me-2"></i>
                                Service Register
                            </h6>
                            <p>@filteredServices.Count service(s) match the current filters.</p>
                        </div>
                        <span class="service-result-count">@filteredServices.Count</span>
                    </div>

                    <div class="bcc-card-body p-0">
                        @if (filteredServices.Any())
                        {
                            <div class="service-list">
                                @foreach (var service in filteredServices)
                                {
                                    <div class="service-row @(service.IsActive ? "" : "inactive-row")">
                                        <div class="service-row-main">
                                            <div class="service-row-icon">
                                                <i class="fas fa-calendar-day"></i>
                                            </div>

                                            <div class="service-row-content">
                                                <div class="service-row-title">
                                                    <strong>@service.Name</strong>
                                                    <span class="service-type-badge">@service.RecurrencePattern</span>

                                                    @if (service.EnableWorkerAttendance)
                                                    {
                                                        <span class="attendance-badge">
                                                            <i class="fas fa-location-dot"></i>
                                                            Worker Attendance
                                                        </span>
                                                    }
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(service.Description))
                                                {
                                                    <p>@service.Description</p>
                                                }

                                                <div class="service-row-meta">
                                                    <span>
                                                        <i class="fas fa-calendar"></i>
                                                        @GetServiceScheduleDisplay(service)
                                                    </span>
                                                    <span>
                                                        <i class="fas fa-clock"></i>
                                                        @GetServiceTimeDisplay(service)
                                                    </span>
                                                    @if (service.EnableWorkerAttendance)
                                                    {
                                                        <span>
                                                            <i class="fas fa-right-to-bracket"></i>
                                                            Opens @service.AttendanceOpenMinutesBefore min before
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <div class="service-row-side">
                                            <span class="service-status-badge @(service.IsActive ? "active" : "inactive")">
                                                <i class="fas @(service.IsActive ? "fa-circle-check" : "fa-circle-pause")"></i>
                                                @(service.IsActive ? "Active" : "Inactive")
                                            </span>

                                            <div class="service-row-actions">
                                                <button type="button"
                                                        class="service-action-btn edit"
                                                        title="Edit service"
                                                        @onclick="() => EditService(service)">
                                                    <i class="fas fa-pen"></i>
                                                </button>

                                                @if (service.IsActive)
                                                {
                                                    <button type="button"
                                                            class="service-action-btn deactivate"
                                                            title="Deactivate service"
                                                            @onclick="() => DeactivateService(service)">
                                                        <i class="fas fa-pause"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            class="service-action-btn activate"
                                                            title="Activate service"
                                                            @onclick="() => ActivateService(service)">
                                                        <i class="fas fa-play"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="bcc-empty py-4">
                                <i class="fas fa-calendar-xmark"></i>
                                <h4>No Services Found</h4>
                                <p>No service matches the current filters.</p>
                                <button type="button"
                                        class="bcc-btn bcc-btn-primary compact-btn"
                                        @onclick="ResetFilters">
                                    Reset Filters
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (showServiceModal)
{
    <div class="service-modal-backdrop" @onclick="CloseServiceModal">
        <div class="service-modal-card" @onclick:stopPropagation="true">

            <div class="service-modal-header">
                <div>
                    <div class="modal-eyebrow">
                        <i class="fas fa-calendar-check me-2"></i>
                        Service Configuration
                    </div>
                    <h4>@(editingService ? "Edit Service" : "Add Service")</h4>
                    <p>Configure the service, schedule and worker attendance options.</p>
                </div>

                <button type="button"
                        class="btn-close"
                        aria-label="Close"
                        @onclick="CloseServiceModal">
                </button>
            </div>

            <EditForm Model="@serviceModel" OnValidSubmit="@SaveService">
                <DataAnnotationsValidator />

                <div class="service-modal-body">

                    <div class="form-section">
                        <div class="form-section-heading">
                            <div class="form-section-icon">
                                <i class="fas fa-circle-info"></i>
                            </div>
                            <div>
                                <h6>Service Information</h6>
                                <p>Basic information that identifies the service.</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label compact-label">
                                    Service Name <span class="text-danger">*</span>
                                </label>
                                <InputText @bind-Value="serviceModel.Name"
                                           class="form-control form-control-sm"
                                           placeholder="e.g. Sunday Service" />
                                <ValidationMessage For="@(() => serviceModel.Name)"
                                                   class="text-danger small" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label compact-label">
                                    Recurrence Pattern <span class="text-danger">*</span>
                                </label>
                                <InputSelect @bind-Value="serviceModel.RecurrencePattern"
                                             class="form-select form-select-sm">
                                    <option value="OneTime">One Time</option>
                                    <option value="Weekly">Weekly</option>
                                    <option value="Monthly">Monthly</option>
                                </InputSelect>
                            </div>

                            <div class="col-12">
                                <label class="form-label compact-label">Description</label>
                                <InputTextArea @bind-Value="serviceModel.Description"
                                               class="form-control form-control-sm"
                                               rows="2"
                                               placeholder="Brief description of the service" />
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="form-section-heading">
                            <div class="form-section-icon schedule">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div>
                                <h6>Service Schedule</h6>
                                <p>Define when this service takes place.</p>
                            </div>
                        </div>

                        @if (serviceModel.RecurrencePattern == "OneTime")
                        {
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label compact-label">
                                        Service Date <span class="text-danger">*</span>
                                    </label>
                                    <InputDate @bind-Value="serviceModel.SpecificDate"
                                               class="form-control form-control-sm" />
                                </div>

                                <div class="col-12 col-md-6"></div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label compact-label">Start Time</label>
                                    <div class="time-picker-12h">
                                        <select class="form-select form-select-sm" @bind="specificStartHour">
                                            @foreach (var hour in Hours12)
                                            {
                                                <option value="@hour">@hour.ToString("00")</option>
                                            }
                                        </select>
                                        <span class="time-separator">:</span>
                                        <select class="form-select form-select-sm" @bind="specificStartMinute">
                                            @foreach (var minute in Minutes)
                                            {
                                                <option value="@minute">@minute.ToString("00")</option>
                                            }
                                        </select>
                                        <select class="form-select form-select-sm period-select" @bind="specificStartPeriod">
                                            <option value="AM">AM</option>
                                            <option value="PM">PM</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label compact-label">End Time</label>
                                    <div class="time-picker-12h">
                                        <select class="form-select form-select-sm" @bind="specificEndHour">
                                            @foreach (var hour in Hours12)
                                            {
                                                <option value="@hour">@hour.ToString("00")</option>
                                            }
                                        </select>
                                        <span class="time-separator">:</span>
                                        <select class="form-select form-select-sm" @bind="specificEndMinute">
                                            @foreach (var minute in Minutes)
                                            {
                                                <option value="@minute">@minute.ToString("00")</option>
                                            }
                                        </select>
                                        <select class="form-select form-select-sm period-select" @bind="specificEndPeriod">
                                            <option value="AM">AM</option>
                                            <option value="PM">PM</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                @if (serviceModel.RecurrencePattern == "Weekly")
                                {
                                    <div class="col-12 col-md-6">
                                        <label class="form-label compact-label">Day of Week</label>
                                        <InputSelect @bind-Value="dayOfWeekString"
                                                     class="form-select form-select-sm">
                                            <option value="0">Sunday</option>
                                            <option value="1">Monday</option>
                                            <option value="2">Tuesday</option>
                                            <option value="3">Wednesday</option>
                                            <option value="4">Thursday</option>
                                            <option value="5">Friday</option>
                                            <option value="6">Saturday</option>
                                        </InputSelect>
                                    </div>
                                    <div class="col-12 col-md-6"></div>
                                }

                              @if (serviceModel.RecurrencePattern == "Monthly")
{
    <div class="col-12 col-md-6">
        <label class="form-label compact-label">Week of Month</label>
        <InputSelect TValue="int?"
                     @bind-Value="serviceModel.WeekOfMonth"
                     class="form-select form-select-sm">
            <option value="">-- Select Week --</option>
            <option value="1">First Week</option>
            <option value="2">Second Week</option>
            <option value="3">Third Week</option>
            <option value="4">Fourth Week</option>
            <option value="5">Last Week</option>
        </InputSelect>
    </div>

                                    <div class="col-12 col-md-6">
                                        <label class="form-label compact-label">Day of Week</label>
                                        <InputSelect @bind-Value="dayOfWeekString"
                                                     class="form-select form-select-sm">
                                            <option value="0">Sunday</option>
                                            <option value="1">Monday</option>
                                            <option value="2">Tuesday</option>
                                            <option value="3">Wednesday</option>
                                            <option value="4">Thursday</option>
                                            <option value="5">Friday</option>
                                            <option value="6">Saturday</option>
                                        </InputSelect>
                                    </div>
                                }

                                <div class="col-12 col-md-6">
                                    <label class="form-label compact-label">Start Time</label>
                                    <div class="time-picker-12h">
                                        <select class="form-select form-select-sm" @bind="startHour">
                                            @foreach (var hour in Hours12)
                                            {
                                                <option value="@hour">@hour.ToString("00")</option>
                                            }
                                        </select>
                                        <span class="time-separator">:</span>
                                        <select class="form-select form-select-sm" @bind="startMinute">
                                            @foreach (var minute in Minutes)
                                            {
                                                <option value="@minute">@minute.ToString("00")</option>
                                            }
                                        </select>
                                        <select class="form-select form-select-sm period-select" @bind="startPeriod">
                                            <option value="AM">AM</option>
                                            <option value="PM">PM</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label compact-label">End Time</label>
                                    <div class="time-picker-12h">
                                        <select class="form-select form-select-sm" @bind="endHour">
                                            @foreach (var hour in Hours12)
                                            {
                                                <option value="@hour">@hour.ToString("00")</option>
                                            }
                                        </select>
                                        <span class="time-separator">:</span>
                                        <select class="form-select form-select-sm" @bind="endMinute">
                                            @foreach (var minute in Minutes)
                                            {
                                                <option value="@minute">@minute.ToString("00")</option>
                                            }
                                        </select>
                                        <select class="form-select form-select-sm period-select" @bind="endPeriod">
                                            <option value="AM">AM</option>
                                            <option value="PM">PM</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="form-section">
                        <div class="form-section-heading">
                            <div class="form-section-icon attendance">
                                <i class="fas fa-location-dot"></i>
                            </div>
                            <div>
                                <h6>Worker Attendance</h6>
                                <p>Configure attendance availability, clocking windows and monthly attendance scoring.</p>
                            </div>
                        </div>

                        <div class="option-card mb-3">
                            <div>
                                <strong>Enable Worker Attendance</strong>
                                <span>Workers will be able to select this service when attendance is open.</span>
                            </div>
                            <div class="form-check form-switch m-0">
                                <InputCheckbox @bind-Value="serviceModel.EnableWorkerAttendance"
                                               class="form-check-input" />
                            </div>
                        </div>

                        @if (serviceModel.EnableWorkerAttendance)
                        {
                            <div class="attendance-settings-box mb-3">
                                <div class="attendance-subheading">
                                    <i class="fas fa-clock me-2"></i>
                                    Attendance Window
                                </div>

                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label compact-label">Clock-in Opens Before Service</label>
                                        <div class="input-group input-group-sm">
                                            <InputNumber TValue="int"
                                                         @bind-Value="serviceModel.AttendanceOpenMinutesBefore"
                                                         class="form-control" />
                                            <span class="input-group-text">minutes</span>
                                        </div>
                                        <div class="field-help">How early workers may clock in.</div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label class="form-label compact-label">Clock-in Closes After Start</label>
                                        <div class="input-group input-group-sm">
                                            <InputNumber TValue="int"
                                                         @bind-Value="serviceModel.AttendanceCloseMinutesAfterStart"
                                                         class="form-control" />
                                            <span class="input-group-text">minutes</span>
                                        </div>
                                        <div class="field-help">How long clock-in remains available after service starts.</div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label class="form-label compact-label">Clock-out Closes After Service</label>
                                        <div class="input-group input-group-sm">
                                            <InputNumber TValue="int"
                                                         @bind-Value="serviceModel.ClockOutCloseMinutesAfterEnd"
                                                         class="form-control" />
                                            <span class="input-group-text">minutes</span>
                                        </div>
                                        <div class="field-help">How long workers may still clock out after the service ends.</div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label class="form-label compact-label">Monthly Weight</label>
                                        <div class="input-group input-group-sm">
                                            <InputNumber TValue="decimal"
                                                         @bind-Value="serviceModel.AttendanceMonthlyWeight"
                                                         class="form-control" />
                                            <span class="input-group-text">%</span>
                                        </div>
                                        <div class="field-help">Sunday 40%, Midweek 20%, Communion 20%, Prayer Rain 20%.</div>
                                    </div>
                                </div>
                            </div>

                            <div class="attendance-settings-box mb-3">
                                <div class="attendance-subheading">
                                    <i class="fas fa-star me-2"></i>
                                    Attendance Points
                                </div>

                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label compact-label">Full / Intermediate / Late Score</label>
                                        <div class="score-input-grid">
                                            <div>
                                                <InputNumber TValue="int" @bind-Value="serviceModel.AttendanceFullScore" class="form-control form-control-sm" />
                                                <span>Full</span>
                                            </div>
                                            <div>
                                                <InputNumber TValue="int" @bind-Value="serviceModel.AttendanceIntermediateScore" class="form-control form-control-sm" />
                                                <span>Intermediate</span>
                                            </div>
                                            <div>
                                                <InputNumber TValue="int" @bind-Value="serviceModel.AttendanceLateScore" class="form-control form-control-sm" />
                                                <span>Late</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6 d-flex align-items-end">
                                        <div class="field-help scoring-help mb-1">
                                            These are the raw points awarded from clock-in time. The normal values are 20, 10 and 2.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="attendance-settings-box mb-3">
                                <div class="attendance-subheading">
                                    <i class="fas fa-user-check me-2"></i>
                                    Worker / General Timing
                                </div>

                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label compact-label">Full Score Cut-off</label>
                                        <div class="time-picker-12h">
                                            <select class="form-select form-select-sm" @bind="workerFullHour">
                                                @foreach (var hour in Hours12)
                                                {
                                                    <option value="@hour">@hour.ToString("00")</option>
                                                }
                                            </select>
                                            <span class="time-separator">:</span>
                                            <select class="form-select form-select-sm" @bind="workerFullMinute">
                                                @foreach (var minute in Minutes)
                                                {
                                                    <option value="@minute">@minute.ToString("00")</option>
                                                }
                                            </select>
                                            <select class="form-select form-select-sm period-select" @bind="workerFullPeriod">
                                                <option value="AM">AM</option>
                                                <option value="PM">PM</option>
                                            </select>
                                        </div>
                                        <div class="field-help">Arrival at or before this time receives the full score.</div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label class="form-label compact-label">Intermediate Score Cut-off</label>
                                        <div class="time-picker-12h">
                                            <select class="form-select form-select-sm" @bind="workerIntermediateHour">
                                                @foreach (var hour in Hours12)
                                                {
                                                    <option value="@hour">@hour.ToString("00")</option>
                                                }
                                            </select>
                                            <span class="time-separator">:</span>
                                            <select class="form-select form-select-sm" @bind="workerIntermediateMinute">
                                                @foreach (var minute in Minutes)
                                                {
                                                    <option value="@minute">@minute.ToString("00")</option>
                                                }
                                            </select>
                                            <select class="form-select form-select-sm period-select" @bind="workerIntermediatePeriod">
                                                <option value="AM">AM</option>
                                                <option value="PM">PM</option>
                                            </select>
                                        </div>
                                        <div class="field-help">Arrival after this time receives the late score.</div>
                                    </div>
                                </div>
                            </div>

                            <div class="option-card mb-3">
                                <div>
                                    <strong>Use Separate Leader Timing</strong>
                                    <span>Enable this only where leaders have different attendance cut-off times.</span>
                                </div>
                                <div class="form-check form-switch m-0">
                                    <InputCheckbox @bind-Value="serviceModel.UseSeparateLeaderScoring"
                                                   class="form-check-input" />
                                </div>
                            </div>

                            @if (serviceModel.UseSeparateLeaderScoring)
                            {
                                <div class="attendance-settings-box">
                                    <div class="attendance-subheading">
                                        <i class="fas fa-user-tie me-2"></i>
                                        Leader Timing
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-12 col-md-6">
                                            <label class="form-label compact-label">Full Score Cut-off</label>
                                            <div class="time-picker-12h">
                                                <select class="form-select form-select-sm" @bind="leaderFullHour">
                                                    @foreach (var hour in Hours12)
                                                    {
                                                        <option value="@hour">@hour.ToString("00")</option>
                                                    }
                                                </select>
                                                <span class="time-separator">:</span>
                                                <select class="form-select form-select-sm" @bind="leaderFullMinute">
                                                    @foreach (var minute in Minutes)
                                                    {
                                                        <option value="@minute">@minute.ToString("00")</option>
                                                    }
                                                </select>
                                                <select class="form-select form-select-sm period-select" @bind="leaderFullPeriod">
                                                    <option value="AM">AM</option>
                                                    <option value="PM">PM</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <label class="form-label compact-label">Intermediate Score Cut-off</label>
                                            <div class="time-picker-12h">
                                                <select class="form-select form-select-sm" @bind="leaderIntermediateHour">
                                                    @foreach (var hour in Hours12)
                                                    {
                                                        <option value="@hour">@hour.ToString("00")</option>
                                                    }
                                                </select>
                                                <span class="time-separator">:</span>
                                                <select class="form-select form-select-sm" @bind="leaderIntermediateMinute">
                                                    @foreach (var minute in Minutes)
                                                    {
                                                        <option value="@minute">@minute.ToString("00")</option>
                                                    }
                                                </select>
                                                <select class="form-select form-select-sm period-select" @bind="leaderIntermediatePeriod">
                                                    <option value="AM">AM</option>
                                                    <option value="PM">PM</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="form-section mb-0">
                        <div class="form-section-heading">
                            <div class="form-section-icon status">
                                <i class="fas fa-toggle-on"></i>
                            </div>
                            <div>
                                <h6>Service Status</h6>
                                <p>Control whether this service is available throughout the application.</p>
                            </div>
                        </div>

                        <div class="option-card">
                            <div>
                                <strong>Active Service</strong>
                                <span>Inactive services remain in the register but are not available for normal use.</span>
                            </div>
                            <div class="form-check form-switch m-0">
                                <InputCheckbox @bind-Value="serviceModel.IsActive"
                                               class="form-check-input" />
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger py-2 mt-3 mb-0">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            @errorMessage
                        </div>
                    }
                </div>

                <div class="service-modal-footer">
                    <button type="button"
                            class="bcc-btn profile-form-secondary-btn compact-btn"
                            disabled="@isLoading"
                            @onclick="CloseServiceModal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="bcc-btn bcc-btn-primary compact-btn"
                            disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="fas fa-save me-2"></i>
                            <span>@(editingService ? "Update Service" : "Create Service")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<Service> allServices = new();
    private List<Service> filteredServices = new();
    private bool showServiceModal;
    private bool editingService;
    private bool isLoading;
    private ServiceModel serviceModel = new();
    private Service? currentService;

    private string selectedStatusFilter = "all";
    private string selectedRecurrenceFilter = "all";

    private readonly int[] Hours12 = Enumerable.Range(1, 12).ToArray();
    private readonly int[] Minutes = Enumerable.Range(0, 60).ToArray();

    private int startHour = 9;
    private int startMinute = 0;
    private string startPeriod = "AM";
    private int endHour = 10;
    private int endMinute = 0;
    private string endPeriod = "AM";

    private int specificStartHour = 9;
    private int specificStartMinute = 0;
    private string specificStartPeriod = "AM";
    private int specificEndHour = 10;
    private int specificEndMinute = 0;
    private string specificEndPeriod = "AM";
    private string dayOfWeekString = "0";

    // Worker attendance scoring time selectors
    private int workerFullHour = 6;
    private int workerFullMinute = 55;
    private string workerFullPeriod = "AM";
    private int workerIntermediateHour = 7;
    private int workerIntermediateMinute = 30;
    private string workerIntermediatePeriod = "AM";

    private int leaderFullHour = 6;
    private int leaderFullMinute = 45;
    private string leaderFullPeriod = "AM";
    private int leaderIntermediateHour = 7;
    private int leaderIntermediateMinute = 0;
    private string leaderIntermediatePeriod = "AM";

    private string errorMessage = string.Empty;
    private bool isAuthorized;

    protected override async Task OnInitializedAsync()
    {
        if (!IsUserAuthorizedForServiceManagement())
        {
            isAuthorized = false;
            return;
        }

        isAuthorized = true;
        await LoadServices();
    }

    private bool IsUserAuthorizedForServiceManagement()
    {
        if (!AuthService.IsAuthenticated || AuthService.CurrentWorker == null)
            return false;

        var role = AuthService.CurrentWorker.Role?.ToLowerInvariant() ?? string.Empty;

        if (role.Contains("church admin") ||
            role.Contains("pastor in charge") ||
            role.Contains("head of service") ||
            role.Contains("assistant head of service") ||
            role.Contains("asst head of service"))
        {
            return true;
        }

        return AuthService.CurrentWorker.CanAccessAdminPanel;
    }

    private async Task LoadServices()
    {
        try
        {
            allServices = await ExcuseService.GetAllServicesAsync();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading services: {ex.Message}";
        }
    }

    private void ApplyFilters()
    {
        var filtered = allServices.AsEnumerable();

        if (selectedStatusFilter == "active")
            filtered = filtered.Where(s => s.IsActive);
        else if (selectedStatusFilter == "inactive")
            filtered = filtered.Where(s => !s.IsActive);

        if (selectedRecurrenceFilter != "all")
            filtered = filtered.Where(s => s.RecurrencePattern == selectedRecurrenceFilter);

        filteredServices = filtered.ToList();
    }

    private void ResetFilters()
    {
        selectedStatusFilter = "all";
        selectedRecurrenceFilter = "all";
        ApplyFilters();
    }

    private string GetServiceScheduleDisplay(Service service)
    {
        if (service.RecurrencePattern == "Weekly")
            return $"Every {GetDayName(service.DayOfWeek)}";

        if (service.RecurrencePattern == "Monthly")
        {
            var weekDisplay = service.WeekOfMonth switch
            {
                1 => "First",
                2 => "Second",
                3 => "Third",
                4 => "Fourth",
                5 => "Last",
                _ => "Week " + service.WeekOfMonth
            };

            return $"{weekDisplay} {GetDayName(service.DayOfWeek)}";
        }

        if (service.RecurrencePattern == "OneTime")
            return service.SpecificDate?.ToString("MMM dd, yyyy") ?? "One Time";

        return service.RecurrencePattern;
    }

    private string GetDayName(DayOfWeek? dayOfWeek)
    {
        return dayOfWeek switch
        {
            DayOfWeek.Sunday => "Sun",
            DayOfWeek.Monday => "Mon",
            DayOfWeek.Tuesday => "Tue",
            DayOfWeek.Wednesday => "Wed",
            DayOfWeek.Thursday => "Thu",
            DayOfWeek.Friday => "Fri",
            DayOfWeek.Saturday => "Sat",
            _ => "Unknown"
        };
    }

    private void ShowAddServiceModal()
    {
        serviceModel = new ServiceModel
        {
            IsActive = true,
            RecurrencePattern = "OneTime",
            EnableWorkerAttendance = false,
            AttendanceOpenMinutesBefore = 60,
            AttendanceCloseMinutesAfterStart = 60,
            ClockOutCloseMinutesAfterEnd = 60,
            AttendanceMonthlyWeight = 0,
            UseSeparateLeaderScoring = false,
            AttendanceFullScore = 20,
            AttendanceIntermediateScore = 10,
            AttendanceLateScore = 2
        };

        editingService = false;
        currentService = null;
        showServiceModal = true;
        errorMessage = string.Empty;

        SetDefaultTimeSelectors();
        SetDefaultAttendanceScoringSelectors();
        dayOfWeekString = "0";
    }

    private void EditService(Service service)
    {
        currentService = service;

        serviceModel = new ServiceModel
        {
            Name = service.Name,
            Description = service.Description,
            RecurrencePattern = service.RecurrencePattern,
            WeekOfMonth = service.WeekOfMonth,
            StartTime = service.StartTime,
            EndTime = service.EndTime,
            SpecificDate = service.SpecificDate,
            SpecificStartTime = service.SpecificStartTime,
            SpecificEndTime = service.SpecificEndTime,
            IsActive = service.IsActive,
            EnableWorkerAttendance = service.EnableWorkerAttendance,
            AttendanceOpenMinutesBefore = service.AttendanceOpenMinutesBefore,
            AttendanceCloseMinutesAfterStart = service.AttendanceCloseMinutesAfterStart,
            ClockOutCloseMinutesAfterEnd = service.ClockOutCloseMinutesAfterEnd,
            AttendanceMonthlyWeight = service.AttendanceMonthlyWeight,
            UseSeparateLeaderScoring = service.UseSeparateLeaderScoring,
            WorkerFullScoreCutoff = service.WorkerFullScoreCutoff,
            WorkerIntermediateScoreCutoff = service.WorkerIntermediateScoreCutoff,
            LeaderFullScoreCutoff = service.LeaderFullScoreCutoff,
            LeaderIntermediateScoreCutoff = service.LeaderIntermediateScoreCutoff,
            AttendanceFullScore = service.AttendanceFullScore,
            AttendanceIntermediateScore = service.AttendanceIntermediateScore,
            AttendanceLateScore = service.AttendanceLateScore
        };

        dayOfWeekString = service.DayOfWeek.HasValue
            ? ((int)service.DayOfWeek.Value).ToString()
            : "0";

        SetTimeSelectors(service.StartTime, ref startHour, ref startMinute, ref startPeriod, 9, "AM");
        SetTimeSelectors(service.EndTime, ref endHour, ref endMinute, ref endPeriod, 10, "AM");
        SetTimeSelectors(service.SpecificStartTime, ref specificStartHour, ref specificStartMinute, ref specificStartPeriod, 9, "AM");
        SetTimeSelectors(service.SpecificEndTime, ref specificEndHour, ref specificEndMinute, ref specificEndPeriod, 10, "AM");

        SetTimeSelectors(service.WorkerFullScoreCutoff, ref workerFullHour, ref workerFullMinute, ref workerFullPeriod, 6, "AM");
        SetTimeSelectors(service.WorkerIntermediateScoreCutoff, ref workerIntermediateHour, ref workerIntermediateMinute, ref workerIntermediatePeriod, 7, "AM");
        SetTimeSelectors(service.LeaderFullScoreCutoff, ref leaderFullHour, ref leaderFullMinute, ref leaderFullPeriod, 6, "AM");
        SetTimeSelectors(service.LeaderIntermediateScoreCutoff, ref leaderIntermediateHour, ref leaderIntermediateMinute, ref leaderIntermediatePeriod, 7, "AM");

        editingService = true;
        showServiceModal = true;
        errorMessage = string.Empty;
    }

    private void CloseServiceModal()
    {
        showServiceModal = false;
        currentService = null;
        errorMessage = string.Empty;
    }

    private async Task SaveService()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            if (serviceModel.RecurrencePattern == "Monthly" &&
    !serviceModel.WeekOfMonth.HasValue)
{
    errorMessage = "Please select the week of the month for this monthly service.";
    return;
}
            if (serviceModel.EnableWorkerAttendance)
            {
                if (serviceModel.AttendanceOpenMinutesBefore < 0 ||
                    serviceModel.AttendanceCloseMinutesAfterStart < 0 ||
                    serviceModel.ClockOutCloseMinutesAfterEnd < 0)
                {
                    errorMessage = "Attendance time windows cannot contain negative values.";
                    return;
                }

                if (serviceModel.AttendanceMonthlyWeight < 0 || serviceModel.AttendanceMonthlyWeight > 100)
                {
                    errorMessage = "Monthly attendance weight must be between 0 and 100 percent.";
                    return;
                }

                if (serviceModel.AttendanceFullScore < 0 ||
                    serviceModel.AttendanceIntermediateScore < 0 ||
                    serviceModel.AttendanceLateScore < 0)
                {
                    errorMessage = "Attendance scores cannot contain negative values.";
                    return;
                }

                if (serviceModel.AttendanceFullScore < serviceModel.AttendanceIntermediateScore ||
                    serviceModel.AttendanceIntermediateScore < serviceModel.AttendanceLateScore)
                {
                    errorMessage = "Attendance scores should follow Full Score >= Intermediate Score >= Late Score.";
                    return;
                }

                serviceModel.WorkerFullScoreCutoff = ToTimeSpan(workerFullHour, workerFullMinute, workerFullPeriod);
                serviceModel.WorkerIntermediateScoreCutoff = ToTimeSpan(workerIntermediateHour, workerIntermediateMinute, workerIntermediatePeriod);

                if (serviceModel.WorkerIntermediateScoreCutoff < serviceModel.WorkerFullScoreCutoff)
                {
                    errorMessage = "Worker intermediate score cut-off cannot be earlier than the full score cut-off.";
                    return;
                }

                if (serviceModel.UseSeparateLeaderScoring)
                {
                    serviceModel.LeaderFullScoreCutoff = ToTimeSpan(leaderFullHour, leaderFullMinute, leaderFullPeriod);
                    serviceModel.LeaderIntermediateScoreCutoff = ToTimeSpan(leaderIntermediateHour, leaderIntermediateMinute, leaderIntermediatePeriod);

                    if (serviceModel.LeaderIntermediateScoreCutoff < serviceModel.LeaderFullScoreCutoff)
                    {
                        errorMessage = "Leader intermediate score cut-off cannot be earlier than the full score cut-off.";
                        return;
                    }
                }
                else
                {
                    serviceModel.LeaderFullScoreCutoff = null;
                    serviceModel.LeaderIntermediateScoreCutoff = null;
                }
            }

            serviceModel.StartTime = ToTimeSpan(startHour, startMinute, startPeriod);
            serviceModel.EndTime = ToTimeSpan(endHour, endMinute, endPeriod);
            serviceModel.SpecificStartTime = ToTimeSpan(specificStartHour, specificStartMinute, specificStartPeriod);
            serviceModel.SpecificEndTime = ToTimeSpan(specificEndHour, specificEndMinute, specificEndPeriod);

            var selectedDay = int.TryParse(dayOfWeekString, out var dayInt)
                ? (DayOfWeek)dayInt
                : DayOfWeek.Sunday;

            if (editingService && currentService != null)
            {
                currentService.Name = serviceModel.Name;
                currentService.Description = serviceModel.Description;
                currentService.RecurrencePattern = serviceModel.RecurrencePattern;
                currentService.DayOfWeek = selectedDay;
                currentService.WeekOfMonth = serviceModel.WeekOfMonth;
                currentService.StartTime = serviceModel.StartTime;
                currentService.EndTime = serviceModel.EndTime;
                currentService.SpecificDate = serviceModel.SpecificDate;
                currentService.SpecificStartTime = serviceModel.SpecificStartTime;
                currentService.SpecificEndTime = serviceModel.SpecificEndTime;
                currentService.IsActive = serviceModel.IsActive;
                currentService.EnableWorkerAttendance = serviceModel.EnableWorkerAttendance;
                currentService.AttendanceOpenMinutesBefore = serviceModel.AttendanceOpenMinutesBefore;
                currentService.AttendanceCloseMinutesAfterStart = serviceModel.AttendanceCloseMinutesAfterStart;
                currentService.ClockOutCloseMinutesAfterEnd = serviceModel.ClockOutCloseMinutesAfterEnd;
                currentService.AttendanceMonthlyWeight = serviceModel.AttendanceMonthlyWeight;
                currentService.UseSeparateLeaderScoring = serviceModel.UseSeparateLeaderScoring;
                currentService.WorkerFullScoreCutoff = serviceModel.WorkerFullScoreCutoff;
                currentService.WorkerIntermediateScoreCutoff = serviceModel.WorkerIntermediateScoreCutoff;
                currentService.LeaderFullScoreCutoff = serviceModel.LeaderFullScoreCutoff;
                currentService.LeaderIntermediateScoreCutoff = serviceModel.LeaderIntermediateScoreCutoff;
                currentService.AttendanceFullScore = serviceModel.AttendanceFullScore;
                currentService.AttendanceIntermediateScore = serviceModel.AttendanceIntermediateScore;
                currentService.AttendanceLateScore = serviceModel.AttendanceLateScore;
                currentService.LastUpdated = DateTime.UtcNow;

                await ExcuseService.UpdateServiceAsync(currentService);
            }
            else
            {
                var service = new Service
                {
                    Name = serviceModel.Name,
                    Description = serviceModel.Description,
                    RecurrencePattern = serviceModel.RecurrencePattern,
                    DayOfWeek = selectedDay,
                    WeekOfMonth = serviceModel.WeekOfMonth,
                    StartTime = serviceModel.StartTime,
                    EndTime = serviceModel.EndTime,
                    SpecificDate = serviceModel.SpecificDate,
                    SpecificStartTime = serviceModel.SpecificStartTime,
                    SpecificEndTime = serviceModel.SpecificEndTime,
                    IsActive = serviceModel.IsActive,
                    EnableWorkerAttendance = serviceModel.EnableWorkerAttendance,
                    AttendanceOpenMinutesBefore = serviceModel.AttendanceOpenMinutesBefore,
                    AttendanceCloseMinutesAfterStart = serviceModel.AttendanceCloseMinutesAfterStart,
                    ClockOutCloseMinutesAfterEnd = serviceModel.ClockOutCloseMinutesAfterEnd,
                    AttendanceMonthlyWeight = serviceModel.AttendanceMonthlyWeight,
                    UseSeparateLeaderScoring = serviceModel.UseSeparateLeaderScoring,
                    WorkerFullScoreCutoff = serviceModel.WorkerFullScoreCutoff,
                    WorkerIntermediateScoreCutoff = serviceModel.WorkerIntermediateScoreCutoff,
                    LeaderFullScoreCutoff = serviceModel.LeaderFullScoreCutoff,
                    LeaderIntermediateScoreCutoff = serviceModel.LeaderIntermediateScoreCutoff,
                    AttendanceFullScore = serviceModel.AttendanceFullScore,
                    AttendanceIntermediateScore = serviceModel.AttendanceIntermediateScore,
                    AttendanceLateScore = serviceModel.AttendanceLateScore,
                    CreatedDate = DateTime.UtcNow
                };

                await ExcuseService.CreateServiceAsync(service);
            }

            CloseServiceModal();
            await LoadServices();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving service: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeactivateService(Service service)
    {
        if (await ExcuseService.DeleteServiceAsync(service.Id))
            await LoadServices();
    }

    private async Task ActivateService(Service service)
    {
        service.IsActive = true;
        service.LastUpdated = DateTime.UtcNow;
        await ExcuseService.UpdateServiceAsync(service);
        await LoadServices();
    }

    private void OnFilterChanged(ChangeEventArgs e, string filterType)
    {
        var newValue = e.Value?.ToString() ?? "all";

        if (filterType == "status")
            selectedStatusFilter = newValue;
        else if (filterType == "recurrence")
            selectedRecurrenceFilter = newValue;

        ApplyFilters();
    }

    private string GetServiceTimeDisplay(Service service)
    {
        var start = service.RecurrencePattern == "OneTime"
            ? service.SpecificStartTime
            : service.StartTime;

        var end = service.RecurrencePattern == "OneTime"
            ? service.SpecificEndTime
            : service.EndTime;

        if (!start.HasValue)
            return "Time not set";

        return end.HasValue
            ? $"{FormatTime12Hour(start.Value)} - {FormatTime12Hour(end.Value)}"
            : FormatTime12Hour(start.Value);
    }

    private void SetDefaultTimeSelectors()
    {
        startHour = 9;
        startMinute = 0;
        startPeriod = "AM";
        endHour = 10;
        endMinute = 0;
        endPeriod = "AM";
        specificStartHour = 9;
        specificStartMinute = 0;
        specificStartPeriod = "AM";
        specificEndHour = 10;
        specificEndMinute = 0;
        specificEndPeriod = "AM";
    }

    private void SetDefaultAttendanceScoringSelectors()
    {
        workerFullHour = 6;
        workerFullMinute = 55;
        workerFullPeriod = "AM";

        workerIntermediateHour = 7;
        workerIntermediateMinute = 30;
        workerIntermediatePeriod = "AM";

        leaderFullHour = 6;
        leaderFullMinute = 45;
        leaderFullPeriod = "AM";

        leaderIntermediateHour = 7;
        leaderIntermediateMinute = 0;
        leaderIntermediatePeriod = "AM";
    }

    private void SetTimeSelectors(
        TimeSpan? time,
        ref int hour,
        ref int minute,
        ref string period,
        int defaultHour,
        string defaultPeriod)
    {
        if (!time.HasValue)
        {
            hour = defaultHour;
            minute = 0;
            period = defaultPeriod;
            return;
        }

        var hour24 = time.Value.Hours;
        minute = time.Value.Minutes;
        period = hour24 >= 12 ? "PM" : "AM";
        hour = hour24 % 12;

        if (hour == 0)
            hour = 12;
    }

    private TimeSpan ToTimeSpan(int hour, int minute, string period)
    {
        var hour24 = hour % 12;

        if (string.Equals(period, "PM", StringComparison.OrdinalIgnoreCase))
            hour24 += 12;

        return new TimeSpan(hour24, minute, 0);
    }

    private string FormatTime12Hour(TimeSpan time)
    {
        return DateTime.Today.Add(time).ToString("h:mm tt");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/workspace/worker-management");
    }
}

