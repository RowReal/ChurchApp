@page "/admin/verse-of-the-day"

@layout Components.Layout.MainLayout
@using ChurchApp.Models
@using ChurchApp.Services
@inject AuthService AuthService
@inject VerseOfTheDayService VerseService

<PageTitle>Verse of the Day - BCC ServiceHub</PageTitle>

@if (!CanManageVerses())
{
    <div class="alert alert-danger">
        You are not authorized to access this page.
    </div>
}
else
{
    <div class="notice-page">

        <div class="notice-page-header">
            <div>
                <span class="notice-kicker">
                    <i class="fas fa-book-open"></i>
                    Spiritual Content Centre
                </span>
                <h2>Verse of the Day</h2>
                <p>Create and manage daily Bible verses displayed on the dashboard.</p>
            </div>

            <button class="notice-primary-btn" @onclick="ShowCreateForm">
                <i class="fas fa-plus"></i>
                New Verse
            </button>
        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (showForm)
        {
            <div class="notice-form-card">
                <div class="notice-form-header">
                    <h5>@(isEditing ? "Edit Verse" : "Create New Verse")</h5>
                    <button class="notice-close-btn" @onclick="CancelForm">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <EditForm Model="@verseModel" OnValidSubmit="@SaveVerse">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Scripture Reference</label>
                            <InputText class="form-control notice-input"
                                       @bind-Value="verseModel.ScriptureReference"
                                       placeholder="Example: Ecclesiastes 9:10" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Display Date</label>
                            <InputDate class="form-control notice-input"
                                       @bind-Value="verseModel.DisplayDate" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Verse Text</label>
                            <InputTextArea class="form-control notice-input"
                                           @bind-Value="verseModel.VerseText"
                                           rows="4"
                                           placeholder="Enter the Bible verse text..." />
                        </div>

                        <div class="col-md-6">
                            <div class="notice-check">
                                <InputCheckbox @bind-Value="verseModel.IsActive" />
                                <span>Active</span>
                            </div>
                        </div>
                    </div>

                    <div class="notice-form-actions">
                        <button type="button" class="notice-secondary-btn" @onclick="CancelForm">
                            Cancel
                        </button>

                        <button type="submit" class="notice-primary-btn" disabled="@isSaving">
                            @(isEditing ? "Update Verse" : "Save Verse")
                        </button>
                    </div>
                </EditForm>
            </div>
        }

        <div class="notice-list-card">
            <div class="notice-list-header">
                <h5>All Verses</h5>
                <span>@verses.Count verse(s)</span>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                    <p class="text-muted mt-2">Loading verses...</p>
                </div>
            }
            else if (!verses.Any())
            {
                <div class="notice-empty">
                    <i class="fas fa-book-open"></i>
                    <h5>No verses yet</h5>
                    <p>Create your first verse of the day.</p>
                </div>
            }
            else
            {
                <div class="notice-table-wrapper">
                    <table class="table notice-table align-middle">
                        <thead>
                            <tr>
                                <th>Verse</th>
                                <th>Reference</th>
                                <th>Display Date</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var verse in verses)
                            {
                                <tr>
                                    <td>
                                        <div class="notice-title-cell">
                                            <div class="notice-type-icon notice-prayer">
                                                <i class="fas fa-book-open"></i>
                                            </div>
                                            <div>
                                                <strong>@TrimText(verse.VerseText)</strong>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="notice-type-badge notice-prayer">
                                            @verse.ScriptureReference
                                        </span>
                                    </td>

                                    <td>@verse.DisplayDate.ToString("dd MMM yyyy")</td>

                                    <td>
                                        @if (verse.IsActive)
                                        {
                                            <span class="notice-status active">Active</span>
                                        }
                                        else
                                        {
                                            <span class="notice-status inactive">Inactive</span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <button class="notice-action-btn edit" @onclick="() => EditVerse(verse)">
                                            <i class="fas fa-edit"></i>
                                        </button>

                                        <button class="notice-action-btn toggle" @onclick="() => ToggleVerse(verse.Id)">
                                            <i class="fas @(verse.IsActive ? "fa-eye-slash" : "fa-eye")"></i>
                                        </button>

                                        <button class="notice-action-btn delete" @onclick="() => DeleteVerse(verse.Id)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
}

@code {
    private List<VerseOfTheDay> verses = new();
    private VerseOfTheDay verseModel = new();

    private bool isLoading = true;
    private bool isSaving = false;
    private bool showForm = false;
    private bool isEditing = false;

    private string successMessage = "";
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadVerses();
    }

    private async Task LoadVerses()
    {
        try
        {
            isLoading = true;
            verses = await VerseService.GetAllVersesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading verses: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateForm()
    {
        verseModel = new VerseOfTheDay
        {
            DisplayDate = DateTime.Today,
            IsActive = true
        };

        isEditing = false;
        showForm = true;
        ClearMessages();
    }

    private void EditVerse(VerseOfTheDay verse)
    {
        verseModel = new VerseOfTheDay
        {
            Id = verse.Id,
            VerseText = verse.VerseText,
            ScriptureReference = verse.ScriptureReference,
            DisplayDate = verse.DisplayDate,
            IsActive = verse.IsActive,
            CreatedDate = verse.CreatedDate
        };

        isEditing = true;
        showForm = true;
        ClearMessages();
    }

    private async Task SaveVerse()
    {
        try
        {
            isSaving = true;
            ClearMessages();

            if (isEditing)
            {
                await VerseService.UpdateVerseAsync(verseModel);
                successMessage = "Verse updated successfully.";
            }
            else
            {
                await VerseService.CreateVerseAsync(verseModel);
                successMessage = "Verse created successfully.";
            }

            showForm = false;
            await LoadVerses();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving verse: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CancelForm()
    {
        showForm = false;
        verseModel = new VerseOfTheDay();
        ClearMessages();
    }

    private async Task ToggleVerse(int id)
    {
        try
        {
            await VerseService.ToggleActiveStatusAsync(id);
            successMessage = "Verse status updated.";
            await LoadVerses();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating verse status: {ex.Message}";
        }
    }

    private async Task DeleteVerse(int id)
    {
        try
        {
            await VerseService.DeleteVerseAsync(id);
            successMessage = "Verse deleted successfully.";
            await LoadVerses();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting verse: {ex.Message}";
        }
    }

    private bool CanManageVerses()
    {
        return AuthService.IsInRole("Church Admin") ||
               AuthService.IsInRole("Pastor in Charge") ||
               AuthService.CanAccessAdminPanel();
    }

    private string TrimText(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return "";
        }

        return text.Length <= 100 ? text : text.Substring(0, 100) + "...";
    }

    private void ClearMessages()
    {
        successMessage = "";
        errorMessage = "";
    }
}

<style>

/* BCC ServiceHub | Compact Green Brand | Presentation only */
.bcc-page-header, .notice-page-header, .bcc-green-hero {
    background: #145c39 !important;
    background-image: linear-gradient(110deg,#145c39 0%,#1c7548 100%) !important;
    color: #fff !important;
    border: 1px solid #105032 !important;
    border-radius: 5px !important;
    padding: 17px 21px !important;
    box-shadow: 0 5px 15px rgba(20,92,57,.13) !important;
    margin-bottom: 15px !important;
}
.bcc-page-header :is(.bcc-page-title,.bcc-page-subtitle,h1,h2,h3,p,span),
.notice-page-header :is(h1,h2,h3,p,span,.notice-kicker),
.bcc-green-hero :is(h1,h2,h3,p,span) {color:#fff !important;}
.bcc-page-header .bcc-page-title,.notice-page-header h2,.bcc-green-hero h2 {font-weight:800 !important;letter-spacing:-.025em;margin-bottom:4px !important;}
.bcc-page-header .bcc-page-subtitle,.notice-page-header p,.bcc-green-hero p {opacity:.91;}
.bcc-card,.card,.notice-form-card,.notice-list-card {border-radius:6px !important;border-color:#dce9e1 !important;box-shadow:0 3px 12px rgba(14,60,38,.055) !important;}
.bcc-card-body,.card-body {padding:14px !important;}
.bcc-card-header,.card-header,.notice-form-header,.notice-list-header {background:#eff8f2 !important;border-bottom:1px solid #dce9e1 !important;color:#174d31 !important;}
.bcc-btn-primary,.notice-primary-btn,.btn-primary,.btn-success {background:#197447 !important;border-color:#197447 !important;color:white !important;border-radius:5px !important;font-weight:700 !important;}
.bcc-btn-primary:hover,.notice-primary-btn:hover,.btn-primary:hover,.btn-success:hover {background:#105a36 !important;border-color:#105a36 !important;}
.bcc-page-header .bcc-btn,.notice-page-header .notice-primary-btn {background:#fff !important;color:#145c39 !important;border:1px solid #fff !important;}
.bcc-page-header .bcc-btn:hover,.notice-page-header .notice-primary-btn:hover {background:#e7f5ec !important;color:#0e492d !important;}
.form-control,.form-select,.notice-input {border-color:#cddfd2 !important;border-radius:5px !important;min-height:34px;}
.form-control:focus,.form-select:focus,.notice-input:focus {border-color:#31845a !important;box-shadow:0 0 0 .16rem rgba(49,132,90,.14) !important;}
.table thead th,table thead th {background:#eaf5ed !important;color:#145c39 !important;border-color:#d4e8db !important;font-size:.8rem;}
.table td,.table th {padding:8px 10px !important;vertical-align:middle;}
.form-label,label {font-size:.83rem;font-weight:600;}
.worker360-page,.notice-page {padding-top:8px;}
@@media (max-width: 767px) {
    .bcc-page-header,.notice-page-header,.bcc-green-hero {padding:14px 15px !important;}
    .bcc-card-body,.card-body {padding:11px !important;}
}

.notice-page {max-width:1400px;margin:0 auto;}.notice-page-header {display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;}.notice-page-header h2 {font-size:1.45rem !important;}.notice-form-card,.notice-list-card {background:#fff;border:1px solid #dce9e1;padding:15px;margin-bottom:14px;}.notice-form-header,.notice-list-header {padding:10px 12px;margin:-15px -15px 12px;}.notice-secondary-btn,.notice-action-btn {border:1px solid #b9d9c4;color:#145c39;background:#eff8f2;border-radius:5px;}.notice-close-btn {color:#145c39;}.notice-primary-btn {padding:8px 14px;}
</style>
