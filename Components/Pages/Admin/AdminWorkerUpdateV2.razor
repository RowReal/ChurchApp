    private async Task OnPassportPhotoChanged(
        InputFileChangeEventArgs e)
    {
        if (worker == null)
            return;

        try
        {
            isUploading = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            var file =
                e.File;

            var allowedExtensions =
                new[]
                {
                    ".jpg",
                    ".jpeg",
                    ".png"
                };

            var extension =
                Path.GetExtension(file.Name)
                    .ToLowerInvariant();

            if (!allowedExtensions.Contains(extension))
            {
                throw new Exception(
                    "Only JPG and PNG files are allowed.");
            }

            var folder =
                Environment.IsDevelopment()
                    ? Path.Combine(
                        Environment.ContentRootPath,
                        "wwwroot",
                        "uploads")
                    : "/var/data/uploads";

            Directory.CreateDirectory(folder);

            var fileName =
                $"{worker.WorkerId}_passport_" +
                $"{Guid.NewGuid()}.jpg";

            var filePath =
                Path.Combine(folder, fileName);

            using var image =
                await Image.LoadAsync(
                    file.OpenReadStream(
                        5 * 1024 * 1024));

            image.Mutate(x =>
                x.Resize(
                    new ResizeOptions
                    {
                        Size = new Size(800, 800),
                        Mode = ResizeMode.Max
                    }));

            await image.SaveAsJpegAsync(
                filePath,
                new JpegEncoder
                {
                    Quality = 75
                });

            var optimizedFileName =
                $"{Path.GetFileNameWithoutExtension(fileName)}_mobile.webp";

            var optimizedPath =
                Path.Combine(
                    folder,
                    optimizedFileName);

            await ImageOptimizationService
                .CreateMobileVersion(
                    filePath,
                    optimizedPath);

            workerModel.PassportPhotoPath =
                fileName;

            workerModel.PassportPhotoThumbPath =
                optimizedFileName;

            successMessage =
                "Photo uploaded successfully.";
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Error uploading photo: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task OnCertificateChanged(
        InputFileChangeEventArgs e,
        string certificateType)
    {
        if (worker == null)
            return;

        try
        {
            errorMessage = string.Empty;
            successMessage = string.Empty;

            var file =
                e.File;

            if (file.Size >
                5 * 1024 * 1024)
            {
                throw new Exception(
                    "File size must be less than 5MB.");
            }

            var allowedExtensions =
                new[]
                {
                    ".pdf",
                    ".jpg",
                    ".jpeg",
                    ".png",
                    ".doc",
                    ".docx"
                };

            var extension =
                Path.GetExtension(file.Name)
                    .ToLowerInvariant();

            if (!allowedExtensions.Contains(extension))
            {
                throw new Exception(
                    "Only PDF, JPG, PNG, DOC and DOCX files are allowed.");
            }

            var folder =
                Environment.IsDevelopment()
                    ? Path.Combine(
                        Environment.ContentRootPath,
                        "wwwroot",
                        "uploads")
                    : "/var/data/uploads";

            Directory.CreateDirectory(folder);

            var fileName =
                $"{worker.WorkerId}_" +
                $"{certificateType}_" +
                $"{Guid.NewGuid()}{extension}";

            var filePath =
                Path.Combine(folder, fileName);

            await using var stream =
                new FileStream(
                    filePath,
                    FileMode.Create);

            await file
                .OpenReadStream(
                    5 * 1024 * 1024)
                .CopyToAsync(stream);

            switch (certificateType)
            {
                case "believerBaptism":
                    believerBaptismPath =
                        fileName;
                    break;

                case "workerInTraining":
                    workerInTrainingPath =
                        fileName;
                    break;

                case "sod":
                    sodPath =
                        fileName;
                    break;

                case "bibleCollege":
                    bibleCollegePath =
                        fileName;
                    break;
            }

            successMessage =
                "Certificate uploaded successfully.";
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Error uploading certificate: {ex.Message}";
        }
    }

    private int CalculateCompliance(
        WorkerUpdateModel model)
    {
        var total = 0;
        var completed = 0;

        total++;
        if (!string.IsNullOrWhiteSpace(
            model.MaritalStatus))
        {
            completed++;
        }

        total++;
        if (model.WeddingAnniversary.HasValue)
        {
            completed++;
        }

        total++;
        if (!string.IsNullOrWhiteSpace(
            model.Address))
        {
            completed++;
        }

        total++;
        if (!string.IsNullOrWhiteSpace(
            model.Profession))
        {
            completed++;
        }

        total++;
        if (!string.IsNullOrWhiteSpace(
            model.Organization))
        {
            completed++;
        }

        total++;
        if (model.DateOfBirth.HasValue)
        {
            completed++;
        }

        total++;
        if (!string.IsNullOrWhiteSpace(
            model.PreviousChurch))
        {
            completed++;
        }

        total++;
        if (!string.IsNullOrWhiteSpace(
            model.PreviousChurchRole))
        {
            completed++;
        }

        total++;
        if (!string.IsNullOrWhiteSpace(
            model.PreviousChurchUnit))
        {
            completed++;
        }

        total++;
        if (model.DirectorateId.HasValue)
        {
            completed++;
        }

        total++;
        if (model.DepartmentId.HasValue)
        {
            completed++;
        }

        total++;
        if (model.UnitId.HasValue)
        {
            completed++;
        }

        total++;
        if (!string.IsNullOrWhiteSpace(
            model.Role))
        {
            completed++;
        }

        total++;
        if (model.SupervisorId.HasValue)
        {
            completed++;
        }

        total++;
        if (model.DateJoinedChurch.HasValue)
        {
            completed++;
        }

        total++;
        if (!string.IsNullOrWhiteSpace(
            model.WorkerStatus))
        {
            completed++;
        }

        total++;
        if (!string.IsNullOrWhiteSpace(
            model.OrdinationLevel))
        {
            completed++;
        }

        total++;
        if (model.LastOrdinationDate.HasValue)
        {
            completed++;
        }

        total++;
        if (model.HasBelieverBaptism)
        {
            completed++;
        }

        total++;
        if (model.HasWorkerInTraining)
        {
            completed++;
        }

        total++;
        if (model.HasSOD)
        {
            completed++;
        }

        total++;
        if (model.HasBibleCollege)
        {
            completed++;
        }

        return total == 0
            ? 0
            : completed * 100 / total;
    }

    private bool IsDirectorateLeadershipRole()
    {
