        DateTime? value)
    {
        return value?.ToString(
            "dd MMM yyyy") ?? "Not provided";
    }

    private static string GetComplianceClass(
        int percentage)
    {
        if (percentage < 50)
            return "bg-danger";

        if (percentage < 80)
            return "bg-warning";

        return "bg-success";
    }

