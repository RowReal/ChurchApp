@page "/admin/worker-update-form/{WorkerId:int}"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.Processing
@using SixLabors.ImageSharp.Formats.Jpeg

@inject WorkerService WorkerService
@inject RoleService RoleService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment
@inject ImageOptimizationService ImageOptimizationService

<PageTitle>Update Worker - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access this page.</p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else if (!AuthService.CanAccessAdminPanel())
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>
        <p>You do not have permission to update worker records.</p>

        <a href="/"
           class="bcc-btn bcc-btn-primary">
            Return to Dashboard
        </a>
    </div>
}
else if (isLoading)
{
    <div class="worker360-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-4">
                <div class="spinner-border text-primary"></div>

                <div class="mt-2 text-muted">
                    Loading worker data...
                </div>
            </div>
        </div>
    </div>
}
else if (worker == null)
{
    <div class="bcc-empty">
        <i class="fas fa-user-slash"></i>
        <h4>Worker Not Found</h4>
        <p>The worker record could not be found.</p>

        <button type="button"
                class="bcc-btn bcc-btn-primary"
                @onclick="NavigateBack">
            Back to Worker Details
        </button>
    </div>
}
else
{
    <EditForm Model="@workerModel"
              OnValidSubmit="@UpdateWorker">

        <DataAnnotationsValidator />

        <div class="worker360-page admin-update-page">

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success py-2">
                    <i class="fas fa-check-circle me-2"></i>
                    @successMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger py-2">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    @errorMessage
                </div>
            }

            <div class="bcc-page-header admin-update-header">
                <div>
                    <div class="bcc-page-subtitle">
                        <i class="fas fa-user-edit me-2"></i>
                        Administration
                    </div>

                    <div class="bcc-page-title">
                        Update Worker
                    </div>

                    <div class="bcc-page-subtitle">
                        Direct administrative update for
                        @worker.FirstName @worker.LastName
                        (@worker.WorkerId).
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="button"
                            class="bcc-btn profile-form-secondary-btn compact-btn"
                            @onclick="NavigateBack">
                        <i class="fas fa-arrow-left me-2"></i>
                        Back
                    </button>

                    <button type="submit"
                            class="bcc-btn bcc-btn-primary compact-btn"
                            disabled="@isUpdating">

                        @if (isUpdating)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <i class="fas fa-save me-2"></i>
                            <span>Save Changes</span>
                        }

                    </button>
                </div>
            </div>

            <div class="worker-update-summary mb-3">

                <div class="worker-update-person">

                    @if (!string.IsNullOrWhiteSpace(workerModel.PassportPhotoPath))
                    {
                        <img src="/uploads/@(workerModel.PassportPhotoThumbPath ?? workerModel.PassportPhotoPath)"
                             class="worker-update-photo"
                             alt="Worker photograph"
                             loading="lazy" />
                    }
                    else
                    {
                        <div class="worker-update-photo-placeholder">
                            <i class="fas fa-user"></i>
                        </div>
                    }

                    <div>
                        <h5>
                            @workerModel.FirstName @workerModel.LastName
                        </h5>

                        <div class="worker-update-meta">
                            <span>
                                <i class="fas fa-id-badge"></i>
                                @worker.WorkerId
                            </span>

                            <span>
                                <i class="fas fa-user-tag"></i>
                                @DisplayValue(workerModel.Role)
                            </span>

                            <span>
                                <i class="fas fa-building"></i>
                                @(worker.Directorate?.Name ?? "No Directorate")
                            </span>

                            <span>
                                <i class="fas fa-sitemap"></i>
                                @(worker.Department?.Name ?? "No Department")
                            </span>
                        </div>
                    </div>

                </div>

                <div class="worker-update-status-grid">

                    <div>
                        <span>Status</span>
                        <strong class="@(workerModel.IsActive ? "text-success" : "text-secondary")">
                            @(workerModel.IsActive ? "Active" : "Inactive")
                        </strong>
                    </div>

                    <div>
                        <span>Compliance</span>
                        <strong>@workerModel.CompliancePercentage%</strong>
                    </div>

                    <div>
                        <span>Role</span>
                        <strong>@DisplayValue(workerModel.Role)</strong>
                    </div>

                </div>

            </div>

            <div class="admin-update-tabs mb-3">

                <button type="button"
                        class="@GetTabClass("personal-professional")"
                        @onclick='() => SetTab("personal-professional")'>
                    <i class="fas fa-user"></i>
                    Personal & Professional
                </button>

                <button type="button"
                        class="@GetTabClass("church-assignment")"
                        @onclick='() => SetTab("church-assignment")'>
                    <i class="fas fa-church"></i>
                    Church & Assignment
                </button>

                <button type="button"
                        class="@GetTabClass("qualification-documents")"
                        @onclick='() => SetTab("qualification-documents")'>
                    <i class="fas fa-award"></i>
                    Qualifications & Documents
                </button>

                <button type="button"
                        class="@GetTabClass("status-actions")"
                        @onclick='() => SetTab("status-actions")'>
                    <i class="fas fa-bolt"></i>
                    Status & Actions
                </button>

            </div>

            @if (activeTab == "personal-professional")
            {
                <div class="row g-3">

                    <div class="col-12 col-xl-6">
                        <div class="bcc-card update-section-card h-100">
                            <div class="update-section-header">
                                <div class="update-section-icon personal">
                                    <i class="fas fa-user"></i>
                                </div>

                                <div>
                                    <h6>Personal Information</h6>
                                    <p>Identity and contact information.</p>
                                </div>
                            </div>

                            <div class="bcc-card-body p-3">
                                <div class="compact-form-grid">

                                    @Field(
                                        "First Name",
                                        worker.FirstName,
                                        @<InputText @bind-Value="workerModel.FirstName"
                                                    class="form-control form-control-sm" />,
                                        true)

                                    @Field(
                                        "Middle Name",
                                        worker.MiddleName,
                                        @<InputText @bind-Value="workerModel.MiddleName"
                                                    class="form-control form-control-sm" />)

                                    @Field(
                                        "Last Name",
                                        worker.LastName,
                                        @<InputText @bind-Value="workerModel.LastName"
                                                    class="form-control form-control-sm" />,
                                        true)

                                    @Field(
                                        "Sex",
                                        worker.Sex,
                                        @<select @bind="workerModel.Sex"
                                                 class="form-select form-select-sm">
                                            <option value="">Select</option>
                                            <option value="Male">Male</option>
                                            <option value="Female">Female</option>
                                            <option value="Other">Other</option>
                                        </select>)

                                    @Field(
                                        "Date of Birth",
                                        FormatDate(worker.DateOfBirth),
                                        @<InputDate @bind-Value="workerModel.DateOfBirth"
                                                    class="form-control form-control-sm" />)

                                    @Field(
                                        "Marital Status",
                                        worker.MaritalStatus,
                                        @<select @bind="workerModel.MaritalStatus"
                                                 class="form-select form-select-sm">
                                            <option value="Single">Single</option>
                                            <option value="Married">Married</option>
                                            <option value="Divorced">Divorced</option>
                                            <option value="Widowed">Widowed</option>
                                        </select>)

                                    @Field(
                                        "Wedding Anniversary",
                                        FormatDate(worker.WeddingAnniversary),
                                        @<InputDate @bind-Value="workerModel.WeddingAnniversary"
                                                    class="form-control form-control-sm"
                                                    disabled="@(workerModel.MaritalStatus == "Single")" />)

                                    @Field(
                                        "Email",
                                        worker.Email,
                                        @<InputText @bind-Value="workerModel.Email"
                                                    class="form-control form-control-sm" />)

                                    @Field(
                                        "Phone",
                                        worker.Phone,
                                        @<InputText @bind-Value="workerModel.Phone"
                                                    class="form-control form-control-sm" />)

                                    @Field(
                                        "Address",
                                        worker.Address,
                                        @<InputTextArea @bind-Value="workerModel.Address"
                                                        class="form-control form-control-sm"
                                                        rows="2" />,
                                        false,
                                        true)

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-6">
                        <div class="bcc-card update-section-card h-100">
                            <div class="update-section-header">
                                <div class="update-section-icon professional">
                                    <i class="fas fa-briefcase"></i>
                                </div>

                                <div>
                                    <h6>Professional & Previous Church</h6>
                                    <p>Employment and prior ministry experience.</p>
                                </div>
                            </div>

                            <div class="bcc-card-body p-3">
                                <div class="compact-form-grid">

                                    @Field(
                                        "Profession",
                                        worker.Profession,
                                        @<InputText @bind-Value="workerModel.Profession"
                                                    class="form-control form-control-sm" />)

                                    @Field(
                                        "Organisation",
                                        worker.Organization,
                                        @<InputText @bind-Value="workerModel.Organization"
                                                    class="form-control form-control-sm" />)

                                    @Field(
                                        "Previous Church",
                                        worker.PreviousChurch,
                                        @<InputText @bind-Value="workerModel.PreviousChurch"
                                                    class="form-control form-control-sm" />)

                                    @Field(
                                        "Previous Role",
                                        worker.PreviousChurchRole,
                                        @<InputText @bind-Value="workerModel.PreviousChurchRole"
                                                    class="form-control form-control-sm" />)

                                    @Field(
                                        "Previous Unit/Department",
                                        worker.PreviousChurchUnit,
                                        @<InputText @bind-Value="workerModel.PreviousChurchUnit"
                                                    class="form-control form-control-sm" />,
                                        false,
                                        true)

                                </div>

                                <div class="tab-footer">
                                    <span>
                                        Continue to church assignment.
                                    </span>

                                    <button type="button"
                                            class="bcc-btn bcc-btn-primary compact-btn"
                                            @onclick='() => SetTab("church-assignment")'>
                                        Next
                                        <i class="fas fa-arrow-right ms-2"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            }

            @if (activeTab == "church-assignment")
            {
                <div class="row g-3">

                    <div class="col-12 col-xl-7">
                        <div class="bcc-card update-section-card h-100">
                            <div class="update-section-header">
                                <div class="update-section-icon church">
                                    <i class="fas fa-sitemap"></i>
                                </div>

                                <div>
                                    <h6>Current Assignment</h6>
                                    <p>Primary, secondary and supervisory assignment.</p>
                                </div>
                            </div>

                            <div class="bcc-card-body p-3">
                                <div class="compact-form-grid">

                                    @Field(
                                        "Primary Directorate",
                                        worker.Directorate?.Name,
                                        @<select @bind="workerModel.DirectorateId"
                                                 @bind:after="OnDirectorateChanged"
                                                 class="form-select form-select-sm">
                                            <option value="">Select</option>

                                            @foreach (var directorate in directorates)
                                            {
                                                <option value="@directorate.Id">
                                                    @directorate.Name
                                                </option>
                                            }
                                        </select>)

                                    @Field(
                                        "Primary Department",
                                        worker.Department?.Name,
                                        @<select @bind="workerModel.DepartmentId"
                                                 @bind:after="OnDepartmentChanged"
                                                 class="form-select form-select-sm"
                                                 disabled="@(filteredDepartments.Count == 0 || IsDirectorateLeadershipRole())">
                                            <option value="">Select</option>

                                            @foreach (var department in filteredDepartments)
                                            {
                                                <option value="@department.Id">
                                                    @department.Name
                                                </option>
                                            }
                                        </select>)

                                    @Field(
                                        "Unit",
                                        worker.Unit?.Name,
                                        @<select @bind="workerModel.UnitId"
                                                 class="form-select form-select-sm"
                                                 disabled="@(filteredUnits.Count == 0)">
                                            <option value="">Select</option>

                                            @foreach (var unit in filteredUnits)
                                            {
                                                <option value="@unit.Id">
                                                    @unit.Name
                                                </option>
                                            }
                                        </select>)

                                    @Field(
                                        "Secondary Directorate",
                                        worker.SecondaryDirectorate?.Name,
                                        @<select @bind="workerModel.SecondaryDirectorateId"
                                                 @bind:after="OnSecondaryDirectorateChanged"
                                                 class="form-select form-select-sm">
                                            <option value="">None</option>

                                            @foreach (var directorate in directorates)
                                            {
                                                <option value="@directorate.Id">
                                                    @directorate.Name
                                                </option>
                                            }
                                        </select>)

                                    @Field(
                                        "Secondary Department",
                                        worker.SecondaryDepartment?.Name,
                                        @<select @bind="workerModel.SecondaryDepartmentId"
                                                 class="form-select form-select-sm"
                                                 disabled="@(filteredSecondaryDepartments.Count == 0)">
                                            <option value="">None</option>

                                            @foreach (var department in filteredSecondaryDepartments)
                                            {
                                                <option value="@department.Id">
                                                    @department.Name
                                                </option>
                                            }
                                        </select>)

                                    @Field(
                                        "Role",
                                        worker.Role,
                                        @<select @bind="workerModel.Role"
                                                 @bind:after="OnRoleChanged"
                                                 class="form-select form-select-sm">
                                            <option value="">Select Role</option>

                                            @foreach (var role in rolesFromDb)
                                            {
                                                <option value="@role.Name">
                                                    @role.Name
                                                </option>
                                            }
                                        </select>,
                                        true)

                                    @Field(
                                        "Supervisor",
                                        GetSupervisorName(worker),
                                        @<select @bind="workerModel.SupervisorId"
                                                 class="form-select form-select-sm">
                                            <option value="">Select Supervisor</option>

                                            @foreach (var candidate in GetSupervisorCandidates())
                                            {
                                                <option value="@candidate.Id">
                                                    @candidate.FirstName
                                                    @candidate.LastName
                                                    - @candidate.Role
                                                </option>
                                            }
                                        </select>)

                                    @Field(
                                        "Date Joined Church",
                                        FormatDate(worker.DateJoinedChurch),
                                        @<InputDate @bind-Value="workerModel.DateJoinedChurch"
                                                    class="form-control form-control-sm" />)

                                    @Field(
                                        "Worker Status",
                                        worker.WorkerStatus,
                                        @<select @bind="workerModel.WorkerStatus"
                                                 class="form-select form-select-sm">
                                            <option value="Temp Worker">Temp Worker</option>
                                            <option value="Full Worker">Full Worker</option>
                                            <option value="On Leave">On Leave</option>
                                            <option value="Inactive">Inactive</option>
                                        </select>)

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-5">
                        <div class="bcc-card update-section-card h-100">
                            <div class="update-section-header">
                                <div class="update-section-icon ordination">
                                    <i class="fas fa-hands-praying"></i>
                                </div>

                                <div>
                                    <h6>Ordination Information</h6>
                                    <p>Ordination level and latest date.</p>
                                </div>
                            </div>

                            <div class="bcc-card-body p-3">
                                <div class="compact-form-grid one-column">

                                    @Field(
                                        "Ordination Level",
                                        worker.OrdinationLevel,
                                        @<select @bind="workerModel.OrdinationLevel"
                                                 class="form-select form-select-sm">
                                            <option value="Not Ordained">Not Ordained</option>
                                            <option value="Deacon">Deacon</option>
                                            <option value="Deaconess">Deaconess</option>
                                            <option value="Asst Pastor">Asst Pastor</option>
                                            <option value="Pastor">Pastor</option>
                                        </select>)

                                    @Field(
                                        "Last Ordination Date",
                                        FormatDate(worker.LastOrdinationDate),
                                        @<InputDate @bind-Value="workerModel.LastOrdinationDate"
                                                    class="form-control form-control-sm" />)

                                </div>

                                <div class="assignment-note">
                                    <i class="fas fa-info-circle"></i>

                                    <span>
                                        Department is automatically cleared for Head of Directorate
                                        and Assistant Head of Directorate roles.
                                    </span>
                                </div>

                                <div class="tab-footer">
                                    <button type="button"
                                            class="bcc-btn profile-form-secondary-btn compact-btn"
                                            @onclick='() => SetTab("personal-professional")'>
                                        <i class="fas fa-arrow-left me-2"></i>
                                        Previous
                                    </button>

                                    <button type="button"
                                            class="bcc-btn bcc-btn-primary compact-btn"
                                            @onclick='() => SetTab("qualification-documents")'>
                                        Next
                                        <i class="fas fa-arrow-right ms-2"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            }

            @if (activeTab == "qualification-documents")
            {
                <div class="row g-3">

                    <div class="col-12 col-xl-7">
                        <div class="bcc-card update-section-card h-100">
                            <div class="update-section-header">
                                <div class="update-section-icon qualification">
                                    <i class="fas fa-certificate"></i>
                                </div>

                                <div>
                                    <h6>Qualifications & Certificates</h6>
                                    <p>Select completed programmes and upload certificates.</p>
                                </div>
                            </div>

                            <div class="bcc-card-body p-3">
                                <div class="qualification-update-grid">

                                    @QualificationUpload(
                                        "Believer's Baptism",
                                        workerModel.HasBelieverBaptism,
                                        "HasBelieverBaptism",
                                        believerBaptismPath,
                                        "believerBaptism")

                                    @QualificationUpload(
                                        "Worker in Training",
                                        workerModel.HasWorkerInTraining,
                                        "HasWorkerInTraining",
                                        workerInTrainingPath,
                                        "workerInTraining")

                                    @QualificationUpload(
                                        "School of Discipleship",
                                        workerModel.HasSOD,
                                        "HasSOD",
                                        sodPath,
                                        "sod")

                                    @QualificationUpload(
                                        "Bible College",
                                        workerModel.HasBibleCollege,
                                        "HasBibleCollege",
                                        bibleCollegePath,
                                        "bibleCollege")

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-5">
                        <div class="bcc-card update-section-card h-100">
                            <div class="update-section-header">
                                <div class="update-section-icon document">
                                    <i class="fas fa-camera"></i>
                                </div>

                                <div>
                                    <h6>Passport Photo</h6>
                                    <p>Upload or replace the worker photograph.</p>
                                </div>
                            </div>

                            <div class="bcc-card-body p-3">
                                <div class="passport-upload-panel">

                                    @if (!string.IsNullOrWhiteSpace(workerModel.PassportPhotoPath))
                                    {
                                        <img src="/uploads/@(workerModel.PassportPhotoThumbPath ?? workerModel.PassportPhotoPath)"
                                             class="passport-preview"
                                             alt="Passport photograph" />
                                    }
                                    else
                                    {
                                        <div class="passport-preview-placeholder">
                                            <i class="fas fa-user"></i>
                                        </div>
                                    }

                                    <div class="passport-upload-content">
                                        <label class="form-label compact-label">
                                            Upload Passport Photo
                                        </label>

                                        <InputFile OnChange="@OnPassportPhotoChanged"
                                                   class="form-control form-control-sm"
                                                   accept=".jpg,.jpeg,.png" />

                                        <small>
                                            JPG or PNG. Maximum 5MB.
                                        </small>

                                        @if (isUploading)
                                        {
                                            <div class="uploading-line">
                                                <span class="spinner-border spinner-border-sm"></span>
                                                Uploading...
                                            </div>
                                        }
                                    </div>

                                </div>

                                <div class="tab-footer">
                                    <button type="button"
                                            class="bcc-btn profile-form-secondary-btn compact-btn"
                                            @onclick='() => SetTab("church-assignment")'>
                                        <i class="fas fa-arrow-left me-2"></i>
                                        Previous
                                    </button>

                                    <button type="button"
                                            class="bcc-btn bcc-btn-primary compact-btn"
                                            @onclick='() => SetTab("status-actions")'>
                                        Next
                                        <i class="fas fa-arrow-right ms-2"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            }

            @if (activeTab == "status-actions")
            {
                <div class="row g-3">

                    <div class="col-12 col-xl-6">
                        <div class="bcc-card update-section-card h-100">
                            <div class="update-section-header">
                                <div class="update-section-icon status">
                                    <i class="fas fa-user-check"></i>
                                </div>

                                <div>
                                    <h6>Status & Compliance</h6>
                                    <p>Worker account state and calculated completeness.</p>
                                </div>
                            </div>

                            <div class="bcc-card-body p-3">

                                <div class="status-control-card">

                                    <div>
                                        <span>Worker Status</span>

                                        <strong class="@(workerModel.IsActive ? "text-success" : "text-danger")">
                                            @(workerModel.IsActive ? "Active" : "Inactive")
                                        </strong>
                                    </div>

                                    <div class="form-check form-switch">
                                        <InputCheckbox @bind-Value="workerModel.IsActive"
                                                       class="form-check-input" />

                                        <label class="form-check-label">
                                            Active
                                        </label>
                                    </div>

                                </div>

                                @{
                                    var recalculatedCompliance =
                                        CalculateCompliance(workerModel);
                                }

                                <div class="compliance-panel">
                                    <div class="compliance-top">
                                        <span>Calculated Compliance</span>
                                        <strong>@recalculatedCompliance%</strong>
                                    </div>

                                    <div class="progress">
                                        <div class="progress-bar @GetComplianceClass(recalculatedCompliance)"
                                             style="width:@recalculatedCompliance%">
                                        </div>
                                    </div>

                                    <small>
                                        The saved compliance percentage will be recalculated when changes are saved.
                                    </small>
                                </div>

                                <ValidationSummary class="compact-validation-summary" />

                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-6">
                        <div class="bcc-card update-section-card h-100">
                            <div class="update-section-header">
                                <div class="update-section-icon action">
                                    <i class="fas fa-bolt"></i>
                                </div>

                                <div>
                                    <h6>Quick Actions</h6>
                                    <p>Additional worker administration options.</p>
                                </div>
                            </div>

                            <div class="bcc-card-body p-3">
                                <div class="admin-action-grid">

                                    <button type="button"
                                            @onclick="NavigateToDetails">
                                        <i class="fas fa-eye"></i>
                                        <span>View Details</span>
                                    </button>

                                    <button type="button"
                                            @onclick="NavigateToResetPassword">
                                        <i class="fas fa-key"></i>
                                        <span>Reset Password</span>
                                    </button>

                                    <button type="button"
                                            class="danger"
                                            disabled="@(!workerModel.IsActive)"
                                            @onclick="NavigateToDeactivate">
                                        <i class="fas fa-user-slash"></i>
                                        <span>Deactivate Worker</span>
                                    </button>

