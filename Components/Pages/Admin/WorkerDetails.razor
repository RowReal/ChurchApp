@page "/admin/worker-details/{workerId:int}"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services
@using ChurchApp.Components

@inject WorkerService WorkerService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Admin Worker Details - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access this page.</p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else if (!AuthService.CanAccessAdminPanel())
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>
        <p>You do not have permission to access the administrative worker profile.</p>

        <a href="/"
           class="bcc-btn bcc-btn-primary">
            Return to Dashboard
        </a>
    </div>
}
else if (isLoading)
{
    <div class="worker360-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-4">
                <div class="spinner-border text-primary"></div>

                <div class="mt-2 text-muted">
                    Loading worker profile...
                </div>
            </div>
        </div>
    </div>
}
else if (worker == null)
{
    <div class="bcc-empty">
        <i class="fas fa-user-slash"></i>
        <h4>Worker Not Found</h4>
        <p>The requested worker profile could not be found.</p>

        <button type="button"
                class="bcc-btn bcc-btn-primary"
                @onclick="NavigateBack">
            Back to Worker List
        </button>
    </div>
}
else
{
    <div class="worker360-page admin-worker-page">

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success py-2">
                <i class="fas fa-check-circle me-2"></i>
                @successMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        <div class="bcc-page-header admin-worker-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-user-shield me-2"></i>
                    Admin Worker 360
                </div>

                <div class="bcc-page-title">
                    Worker Profile
                </div>

                <div class="bcc-page-subtitle">
                    Administrative view of worker information, ministry history and system records.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        @onclick="NavigateBack">
                    <i class="fas fa-arrow-left me-2"></i>
                    Back
                </button>

                <button type="button"
                        class="bcc-btn bcc-btn-primary compact-btn"
                        @onclick="NavigateToUpdate">
                    <i class="fas fa-edit me-2"></i>
                    Update Profile
                </button>
            </div>
        </div>

        <div class="worker-identity-card mb-3">

            <div class="worker-identity-main">

                @if (!string.IsNullOrWhiteSpace(worker.PassportPhotoPath))
                {
                    <img src="/uploads/@(worker.PassportPhotoThumbPath ?? worker.PassportPhotoPath)"
                         alt="@worker.FirstName"
                         class="worker-profile-photo" />
                }
                else
                {
                    <div class="worker-profile-placeholder">
                        <i class="fas fa-user"></i>
                    </div>
                }

                <div>
                    <h2>
                        @BuildFullName()
                    </h2>

                    <div class="worker-identity-meta">
                        <span>
                            <i class="fas fa-id-badge"></i>
                            @worker.WorkerId
                        </span>

                        <span>
                            <i class="fas fa-user-tag"></i>
                            @DisplayValue(worker.Role)
                        </span>

                        <span>
                            <i class="fas fa-building"></i>
                            @(worker.Directorate?.Name ?? "No Directorate")
                        </span>

                        <span>
                            <i class="fas fa-sitemap"></i>
                            @(worker.Department?.Name ?? "No Department")
                        </span>
                    </div>
                </div>

            </div>

            <div class="worker-identity-stats">

                <div>
                    <span>Compliance</span>
                    <strong>@worker.CompliancePercentage%</strong>
                    <small>@GetComplianceText(worker.CompliancePercentage)</small>
                </div>

                <div>
                    <span>Qualifications</span>
                    <strong>@GetTotalQualifications()/4</strong>
                    <small>Completed</small>
                </div>

                <div>
                    <span>Years in BCC</span>
                    <strong>@CalculateYearsInBCC()</strong>
                    <small>Years</small>
                </div>

                <div class="status">
                    <span>Status</span>
                    <strong class="@(worker.IsActive ? "text-success" : "text-secondary")">
                        @(worker.IsActive ? "Active" : "Inactive")
                    </strong>
                    <small>@GetApprovalStatus()</small>
                </div>

            </div>

        </div>

        <div class="admin-profile-tabs mb-3">

            <button type="button"
                    class="@GetTabClass("profile")"
                    @onclick='() => SetTab("profile")'>
                <i class="fas fa-address-card"></i>
                Profile
            </button>

            <button type="button"
                    class="@GetTabClass("ministry")"
                    @onclick='() => SetTab("ministry")'>
                <i class="fas fa-church"></i>
                Ministry & Qualifications
            </button>

            <button type="button"
                    class="@GetTabClass("documents")"
                    @onclick='() => SetTab("documents")'>
                <i class="fas fa-folder-open"></i>
                Documents & History
            </button>

            <button type="button"
                    class="@GetTabClass("system")"
                    @onclick='() => SetTab("system")'>
                <i class="fas fa-cog"></i>
                System & Actions
            </button>

        </div>

        @if (activeTab == "profile")
        {
            <div class="row g-3">

                <div class="col-12 col-xl-6">
                    <div class="bcc-card admin-section-card h-100">
                        <div class="admin-section-header">
                            <div class="admin-section-icon personal">
                                <i class="fas fa-user"></i>
                            </div>

                            <div>
                                <h6>Personal Information</h6>
                                <p>Identity and personal details.</p>
                            </div>
                        </div>

                        <div class="bcc-card-body p-3">
                            <div class="admin-info-grid">
                                @InfoItem("Worker ID", worker.WorkerId)
                                @InfoItem("Full Name", BuildFullName(), true)
                                @InfoItem("Sex", worker.Sex)
                                @InfoItem("Date of Birth", FormatDate(worker.DateOfBirth))
                                @InfoItem("Age", CalculateAge(worker.DateOfBirth) == 0 ? "Not provided" : $"{CalculateAge(worker.DateOfBirth)} years")
                                @InfoItem("Marital Status", worker.MaritalStatus)
                                @InfoItem("Wedding Anniversary", FormatDate(worker.WeddingAnniversary))
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="bcc-card admin-section-card h-100">
                        <div class="admin-section-header">
                            <div class="admin-section-icon contact">
                                <i class="fas fa-address-book"></i>
                            </div>

                            <div>
                                <h6>Contact & Professional</h6>
                                <p>Communication, profession and address.</p>
                            </div>
                        </div>

                        <div class="bcc-card-body p-3">
                            <div class="admin-info-grid">
                                @InfoItem("Email", worker.Email)
                                @InfoItem("Phone", worker.Phone)
                                @InfoItem("Profession", worker.Profession)
                                @InfoItem("Organisation", worker.Organization)
                                @InfoItem("Address", worker.Address, true)
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        }

        @if (activeTab == "ministry")
        {
            <div class="row g-3">

                <div class="col-12 col-xl-6">
                    <div class="bcc-card admin-section-card">
                        <div class="admin-section-header">
                            <div class="admin-section-icon church">
                                <i class="fas fa-church"></i>
                            </div>

                            <div>
                                <h6>Current Ministry Assignment</h6>
                                <p>Primary and secondary assignments.</p>
                            </div>
                        </div>

                        <div class="bcc-card-body p-3">
                            <div class="admin-info-grid">
                                @InfoItem("Primary Directorate", worker.Directorate?.Name)
                                @InfoItem("Primary Department", worker.Department?.Name)
                                @InfoItem("Unit", worker.Unit?.Name)
                                @InfoItem("Secondary Directorate", worker.SecondaryDirectorate?.Name)
                                @InfoItem("Secondary Department", worker.SecondaryDepartment?.Name)
                                @InfoItem("Role", worker.Role)
                                @InfoItem("Worker Status", worker.WorkerStatus)
                                @InfoItem("Supervisor", GetSupervisorName())
                                @InfoItem("Date Joined BCC", FormatDate(worker.DateJoinedChurch))
                                @InfoItem("Years in BCC", $"{CalculateYearsInBCC()} year(s)")
                            </div>
                        </div>
                    </div>

                    <div class="bcc-card admin-section-card">
                        <div class="admin-section-header">
                            <div class="admin-section-icon experience">
                                <i class="fas fa-history"></i>
                            </div>

                            <div>
                                <h6>Previous Church Experience</h6>
                                <p>Service experience before BCC.</p>
                            </div>
                        </div>

                        <div class="bcc-card-body p-3">
                            <div class="admin-info-grid">
                                @InfoItem("Previous Church", worker.PreviousChurch)
                                @InfoItem("Previous Role", worker.PreviousChurchRole)
                                @InfoItem("Previous Unit", worker.PreviousChurchUnit)
                                @InfoItem(
                                "Experience Status",
                                                HasPreviousChurchExperience()
                                                ? "Previous experience recorded"
                                                : "No previous experience recorded",
                                                true)
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="bcc-card admin-section-card">
                <div class="admin-section-header">
                    <div class="admin-section-icon ordination">
                        <i class="fas fa-hands-praying"></i>
                    </div>

                    <div>
                        <h6>Ordination</h6>
                        <p>Ordination status and latest record.</p>
                    </div>
                </div>

                <div class="bcc-card-body p-3">
                    <div class="admin-info-grid">
                        @InfoItem("Ordination Status", worker.OrdinationStatus)
                        @InfoItem("Ordination Level", worker.OrdinationLevel)
                        @InfoItem("Last Ordination", FormatDate(worker.LastOrdinationDate), true)
                    </div>
                </div>
            </div>

            <div class="bcc-card admin-section-card">
                <div class="admin-section-header">
                    <div class="admin-section-icon qualification">
                        <i class="fas fa-award"></i>
                    </div>

                    <div>
                        <h6>Qualifications & Certificates</h6>
                        <p>@GetTotalQualifications() of 4 completed.</p>
                    </div>
                </div>

                <div class="bcc-card-body p-3">
                    <div class="qualification-grid">
                        @QualificationItem(
                                                "Believer's Baptism",
                                                worker.HasBelieverBaptism,
                                                worker.BelieverBaptismCertificatePath)

                        @QualificationItem(
                                                "Worker in Training",
                                                worker.HasWorkerInTraining,
                                                worker.WorkerInTrainingCertificatePath)

                        @QualificationItem(
                                                "School of Discipleship",
                                                worker.HasSOD,
                                                worker.SODCertificatePath)

                        @QualificationItem(
                                                "Bible College",
                                                worker.HasBibleCollege,
                                                worker.BibleCollegeCertificatePath)
                    </div>
                </div>
            </div>
        </div>

    </div>
        }

        @if (activeTab == "documents")
        {
            <div class="row g-3">

                <div class="col-12 col-xl-5">
                    <div class="bcc-card admin-section-card">
                        <div class="admin-section-header">
                            <div class="admin-section-icon document">
                                <i class="fas fa-image"></i>
                            </div>

                            <div>
                                <h6>Passport Photo</h6>
                                <p>Current profile photograph.</p>
                            </div>
                        </div>

                        <div class="bcc-card-body p-3">

                            @if (!string.IsNullOrWhiteSpace(worker.PassportPhotoPath))
                            {
                                <div class="passport-document-panel">
                                    <img src="/uploads/@worker.PassportPhotoPath"
                                         alt="Passport photograph" />

                                    <div class="d-flex gap-2 flex-wrap">
                                        <a href="/uploads/@worker.PassportPhotoPath"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-expand me-1"></i>
                                            View Full Size
                                        </a>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-success"
                                                @onclick="DownloadPhoto">
                                            <i class="fas fa-download me-1"></i>
                                            Download
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="bcc-empty py-4">
                                    <i class="fas fa-user-circle"></i>
                                    <p>No passport photo uploaded.</p>

                                    <button type="button"
                                            class="bcc-btn bcc-btn-primary compact-btn"
                                            @onclick="NavigateToUpdate">
                                        Upload Photo
                                    </button>
                                </div>
                            }

                        </div>
                    </div>

                    <div class="bcc-card admin-section-card">
                        <div class="admin-section-header">
                            <div class="admin-section-icon document">
                                <i class="fas fa-file-alt"></i>
                            </div>

                            <div>
                                <h6>Certificate Documents</h6>
                                <p>Uploaded qualification documents.</p>
                            </div>
                        </div>

                        <div class="bcc-card-body p-3">
                            <div class="document-list">
                                @DocumentItem(
                                "Believer Baptism Certificate",
                                                worker.BelieverBaptismCertificatePath)

                        @DocumentItem(
                                                "Worker in Training Certificate",
                                                worker.WorkerInTrainingCertificatePath)

                        @DocumentItem(
                                                "SOD Certificate",
                                                worker.SODCertificatePath)

                        @DocumentItem(
                                                "Bible College Certificate",
                                                worker.BibleCollegeCertificatePath)
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-7">
            <div class="bcc-card admin-section-card h-100">
                <div class="admin-section-header">
                    <div class="admin-section-icon timeline">
                        <i class="fas fa-stream"></i>
                    </div>

                    <div>
                        <h6>Ministry Journey Timeline</h6>
                        <p>Important dates and profile milestones.</p>
                    </div>
                </div>

                <div class="bcc-card-body p-3">
                    <div class="compact-timeline">

                        @TimelineItem(
                                                worker.CreatedDate,
                                                "Worker profile created",
                                                "The worker record was created.")

                        @if (worker.DateJoinedChurch.HasValue)
                                {
                                    @TimelineItem(
                                    worker.DateJoinedChurch.Value,
                                                "Joined BCC",
                                                "The worker joined the church.")
                                                }

                                @if (worker.HasBelieverBaptism)
                                {
                                    @TimelineItem(
                                    worker.CreatedDate,
                                                "Believer's Baptism",
                                                "Baptism qualification recorded.")
                                                }

                                @if (worker.HasWorkerInTraining)
                                {
                                    @TimelineItem(
                                    worker.CreatedDate,
                                                "Worker in Training",
                                                "Worker training qualification recorded.")
                                                }

                                @if (worker.HasSOD)
                                {
                                    @TimelineItem(
                                    worker.CreatedDate,
                                                "School of Discipleship",
                                                "SOD qualification recorded.")
                                                }

                                @if (worker.HasBibleCollege)
                                {
                                    @TimelineItem(
                                    worker.CreatedDate,
                                                "Bible College",
                                                "Bible College qualification recorded.")
                                                }

                                @if (worker.LastOrdinationDate.HasValue)
                                {
                                    @TimelineItem(
                                    worker.LastOrdinationDate.Value,
                                                "Ordination",
                                                $"{worker.OrdinationLevel} recorded.")
                                                }

                                @if (worker.LastUpdated.HasValue)
                                {
                                    @TimelineItem(
                                    worker.LastUpdated.Value,
                                                "Profile Updated",
                                                "The profile was last updated.")
                                                }

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        }

        @if (activeTab == "system")
        {
            <div class="row g-3">

                <div class="col-12 col-xl-7">
                    <div class="bcc-card admin-section-card">
                        <div class="admin-section-header">
                            <div class="admin-section-icon system">
                                <i class="fas fa-cog"></i>
                            </div>

                            <div>
                                <h6>System Information</h6>
                                <p>Account, approval and profile status.</p>
                            </div>
                        </div>

                        <div class="bcc-card-body p-3">
                            <div class="admin-info-grid">
                                @InfoItem("Created Date", worker.CreatedDate.ToString("dd MMM yyyy, hh:mm tt"))
                                @InfoItem("Last Updated", worker.LastUpdated?.ToString("dd MMM yyyy, hh:mm tt"))
                                @InfoItem("Last Login", worker.LastLoginDate?.ToString("dd MMM yyyy, hh:mm tt"))
                                @InfoItem("First Login", worker.IsFirstLogin ? "Pending" : "Completed")
                                @InfoItem("Profile Submitted", worker.ProfileSubmitted ? "Yes" : "No")
                                @InfoItem("Approval Status", GetApprovalStatus())
                                @InfoItem("Compliance", $"{worker.CompliancePercentage}% - {GetComplianceText(worker.CompliancePercentage)}", true)
                            </div>
                        </div>
                    </div>

                    <div class="bcc-card admin-section-card">
                        <div class="admin-section-header">
                            <div class="admin-section-icon audit">
                                <i class="fas fa-clipboard-list"></i>
                            </div>

                            <div>
                                <h6>Audit Trail</h6>
                                <p>Recent administrative and profile activity.</p>
                            </div>
                        </div>

                        <div class="bcc-card-body p-3">
                            <AuditTrailView WorkerId="worker.Id" />
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-5">
                    <div class="bcc-card admin-section-card">
                        <div class="admin-section-header">
                            <div class="admin-section-icon action">
                                <i class="fas fa-bolt"></i>
                            </div>

                            <div>
                                <h6>Administrative Actions</h6>
                                <p>Manage profile and account activities.</p>
                            </div>
                        </div>

                        <div class="bcc-card-body p-3">
                            <div class="admin-action-grid">

                                <button type="button"
                                        @onclick="NavigateToUpdate">
                                    <i class="fas fa-edit"></i>
                                    <span>Update Profile</span>
                                </button>

                                <button type="button"
                                        @onclick="ResetPassword">
                                    <i class="fas fa-key"></i>
                                    <span>Reset Password</span>
                                </button>

                                <button type="button"
                                        @onclick="SendReminder">
                                    <i class="fas fa-envelope"></i>
                                    <span>Send Reminder</span>
                                </button>

                                <button type="button"
                                        @onclick="PrintProfile">
                                    <i class="fas fa-print"></i>
                                    <span>Print Profile</span>
                                </button>

                                <button type="button"
                                        @onclick="ViewFullHistory">
                                    <i class="fas fa-history"></i>
                                    <span>Full History</span>
                                </button>

                                <button type="button"
                                        class="@(worker.IsActive ? "danger" : "success")"
                                        @onclick="ToggleActiveStatus">
                                    <i class="fas @(worker.IsActive ? "fa-user-slash" : "fa-user-check")"></i>

                                    <span>
                                        @(worker.IsActive
                                                                        ? "Deactivate Worker"
                                                                        : "Activate Worker")
                            </span>
                        </button>

                            </div>
                        </div>
                    </div>

                    <div class="bcc-card admin-section-card">
                        <div class="admin-section-header">
                            <div class="admin-section-icon status">
                                <i class="fas fa-user-check"></i>
                            </div>

                            <div>
                                <h6>Worker Status</h6>
                                <p>Current account and approval condition.</p>
                            </div>
                        </div>

                        <div class="bcc-card-body p-3">
                            <div class="status-summary-grid">

                                <div>
                                    <span>Account</span>
                                    <strong class="@(worker.IsActive ? "text-success" : "text-danger")">
                                        @(worker.IsActive ? "Active" : "Inactive")
                                    </strong>
                                </div>

                                <div>
                                    <span>Approval</span>
                                    <strong>@GetApprovalStatus()</strong>
                                </div>

                                <div>
                                    <span>First Login</span>
                                    <strong>
                                        @(worker.IsFirstLogin ? "Pending" : "Completed")
                                    </strong>
                                </div>

                                <div>
                                    <span>Profile</span>
                                    <strong>
                                        @(worker.ProfileSubmitted ? "Submitted" : "Not Submitted")
                                    </strong>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        }

    </div>
}

@code {
    [Parameter]
    public int workerId { get; set; }

    private Worker? worker;

    private bool isLoading = true;

    private string? errorMessage;
    private string? successMessage;

    private string activeTab = "profile";

    protected override async Task OnParametersSetAsync()
    {
        await LoadWorkerData();
    }

    private async Task LoadWorkerData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            worker =
                await WorkerService
                    .GetWorkerByIdAsync(workerId);
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Error loading worker: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        successMessage = null;
        errorMessage = null;
    }

    private string GetTabClass(string tab)
    {
        return activeTab == tab
            ? "admin-profile-tab active"
            : "admin-profile-tab";
    }

    private RenderFragment InfoItem(
        string label,
        string? value,
        bool fullWidth = false) => @<div class="admin-info-item @(fullWidth ? "full-width" : "")">
        <span>@label</span>
        <strong>@DisplayValue(value)</strong>
    </div>;

    private RenderFragment QualificationItem(
        string title,
        bool completed,
        string? path) => @<div class="qualification-item">

    <div class="qualification-icon @(completed ? "completed" : "missing")">
        <i class="fas @(completed ? "fa-check" : "fa-times")"></i>
    </div>

    <div class="qualification-content">
        <strong>@title</strong>
        <span>@(completed ? "Completed" : "Not completed")</span>
    </div>

@if (!string.IsNullOrWhiteSpace(path))
    {
    <a href="/uploads/@path"
       target="_blank"
       title="View certificate">
        <i class="fas fa-file-alt"></i>
    </a>
    }
    else
    {
    <span class="document-missing"
          title="No certificate uploaded">
        <i class="fas fa-minus"></i>
    </span>
    }

</div>;

    private RenderFragment DocumentItem(
        string title,
        string? path) => @<div class="document-item">

    <div>
        <i class="fas fa-file-alt"></i>

        <span>@title</span>
    </div>

@if (!string.IsNullOrWhiteSpace(path))
    {
    <a href="/uploads/@path"
       target="_blank">
        View
    </a>
    }
    else
    {
    <small>Not uploaded</small>
    }

</div>;

    private RenderFragment TimelineItem(
        DateTime date,
        string title,
        string description) => @<div class="timeline-item">

        <div class="timeline-dot"></div>

        <div>
            <span>@date.ToString("dd MMM yyyy")</span>
            <strong>@title</strong>
            <p>@description</p>
        </div>

    </div>;

    private string BuildFullName()
    {
        if (worker == null)
            return "Worker";

        return string.Join(
            " ",
            new[]
            {
                worker.Title,
                worker.FirstName,
                worker.MiddleName,
                worker.LastName
            }
            .Where(x =>
                !string.IsNullOrWhiteSpace(x)));
    }

    private string GetSupervisorName()
    {
        if (worker?.Supervisor == null)
            return "Not assigned";

        return string.Join(
            " ",
            new[]
            {
                worker.Supervisor.FirstName,
                worker.Supervisor.LastName
            }
            .Where(x =>
                !string.IsNullOrWhiteSpace(x)));
    }

    private static string DisplayValue(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Not provided"
            : value.Trim();
    }

    private static string FormatDate(
        DateTime? value)
    {
        return value?.ToString(
            "dd MMMM yyyy") ?? "Not provided";
    }

    private void NavigateToUpdate()
    {
        if (worker == null)
            return;

        Navigation.NavigateTo(
            $"/admin/worker-update-form/{worker.Id}");
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo(
            "/admin/worker-update");
    }

    private static string GetComplianceText(
        int percentage)
    {
        return percentage switch
        {
            >= 90 => "Excellent",
            >= 80 => "Good",
            >= 50 => "Fair",
            _ => "Poor"
        };
    }

    private int CalculateYearsInBCC()
    {
        if (worker?.DateJoinedChurch.HasValue != true)
            return 0;

        var joined =
            worker.DateJoinedChurch.Value;

        var years =
            DateTime.Today.Year -
            joined.Year;

        if (joined.Date >
            DateTime.Today.AddYears(-years))
        {
            years--;
        }

        return Math.Max(0, years);
    }

    private bool HasPreviousChurchExperience()
    {
        return
            !string.IsNullOrWhiteSpace(
                worker?.PreviousChurch) ||

            !string.IsNullOrWhiteSpace(
                worker?.PreviousChurchRole) ||

            !string.IsNullOrWhiteSpace(
                worker?.PreviousChurchUnit);
    }

    private int GetTotalQualifications()
    {
        if (worker == null)
            return 0;

        var total = 0;

        if (worker.HasBelieverBaptism)
            total++;

        if (worker.HasWorkerInTraining)
            total++;

        if (worker.HasSOD)
            total++;

        if (worker.HasBibleCollege)
            total++;

        return total;
    }

    private string GetApprovalStatus()
    {
        if (worker == null)
            return "Unknown";

        if (worker.Stage1Approved &&
            worker.Stage2Approved)
        {
            return "Fully Approved";
        }

        if (worker.Stage1Approved)
            return "Stage 1 Approved";

        if (worker.ProfileSubmitted)
            return "Pending";

        return "Not Submitted";
    }

    private async Task DownloadPhoto()
    {
        if (string.IsNullOrWhiteSpace(
            worker?.PassportPhotoPath))
        {
            return;
        }

        var fileName =
            $"{worker.FirstName}_{worker.LastName}_Passport" +
            $"{Path.GetExtension(worker.PassportPhotoPath)}";

        Navigation.NavigateTo(
            $"/download-file/{worker.PassportPhotoPath}/{fileName}",
            true);

        await Task.CompletedTask;
    }

    private void ViewFullHistory()
    {
        if (worker == null)
            return;

        Navigation.NavigateTo(
            $"/admin/worker-history/{worker.Id}");
    }

    private async Task ResetPassword()
    {
        if (worker == null)
            return;

        try
        {
            successMessage = null;
            errorMessage = null;

            var success =
                await WorkerService
                    .ResetPasswordAsync(worker.Id);

            successMessage =
                success
                    ? "Password reset successfully. A temporary password was assigned."
                    : "Unable to reset the password.";
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Error resetting password: {ex.Message}";
        }
    }

    private async Task SendReminder()
    {
        if (worker == null)
            return;

        try
        {
            successMessage = null;
            errorMessage = null;

            var success =
                await WorkerService
                    .SendProfileReminderAsync(worker.Id);

            successMessage =
                success
                    ? "Profile reminder sent successfully."
                    : "Unable to send the reminder.";
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Error sending reminder: {ex.Message}";
        }
    }

    private async Task ToggleActiveStatus()
    {
        if (worker == null)
            return;

        var previousStatus =
            worker.IsActive;

        try
        {
            successMessage = null;
            errorMessage = null;

            worker.IsActive =
                !worker.IsActive;

            worker.LastUpdated =
                DateTime.UtcNow;

            await WorkerService
                .UpdateWorkerAsync(worker);

            successMessage =
                worker.IsActive
                    ? "Worker activated successfully."
                    : "Worker deactivated successfully.";
        }
        catch (Exception ex)
        {
            worker.IsActive =
                previousStatus;

            errorMessage =
                $"Error updating worker status: {ex.Message}";
        }
    }

    private void PrintProfile()
    {
        if (worker == null)
            return;

        Navigation.NavigateTo(
            $"/admin/worker-print/{worker.Id}",
            true);
    }

    private static int CalculateAge(
        DateTime? birthDate)
    {
        if (!birthDate.HasValue)
            return 0;

        var today =
            DateTime.Today;

        var age =
            today.Year -
            birthDate.Value.Year;

        if (birthDate.Value.Date >
            today.AddYears(-age))
        {
            age--;
        }

        return Math.Max(0, age);
    }
}

