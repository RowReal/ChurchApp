@page "/admin/worker-update"
@layout Components.Layout.MainLayout
@using ChurchApp.Services
@using ChurchApp.Models
@inject WorkerService WorkerService
@inject AuthService AuthService
@inject NavigationManager Navigation

@if (AuthService.IsAuthenticated && AuthService.CanAccessAdminPanel())
{
    <PageTitle>Workers - Admin</PageTitle>

    <div class="my-team-v2-page">

        <div class="bcc-page-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-users-cog me-2"></i>
                    Administration
                </div>
                <div class="bcc-page-title">Worker Profiles</div>
                <div class="bcc-page-subtitle">
                    View, update, activate or deactivate worker records.
                </div>
            </div>

            <a class="bcc-btn bcc-btn-primary" href="/admin/worker-setup">
                <i class="fas fa-user-plus me-2"></i>
                Add New Worker
            </a>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="team-summary-card">
                    <span>Total Workers</span>
                    <strong>@workers.Count</strong>
                    <i class="fas fa-users"></i>
                </div>
            </div>

            <div class="col-md-3">
                <div class="team-summary-card active">
                    <span>Active</span>
                    <strong>@workers.Count(w => w.IsActive)</strong>
                    <i class="fas fa-user-check"></i>
                </div>
            </div>

            <div class="col-md-3">
                <div class="team-summary-card inactive">
                    <span>Inactive</span>
                    <strong>@workers.Count(w => !w.IsActive)</strong>
                    <i class="fas fa-user-slash"></i>
                </div>
            </div>

            <div class="col-md-3">
                <div class="team-summary-card directorate">
                    <span>Directorates</span>
                    <strong>@directorates.Count</strong>
                    <i class="fas fa-sitemap"></i>
                </div>
            </div>
        </div>

        <div class="bcc-card">
            <div class="bcc-card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="profile-form-label">Search Worker</label>
                        <input class="form-control bcc-input"
                               placeholder="Search by name or Worker ID..."
                               @bind="SearchText"
                               @bind:event="oninput" />
                    </div>

                    <div class="col-md-4">
                        <label class="profile-form-label">Directorate</label>
                        <select class="form-select bcc-input" @bind="SelectedDirectorateId">
                            <option value="0">All Directorates</option>
                            @foreach (var d in directorates)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <div class="notice-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   checked="@showInactiveWorkers"
                                   @onchange="ToggleInactiveWorkers"
                                   id="showInactive" />

                            <label for="showInactive">
                                Show Inactive
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="bcc-card">
            <div class="bcc-card-header">
                <div class="profile-v2-card-icon">
                    <i class="fas fa-address-card"></i>
                </div>
                <div class="bcc-card-title">
                    Workers (@filteredWorkers.Count)
                </div>
            </div>

            <div class="bcc-card-body p-0">
                @if (filteredWorkers.Any())
                {
                    <div class="notice-table-wrapper">
                        <table class="table notice-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Worker</th>
                                    <th>Directorate</th>
                                    <th>Department</th>
                                    <th>Role</th>
                                    <th>Data</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var worker in filteredWorkers)
                                {
                                    var completeness = CalculateCompleteness(worker);

                                    <tr>
                                        <td>
                                            <div class="notice-title-cell">
                                                @if (!string.IsNullOrEmpty(worker.PassportPhotoPath))
                                                {
                                                    <img src="/uploads/@(worker.PassportPhotoThumbPath ?? worker.PassportPhotoPath)"
                                                         class="admin-worker-avatar"
                                                         loading="lazy"
                                                         @onclick="() => OpenImagePreview(worker.PassportPhotoPath, worker)" />
                                                }
                                                else
                                                {
                                                    <div class="admin-worker-avatar-placeholder"
                                                         @onclick="() => OpenImagePreview(null, worker)">
                                                        <i class="fas fa-user"></i>
                                                    </div>
                                                }

                                                <div>
                                                    <strong>@worker.FirstName @worker.LastName</strong>
                                                    <span>@worker.WorkerId</span>
                                                </div>
                                            </div>
                                        </td>

                                        <td>@(worker.Directorate?.Name ?? "Not assigned")</td>
                                        <td>@(worker.Department?.Name ?? "Not assigned")</td>

                                        <td>
                                            <span class="notice-type-badge notice-prayer">
                                                @worker.Role
                                            </span>
                                        </td>

                                        <td>
                                            <span class="notice-status @GetCompletenessClass(completeness)">
                                                @completeness%
                                            </span>
                                        </td>

                                        <td>
                                            @if (worker.IsActive)
                                            {
                                                <span class="notice-status active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="notice-status inactive">Inactive</span>
                                            }
                                        </td>

                                        <td class="text-end">
                                            <a href="/admin/worker-details/@worker.Id" class="notice-action-btn edit" title="View">
                                                <i class="fas fa-eye"></i>
                                            </a>

                                            <a href="/admin/worker-update-form/@worker.Id" class="notice-action-btn toggle" title="Update">
                                                <i class="fas fa-pen"></i>
                                            </a>

                                            @if (worker.IsActive)
                                            {
                                                <a href="/admin/deactivate-worker/@worker.Id" class="notice-action-btn delete" title="Deactivate">
                                                    <i class="fas fa-user-slash"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="/admin/activate-worker/@worker.Id" class="notice-action-btn edit" title="Activate">
                                                    <i class="fas fa-user-check"></i>
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="bcc-empty">
                        <i class="fas fa-users-slash"></i>
                        <h4>No workers found</h4>
                        <p>No worker matches your current filter.</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (showImagePreview)
{
    <div class="team-modal-backdrop" @onclick="CloseImagePreview">
        <div class="team-modal-card" @onclick:stopPropagation="true">
            <button class="team-modal-close" @onclick="CloseImagePreview">
                <i class="fas fa-times"></i>
            </button>

            @if (previewWorker != null)
            {
                <div class="text-center">
                    @if (!string.IsNullOrEmpty(previewImageUrl))
                    {
                        <img src="@previewImageUrl" class="team-modal-photo" />
                    }
                    else
                    {
                        <div class="team-modal-photo-placeholder">
                            <i class="fas fa-user"></i>
                        </div>
                    }

                    <h4>@previewWorker.FirstName @previewWorker.LastName</h4>
                    <p>@previewWorker.Role</p>

                    <span class="team-status @(previewWorker.IsActive ? "active" : "inactive")">
                        @(previewWorker.IsActive ? "Active" : "Inactive")
                    </span>
                </div>

                <div class="team-modal-info">
                    <div><strong>ID:</strong> @previewWorker.WorkerId</div>
                    <div><strong>Directorate:</strong> @(previewWorker.Directorate?.Name ?? "Not assigned")</div>
                    <div><strong>Department:</strong> @(previewWorker.Department?.Name ?? "Not assigned")</div>
                    <div><strong>BCC:</strong> @GetBccAge(previewWorker)</div>
                </div>

                <div class="team-modal-actions">
                    <a class="team-action-btn text-center" href="/admin/worker-details/@previewWorker.Id" @onclick="CloseImagePreview">
                        <i class="fas fa-eye me-1"></i> View
                    </a>

                    <a class="team-action-btn text-center" href="/admin/worker-update-form/@previewWorker.Id" @onclick="CloseImagePreview">
                        <i class="fas fa-pen me-1"></i> Update
                    </a>

                    @if (previewWorker.IsActive)
                    {
                        <button class="team-danger-btn" @onclick="() => DeactivateFromModal(previewWorker)">
                            <i class="fas fa-user-slash me-1"></i> Deactivate
                        </button>
                    }
                    else
                    {
                        <button class="team-success-btn" @onclick="() => ActivateFromModal(previewWorker)">
                            <i class="fas fa-user-check me-1"></i> Activate
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private List<Worker> workers = new();
    private List<Worker> filteredWorkers = new();

    private bool showInactiveWorkers = false;

    private string? previewImageUrl;
    private bool showImagePreview = false;
    private Worker? previewWorker;

    private List<Directorate> directorates = new();

    private int selectedDirectorateId = 0;

    private int SelectedDirectorateId
    {
        get => selectedDirectorateId;
        set
        {
            selectedDirectorateId = value;
            ApplyFilter();
        }
    }

    private string searchText = "";

    private string SearchText
    {
        get => searchText;
        set
        {
            searchText = value;
            ApplyFilter();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        workers = await WorkerService.GetAllWorkersAsync();
        directorates = await WorkerService.GetDirectoratesAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        IEnumerable<Worker> query = workers;

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var text = searchText.ToLower();

            query = query.Where(w =>
                ($"{w.FirstName} {w.MiddleName} {w.LastName}")
                    .ToLower()
                    .Contains(text)
                || (w.WorkerId ?? "").ToLower().Contains(text));
        }

        if (selectedDirectorateId > 0)
            query = query.Where(w => w.DirectorateId == selectedDirectorateId);

        if (!showInactiveWorkers)
            query = query.Where(w => w.IsActive);

        query = query
            .OrderBy(w => GetWorkerPriority(w.WorkerId))
            .ThenBy(w =>
            {
                var id = w.WorkerId ?? "";
                var digits = new string(id.Where(char.IsDigit).ToArray());

                return int.TryParse(digits, out var num)
                    ? num
                    : int.MaxValue;
            });

        filteredWorkers = query.ToList();
    }

    private void ToggleInactiveWorkers(ChangeEventArgs e)
    {
        showInactiveWorkers = (bool)e.Value!;
        ApplyFilter();
    }

    private void OpenImagePreview(string? imagePath, Worker worker)
    {
        previewWorker = worker;
        previewImageUrl = !string.IsNullOrEmpty(imagePath)
            ? $"/uploads/{imagePath}"
            : null;

        showImagePreview = true;
    }

    private void CloseImagePreview()
    {
        showImagePreview = false;
        previewWorker = null;
        previewImageUrl = null;
    }

    private async Task DeactivateFromModal(Worker w)
    {
        w.IsActive = false;
        await WorkerService.UpdateWorkerAsync(w);
        ApplyFilter();
        CloseImagePreview();
    }

    private async Task ActivateFromModal(Worker w)
    {
        w.IsActive = true;
        await WorkerService.UpdateWorkerAsync(w);
        ApplyFilter();
        CloseImagePreview();
    }

    private int CalculateCompleteness(Worker worker)
    {
        var filledFields = 0;
        var totalFields = 15;

        if (!string.IsNullOrEmpty(worker.FirstName)) filledFields++;
        if (!string.IsNullOrEmpty(worker.LastName)) filledFields++;
        if (!string.IsNullOrEmpty(worker.Email)) filledFields++;
        if (!string.IsNullOrEmpty(worker.Phone)) filledFields++;
        if (worker.DateOfBirth.HasValue) filledFields++;
        if (!string.IsNullOrEmpty(worker.Profession)) filledFields++;
        if (!string.IsNullOrEmpty(worker.Organization)) filledFields++;
        if (!string.IsNullOrEmpty(worker.Address)) filledFields++;
        if (worker.DirectorateId.HasValue) filledFields++;
        if (worker.DepartmentId.HasValue) filledFields++;
        if (!string.IsNullOrEmpty(worker.Role)) filledFields++;
        if (worker.DateJoinedChurch.HasValue) filledFields++;
        if (!string.IsNullOrEmpty(worker.OrdinationLevel)) filledFields++;
        if (worker.HasBelieverBaptism || worker.HasWorkerInTraining || worker.HasSOD || worker.HasBibleCollege) filledFields++;
        if (!string.IsNullOrEmpty(worker.PassportPhotoPath)) filledFields++;

        return totalFields > 0
            ? (int)Math.Round((double)filledFields / totalFields * 100)
            : 0;
    }

    private string GetCompletenessClass(int percentage)
    {
        if (percentage < 50) return "inactive";
        if (percentage < 86) return "notice-prayer";
        return "active";
    }

    private string GetBccAge(Worker worker)
    {
        if (!worker.DateJoinedChurch.HasValue)
            return "Not set";

        var joined = worker.DateJoinedChurch.Value;
        var now = DateTime.Now;
        var totalDays = (now - joined).TotalDays;

        if (totalDays < 0)
            return "Invalid date";

        if (totalDays < 30)
            return $"{(int)totalDays} days in BCC";

        if (totalDays < 365)
            return $"{(int)(totalDays / 30)} months in BCC";

        var years = totalDays / 365;
        return $"{Math.Floor(years)} years in BCC";
    }

    private int GetWorkerPriority(string? workerId)
    {
        if (string.IsNullOrWhiteSpace(workerId))
            return 99;

        workerId = workerId.Trim().ToUpper();

        if (workerId.StartsWith("P")) return 1;
        if (workerId.StartsWith("C")) return 2;
        if (workerId.StartsWith("D")) return 3;
        if (workerId.StartsWith("W")) return 4;

        return 99;
    }
}