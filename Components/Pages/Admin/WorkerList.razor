@page "/admin/worker-update"
@layout Components.Layout.MainLayout

@using ChurchApp.Services
@using ChurchApp.Models

@inject WorkerService WorkerService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Worker Profiles - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access Worker Management.</p>
        <a href="/login" class="bcc-btn bcc-btn-primary">Go to Login</a>
    </div>
}
else if (!AuthService.CanAccessAdminPanel())
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>
        <p>You do not have permission to manage worker profiles.</p>
        <a href="/" class="bcc-btn bcc-btn-primary">Return to Dashboard</a>
    </div>
}
else if (isLoading)
{
    <div class="worker360-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-4">
                <div class="spinner-border text-primary"></div>
                <div class="mt-2 text-muted">Loading worker profiles...</div>
            </div>
        </div>
    </div>
}
else
{
    <div class="worker360-page worker-admin-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>@errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success py-2">
                <i class="fas fa-check-circle me-2"></i>@successMessage
            </div>
        }

        <div class="bcc-page-header worker-admin-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-users-cog me-2"></i>Administration
                </div>
                <div class="bcc-page-title">Worker Profiles</div>
                <div class="bcc-page-subtitle">
                    Search, review, update, activate or deactivate worker records.
                </div>
            </div>

            <a href="/admin/worker-setup" class="bcc-btn bcc-btn-primary compact-btn">
                <i class="fas fa-user-plus me-2"></i>Add New Worker
            </a>
        </div>

        <div class="row g-3 align-items-start">

            <div class="col-12 col-xl-4">
                <div class="bcc-card worker-filter-card">
                    <div class="worker-panel-header">
                        <div class="worker-panel-icon"><i class="fas fa-filter"></i></div>
                        <div>
                            <h6>Worker Search</h6>
                            <p>Use one or more filters.</p>
                        </div>
                    </div>

                    <div class="bcc-card-body p-3">
                        <div class="worker-summary-grid mb-3">
                            <div><span>Total</span><strong>@workers.Count</strong></div>
                            <div class="active"><span>Active</span><strong>@workers.Count(w => w.IsActive)</strong></div>
                            <div class="inactive"><span>Inactive</span><strong>@workers.Count(w => !w.IsActive)</strong></div>
                            <div class="directorate"><span>Directorates</span><strong>@directorates.Count</strong></div>
                        </div>

                        <div class="worker-search-tip">
                            <i class="fas fa-lightbulb"></i>
                            <span>Search by name, Worker ID, role, department or directorate.</span>
                        </div>

                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label compact-label">Search Worker</label>
                                <div class="search-input-wrap">
                                    <i class="fas fa-search"></i>
                                    <input class="form-control form-control-sm"
                                           placeholder="Name, Worker ID or role"
                                           @bind="SearchText"
                                           @bind:event="oninput" />
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label compact-label">Directorate</label>
                                <select class="form-select form-select-sm" @bind="SelectedDirectorateId">
                                    <option value="0">All Directorates</option>
                                    @foreach (var directorate in directorates)
                                    {
                                        <option value="@directorate.Id">@directorate.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label compact-label">Worker Status</label>
                                <select class="form-select form-select-sm" @bind="SelectedStatus">
                                    <option value="active">Active Workers</option>
                                    <option value="all">All Workers</option>
                                    <option value="inactive">Inactive Workers</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label compact-label">Sort Workers</label>
                                <select class="form-select form-select-sm" @bind="SelectedSort">
                                    <option value="id">Worker ID</option>
                                    <option value="name">Name A-Z</option>
                                    <option value="directorate">Directorate</option>
                                    <option value="compliance-high">Compliance High-Low</option>
                                    <option value="compliance-low">Compliance Low-High</option>
                                </select>
                            </div>
                        </div>

                        <div class="mt-3 d-flex justify-content-end gap-2">
                            <button type="button" class="bcc-btn profile-form-secondary-btn compact-btn" @onclick="ResetFilters">Reset</button>
                            <button type="button" class="bcc-btn bcc-btn-primary compact-btn" @onclick="ApplyFilter">
                                <i class="fas fa-filter me-2"></i>Apply
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-8">
                <div class="bcc-card worker-list-card">
                    <div class="worker-list-header">
                        <div>
                            <h6><i class="fas fa-address-card me-2"></i>Worker Register</h6>
                            <p>@filteredWorkers.Count worker(s) match the current filter.</p>
                        </div>
                        <span class="worker-result-count">@filteredWorkers.Count</span>
                    </div>

                    <div class="bcc-card-body p-0">
                        @if (filteredWorkers.Any())
                        {
                            <div class="table-responsive worker-table-wrapper">
                                <table class="table align-middle mb-0 worker-admin-table">
                                    <thead>
                                        <tr>
                                            <th>Worker</th>
                                            <th>Assignment</th>
                                            <th>Role</th>
                                            <th>Profile</th>
                                            <th>Status</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var workerItem in filteredWorkers)
                                        {
                                            var completeness = CalculateCompleteness(workerItem);

                                            <tr>
                                                <td>
                                                    <div class="worker-name-cell">
                                                        @if (!string.IsNullOrWhiteSpace(workerItem.PassportPhotoPath))
                                                        {
                                                            <img src="/uploads/@(workerItem.PassportPhotoThumbPath ?? workerItem.PassportPhotoPath)"
                                                                 class="worker-avatar"
                                                                 alt="@workerItem.FirstName"
                                                                 loading="lazy"
                                                                 @onclick="() => OpenImagePreview(workerItem.PassportPhotoPath, workerItem)" />
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="worker-avatar-placeholder" @onclick="() => OpenImagePreview(null, workerItem)">
                                                                <i class="fas fa-user"></i>
                                                            </button>
                                                        }

                                                        <div>
                                                            <strong>@workerItem.FirstName @workerItem.LastName</strong>
                                                            <span>
                                                                @workerItem.WorkerId
                                                                @if (!string.IsNullOrWhiteSpace(workerItem.Phone))
                                                                {
                                                                    <text> · @workerItem.Phone</text>
                                                                }
                                                            </span>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td>
                                                    <div class="assignment-cell">
                                                        <strong>@(workerItem.Directorate?.Name ?? "Not assigned")</strong>
                                                        <span>@(workerItem.Department?.Name ?? "No department")</span>
                                                    </div>
                                                </td>

                                                <td><span class="worker-role-badge">@DisplayValue(workerItem.Role)</span></td>

                                                <td>
                                                    <div class="compliance-cell">
                                                        <div class="compliance-top"><span>@completeness%</span></div>
                                                        <div class="progress">
                                                            <div class="progress-bar @GetProgressClass(completeness)" style="width: @completeness%"></div>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td>
                                                    <span class="worker-status-badge @(workerItem.IsActive ? "active" : "inactive")">
                                                        @(workerItem.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                </td>

                                                <td class="text-end">
                                                    <div class="worker-row-actions">
                                                        <a href="/admin/worker-details/@workerItem.Id" class="worker-action-btn view" title="View worker">
                                                            <i class="fas fa-eye"></i>
                                                        </a>

                                                        <a href="/admin/worker-update-form/@workerItem.Id" class="worker-action-btn update" title="Update worker">
                                                            <i class="fas fa-pen"></i>
                                                        </a>

                                                        @if (workerItem.IsActive)
                                                        {
                                                            <a href="/admin/deactivate-worker/@workerItem.Id" class="worker-action-btn deactivate" title="Deactivate worker">
                                                                <i class="fas fa-user-slash"></i>
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <a href="/admin/activate-worker/@workerItem.Id" class="worker-action-btn activate" title="Activate worker">
                                                                <i class="fas fa-user-check"></i>
                                                            </a>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="bcc-empty py-4">
                                <i class="fas fa-users-slash"></i>
                                <h4>No Workers Found</h4>
                                <p>No worker matches the current filter.</p>
                                <button type="button" class="bcc-btn bcc-btn-primary compact-btn" @onclick="ResetFilters">Clear Filters</button>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
}

@if (showImagePreview && previewWorker != null)
{
    <div class="worker-preview-backdrop" @onclick="CloseImagePreview">
        <div class="worker-preview-card" @onclick:stopPropagation="true">

            <div class="worker-preview-header">
                <div>
                    <h4>Worker Profile</h4>
                    <p>@previewWorker.WorkerId</p>
                </div>
                <button type="button" class="btn-close" @onclick="CloseImagePreview"></button>
            </div>

            <div class="worker-preview-profile">
                @if (!string.IsNullOrWhiteSpace(previewImageUrl))
                {
                    <img src="@previewImageUrl" class="worker-preview-photo" alt="@previewWorker.FirstName" />
                }
                else
                {
                    <div class="worker-preview-photo-placeholder"><i class="fas fa-user"></i></div>
                }

                <div>
                    <h5>@previewWorker.FirstName @previewWorker.LastName</h5>
                    <span>@DisplayValue(previewWorker.Role)</span>
                    <small class="worker-status-badge @(previewWorker.IsActive ? "active" : "inactive")">
                        @(previewWorker.IsActive ? "Active" : "Inactive")
                    </small>
                </div>
            </div>

            <div class="worker-preview-grid">
                <div><span>Directorate</span><strong>@(previewWorker.Directorate?.Name ?? "Not assigned")</strong></div>
                <div><span>Department</span><strong>@(previewWorker.Department?.Name ?? "Not assigned")</strong></div>
                <div><span>Time in BCC</span><strong>@GetBccAge(previewWorker)</strong></div>
                <div><span>Profile</span><strong>@CalculateCompleteness(previewWorker)%</strong></div>
            </div>

            <div class="worker-preview-actions">
                <a href="/admin/worker-details/@previewWorker.Id" class="btn btn-sm btn-outline-primary" @onclick="CloseImagePreview">
                    <i class="fas fa-eye me-1"></i>View
                </a>

                <a href="/admin/worker-update-form/@previewWorker.Id" class="btn btn-sm btn-outline-secondary" @onclick="CloseImagePreview">
                    <i class="fas fa-pen me-1"></i>Update
                </a>

                @if (previewWorker.IsActive)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" disabled="@isChangingStatus" @onclick="() => ChangeWorkerStatus(previewWorker, false)">
                        <i class="fas fa-user-slash me-1"></i>Deactivate
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-outline-success" disabled="@isChangingStatus" @onclick="() => ChangeWorkerStatus(previewWorker, true)">
                        <i class="fas fa-user-check me-1"></i>Activate
                    </button>
                }
            </div>

        </div>
    </div>
}

@code {
    private List<Worker> workers = new();
    private List<Worker> filteredWorkers = new();
    private List<Directorate> directorates = new();

    private Worker? previewWorker;
    private string? previewImageUrl;

    private bool isLoading = true;
    private bool showImagePreview;
    private bool isChangingStatus;

    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private string searchText = string.Empty;
    private int selectedDirectorateId;
    private string selectedStatus = "active";
    private string selectedSort = "id";

    private string SearchText
    {
        get => searchText;
        set
        {
            searchText = value;
            ApplyFilter();
        }
    }

    private int SelectedDirectorateId
    {
        get => selectedDirectorateId;
        set
        {
            selectedDirectorateId = value;
            ApplyFilter();
        }
    }

    private string SelectedStatus
    {
        get => selectedStatus;
        set
        {
            selectedStatus = value;
            ApplyFilter();
        }
    }

    private string SelectedSort
    {
        get => selectedSort;
        set
        {
            selectedSort = value;
            ApplyFilter();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            workers = await WorkerService.GetAllWorkersAsync();
            directorates = await WorkerService.GetDirectoratesAsync();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load workers: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilter()
    {
        IEnumerable<Worker> query = workers;

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var keyword = searchText.Trim();

            query = query.Where(workerItem =>
                ($"{workerItem.FirstName} {workerItem.MiddleName} {workerItem.LastName}")
                    .Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || (workerItem.WorkerId ?? string.Empty)
                    .Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || (workerItem.Role ?? string.Empty)
                    .Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || (workerItem.Department?.Name ?? string.Empty)
                    .Contains(keyword, StringComparison.OrdinalIgnoreCase)
                || (workerItem.Directorate?.Name ?? string.Empty)
                    .Contains(keyword, StringComparison.OrdinalIgnoreCase));
        }

        if (selectedDirectorateId > 0)
            query = query.Where(workerItem => workerItem.DirectorateId == selectedDirectorateId);

        query = selectedStatus switch
        {
            "inactive" => query.Where(workerItem => !workerItem.IsActive),
            "all" => query,
            _ => query.Where(workerItem => workerItem.IsActive)
        };

        query = selectedSort switch
        {
            "name" => query.OrderBy(workerItem => workerItem.LastName).ThenBy(workerItem => workerItem.FirstName),
            "directorate" => query.OrderBy(workerItem => workerItem.Directorate?.Name).ThenBy(workerItem => workerItem.LastName),
            "compliance-high" => query.OrderByDescending(CalculateCompleteness).ThenBy(workerItem => workerItem.LastName),
            "compliance-low" => query.OrderBy(CalculateCompleteness).ThenBy(workerItem => workerItem.LastName),
            _ => query.OrderBy(workerItem => GetWorkerPriority(workerItem.WorkerId))
                      .ThenBy(workerItem => ExtractWorkerNumber(workerItem.WorkerId))
        };

        filteredWorkers = query.ToList();
    }

    private void ResetFilters()
    {
        searchText = string.Empty;
        selectedDirectorateId = 0;
        selectedStatus = "active";
        selectedSort = "id";
        ApplyFilter();
    }

    private void OpenImagePreview(string? imagePath, Worker workerItem)
    {
        previewWorker = workerItem;
        previewImageUrl = !string.IsNullOrWhiteSpace(imagePath)
            ? $"/uploads/{imagePath}"
            : null;
        showImagePreview = true;
    }

    private void CloseImagePreview()
    {
        if (isChangingStatus)
            return;

        showImagePreview = false;
        previewWorker = null;
        previewImageUrl = null;
    }

    private async Task ChangeWorkerStatus(Worker workerItem, bool newStatus)
    {
        if (isChangingStatus)
            return;

        var previousStatus = workerItem.IsActive;

        try
        {
            isChangingStatus = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            workerItem.IsActive = newStatus;
            workerItem.LastUpdated = DateTime.UtcNow;

            await WorkerService.UpdateWorkerAsync(workerItem);

            successMessage = newStatus
                ? $"{workerItem.FirstName} {workerItem.LastName} was activated successfully."
                : $"{workerItem.FirstName} {workerItem.LastName} was deactivated successfully.";

            ApplyFilter();
        }
        catch (Exception ex)
        {
            workerItem.IsActive = previousStatus;
            errorMessage = $"Unable to change worker status: {ex.Message}";
        }
        finally
        {
            isChangingStatus = false;
            showImagePreview = false;
            previewWorker = null;
            previewImageUrl = null;
        }
    }

    private int CalculateCompleteness(Worker workerItem)
    {
        var filledFields = 0;
        const int totalFields = 15;

        if (!string.IsNullOrWhiteSpace(workerItem.FirstName)) filledFields++;
        if (!string.IsNullOrWhiteSpace(workerItem.LastName)) filledFields++;
        if (!string.IsNullOrWhiteSpace(workerItem.Email)) filledFields++;
        if (!string.IsNullOrWhiteSpace(workerItem.Phone)) filledFields++;
        if (workerItem.DateOfBirth.HasValue) filledFields++;
        if (!string.IsNullOrWhiteSpace(workerItem.Profession)) filledFields++;
        if (!string.IsNullOrWhiteSpace(workerItem.Organization)) filledFields++;
        if (!string.IsNullOrWhiteSpace(workerItem.Address)) filledFields++;
        if (workerItem.DirectorateId.HasValue) filledFields++;
        if (workerItem.DepartmentId.HasValue) filledFields++;
        if (!string.IsNullOrWhiteSpace(workerItem.Role)) filledFields++;
        if (workerItem.DateJoinedChurch.HasValue) filledFields++;
        if (!string.IsNullOrWhiteSpace(workerItem.OrdinationLevel)) filledFields++;

        if (workerItem.HasBelieverBaptism ||
            workerItem.HasWorkerInTraining ||
            workerItem.HasSOD ||
            workerItem.HasBibleCollege)
        {
            filledFields++;
        }

        if (!string.IsNullOrWhiteSpace(workerItem.PassportPhotoPath))
            filledFields++;

        return (int)Math.Round((double)filledFields / totalFields * 100);
    }

    private static string GetProgressClass(int percentage)
    {
        if (percentage < 50) return "bg-danger";
        if (percentage < 86) return "bg-warning";
        return "bg-success";
    }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Not assigned"
            : value.Trim();
    }

    private static string GetBccAge(Worker workerItem)
    {
        if (!workerItem.DateJoinedChurch.HasValue)
            return "Not set";

        var joined = workerItem.DateJoinedChurch.Value.Date;
        var today = DateTime.Today;

        if (joined > today)
            return "Invalid date";

        var years = today.Year - joined.Year;

        if (joined > today.AddYears(-years))
            years--;

        if (years > 0)
            return years == 1 ? "1 year" : $"{years} years";

        var totalDays = (today - joined).Days;

        if (totalDays < 30)
            return totalDays == 1 ? "1 day" : $"{totalDays} days";

        var months = totalDays / 30;
        return months == 1 ? "1 month" : $"{months} months";
    }

    private static int GetWorkerPriority(string? workerId)
    {
        if (string.IsNullOrWhiteSpace(workerId)) return 99;

        var normalized = workerId.Trim().ToUpperInvariant();

        if (normalized.StartsWith("P")) return 1;
        if (normalized.StartsWith("C")) return 2;
        if (normalized.StartsWith("D")) return 3;
        if (normalized.StartsWith("W")) return 4;

        return 99;
    }

    private static int ExtractWorkerNumber(string? workerId)
    {
        if (string.IsNullOrWhiteSpace(workerId))
            return int.MaxValue;

        var digits = new string(workerId.Where(char.IsDigit).ToArray());

        return int.TryParse(digits, out var number)
            ? number
            : int.MaxValue;
    }
}

<style>
    .worker-admin-page {
        max-width: 1550px;
        margin: 0 auto;
    }

    .worker-admin-header {
        margin-bottom: 14px;
    }

    .compact-btn {
        min-height: 32px;
        padding: 6px 11px;
        font-size: .78rem;
    }

    .worker-filter-card,
    .worker-list-card {
        overflow: hidden;
        border: 1px solid #e5e7eb;
        border-radius: 13px;
        box-shadow: 0 4px 14px rgba(15,23,42,.035);
    }

    .worker-filter-card {
        border-top: 4px solid #4f46e5;
    }

    .worker-list-card {
        border-top: 4px solid #7c3aed;
    }

    .worker-panel-header,
    .worker-list-header {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 10px 12px;
        background: #fff;
        border-bottom: 1px solid #eef2f7;
    }

    .worker-list-header {
        justify-content: space-between;
    }

    .worker-panel-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 32px;
        width: 32px;
        height: 32px;
        color: #4338ca;
        background: #eef2ff;
        border-radius: 9px;
        font-size: .74rem;
    }

    .worker-panel-header h6,
    .worker-list-header h6 {
        margin: 0 0 1px;
        color: #0f172a;
        font-size: .82rem;
        font-weight: 800;
    }

    .worker-panel-header p,
    .worker-list-header p {
        margin: 0;
        color: #64748b;
        font-size: .64rem;
    }

    .worker-result-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 29px;
        height: 29px;
        padding: 0 8px;
        color: #fff;
        background: #4f46e5;
        border-radius: 999px;
        font-size: .7rem;
        font-weight: 800;
    }

    .worker-summary-grid {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 7px;
    }

        .worker-summary-grid > div {
            padding: 8px 9px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
        }

        .worker-summary-grid span,
        .worker-summary-grid strong {
            display: block;
        }

        .worker-summary-grid span {
            color: #64748b;
            font-size: .58rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .worker-summary-grid strong {
            margin-top: 1px;
            color: #0f172a;
            font-size: .88rem;
        }

        .worker-summary-grid .active {
            background: #f0fdf4;
            border-color: #bbf7d0;
        }

            .worker-summary-grid .active strong {
                color: #166534;
            }

        .worker-summary-grid .inactive {
            background: #fef2f2;
            border-color: #fecaca;
        }

            .worker-summary-grid .inactive strong {
                color: #991b1b;
            }

        .worker-summary-grid .directorate {
            background: #eef2ff;
            border-color: #c7d2fe;
        }

            .worker-summary-grid .directorate strong {
                color: #4338ca;
            }

    .worker-search-tip {
        display: flex;
        align-items: flex-start;
        gap: 7px;
        margin-bottom: 11px;
        padding: 8px 9px;
        color: #4338ca;
        background: #eef2ff;
        border: 1px solid #c7d2fe;
        border-radius: 8px;
        font-size: .62rem;
    }

    .compact-label {
        margin-bottom: 3px;
        color: #475569;
        font-size: .67rem;
        font-weight: 700;
    }

