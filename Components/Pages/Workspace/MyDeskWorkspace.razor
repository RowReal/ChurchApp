@page "/workspace/my-desk"
@layout Components.Layout.MainLayout

@using ChurchApp.Services
@using ChurchApp.Components.Shared

@inject AuthService AuthService
@inject ApprovalRequestService ApprovalRequestService
@inject NavigationManager Navigation

<PageTitle>My Desk - BCC ServiceHub</PageTitle>

@if (AuthService.IsAuthenticated)
{
    <div class="worker360-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        <div class="bcc-page-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-clipboard-check me-2"></i>
                    Workspace
                </div>

                <div class="bcc-page-title">
                    My Desk
                </div>

                <div class="bcc-page-subtitle">
                    Create requests, monitor submitted requests
                    and act on approvals assigned to you.
                </div>
            </div>

            <div>
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn"
                        @onclick="GoBack">
                    <i class="fas fa-arrow-left me-2"></i>
                    Dashboard
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="bcc-card">
                <div class="bcc-card-body text-center py-5">
                    <div class="spinner-border text-primary"></div>

                    <div class="mt-3 text-muted">
                        Loading your workspace...
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="my-desk-summary-grid mb-4">

                <div class="my-desk-summary-card">
                    <div class="my-desk-summary-icon pending">
                        <i class="fas fa-hourglass-half"></i>
                    </div>

                    <div>
                        <span>Pending My Action</span>
                        <strong>@pendingApprovalCount</strong>
                    </div>
                </div>

                <div class="my-desk-summary-card">
                    <div class="my-desk-summary-icon returned">
                        <i class="fas fa-reply"></i>
                    </div>

                    <div>
                        <span>Returned Requests</span>
                        <strong>@returnedRequestCount</strong>
                    </div>
                </div>

                <div class="my-desk-summary-card">
                    <div class="my-desk-summary-icon total">
                        <i class="fas fa-briefcase"></i>
                    </div>

                    <div>
                        <span>Total Attention</span>
                        <strong>@myDeskCount</strong>
                    </div>
                </div>

            </div>

            <div class="bcc-card">
                <div class="bcc-card-body">

                    <div class="workspace-section-heading">
                        <div>
                            <h5>Approval Workspace</h5>
                            <p>
                                Select an action below to continue.
                            </p>
                        </div>
                    </div>

                    <div class="row g-3">

                        <div class="col-12 col-md-6 col-xl-4">
                            <WorkspaceActionCard
                                Href="/approvals/new"
                                Icon="fas fa-plus-circle"
                                Title="New Request"
                                Description="Create and submit a new leave, off-service, activity, financial or general request." />
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <WorkspaceActionCard
                                Href="/approvals/my-requests"
                                Icon="fas fa-folder-open"
                                Title="Existing Requests"
                                Description="View and track all requests you have submitted."
                                BadgeCount="@returnedRequestCount" />
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <WorkspaceActionCard
                                Href="/approvals/inbox"
                                Icon="fas fa-inbox"
                                Title="Approval Inbox"
                                Description="Review requests currently waiting for your approval or action."
                                BadgeCount="@pendingApprovalCount" />
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>

        <h4>Please Log In</h4>

        <p>
            You need to be logged in to access My Desk.
        </p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}

@code {
    private int pendingApprovalCount;
    private int returnedRequestCount;
    private int myDeskCount;

    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkspaceAsync();
    }

    private async Task LoadWorkspaceAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            if (AuthService.CurrentWorker == null)
                return;

            var workerId =
                AuthService.CurrentWorker.Id;

            pendingApprovalCount =
                await ApprovalRequestService
                    .GetPendingApprovalCountAsync(workerId);

            returnedRequestCount =
                await ApprovalRequestService
                    .GetReturnedRequestCountAsync(workerId);

            myDeskCount =
                pendingApprovalCount +
                returnedRequestCount;
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load My Desk: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}

<style>
    .my-desk-summary-grid {
        display: grid;
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
        gap: 15px;
    }

    .my-desk-summary-card {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, 0.04);
    }

    .my-desk-summary-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 48px;
        width: 48px;
        height: 48px;
        border-radius: 14px;
        font-size: 1.1rem;
    }

    .my-desk-summary-icon.pending {
        color: #b45309;
        background: #fef3c7;
    }

    .my-desk-summary-icon.returned {
        color: #b91c1c;
        background: #fee2e2;
    }

    .my-desk-summary-icon.total {
        color: #4338ca;
        background: #eef2ff;
    }

    .my-desk-summary-card span {
        display: block;
        margin-bottom: 2px;
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .my-desk-summary-card strong {
        display: block;
        color: #0f172a;
        font-size: 1.45rem;
        font-weight: 800;
    }

    .workspace-section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .workspace-section-heading h5 {
        margin: 0 0 4px;
        color: #0f172a;
        font-weight: 800;
    }

    .workspace-section-heading p {
        margin: 0;
        color: #64748b;
        font-size: 0.86rem;
    }

    @@media (max-width: 768px) {
        .my-desk-summary-grid {
            grid-template-columns: 1fr;
        }

        .my-desk-summary-card {
            padding: 15px;
        }
    }
</style>
