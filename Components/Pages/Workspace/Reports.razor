@page "/workspace/reports"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services

@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Reports & Insights - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access Reports & Insights.</p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else
{
    <div class="worker360-page compact-reports-page">

        <!-- =====================================================
             PAGE HERO
             ===================================================== -->
        <div class="bcc-page-header reports-page-header">

            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-chart-line me-2"></i>
                    Reports & Insights
                </div>

                <div class="bcc-page-title">
                    Reports
                </div>

                <div class="bcc-page-subtitle">
                    Access church operational, attendance, financial and growth reports.
                </div>
            </div>

            <button type="button"
                    class="bcc-btn profile-form-secondary-btn compact-btn"
                    @onclick="GoBack">
                <i class="fas fa-arrow-left me-2"></i>
                Dashboard
            </button>

        </div>


        <!-- =====================================================
             REPORT TILES
             ===================================================== -->
        <div class="workspace-tile-grid">

            @RenderTile(
            "/reports/offering",
                "fas fa-coins",
                "Offering Reports",
                CanViewOperationalReports())

        @RenderTile(
                "/reports/attendance",
                "fas fa-calendar-check",
                "Church Attendance Reports",
                CanViewOperationalReports())

        @RenderTile(
                "/admin/worker-attendance-report",
                "fas fa-user-clock",
                "Worker Attendance Report",
                true)

        @RenderTile(
                "/reports/financial",
                "fas fa-chart-pie",
                "Financial Reports",
                CanViewFinancialReports())

        @RenderTile(
                "/reports/analytics",
                "fas fa-chart-line",
                "Church Analytics",
                CanViewChurchAnalytics())

        @RenderTile(
                "/Workforce/reports",
                "fas fa-file-alt",
                "Growth Reports",
                CanViewGrowthReports())

    </div>

</div>
}


@code {

    // ============================================================
    // REPORT ACCESS
    // ============================================================

    private bool CanViewOperationalReports()
    {
        if (!AuthService.IsAuthenticated ||
            AuthService.CurrentWorker == null)
        {
            return false;
        }

        return
            AuthService.IsInRole("Pastor in Charge") ||
            AuthService.IsInRole("Church Admin") ||
            AuthService.IsInRole("Head of Service") ||
            AuthService.IsInRole("Asst Head of Service") ||
            AuthService.CurrentWorker.CanAccessAdminPanel;
    }


    // ============================================================
    // FINANCIAL REPORT ACCESS
    // ============================================================

    private bool CanViewFinancialReports()
    {
        return
            AuthService.IsInRole("Church Admin") ||
            AuthService.IsInRole("Pastor in Charge");
    }


    // ============================================================
    // CHURCH ANALYTICS ACCESS
    // ============================================================

    private bool CanViewChurchAnalytics()
    {
        return
            AuthService.IsInRole("Church Admin") ||
            AuthService.IsInRole("Pastor in Charge");
    }


    // ============================================================
    // GROWTH REPORT ACCESS
    // ============================================================

    private bool CanViewGrowthReports()
    {
        if (AuthService.CurrentWorker == null)
            return false;

        return
            AuthService.IsInRole("Pastor in Charge") ||
            AuthService.IsInRole("Church Admin") ||
            AuthService.IsInRole("Head of Service") ||
            AuthService.IsInRole("Asst Head of Service") ||
            AuthService.CurrentWorker.CanAccessAdminPanel;
    }


    // ============================================================
    // TILE RENDERER
    // ============================================================

    private RenderFragment RenderTile(
        string href,
        string icon,
        string title,
        bool isEnabled) => builder =>
    {
        var sequence = 0;

        if (isEnabled)
        {
            builder.OpenElement(sequence++, "a");

            builder.AddAttribute(
                sequence++,
                "href",
                href);

            builder.AddAttribute(
                sequence++,
                "class",
                "compact-workspace-tile");
        }
        else
        {
            builder.OpenElement(sequence++, "div");

            builder.AddAttribute(
                sequence++,
                "class",
                "compact-workspace-tile disabled");

            builder.AddAttribute(
                sequence++,
                "title",
                "You do not have access to this report.");

            builder.AddAttribute(
                sequence++,
                "aria-disabled",
                "true");
        }


        // ICON
        builder.OpenElement(sequence++, "div");

        builder.AddAttribute(
            sequence++,
            "class",
            "compact-tile-icon");

        builder.OpenElement(sequence++, "i");

        builder.AddAttribute(
            sequence++,
            "class",
            icon);

        builder.CloseElement();

        builder.CloseElement();


        // TITLE
        builder.OpenElement(sequence++, "div");

        builder.AddAttribute(
            sequence++,
            "class",
            "compact-tile-title");

        builder.AddContent(
            sequence++,
            title);

        builder.CloseElement();


        // ARROW / LOCK
        builder.OpenElement(sequence++, "div");

        builder.AddAttribute(
            sequence++,
            "class",
            "compact-tile-arrow");

        builder.OpenElement(sequence++, "i");

        builder.AddAttribute(
            sequence++,
            "class",
            isEnabled
                ? "fas fa-chevron-right"
                : "fas fa-lock");

        builder.CloseElement();

        builder.CloseElement();


        builder.CloseElement();
    };


    // ============================================================
    // NAVIGATION
    // ============================================================

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}


<style>

    /* ============================================================
               PAGE
               ============================================================ */

    .compact-reports-page {
        max-width: 1400px;
        margin: 0 auto;
        padding-top: 6px;
    }

    .reports-page-header {
        margin-bottom: 14px;
    }

    .compact-btn {
        min-height: 32px;
        padding: 6px 11px;
        font-size: 0.78rem;
    }


    /* ============================================================
               REPORT GRID
               ============================================================ */

    .workspace-tile-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 9px;
    }


    /* ============================================================
               REPORT TILE
               ============================================================ */

    .compact-workspace-tile {
        display: grid;
        grid-template-columns: 36px minmax(0, 1fr) 16px;
        align-items: center;
        gap: 9px;
        min-height: 58px;
        padding: 9px 11px;
        color: inherit;
        text-decoration: none;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 11px;
        box-shadow: 0 3px 10px rgba(15, 23, 42, 0.04);
        transition: transform 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
    }

        .compact-workspace-tile:hover {
            color: inherit;
            text-decoration: none;
            border-color: #c7d2fe;
            box-shadow: 0 7px 18px rgba(15, 23, 42, 0.08);
            transform: translateY(-1px);
        }


        /* ============================================================
               DISABLED TILE
               ============================================================ */

        .compact-workspace-tile.disabled {
            cursor: not-allowed;
            opacity: 0.48;
            background: #f8fafc;
            box-shadow: none;
        }

            .compact-workspace-tile.disabled:hover {
                border-color: #e5e7eb;
                box-shadow: none;
                transform: none;
            }


    /* ============================================================
               ICON
               ============================================================ */

    .compact-tile-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        color: #4338ca;
        background: #eef2ff;
        border-radius: 9px;
        font-size: 0.9rem;
    }

    .compact-workspace-tile.disabled
    .compact-tile-icon {
        color: #64748b;
        background: #e2e8f0;
    }


    /* ============================================================
               TITLE
               ============================================================ */

    .compact-tile-title {
        min-width: 0;
        color: #0f172a;
        font-size: 0.78rem;
        font-weight: 800;
        line-height: 1.2;
    }


    /* ============================================================
               ARROW
               ============================================================ */

    .compact-tile-arrow {
        color: #94a3b8;
        font-size: 0.68rem;
    }


    /* ============================================================
               RESPONSIVE
               ============================================================ */

    @@media (max-width: 1100px) {

        .workspace-tile-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }


    @@media (max-width: 800px) {

        .workspace-tile-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }


    @@media (max-width: 520px) {

        .workspace-tile-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
