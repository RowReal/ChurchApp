    /* Soft green icon shades for Worker Management action cards. */
    .worker-management-workspace :is(.workspace-action-icon, .workspace-action-card-icon, .workspace-card-icon, .my-desk-action-icon, .workspace-tile-icon, .compact-tile-icon, .action-card-icon) {
