@page "/workspace/event-hub"
@layout Components.Layout.MainLayout
@using ChurchApp.Services
@using ChurchApp.Services.Event
@inject AuthService AuthService
@inject PrivilegeService PrivilegeService
@inject AwardService AwardService
@inject NavigationManager Navigation

<PageTitle>Event Hub - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access Event Hub.</p>
        <a href="/login" class="bcc-btn bcc-btn-primary">Go to Login</a>
    </div>
}
else if (IsCheckingPrivilege)
{
    <div class="bcc-empty"><p>Checking Event Management access...</p></div>
}
else
{
    <div class="worker360-page compact-workspace-page">
        <div class="bcc-page-header service-records-page-header">
            <div>
                <div class="bcc-page-subtitle"><i class="fas fa-calendar-alt me-2"></i>Workspace</div>
                <div class="bcc-page-title">Event Hub</div>
                <div class="bcc-page-subtitle">Manage events, registration, attendance, seating and catering.</div>
            </div>
            <button type="button" class="bcc-btn profile-form-secondary-btn compact-btn" @onclick="GoBack">
                <i class="fas fa-arrow-left me-2"></i>Dashboard
            </button>
        </div>
        <div class="workspace-tile-grid">
            @if (CanManageEvents)
            {
                <a href="/event/setup" class="compact-workspace-tile">
                    <div class="compact-tile-icon"><i class="fas fa-map-marker-alt"></i></div>
                    <div class="compact-tile-title">Event Setup</div>
                    <div class="compact-tile-arrow"><i class="fas fa-lock"></i></div>
                </a>
                <button type="button" @onclick='() => Navigation.NavigateTo("/event/fun/admin")' class="compact-workspace-tile" style="width:100%;text-align:left;cursor:pointer;font:inherit;">
                    <div class="compact-tile-icon"><i class="fas fa-gamepad"></i></div>
                    <div class="compact-tile-title">Game Setup &amp; Management</div>
                    <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
                </button>
                <a href="/event/registration-report" class="compact-workspace-tile">
                    <div class="compact-tile-icon"><i class="fas fa-calendar-plus"></i></div>
                    <div class="compact-tile-title">Event Registration Report</div>
                    <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
                </a>
            }

            @if (CanManageAwards)
            {
                <a href="/event/award-setup" class="compact-workspace-tile">
                    <div class="compact-tile-icon"><i class="fas fa-award"></i></div>
                    <div class="compact-tile-title">Award Setup</div>
                    <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
                </a>
            }
            @if (CanManageEvents)
            {
                <a href="/event/seating-setup" class="compact-workspace-tile">
                    <div class="compact-tile-icon"><i class="fas fa-chair"></i></div>
                    <div class="compact-tile-title">Table &amp; Seating Setup</div>
                    <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
                </a>
            }
            <a href="/event/assisted-check-in" class="compact-workspace-tile">
                <div class="compact-tile-icon"><i class="fas fa-map-marker-alt"></i></div>
                <div class="compact-tile-title">Event Check-In</div>
                <div class="compact-tile-arrow"><i class="fas fa-lock"></i></div>
            </a>
            @if (CanManageEvents)
            {
                <a href="/event/check-in-report" class="compact-workspace-tile">
                    <div class="compact-tile-icon"><i class="fas fa-chart-bar"></i></div>
                    <div class="compact-tile-title">Check-In Report</div>
                    <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
                </a>
            }
            @if (CanViewAwardResults)
            {
                <a href="/event/award-results" class="compact-workspace-tile">
                    <div class="compact-tile-icon"><i class="fas fa-chart-pie"></i></div>
                    <div class="compact-tile-title">Award Results</div>
                    <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
                </a>
            }
        </div>
    </div>
}

@code {
    private bool CanManageEvents;
    private bool CanManageAwards;
    private bool CanViewAwardResults;
    private bool IsCheckingPrivilege = true;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.CurrentWorker is { } worker)
        {
            CanManageEvents = await PrivilegeService.HasPrivilegeAsync(
                worker.Id, "Access-Event-Management");
            CanManageAwards = await AwardService.CanManageAsync();
            CanViewAwardResults = await AwardService.CanSeeResultsAsync();
        }
        IsCheckingPrivilege = false;
    }
    private void GoBack() => Navigation.NavigateTo("/");
}

<style>
    .compact-workspace-page {
        max-width: 1400px;
        margin: 0 auto;
        padding-top: 6px;
    }

    .service-records-page-header {
        margin-bottom: 14px;
    }

    .compact-btn {
        min-height: 32px;
        padding: 6px 11px;
        font-size: 0.78rem;
    }

    .workspace-tile-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 9px;
    }

    .compact-workspace-tile {
        display: grid;
        grid-template-columns: 36px minmax(0, 1fr) auto 16px;
        align-items: center;
        gap: 9px;
        min-height: 58px;
        padding: 9px 11px;
        color: inherit;
        text-decoration: none;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 11px;
        box-shadow: 0 3px 10px rgba(15,23,42,.04);
        transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
    }

        .compact-workspace-tile:hover {
            color: inherit;
            text-decoration: none;
            border-color: #a7d7b4;
            box-shadow: 0 7px 18px rgba(15,23,42,.08);
            transform: translateY(-1px);
        }

        .compact-workspace-tile.disabled {
            cursor: not-allowed;
            opacity: .48;
            background: #f8fafc;
            box-shadow: none;
        }

            .compact-workspace-tile.disabled:hover {
                border-color: #e5e7eb;
                box-shadow: none;
                transform: none;
            }

    .compact-tile-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        color: #167347;
        background: #e8f5ed;
        border-radius: 9px;
        font-size: .9rem;
    }

    .compact-workspace-tile.disabled .compact-tile-icon {
        color: #64748b;
        background: #e2e8f0;
    }

    .compact-tile-title {
        min-width: 0;
        color: #0f172a;
        font-size: .78rem;
        font-weight: 800;
        line-height: 1.2;
    }

    .compact-tile-arrow {
        color: #94a3b8;
        font-size: .68rem;
    }

    @@media (max-width: 1100px) {
        .workspace-tile-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 800px) {
        .workspace-tile-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 520px) {
        .workspace-tile-grid {
            grid-template-columns: 1fr;
        }
    }

    /* BCC ServiceHub | unified compact green workspace design */
    .worker360-page {
        --bcc-workspace-green: #145c39;
        --bcc-workspace-green-light: #31845a;
        --bcc-workspace-mint: #eaf6ee;
        --bcc-workspace-border: #d8e8dc;
        color: #18372a;
    }
    .worker360-page .bcc-page-header {
        background: #145c39 !important;
        background-image: linear-gradient(115deg, #145c39 0%, #23774c 100%) !important;
        color: #fff !important;
        border: 1px solid #145c39 !important;
        border-radius: 7px !important;
        padding: 17px 20px !important;
        margin-bottom: 15px !important;
        box-shadow: 0 5px 15px rgba(20, 92, 57, .13) !important;
    }
    .worker360-page .bcc-page-header .bcc-page-title,
    .worker360-page .bcc-page-header .bcc-page-subtitle,
    .worker360-page .bcc-page-header h1,
    .worker360-page .bcc-page-header h2,
    .worker360-page .bcc-page-header h3,
    .worker360-page .bcc-page-header p,
    .worker360-page .bcc-page-header i { color: #fff !important; }
    .worker360-page .bcc-page-header .bcc-page-title {
        font-size: clamp(1.24rem, 1.9vw, 1.65rem) !important;
        font-weight: 800 !important;
        line-height: 1.22 !important;
        letter-spacing: -.025em;
        margin: 3px 0 !important;
    }
    .worker360-page .bcc-page-header .bcc-page-subtitle {
        font-size: .78rem !important;
        line-height: 1.45 !important;
        opacity: .92;
    }
    .worker360-page .bcc-page-header .bcc-btn,
    .worker360-page .bcc-page-header .btn,
    .worker360-page .bcc-page-header a:not(.bcc-page-title) {
        background: #fff !important;
        border: 1px solid rgba(255,255,255,.9) !important;
        color: #145c39 !important;
        border-radius: 5px !important;
        font-size: .77rem !important;
        font-weight: 750 !important;
        padding: 7px 12px !important;
        box-shadow: none !important;
    }
    .worker360-page .bcc-page-header .bcc-btn i,
    .worker360-page .bcc-page-header .btn i,
    .worker360-page .bcc-page-header a i { color: #145c39 !important; }
    .worker360-page .bcc-page-header .bcc-btn:hover,
    .worker360-page .bcc-page-header .btn:hover,
    .worker360-page .bcc-page-header a:hover { background: #eaf6ee !important; }
    .worker360-page .compact-workspace-tile,
    .worker360-page .my-desk-action-card,
    .worker360-page .workspace-tile,
    .worker360-page .bcc-card {
        border-color: #d8e8dc !important;
        border-radius: 7px !important;
        box-shadow: 0 2px 8px rgba(22, 70, 42, .045) !important;
    }
    .worker360-page a.compact-workspace-tile:hover,
    .worker360-page a.my-desk-action-card:hover,
    .worker360-page a.workspace-tile:hover {
        background: #f4faf6 !important;
        border-color: #6cb28a !important;
        box-shadow: 0 5px 13px rgba(20,92,57,.09) !important;
        transform: translateY(-1px);
    }
    .worker360-page .compact-tile-icon,
    .worker360-page .my-desk-action-icon,
    .worker360-page .workspace-tile-icon {
        background: #eaf6ee !important;
        color: #17633d !important;
        border-radius: 6px !important;
    }
    .worker360-page .compact-tile-icon i,
    .worker360-page .my-desk-action-icon i,
    .worker360-page .workspace-tile-icon i { color: #17633d !important; }
    .worker360-page .compact-tile-title,
    .worker360-page .my-desk-action-content h5,
    .worker360-page .workspace-section-heading h5,
    .worker360-page .workspace-heading h6,
    .worker360-page .my-desk-section-heading h6 { color: #174a30 !important; }
    .worker360-page .compact-tile-arrow,
    .worker360-page .my-desk-action-arrow { color: #31845a !important; }
    .worker360-page .my-desk-actions-card,
    .worker360-page .setup-workspace-card { border-top: 3px solid #31845a !important; }
    .worker360-page .my-desk-summary-strip .attention {
        background: #eaf6ee !important;
        border-color: #b9ddc6 !important;
    }
    .worker360-page .my-desk-summary-strip .attention strong { color: #145c39 !important; }
    .worker360-page .bcc-btn-primary,
    .worker360-page .btn-primary { background: #145c39 !important; border-color: #145c39 !important; color: #fff !important; }
    .worker360-page .bcc-btn-primary:hover,
    .worker360-page .btn-primary:hover { background: #23774c !important; border-color: #23774c !important; }
    .worker360-page .form-control:focus,
    .worker360-page .form-select:focus { border-color: #31845a !important; box-shadow: 0 0 0 .15rem rgba(49,132,90,.14) !important; }
    .worker360-page .table thead th { background: #eaf6ee !important; color: #174a30 !important; border-color: #d8e8dc !important; }
    .worker360-page .table td { vertical-align: middle; }
    .worker360-page .card { border-radius: 7px; }
    .worker360-page .card-header { background: #f0f8f3; color: #174a30; }
    @@media (max-width: 700px) {
        .worker360-page .bcc-page-header { padding: 14px 15px !important; gap: 10px; }
        .worker360-page .bcc-page-header .bcc-page-title { font-size: 1.24rem !important; }
    }
</style>














































