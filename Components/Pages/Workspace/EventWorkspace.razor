@page "/workspace/event-hub"
@layout Components.Layout.MainLayout
@using ChurchApp.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Event Hub - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access Event Hub.</p>
        <a href="/login" class="bcc-btn bcc-btn-primary">Go to Login</a>
    </div>
}
else
{
    <div class="worker360-page compact-workspace-page">
        <div class="bcc-page-header service-records-page-header">
            <div>
                <div class="bcc-page-subtitle"><i class="fas fa-calendar-alt me-2"></i>Workspace</div>
                <div class="bcc-page-title">Event Hub</div>
                <div class="bcc-page-subtitle">Manage events, registration, attendance, seating and catering.</div>
            </div>
            <button type="button" class="bcc-btn profile-form-secondary-btn compact-btn" @onclick="GoBack">
                <i class="fas fa-arrow-left me-2"></i>Dashboard
            </button>
        </div>
        <div class="workspace-tile-grid">
            @if (IsAdmin)
            {
                <a href="/event/registration-report" class="compact-workspace-tile">
                    <div class="compact-tile-icon"><i class="fas fa-calendar-plus"></i></div>
                    <div class="compact-tile-title">Event Report</div>
                    <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
                </a>
            }

            <div class="compact-workspace-tile disabled" title="Coming in the next stage">
                <div class="compact-tile-icon"><i class="fas fa-user-check"></i></div>
                <div class="compact-tile-title">My Event Registration</div>
                <div class="compact-tile-arrow"><i class="fas fa-lock"></i></div>
            </div>
            @if (IsAdmin)
            {
                <div class="compact-workspace-tile disabled" title="Coming in the next stage">
                    <div class="compact-tile-icon"><i class="fas fa-users"></i></div>
                    <div class="compact-tile-title">Assisted Registration</div>
                    <div class="compact-tile-arrow"><i class="fas fa-lock"></i></div>
                </div>
                <a href="/event/seating-setup" class="compact-workspace-tile">
                    <div class="compact-tile-icon"><i class="fas fa-chair"></i></div>
                    <div class="compact-tile-title">Table &amp; Seating Setup</div>
                    <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
                </a>
            }
            <div class="compact-workspace-tile disabled" title="Coming in a later stage">
                <div class="compact-tile-icon"><i class="fas fa-map-marker-alt"></i></div>
                <div class="compact-tile-title">Event Check-In</div>
                <div class="compact-tile-arrow"><i class="fas fa-lock"></i></div>
            </div>
            @if (IsAdmin)
            {
                <div class="compact-workspace-tile disabled" title="Coming in a later stage">
                    <div class="compact-tile-icon"><i class="fas fa-utensils"></i></div>
                    <div class="compact-tile-title">Food &amp; Catering</div>
                    <div class="compact-tile-arrow"><i class="fas fa-lock"></i></div>
                </div>
                <div class="compact-workspace-tile disabled" title="Coming in a later stage">
                    <div class="compact-tile-icon"><i class="fas fa-chart-bar"></i></div>
                    <div class="compact-tile-title">Event Reports</div>
                    <div class="compact-tile-arrow"><i class="fas fa-lock"></i></div>
                </div>
            }
        </div>
    </div>
}

@code {
    private bool IsAdmin => AuthService.IsInRole(AuthService.Roles.ChurchAdmin);
    private void GoBack() => Navigation.NavigateTo("/");
}

<style>
    .compact-workspace-page {
        max-width: 1400px;
        margin: 0 auto;
        padding-top: 6px;
    }

    .service-records-page-header {
        margin-bottom: 14px;
    }

    .compact-btn {
        min-height: 32px;
        padding: 6px 11px;
        font-size: 0.78rem;
    }

    .workspace-tile-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 9px;
    }

    .compact-workspace-tile {
        display: grid;
        grid-template-columns: 36px minmax(0, 1fr) auto 16px;
        align-items: center;
        gap: 9px;
        min-height: 58px;
        padding: 9px 11px;
        color: inherit;
        text-decoration: none;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 11px;
        box-shadow: 0 3px 10px rgba(15,23,42,.04);
        transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
    }

        .compact-workspace-tile:hover {
            color: inherit;
            text-decoration: none;
            border-color: #a7d7b4;
            box-shadow: 0 7px 18px rgba(15,23,42,.08);
            transform: translateY(-1px);
        }

        .compact-workspace-tile.disabled {
            cursor: not-allowed;
            opacity: .48;
            background: #f8fafc;
            box-shadow: none;
        }

            .compact-workspace-tile.disabled:hover {
                border-color: #e5e7eb;
                box-shadow: none;
                transform: none;
            }

    .compact-tile-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        color: #167347;
        background: #e8f5ed;
        border-radius: 9px;
        font-size: .9rem;
    }

    .compact-workspace-tile.disabled .compact-tile-icon {
        color: #64748b;
        background: #e2e8f0;
    }

    .compact-tile-title {
        min-width: 0;
        color: #0f172a;
        font-size: .78rem;
        font-weight: 800;
        line-height: 1.2;
    }

    .compact-tile-arrow {
        color: #94a3b8;
        font-size: .68rem;
    }

    @@media (max-width: 1100px) {
        .workspace-tile-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 800px) {
        .workspace-tile-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 520px) {
        .workspace-tile-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

