@page "/workspace/account-remittance"
@layout Components.Layout.MainLayout
@using ChurchApp.Services
@using ChurchApp.Data
@using ChurchApp.Models.Finance
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject AuthService AuthService
@inject PrivilegeService PrivilegeService
@inject NavigationManager Navigation

<PageTitle>Account &amp; Remittance - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i><h4>Please Log In</h4>
        <p>You need to be logged in to access Account &amp; Remittance.</p>
        <a href="/login" class="bcc-btn bcc-btn-primary">Go to Login</a>
    </div>
}
else if (isLoadingAccess)
{
    <div class="bcc-empty"><span class="spinner-border text-success"></span><p>Checking access...</p></div>
}
else if (!CanAccessWorkspace())
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i><h4>Access Denied</h4>
        <p>You do not currently have access to Account &amp; Remittance.</p>
        <button type="button" class="bcc-btn bcc-btn-primary" @onclick="GoBack">Return to Dashboard</button>
    </div>
}
else
{
    <div class="worker360-page compact-workspace-page">
        <div class="bcc-page-header service-records-page-header">
            <div>
                <div class="bcc-page-subtitle"><i class="fas fa-wallet me-2"></i>Workspace</div>
                <div class="bcc-page-title">Account &amp; Remittance</div>
                <div class="bcc-page-subtitle">Bank account transactions, financial records and remittance management.</div>
            </div>
            <button type="button" class="bcc-btn profile-form-secondary-btn compact-btn" @onclick="GoBack">
                <i class="fas fa-arrow-left me-2"></i>Dashboard
            </button>
        </div>
        <div class="workspace-tile-grid">
            <a href="/finance/opening-balances" class="compact-workspace-tile">
                <div class="compact-tile-icon"><i class="fas fa-landmark"></i></div>
                <div class="compact-tile-title">Setup Opening Balance</div>
                @if (IsAdmin && unlockedCount > 0)
                {
                    <span class="compact-tile-badge" title="Accounts awaiting opening balance lock">@unlockedCount</span>
                }
                <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
            </a>
            <a href="/finance/bank-journal" class="compact-workspace-tile">
                <div class="compact-tile-icon"><i class="fas fa-book"></i></div>
                <div class="compact-tile-title">Bank Journal Entries</div>
                <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
            </a>
            <a href="/finance/post-approved-collections" class="compact-workspace-tile">
                <div class="compact-tile-icon"><i class="fas fa-file-invoice-dollar"></i></div>
                <div class="compact-tile-title">Move Collection To Bank</div>
                @if (IsAdmin && unpostedCount > 0)
                {
                    <span class="compact-tile-badge" title="Approved collections awaiting bank posting">@unpostedCount</span>
                }
                <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
            </a>
            <a href="/finance/bank-journal-approvals" class="compact-workspace-tile">
                <div class="compact-tile-icon"><i class="fas fa-clipboard-check"></i></div>
                <div class="compact-tile-title">Approve Bank Journal</div>
                @if (IsPastor && pendingCount > 0)
                {
                    <span class="compact-tile-badge" title="Journal entries awaiting Pastor approval">@pendingCount</span>
                }
                <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
            </a>
            @if (IsAdmin)
            {
                <a href="/finance/returned-bank-entries" class="compact-workspace-tile">
                    <div class="compact-tile-icon"><i class="fas fa-undo-alt"></i></div>
                    <div class="compact-tile-title">Return/Reject Entries</div>
                    @if (returnedCount > 0)
                    {
                        <span class="compact-tile-badge" title="Returned or rejected entries requiring action">@returnedCount</span>
                    }
                    <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
                </a>
                <a href="/finance/bank-journal-corrections" class="compact-workspace-tile">
                    <div class="compact-tile-icon"><i class="fas fa-exchange-alt"></i></div>
                    <div class="compact-tile-title">Reverse / Adjust Bank Entries</div>
                    <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
                </a>
            }
            <a href="/finance/church-account-balances" class="compact-workspace-tile">
                <div class="compact-tile-icon"><i class="fas fa-balance-scale"></i></div>
                <div class="compact-tile-title">Church Account Balances</div>
                <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
            </a>
            @if (IsAdmin)
            {
                <a href="/finance/monthly-remittance" class="compact-workspace-tile">
                    <div class="compact-tile-icon"><i class="fas fa-calendar-check"></i></div>
                    <div class="compact-tile-title">Monthly Remittance Processing</div>
                    <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
                </a>
                <a href="/finance/expenditure-setup" class="compact-workspace-tile">
                    <div class="compact-tile-icon"><i class="fas fa-sliders-h"></i></div>
                    <div class="compact-tile-title">Expenditure Setup</div>
                    <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
                </a>
                <a href="/finance/expenditure-entry" class="compact-workspace-tile">
                    <div class="compact-tile-icon"><i class="fas fa-file-invoice"></i></div>
                    <div class="compact-tile-title">Record Expenditure</div>
                    <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
                </a>
            }
            @if (IsAuditor || IsPastor)
            {
                <a href="/finance/expenditure-approvals" class="compact-workspace-tile">
                    <div class="compact-tile-icon"><i class="fas fa-user-check"></i></div>
                    <div class="compact-tile-title">Approve Expenditure</div>
                    <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
                </a>
            }
        </div>
    </div>
}

@code {
    private int returnedCount, unlockedCount, unpostedCount, pendingCount;
    private bool IsAuditor;
    private bool isLoadingAccess = true;
    private bool IsAdmin => AuthService.IsInRole(AuthService.Roles.ChurchAdmin);
    private bool IsPastor => AuthService.IsInRole(AuthService.Roles.PastorInCharge);
    private bool CanAccessWorkspace() => IsAdmin || IsPastor || IsAuditor;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!AuthService.IsAuthenticated) return;
            var currentWorkerId = AuthService.CurrentWorker?.WorkerId;
            if (!string.IsNullOrWhiteSpace(currentWorkerId))
            {
                var workerDbId = await Db.Workers.AsNoTracking()
                    .Where(w => w.WorkerId == currentWorkerId)
                    .Select(w => (int?)w.Id)
                    .FirstOrDefaultAsync();
                if (workerDbId.HasValue)
                    IsAuditor = await PrivilegeService.HasPrivilegeAsync(
                        workerDbId.Value, PrivilegeService.ApproveChurchExpenditure);
            }
            if (!CanAccessWorkspace()) return;
            if (IsAdmin)
            {
                if (!string.IsNullOrWhiteSpace(currentWorkerId))
                {
                    returnedCount = await Db.BankAccountJournals.AsNoTracking()
                        .CountAsync(entry =>
                            (entry.Status == BankJournalStatus.Returned ||
                             entry.Status == BankJournalStatus.Rejected) &&
                            entry.InitiatedByWorkerId == currentWorkerId);
                }
                unlockedCount = await Db.BankAccounts.AsNoTracking()
                    .CountAsync(account => account.IsActive && !account.IsOpeningBalanceLocked);
                unpostedCount = await Db.ChurchCollectionRecords.AsNoTracking()
                    .CountAsync(collection =>
                        collection.Status == ChurchCollectionService.StatusApproved &&
                        !collection.IsRemoved &&
                        !Db.BankAccountJournals.Any(entry => entry.SourceCollectionId == collection.Id));
            }
            if (IsPastor)
                pendingCount = await Db.BankAccountJournals.AsNoTracking()
                    .CountAsync(entry => entry.Status == BankJournalStatus.PendingApproval);
        }
        finally { isLoadingAccess = false; }
    }
    private void GoBack() => Navigation.NavigateTo("/");
}
<style>
    .compact-workspace-page {
        max-width: 1400px;
        margin: 0 auto;
        padding-top: 6px;
        --bcc-green: #145c39;
    }

        .compact-workspace-page .bcc-page-header {
            background: linear-gradient(115deg,#145c39,#23774c) !important;
            color: #fff !important;
            border: 1px solid #145c39 !important;
            border-radius: 7px !important;
            padding: 17px 20px !important;
            margin-bottom: 15px !important;
            box-shadow: 0 5px 15px rgba(20,92,57,.13) !important;
        }

            .compact-workspace-page .bcc-page-header .bcc-page-title {
                color: #fff !important;
                font-size: 1.5rem;
                font-weight: 800;
            }

            .compact-workspace-page .bcc-page-header .bcc-page-subtitle {
                color: #fff !important;
                font-size: .78rem;
                opacity: .92;
            }

            .compact-workspace-page .bcc-page-header .bcc-btn {
                background: #fff !important;
                color: #145c39 !important;
                border-radius: 5px;
                padding: 7px 12px;
            }

    .workspace-tile-grid {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 9px;
    }

    .compact-workspace-tile {
        display: grid;
        grid-template-columns: 36px minmax(0,1fr) auto 16px;
        align-items: center;
        gap: 9px;
        min-height: 58px;
        padding: 9px 11px;
        color: #174a30;
        text-decoration: none;
        background: #fff;
        border: 1px solid #d8e8dc;
        border-radius: 7px;
        box-shadow: 0 2px 8px rgba(22,70,42,.045);
        transition: transform .16s,border-color .16s,box-shadow .16s;
    }

        .compact-workspace-tile:hover {
            color: #174a30;
            text-decoration: none;
            background: #f4faf6;
            border-color: #6cb28a;
            box-shadow: 0 5px 13px rgba(20,92,57,.09);
            transform: translateY(-1px);
        }

    .compact-tile-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: #eaf6ee;
        color: #17633d;
        border-radius: 6px;
        font-size: .9rem;
    }

    .compact-tile-title {
        min-width: 0;
        font-size: .78rem;
        font-weight: 800;
        line-height: 1.2;
    }

    .compact-tile-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        padding: 0 6px;
        color: #fff;
        background: #dc2626;
        border-radius: 999px;
        font-size: .67rem;
        font-weight: 800;
    }

    .compact-tile-arrow {
        color: #31845a;
        font-size: .68rem;
    }

    @@media (max-width:1100px) {
        .workspace-tile-grid {
            grid-template-columns: repeat(3,minmax(0,1fr));
        }
    }

    @@media (max-width:800px) {
        .workspace-tile-grid {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }
    }

    @@media (max-width:520px) {
        .workspace-tile-grid {
            grid-template-columns: 1fr;
        }

        .compact-workspace-page .bcc-page-header {
            padding: 14px 15px !important;
        }
    }
</style>
