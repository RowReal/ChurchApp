@page "/workspace/account-remittance"
@layout Components.Layout.MainLayout
@using ChurchApp.Services
@using ChurchApp.Data
@using ChurchApp.Models.Finance
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Account &amp; Remittance - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access Account &amp; Remittance.</p>
        <a href="/login" class="bcc-btn bcc-btn-primary">Go to Login</a>
    </div>
}
else if (!CanAccessWorkspace())
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>
        <p>You do not currently have access to Account &amp; Remittance.</p>
        <button type="button" class="bcc-btn bcc-btn-primary" @onclick="GoBack">Return to Dashboard</button>
    </div>
}
else
{
    <div class="worker360-page compact-workspace-page">
        <div class="bcc-page-header service-records-page-header">
            <div>
                <div class="bcc-page-subtitle"><i class="fas fa-wallet me-2"></i>Workspace</div>
                <div class="bcc-page-title">Account &amp; Remittance</div>
                <div class="bcc-page-subtitle">Bank account transactions, financial records and remittance management.</div>
            </div>
            <button type="button" class="bcc-btn profile-form-secondary-btn compact-btn" @onclick="GoBack">
                <i class="fas fa-arrow-left me-2"></i>Dashboard
            </button>
        </div>
        <div class="workspace-tile-grid">
            <a href="/finance/opening-balances" class="compact-workspace-tile">
                <div class="compact-tile-icon"><i class="fas fa-landmark"></i></div>
                <div class="compact-tile-title">Setup Opening Balance</div>
                @if (IsAdmin && unlockedCount > 0)
                {
                    <span class="compact-tile-badge" title="Accounts awaiting opening balance lock">@unlockedCount</span>
                }
                <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
            </a>

            <a href="/finance/bank-journal" class="compact-workspace-tile">
                <div class="compact-tile-icon"><i class="fas fa-book"></i></div>
                <div class="compact-tile-title">Bank Journal Entries</div>
                <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
            </a>

            <a href="/finance/post-approved-collections" class="compact-workspace-tile">
                <div class="compact-tile-icon"><i class="fas fa-file-invoice-dollar"></i></div>
                <div class="compact-tile-title">Move Collection To Bank</div>
                @if (IsAdmin && unpostedCount > 0)
                {
                    <span class="compact-tile-badge" title="Approved collections awaiting bank posting">@unpostedCount</span>
                }
                <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
            </a>

            <a href="/finance/bank-journal-approvals" class="compact-workspace-tile">
                <div class="compact-tile-icon"><i class="fas fa-clipboard-check"></i></div>
                <div class="compact-tile-title">Approve Bank Journal</div>
                @if (IsPastor && pendingCount > 0)
                {
                    <span class="compact-tile-badge" title="Journal entries awaiting Pastor approval">@pendingCount</span>
                }
                <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
            </a>

            @if (IsAdmin)
            {
                <a href="/finance/returned-bank-entries" class="compact-workspace-tile">
                    <div class="compact-tile-icon"><i class="fas fa-undo-alt"></i></div>
                    <div class="compact-tile-title">Return/Reject Entries</div>
                    @if (returnedCount > 0)
                    {
                        <span class="compact-tile-badge" title="Returned or rejected entries requiring action">@returnedCount</span>
                    }
                    <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
                </a>
            }
            @if (IsAdmin)
            {
                <a href="/finance/bank-journal-corrections" class="compact-workspace-tile">
                    <div class="compact-tile-icon"><i class="fas fa-exchange-alt"></i></div>
                    <div class="compact-tile-title">Reverse / Adjust Bank Entries</div>
                    <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
                </a>
            }
            <a href="/finance/church-account-balances" class="compact-workspace-tile">
                <div class="compact-tile-icon"><i class="fas fa-balance-scale"></i></div>
                <div class="compact-tile-title">Church Account Balances</div>
                <div class="compact-tile-arrow"><i class="fas fa-chevron-right"></i></div>
            </a>
            @* Add additional Account & Remittance menu cards here as modules are completed. *@
        </div>
    </div>
}

@code {
    #region Page State and Computed Properties

    private int returnedCount;
    private int unlockedCount;
    private int unpostedCount;
    private int pendingCount;

    private bool IsAdmin => AuthService.IsInRole(AuthService.Roles.ChurchAdmin);

    private bool IsPastor => AuthService.IsInRole(AuthService.Roles.PastorInCharge);

    #endregion

    #region Can Access Workspace

    private bool CanAccessWorkspace()
    {
        return IsAdmin || IsPastor;
    }

    #endregion

    #region On Initialized

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated || !CanAccessWorkspace())
        {
            return;
        }

        if (IsAdmin)
        {
            var workerId = AuthService.CurrentWorker?.WorkerId;

            if (!string.IsNullOrWhiteSpace(workerId))
            {
                returnedCount = await Db.BankAccountJournals
                    .AsNoTracking()
                    .CountAsync(entry =>
                        (entry.Status == BankJournalStatus.Returned ||
                         entry.Status == BankJournalStatus.Rejected) &&
                        entry.InitiatedByWorkerId == workerId);
            }

            unlockedCount = await Db.BankAccounts
                .AsNoTracking()
                .CountAsync(account =>
                    account.IsActive &&
                    !account.IsOpeningBalanceLocked);

            unpostedCount = await Db.ChurchCollectionRecords
                .AsNoTracking()
                .CountAsync(collection =>
                    collection.Status == ChurchCollectionService.StatusApproved &&
                    !collection.IsRemoved &&
                    !Db.BankAccountJournals.Any(entry =>
                        entry.SourceCollectionId == collection.Id));
        }

        if (IsPastor)
        {
            pendingCount = await Db.BankAccountJournals
                .AsNoTracking()
                .CountAsync(entry =>
                    entry.Status == BankJournalStatus.PendingApproval);
        }
    }

    #endregion

    #region Go Back

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
    #endregion
}
<style>
    /* Page styling: readable declarations and responsive rules. */
    .compact-workspace-page {
        max-width: 1400px;
        margin: 0 auto;
        padding-top: 6px;
    }

    .service-records-page-header {
        margin-bottom: 14px;
    }

    .compact-btn {
        min-height: 32px;
        padding: 6px 11px;
        font-size: 0.78rem;
    }

    .workspace-tile-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 9px;
    }

    .compact-workspace-tile {
        display: grid;
        grid-template-columns: 36px minmax(0, 1fr) auto 16px;
        align-items: center;
        gap: 9px;
        min-height: 58px;
        padding: 9px 11px;
        color: inherit;
        text-decoration: none;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 11px;
        box-shadow: 0 3px 10px rgba(15, 23, 42, 0.04);
        transition: transform 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
    }

        .compact-workspace-tile:hover {
            color: inherit;
            text-decoration: none;
            border-color: #c7d2fe;
            box-shadow: 0 7px 18px rgba(15, 23, 42, 0.08);
            transform: translateY(-1px);
        }

        .compact-workspace-tile.disabled {
            cursor: not-allowed;
            opacity: 0.48;
            background: #f8fafc;
            box-shadow: none;
        }

            .compact-workspace-tile.disabled:hover {
                border-color: #e5e7eb;
                box-shadow: none;
                transform: none;
            }

    .compact-tile-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        color: #4338ca;
        background: #eef2ff;
        border-radius: 9px;
        font-size: 0.9rem;
    }

    .compact-workspace-tile.disabled
    .compact-tile-icon {
        color: #64748b;
        background: #e2e8f0;
    }

    .compact-tile-title {
        min-width: 0;
        color: #0f172a;
        font-size: 0.78rem;
        font-weight: 800;
        line-height: 1.2;
    }

    .compact-tile-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        padding: 0 6px;
        color: #ffffff;
        background: #dc2626;
        border-radius: 999px;
        font-size: 0.67rem;
        font-weight: 800;
    }

    .compact-tile-arrow {
        color: #94a3b8;
        font-size: 0.68rem;
    }

    @@media (max-width: 1100px) {
        .workspace-tile-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 800px) {
        .workspace-tile-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 520px) {
        .workspace-tile-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
