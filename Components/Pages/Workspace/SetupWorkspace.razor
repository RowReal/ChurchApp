@page "/workspace/setup"
@layout Components.Layout.MainLayout

@using ChurchApp.Components.Shared
@using ChurchApp.Services

@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>System Setup - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to log in to access System Setup.</p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else if (!CanAccessWorkspace())
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>
        <p>You do not have permission to access System Setup.</p>

        <button type="button"
                class="bcc-btn bcc-btn-primary"
                @onclick="GoBack">
            Return to Dashboard
        </button>
    </div>
}
else
{
    <div class="worker360-page setup-workspace-page">

        <div class="bcc-page-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-cogs me-2"></i>
                    Administration Workspace
                </div>

                <div class="bcc-page-title">
                    System Setup
                </div>

                <div class="bcc-page-subtitle">
                    Configure the organisational structure, workflow and church content.
                </div>
            </div>

            <button type="button"
                    class="bcc-btn profile-form-secondary-btn compact-btn"
                    @onclick="GoBack">
                <i class="fas fa-arrow-left me-2"></i>
                Dashboard
            </button>
        </div>

        <div class="bcc-card setup-workspace-card">
            <div class="bcc-card-body p-3">

                <div class="workspace-heading">
                    <h6>Setup Functions</h6>
                    <p>Select a setup function to continue.</p>
                </div>

                <div class="row g-3">
                    @if (CanManageOrganisationSetup())
                    {
                         <div class="col-12 col-md-6 col-xl-4">
    <WorkspaceActionCard Href="/admin/get-my-location"
                         Icon="fas fa-building"
                         Title="Get My Location"
                         Description="Get Current Location For Setup." />
</div>
                   <div class="col-12 col-md-6 col-xl-4">
    <WorkspaceActionCard Href="/admin/directorate-setup"
                         Icon="fas fa-building"
                         Title="Directorate Setup"
                         Description="Create and manage church directorates." />
</div>

<div class="col-12 col-md-6 col-xl-4">
    <WorkspaceActionCard Href="/admin/supervisory-clusters"
                         Icon="fas fa-diagram-project"
                         Title="Supervisory Clusters"
                         Description="Configure supervisory clusters, Cluster Heads and Directorate allocations." />
</div>

<div class="col-12 col-md-6 col-xl-4">
    <WorkspaceActionCard Href="/admin/department-setup"
                         Icon="fas fa-sitemap"
                         Title="Department Setup"
                         Description="Create and manage departments and units." />
</div>

                    <div class="col-12 col-md-6 col-xl-4">
                        <WorkspaceActionCard Href="/admin/role-setup"
                                             Icon="fas fa-user-tag"
                                             Title="Role Setup"
                                             Description="Create and manage workforce roles." />
                    </div>

                    <div class="col-12 col-md-6 col-xl-4">
                        <WorkspaceActionCard Href="/admin/workflow-setup"
                                             Icon="fas fa-project-diagram"
                                             Title="Workflow Setup"
                                             Description="Configure approval and operational workflows." />
                    </div>

                    <div class="col-12 col-md-6 col-xl-4">
                        <WorkspaceActionCard Href="/admin/church-notices"
                                             Icon="fas fa-bullhorn"
                                             Title="Church Notices"
                                             Description="Create and manage church notices." />
                    </div>

                    <div class="col-12 col-md-6 col-xl-4">
                        <WorkspaceActionCard Href="/admin/verse-of-the-day"
                                             Icon="fas fa-bible"
                                             Title="Verse of the Day"
                                             Description="Manage the daily Bible verse." />
                    </div>

                    <div class="col-12 col-md-6 col-xl-4">
                        <WorkspaceActionCard Href="/admin/prayer-focus"
                                             Icon="fas fa-praying-hands"
                                             Title="Prayer Focus"
                                             Description="Create and manage prayer focus content." />
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
    <WorkspaceActionCard Href="/admin/worker-attendance-settings"
                         Icon="fas fa-map-marker-alt"
                         Title="Worker Attendance Setup"
                         Description="Configure the authorised location and GPS radius for worker attendance." />
</div>
<div class="col-12 col-md-6 col-xl-4">
    <WorkspaceActionCard Href="/admin/services"
                         Icon="fas fa-calendar-alt"
                         Title="Service Management"
                         Description="Create and manage church services, schedules and worker attendance windows." />
</div>
<div class="col-12 col-md-6 col-xl-4">
    <WorkspaceActionCard Href="/worker-attendance"
                         Icon="fas fa-user-check"
                         Title="Worker Attendance"
                         Description="Open the worker attendance register to test sign-in, sign-out and location validation." />
</div>
@* <div class="col-12 col-md-6 col-xl-4">
    <WorkspaceActionCard Href="/event/setup"
                         Icon="fas fa-calendar-check"
                         Title="Event Setup"
                         Description="Create and manage church events and registration periods." />
</div> *@
                    }
                    @if (CanAccessFinanceSetup())
                    {
                        <div class="col-12">
                            <div class="workspace-section-divider">
                                <span>
                                    <i class="fas fa-coins me-2"></i>
                                    Finance Configuration
                                </span>
                            </div>
                        </div>
                    }

                    @if (CanManageBankAccounts())
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <WorkspaceActionCard Href="/finance/bank-accounts"
                                                 Icon="fas fa-university"
                                                 Title="Bank Account Setup"
                                                 Description="Configure church bank accounts and their permitted uses." />
                        </div>
                         <div class="col-12 col-md-6 col-xl-4">
                            <WorkspaceActionCard Href="/finance/expenditure-setup"
                                                 Icon="fas fa-money-bill-wave"
                                                 Title="Expenditure Setup"
                                                 Description="Configure church bank accounts and their permitted uses." />
                        </div>

                    }

                    @if (CanManageIncomeCategories())
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <WorkspaceActionCard Href="/finance/income-categories"
                                                 Icon="fas fa-tags"
                                                 Title="Income Category Setup"
                                                 Description="Create broad categories for church income." />
                        </div>
                    }

                    @if (CanManageIncomeTypes())
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <WorkspaceActionCard Href="/finance/income-types"
                                                 Icon="fas fa-list-alt"
                                                 Title="Income Type Setup"
                                                 Description="Define specific income types and their default bank accounts." />
                        </div>
                    }

                    @if (CanManageRemittanceRules())
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <WorkspaceActionCard Href="/finance/remittance-elements"
                                                 Icon="fas fa-layer-group"
                                                 Title="Setup Remiitance Type"
                                                 Description="Create and manage remittance types and their active status." />
                        </div>
                    }

                    @if (CanManageRemittanceRules())
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <WorkspaceActionCard Href="/finance/remittance-rules"
                                                 Icon="fas fa-percentage"
                                                 Title="Remittance Rule Setup"
                                                 Description="Configure effective remittance percentages and rules." />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool CanAccessWorkspace()
    {
        return
            AuthService.IsAuthenticated &&
            (
                AuthService.IsInRole("Church Admin") ||
                AuthService.IsInRole("Pastor in Charge") ||
                 CanAccessFinanceSetup()
            );
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
    private bool CanAccessFinanceSetup()
    {
        return
            CanManageBankAccounts() ||
            CanManageIncomeCategories() ||
            CanManageIncomeTypes() ||
            CanManageRemittanceRules();
    }

    private bool CanManageBankAccounts()
    {
        return
            AuthService.IsInRole("Church Admin") ||
            AuthService.IsInRole("Pastor in Charge") ||
            AuthService.IsInRole("Finance Head");
    }

    private bool CanManageIncomeCategories()
    {
        return
            AuthService.IsInRole("Church Admin") ||
            AuthService.IsInRole("Pastor in Charge") ||
            AuthService.IsInRole("Finance Head");
    }

    private bool CanManageIncomeTypes()
    {
        return
            AuthService.IsInRole("Church Admin") ||
            AuthService.IsInRole("Pastor in Charge") ||
            AuthService.IsInRole("Finance Head");
    }

    private bool CanManageRemittanceRules()
    {
        return
            AuthService.IsInRole("Church Admin") ||
            AuthService.IsInRole("Pastor in Charge") ||
            AuthService.IsInRole("Finance Head");
    }
    private bool CanManageOrganisationSetup()
{
    return
        AuthService.IsInRole("Church Admin") ||
        AuthService.IsInRole("Pastor in Charge");
}
}

<style>
    .setup-workspace-page {
        max-width: 1300px;
        margin: 0 auto;
    }

    .compact-btn {
        min-height: 32px;
        padding: 6px 11px;
        font-size: 0.78rem;
    }

    .setup-workspace-card {
        overflow: hidden;
        border-top: 4px solid #7c3aed;
    }

    .workspace-heading {
        margin-bottom: 12px;
    }

        .workspace-heading h6 {
            margin: 0 0 2px;
            color: #0f172a;
            font-size: 0.86rem;
            font-weight: 800;
        }

        .workspace-heading p {
            margin: 0;
            color: #64748b;
            font-size: 0.67rem;
        }

    /* BCC ServiceHub | unified compact green workspace design */
    .worker360-page {
        --bcc-workspace-green: #145c39;
        --bcc-workspace-green-light: #31845a;
        --bcc-workspace-mint: #eaf6ee;
        --bcc-workspace-border: #d8e8dc;
        color: #18372a;
    }
    .worker360-page .bcc-page-header {
        background: #145c39 !important;
        background-image: linear-gradient(115deg, #145c39 0%, #23774c 100%) !important;
        color: #fff !important;
        border: 1px solid #145c39 !important;
        border-radius: 7px !important;
        padding: 17px 20px !important;
        margin-bottom: 15px !important;
        box-shadow: 0 5px 15px rgba(20, 92, 57, .13) !important;
    }
    .worker360-page .bcc-page-header .bcc-page-title,
    .worker360-page .bcc-page-header .bcc-page-subtitle,
    .worker360-page .bcc-page-header h1,
    .worker360-page .bcc-page-header h2,
    .worker360-page .bcc-page-header h3,
    .worker360-page .bcc-page-header p,
    .worker360-page .bcc-page-header i { color: #fff !important; }
    .worker360-page .bcc-page-header .bcc-page-title {
        font-size: clamp(1.24rem, 1.9vw, 1.65rem) !important;
        font-weight: 800 !important;
        line-height: 1.22 !important;
        letter-spacing: -.025em;
        margin: 3px 0 !important;
    }
    .worker360-page .bcc-page-header .bcc-page-subtitle {
        font-size: .78rem !important;
        line-height: 1.45 !important;
        opacity: .92;
    }
    .worker360-page .bcc-page-header .bcc-btn,
    .worker360-page .bcc-page-header .btn,
    .worker360-page .bcc-page-header a:not(.bcc-page-title) {
        background: #fff !important;
        border: 1px solid rgba(255,255,255,.9) !important;
        color: #145c39 !important;
        border-radius: 5px !important;
        font-size: .77rem !important;
        font-weight: 750 !important;
        padding: 7px 12px !important;
        box-shadow: none !important;
    }
    .worker360-page .bcc-page-header .bcc-btn i,
    .worker360-page .bcc-page-header .btn i,
    .worker360-page .bcc-page-header a i { color: #145c39 !important; }
    .worker360-page .bcc-page-header .bcc-btn:hover,
    .worker360-page .bcc-page-header .btn:hover,
    .worker360-page .bcc-page-header a:hover { background: #eaf6ee !important; }
    .worker360-page .compact-workspace-tile,
    .worker360-page .my-desk-action-card,
    .worker360-page .workspace-tile,
    .worker360-page .bcc-card {
        border-color: #d8e8dc !important;
        border-radius: 7px !important;
        box-shadow: 0 2px 8px rgba(22, 70, 42, .045) !important;
    }
    .worker360-page a.compact-workspace-tile:hover,
    .worker360-page a.my-desk-action-card:hover,
    .worker360-page a.workspace-tile:hover {
        background: #f4faf6 !important;
        border-color: #6cb28a !important;
        box-shadow: 0 5px 13px rgba(20,92,57,.09) !important;
        transform: translateY(-1px);
    }
    .worker360-page .compact-tile-icon,
    .worker360-page .my-desk-action-icon,
    .worker360-page .workspace-tile-icon {
        background: #eaf6ee !important;
        color: #17633d !important;
        border-radius: 6px !important;
    }
    .worker360-page .compact-tile-icon i,
    .worker360-page .my-desk-action-icon i,
    .worker360-page .workspace-tile-icon i { color: #17633d !important; }
    .worker360-page .compact-tile-title,
    .worker360-page .my-desk-action-content h5,
    .worker360-page .workspace-section-heading h5,
    .worker360-page .workspace-heading h6,
    .worker360-page .my-desk-section-heading h6 { color: #174a30 !important; }
    .worker360-page .compact-tile-arrow,
    .worker360-page .my-desk-action-arrow { color: #31845a !important; }
    .worker360-page .my-desk-actions-card,
    .worker360-page .setup-workspace-card { border-top: 3px solid #31845a !important; }
    .worker360-page .my-desk-summary-strip .attention {
        background: #eaf6ee !important;
        border-color: #b9ddc6 !important;
    }
    .worker360-page .my-desk-summary-strip .attention strong { color: #145c39 !important; }
    .worker360-page .bcc-btn-primary,
    .worker360-page .btn-primary { background: #145c39 !important; border-color: #145c39 !important; color: #fff !important; }
    .worker360-page .bcc-btn-primary:hover,
    .worker360-page .btn-primary:hover { background: #23774c !important; border-color: #23774c !important; }
    .worker360-page .form-control:focus,
    .worker360-page .form-select:focus { border-color: #31845a !important; box-shadow: 0 0 0 .15rem rgba(49,132,90,.14) !important; }
    .worker360-page .table thead th { background: #eaf6ee !important; color: #174a30 !important; border-color: #d8e8dc !important; }
    .worker360-page .table td { vertical-align: middle; }
    .worker360-page .card { border-radius: 7px; }
    .worker360-page .card-header { background: #f0f8f3; color: #174a30; }
    @@media (max-width: 700px) {
        .worker360-page .bcc-page-header { padding: 14px 15px !important; gap: 10px; }
        .worker360-page .bcc-page-header .bcc-page-title { font-size: 1.24rem !important; }
    }

    /* Setup cards: mint-green icon tiles with deeper green symbols. */
    .setup-workspace-page :is(.workspace-action-icon, .workspace-action-card-icon,
        .workspace-card-icon, .workspace-tile-icon, .my-desk-action-icon,
        .compact-tile-icon, .action-card-icon, .action-icon, .icon-wrapper,
        .icon-container) {
        background: linear-gradient(145deg, #e8f6ed, #d5ecde) !important;
        color: #17633d !important;
        border: 1px solid #c2e2ce !important;
        border-radius: 9px !important;
    }
    .setup-workspace-page :is(.workspace-action-icon, .workspace-action-card-icon,
        .workspace-card-icon, .workspace-tile-icon, .my-desk-action-icon,
        .compact-tile-icon, .action-card-icon, .action-icon, .icon-wrapper,
        .icon-container) i {
        color: #17633d !important;
    }
    .setup-workspace-page :is(.workspace-action-card, .workspace-tile,
        .my-desk-action-card, .action-card):hover :is(.workspace-action-icon,
        .workspace-action-card-icon, .workspace-card-icon, .workspace-tile-icon,
        .my-desk-action-icon, .action-card-icon, .action-icon, .icon-wrapper,
        .icon-container) {
        background: #c9e8d4 !important;
        border-color: #92c8a6 !important;
    }
</style>