@page "/"
@page "/dashboard"

@layout Components.Layout.MainLayout
@using ChurchApp.Services
@using ChurchApp.Models
@inject AuthService AuthService
@inject WorkforceService WorkforceService
@inject ExcuseService ExcuseService
@inject WorkerService WorkerService
@inject OfferingService OfferingService
@inject AttendanceService AttendanceService
@inject NavigationManager Navigation
@inject IServiceProvider ScopedServices

<PageTitle>BCC ServiceHub - Dashboard</PageTitle>

@if (AuthService.IsAuthenticated)
{
    <div class="container-fluid py-3">
        <!-- Welcome Section with User Avatar -->
       <!-- Modern Dashboard Header -->
<div class="dashboard-hero mb-4">
    <div>
        <div class="dashboard-kicker">
            <i class="fas fa-church me-2"></i>
            BCC ServiceHub
        </div>

        <h2>
            @GetGreeting(), @AuthService.CurrentWorker?.FirstName
        </h2>

        <p>
            Here is what needs your attention today.
        </p>

        <div class="dashboard-meta">
            <span>
                <i class="fas fa-calendar-day me-1"></i>
                @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
            </span>

            @if (!string.IsNullOrEmpty(AuthService.CurrentWorker?.Directorate?.Name))
            {
                <span>
                    <i class="fas fa-sitemap me-1"></i>
                    @AuthService.CurrentWorker?.Directorate?.Name
                </span>
            }
        </div>
    </div>

    <div class="dashboard-user">
        @if (!string.IsNullOrEmpty(AuthService.CurrentWorker?.PassportPhotoPath))
        {
            <img src="@AuthService.CurrentWorker.PassportPhotoPath"
                 alt="@AuthService.CurrentWorker?.FirstName" />
        }
        else
        {
            <div class="dashboard-user-placeholder">
                <i class="fas fa-user"></i>
            </div>
        }

        <span></span>
    </div>
</div>

        <!-- Quick Stats with Representative Images -->
        <div class="row mb-4">
            @if (IsChurchAdmin() || IsHeadOfMeatDirectorate())
            {
                <!-- Church Admin & Head of MEAT Stats -->
                <div class="col-6 col-md-3 mb-3">
                    <div class="stat-card">
                        <div class="stat-image-container">
                            <div class="workers-image">
                                <div class="worker-avatar small">
                                    <i class="fas fa-user"></i>
                                </div>
                                <div class="worker-avatar medium">
                                    <i class="fas fa-user"></i>
                                </div>
                                <div class="worker-avatar large">
                                    <i class="fas fa-user"></i>
                                </div>
                                <div class="worker-avatar small">
                                    <i class="fas fa-user"></i>
                                </div>
                            </div>
                        </div>
                        <a href="/admin/worker-update"
   class="text-decoration-none text-dark">

    <div class="stat-content"
         style="cursor:pointer;">

        <h3 class="stat-number">@totalWorkers</h3>

        <p class="stat-label">
            Total Workers
        </p>

    </div>

</a>
                    </div>
                </div>

                <div class="col-6 col-md-3 mb-3">
                    <div class="stat-card">
                        <div class="stat-image-container">
                            <div class="active-workers-image">
                                <div class="worker-avatar active">
                                    <i class="fas fa-check"></i>
                                </div>
                                <div class="worker-avatar active">
                                    <i class="fas fa-check"></i>
                                </div>
                                <div class="worker-avatar active">
                                    <i class="fas fa-check"></i>
                                </div>
                            </div>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@activeWorkers</h3>
                            <p class="stat-label">Active Workers</p>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3 mb-3">
                    <div class="stat-card">
                        <div class="stat-image-container">
                            <div class="pending-image">
                                <div class="document-icon">
                                    <i class="fas fa-file-alt"></i>
                                </div>
                                <div class="clock-overlay">
                                    <i class="fas fa-clock"></i>
                                </div>
                            </div>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@pendingApprovals</h3>
                            <p class="stat-label">Pending Approvals</p>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3 mb-3">
                    <div class="stat-card">
                        <div class="stat-image-container">
                            <div class="offering-image">
                                <div class="coin-stack">
                                    <div class="coin coin-1"></div>
                                    <div class="coin coin-2"></div>
                                    <div class="coin coin-3"></div>
                                </div>
                                <div class="hand-icon">
                                    <i class="fas fa-hand-holding-usd"></i>
                                </div>
                            </div>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@pendingOfferingsCount</h3>
                            <p class="stat-label">Pending Offerings</p>
                        </div>
                    </div>
                </div>
            }
            else if (IsUsheringDepartment())
            {
                <!-- Ushering Department Stats -->
                <div class="col-6 col-md-3 mb-3">
                    <div class="stat-card">
                        <div class="stat-image-container">
                            <div class="church-time-image">
                                <div class="church-building">
                                    <i class="fas fa-church"></i>
                                </div>
                                <div class="calendar-icon">
                                    <i class="fas fa-calendar-alt"></i>
                                </div>
                            </div>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@GetFormattedDaysInBCC()</h3>
                            <p class="stat-label">Time in BCC</p>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3 mb-3">
                    <div class="stat-card">
                        <div class="stat-image-container">
                            <div class="pending-requests-image">
                                <div class="request-paper">
                                    <i class="fas fa-scroll"></i>
                                </div>
                                <div class="hourglass-icon">
                                    <i class="fas fa-hourglass-half"></i>
                                </div>
                            </div>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@myPendingExcuses</h3>
                            <p class="stat-label">Pending Requests</p>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3 mb-3">
                    <div class="stat-card">
                        <div class="stat-image-container">
                            <div class="approved-image">
                                <div class="checkmark-circle">
                                    <i class="fas fa-check"></i>
                                </div>
                                <div class="document-approved">
                                    <i class="fas fa-file-signature"></i>
                                </div>
                            </div>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@myApprovedExcuses</h3>
                            <p class="stat-label">Approved Requests</p>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3 mb-3">
                    <div class="stat-card">
                        <div class="stat-image-container">
                            <div class="rejected-image">
                                <div class="warning-triangle">
                                    <i class="fas fa-exclamation"></i>
                                </div>
                                <div class="coin-falling">
                                    <div class="coin coin-fall"></div>
                                </div>
                            </div>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@rejectedOfferingsCount</h3>
                            <p class="stat-label">Rejected Offerings</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Regular Worker Stats -->
                <div class="col-6 col-md-3 mb-3">
                    <div class="stat-card">
                        <div class="stat-image-container">
                            <div class="church-membership-image">
                                <div class="church-icon-large">
                                    <i class="fas fa-church"></i>
                                </div>
                                <div class="membership-badge">
                                    <span>BCC</span>
                                </div>
                            </div>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@GetFormattedDaysInBCC()</h3>
                            <p class="stat-label">Time in BCC</p>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3 mb-3">
                    <div class="stat-card">
                        <div class="stat-image-container">
                            <div class="pending-excuse-image">
                                <div class="calendar-waiting">
                                    <i class="fas fa-calendar"></i>
                                </div>
                                <div class="waiting-clock">
                                    <i class="fas fa-clock"></i>
                                </div>
                            </div>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@myPendingExcuses</h3>
                            <p class="stat-label">Pending Requests</p>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3 mb-3">
                    <div class="stat-card">
                        <div class="stat-image-container">
                            <div class="approved-excuse-image">
                                <div class="calendar-checked">
                                    <i class="fas fa-calendar-check"></i>
                                </div>
                                <div class="green-checkmark">
                                    <i class="fas fa-check-circle"></i>
                                </div>
                            </div>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@myApprovedExcuses</h3>
                            <p class="stat-label">Approved Requests</p>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3 mb-3">
                    <div class="stat-card">
                        <div class="stat-image-container">
                            <div class="profile-complete-image">
                                <div class="profile-avatar">
                                    @if (!string.IsNullOrEmpty(AuthService.CurrentWorker?.PassportPhotoPath))
                                    {
                                        <img src="@AuthService.CurrentWorker.PassportPhotoPath" 
                                             alt="Profile" 
                                             class="profile-avatar-img" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-user"></i>
                                    }
                                </div>
                                <div class="progress-ring">
                                    <svg width="60" height="60">
                                        <circle class="progress-ring-bg" cx="30" cy="30" r="24"></circle>
                                        <circle class="progress-ring-fill" cx="30" cy="30" r="24" 
                                                style="stroke-dasharray: @(2 * Math.PI * 24); stroke-dashoffset: @(2 * Math.PI * 24 * (1 - userCompliance / 100.0))"></circle>
                                    </svg>
                                </div>
                            </div>
                        </div>
                        <div class="stat-content">
                            <h3 class="stat-number">@userCompliance%</h3>
                            <p class="stat-label">Profile Complete</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Main Content Area -->
        <div class="row">
            <!-- Left Column - Quick Actions & Recent Activity -->
            <div class="col-lg-8 mb-4">
                <!-- Quick Actions - Now includes ALL menu options from sidebar -->
                <!-- Modern Grouped Quick Menu -->
<div class="card border-0 shadow-sm mb-4 modern-menu-card">
    <div class="card-header bg-white border-0 py-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="mb-1 d-flex align-items-center">
                    <div class="action-header-icon me-2">
                        <i class="fas fa-th-large"></i>
                    </div>
                    Quick Workspace
                </h5>
                <small class="text-muted">Access your most important church operations</small>
            </div>
        </div>
    </div>

    <div class="card-body p-4">

        <!-- PERSONAL WORKSPACE -->
        <div class="menu-section">
            <div class="menu-section-title">
                <i class="fas fa-user-circle"></i>
                Personal Workspace
            </div>

            <div class="row g-3">
                <div class="col-6 col-sm-4 col-lg-3">
                    <a href="/workforce/my-profile" class="action-card">
                        <div class="action-image">
                            <i class="fas fa-user"></i>
                        </div>
                        <span class="action-text">My Profile</span>
                    </a>
                </div>

                <div class="col-6 col-sm-4 col-lg-3">
                    <a href="/excuse/my-requests" class="action-card">
                        <div class="action-image">
                            <i class="fas fa-calendar-times"></i>
                        </div>
                        <span class="action-text">Off Service</span>

                        @if (myPendingExcuses > 0)
                        {
                            <span class="pending-badge">@myPendingExcuses</span>
                        }
                    </a>
                </div>

                <div class="col-6 col-sm-4 col-lg-3">
                    <a href="/excuse/mybreak-requests" class="action-card">
                        <div class="action-image">
                            <i class="fas fa-umbrella-beach"></i>
                        </div>
                        <span class="action-text">Break Request</span>

                        @if (pendingBreakCount > 0)
                        {
                            <span class="pending-badge">@pendingBreakCount</span>
                        }
                    </a>
                </div>

                <div class="col-6 col-sm-4 col-lg-3">
                    <a href="/Workforce/feedback" class="action-card">
                        <div class="action-image">
                            <i class="fas fa-comment-dots"></i>
                        </div>
                        <span class="action-text">Growth Feedback</span>

                        @if (growthHubCounts.MyFeedback > 0)
                        {
                            <span class="pending-badge">@growthHubCounts.MyFeedback</span>
                        }
                    </a>
                </div>
            </div>
        </div>

        <!-- APPROVALS & SUPERVISION -->
        @if (CanAccessProfileApproval() || CanAccessMyTeam() || CanApprovePermissionRequests())
        {
            <div class="menu-section">
                <div class="menu-section-title">
                    <i class="fas fa-user-check"></i>
                    Approvals & Supervision
                </div>

                <div class="row g-3">
                    @if (CanAccessProfileApproval())
                    {
                        <div class="col-6 col-sm-4 col-lg-3">
                            <a href="/workforce/my-inbox" class="action-card">
                                <div class="action-image">
                                    <i class="fas fa-inbox"></i>
                                </div>
                                <span class="action-text">Profile Approval</span>

                                @if (pendingApprovalCount > 0)
                                {
                                    <span class="pending-badge">@pendingApprovalCount</span>
                                }
                            </a>
                        </div>
                    }

                    @if (CanAccessMyTeam())
                    {
                        <div class="col-6 col-sm-4 col-lg-3">
                            <a href="/workforce/my-team" class="action-card">
                                <div class="action-image">
                                    <i class="fas fa-users-cog"></i>
                                </div>
                                <span class="action-text">My Team</span>
                            </a>
                        </div>
                    }

                    @if (CanApprovePermissionRequests())
                    {
                        <div class="col-6 col-sm-4 col-lg-3">
                            <a href="/excuse/approvals" class="action-card">
                                <div class="action-image">
                                    <i class="fas fa-check-double"></i>
                                </div>
                                <span class="action-text">Approval Inbox</span>

                                @if ((pendingExcuseApprovals + pendingBreakApprovals) > 0)
                                {
                                    <span class="pending-badge">@(pendingExcuseApprovals + pendingBreakApprovals)</span>
                                }
                            </a>
                        </div>
                    }

                    <div class="col-6 col-sm-4 col-lg-3">
                        <a href="/Workforce/assigned" class="action-card">
                            <div class="action-image">
                                <i class="fas fa-tasks"></i>
                            </div>
                            <span class="action-text">Assigned to Me</span>

                            @if (growthHubCounts.AssignedToMe > 0)
                            {
                                <span class="pending-badge">@growthHubCounts.AssignedToMe</span>
                            }
                        </a>
                    </div>
                </div>
            </div>
        }

        <!-- SERVICE RECORDS -->
        @if (CanAccessServiceRecords())
        {
            <div class="menu-section">
                <div class="menu-section-title">
                    <i class="fas fa-church"></i>
                    Service Records
                </div>

                <div class="row g-3">
                    @if (CanAccessRecordNomination())
                    {
                        <div class="col-6 col-sm-4 col-lg-3">
                            <a href="/Offering/record-nomination" class="action-card">
                                <div class="action-image">
                                    <i class="fas fa-vote-yea"></i>
                                </div>
                                <span class="action-text">Record Nomination</span>
                            </a>
                        </div>
                    }

                    @if (CanAccessServiceNotes())
                    {
                        <div class="col-6 col-sm-4 col-lg-3">
                            <a href="/Offering/NoteList" class="action-card">
                                <div class="action-image">
                                    <i class="fas fa-sticky-note"></i>
                                </div>
                                <span class="action-text">Service Notes</span>
                            </a>
                        </div>
                    }

                    @if (CanRecordOfferings())
                    {
                        <div class="col-6 col-sm-4 col-lg-3">
                            <a href="/offering/record" class="action-card">
                                <div class="action-image">
                                    <i class="fas fa-hand-holding-usd"></i>
                                </div>
                                <span class="action-text">Record Offering</span>

                                @if (rejectedOfferingsCount > 0)
                                {
                                    <span class="rejected-badge">@rejectedOfferingsCount</span>
                                }
                            </a>
                        </div>

                        <div class="col-6 col-sm-4 col-lg-3">
                            <a href="/Offering/Attendance-record" class="action-card">
                                <div class="action-image">
                                    <i class="fas fa-clipboard-check"></i>
                                </div>
                                <span class="action-text">Record Attendance</span>
                            </a>
                        </div>

                        <div class="col-6 col-sm-4 col-lg-3">
                            <a href="/Offering/Attendance-list" class="action-card">
                                <div class="action-image">
                                    <i class="fas fa-list-ol"></i>
                                </div>
                                <span class="action-text">View Attendance</span>
                            </a>
                        </div>
                    }

                    @if (CanApproveOfferings())
                    {
                        <div class="col-6 col-sm-4 col-lg-3">
                            <a href="/offering/approvals" class="action-card">
                                <div class="action-image">
                                    <i class="fas fa-stamp"></i>
                                </div>
                                <span class="action-text">Approve Offerings</span>

                                @if (pendingOfferingsCount > 0)
                                {
                                    <span class="pending-badge">@pendingOfferingsCount</span>
                                }
                            </a>
                        </div>
                    }

                    @if (IsFIGDirectorateMember())
                    {
                        <div class="col-6 col-sm-4 col-lg-3">
                            <a href="/guest" class="action-card">
                                <div class="action-image">
                                    <i class="fas fa-user-friends"></i>
                                </div>
                                <span class="action-text">Guest Management</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- REPORTS -->
        @if (CanAccessReports())
        {
            <div class="menu-section">
                <div class="menu-section-title">
                    <i class="fas fa-chart-line"></i>
                    Reports & Insights
                </div>

                <div class="row g-3">
                    <div class="col-6 col-sm-4 col-lg-3">
                        <a href="/reports" class="action-card">
                            <div class="action-image">
                                <i class="fas fa-chart-bar"></i>
                            </div>
                            <span class="action-text">Reports</span>
                        </a>
                    </div>

                    <div class="col-6 col-sm-4 col-lg-3">
                        <a href="/reports/offering" class="action-card">
                            <div class="action-image">
                                <i class="fas fa-coins"></i>
                            </div>
                            <span class="action-text">Offering Reports</span>
                        </a>
                    </div>

                    <div class="col-6 col-sm-4 col-lg-3">
                        <a href="/reports/attendance" class="action-card">
                            <div class="action-image">
                                <i class="fas fa-calendar-check"></i>
                            </div>
                            <span class="action-text">Attendance Reports</span>
                        </a>
                    </div>

                    @if (AuthService.IsInRole("Church Admin") || AuthService.IsInRole("Pastor in Charge"))
                    {
                        <div class="col-6 col-sm-4 col-lg-3">
                            <a href="/reports/financial" class="action-card">
                                <div class="action-image">
                                    <i class="fas fa-chart-pie"></i>
                                </div>
                                <span class="action-text">Financial Reports</span>
                            </a>
                        </div>

                        <div class="col-6 col-sm-4 col-lg-3">
                            <a href="/reports/analytics" class="action-card">
                                <div class="action-image">
                                    <i class="fas fa-chart-line"></i>
                                </div>
                                <span class="action-text">Church Analytics</span>
                            </a>
                        </div>
                    }

                    @if (CanViewGrowthReports())
                    {
                        <div class="col-6 col-sm-4 col-lg-3">
                            <a href="/Workforce/reports" class="action-card">
                                <div class="action-image">
                                    <i class="fas fa-file-alt"></i>
                                </div>
                                <span class="action-text">Growth Reports</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ADMINISTRATION -->
        @if (AuthService.CanAccessAdminPanel())
        {
            <div class="menu-section">
                <div class="menu-section-title">
                    <i class="fas fa-cogs"></i>
                    Administration & Setup
                </div>

                <div class="row g-3">
                    <div class="col-6 col-sm-4 col-lg-3">
                        <a href="/admin/worker-setup" class="action-card">
                            <div class="action-image">
                                <i class="fas fa-user-plus"></i>
                            </div>
                            <span class="action-text">Worker Setup</span>
                        </a>
                    </div>

                    <div class="col-6 col-sm-4 col-lg-3">
                        <a href="/admin/worker-update" class="action-card">
                            <div class="action-image">
                                <i class="fas fa-users"></i>
                            </div>
                            <span class="action-text">Workers Detail</span>
                        </a>
                    </div>

                    <div class="col-6 col-sm-4 col-lg-3">
                        <a href="/admin/services" class="action-card">
                            <div class="action-image">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                            <span class="action-text">Service Mgmt</span>
                        </a>
                    </div>

                    @if (CanAccessOfferingSetup())
                    {
                        <div class="col-6 col-sm-4 col-lg-3">
                            <a href="/offering/types" class="action-card">
                                <div class="action-image">
                                    <i class="fas fa-list-ul"></i>
                                </div>
                                <span class="action-text">Offering Setup</span>
                            </a>
                        </div>
                    }

                    <div class="col-6 col-sm-4 col-lg-3">
                        <a href="/admin/directorate-setup" class="action-card">
                            <div class="action-image">
                                <i class="fas fa-building"></i>
                            </div>
                            <span class="action-text">Directorate Setup</span>
                        </a>
                    </div>

                    <div class="col-6 col-sm-4 col-lg-3">
                        <a href="/admin/department-setup" class="action-card">
                            <div class="action-image">
                                <i class="fas fa-sitemap"></i>
                            </div>
                            <span class="action-text">Department Setup</span>
                        </a>
                    </div>

                    <div class="col-6 col-sm-4 col-lg-3">
                        <a href="/admin/role-setup" class="action-card">
                            <div class="action-image">
                                <i class="fas fa-user-tag"></i>
                            </div>
                            <span class="action-text">Role Setup</span>
                        </a>
                    </div>
                </div>
            </div>
        }

        <!-- FINANCE -->
        @if (CanAccessBudget() || CanAccessRemittance())
        {
            <div class="menu-section mb-0">
                <div class="menu-section-title">
                    <i class="fas fa-wallet"></i>
                    Finance & Remittance
                </div>

