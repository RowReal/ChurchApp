@page "/finance/bank-journal-approvals"
@rendermode InteractiveServer
@layout Components.Layout.MainLayout
@using ChurchApp.Data
@using ChurchApp.Models.Finance
@using JournalEntry = ChurchApp.Models.Finance.BankAccountJournal
@using Microsoft.EntityFrameworkCore
@using ChurchApp.Services
@inject BankAccountJournalService JournalService
@inject AppDbContext Db
@inject AuthService AuthService

<PageTitle>Bank Entry Approvals - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="alert alert-warning">Please sign in to continue.</div>
}
else if (!IsPastor)
{
    <div class="alert alert-danger">Only the Pastor in Charge can approve bank journal entries.</div>
}
else
{
    <div class="worker360-page ba-page">
        <div class="bcc-page-header ba-hero">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-wallet me-2"></i>Account &amp; Remittance Workspace
                </div>
                <div class="bcc-page-title">Bank Entry Approvals</div>
                <div class="bcc-page-subtitle">
                    Review bank transactions awaiting Pastor authorisation.
                </div>
            </div>
            <a href="/workspace/account-remittance" class="bcc-btn profile-form-secondary-btn">
                <i class="fas fa-arrow-left me-2"></i>Workspace
            </a>
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success")" role="alert">
                @message
            </div>
        }

        <div class="ba-summary">
            <span><strong>@pendingEntries.Count</strong> Pending requests</span>
            <button class="btn btn-outline-secondary btn-sm" type="button" disabled="@busy" @onclick="LoadPendingAsync">
                <i class="fas fa-sync-alt me-1"></i>Refresh
            </button>
        </div>

        <div class="ba-grid">
            <section class="card ba-panel">
                <div class="card-header"><strong>Pending bank entries</strong></div>
                <div class="card-body">
                    <label class="form-label" for="ba-search">Search pending entries</label>
                    <input id="ba-search"
                           class="form-control form-control-sm ba-input"
                           placeholder="Journal ID, reference or narration"
                           @bind="search"
                           @bind:event="oninput" />

                    @if (pendingEntries.Count == 0)
                    {
                        <p class="text-muted small mt-3 mb-0">No bank entries are awaiting approval.</p>
                    }
                    else
                    {
                        <div class="ba-list mt-2">
                            @foreach (var entry in FilteredEntries)
                            {
                                <button type="button"
                                        class="ba-entry @(selectedId == entry.Id ? "ba-selected" : "")"
                                        disabled="@busy"
                                        @onclick="() => SelectEntry(entry.Id)">
                                    <span class="ba-entry-main">
                                        <strong>Journal #@entry.Id</strong>
                                        <small>@TransactionLabel(entry.TransactionType)</small>
                                        <small>@entry.TransactionDate.ToString("dd MMM yyyy")</small>
                                    </span>
                                    <span class="ba-entry-amount">
                                        @entry.Currency @entry.Amount.ToString("N2")
                                    </span>
                                </button>
                            }
                        </div>
                    }
                </div>
            </section>

            <section class="card ba-panel">
                <div class="card-header"><strong>Review and decision</strong></div>
                <div class="card-body">
                    @if (SelectedEntry is null)
                    {
                        <p class="text-muted small mb-0">Select a pending entry to review its details.</p>
                    }
                    else
                    {
                        <div class="ba-details">
                            <div>
                                <label>Journal reference</label>
                                <strong>#@SelectedEntry.Id</strong>
                            </div>
                            <div>
                                <label>Transaction type</label>
                                <strong>@TransactionLabel(SelectedEntry.TransactionType)</strong>
                            </div>
                            <div>
                                <label>Transaction date</label>
                                <strong>@SelectedEntry.TransactionDate.ToString("dd MMM yyyy")</strong>
                            </div>
                            <div>
                                <label>Direction</label>
                                <strong>@SelectedEntry.Direction</strong>
                            </div>
                            <div>
                                <label>Amount</label>
                                <strong>@SelectedEntry.Currency @SelectedEntry.Amount.ToString("N2")</strong>
                            </div>
                            <div>
                                <label>Bank account</label>
                                <strong>@(SelectedEntry.BankAccount?.BankName ?? $"Account #{SelectedEntry.BankAccountId}")</strong>
                                @if (!string.IsNullOrWhiteSpace(SelectedEntry.BankAccount?.AccountNumber))
                                {
                                    <span class="ba-account-number">
                                        Account No: @SelectedEntry.BankAccount.AccountNumber
                                    </span>
                                }
                            </div>
                            <div>
                                <label>Income type</label>
                                <strong>@(SelectedEntry.IncomeType?.Name ?? "Not applicable")</strong>
                            </div>
                            <div>
                                <label>Source collection</label>
                                <strong>@(SelectedEntry.SourceCollectionId?.ToString() ?? "Not applicable")</strong>
                            </div>
                            <div>
                                <label>Bank reference</label>
                                <strong>@(SelectedEntry.TransactionReference ?? "Not provided")</strong>
                            </div>
                            <div>
                                <label>Initiated by Worker</label>
                                <strong>@SelectedEntry.InitiatedByWorkerId</strong>
                            </div>
                        </div>

                        @if (SelectedEntry.ReversesJournalId.HasValue)
                        {
                            <div class="alert alert-info small mt-2">
                                <strong>Bank correction request</strong>
                                <div>Original journal: #@SelectedEntry.ReversesJournalId</div>
                                <div>Action: @SelectedEntry.CorrectionKind</div>
                                <div>Corrected total amount: @SelectedEntry.Currency @SelectedEntry.RequestedCorrectAmount?.ToString("N2")</div>
                                <div>Correction entry: @SelectedEntry.Direction @SelectedEntry.Currency @SelectedEntry.Amount.ToString("N2")</div>
                                <div>Reason: @SelectedEntry.Narration</div>
                            </div>
                        }

                        <div class="ba-narration mt-2">
                            <label>Narration</label>
                            <p>@SelectedEntry.Narration</p>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(SelectedEntry.ResubmissionExplanation))
                        {
                            <div class="ba-narration">
                                <label>Church Admin's resubmission explanation</label>
                                <p>@SelectedEntry.ResubmissionExplanation</p>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(SelectedEntry.ReviewHistory))
                        {
                            <div class="ba-narration">
                                <label>Previous review history</label>
                                <p style="white-space: pre-wrap; overflow-wrap: anywhere;">@SelectedEntry.ReviewHistory</p>
                            </div>
                        }
                        @if (SelectedEntry.InitiatedByWorkerId == CurrentWorkerId)
                        {
                            <div class="alert alert-warning small mt-2">
                                You cannot decide an entry that you initiated.
                            </div>
                        }
                        else
                        {
                            <div class="ba-actions mt-3">
                                <button type="button"
                                        class="btn btn-success btn-sm"
                                        disabled="@busy"
                                        @onclick="ApproveSelectedAsync">
                                    <i class="fas fa-check me-1"></i>Approve
                                </button>
                                <button type="button"
                                        class="btn btn-outline-warning btn-sm"
                                        disabled="@busy"
                                        @onclick="() => SetDecision(DecisionAction.Return)">
                                    Return
                                </button>
                                <button type="button"
                                        class="btn btn-outline-danger btn-sm"
                                        disabled="@busy"
                                        @onclick="() => SetDecision(DecisionAction.Reject)">
                                    Reject
                                </button>
                            </div>


                        }
                    }
                </div>
            </section>
        </div>
    </div>
}


@if (IsPastor && decision != DecisionAction.None && SelectedEntry is not null)
{
    <div class="ba-modal-backdrop" role="presentation">
        <section class="ba-modal-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="ba-modal-title">
            <div class="ba-modal-header">
                <div>
                    <h3 id="ba-modal-title" class="ba-modal-title">
                        @(decision == DecisionAction.Return ? "Return Bank Entry" : "Reject Bank Entry")
                    </h3>
                    <p class="ba-modal-subtitle">
                        Journal #@SelectedEntry.Id — @SelectedEntry.Currency @SelectedEntry.Amount.ToString("N2")
                    </p>
                </div>
                <button type="button"
                        class="ba-modal-close"
                        aria-label="Close decision popup"
                        disabled="@busy"
                        @onclick="CancelDecision">
                    &times;
                </button>
            </div>

            <div class="ba-modal-body">
                <label class="form-label" for="ba-reason">
                    Reason for @(decision == DecisionAction.Return ? "returning" : "rejecting")
                    <span class="text-danger">*</span>
                </label>
                <textarea id="ba-reason"
                          class="form-control form-control-sm ba-input"
                          rows="4"
                          maxlength="1000"
                          placeholder="Enter a clear reason for the Church Admin"
                          @bind="reason"
                          @bind:event="oninput"></textarea>
                <div class="ba-modal-help">
                    This reason will be available to Church Admin for follow-up.
                </div>

                @if (isError && !string.IsNullOrWhiteSpace(message))
                {
                    <div class="alert alert-danger small mt-2 mb-0" role="alert">
                        @message
                    </div>
                }
            </div>

            <div class="ba-modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        disabled="@busy"
                        @onclick="CancelDecision">
                    Cancel
                </button>
                <button type="button"
                        class="btn btn-sm @(decision == DecisionAction.Return ? "btn-warning" : "btn-danger")"
                        disabled="@(busy || string.IsNullOrWhiteSpace(reason))"
                        @onclick="SubmitDecisionAsync">
                    @(decision == DecisionAction.Return ? "Confirm Return" : "Confirm Rejection")
                </button>
            </div>
        </section>
    </div>
}

@code {
    #region Page State and Computed Properties

    private enum DecisionAction
    {
        None,
        Return,
        Reject
    }

    private List<JournalEntry> pendingEntries = new();
    private int? selectedId;
    private string search = string.Empty;
    private string reason = string.Empty;
    private string message = string.Empty;
    private bool isError;
    private bool busy;
    private DecisionAction decision = DecisionAction.None;

    private bool IsPastor
    {
        get
        {
            return AuthService.IsInRole(AuthService.Roles.PastorInCharge);
        }
    }

    private string? CurrentWorkerId
    {
        get
        {
            return AuthService.CurrentWorker?.WorkerId;
        }
    }

    private JournalEntry? SelectedEntry
    {
        get
        {
            return pendingEntries.FirstOrDefault(entry => entry.Id == selectedId);
        }
    }

    private IEnumerable<JournalEntry> FilteredEntries
    {
        get
        {
            if (string.IsNullOrWhiteSpace(search))
            {
                return pendingEntries;
            }

            var term = search.Trim();

            return pendingEntries.Where(entry =>
                entry.Id.ToString().Contains(term, StringComparison.OrdinalIgnoreCase)
                || entry.Narration.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (entry.TransactionReference?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    #endregion

    #region On Initialized

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated && IsPastor)
        {
            await LoadPendingAsync();
        }
    }

    #endregion

    #region Load Pending

    private async Task LoadPendingAsync()
    {
        try
        {
            busy = true;
            pendingEntries = await Db.BankAccountJournals
                .AsNoTracking()
                .Include(entry => entry.BankAccount)
                .Include(entry => entry.IncomeType)
                .Where(entry => entry.Status == BankJournalStatus.PendingApproval)
                .OrderBy(entry => entry.InitiatedDate)
                .ToListAsync();

            if (selectedId.HasValue && !pendingEntries.Any(entry => entry.Id == selectedId.Value))
            {
                selectedId = null;
            }
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    #endregion

    #region Select Entry

    private void SelectEntry(int journalId)
    {
        selectedId = journalId;
        decision = DecisionAction.None;
        reason = string.Empty;
        message = string.Empty;
    }

    #endregion

    #region Set Decision

    private void SetDecision(DecisionAction action)
    {
        decision = action;
        reason = string.Empty;
        message = string.Empty;
    }

    #endregion

    #region Cancel Decision

    private void CancelDecision()
    {
        if (busy)
        {
            return;
        }

        decision = DecisionAction.None;
        reason = string.Empty;
        message = string.Empty;
        isError = false;
    }

    #endregion

    #region Approve Selected

    private async Task ApproveSelectedAsync()
    {
        if (!CanDecide())
        {
            return;
        }

        try
        {
            busy = true;
            var journalId = selectedId!.Value;
            await JournalService.ApproveAsync(journalId, CurrentWorkerId!);
            await LoadPendingAsync();
            ShowSuccess($"Journal #{journalId} approved and posted successfully.");
            ClearSelection();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    #endregion

    #region Submit Decision

    private async Task SubmitDecisionAsync()
    {
        if (!CanDecide())
        {
            return;
        }

        if (decision == DecisionAction.None || string.IsNullOrWhiteSpace(reason))
        {
            ShowError("Enter a reason for returning or rejecting this entry.");
            return;
        }

        try
        {
            busy = true;
            var journalId = selectedId!.Value;
            var action = decision;

            if (action == DecisionAction.Return)
            {
                await JournalService.ReturnAsync(journalId, CurrentWorkerId!, reason.Trim());
            }
            else
            {
                await JournalService.RejectAsync(journalId, CurrentWorkerId!, reason.Trim());
            }

            await LoadPendingAsync();
            ShowSuccess($"Journal #{journalId} {(action == DecisionAction.Return ? "returned" : "rejected")} successfully.");
            ClearSelection();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    #endregion

    #region Can Decide

    private bool CanDecide()
    {
        if (!AuthService.IsAuthenticated || !IsPastor || string.IsNullOrWhiteSpace(CurrentWorkerId))
        {
            ShowError("You are not authorised to decide this bank entry.");
            return false;
        }

        var entry = SelectedEntry;

        if (entry is null)
        {
            ShowError("Select a pending bank entry first.");
            return false;
        }

        if (entry.InitiatedByWorkerId == CurrentWorkerId)
        {
            ShowError("You cannot approve, return or reject your own entry.");
            return false;
        }

        return true;
    }

    #endregion

    #region Clear Selection

    private void ClearSelection()
    {
        selectedId = null;
        decision = DecisionAction.None;
        reason = string.Empty;
    }

    #endregion

    #region Show Error

    private void ShowError(string text)
    {
        message = text;
        isError = true;
    }

    #endregion

    #region Show Success

    private void ShowSuccess(string text)
    {
        message = text;
        isError = false;
    }

    #endregion

    #region Transaction Label

    private static string TransactionLabel(BankJournalTransactionType type)
    {
        return type switch
        {
            BankJournalTransactionType.CollectionPosting => "Collection Posting",
            BankJournalTransactionType.DirectBankReceipt => "Direct Bank Receipt",
            BankJournalTransactionType.BankCharges => "Bank Charges",
            BankJournalTransactionType.InternalAccountTransfer => "Internal Account Transfer",
            BankJournalTransactionType.ExpenditurePayment => "Expenditure Payment",
            BankJournalTransactionType.RemittancePayment => "Remittance Payment",
            BankJournalTransactionType.Adjustment => "Adjustment",
            _ => type.ToString()
        };
    }
    #endregion
}
<style>
    /* Page styling: readable declarations and responsive rules. */
    .ba-page {
        max-width: 1320px;
        margin: 0 auto;
        padding-top: 6px;
    }

    .ba-hero {
        margin-bottom: 14px;
    }

    .ba-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
        font-size: 0.82rem;
    }

    .ba-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
        align-items: start;
        gap: 12px;
    }

    .ba-panel {
        min-width: 0;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
    }

    .ba-panel .card-header {
        padding: 10px 14px;
        background: #f0fdf4;
        color: #166534;
        font-size: 0.84rem;
    }

    .ba-panel .card-body {
        padding: 14px;
    }

    .ba-input {
        max-width: 100%;
        font-size: 0.82rem;
    }

    .ba-list {
        display: flex;
        flex-direction: column;
        gap: 7px;
        max-height: 510px;
        overflow-y: auto;
    }

    .ba-entry {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        width: 100%;
        padding: 10px;
        text-align: left;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
    }

    .ba-entry:hover,
    .ba-selected {
        background: #f0fdf4;
        border-color: #86efac;
    }

    .ba-entry-main {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .ba-entry-main small {
        color: #64748b;
        font-size: 0.73rem;
    }

    .ba-entry-amount {
        flex-shrink: 0;
        color: #166534;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .ba-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px 14px;
    }

    .ba-details > div {
        display: flex;
        flex-direction: column;
        gap: 3px;
        min-width: 0;
    }

    .ba-details label,
    .ba-narration label {
        color: #64748b;
        font-size: 0.73rem;
    }

    .ba-details strong {
        overflow-wrap: anywhere;
        font-size: 0.83rem;
    }

    .ba-account-number {
        color: #166534;
        font-size: 0.88rem;
        font-weight: 800;
    }

    .ba-narration {
        padding: 10px;
        background: #f8fafc;
        border-radius: 8px;
    }

    .ba-narration p {
        margin: 4px 0 0;
        font-size: 0.82rem;
        overflow-wrap: anywhere;
    }

    .ba-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .ba-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        background: rgba(15, 23, 42, 0.55);
    }

    .ba-modal-dialog {
        width: 100%;
        max-width: 520px;
        max-height: calc(100vh - 32px);
        overflow-y: auto;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 18px 48px rgba(15, 23, 42, 0.24);
    }

    .ba-modal-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 20px 12px;
        border-bottom: 1px solid #e2e8f0;
    }

    .ba-modal-title {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 700;
        color: #14532d;
    }

    .ba-modal-subtitle {
        margin: 5px 0 0;
        font-size: 0.82rem;
        color: #64748b;
    }

    .ba-modal-close {
        padding: 0 5px;
        border: 0;
        background: transparent;
        color: #475569;
        font-size: 1.5rem;
        line-height: 1;
    }

    .ba-modal-body {
        padding: 16px 20px;
    }

    .ba-modal-body .ba-input {
        width: 100%;
        resize: vertical;
    }

    .ba-modal-help {
        margin-top: 7px;
        font-size: 0.75rem;
        color: #64748b;
    }

    .ba-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 12px 20px 18px;
        border-top: 1px solid #e2e8f0;
    }

    @@media (max-width: 850px) {
        .ba-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 520px) {
        .ba-details {
            grid-template-columns: 1fr;
        }

        .ba-entry {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>
