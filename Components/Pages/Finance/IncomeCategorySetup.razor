@page "/finance/income-categories"
@rendermode InteractiveServer

@using ChurchApp.Models.Finance
@using ChurchApp.Services

@inject IncomeCategoryService IncomeCategoryService
@inject AuthService AuthService

<PageTitle>Income Category Setup</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="finance-access-card">
        <div class="finance-access-icon">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h4>Authentication Required</h4>

        <p>
            Please sign in to access the Finance Setup workspace.
        </p>
    </div>
}
else if (!AuthService.CanAccessAdminPanel())
{
    <div class="finance-access-card">
        <div class="finance-access-icon denied">
            <i class="bi bi-exclamation-triangle"></i>
        </div>

        <h4>Access Restricted</h4>

        <p>
            You do not have permission to manage income categories.
        </p>
    </div>
}
else
{
    <div class="worker360-page finance-page">

        <div class="bcc-page-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-tags me-2"></i>
                    Finance Configuration
                </div>
                <div class="bcc-page-title">Income Category Setup</div>
                <div class="bcc-page-subtitle">
                    Create broad classifications for offerings, tithes, donations, projects and other church income.
                </div>
            </div>
            <div class="finance-header-actions">
                <button type="button" class="bcc-btn bcc-btn-primary finance-compact-btn" @onclick="StartNewCategory">
                    <i class="fas fa-plus me-2"></i> New Category
                </button>
                <a href="/workspace/setup" class="bcc-btn profile-form-secondary-btn finance-compact-btn">
                    <i class="fas fa-arrow-left me-2"></i> Setup Workspace
                </a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="finance-alert finance-alert-success">
                <div class="finance-alert-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <div class="flex-grow-1">
                    <strong>Successful</strong>
                    <div>@successMessage</div>
                </div>

                <button type="button"
                        class="finance-alert-close"
                        @onclick="ClearMessages">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="finance-alert finance-alert-danger">
                <div class="finance-alert-icon">
                    <i class="bi bi-exclamation-circle-fill"></i>
                </div>

                <div class="flex-grow-1">
                    <strong>Unable to complete request</strong>
                    <div>@errorMessage</div>
                </div>

                <button type="button"
                        class="finance-alert-close"
                        @onclick="ClearMessages">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        }

    <section class="finance-summary-grid">

        <div class="finance-summary-card summary-blue">
            <div class="finance-summary-icon">
                <i class="bi bi-tags"></i>
            </div>

            <div>
                <span>Total Categories</span>
                <strong>@incomeCategories.Count</strong>
                <small>All configured categories</small>
            </div>
        </div>

        <div class="finance-summary-card summary-green">
            <div class="finance-summary-icon">
                <i class="bi bi-check2-circle"></i>
            </div>

            <div>
                <span>Active Categories</span>
                <strong>@incomeCategories.Count(x => x.IsActive)</strong>
                <small>Available for income setup</small>
            </div>
        </div>

        <div class="finance-summary-card summary-purple">
            <div class="finance-summary-icon">
                <i class="bi bi-list-check"></i>
            </div>

            <div>
                <span>Income Types</span>
                <strong>
                    @incomeCategories.Sum(x => x.IncomeTypes?.Count ?? 0)
                </strong>
                <small>Types linked to categories</small>
            </div>
        </div>

        <div class="finance-summary-card summary-gold">
            <div class="finance-summary-icon">
                <i class="bi bi-eye-slash"></i>
            </div>

            <div>
                <span>Inactive</span>
                <strong>@incomeCategories.Count(x => !x.IsActive)</strong>
                <small>Unavailable categories</small>
            </div>
        </div>

    </section>

    <div class="finance-workspace-grid">

        <section class="finance-panel finance-form-panel">

            <div class="finance-panel-header">
                <div>
                    <div class="finance-section-label">
                        Category Configuration
                    </div>

                    <h4>
                        @(categoryModel.Id == 0
                                                ? "New Income Category"
                                                : "Edit Income Category")
                    </h4>

                        <p>
                            Define a broad classification used to group
                            related income types.
                        </p>
                    </div>

                @if (categoryModel.Id != 0)
                    {
                        <span class="finance-edit-badge">
                            <i class="bi bi-pencil-square me-1"></i>
                            Editing
                        </span>
                    }
                </div>

                <EditForm Model="@categoryModel"
                          OnValidSubmit="@SaveCategory"
                          FormName="IncomeCategorySetupForm">

                    <DataAnnotationsValidator />

                    <div class="finance-validation-summary">
                        <ValidationSummary />
                    </div>

                    <div class="finance-form-section">
                        <div class="finance-form-section-title">
                            <i class="bi bi-tag"></i>

                            <div>
                                <strong>Category Information</strong>
                                <span>
                                    Enter the category name, code and description
                                </span>
                            </div>
                        </div>

                        <div class="row g-3">

                            <div class="col-12">
                                <label class="form-label">
                                    Category Name
                                    <span class="required-mark">*</span>
                                </label>

                                <InputText class="form-control finance-control"
                                           @bind-Value="categoryModel.Name"
                                           placeholder="e.g. Offering" />

                                <ValidationMessage For="@(() => categoryModel.Name)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Category Code
                                </label>

                                <InputText class="form-control finance-control"
                                           @bind-Value="categoryModel.Code"
                                           maxlength="20"
                                           placeholder="e.g. OFF" />

                                <small class="finance-field-hint">
                                    Use a short, recognisable code.
                                </small>

                                <ValidationMessage For="@(() => categoryModel.Code)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Display Order
                                </label>

                                <InputNumber class="form-control finance-control"
                                             @bind-Value="categoryModel.DisplayOrder" />

                                <small class="finance-field-hint">
                                    Lower numbers appear first.
                                </small>

                                <ValidationMessage For="@(() => categoryModel.DisplayOrder)" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">
                                    Description
                                </label>

                                <InputTextArea class="form-control finance-control finance-textarea"
                                               @bind-Value="categoryModel.Description"
                                               placeholder="Describe the income grouped under this category" />
                            </div>

                            <div class="col-12">
                                <label class="finance-status-switch">
                                    <InputCheckbox class="form-check-input"
                                                   @bind-Value="categoryModel.IsActive" />

                                    <span>
                                        <strong>Active Category</strong>
                                        <small>
                                            Active categories can be selected when creating income types
                                        </small>
                                    </span>
                                </label>
                            </div>

                        </div>
                    </div>

                    <div class="finance-form-actions">

                        <button type="submit"
                                class="btn finance-primary-button"
                                disabled="@isSaving">

                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Saving...</span>
                            }
                            else if (categoryModel.Id == 0)
                            {
                                <i class="bi bi-check-circle me-2"></i>
                                <span>Save Category</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle me-2"></i>
                                <span>Update Category</span>
                            }
                    </button>

                    <button type="button"
                            class="btn finance-secondary-button"
                            disabled="@isSaving"
                            @onclick="ResetForm">

                        <i class="bi bi-arrow-counterclockwise me-2"></i>

                        @(categoryModel.Id == 0
                                                ? "Clear Form"
                                                : "Cancel Editing")
                    </button>

                    </div>

                </EditForm>
            </section>

            <section class="finance-panel finance-list-panel">

                <div class="finance-panel-header">
                    <div>
                        <div class="finance-section-label">
                            Category Register
                        </div>

                        <h4>Configured Income Categories</h4>

                        <p>
                            Review categories, linked income types and
                            operational status.
                        </p>
                    </div>

                    <span class="finance-count-badge">
                        @FilteredCategories.Count category(s)
                    </span>
                </div>

                <div class="finance-list-toolbar">

                    <div class="finance-search-box">
                        <i class="bi bi-search"></i>

                        <input class="form-control"
                               value="@searchText"
                               @oninput="HandleSearch"
                               placeholder="Search category, code or description" />

                    @if (!string.IsNullOrWhiteSpace(searchText))
                        {
                            <button type="button"
                                    @onclick="ClearSearch"
                                    title="Clear search">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        }
                    </div>

                    <select class="form-select finance-status-filter"
                            value="@statusFilter"
                            @onchange="HandleStatusFilter">

                        <option value="All">All categories</option>
                        <option value="Active">Active categories</option>
                        <option value="Inactive">Inactive categories</option>
                    </select>

                    <button type="button"
                            class="btn finance-refresh-button"
                            disabled="@isLoading"
                            @onclick="LoadCategories">

                        <i class="bi bi-arrow-clockwise"></i>
                    </button>

                </div>

                @if (isLoading)
                {
                    <div class="finance-loading-state">
                        <div class="spinner-border" role="status"></div>
                        <strong>Loading income categories...</strong>
                        <span>Please wait while the category register is prepared.</span>
                    </div>
                }
                else if (FilteredCategories.Count == 0)
                {
                    <div class="finance-empty-state">
                        <div class="finance-empty-icon">
                            <i class="bi bi-tags"></i>
                        </div>

                        <h5>No income category found</h5>

                        <p>
                            No category matches the current search or status filter.
                        </p>

                        <button type="button"
                                class="btn finance-secondary-button"
                                @onclick="ClearFilters">

                            <i class="bi bi-funnel me-2"></i>
                            Clear Filters
                        </button>
                    </div>
                }
                else
                {
                    <div class="finance-table-wrapper">
                        <table class="table finance-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Code</th>
                                    <th>Description</th>
                                    <th>Order</th>
                                    <th>Income Types</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var category in FilteredCategories)
                                {
                                    <tr class="@GetEditingRowClass(category.Id)">

                                        <td>
                                            <div class="finance-category-cell">
                                                <div class="finance-category-avatar">
                                                    @GetCategoryInitials(category.Name)
                                                </div>

                                                <strong>@category.Name</strong>
                                            </div>
                                        </td>

                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(category.Code))
                                            {
                                                <span class="finance-code-badge">
                                                    @category.Code
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="finance-muted-value">
                                                    Not assigned
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            <span title="@category.Description">
                                                @TruncateText(category.Description, 55)
                                            </span>
                                        </td>

                                        <td>
                                            <span class="finance-order-badge">
                                                @category.DisplayOrder
                                            </span>
                                        </td>

                                        <td>
                                            <span class="finance-type-count">
                                                @(category.IncomeTypes?.Count ?? 0)
                                            </span>
                                        </td>

                                        <td>
                                            @if (category.IsActive)
                                            {
                                                <span class="finance-status-badge status-active">
                                                    <span></span>
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="finance-status-badge status-inactive">
                                                    <span></span>
                                                    Inactive
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            <div class="finance-action-group">

                                                <button type="button"
                                                        class="finance-action-button action-edit"
                                                        title="Edit category"
                                                        @onclick="() => EditCategory(category)">

                                                    <i class="bi bi-pencil-square"></i>
                                                </button>

                                                <button type="button"
                                                        class="finance-action-button @(category.IsActive ? "action-disable" : "action-enable")"
                                                        title="@(category.IsActive ? "Deactivate category" : "Activate category")"
                                                        @onclick="() => ToggleStatus(category)">

                                                    @if (category.IsActive)
                                                    {
                                                        <i class="bi bi-toggle-on"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-toggle-off"></i>
                                                    }

                                                </button>

                                            </div>
                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </section>

        </div>
    </div>
}

@code {
    private List<IncomeCategory> incomeCategories = new();
    private IncomeCategory categoryModel = CreateEmptyModel();

    private string searchText = string.Empty;
    private string statusFilter = "All";

    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    private bool isLoading = true;
    private bool isSaving;

    private List<IncomeCategory> FilteredCategories
    {
        get
        {
            IEnumerable<IncomeCategory> query = incomeCategories;

            if (statusFilter == "Active")
            {
                query = query.Where(x => x.IsActive);
            }
            else if (statusFilter == "Inactive")
            {
                query = query.Where(x => !x.IsActive);
            }

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var term = searchText.Trim();

                query = query.Where(x =>
                    x.Name.Contains(
                        term,
                        StringComparison.OrdinalIgnoreCase) ||

                    (x.Code?.Contains(
                        term,
                        StringComparison.OrdinalIgnoreCase) ?? false) ||

                    (x.Description?.Contains(
                        term,
                        StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return query
                .OrderByDescending(x => x.IsActive)
                .ThenBy(x => x.DisplayOrder)
                .ThenBy(x => x.Name)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated &&
            AuthService.CanAccessAdminPanel())
        {
            await LoadCategories();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task LoadCategories()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            incomeCategories =
                await IncomeCategoryService.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load income categories: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveCategory()
    {
        if (isSaving)
        {
            return;
        }

        try
        {
            isSaving = true;
            ClearMessages();

            ServiceResult<IncomeCategory> result;

            if (categoryModel.Id == 0)
            {
                result = await IncomeCategoryService.CreateAsync(
                    categoryModel,
                    GetCurrentUserName());
            }
            else
            {
                result = await IncomeCategoryService.UpdateAsync(
                    categoryModel,
                    GetCurrentUserName());
            }

            if (!result.Success)
            {
                errorMessage = result.Message;
                return;
            }

            successMessage = result.Message;
            categoryModel = CreateEmptyModel();

            await LoadCategories();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to save the income category: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void EditCategory(IncomeCategory category)
    {
        ClearMessages();

        categoryModel = new IncomeCategory
        {
            Id = category.Id,
            Name = category.Name,
            Code = category.Code,
            Description = category.Description,
            DisplayOrder = category.DisplayOrder,
            IsActive = category.IsActive,
            CreatedDate = category.CreatedDate,
            CreatedBy = category.CreatedBy,
            LastModifiedDate = category.LastModifiedDate,
            LastModifiedBy = category.LastModifiedBy
        };
    }

    private async Task ToggleStatus(IncomeCategory category)
    {
        try
        {
            ClearMessages();

            var result =
                await IncomeCategoryService.ToggleStatusAsync(
                    category.Id,
                    GetCurrentUserName());

            if (!result.Success)
            {
                errorMessage = result.Message;
                return;
            }

            successMessage = result.Message;

            if (categoryModel.Id == category.Id)
            {
                categoryModel = CreateEmptyModel();
            }

            await LoadCategories();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to change the category status: {ex.Message}";
        }
    }

    private void StartNewCategory()
    {
        ResetForm();
    }

    private void ResetForm()
    {
        categoryModel = CreateEmptyModel();
        ClearMessages();
    }

    private static IncomeCategory CreateEmptyModel()
    {
        return new IncomeCategory
        {
            DisplayOrder = 0,
            IsActive = true
        };
    }

    private void HandleSearch(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
    }

    private void HandleStatusFilter(ChangeEventArgs args)
    {
        statusFilter = args.Value?.ToString() ?? "All";
    }

    private void ClearSearch()
    {
        searchText = string.Empty;
    }

    private void ClearFilters()
    {
        searchText = string.Empty;
        statusFilter = "All";
    }

    private void ClearMessages()
    {
        successMessage = string.Empty;
        errorMessage = string.Empty;
    }

    private static string GetCurrentUserName()
    {
        return "System User";
    }

    private string GetEditingRowClass(int categoryId)
    {
        return categoryModel.Id == categoryId
            ? "finance-editing-row"
            : string.Empty;
    }

    private static string GetCategoryInitials(string categoryName)
    {
        if (string.IsNullOrWhiteSpace(categoryName))
        {
            return "IC";
        }

        var words = categoryName
            .Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .ToArray();

        return string.Concat(words.Select(x => x[0]))
            .ToUpperInvariant();
    }

    private static string TruncateText(
        string? text,
        int maximumLength)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return "No description";
        }

        return text.Length <= maximumLength
            ? text
            : $"{text[..maximumLength]}...";
    }
}

<style>
