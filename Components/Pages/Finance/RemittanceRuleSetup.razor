        color: #0f172a;
        font-size: 1rem;
        font-weight: 800
    }

    .finance-access-card p {
        color: #64748b;
        font-size: .75rem
    }

    .finance-alert {
        margin-bottom: 14px;
        padding: 10px 12px;
        border: 1px solid;
        border-radius: 9px;
        display: flex;
        gap: 9px;
        font-size: .68rem
    }

    .finance-alert-success {
        border-color: #bbf7d0;
        background: #f0fdf4;
        color: #166534
    }

    .finance-alert-danger {
        border-color: #fecaca;
        background: #fef2f2;
        color: #991b1b
    }

