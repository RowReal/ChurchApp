@page "/finance/remittance-rules"
@rendermode InteractiveServer

@using ChurchApp.Models.Finance
@using ChurchApp.Services
@inject RemittanceRuleService RemittanceRuleService
@inject IncomeTypeService IncomeTypeService
@inject RemittanceElementService RemittanceElementService
@inject AuthService AuthService

<PageTitle>Remittance Rule Setup</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="finance-access-card"><h4>Authentication Required</h4><p>Please sign in to access Finance Setup.</p></div>
}
else if (!AuthService.CanAccessAdminPanel())
{
    <div class="finance-access-card"><h4>Access Restricted</h4><p>You do not have permission to manage remittance rules.</p></div>
}
else
{
    <div class="worker360-page finance-page">
        <div class="bcc-page-header">
            <div>
                <div class="bcc-page-subtitle"><i class="fas fa-sliders-h me-2"></i>Finance Configuration</div>
                <div class="bcc-page-title">Remittance Rule Setup</div>
                <div class="bcc-page-subtitle">Manage direct, derived and independent remittance rules with effective dates.</div>
            </div>
            <div class="finance-header-actions">
                <button type="button" class="bcc-btn bcc-btn-primary finance-compact-btn" @onclick="ResetForm"><i class="fas fa-plus me-2"></i>New Rule</button>
                <a href="/workspace/setup" class="bcc-btn profile-form-secondary-btn finance-compact-btn"><i class="fas fa-arrow-left me-2"></i>Setup Workspace</a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="finance-alert finance-alert-success"><i class="bi bi-check-circle-fill"></i><div><strong>Successful</strong><div>@successMessage</div></div></div>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="finance-alert finance-alert-danger"><i class="bi bi-exclamation-circle-fill"></i><div><strong>Unable to complete request</strong><div>@errorMessage</div></div></div>
        }

        <section class="finance-summary-grid">
            <div class="finance-summary-card summary-blue"><div class="finance-summary-icon"><i class="bi bi-list-check"></i></div><div><span>Total Rules</span><strong>@rules.Count</strong><small>Configured remittance rules</small></div></div>
            <div class="finance-summary-card summary-green"><div class="finance-summary-icon"><i class="bi bi-check-circle"></i></div><div><span>Active Rules</span><strong>@rules.Count(x => x.IsActive)</strong><small>Enabled rules</small></div></div>
            <div class="finance-summary-card summary-purple"><div class="finance-summary-icon"><i class="bi bi-calendar-event"></i></div><div><span>Currently Effective</span><strong>@rules.Count(IsCurrentlyEffective)</strong><small>Active as of today</small></div></div>
            <div class="finance-summary-card summary-gold"><div class="finance-summary-icon"><i class="bi bi-collection"></i></div><div><span>Eligible Income Types</span><strong>@incomeTypes.Count(x => x.IsActive && x.RemittanceApplicable)</strong><small>Available for new rules</small></div></div>
        </section>

        <div class="finance-workspace-grid">
            <section class="finance-panel finance-form-panel">
                <div class="finance-panel-header"><div><div class="finance-section-label">Remittance Configuration</div><h4>@(model.Id == 0 ? "New Remittance Rule" : "Edit Remittance Rule")</h4><p>Define the calculation and the period during which it applies.</p></div></div>
                <EditForm Model="@model" OnValidSubmit="@Save" FormName="RemittanceRuleSetupForm" @key="formKey">
                    <DataAnnotationsValidator />
                    <div class="finance-validation-summary"><ValidationSummary /></div>
                    <div class="finance-form-section">
                        <div class="finance-form-section-title"><i class="bi bi-collection"></i><div><strong>Income & Calculation</strong><span>Select an income source or Independent, then choose a calculation method</span></div></div>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Income Type / Independent <span class="required-mark">*</span></label>
                                <InputSelect class="form-select finance-control" @bind-Value="SelectedIncomeType">
                                    <option value="">Select income type</option>
                                    <option value="-1">Independent (no income type)</option>
                                    @foreach (var item in EligibleIncomeTypes)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Remittance Element <span class="required-mark">*</span></label>
                                <InputSelect class="form-select finance-control" @bind-Value="model.RemittanceElementId">
                                    <option value="0">Select remittance element</option>
                                    @foreach (var item in EligibleRemittanceElements)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                </InputSelect>
                                <small class="finance-field-hint">Manage elements in <a href="/finance/remittance-elements">Remittance Element Setup</a>.</small>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Calculation Basis</label>
                                <InputSelect class="form-select finance-control" @bind-Value="SelectedCalculationBasis">
                                    <option value="@RemittanceCalculationBasis.PercentageOfIncome">Percentage of Income</option>
                                    <option value="@RemittanceCalculationBasis.PercentageOfDerivedAmount">Percentage of Derived Amount</option>
                                    <option value="@RemittanceCalculationBasis.Independent">Independent / Discretionary</option>
                                </InputSelect>
                            </div>
                            @if (model.CalculationBasis == RemittanceCalculationBasis.PercentageOfIncome || model.CalculationBasis == RemittanceCalculationBasis.PercentageOfDerivedAmount)
                            {
                                @if (model.CalculationBasis == RemittanceCalculationBasis.PercentageOfDerivedAmount)
                                {
                                    <div class="col-12">
                                        <label class="form-label">Derived Base Percentage (%) <span class="required-mark">*</span></label>
                                        <InputNumber class="form-control finance-control" @bind-Value="model.DerivedBasePercentage" step="0.0001" min="0" max="100" />
                                        <small class="finance-field-hint">Example: enter 70 to calculate remittance from 70% of the selected income.</small>
                                    </div>
                                }
                                <div class="col-12">
                                    <label class="form-label">Remittance Percentage (%) <span class="required-mark">*</span></label>
                                    <InputNumber class="form-control finance-control" @bind-Value="model.Percentage" step="0.0001" min="0" max="100" />
                                    <small class="finance-field-hint">@(model.CalculationBasis == RemittanceCalculationBasis.PercentageOfDerivedAmount ? "Example: enter 20 for 20% of the derived base." : "Percentage of the selected income type.")</small>
                                </div>
                            }
                            else if (model.CalculationBasis == RemittanceCalculationBasis.Independent)
                            {
                                <div class="col-12"><div class="finance-field-hint">No income source, percentage or fixed amount is required. The amount will be entered during monthly remittance processing.</div></div>
                            }
                        </div>
                    </div>
                    <div class="finance-form-section">
                        <div class="finance-form-section-title"><i class="bi bi-calendar-range"></i><div><strong>Effective Period</strong><span>Protect historical remittance calculations</span></div></div>
                        <div class="row g-3">
                            <div class="col-md-6"><label class="form-label">Effective From <span class="required-mark">*</span></label><InputDate class="form-control finance-control" @bind-Value="model.EffectiveFrom" /></div>
                            <div class="col-md-6"><label class="form-label">Effective To (optional)</label><InputDate class="form-control finance-control" @bind-Value="model.EffectiveTo" /><small class="finance-field-hint">Leave blank for an open-ended rule.</small></div>
                            <div class="col-12"><label class="form-label">Remarks</label><InputTextArea class="form-control finance-control finance-textarea" @bind-Value="model.Remarks" placeholder="Reason or approval reference for this rule" /></div>
                            <div class="col-12"><label class="finance-status-switch"><InputCheckbox class="form-check-input" @bind-Value="model.IsActive" /><span><strong>Active Rule</strong><small>Only active rules are considered when determining the applicable rate.</small></span></label></div>
                        </div>
                    </div>
                    <div class="finance-form-actions">
                        <button type="submit" class="finance-primary-button" disabled="@isSaving"><i class="bi bi-check2-circle me-2"></i>@(isSaving ? "Saving..." : model.Id == 0 ? "Save Remittance Rule" : "Update Remittance Rule")</button>
                        <button type="button" class="finance-secondary-button" @onclick="ResetForm"><i class="bi bi-arrow-counterclockwise me-2"></i>Reset</button>
                    </div>
                </EditForm>
            </section>
            <section class="finance-panel finance-list-panel">
                <div class="finance-panel-header"><div><div class="finance-section-label">Remittance Register</div><h4>Configured Rules</h4><p>Review effective periods, rates and status.</p></div><span class="finance-count-badge">@Filtered.Count record(s)</span></div>
                <div class="finance-list-toolbar">
                    <div class="finance-search-box"><i class="bi bi-search"></i><input class="form-control" value="@searchText" @oninput="HandleSearch" placeholder="Search income type, element or remarks" /></div>
                    <select class="form-select finance-status-filter" value="@statusFilter" @onchange="HandleStatusFilter"><option value="All">All statuses</option><option value="Active">Active only</option><option value="Inactive">Inactive only</option><option value="Current">Currently effective</option></select>
                    <button type="button" class="finance-refresh-button" title="Reload" @onclick="LoadData"><i class="bi bi-arrow-clockwise"></i></button>
                </div>
                @if (isLoading)
                {
                    <div class="finance-loading-state"><div class="spinner-border"></div><p>Loading remittance rules...</p></div>
                }
                else if (Filtered.Count == 0)
                {
                    <div class="finance-empty-state"><div class="finance-empty-icon"><i class="bi bi-list-check"></i></div><h5>No remittance rules found</h5><p>Create a new rule or adjust your filters.</p></div>
                }
                else
                {
                    <div class="finance-table-wrapper">
                        <table class="table finance-table">
                            <thead><tr><th>Income Type</th><th>Remittance Element</th><th>Basis / Rate</th><th>Effective Period</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                            <tbody>
                                @foreach (var item in Filtered)
                                {
                                    <tr class="@(model.Id == item.Id ? "finance-editing-row" : "")">
                                        <td><div class="finance-category-cell"><div class="finance-category-avatar">@GetInitials(item.IncomeType?.Name)</div><div><strong>@(item.CalculationBasis == RemittanceCalculationBasis.Independent ? "Independent" : item.IncomeType?.Name ?? "Unknown")</strong><small>@(item.Remarks ?? "No remarks")</small></div></div></td>
                                        <td><strong>@(item.RemittanceElement?.Name ?? "Unassigned")</strong><small class="d-block text-muted">@item.RemittanceElement?.Code</small></td>
                                        <td><strong>@GetRate(item)</strong><small class="d-block text-muted">@GetBasis(item.CalculationBasis)</small></td>
                                        <td><strong>@item.EffectiveFrom.ToString("dd MMM yyyy")</strong><small class="d-block text-muted">to @(item.EffectiveTo?.ToString("dd MMM yyyy") ?? "Open-ended")</small></td>
                                        <td><span class="finance-status-badge @(item.IsActive ? "status-active" : "status-inactive")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                                        <td><div class="finance-action-group"><button type="button" class="finance-action-button action-edit" title="Edit" @onclick="() => Edit(item)"><i class="bi bi-pencil"></i></button><button type="button" class="finance-action-button @(item.IsActive ? "action-disable" : "action-enable")" title="@(item.IsActive ? "Deactivate" : "Activate")" @onclick="() => ToggleStatus(item)"><i class="bi @(item.IsActive ? "bi-pause" : "bi-play")"></i></button></div></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    </div>
}

@code {
    private List<RemittanceRule> rules = new();
    private List<IncomeType> incomeTypes = new();
    private List<RemittanceElement> remittanceElements = new();
    private RemittanceRule model = NewModel();
    private int formKey;
    private bool isLoading = true;
    private bool isSaving;
    private string successMessage = "";
    private string errorMessage = "";
    private string searchText = "";
    private string statusFilter = "All";

    // The -1 selection is a UI-only sentinel; independent rules persist a null IncomeTypeId.
    private int? SelectedIncomeType
    {
        get => model.CalculationBasis == RemittanceCalculationBasis.Independent ? -1 : model.IncomeTypeId;
        set
        {
            if (value == -1)
            {
                model.IncomeTypeId = null;
                model.CalculationBasis = RemittanceCalculationBasis.Independent;
                model.Percentage = 0m;
                model.DerivedBasePercentage = null;
                model.FixedAmount = null;
            }
            else
            {
                model.IncomeTypeId = value;
                if (model.CalculationBasis == RemittanceCalculationBasis.Independent)
                    model.CalculationBasis = RemittanceCalculationBasis.PercentageOfIncome;
            }
        }
    }

    private RemittanceCalculationBasis SelectedCalculationBasis
    {
        get => model.CalculationBasis;
        set
        {
            model.CalculationBasis = value;
            if (value == RemittanceCalculationBasis.Independent)
            {
                model.IncomeTypeId = null;
                model.Percentage = 0m;
                model.DerivedBasePercentage = null;
                model.FixedAmount = null;
            }
            else if (value != RemittanceCalculationBasis.PercentageOfDerivedAmount)
            {
                model.DerivedBasePercentage = null;
            }
        }
    }

    private List<IncomeType> EligibleIncomeTypes => incomeTypes.Where(x => (x.IsActive && x.RemittanceApplicable) || x.Id == model.IncomeTypeId).OrderBy(x => x.Name).ToList();
    private List<RemittanceElement> EligibleRemittanceElements => remittanceElements.Where(x => x.IsActive || x.Id == model.RemittanceElementId).OrderBy(x => x.Name).ToList();
    private List<RemittanceRule> Filtered => rules.Where(x => (statusFilter switch { "Active" => x.IsActive, "Inactive" => !x.IsActive, "Current" => IsCurrentlyEffective(x), _ => true }) && (string.IsNullOrWhiteSpace(searchText) || (x.CalculationBasis == RemittanceCalculationBasis.Independent && "Independent".Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase)) || (x.IncomeType?.Name.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) || (x.RemittanceElement?.Name.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) || (x.RemittanceElement?.Code?.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) || (x.Remarks?.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))).ToList();
    private static bool IsCurrentlyEffective(RemittanceRule x) => x.IsActive && x.EffectiveFrom.Date <= DateTime.Today && (!x.EffectiveTo.HasValue || x.EffectiveTo.Value.Date >= DateTime.Today);
    protected override async Task OnInitializedAsync() { if (AuthService.IsAuthenticated && AuthService.CanAccessAdminPanel()) await LoadData(); else isLoading = false; }
    private async Task LoadData()
    {
        try { isLoading = true; rules = await RemittanceRuleService.GetAllAsync(); incomeTypes = await IncomeTypeService.GetAllAsync(); remittanceElements = await RemittanceElementService.GetAllAsync(); }
        catch (Exception ex) { errorMessage = $"Unable to load remittance rules: {ex.Message}"; }
        finally { isLoading = false; }
    }
    private async Task Save()
    {
        if (isSaving) return;
        try
        {
            isSaving = true; successMessage = ""; errorMessage = "";
            if (model.CalculationBasis == RemittanceCalculationBasis.Independent)
                model.IncomeTypeId = null;
            else if (!model.IncomeTypeId.HasValue || model.IncomeTypeId.Value <= 0)
            {
                errorMessage = "Select an income type, or choose Independent for discretionary remittance.";
                return;
            }
            var result = model.Id == 0 ? await RemittanceRuleService.CreateAsync(model, GetCurrentUserName()) : await RemittanceRuleService.UpdateAsync(model, GetCurrentUserName());
            if (!result.Success) { errorMessage = result.Message; return; }
            ResetForm(); successMessage = result.Message; await LoadData();
        }
        catch (Exception ex) { errorMessage = $"Unable to save the remittance rule: {ex.Message}"; }
        finally { isSaving = false; }
    }
    private void Edit(RemittanceRule item)
    {
        successMessage = ""; errorMessage = "";
        model = new RemittanceRule { Id = item.Id, IncomeTypeId = item.IncomeTypeId, RemittanceElementId = item.RemittanceElementId, CalculationBasis = item.CalculationBasis, Percentage = item.Percentage, DerivedBasePercentage = item.DerivedBasePercentage, FixedAmount = item.FixedAmount, EffectiveFrom = item.EffectiveFrom, EffectiveTo = item.EffectiveTo, Remarks = item.Remarks, IsActive = item.IsActive };
        formKey++;
    }
    private async Task ToggleStatus(RemittanceRule item)
    {
        try
        {
            successMessage = ""; errorMessage = "";
            var result = await RemittanceRuleService.ToggleStatusAsync(item.Id, GetCurrentUserName());
            if (!result.Success) { errorMessage = result.Message; return; }
            if (model.Id == item.Id) ResetForm();
            successMessage = result.Message; await LoadData();
        }
        catch (Exception ex) { errorMessage = $"Unable to change the rule status: {ex.Message}"; }
    }
    private void ResetForm() { model = NewModel(); formKey++; successMessage = ""; errorMessage = ""; }
    private static RemittanceRule NewModel() => new() { EffectiveFrom = DateTime.Today, CalculationBasis = RemittanceCalculationBasis.PercentageOfIncome, IsActive = true };
    private void HandleSearch(ChangeEventArgs e) => searchText = e.Value?.ToString() ?? "";
    private void HandleStatusFilter(ChangeEventArgs e) => statusFilter = e.Value?.ToString() ?? "All";
    private static string GetCurrentUserName() => "System User";
    private static string GetInitials(string? value) => string.IsNullOrWhiteSpace(value) ? "RR" : string.Concat(value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
    private static string GetBasis(RemittanceCalculationBasis basis) => basis switch { RemittanceCalculationBasis.PercentageOfIncome => "Percentage of Income", RemittanceCalculationBasis.PercentageOfDerivedAmount => "Percentage of Derived Amount", RemittanceCalculationBasis.Independent => "Independent / Discretionary", RemittanceCalculationBasis.FixedAmount => "Fixed Amount (legacy)", _ => "Not Applicable (legacy)" };
    private static string GetRate(RemittanceRule rule) => rule.CalculationBasis switch { RemittanceCalculationBasis.PercentageOfIncome => $"{rule.Percentage:0.####}%", RemittanceCalculationBasis.PercentageOfDerivedAmount => $"{rule.Percentage:0.####}% of {rule.DerivedBasePercentage:0.####}%", RemittanceCalculationBasis.Independent => "Amount set monthly", RemittanceCalculationBasis.FixedAmount => $"{rule.FixedAmount:N2} (legacy fixed)", _ => "Not applicable" };
}

<style>
    .finance-page {
        max-width: 1300px;
        margin: 0 auto
    }

        .finance-page .bcc-page-header {
            margin-bottom: 16px
        }

    .finance-header-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap
    }

    .finance-compact-btn {
        min-height: 32px;
        padding: 6px 11px;
        font-size: .78rem
    }

