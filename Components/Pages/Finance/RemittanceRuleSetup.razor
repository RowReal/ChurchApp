        max-width: 520px;
        margin: 70px auto;
        padding: 28px;
        text-align: center;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-top: 4px solid #7c3aed;
        border-radius: 12px
    }

    .finance-access-icon {
        width: 52px;
        height: 52px;
        margin: 0 auto 12px;
        display: grid;
        place-items: center;
