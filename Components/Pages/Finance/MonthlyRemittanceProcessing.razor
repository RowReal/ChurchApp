    }</style>

@code {
    private int selectedYear = DateTime.Today.Year;
    private int selectedMonth = DateTime.Today.Month;
    private bool isChecking;
    private bool isPreparing;
    private bool preparationRequested;
    private sealed class RemittancePreviewRow
    {
        public string IncomeName { get; set; } = "";
        public string Currency { get; set; } = "";
        public decimal? QualifyingAmount { get; set; }
        public string RuleDescription { get; set; } = "";
        public decimal? Remittance { get; set; }
    }
    private sealed class PreviewAccountRow
    {
        public string Name { get; set; } = "";
        public string Currency { get; set; } = "";
        public decimal Balance { get; set; }
    }
    private sealed class PreviewIncomeRow
    {
        public int IncomeTypeId { get; set; }
        public string IncomeName { get; set; } = "";
        public string Currency { get; set; } = "";
        public decimal Income { get; set; }
    }
    private List<RemittancePreviewRow> previewRows = new();
    private List<PreviewAccountRow> previewAccounts = new();
    private List<PreviewIncomeRow> previewIncomeRows = new();
    private List<string> previewWarnings = new();
    private MonthlyRemittanceValidationIssue? selectedIssue;
    private ChurchCollectionRecord? detailCollection;
    private ChurchApp.Models.Finance.BankAccountJournal? detailJournal;
    private List<ChurchApp.Models.Finance.BankAccountJournal> detailCorrections = new();
    private decimal effectiveJournalAmount;
    private Dictionary<string, string> detailWorkerNames = new(StringComparer.OrdinalIgnoreCase);

    private string WorkerDisplayName(string? workerId)
        => string.IsNullOrWhiteSpace(workerId) ? "—"
           : detailWorkerNames.TryGetValue(workerId, out var name) ? name : "Unknown worker";
    private bool detailLoading;
    private string? detailError;

    private void CloseDetails() => selectedIssue = null;

    private async Task ViewIssue(MonthlyRemittanceValidationIssue issue)
    {
        selectedIssue = issue;
        detailCollection = null;
        detailJournal = null;
        detailCorrections = new();
        detailWorkerNames.Clear();
        detailError = null;
        detailLoading = true;
        try
        {
            if (issue.CollectionId.HasValue)
                detailCollection = await Db.ChurchCollectionRecords.AsNoTracking()
                    .FirstOrDefaultAsync(x => x.Id == issue.CollectionId.Value);
            if (issue.JournalId.HasValue)
                detailJournal = await Db.BankAccountJournals.AsNoTracking()
                    .FirstOrDefaultAsync(x => x.Id == issue.JournalId.Value);
            if (detailJournal is null && issue.CollectionId.HasValue)
                detailJournal = await Db.BankAccountJournals.AsNoTracking()
                    .FirstOrDefaultAsync(x => x.SourceCollectionId == issue.CollectionId.Value &&
                        x.TransactionType == BankJournalTransactionType.CollectionPosting);
            var workerIds = new[] { detailCollection?.RecordedByWorkerId, detailJournal?.PostedByWorkerId }
                .Where(id => !string.IsNullOrWhiteSpace(id)).Select(id => id!).Distinct().ToList();
            if (workerIds.Count > 0)
            {
                var workers = await Db.Workers.AsNoTracking()
                    .Where(w => workerIds.Contains(w.WorkerId))
                    .Select(w => new { w.WorkerId, w.FirstName, w.LastName }).ToListAsync();
                detailWorkerNames = workers.ToDictionary(w => w.WorkerId,
                    w => $"{w.FirstName} {w.LastName}".Trim(), StringComparer.OrdinalIgnoreCase);
            }
            if (detailJournal is not null)
            {
                detailCorrections = await Db.BankAccountJournals.AsNoTracking()
                    .Where(x => x.ReversesJournalId == detailJournal.Id).ToListAsync();
                effectiveJournalAmount = detailJournal.Amount;
                foreach (var correction in detailCorrections.Where(x => x.Status == BankJournalStatus.Posted))
                    effectiveJournalAmount += correction.Direction == detailJournal.Direction
                        ? correction.Amount : -correction.Amount;
            }
        }
        catch (Exception ex) { detailError = ex.Message; }
        finally { detailLoading = false; }
    }

    private string? errorMessage;
    private MonthlyRemittanceValidationResult? validationResult;

    private string ReportPeriod => new DateTime(validationResult?.Year ?? selectedYear, validationResult?.Month ?? selectedMonth, 1)
        .ToString("MMMM yyyy", CultureInfo.InvariantCulture);

    private void ClearResult()
    {
        validationResult = null;
        errorMessage = null;
        preparationRequested = false;
        ResetPreview();
        CloseDetails();
    }

    private async Task PrepareRemittance()
    {
        if (isChecking || isPreparing || validationResult?.CanProceed != true)
            return;

        isPreparing = true;
        preparationRequested = false;
        ResetPreview();
        errorMessage = null;
        try
        {
            // Never trust the previous UI result: financial records may have changed.
            validationResult = await ValidationService.ValidateAsync(selectedYear, selectedMonth);
            if (validationResult.CanProceed)
            {
                await BuildPreviewAsync();
                preparationRequested = true;
            }
        }
        catch (Exception ex)
        {
            validationResult = null;
            errorMessage = ex.Message;
        }
        finally
        {
            isPreparing = false;
        }
    }

    private void ResetPreview()
    {
        previewRows.Clear();
        previewAccounts.Clear();
        previewIncomeRows.Clear();
        previewWarnings.Clear();
    }

    private async Task BuildPreviewAsync()
    {
        ResetPreview();
        var start = new DateTime(selectedYear, selectedMonth, 1);
        var end = start.AddMonths(1);
        var monthEnd = end.AddDays(-1);

        var accounts = await Db.BankAccounts.AsNoTracking()
            .Where(x => x.IsActive && x.CanPayRemittance)
            .OrderBy(x => x.BankName).ThenBy(x => x.ShortName).ToListAsync();
        var postedLedger = await Db.BankAccountJournals.AsNoTracking()
            .Where(x => x.Status == BankJournalStatus.Posted && x.TransactionDate < end)
            .Select(x => new { x.BankAccountId, x.Direction, x.Amount }).ToListAsync();
        foreach (var account in accounts)
        {
            var balance = account.OpeningBalance;
            foreach (var entry in postedLedger.Where(x => x.BankAccountId == account.Id))
                balance += entry.Direction == BankJournalDirection.Credit ? entry.Amount : -entry.Amount;
            previewAccounts.Add(new PreviewAccountRow
            {
                Name = $"{account.BankName} — {account.AccountTitle} ({account.ShortName})",
                Currency = account.Currency.ToString(),
                Balance = balance
            });
        }

        var collections = await Db.ChurchCollectionRecords.AsNoTracking()
            .Where(x => x.CollectionDate >= start && x.CollectionDate < end &&
                        !x.IsRemoved && x.Status == ChurchCollectionService.StatusApproved)
            .Select(x => new { x.IncomeTypeId, x.Currency, x.Amount }).ToListAsync();
        var direct = await Db.BankAccountJournals.AsNoTracking()
            .Where(x => x.TransactionType == BankJournalTransactionType.DirectBankReceipt &&
                        x.Status == BankJournalStatus.Posted &&
                        x.TransactionDate >= start && x.TransactionDate < end)
            .ToListAsync();
        var directIds = direct.Select(x => x.Id).ToList();
        var corrections = await Db.BankAccountJournals.AsNoTracking()
            .Where(x => x.ReversesJournalId.HasValue && directIds.Contains(x.ReversesJournalId.Value) &&
                        x.Status == BankJournalStatus.Posted).ToListAsync();

        var income = new Dictionary<(int Id, string Currency), decimal>();
        foreach (var c in collections)
        {
            var key = (c.IncomeTypeId, c.Currency ?? "NGN");
            income[key] = income.GetValueOrDefault(key) + c.Amount;
        }
        foreach (var d in direct)
        {
            if (!d.IncomeTypeId.HasValue)
            {
                previewWarnings.Add($"Direct receipt #{d.Id} has no Income Type.");
                continue;
            }
            var net = d.Direction == BankJournalDirection.Credit ? d.Amount : -d.Amount;
            foreach (var correction in corrections.Where(x => x.ReversesJournalId == d.Id))
                net += correction.Direction == BankJournalDirection.Credit ? correction.Amount : -correction.Amount;
            var key = (d.IncomeTypeId.Value, d.Currency.ToString());
            income[key] = income.GetValueOrDefault(key) + net;
        }

        var types = await Db.IncomeTypes.AsNoTracking().ToDictionaryAsync(x => x.Id);
        foreach (var item in income.OrderBy(x => types.TryGetValue(x.Key.Id, out var t) ? t.Name : ""))
        {
            if (!types.TryGetValue(item.Key.Id, out var type) || !type.RemittanceApplicable)
                continue;
            previewIncomeRows.Add(new PreviewIncomeRow
            {
                IncomeTypeId = item.Key.Id,
                IncomeName = type.Name,
                Currency = item.Key.Currency,
                Income = item.Value
            });
        }

        var elements = await Db.RemittanceElements.AsNoTracking()
            .Where(x => x.IsActive).OrderBy(x => x.Name).ToListAsync();
        var rules = await Db.RemittanceRules.AsNoTracking()
            .Where(x => x.IsActive && x.EffectiveFrom < end &&
                        (!x.EffectiveTo.HasValue || x.EffectiveTo.Value >= start))
            .ToListAsync();
        foreach (var element in elements)
        {
            var relevant = rules.Where(x => x.RemittanceElementId == element.Id).ToList();
            var currencies = previewIncomeRows.Where(x => relevant.Any(r => r.IncomeTypeId == x.IncomeTypeId))
                .Select(x => x.Currency).Distinct().ToList();
            if (currencies.Count == 0) currencies.Add("");
            foreach (var currency in currencies)
            {
                var row = new RemittancePreviewRow { IncomeName = element.Name, Currency = currency };
                var relevantIncome = previewIncomeRows.Where(x => x.Currency == currency &&
                    relevant.Any(r => r.IncomeTypeId == x.IncomeTypeId)).ToList();
                decimal qualifying = 0m, amount = 0m;
                var ruleLabels = new List<string>();
                var valid = relevantIncome.Count > 0;
                foreach (var source in relevantIncome)
                {
                    var candidates = relevant.Where(x => x.IncomeTypeId == source.IncomeTypeId &&
                        x.EffectiveFrom.Date <= start &&
                        (!x.EffectiveTo.HasValue || x.EffectiveTo.Value.Date >= monthEnd)).ToList();
                    if (candidates.Count != 1)
                    {
                        valid = false;
                        previewWarnings.Add($"{element.Name} / {source.IncomeName}: expected one full-month rule; found {candidates.Count}.");
                        continue;
                    }
                    var rule = candidates[0];
                    qualifying += source.Income;
                    if (rule.CalculationBasis == RemittanceCalculationBasis.PercentageOfIncome)
                    {
                        amount += decimal.Round(source.Income * rule.Percentage / 100m, 2, MidpointRounding.AwayFromZero);
                        ruleLabels.Add($"{source.IncomeName}: {rule.Percentage:0.####}%");
                    }
                    else if (rule.CalculationBasis == RemittanceCalculationBasis.PercentageOfDerivedAmount)
                    {
                        if (!rule.DerivedBasePercentage.HasValue)
                        {
                            valid = false;
                            previewWarnings.Add($"{element.Name} / {source.IncomeName}: derived base percentage is missing.");
                            continue;
                        }
                        // The configured derived base is applied first, then the rule percentage.
                        // Example: 20% of 70% of the qualifying income.
                        var derivedBase = decimal.Round(source.Income * rule.DerivedBasePercentage.Value / 100m,
                            2, MidpointRounding.AwayFromZero);
                        amount += decimal.Round(derivedBase * rule.Percentage / 100m,
                            2, MidpointRounding.AwayFromZero);
                        ruleLabels.Add($"{source.IncomeName}: {rule.Percentage:0.####}% of {rule.DerivedBasePercentage.Value:0.####}%");
                    }
                    else if (rule.CalculationBasis == RemittanceCalculationBasis.FixedAmount && rule.FixedAmount.HasValue)
                    {
                        amount += rule.FixedAmount.Value;
                        ruleLabels.Add($"{source.IncomeName}: fixed {rule.FixedAmount.Value:N2}");
                    }
                    else if (rule.CalculationBasis == RemittanceCalculationBasis.Independent ||
                             rule.CalculationBasis == RemittanceCalculationBasis.NotApplicable)
                    {
                        // Intentionally blank: no automatic calculation is defined.
                        valid = false;
                    }
                    else
                    {
                        valid = false;
                        previewWarnings.Add($"{element.Name} / {source.IncomeName} has an unrecognised calculation basis.");
                    }
                }
                if (valid)
                {
                    row.QualifyingAmount = qualifying;
                    row.Remittance = amount;
                    row.RuleDescription = string.Join("; ", ruleLabels);
                }
                previewRows.Add(row);
            }
        }
        if (previewRows.Any(x => !x.Remittance.HasValue))
            previewWarnings.Add("Blank remittance elements require review or manual processing in a later step.");
    }

    private async Task CheckReadiness()
    {
        isChecking = true;
        preparationRequested = false;
        ResetPreview();
        errorMessage = null;
        validationResult = null;
        CloseDetails();
        try
        {
            validationResult = await ValidationService.ValidateAsync(selectedYear, selectedMonth);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isChecking = false;
        }
    }
}









































