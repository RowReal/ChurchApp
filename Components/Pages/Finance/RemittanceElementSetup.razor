@page "/finance/remittance-elements"
@rendermode InteractiveServer

@using ChurchApp.Models.Finance
@using ChurchApp.Services
@inject RemittanceElementService RemittanceElementService
@inject AuthService AuthService

<PageTitle>Remittance Element Setup</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="finance-access-card"><h4>Authentication Required</h4><p>Please sign in to access Finance Setup.</p></div>
}
else if (!AuthService.CanAccessAdminPanel())
{
    <div class="finance-access-card"><h4>Access Restricted</h4><p>You do not have permission to manage remittance elements.</p></div>
}
else
{
    <div class="worker360-page finance-page">
        <div class="bcc-page-header">
            <div>
                <div class="bcc-page-subtitle"><i class="fas fa-sliders-h me-2"></i>Finance Configuration</div>
                <div class="bcc-page-title">Remittance Element Setup</div>
                <div class="bcc-page-subtitle">Configure the remittance obligations used in monthly processing.</div>
            </div>
            <div class="finance-header-actions">
                <button type="button" class="bcc-btn bcc-btn-primary finance-compact-btn" @onclick="ResetForm"><i class="fas fa-plus me-2"></i>New Element</button>
                <a href="/finance/remittance-rules" class="bcc-btn profile-form-secondary-btn finance-compact-btn"><i class="fas fa-list me-2"></i>Remittance Rules</a>
                <a href="/workspace/setup" class="bcc-btn profile-form-secondary-btn finance-compact-btn"><i class="fas fa-arrow-left me-2"></i>Setup Workspace</a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="finance-alert finance-alert-success"><i class="bi bi-check-circle-fill"></i><div><strong>Successful</strong><div>@successMessage</div></div></div>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="finance-alert finance-alert-danger"><i class="bi bi-exclamation-circle-fill"></i><div><strong>Unable to complete request</strong><div>@errorMessage</div></div></div>
        }

        <section class="finance-summary-grid">
            <div class="finance-summary-card summary-blue"><div class="finance-summary-icon"><i class="bi bi-collection"></i></div><div><span>Total Elements</span><strong>@elements.Count</strong><small>Configured elements</small></div></div>
            <div class="finance-summary-card summary-green"><div class="finance-summary-icon"><i class="bi bi-check-circle"></i></div><div><span>Active Elements</span><strong>@elements.Count(x => x.IsActive)</strong><small>Available for rules</small></div></div>
            <div class="finance-summary-card summary-purple"><div class="finance-summary-icon"><i class="bi bi-pause-circle"></i></div><div><span>Inactive Elements</span><strong>@elements.Count(x => !x.IsActive)</strong><small>Not available for new rules</small></div></div>
        </section>

        <div class="finance-workspace-grid">
            <section class="finance-panel finance-form-panel">
                <div class="finance-panel-header"><div><div class="finance-section-label">Remittance Configuration</div><h4>@(model.Id == 0 ? "New Remittance Element" : "Edit Remittance Element")</h4><p>Define the name, optional code and description of an obligation.</p></div></div>
                <EditForm Model="@model" OnValidSubmit="@Save" FormName="RemittanceElementSetupForm" @key="formKey">
                    <DataAnnotationsValidator />
                    <div class="finance-validation-summary"><ValidationSummary /></div>
                    <div class="finance-form-section">
                        <div class="finance-form-section-title"><i class="bi bi-collection"></i><div><strong>Element Details</strong><span>Each element can be linked to several income types</span></div></div>
                        <div class="row g-3">
                            <div class="col-12"><label class="form-label">Element Name <span class="required-mark">*</span></label><InputText class="form-control finance-control" @bind-Value="model.Name" placeholder="e.g. Main Remittance" /><ValidationMessage For="@(() => model.Name)" /></div>
                            <div class="col-12"><label class="form-label">Code (optional)</label><InputText class="form-control finance-control" @bind-Value="model.Code" placeholder="e.g. MAIN" /><ValidationMessage For="@(() => model.Code)" /></div>
                            <div class="col-12"><label class="form-label">Description (optional)</label><InputTextArea class="form-control finance-control finance-textarea" @bind-Value="model.Description" placeholder="Purpose of this remittance element" /><ValidationMessage For="@(() => model.Description)" /></div>
                        </div>
                    </div>
                    @if (model.Id == 0)
                    {
                        <div class="finance-form-section"><label class="finance-status-switch"><InputCheckbox class="form-check-input" @bind-Value="model.IsActive" /><span><strong>Active Element</strong><small>Active elements can be selected when creating remittance rules.</small></span></label></div>
                    }
                    <div class="finance-form-actions">
                        <button type="submit" class="finance-primary-button" disabled="@isSaving"><i class="bi bi-check2-circle me-2"></i>@(isSaving ? "Saving..." : model.Id == 0 ? "Save Remittance Element" : "Update Remittance Element")</button>
                        <button type="button" class="finance-secondary-button" @onclick="ResetForm"><i class="bi bi-arrow-counterclockwise me-2"></i>Reset</button>
                    </div>
                </EditForm>
            </section>
            <section class="finance-panel finance-list-panel">
                <div class="finance-panel-header"><div><div class="finance-section-label">Remittance Register</div><h4>Configured Elements</h4><p>Review names, codes, descriptions and status.</p></div><span class="finance-count-badge">@Filtered.Count record(s)</span></div>
                <div class="finance-list-toolbar">
                    <div class="finance-search-box"><i class="bi bi-search"></i><input class="form-control" value="@searchText" @oninput="HandleSearch" placeholder="Search name, code or description" /></div>
                    <select class="form-select finance-status-filter" value="@statusFilter" @onchange="HandleStatusFilter"><option value="All">All statuses</option><option value="Active">Active only</option><option value="Inactive">Inactive only</option></select>
                    <button type="button" class="finance-refresh-button" title="Reload" @onclick="LoadData"><i class="bi bi-arrow-clockwise"></i></button>
                </div>
                @if (isLoading)
                {
                    <div class="finance-loading-state"><div class="spinner-border"></div><p>Loading remittance elements...</p></div>
                }
                else if (Filtered.Count == 0)
                {
                    <div class="finance-empty-state"><div class="finance-empty-icon"><i class="bi bi-collection"></i></div><h5>No remittance elements found</h5><p>Create an element or adjust your filters.</p></div>
                }
                else
                {
                    <div class="finance-table-wrapper">
                        <table class="table finance-table">
                            <thead><tr><th>Element</th><th>Code</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                            <tbody>
                                @foreach (var item in Filtered)
                                {
                                    <tr class="@(model.Id == item.Id ? "finance-editing-row" : "")">
                                        <td><div class="finance-category-cell"><div class="finance-category-avatar">@GetInitials(item.Name)</div><div><strong>@item.Name</strong><small>@(item.Description ?? "No description")</small></div></div></td>
                                        <td>@(item.Code ?? "—")</td>
                                        <td><span class="finance-status-badge @(item.IsActive ? "status-active" : "status-inactive")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                                        <td><div class="finance-action-group"><button type="button" class="finance-action-button action-edit" title="Edit" @onclick="() => Edit(item)"><i class="bi bi-pencil"></i></button><button type="button" class="finance-action-button @(item.IsActive ? "action-disable" : "action-enable")" title="@(item.IsActive ? "Deactivate" : "Activate")" @onclick="() => ToggleStatus(item)"><i class="bi @(item.IsActive ? "bi-pause" : "bi-play")"></i></button></div></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    </div>
}

@code {
    private List<RemittanceElement> elements = new();
    private RemittanceElement model = NewModel();
    private int formKey;
    private bool isLoading = true;
    private bool isSaving;
    private string successMessage = "";
    private string errorMessage = "";
    private string searchText = "";
    private string statusFilter = "All";

    private List<RemittanceElement> Filtered => elements.Where(x =>
        (statusFilter switch { "Active" => x.IsActive, "Inactive" => !x.IsActive, _ => true }) &&
        (string.IsNullOrWhiteSpace(searchText) ||
         x.Name.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
         (x.Code?.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) ||
         (x.Description?.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated && AuthService.CanAccessAdminPanel()) await LoadData();
        else isLoading = false;
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            elements = await RemittanceElementService.GetAllAsync();
        }
        catch (Exception ex) { errorMessage = $"Unable to load remittance elements: {ex.Message}"; }
        finally { isLoading = false; }
    }

    private async Task Save()
    {
        if (isSaving) return;
        try
        {
            isSaving = true;
            successMessage = "";
            errorMessage = "";
            var result = model.Id == 0
                ? await RemittanceElementService.CreateAsync(model, GetCurrentUserName())
                : await RemittanceElementService.UpdateAsync(model, GetCurrentUserName());
            if (!result.Success) { errorMessage = result.Message; return; }
            ResetForm();
            successMessage = result.Message;
            await LoadData();
        }
        catch (Exception ex) { errorMessage = $"Unable to save the remittance element: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private void Edit(RemittanceElement item)
    {
        successMessage = "";
        errorMessage = "";
        model = new RemittanceElement
        {
            Id = item.Id,
            Name = item.Name,
            Code = item.Code,
            Description = item.Description,
            IsActive = item.IsActive
        };
        formKey++;
    }

    private async Task ToggleStatus(RemittanceElement item)
    {
        try
        {
            successMessage = "";
            errorMessage = "";
            var result = await RemittanceElementService.ToggleStatusAsync(item.Id, GetCurrentUserName());
            if (!result.Success) { errorMessage = result.Message; return; }
            if (model.Id == item.Id) ResetForm();
            successMessage = result.Message;
            await LoadData();
        }
        catch (Exception ex) { errorMessage = $"Unable to change element status: {ex.Message}"; }
    }

    private void ResetForm() { model = NewModel(); formKey++; successMessage = ""; errorMessage = ""; }
    private static RemittanceElement NewModel() => new() { IsActive = true };
    private void HandleSearch(ChangeEventArgs e) => searchText = e.Value?.ToString() ?? "";
    private void HandleStatusFilter(ChangeEventArgs e) => statusFilter = e.Value?.ToString() ?? "All";
    private static string GetCurrentUserName() => "System User";
    private static string GetInitials(string? value) => string.IsNullOrWhiteSpace(value) ? "RE" : string.Concat(value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
}

