@page "/login"
@layout Components.Layout.LoginLayout
@using ChurchApp.Models
@using ChurchApp.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>BCC ServiceHub - Login</PageTitle>

<div class="login-page">
    <div class="login-overlay"></div>

    <div class="login-wrapper">
        <div class="login-info-panel">
            <div class="login-badge">
                <i class="fas fa-church me-2"></i>
                BCC Workers' Platform
            </div>

            <h1>BCC ServiceHub</h1>
            <p>
                Secure access to church workforce management, service records,
                attendance, offerings and ministry operations.
            </p>

            <div class="login-scripture">
                “Let all things be done decently and in order.”<br />
                <span>1 Corinthians 14:40</span>
            </div>
        </div>

        <div class="login-card">
            <div class="login-header">
                <div class="church-logo-container">
                    <img src="/images/bcc-logo.png" alt="BCC Logo" class="church-logo-img" />
                </div>

                <h2>Welcome Back</h2>
                <p>Sign in to continue to BCC ServiceHub</p>
            </div>

            <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="workerId">Worker ID</label>
                    <div class="input-wrap">
                        <i class="fas fa-id-card"></i>
                        <InputText id="workerId"
                                   @bind-Value="loginModel.WorkerId"
                                   class="form-control"
                                   placeholder="Enter your Worker ID" />
                    </div>
                    <ValidationMessage For="@(() => loginModel.WorkerId)" />
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <div class="input-wrap">
                        <i class="fas fa-lock"></i>
                        <InputText id="password"
                                   type="password"
                                   @bind-Value="loginModel.Password"
                                   class="form-control"
                                   placeholder="Enter your password" />
                    </div>
                    <ValidationMessage For="@(() => loginModel.Password)" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">
                        @errorMessage
                    </div>
                }

                <button type="submit" class="btn-login" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="loading-spinner"></span>
                        <span>Logging in...</span>
                    }
                    else
                    {
                        <span>Login</span>
                        <i class="fas fa-arrow-right ms-2"></i>
                    }
                </button>
            </EditForm>

            <div class="login-links">
                <a href="/forgot-password" class="forgot-password">Forgot Password?</a>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var isValid = await AuthService.LoginAsync(loginModel.WorkerId, loginModel.Password);

            if (isValid)
            {
                var worker = AuthService.CurrentWorker;

                if (worker != null && worker.IsFirstLogin)
                {
                    // Redirect to change password page
                    Navigation.NavigateTo($"/change-password/{worker.Id}");
                }
                else
                {
                    // Redirect to dashboard
                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                var isDeactivated = await AuthService.IsWorkerDeactivatedAsync(loginModel.WorkerId);

                if (isDeactivated)
                {
                    errorMessage = "Your account has been deactivated. Please contact administrator.";
                }
                else
                {
                    errorMessage = "Invalid Worker ID or Password";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred during login: {ex.Message}";
            Console.WriteLine($"Login error: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }

        isLoading = false;
        StateHasChanged();
    }
}

<style>
    .login-page {
        min-height: 100vh;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: linear-gradient(rgba(8, 21, 45, 0.78), rgba(8, 21, 45, 0.84)), url('/images/church-hero.jpg') center center / cover no-repeat;
        overflow: hidden;
    }

    .login-overlay {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top right, rgba(212, 175, 55, 0.25), transparent 35%), radial-gradient(circle at bottom left, rgba(13, 110, 253, 0.25), transparent 35%);
    }

    .login-wrapper {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1080px;
        display: grid;
        grid-template-columns: 1.2fr 430px;
        gap: 32px;
        align-items: center;
    }

    .login-info-panel {
        color: #ffffff;
        padding: 20px;
    }

    .login-badge {
        display: inline-flex;
        align-items: center;
        padding: 8px 16px;
        border-radius: 999px;
        background: rgba(255,255,255,0.14);
        border: 1px solid rgba(255,255,255,0.18);
        font-weight: 800;
        margin-bottom: 22px;
        backdrop-filter: blur(8px);
    }

    .login-info-panel h1 {
        font-size: clamp(2.8rem, 6vw, 4.8rem);
        font-weight: 900;
        line-height: 1.05;
        margin-bottom: 20px;
    }

    .login-info-panel p {
        max-width: 640px;
        color: #e5e7eb;
        font-size: 1.15rem;
        line-height: 1.8;
        margin-bottom: 28px;
    }

    .login-scripture {
        border-left: 4px solid #d4af37;
        padding-left: 18px;
        color: #ffffff;
        font-size: 1rem;
        font-weight: 700;
    }

        .login-scripture span {
            color: #d4af37;
            font-weight: 900;
        }

    .login-card {
        background: rgba(255,255,255,0.96);
        border: 1px solid rgba(255,255,255,0.35);
        border-radius: 28px;
        padding: 34px;
        box-shadow: 0 30px 80px rgba(0,0,0,0.28);
        backdrop-filter: blur(14px);
        width: 100%;
    }

    .login-header {
        text-align: center;
        margin-bottom: 28px;
    }

    .church-logo-container {
        width: 96px;
        height: 70px;
        margin: 0 auto 16px;
        border-radius: 18px;
        background: #111827;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 24px rgba(17, 24, 39, 0.18);
    }

    .church-logo-img {
        width: 78px;
        height: 52px;
        object-fit: contain;
    }

    .login-header h2 {
        color: #111827;
        margin: 0 0 6px;
        font-size: 1.7rem;
        font-weight: 900;
    }

    .login-header p {
        color: #6b7280;
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .form-group {
        margin-bottom: 1.25rem;
    }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 800;
            color: #374151;
            font-size: 0.9rem;
        }

    .input-wrap {
        position: relative;
    }

        .input-wrap i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6b7280;
            font-size: 0.95rem;
        }

    .form-control {
        width: 100%;
        padding: 0.85rem 0.85rem 0.85rem 2.8rem;
        border: 1px solid #d1d5db;
        border-radius: 14px;
        font-size: 1rem;
        background: #ffffff;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .form-control:focus {
            outline: none;
            border-color: #0d6efd;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.12);
        }

    .btn-login {
        width: 100%;
        background: linear-gradient(135deg, #0d6efd, #1f2937);
        color: white;
        border: none;
        padding: 0.9rem;
        border-radius: 15px;
        font-size: 1rem;
        font-weight: 900;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(13, 110, 253, 0.25);
        }

        .btn-login:disabled {
            background: #9ca3af;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    .login-links {
        text-align: center;
        margin-top: 1.4rem;
        padding-top: 1.4rem;
        border-top: 1px solid #e5e7eb;
    }

    .forgot-password {
        color: #0d6efd;
        text-decoration: none;
        font-size: 0.92rem;
        font-weight: 800;
    }

        .forgot-password:hover {
            text-decoration: underline;
        }

    .alert {
        padding: 0.8rem;
        border-radius: 14px;
        margin-bottom: 1rem;
        font-size: 0.9rem;
        font-weight: 700;
    }

    .alert-danger {
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
    }

    .loading-spinner {
        display: inline-block;
        width: 16px;
        height: 16px;
        border: 2px solid #ffffff;
        border-radius: 50%;
        border-top-color: transparent;
        animation: spin 1s ease-in-out infinite;
        margin-right: 0.5rem;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 900px) {
        .login-wrapper {
            grid-template-columns: 1fr;
            max-width: 460px;
        }

        .login-info-panel {
            text-align: center;
            padding: 0;
        }

            .login-info-panel p,
            .login-scripture {
                display: none;
            }

        .login-card {
            padding: 28px;
        }
    }

    @@media (max-width: 480px) {
        .login-page {
            padding: 1rem;
        }

        .login-card {
            border-radius: 22px;
            padding: 24px;
        }

        .login-info-panel h1 {
            font-size: 2.3rem;
        }
    }
</style>