@page "/login"
@layout Components.Layout.LoginLayout
@using ChurchApp.Models
@using ChurchApp.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>BCC ServiceHub - Login</PageTitle>

<div class="login-page">
    <div class="login-overlay"></div>

    <div class="login-wrapper">
        <div class="login-info-panel">
            <div class="login-badge">
                <i class="fas fa-church me-2"></i>
                BCC Workers' Platform
            </div>

            <h1>BCC ServiceHub</h1>
            <p>
                Secure access to church workforce management, service records,
                attendance, offerings and ministry operations.
            </p>

            <div class="login-scripture">
                “Let all things be done decently and in order.”<br />
                <span>1 Corinthians 14:40</span>
            </div>
        </div>

        <div class="login-card">
            <div class="login-header">
                <div class="church-logo-container">
                    <img src="/images/bcc-logo.png" alt="BCC Logo" class="church-logo-img" />
                </div>

                <h2>Welcome Back</h2>
                <p>Sign in to continue to BCC ServiceHub</p>
            </div>

            <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin" FormName="WorkerLogin">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="workerId">Worker ID</label>
                    <div class="input-wrap">
                        <i class="fas fa-id-card"></i>
                        <InputText id="workerId"
                                   @bind-Value="loginModel.WorkerId"
                                   class="form-control"
                                   placeholder="Enter your Worker ID" />
                    </div>
                    <ValidationMessage For="@(() => loginModel.WorkerId)" />
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <div class="input-wrap">
                        <i class="fas fa-lock"></i>
                        <InputText id="password"
                                   type="@(showPassword ? "text" : "password")"
                                   @bind-Value="loginModel.Password"
                                   class="form-control password-with-toggle"
                                   autocomplete="current-password"
                                   placeholder="Enter your password" />
                        <button type="button" class="password-toggle"
                                @onclick="() => showPassword = !showPassword"
                                aria-label="@(showPassword ? "Hide password" : "Show password")"
                                aria-pressed="@showPassword" title="@(showPassword ? "Hide password" : "Show password")">
                            <i class="@(showPassword ? "fas fa-eye-slash" : "fas fa-eye")" aria-hidden="true"></i>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => loginModel.Password)" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">
                        @errorMessage
                    </div>
                }

                <button type="submit" class="btn-login" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="loading-spinner"></span>
                        <span>Logging in...</span>
                    }
                    else
                    {
                        <span>Login</span>
                        <i class="fas fa-arrow-right ms-2"></i>
                    }
                </button>
            </EditForm>

            <div class="login-links">
                <a href="/forgot-password" class="forgot-password">Forgot Password?</a>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool showPassword = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var isValid = await AuthService.LoginAsync(loginModel.WorkerId, loginModel.Password);

            if (isValid)
            {
                var worker = AuthService.CurrentWorker;

                if (worker != null && worker.IsFirstLogin)
                {
                    // Redirect to change password page
                    Navigation.NavigateTo($"/change-password/{worker.Id}");
                }
                else
                {
                    // Redirect to dashboard
                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                var isDeactivated = await AuthService.IsWorkerDeactivatedAsync(loginModel.WorkerId);

                if (isDeactivated)
                {
                    errorMessage = "Your account has been deactivated. Please contact administrator.";
                }
                else
                {
                    errorMessage = "Invalid Worker ID or Password";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred during login: {ex.Message}";
            Console.WriteLine($"Login error: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }

        isLoading = false;
        StateHasChanged();
    }
}

<style>
    /* BCC green identity — scoped to the login page */
    .login-page {
        --bcc-green: #145c39;
        --bcc-deep: #0b3f29;
        --bcc-bright: #238452;
        min-height: 100vh;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 36px 22px;
        background-color: #e9f1eb;
        /* A light tint keeps the original church photograph clearly visible. */
        background-image: linear-gradient(90deg, rgba(6, 43, 27, .76) 0%, rgba(8, 58, 35, .54) 44%, rgba(7, 51, 31, .20) 100%), url('/images/church-hero.jpg');
        background-position: center center;
        background-size: cover;
        background-repeat: no-repeat;
        overflow: hidden;
        isolation: isolate;
    }

    .login-overlay {
        position: absolute;
        inset: 0;
        z-index: 0;
        background: linear-gradient(0deg, rgba(4, 39, 23, .15), transparent 40%);
        pointer-events: none;
    }

    .login-wrapper {
        position: relative;
        z-index: 1;
        width: min(100%, 960px);
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(290px, 340px);
        gap: clamp(20px, 4vw, 52px);
        align-items: center;
    }

    .login-info-panel {
        color: #fff;
        padding: 24px 4px;
        text-shadow: 0 2px 14px rgba(0,0,0,.22);
    }

    .login-badge {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 5px;
        background: rgba(9, 66, 40, .72);
        border: 1px solid rgba(255,255,255,.36);
        font-weight: 750;
        font-size: .84rem;
        letter-spacing: .025em;
        margin-bottom: 24px;
    }

    .login-info-panel h1 {
        font-size: clamp(2.5rem, 5.5vw, 4.25rem);
        font-weight: 850;
        line-height: 1.06;
        letter-spacing: -.045em;
        margin: 0 0 18px;
    }

    .login-info-panel p {
        max-width: 530px;
        color: #f3fff6;
        font-size: 1.04rem;
        line-height: 1.7;
        margin-bottom: 26px;
    }

    .login-scripture {
        border-left: 4px solid #a9dfb9;
        padding-left: 16px;
        color: #fff;
        font-size: .96rem;
        font-weight: 600;
        line-height: 1.65;
    }

        .login-scripture span {
            color: #c5f1d0;
            font-weight: 800;
        }

    .login-card {
        width: 100%;
        background: #fff;
        border: 1px solid rgba(255,255,255,.9);
        border-radius: 9px;
        padding: 20px 24px 18px;
        box-shadow: 0 22px 70px rgba(3, 36, 21, .26);
    }

    .login-header {
        text-align: center;
        margin-bottom: 15px;
    }

    .church-logo-container {
        width: 100px;
        height: 78px;
        margin: 0 auto 9px;
        border-radius: 5px;
        background: #21172f;
        border: 1px solid #45345c;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 5px 16px rgba(12,70,40,.07);
        padding: 5px;
    }

    .church-logo-img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
        image-rendering: auto;
    }

    .login-header h2 {
        color: #103e2a;
        margin: 0 0 6px;
        font-size: 1.42rem;
        font-weight: 800;
    }

    .login-header p {
        color: #64746a;
        margin: 0;
        font-size: .84rem;
        font-weight: 500;
    }

    .form-group {
        margin-bottom: 11px;
    }

        .form-group label {
            display: block;
            margin-bottom: 4px;
            font-weight: 750;
            color: #214a35;
            font-size: .88rem;
        }

    .input-wrap {
        position: relative;
    }

        .input-wrap > i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #668777;
            font-size: .94rem;
            pointer-events: none;
        }

    .login-card .form-control {
        width: 100%;
        min-height: 40px;
        padding: .48rem .8rem .48rem 2.65rem;
        border: 1px solid #cbdcd1;
        border-radius: 6px;
        font-size: .96rem;
        background: #fff;
        color: #1d392a;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .login-card .form-control:focus {
            outline: none;
            border-color: #238452;
            box-shadow: 0 0 0 3px rgba(35,132,82,.14);
        }

    .login-card .password-with-toggle {
        padding-right: 3.1rem;
    }

    .input-wrap .password-toggle {
        position: absolute;
        right: 7px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #416c55;
        padding: 10px;
        cursor: pointer;
        z-index: 1;
    }

        .input-wrap .password-toggle i {
            position: static;
            transform: none;
            color: inherit;
        }

    .password-toggle:focus-visible {
        outline: 2px solid #238452;
        border-radius: 5px;
    }

    .btn-login {
        width: 100%;
        background: #145c39;
        color: #fff;
        border: 1px solid #145c39;
        padding: .58rem;
        border-radius: 6px;
        font-size: .98rem;
        font-weight: 800;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .2s ease, box-shadow .2s ease;
    }

        .btn-login:hover {
            background: #0b452a;
            box-shadow: 0 8px 22px rgba(20,92,57,.2);
        }

        .btn-login:disabled {
            background: #90a79a;
            border-color: #90a79a;
            cursor: not-allowed;
            box-shadow: none;
        }

    .login-links {
        text-align: center;
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px solid #e4ede6;
    }

    .forgot-password {
        color: #145c39;
        text-decoration: none;
        font-size: .9rem;
        font-weight: 750;
    }

        .forgot-password:hover {
            text-decoration: underline;
        }

    .login-card .alert {
        padding: .75rem;
        border-radius: 6px;
        margin-bottom: 1rem;
        font-size: .88rem;
        font-weight: 650;
    }

    .login-card .alert-danger {
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
    }

    .loading-spinner {
        display: inline-block;
        width: 16px;
        height: 16px;
        border: 2px solid #fff;
        border-radius: 50%;
        border-top-color: transparent;
        animation: spin 1s ease-in-out infinite;
        margin-right: .5rem;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 800px) {
        .login-page {
            padding: 26px 18px;
            background-image: linear-gradient(rgba(6,43,27,.48),rgba(6,43,27,.58)), url('/images/church-hero.jpg');
        }

        .login-wrapper {
            grid-template-columns: 1fr;
            max-width: 350px;
            gap: 12px;
        }

        .login-info-panel {
            text-align: center;
            padding: 0;
        }

            .login-info-panel h1 {
                font-size: 2.45rem;
                margin-bottom: 0;
            }

            .login-info-panel p, .login-scripture {
                display: none;
            }

        .login-badge {
            margin-bottom: 10px;
        }

        .login-card {
            padding: 18px 20px 16px;
        }
    }

    @@media (max-width: 420px) {
        .login-page {
            padding: 18px 12px;
        }

        .login-card {
            padding: 17px 17px;
        }

        .login-info-panel h1 {
            font-size: 2.1rem;
        }

        .church-logo-container {
            width: 92px;
            height: 72px;
        }
    }
</style>
