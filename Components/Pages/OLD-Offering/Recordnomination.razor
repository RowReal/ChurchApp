@page "/Offering/record-nomination"
@layout Components.Layout.MainLayout
@using ChurchApp.Models
@using ChurchApp.Services
@using ChurchApp.Components.Shared
@inject RecordNominationService RecordNominationService
@inject WorkerService WorkerService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Record Keeper Nomination</PageTitle>

@if (AuthService.IsAuthenticated)
{
    <div class="profile-form-v2-page">

        <div class="bcc-page-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-user-check me-2"></i>
                    Service Records
                </div>
                <div class="bcc-page-title">Record Keeper Nomination</div>
                <div class="bcc-page-subtitle">
                    Nominate workers to manage attendance, offering, guest, and service note records.
                </div>
            </div>

            <a href="/Offering/list" class="bcc-btn profile-form-secondary-btn">
                <i class="fas fa-list me-2"></i>
                View Nominations
            </a>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i>@errorMessage
                <button type="button" class="btn-close float-end" @onclick="ClearErrorMessage"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle me-2"></i>@successMessage
                <button type="button" class="btn-close float-end" @onclick="ClearSuccessMessage"></button>
            </div>
        }

        @if (!canNominate)
        {
            <div class="bcc-empty">
                <i class="fas fa-lock"></i>
                <h4>Access Restricted</h4>
                <p>Only authorised FIG Directorate leaders can nominate record keepers.</p>
            </div>
        }
        else
        {
            <EditForm Model="@model" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="bcc-card">
                    <div class="bcc-card-header">
                        <div class="profile-v2-card-icon">
                            <i class="fas fa-clipboard-list"></i>
                        </div>
                        <div class="bcc-card-title">Nomination Details</div>
                    </div>

                    <div class="bcc-card-body">
                        <div class="row g-3">

                            <BccFormField Label="Service" CurrentValue="@GetServiceName(model.ServiceId)">
                                @if (isLoadingServices)
                                {
                                    <div class="form-control bcc-input">Loading services...</div>
                                }
                                else
                                {
                                    <InputSelect @bind-Value="model.ServiceId" class="form-select bcc-input" disabled="@isSubmitting">
                                        <option value="0">Select a service</option>
                                        @foreach (var service in services)
                                        {
                                            <option value="@service.Id">@service.Name</option>
                                        }
                                    </InputSelect>
                                }
                                <ValidationMessage For="@(() => model.ServiceId)" />
                            </BccFormField>

                            <BccFormField Label="Service Date" CurrentValue="@model.ServiceDate.ToString("dd MMM yyyy")">
                                <InputDate @bind-Value="model.ServiceDate" class="form-control bcc-input" disabled="@isSubmitting" />
                                <ValidationMessage For="@(() => model.ServiceDate)" />
                            </BccFormField>

                            <BccFormField Label="Record Type" CurrentValue="@GetRecordTypeDisplay(model.RecordType)">
                                <InputSelect @bind-Value="model.RecordType"
                                             @bind-Value:after="OnRecordTypeChanged"
                                             class="form-select bcc-input"
                                             disabled="@isSubmitting">
                                    <option value="">Select record type</option>
                                    @foreach (var type in recordTypes)
                                    {
                                        <option value="@type">@GetRecordTypeDisplay(type)</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => model.RecordType)" />
                            </BccFormField>

                            <BccFormField Label="Nominee / Record Keeper" CurrentValue="@GetNomineeName(model.NomineeWorkerId)">
                                @if (isLoadingMembers)
                                {
                                    <div class="form-control bcc-input">Loading members...</div>
                                }
                                else if (!GetEligibleNominees().Any())
                                {
                                    <div class="alert alert-warning mb-0">
                                        No eligible nominee found for this record type.
                                    </div>
                                }
                                else
                                {
                                    <InputSelect @bind-Value="model.NomineeWorkerId" class="form-select bcc-input" disabled="@isSubmitting">
                                        <option value="">Select nominee</option>
                                        @foreach (var member in GetEligibleNominees())
                                        {
                                            <option value="@member.WorkerId">
                                                @member.LastName, @member.FirstName (@member.WorkerId)
                                            </option>
                                        }
                                    </InputSelect>
                                }
                                <ValidationMessage For="@(() => model.NomineeWorkerId)" />
                            </BccFormField>

                        </div>

                        @if (model.RecordType == "Guest Record")
                        {
                            <div class="worker360-note mt-4">
                                <i class="fas fa-info-circle"></i>
                                Guest Record nominees are limited to workers whose primary or secondary directorate is FIG.
                            </div>
                        }

                        <div class="profile-form-v2-actions mt-4">
                            <button type="button" class="bcc-btn profile-form-secondary-btn" @onclick="ResetForm" disabled="@isSubmitting">
                                <i class="fas fa-redo me-2"></i>
                                Reset
                            </button>

                            <button type="submit" class="bcc-btn bcc-btn-primary" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Processing...</span>
                                }
                                else
                                {
                                    <i class="fas fa-user-check me-2"></i>
                                    <span>Nominate Record Keeper</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </EditForm>
        }
    </div>
}
else
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Login</h4>
        <a href="/login" class="bcc-btn bcc-btn-primary">Go to Login</a>
    </div>
}

@code {
    private RecordNominationModel model = new();
    private List<Service> services = new();
    private List<Worker> figMembers = new();
    private List<Worker> allWorkers = new();
    private List<string> recordTypes = new();

    private bool canNominate = false;
    private bool isLoadingServices = true;
    private bool isLoadingMembers = true;
    private bool isSubmitting = false;

    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private System.Timers.Timer? debugTimer;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.CurrentWorker == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            canNominate = await RecordNominationService.CanNominateRecords(AuthService.CurrentWorker.WorkerId);

            if (canNominate)
            {
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Initialization error: {ex.Message}";
        }
    }

    private async Task LoadData()
    {
        try
        {
            isLoadingServices = true;
            isLoadingMembers = true;

            services = await RecordNominationService.GetServicesForNomination();
            figMembers = await RecordNominationService.GetFIGMembers();
            allWorkers = await WorkerService.GetAllWorkersAsync();
            recordTypes = await RecordNominationService.GetRecordTypes();

            model.ServiceDate = DateTime.Today;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            isLoadingServices = false;
            isLoadingMembers = false;
            StateHasChanged();
        }
    }

    private void OnRecordTypeChanged()
    {
        model.NomineeWorkerId = "";
    }

    private List<Worker> GetEligibleNominees()
    {
        if (model.RecordType == "Guest Record")
        {
            return allWorkers
                .Where(w => w.IsActive && IsFIGWorker(w))
                .OrderBy(w => w.LastName)
                .ThenBy(w => w.FirstName)
                .ToList();
        }

        return figMembers
            .Where(w => w.IsActive)
            .OrderBy(w => w.LastName)
            .ThenBy(w => w.FirstName)
            .ToList();
    }

    private bool IsFIGWorker(Worker worker)
    {
        var primaryDirectorate = worker.Directorate?.Name?.ToLowerInvariant() ?? "";
        var secondaryDirectorate = worker.SecondaryDirectorate?.Name?.ToLowerInvariant() ?? "";

        return primaryDirectorate.Contains("fig") ||
               secondaryDirectorate.Contains("fig");
    }

    private string GetRecordTypeDisplay(string recordType)
    {
        return recordType switch
        {
            "ChurchAttendance" => "Church Attendance",
            "Offering" => "Offering Recording",
            "Guest Record" => "Guest Record",
            "ServicesNote" => "Services Note",
            _ => recordType
        };
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            if (model.ServiceId <= 0)
            {
                errorMessage = "Please select a service.";
                return;
            }

            if (string.IsNullOrEmpty(model.RecordType))
            {
                errorMessage = "Please select a record type.";
                return;
            }

            if (string.IsNullOrEmpty(model.NomineeWorkerId))
            {
                errorMessage = "Please select a nominee.";
                return;
            }

            if (!ValidateServiceDay())
            {
                return;
            }

            var nomination = await RecordNominationService.CreateNomination(
                model,
                AuthService.CurrentWorker!.WorkerId
            );

            if (nomination != null)
            {
                successMessage = $"Successfully nominated {GetNomineeName(model.NomineeWorkerId)} as {GetRecordTypeDisplay(model.RecordType)} record keeper.";
                await ShowSuccess(successMessage);

                ResetForm();

                await Task.Delay(2500);
                Navigation.NavigateTo("/Offering/list");
            }
            else
            {
                errorMessage = "Nomination failed. This nomination may already exist for this service, date, and record type.";
                await ShowError(errorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
            await ShowError(errorMessage);
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private bool ValidateServiceDay()
    {
        if (model.ServiceId <= 0)
            return true;

        var selectedService = services.FirstOrDefault(s => s.Id == model.ServiceId);

        if (selectedService == null || string.IsNullOrEmpty(selectedService.Name))
            return true;

        var serviceName = selectedService.Name.ToLowerInvariant();
        var selectedDate = model.ServiceDate;
        var dayOfWeek = selectedDate.DayOfWeek;

        if ((serviceName.Contains("mid week") || serviceName.Contains("mid-week")) &&
            dayOfWeek != DayOfWeek.Wednesday)
        {
            errorMessage = $"'{selectedService.Name}' services are typically held on Wednesdays. You selected {selectedDate:dddd}.";
            return false;
        }

        if (serviceName.Contains("sunday") && dayOfWeek != DayOfWeek.Sunday)
        {
            errorMessage = $"'{selectedService.Name}' services are held on Sundays. You selected {selectedDate:dddd}.";
            return false;
        }

        return true;
    }

    private string GetNomineeName(string workerId)
    {
        if (string.IsNullOrWhiteSpace(workerId))
            return "Not selected";

        var member = GetEligibleNominees().FirstOrDefault(m => m.WorkerId == workerId);

        return member != null
            ? $"{member.FirstName} {member.LastName}"
            : workerId;
    }

    private string GetServiceName(int serviceId)
    {
        var service = services.FirstOrDefault(s => s.Id == serviceId);
        return service?.Name ?? "Not selected";
    }

    private void ResetForm()
    {
        model = new RecordNominationModel
        {
            ServiceDate = DateTime.Today
        };
    }

    private async Task ShowSuccess(string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", "success", "Success", message);
        }
        catch
        {
            Console.WriteLine($"Success: {message}");
        }
    }

    private async Task ShowError(string message)
    {
        try
        {
            await JS.InvokeVoidAsync("showToast", "error", "Error", message);
        }
        catch
        {
            Console.WriteLine($"Error: {message}");
        }
    }

    private void ClearErrorMessage()
    {
        errorMessage = string.Empty;
    }

    private void ClearSuccessMessage()
    {
        successMessage = string.Empty;
    }

    public void Dispose()
    {
        debugTimer?.Stop();
        debugTimer?.Dispose();
    }
}