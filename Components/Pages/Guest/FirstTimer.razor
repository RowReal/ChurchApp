@page "/guest/first-timer"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services

@inject GuestService GuestService
@inject ServiceService ServiceService
@inject ServiceRecordAccessService ServiceRecordAccessService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>First Timer Registration - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to register first timers.</p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else if (isLoading)
{
    <div class="worker360-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-4">
                <div class="spinner-border text-primary"></div>
                <div class="mt-2 text-muted">
                    Loading first timer register...
                </div>
            </div>
        </div>
    </div>
}
else if (!canAccessGuestManagement)
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>

        <p>
            You must have the Guest Management privilege and either belong
            to the FIG Directorate, have FIG as your secondary department,
            or hold an authorised leadership role.
        </p>

        <button type="button"
                class="bcc-btn bcc-btn-primary"
                @onclick="GoBack">
            Return to Guest Management
        </button>
    </div>
}
else
{
    <div class="worker360-page first-timer-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        <div class="bcc-page-header first-timer-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-user-plus me-2"></i>
                    Guest Management
                </div>

                <div class="bcc-page-title">
                    First Timer Registration
                </div>

                <div class="bcc-page-subtitle">
                    Register a first-time guest and review today’s entries.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        @onclick="ResetForm">
                    <i class="fas fa-redo me-2"></i>
                    Reset
                </button>

                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        @onclick="GoBack">
                    <i class="fas fa-arrow-left me-2"></i>
                    Back
                </button>
            </div>
        </div>

        <div class="row g-3">

            <div class="col-12 col-xl-5">
                <div class="bcc-card">
                    <div class="bcc-card-body p-3">

                        <div class="compact-section-heading">
                            <div>
                                <h6>
                                    <i class="fas fa-id-card me-2"></i>
                                    Guest Information
                                </h6>

                                <p>
                                    Fields marked * are required.
                                </p>
                            </div>
                        </div>

                        <div class="row g-2">

                            <div class="col-12">
                                <label class="form-label compact-label">
                                    Service
                                    <span class="text-danger">*</span>
                                </label>

                                <InputSelect class="form-select form-select-sm"
                                             @bind-Value="model.ServiceId">
                                    <option value="0">Select Service</option>

                                    @foreach (var service in services)
                                    {
                                        <option value="@service.Id">
                                            @service.Name
                                        </option>
                                    }
                                </InputSelect>

                                <div class="text-danger small">
                                    @GetValidationMessage(nameof(model.ServiceId))
                                </div>
                            </div>

                            <div class="col-4">
                                <label class="form-label compact-label">
                                    Title
                                    <span class="text-danger">*</span>
                                </label>

                                <InputSelect class="form-select form-select-sm"
                                             @bind-Value="model.Title">
                                    <option value="">Select</option>
                                    <option value="Mr">Mr</option>
                                    <option value="Mrs">Mrs</option>
                                    <option value="Miss">Miss</option>
                                    <option value="Dr">Dr</option>
                                    <option value="Pastor">Pastor</option>
                                    <option value="Rev">Rev</option>
                                    <option value="Prof">Prof</option>
                                    <option value="Engr">Engr</option>
                                </InputSelect>

                                <div class="text-danger small">
                                    @GetValidationMessage(nameof(model.Title))
                                </div>
                            </div>

                            <div class="col-8">
                                <label class="form-label compact-label">
                                    First Name
                                    <span class="text-danger">*</span>
                                </label>

                                <InputText class="form-control form-control-sm"
                                           @bind-Value="model.FirstName" />

                                <div class="text-danger small">
                                    @GetValidationMessage(nameof(model.FirstName))
                                </div>
                            </div>

                            <div class="col-6">
                                <label class="form-label compact-label">
                                    Middle Name
                                </label>

                                <InputText class="form-control form-control-sm"
                                           @bind-Value="model.MiddleName" />
                            </div>

                            <div class="col-6">
                                <label class="form-label compact-label">
                                    Surname
                                    <span class="text-danger">*</span>
                                </label>

                                <InputText class="form-control form-control-sm"
                                           @bind-Value="model.Surname" />

                                <div class="text-danger small">
                                    @GetValidationMessage(nameof(model.Surname))
                                </div>
                            </div>

                            <div class="col-6">
                                <label class="form-label compact-label">
                                    Sex
                                    <span class="text-danger">*</span>
                                </label>

                                <InputSelect class="form-select form-select-sm"
                                             @bind-Value="model.Sex">
                                    <option value="">Select</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </InputSelect>

                                <div class="text-danger small">
                                    @GetValidationMessage(nameof(model.Sex))
                                </div>
                            </div>

                            <div class="col-6">
                                <label class="form-label compact-label">
                                    Age Group
                                </label>
                                <InputSelect class="form-select form-select-sm"
                                             @bind-Value="model.AgeGroup">
                                    <option value="">Select</option>
                                    <option value="Child">Child</option>
                                    <option value="Teenager">Teenager</option>
                                    <option value="Young Adult">Young Adult</option>
                                    <option value="Adult">Adult</option>
                                    <option value="Senior">Senior</option>
                                </InputSelect>

                                <div class="text-danger small">
                                    @GetValidationMessage(nameof(model.AgeGroup))
                                </div>
                            </div>

                            <div class="col-6">
                                <label class="form-label compact-label">
                                    Phone Number
                                </label>

                                <InputText class="form-control form-control-sm"
                                           @bind-Value="model.PhoneNumber" />

                                @if (!string.IsNullOrWhiteSpace(phoneValidationMessage))
                                {
                                    <div class="text-danger small">
                                        @phoneValidationMessage
                                    </div>
                                }
                            </div>

                            <div class="col-6">
                                <label class="form-label compact-label">
                                    WhatsApp Number
                                </label>

                                <InputText class="form-control form-control-sm"
                                           @bind-Value="model.WhatsAppNumber" />
                            </div>

                            <div class="col-12">
                                <label class="form-label compact-label">
                                    Email
                                </label>

                                <InputText class="form-control form-control-sm"
                                           @bind-Value="model.Email" />

                                @if (!string.IsNullOrWhiteSpace(emailValidationMessage))
                                {
                                    <div class="text-danger small">
                                        @emailValidationMessage
                                    </div>
                                }
                            </div>

                            <div class="col-12">
                                <label class="form-label compact-label">
                                    Address
                                </label>

                                <InputText class="form-control form-control-sm"
                                           @bind-Value="model.Address" />
                            </div>

                            <div class="col-12">
                                <label class="form-label compact-label">
                                    Landmark
                                </label>

                                <InputText class="form-control form-control-sm"
                                           @bind-Value="model.Landmark" />
                            </div>

                            <div class="col-6">
                                <label class="form-label compact-label">
                                    Visiting Date
                                </label>

                                <InputDate class="form-control form-control-sm"
                                           @bind-Value="model.VisitingDate" />
                            </div>

                            <div class="col-6">
                                <label class="form-label compact-label">
                                    How Did You Find Us?
                                </label>

                                <select class="form-select form-select-sm"
                                        value="@model.HowFoundUs"
                                        @onchange="OnHowFoundUsChanged">
                                    <option value="">Select</option>
                                    <option value="invite">Invited</option>
                                    <option value="social-media">Social Media</option>
                                    <option value="signboard">Signboard</option>
                                    <option value="nearby">Lives Nearby</option>
                                    <option value="event">Church Event</option>
                                    <option value="other">Other</option>
                                </select>

                                <div class="text-danger small">
                                    @GetValidationMessage(nameof(model.HowFoundUs))
                                </div>
                            </div>

                            @if (model.HowFoundUs == "invite")
                            {
                                <div class="col-12">
                                    <label class="form-label compact-label">
                                        Invited By
                                    </label>

                                    <InputText class="form-control form-control-sm"
                                               @bind-Value="model.InvitedByName" />
                                </div>
                            }

                            <div class="col-6">
                                <div class="form-check compact-check">
                                    <InputCheckbox class="form-check-input"
                                                   @bind-Value="model.IsRCCGMember" />

                                    <label class="form-check-label">
                                        RCCG Member
                                    </label>
                                </div>
                            </div>

                            @if (model.IsRCCGMember)
                            {
                                <div class="col-6">
                                    <label class="form-label compact-label">
                                        Other Church/Parish
                                    </label>

                                    <InputText class="form-control form-control-sm"
                                               @bind-Value="model.OtherChurch" />
                                </div>
                            }

                        </div>

                        @if (validationErrors.Any())
                        {
                            <div class="alert alert-warning py-2 mt-3 mb-2">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                Please complete the required fields highlighted above.
                            </div>
                        }

                        <div class="mt-3 d-flex justify-content-end gap-2">
                            <button type="button"
                                    class="bcc-btn profile-form-secondary-btn compact-btn"
                                    disabled="@isSubmitting"
                                    @onclick="ResetForm">
                                Clear
                            </button>

                            <button type="button"
                                    class="bcc-btn bcc-btn-primary compact-btn"
                                    disabled="@isSubmitting"
                                    @onclick="SubmitForm">

                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <i class="fas fa-save me-2"></i>
                                    <span>Register Guest</span>
                                }

                            </button>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-7">
                <div class="bcc-card">
                    <div class="bcc-card-body p-3">

                        <div class="guest-register-heading">
                            <div>
                                <h6>Today’s First Timers</h6>
                                <p>@filteredFirstTimers.Count record(s)</p>
                            </div>

                            <div class="guest-search">
                                <i class="fas fa-search"></i>

                                <input class="form-control form-control-sm"
                                       value="@searchTerm"
                                       @oninput="OnSearch"
                                       placeholder="Search name, phone, guest number or service" />
                            </div>
                        </div>

                        @if (!filteredFirstTimers.Any())
                        {
                            <div class="bcc-empty py-4">
                                <i class="fas fa-user-friends"></i>
                                <h4>No First Timers Today</h4>
                                <p>No guest records have been added today.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0 guest-register-table">
                                    <thead>
                                        <tr>
                                            <th>Guest</th>
                                            <th>Guest No.</th>
                                            <th>Phone</th>
                                            <th>Service</th>
                                            <th>How Found Us</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var guest in filteredFirstTimers)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="guest-name-cell">
                                                        <div class="guest-avatar">
                                                            @GetGuestInitials(guest)
                                                        </div>

                                                        <div>
                                                            <strong>
                                                                @guest.Title @guest.FirstName @guest.Surname
                                                            </strong>

                                                            <span>
                                                                @guest.Sex · @guest.AgeGroup
                                                            </span>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td>@guest.GuestNumber</td>

                                                <td>
                                                    @(string.IsNullOrWhiteSpace(guest.PhoneNumber)
                                                                                            ? "—"
                                                                                            : guest.PhoneNumber)
                                                                                                            </td>

                                                <td>
                                                    @(guest.Service?.Name ?? "Not available")
                                                </td>

                                                <td>
                                                    @(string.IsNullOrWhiteSpace(guest.HowFoundUs)
                                                                                            ? "—"
                                                                                            : guest.HowFoundUs)
                                    </td>

                                                <td class="text-end">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary me-1"
                                                            title="View"
                                                            @onclick="() => ViewGuestDetails(guest.Id)">
                                                        <i class="fas fa-eye"></i>
                                                    </button>

                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-warning me-1"
                                                            title="Edit"
                                                            @onclick="() => EditGuest(guest)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>

                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Delete"
                                                            @onclick="() => DeleteGuest(guest)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                                                }
                                    </tbody>
                                </table>
                            </div>
                        }

                    </div>
                </div>
            </div>

        </div>
    </div>
}

@if (showDeleteModal && guestToDelete != null)
{
    <div class="guest-popup-backdrop">
        <div class="guest-popup-card delete-popup">

            <div class="delete-popup-icon">
                <i class="fas fa-exclamation-triangle"></i>
            </div>

            <h4>Delete Guest Record?</h4>

            <p>
                You are about to delete
                <strong>
                    @guestToDelete.Title @guestToDelete.FirstName @guestToDelete.Surname
                </strong>.
            </p>

            <div class="mt-3 d-flex justify-content-center gap-2">
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        disabled="@isDeleting"
                        @onclick="CancelDelete">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-danger btn-sm"
                        disabled="@isDeleting"
                        @onclick="ConfirmDelete">

                    @if (isDeleting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <i class="fas fa-trash me-2"></i>
                        <span>Delete</span>
                    }

                </button>
            </div>

        </div>
    </div>
}

@if (showSuccessModal)
{
    <div class="guest-popup-backdrop">
        <div class="guest-popup-card result-popup">

            <div class="result-popup-icon">
                <i class="fas fa-check-circle"></i>
            </div>

            <h4>Guest Registered</h4>

            <p>
                <strong>@successGuestName</strong> was registered successfully.
            </p>

            <div class="guest-number-box">
                Guest Number:
                <strong>@successGuestNumber</strong>
            </div>

            <button type="button"
                    class="bcc-btn bcc-btn-primary compact-btn mt-3"
                    @onclick="CloseSuccessModalAndRefresh">
                OK
            </button>

        </div>
    </div>
}

@code {
    private CreateGuestModel model = NewGuestModel();

    private List<Service> services = new();
    private List<Guest> recentFirstTimers = new();
    private List<Guest> filteredFirstTimers = new();

    private Guest? guestToDelete;

    private bool isLoading = true;
    private bool isSubmitting;
    private bool isDeleting;
    private bool canAccessGuestManagement;
    private bool showDeleteModal;
    private bool showSuccessModal;

    private string errorMessage = string.Empty;
    private string phoneValidationMessage = string.Empty;
    private string emailValidationMessage = string.Empty;
    private string searchTerm = string.Empty;

    private string successGuestNumber = string.Empty;
    private string successGuestName = string.Empty;

    private Dictionary<string, List<string>> validationErrors = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var worker = AuthService.CurrentWorker;

            if (worker == null)
            {
                canAccessGuestManagement = false;
                return;
            }

            var access =
                await ServiceRecordAccessService
                    .GetAccessAsync(worker.Id);

            var hasGuestPrivilege =
                access.CanAccessGuestManagement;

            var isFigDirectorate =
                IsFigName(worker.Directorate?.Name);

            var isSecondaryDepartmentFig =
                IsFigName(worker.SecondaryDepartment?.Name);

            var hasAuthorisedRole =
                AuthService.IsInRole("Church Admin") ||
                AuthService.IsInRole("Head of Service") ||
                AuthService.IsInRole("Pastor in Charge");

            canAccessGuestManagement =
                hasGuestPrivilege &&
                (
                    isFigDirectorate ||
                    isSecondaryDepartmentFig ||
                    hasAuthorisedRole
                );

            if (!canAccessGuestManagement)
                return;

            services =
                await ServiceService.GetActiveServicesAsync();

            await LoadTodayGuests();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load first timer registration: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SubmitForm()
    {
        ClearValidationMessages();

        if (!ValidateModel())
            return;

        if (AuthService.CurrentWorker == null)
        {
            errorMessage =
                "Unable to identify the current worker.";
            return;
        }

        try
        {
            isSubmitting = true;

            if (!string.IsNullOrWhiteSpace(model.PhoneNumber))
            {
                var isPhoneUnique =
                    await GuestService
                        .IsPhoneNumberUniqueAsync(
                            model.PhoneNumber);

                if (!isPhoneUnique)
                {
                    phoneValidationMessage =
                        "This phone number is already registered.";
                    return;
                }
            }

            if (!string.IsNullOrWhiteSpace(model.Email))
            {
                var isEmailUnique =
                    await GuestService
                        .IsEmailUniqueAsync(model.Email);

                if (!isEmailUnique)
                {
                    emailValidationMessage =
                        "This email address is already registered.";
                    return;
                }
            }

            var guest =
                await GuestService.CreateFirstTimerAsync(
                    model,
                    AuthService.CurrentWorker);

            successGuestNumber =
                guest.GuestNumber;

            successGuestName =
                $"{guest.FirstName} {guest.Surname}".Trim();

            showSuccessModal = true;
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to register guest: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task LoadTodayGuests()
    {
        var today = DateTime.Today;

        recentFirstTimers =
            await GuestService
                .GetRecentFirstTimersAsync(today);

        filteredFirstTimers =
            recentFirstTimers.ToList();
    }

    private bool ValidateModel()
    {
        validationErrors.Clear();

        if (model.ServiceId <= 0)
            AddValidationError(
                nameof(model.ServiceId),
                "Please select a service.");

        if (string.IsNullOrWhiteSpace(model.Title))
            AddValidationError(
                nameof(model.Title),
                "Title is required.");

        if (string.IsNullOrWhiteSpace(model.FirstName))
            AddValidationError(
                nameof(model.FirstName),
                "First name is required.");

        if (string.IsNullOrWhiteSpace(model.Surname))
            AddValidationError(
                nameof(model.Surname),
                "Surname is required.");

        if (string.IsNullOrWhiteSpace(model.Sex))
            AddValidationError(
                nameof(model.Sex),
                "Sex is required.");

        // if (string.IsNullOrWhiteSpace(model.AgeGroup))
        //     AddValidationError(
        //         nameof(model.AgeGroup),
        //         "Age group is required.");

        // if (string.IsNullOrWhiteSpace(model.HowFoundUs))
        //     AddValidationError(
        //         nameof(model.HowFoundUs),
        //         "Please specify how the guest found us.");

        if (model.VisitingDate.Date > DateTime.Today)
            AddValidationError(
                nameof(model.VisitingDate),
                "Visiting date cannot be in the future.");

        return !validationErrors.Any();
    }

    private void OnSearch(ChangeEventArgs e)
    {
        searchTerm =
            e.Value?.ToString() ?? string.Empty;

        FilterGuests();
    }

    private void FilterGuests()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredFirstTimers =
                recentFirstTimers.ToList();

            return;
        }

        var term = searchTerm.Trim();

        filteredFirstTimers =
            recentFirstTimers
                .Where(g =>
                    (g.FirstName?.Contains(
                        term,
                        StringComparison.OrdinalIgnoreCase)
                        ?? false) ||

                    (g.Surname?.Contains(
                        term,
                        StringComparison.OrdinalIgnoreCase)
                        ?? false) ||

                    (g.GuestNumber?.Contains(
                        term,
                        StringComparison.OrdinalIgnoreCase)
                        ?? false) ||

                    (g.PhoneNumber?.Contains(
                        term,
                        StringComparison.OrdinalIgnoreCase)
                        ?? false) ||

                    (g.Service?.Name?.Contains(
                        term,
                        StringComparison.OrdinalIgnoreCase)
                        ?? false))
                .ToList();
    }

    private void EditGuest(Guest guest)
    {
        Navigation.NavigateTo(
            $"/guest/edit/{guest.Id}");
    }

    private void ViewGuestDetails(int guestId)
    {
        Navigation.NavigateTo(
            $"/guest/details/{guestId}");
    }

    private void DeleteGuest(Guest guest)
    {
        guestToDelete = guest;
        showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        if (guestToDelete == null)
            return;

        try
        {
            isDeleting = true;

            var success =
                await GuestService.DeleteGuestAsync(
                    guestToDelete.Id);

            if (!success)
            {
                throw new Exception(
                    "The guest record could not be deleted.");
            }

            showDeleteModal = false;
            guestToDelete = null;

            await LoadTodayGuests();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to delete guest: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
        guestToDelete = null;
    }

    private void OnHowFoundUsChanged(
        ChangeEventArgs e)
    {
        model.HowFoundUs =
            e.Value?.ToString() ?? string.Empty;

        if (model.HowFoundUs != "invite")
        {
            model.InvitedByName =
                string.Empty;
        }
    }

    private void CloseSuccessModalAndRefresh()
    {
        showSuccessModal = false;
        ResetForm();
        _ = LoadTodayGuests();
    }

    private void ResetForm()
    {
        model = NewGuestModel();

        validationErrors.Clear();
        phoneValidationMessage = string.Empty;
        emailValidationMessage = string.Empty;
        errorMessage = string.Empty;
    }

    private static CreateGuestModel NewGuestModel()
    {
        return new CreateGuestModel
        {
            VisitingDate = DateTime.Today
        };
    }

    private static bool IsFigName(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        return string.Equals(
                   value.Trim(),
                   "FIG",
                   StringComparison.OrdinalIgnoreCase)
               ||
               value.Contains(
                   "FIG",
                   StringComparison.OrdinalIgnoreCase);
    }

    private void AddValidationError(
        string propertyName,
        string message)
    {
        if (!validationErrors.ContainsKey(propertyName))
        {
            validationErrors[propertyName] =
                new List<string>();
        }

        validationErrors[propertyName].Add(message);
    }

    private string GetValidationMessage(
        string propertyName)
    {
        return validationErrors.TryGetValue(
            propertyName,
            out var messages)
                ? string.Join("; ", messages)
                : string.Empty;
    }

    private void ClearValidationMessages()
    {
        validationErrors.Clear();
        phoneValidationMessage = string.Empty;
        emailValidationMessage = string.Empty;
        errorMessage = string.Empty;
    }

    private static string GetGuestInitials(
        Guest guest)
    {
        var first =
            !string.IsNullOrWhiteSpace(guest.FirstName)
                ? guest.FirstName[..1].ToUpperInvariant()
                : string.Empty;

        var last =
            !string.IsNullOrWhiteSpace(guest.Surname)
                ? guest.Surname[..1].ToUpperInvariant()
                : string.Empty;

        var initials = $"{first}{last}";

        return string.IsNullOrWhiteSpace(initials)
            ? "G"
            : initials;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/guest");
    }
}

