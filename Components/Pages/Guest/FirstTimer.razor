@page "/guest/first-timer"
@layout Components.Layout.MainLayout
@using ChurchApp.Services
@using ChurchApp.Models
@inject GuestService GuestService
@inject ServiceService ServiceService
@inject AuthService AuthService
@inject RecordNominationService RecordNominationService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Guest Connect - BCC ServiceHub</PageTitle>

@if (AuthService.IsAuthenticated)
{
    @if (showNotNominatedModal)
    {
        <div class="team-modal-backdrop">
            <div class="team-modal-card text-center">
                <div class="guest-access-icon warning">
                    <i class="fas fa-user-clock"></i>
                </div>

                <h4>Access Restricted</h4>
                <p>You are not nominated to take guest records for today.</p>

                <div class="guest-access-box">
                    <div>
                        <strong>Service</strong>
                        <span>@(selectedService?.Name ?? "No service selected")</span>
                    </div>
                    <div>
                        <strong>Date</strong>
                        <span>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
                    </div>
                </div>

                <p class="text-muted small mb-4">
                    Only nominated FIG members, FIG Directorate leaders, or authorized department heads can record guests.
                </p>

                <button type="button" class="bcc-btn guest-secondary-btn w-100" @onclick="GoToGuestManagement">
                    <i class="fas fa-arrow-left me-1"></i>Back to Guest Centre
                </button>
            </div>
        </div>
    }

    @if (!IsFIGDirectorateMember() && !IsFIGHeadOfDepartment() && !isUserNominated && !showNotNominatedModal)
    {
        <div class="guest-firsttimer-v2-page">
            <div class="bcc-empty">
                <i class="fas fa-lock"></i>
                <h4>Access Denied</h4>
                <p>This section is only accessible to FIG Directorate members or nominated guest record keepers.</p>
                <a href="/guest" class="bcc-btn bcc-btn-primary text-decoration-none">
                    <i class="fas fa-arrow-left me-1"></i>Back to Guest Centre
                </a>
            </div>
        </div>
    }
    else if (isLoading)
    {
        <div class="guest-firsttimer-v2-page">
            <div class="bcc-card">
                <div class="bcc-card-body text-center py-5">
                    <div class="spinner-border text-primary mb-3"></div>
                    <h5 class="fw-bold">Loading Guest Connect...</h5>
                    <p class="text-muted mb-0">Please wait while we prepare today’s guest register.</p>
                </div>
            </div>
        </div>
    }
    else if (isUserNominated || IsFIGDirectorateMember() || IsFIGHeadOfDepartment())
    {
        @if (showDeleteModal)
        {
            <div class="team-modal-backdrop">
                <div class="team-modal-card">
                    <button class="team-modal-close" @onclick="CancelDelete">
                        <i class="fas fa-times"></i>
                    </button>

                    <div class="text-center">
                        <div class="guest-access-icon danger">
                            <i class="fas fa-trash-alt"></i>
                        </div>

                        <h4>Delete Guest Record?</h4>
                        <p>This action cannot be undone.</p>
                    </div>

                    <div class="guest-access-box">
                        <div>
                            <strong>Guest</strong>
                            <span>@guestToDelete?.Title @guestToDelete?.FirstName @guestToDelete?.Surname</span>
                        </div>
                        <div>
                            <strong>Guest ID</strong>
                            <span>@guestToDelete?.GuestNumber</span>
                        </div>
                    </div>

                    <div class="team-modal-actions">
                        <button type="button" class="bcc-btn guest-secondary-btn" @onclick="CancelDelete">
                            Cancel
                        </button>

                        <button type="button" class="bcc-btn guest-danger-btn" @onclick="ConfirmDelete" disabled="@isDeleting">
                            @if (isDeleting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {
                                <i class="fas fa-trash me-1"></i>
                            }
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="guest-firsttimer-v2-page">
                <div class="alert alert-success profile-v2-alert alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    <strong>Success!</strong> @successMessage
                    <button type="button" class="btn-close" @onclick="ClearSuccessMessage"></button>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="guest-firsttimer-v2-page">
                <div class="alert alert-danger profile-v2-alert alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i> @errorMessage
                    <button type="button" class="btn-close" @onclick="ClearErrorMessage"></button>
                </div>
            </div>
        }

        @if (showAddForm)
        {
            <div class="guest-firsttimer-v2-page guest-intake-v3-page">

                <div class="bcc-page-header guest-intake-header">
                    <div>
                        <div class="guest-page-kicker">
                            <i class="fas fa-clipboard-list me-2"></i>BCC ServiceHub
                        </div>
                        <div class="bcc-page-title">Guest Intake Sheet</div>
                        <div class="bcc-page-subtitle">
                            Fast single-page capture for MAT guest registration.
                        </div>
                    </div>

                    <button class="bcc-btn guest-light-btn" @onclick="ShowGuestList">
                        <i class="fas fa-arrow-left me-1"></i>Today’s Register
                    </button>
                </div>

                <div class="guest-intake-layout">

                    <aside class="guest-intake-side">
                        <div class="guest-intake-side-card">
                            <div class="guest-intake-side-icon">
                                <i class="fas fa-calendar-check"></i>
                            </div>

                            <h5>Service Access</h5>
                            <p>Select the service first to unlock the form.</p>

                            <label class="bcc-form-label">Service *</label>
                            <select class="form-select bcc-input" @bind="SelectedServiceId" @bind:event="onchange">
                                <option value="0">Select Service</option>
                                @foreach (var service in services)
                                {
                                    <option value="@service.Id">@service.Name</option>
                                }
                            </select>

                            @if (selectedService != null && !string.IsNullOrEmpty(nominationStatusMessage))
                            {
                                <div class="guest-intake-auth @(isUserNominatedForSelectedService ? "approved" : "warning")">
                                    <i class="@(isUserNominatedForSelectedService ? "fas fa-check-circle" : "fas fa-info-circle")"></i>
                                    <span>@nominationStatusMessage</span>
                                </div>
                            }
                            else
                            {
                                <div class="guest-intake-auth neutral">
                                    <i class="fas fa-info-circle"></i>
                                    <span>Waiting for service selection.</span>
                                </div>
                            }
                        </div>
                    </aside>

                    <main class="guest-intake-main">
                        <div class="bcc-card">
                            <div class="bcc-card-header guest-intake-card-header">
                                <div>
                                    <div class="bcc-card-title">
                                        <i class="fas fa-user-plus me-2 text-primary"></i>First Timer Registration
                                    </div>
                                    <small class="text-muted">Compact MAT data-entry form. Fields marked * are required.</small>
                                </div>
                            </div>

                            <div class="bcc-card-body guest-intake-body">
                                <form>

                                    <div class="guest-intake-section">
                                        <h6><i class="fas fa-user-circle"></i>Personal Details</h6>

                                        <div class="row g-2">
                                            <div class="col-md-2">
                                                <label class="guest-intake-label">Title *</label>
                                                <select class="form-select bcc-input guest-intake-input" @bind="model.Title" disabled="@(!isUserNominatedForSelectedService)">
                                                    <option value="">Title</option>
                                                    <option value="Mr">Mr</option>
                                                    <option value="Mrs">Mrs</option>
                                                    <option value="Miss">Miss</option>
                                                    <option value="Dr">Dr</option>
                                                    <option value="Pastor">Pastor</option>
                                                    <option value="Rev">Rev</option>
                                                    <option value="Prof">Prof</option>
                                                    <option value="Engr">Engr</option>
                                                </select>
                                                <span class="text-danger small">@GetValidationMessage(nameof(model.Title))</span>
                                            </div>

                                            <div class="col-md-3">
                                                <label class="guest-intake-label">First Name *</label>
                                                <input class="form-control bcc-input guest-intake-input" @bind="model.FirstName" disabled="@(!isUserNominatedForSelectedService)" />
                                                <span class="text-danger small">@GetValidationMessage(nameof(model.FirstName))</span>
                                            </div>

                                            <div class="col-md-3">
                                                <label class="guest-intake-label">Middle Name</label>
                                                <input class="form-control bcc-input guest-intake-input" @bind="model.MiddleName" disabled="@(!isUserNominatedForSelectedService)" />
                                            </div>

                                            <div class="col-md-4">
                                                <label class="guest-intake-label">Surname *</label>
                                                <input class="form-control bcc-input guest-intake-input" @bind="model.Surname" disabled="@(!isUserNominatedForSelectedService)" />
                                                <span class="text-danger small">@GetValidationMessage(nameof(model.Surname))</span>
                                            </div>

                                            <div class="col-md-3">
                                                <label class="guest-intake-label">Sex *</label>
                                                <div class="guest-radio-pill-group">
                                                    <label class="guest-radio-pill">
                                                        <input type="radio" name="sex"
                                                               checked="@(model.Sex == "Male")"
                                                               @onchange="@(() => { if (isUserNominatedForSelectedService) model.Sex = "Male"; })"
                                                               disabled="@(!isUserNominatedForSelectedService)" />
                                                        Male
                                                    </label>

                                                    <label class="guest-radio-pill">
                                                        <input type="radio" name="sex"
                                                               checked="@(model.Sex == "Female")"
                                                               @onchange="@(() => { if (isUserNominatedForSelectedService) model.Sex = "Female"; })"
                                                               disabled="@(!isUserNominatedForSelectedService)" />
                                                        Female
                                                    </label>
                                                </div>
                                                <span class="text-danger small">@GetValidationMessage(nameof(model.Sex))</span>
                                            </div>

                                            <div class="col-md-3">
                                                <label class="guest-intake-label">Age Group *</label>
                                                <select class="form-select bcc-input guest-intake-input" @bind="model.AgeGroup" disabled="@(!isUserNominatedForSelectedService)">
                                                    <option value="">Age Group</option>
                                                    <option value="below 30">Below 30</option>
                                                    <option value="30-40">30-40</option>
                                                    <option value="41-50">41-50</option>
                                                    <option value="51-60">51-60</option>
                                                    <option value="60 and above">60 and above</option>
                                                </select>
                                                <span class="text-danger small">@GetValidationMessage(nameof(model.AgeGroup))</span>
                                            </div>

                                            <div class="col-md-3">
                                                <label class="guest-intake-label">Service Attended *</label>
                                                <select class="form-select bcc-input guest-intake-input" @bind="model.ServiceId" disabled="@(!isUserNominatedForSelectedService)">
                                                    <option value="0">Select Service</option>
                                                    @foreach (var service in services)
                                                    {
                                                        <option value="@service.Id">@service.Name</option>
                                                    }
                                                </select>
                                                <span class="text-danger small">@GetValidationMessage(nameof(model.ServiceId))</span>
                                            </div>

                                            <div class="col-md-3">
                                                <label class="guest-intake-label">Visiting Date *</label>
                                                <input type="date" class="form-control bcc-input guest-intake-input"
                                                       @bind="model.VisitingDate"
                                                       @bind:format="yyyy-MM-dd"
                                                       max="@DateTime.Now.ToString("yyyy-MM-dd")"
                                                       disabled="@(!isUserNominatedForSelectedService)" />
                                                <span class="text-danger small">@GetValidationMessage(nameof(model.VisitingDate))</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="guest-intake-section">
                                        <h6><i class="fas fa-phone-alt"></i>Contact Details</h6>

                                        <div class="row g-2">
                                            <div class="col-md-4">
                                                <label class="guest-intake-label">Phone Number</label>
                                                <input type="tel" class="form-control bcc-input guest-intake-input"
                                                       @bind="model.PhoneNumber"
                                                       placeholder="080XXXXXXXX"
                                                       disabled="@(!isUserNominatedForSelectedService)" />
                                                <span class="text-danger small">@phoneValidationMessage</span>
                                            </div>

                                            <div class="col-md-4">
                                                <label class="guest-intake-label">WhatsApp Number</label>
                                                <input type="tel" class="form-control bcc-input guest-intake-input"
                                                       @bind="model.WhatsAppNumber"
                                                       placeholder="080XXXXXXXX"
                                                       disabled="@(!isUserNominatedForSelectedService)" />
                                            </div>

                                            <div class="col-md-4">
                                                <label class="guest-intake-label">Email</label>
                                                <input type="email" class="form-control bcc-input guest-intake-input"
                                                       @bind="model.Email"
                                                       placeholder="email@example.com"
                                                       disabled="@(!isUserNominatedForSelectedService)" />
                                                <span class="text-danger small">@emailValidationMessage</span>
                                            </div>

                                            <div class="col-md-8">
                                                <label class="guest-intake-label">Address</label>
                                                <textarea class="form-control bcc-input guest-intake-input"
                                                          @bind="model.Address"
                                                          rows="2"
                                                          placeholder="Full residential address"
                                                          disabled="@(!isUserNominatedForSelectedService)"></textarea>
                                            </div>

                                            <div class="col-md-4">
                                                <label class="guest-intake-label">Landmark</label>
                                                <textarea class="form-control bcc-input guest-intake-input"
                                                          @bind="model.Landmark"
                                                          rows="2"
                                                          placeholder="Nearest landmark"
                                                          disabled="@(!isUserNominatedForSelectedService)"></textarea>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="guest-intake-section">
                                        <h6><i class="fas fa-church"></i>Church Connection</h6>

                                        <div class="row g-2">
                                            <div class="col-md-4">
                                                <label class="guest-intake-label">RCCG Member? *</label>
                                                <div class="guest-radio-pill-group">
                                                    <label class="guest-radio-pill">
                                                        <input type="radio" name="rccgMember"
                                                               checked="@(model.IsRCCGMember == true)"
                                                               @onchange="() => { if (isUserNominatedForSelectedService) model.IsRCCGMember = true; }"
                                                               disabled="@(!isUserNominatedForSelectedService)" />
                                                        Yes
                                                    </label>

                                                    <label class="guest-radio-pill">
                                                        <input type="radio" name="rccgMember"
                                                               checked="@(model.IsRCCGMember == false)"
                                                               @onchange="() => { if (isUserNominatedForSelectedService) model.IsRCCGMember = false; }"
                                                               disabled="@(!isUserNominatedForSelectedService)" />
                                                        No
                                                    </label>
                                                </div>
                                            </div>

                                            @if (!model.IsRCCGMember)
                                            {
                                                <div class="col-md-4">
                                                    <label class="guest-intake-label">Current Church</label>
                                                    <input class="form-control bcc-input guest-intake-input"
                                                           @bind="model.OtherChurch"
                                                           placeholder="Name of church"
                                                           disabled="@(!isUserNominatedForSelectedService)" />
                                                </div>
                                            }

                                            <div class="col-md-4">
                                                <label class="guest-intake-label">How did you find us? *</label>
                                                <select class="form-select bcc-input guest-intake-input"
                                                        value="@model.HowFoundUs"
                                                        @onchange="OnHowFoundUsChanged"
                                                        disabled="@(!isUserNominatedForSelectedService)">
                                                    <option value="">Select Option</option>
                                                    <option value="Facebook">Facebook</option>
                                                    <option value="Youtube">YouTube</option>
                                                    <option value="Instagram">Instagram</option>
                                                    <option value="X">X (Twitter)</option>
                                                    <option value="looking around">Looking Around</option>
                                                    <option value="invite">Invitation</option>
                                                </select>
                                                <span class="text-danger small">@GetValidationMessage(nameof(model.HowFoundUs))</span>
                                            </div>

                                            @if (model.HowFoundUs == "invite")
                                            {
                                                <div class="col-md-4">
                                                    <label class="guest-intake-label">Invited By</label>
                                                    <input class="form-control bcc-input guest-intake-input"
                                                           @bind="model.InvitedByName"
                                                           placeholder="Name of inviter"
                                                           disabled="@(!isUserNominatedForSelectedService)" />
                                                </div>
                                            }
                                        </div>
                                    </div>

                                </form>
                            </div>

                            <div class="guest-intake-footer">
                                <button class="bcc-btn guest-secondary-btn" @onclick="ShowGuestList">
                                    <i class="fas fa-times me-1"></i>Cancel
                                </button>

                                <button class="bcc-btn bcc-btn-primary"
                                        @onclick="SubmitForm"
                                        disabled="@(!isUserNominatedForSelectedService || isSubmitting)">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-save me-1"></i>
                                    }

                                    @if (!isUserNominatedForSelectedService)
                                    {
                                        <span>Not Authorized</span>
                                    }
                                    else
                                    {
                                        <span>Save Guest Record</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </main>
                </div>
            </div>
        }
        else
        {
            <div class="guest-firsttimer-v2-page">
                <div class="bcc-page-header">
                    <div>
                        <div class="guest-page-kicker">
                            <i class="fas fa-hands-helping me-2"></i>BCC ServiceHub
                        </div>
                        <div class="bcc-page-title">Guest Connect</div>
                        <div class="bcc-page-subtitle">
                            Record and manage first-time visitors attending today’s church services.
                        </div>
                        <div class="guest-page-date">
                            <i class="fas fa-calendar-day me-2"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button class="bcc-btn guest-light-btn" @onclick="GoToGuestManagement">
                            <i class="fas fa-arrow-left me-1"></i>Guest Centre
                        </button>

                        <button class="bcc-btn guest-warning-btn"
                                @onclick="() => ShowAddForm()"
                                disabled="@(!hasNominatedServiceToday && !IsFIGDirectorateMember() && !IsFIGHeadOfDepartment())">
                            <i class="fas fa-user-plus me-1"></i>Register Guest
                        </button>
                    </div>
                </div>

                <div class="bcc-empty guest-empty-state">
                    <i class="fas fa-users"></i>
                    <h4>Today’s Guest Register</h4>
                    <p>Click Register Guest to capture a first timer.</p>
                </div>
            </div>
        }
    }
}
else
{
    <div class="guest-firsttimer-v2-page">
        <div class="bcc-empty">
            <i class="fas fa-exclamation-triangle"></i>
            <h4>Please Log In</h4>
            <p>You need to be logged in to access Guest Connect.</p>
            <a href="/login" class="bcc-btn bcc-btn-primary text-decoration-none">Go to Login</a>
        </div>
    </div>
}

@if (showSuccessModal)
{
    <div class="team-modal-backdrop">
        <div class="team-modal-card text-center">
            <div class="guest-access-icon success">
                <i class="fas fa-user-check"></i>
            </div>

            <h4>Guest Successfully Registered</h4>
            <p>The first timer has been added to today’s guest register.</p>

            <div class="guest-success-id">
                <span>Guest ID</span>
                <strong>@successGuestNumber</strong>
            </div>

            <h5 class="fw-bold text-dark">@successGuestName</h5>

            <button type="button" class="bcc-btn bcc-btn-primary w-100 mt-3" @onclick="CloseSuccessModalAndRefresh">
                <i class="fas fa-check me-1"></i>Done
            </button>
        </div>
    </div>
}

@code {
    private CreateGuestModel model = new();
    private List<Service> services = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool isDeleting = false;
    private string errorMessage = "";
    private string successMessage = "";
    private string phoneValidationMessage = "";
    private string emailValidationMessage = "";
    private string nominationStatusMessage = "";

    private bool showAddForm = false;
    private bool showSuccessModal = false;
    private bool showDeleteModal = false;
    private bool showNotNominatedModal = false;
    private bool isUserNominated = false;
    private bool isUserNominatedForSelectedService = false;
    private bool hasNominatedServiceToday = false;

    private List<Guest> recentFirstTimers = new();
    private List<Guest> filteredFirstTimers = new();
    private Guest? guestToDelete;
    private string searchTerm = "";
    private int selectedServiceId = 0;
    private Service? selectedService = null;

    private string successGuestNumber = "";
    private string successGuestName = "";

    private Dictionary<string, List<string>> validationErrors = new();

    private int SelectedServiceId
    {
        get => selectedServiceId;
        set
        {
            if (selectedServiceId != value)
            {
                selectedServiceId = value;
                _ = OnServiceSelected(value);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
            return;

        var isFIGDirectorateMember = IsFIGDirectorateMember() || IsFIGHeadOfDepartment();

        if (!isFIGDirectorateMember)
        {
            isUserNominated = await CheckUserNominationStatus();

            if (!isUserNominated)
            {
                showNotNominatedModal = true;
            }
        }
        else
        {
            isUserNominated = true;
            hasNominatedServiceToday = true;
        }

        await LoadServices();
        await LoadTodayGuests();
        isLoading = false;
    }

    private async Task<bool> CheckUserNominationStatus()
    {
        try
        {
            var currentWorker = AuthService.CurrentWorker;
            if (currentWorker == null) return false;

            var today = DateTime.Today;

            var nominations = await RecordNominationService.GetNominationsForUserAsync(currentWorker.WorkerId, today);
            var guestRecordNominations = nominations.Where(n => n.RecordType == "Guest Record").ToList();

            hasNominatedServiceToday = guestRecordNominations.Any();

            return hasNominatedServiceToday;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking nomination status: {ex.Message}");
            return false;
        }
    }

    private async Task LoadServices()
    {
        try
        {
            services = await ServiceService.GetActiveServicesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading services: {ex.Message}";
        }
    }

    private async Task LoadTodayGuests()
    {
        try
        {
            var today = DateTime.Today;
            recentFirstTimers = await GuestService.GetRecentFirstTimersAsync(today);
            filteredFirstTimers = recentFirstTimers;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading today's guests: {ex.Message}");
            recentFirstTimers = new List<Guest>();
            filteredFirstTimers = new List<Guest>();
        }
    }

    private bool IsFIGDirectorateMember()
    {
        var worker = AuthService.CurrentWorker;
        if (worker == null) return false;

        var directorateName = worker.Directorate?.Name?.ToLowerInvariant() ?? "";
        var role = worker.Role?.ToLowerInvariant() ?? "";

        var isInFIG = directorateName.Contains("fig");

        var hasValidRole = role.Contains("head of directorate") ||
                           role.Contains("asst head of directorate") ||
                           role.Contains("directorate member") ||
                           AuthService.IsInRole("Church Admin") ||
                           AuthService.IsInRole("Pastor in Charge");

        return isInFIG && hasValidRole;
    }

    private async Task OnServiceSelected(int serviceId)
    {
        if (serviceId > 0)
        {
            selectedServiceId = serviceId;
            selectedService = services.FirstOrDefault(s => s.Id == serviceId);

            await CheckNominationForSelectedService();

            model.ServiceId = serviceId;
            model.VisitingDate = DateTime.Today;

            StateHasChanged();
        }
        else
        {
            selectedServiceId = 0;
            selectedService = null;
            model.ServiceId = 0;
            isUserNominatedForSelectedService = false;
            nominationStatusMessage = "Please select a service";
            StateHasChanged();
        }
    }

    private async Task CheckNominationForSelectedService()
    {
        if (selectedServiceId <= 0 || AuthService.CurrentWorker == null)
        {
            isUserNominatedForSelectedService = false;
            nominationStatusMessage = "Please select a service";
            return;
        }

        var today = DateTime.Today;
        var workerId = AuthService.CurrentWorker.WorkerId;
        var recordType = "Guest Record";

        try
        {
            if (IsFIGDirectorateMember() || IsFIGHeadOfDepartment())
            {
                isUserNominatedForSelectedService = true;
                nominationStatusMessage = "Authorized to record guests for this service.";
                return;
            }

            var isNominated = await RecordNominationService.IsWorkerNominatedForRecord(
                workerId,
                selectedServiceId,
                today,
                recordType
            );

            if (isNominated)
            {
                isUserNominatedForSelectedService = true;
                nominationStatusMessage = $"Nominated for {selectedService?.Name}.";
            }
            else
            {
                isUserNominatedForSelectedService = false;
                nominationStatusMessage = $"Not nominated for {selectedService?.Name}. Form disabled.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking nomination: {ex.Message}");
            isUserNominatedForSelectedService = false;
            nominationStatusMessage = "Error checking nomination status.";
        }
    }

    private async Task SubmitForm()
    {
        if (!isUserNominatedForSelectedService)
        {
            errorMessage = "You are not authorized to record guests for this service.";
            return;
        }

        ClearValidationMessages();

        if (!ValidateModel())
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(model.PhoneNumber))
        {
            var isPhoneUnique = await GuestService.IsPhoneNumberUniqueAsync(model.PhoneNumber);

            if (!isPhoneUnique)
            {
                phoneValidationMessage = "This phone number is already registered with another guest.";
                return;
            }
        }

        if (!string.IsNullOrWhiteSpace(model.Email))
        {
            var isEmailUnique = await GuestService.IsEmailUniqueAsync(model.Email);

            if (!isEmailUnique)
            {
                emailValidationMessage = "This email address is already registered with another guest.";
                return;
            }
        }

        isSubmitting = true;
        errorMessage = "";
        successMessage = "";

        try
        {
            var currentWorker = AuthService.CurrentWorker;
            var guest = await GuestService.CreateFirstTimerAsync(model, currentWorker);

            successGuestNumber = guest.GuestNumber;
            successGuestName = $"{guest.FirstName} {guest.Surname}".Trim();

            showSuccessModal = true;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving guest: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool ValidateModel()
    {
        validationErrors.Clear();

        if (string.IsNullOrWhiteSpace(model.Title))
            AddValidationError(nameof(model.Title), "Title is required");

        if (string.IsNullOrWhiteSpace(model.FirstName))
            AddValidationError(nameof(model.FirstName), "First name is required");

        if (string.IsNullOrWhiteSpace(model.Surname))
            AddValidationError(nameof(model.Surname), "Surname is required");

        if (string.IsNullOrWhiteSpace(model.Sex))
            AddValidationError(nameof(model.Sex), "Sex is required");

        if (string.IsNullOrWhiteSpace(model.AgeGroup))
            AddValidationError(nameof(model.AgeGroup), "Age group is required");

        if (string.IsNullOrWhiteSpace(model.HowFoundUs))
            AddValidationError(nameof(model.HowFoundUs), "Please specify how you found us");

        if (model.ServiceId <= 0)
            AddValidationError(nameof(model.ServiceId), "Please select a service");

        if (model.VisitingDate > DateTime.Today)
            AddValidationError(nameof(model.VisitingDate), "Visiting date cannot be in the future");

        return !validationErrors.Any();
    }

