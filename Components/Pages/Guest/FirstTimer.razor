    private bool IsFIGHeadOfDepartment()
    {
        var worker = AuthService.CurrentWorker;
        if (worker == null) return false;

        var directorateName = worker.Directorate?.Name?.ToLowerInvariant() ?? "";
        var role = worker.Role?.ToLowerInvariant() ?? "";

        return directorateName.Contains("fig")
               && role.Contains("head of department")
               && worker.DepartmentId == 4;
    }

    private bool IsValidDateForSelectedService(DateTime date)
    {
        if (selectedService == null)
            return true;

        if (selectedService.Name == "Sunday Service")
            return date.DayOfWeek == DayOfWeek.Sunday;

        if (selectedService.Name == "Mid Week Service")
            return date.DayOfWeek == DayOfWeek.Wednesday;

        return true;
    }

    private void OnServiceChanged()
    {
        if (selectedService?.Name == "Sunday Service")
        {
            while (model.VisitingDate.DayOfWeek != DayOfWeek.Sunday)
                model.VisitingDate = model.VisitingDate.AddDays(1);
        }
        else if (selectedService?.Name == "Mid Week Service")
        {
            while (model.VisitingDate.DayOfWeek != DayOfWeek.Wednesday)
                model.VisitingDate = model.VisitingDate.AddDays(1);
        }
    }

    private string GetGuestInitials(Guest guest)
    {
        var first = !string.IsNullOrWhiteSpace(guest.FirstName) ? guest.FirstName.Substring(0, 1).ToUpper() : "";
        var last = !string.IsNullOrWhiteSpace(guest.Surname) ? guest.Surname.Substring(0, 1).ToUpper() : "";

        var initials = $"{first}{last}";

        return string.IsNullOrWhiteSpace(initials) ? "G" : initials;
    }
