@page "/guest/details/{Id:int}"
@layout Components.Layout.MainLayout
@using ChurchApp.Services
@using ChurchApp.Models
@inject GuestService GuestService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Guest 360 - BCC ServiceHub</PageTitle>

@if (AuthService.IsAuthenticated)
{
    @if (!IsFIGDirectorateMember())
    {
        <div class="guest360-v2-page">
            <div class="bcc-empty">
                <i class="fas fa-lock"></i>
                <h4>Access Denied</h4>
                <p>This section is only accessible to FIG Directorate members.</p>
                <a href="/guest" class="bcc-btn bcc-btn-primary text-decoration-none">
                    <i class="fas fa-arrow-left me-1"></i>Back to Guest Centre
                </a>
            </div>
        </div>
    }
    else if (isLoading)
    {
        <div class="guest360-v2-page">
            <div class="bcc-card">
                <div class="bcc-card-body text-center py-5">
                    <div class="spinner-border text-primary mb-3"></div>
                    <h5 class="fw-bold">Loading Guest 360...</h5>
                    <p class="text-muted mb-0">Please wait while we load the guest profile.</p>
                </div>
            </div>
        </div>
    }
    else if (guest == null)
    {
        <div class="guest360-v2-page">
            <div class="bcc-empty">
                <i class="fas fa-user-slash"></i>
                <h4>Guest Not Found</h4>
                <p>The requested guest record could not be found or may have been deleted.</p>

                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a href="/guest" class="bcc-btn guest-secondary-btn text-decoration-none">
                        <i class="fas fa-arrow-left me-1"></i>Guest Centre
                    </a>
                    <a href="/guest/first-timer" class="bcc-btn bcc-btn-primary text-decoration-none">
                        <i class="fas fa-list me-1"></i>Today’s Guests
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="guest360-v2-page">

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success profile-v2-alert alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    <strong>Success!</strong> @successMessage
                    <button type="button" class="btn-close" @onclick="ClearSuccessMessage"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger profile-v2-alert alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i> @errorMessage
                    <button type="button" class="btn-close" @onclick="ClearErrorMessage"></button>
                </div>
            }

            <div class="bcc-page-header">
                <div>
                    <div class="guest-page-kicker">
                        <i class="fas fa-user-circle me-2"></i>BCC ServiceHub
                    </div>
                    <div class="bcc-page-title">Guest 360</div>
                    <div class="bcc-page-subtitle">
                        Complete guest profile, visit history, contact details, and follow-up information.
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button class="bcc-btn guest-light-btn" @onclick="GoBack">
                        <i class="fas fa-arrow-left me-1"></i>Back
                    </button>

                    <a href="@($"/guest/edit/{Id}")" class="bcc-btn guest-warning-btn text-decoration-none">
                        <i class="fas fa-edit me-1"></i>Edit
                    </a>

                    <button class="bcc-btn guest-danger-outline-btn" @onclick="DeleteGuest">
                        <i class="fas fa-trash me-1"></i>Delete
                    </button>
                </div>
            </div>

            <div class="bcc-card">
                <div class="bcc-card-body">
                    <div class="guest360-profile-hero">
                        <div class="guest360-avatar large">
                            @GetGuestInitials()
                        </div>

                        <div class="flex-grow-1">
                            <h2>@guest.Title @guest.FirstName @guest.Surname</h2>
                            <p>@guest.GuestNumber</p>

                            <div class="guest360-meta-pills">
                                @if (guest.IsSecondTimer)
                                {
                                    <span class="status-warning">
                                        <i class="fas fa-user-check"></i>Second Timer
                                    </span>
                                }
                                else
                                {
                                    <span class="status-success">
                                        <i class="fas fa-user-plus"></i>First Timer
                                    </span>
                                }

                                <span>
                                    <i class="fas fa-calendar-day"></i>@guest.VisitingDate.ToString("dd MMM yyyy")
                                </span>

                                <span>
                                    <i class="fas fa-church"></i>@DisplayText(guest.Service?.Name)
                                </span>

                                <span>
                                    <i class="fas fa-user-edit"></i>@DisplayText(guest.RecordedByName)
                                </span>
                            </div>
                        </div>

                        <div class="guest360-status-box">
                            <span>Guest Type</span>
                            <strong>@(guest.IsSecondTimer ? "Return Visit" : "First Visit")</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="team-summary-card">
                        <span>Guest Number</span>
                        <strong>@guest.GuestNumber</strong>
                        <i class="fas fa-id-card"></i>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="team-summary-card active">
                        <span>Visit Status</span>
                        <strong>@(guest.IsSecondTimer ? "Second" : "First")</strong>
                        <i class="fas fa-user-check"></i>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="team-summary-card directorate">
                        <span>Service</span>
                        <strong>@DisplayText(guest.Service?.Name)</strong>
                        <i class="fas fa-church"></i>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="team-summary-card inactive">
                        <span>Recorded</span>
                        <strong>@guest.RecordingDate.ToString("dd MMM")</strong>
                        <i class="fas fa-clipboard-check"></i>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="bcc-card">
                        <div class="bcc-card-header">
                            <i class="fas fa-user-circle text-primary"></i>
                            <div>
                                <div class="bcc-card-title">Guest Information</div>
                                <small class="text-muted">Personal, contact, church and service details.</small>
                            </div>
                        </div>

                        <div class="bcc-card-body">
                            <div class="guest-form-section">
                                <div class="guest-form-section-header blue">
                                    <i class="fas fa-user-circle"></i>
                                    <span>Personal Information</span>
                                </div>

                                <div class="guest-detail-grid">
                                    <div class="guest-detail-item">
                                        <span>Title</span>
                                        <strong>@DisplayText(guest.Title)</strong>
                                    </div>

                                    <div class="guest-detail-item">
                                        <span>Full Name</span>
                                        <strong>@guest.FirstName @guest.MiddleName @guest.Surname</strong>
                                    </div>

                                    <div class="guest-detail-item">
                                        <span>Sex</span>
                                        <strong>@DisplayText(guest.Sex)</strong>
                                    </div>

                                    <div class="guest-detail-item">
                                        <span>Age Group</span>
                                        <strong>@DisplayText(guest.AgeGroup)</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="guest-form-section">
                                <div class="guest-form-section-header green">
                                    <i class="fas fa-address-book"></i>
                                    <span>Contact Information</span>
                                </div>

                                <div class="guest-detail-grid">
                                    <div class="guest-detail-item full">
                                        <span>Address</span>
                                        <strong>@DisplayText(guest.Address)</strong>
                                    </div>

                                    <div class="guest-detail-item full">
                                        <span>Landmark</span>
                                        <strong>@DisplayText(guest.Landmark)</strong>
                                    </div>

                                    <div class="guest-detail-item">
                                        <span>Phone</span>
                                        <strong>@DisplayText(guest.PhoneNumber)</strong>
                                    </div>

                                    <div class="guest-detail-item">
                                        <span>WhatsApp</span>
                                        <strong>@DisplayText(guest.WhatsAppNumber)</strong>
                                    </div>

                                    <div class="guest-detail-item full">
                                        <span>Email</span>
                                        <strong>@DisplayText(guest.Email)</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="guest-form-section">
                                <div class="guest-form-section-header purple">
                                    <i class="fas fa-church"></i>
                                    <span>Church Information</span>
                                </div>

                                <div class="guest-detail-grid">
                                    <div class="guest-detail-item">
                                        <span>RCCG Member</span>
                                        <strong>@(guest.IsRCCGMember ? "Yes" : "No")</strong>
                                    </div>

                                    @if (!guest.IsRCCGMember)
                                    {
                                        <div class="guest-detail-item">
                                            <span>Other Church</span>
                                            <strong>@DisplayText(guest.OtherChurch)</strong>
                                        </div>
                                    }

                                    <div class="guest-detail-item">
                                        <span>How Found Us</span>
                                        <strong>@DisplayText(guest.HowFoundUs)</strong>
                                    </div>

                                    @if (!string.IsNullOrEmpty(guest.InvitedByName))
                                    {
                                        <div class="guest-detail-item">
                                            <span>Invited By</span>
                                            <strong>@guest.InvitedByName</strong>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="guest-form-section mb-0">
                                <div class="guest-form-section-header amber">
                                    <i class="fas fa-calendar-alt"></i>
                                    <span>Service Information</span>
                                </div>

                                <div class="guest-detail-grid">
                                    <div class="guest-detail-item">
                                        <span>Service</span>
                                        <strong>@DisplayText(guest.Service?.Name)</strong>
                                    </div>

                                    <div class="guest-detail-item">
                                        <span>Visiting Date</span>
                                        <strong>@guest.VisitingDate.ToString("dd/MM/yyyy")</strong>
                                    </div>

                                    <div class="guest-detail-item">
                                        <span>Recording Date</span>
                                        <strong>@guest.RecordingDate.ToString("dd/MM/yyyy")</strong>
                                    </div>

                                    <div class="guest-detail-item">
                                        <span>Recorded By</span>
                                        <strong>@DisplayText(guest.RecordedByName)</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="bcc-card">
                        <div class="bcc-card-header">
                            <i class="fas fa-bolt text-primary"></i>
                            <div>
                                <div class="bcc-card-title">Quick Actions</div>
                                <small class="text-muted">Common guest actions.</small>
                            </div>
                        </div>

                        <div class="bcc-card-body">
                            <div class="guest360-actions-list">
                                <a href="@($"/guest/edit/{Id}")" class="guest360-action">
                                    <i class="fas fa-edit"></i>
                                    <span>Edit Guest Record</span>
                                </a>

                                @if (!guest.IsSecondTimer)
                                {
                                    <button class="guest360-action" @onclick="MarkAsSecondTimer">
                                        <i class="fas fa-user-check"></i>
                                        <span>Mark as Second Timer</span>
                                    </button>
                                }

                                <a href="@($"/guest/phone-followup?guestId={Id}")" class="guest360-action">
                                    <i class="fas fa-phone-alt"></i>
                                    <span>Phone Follow-up</span>
                                </a>

                                <button class="guest360-action" onclick="window.print()">
                                    <i class="fas fa-print"></i>
                                    <span>Print Guest Profile</span>
                                </button>

                                <button class="guest360-action danger" @onclick="DeleteGuest">
                                    <i class="fas fa-trash"></i>
                                    <span>Delete Record</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="bcc-card">
                        <div class="bcc-card-header">
                            <i class="fas fa-clock text-primary"></i>
                            <div>
                                <div class="bcc-card-title">Record Timeline</div>
                                <small class="text-muted">System dates and update history.</small>
                            </div>
                        </div>

                        <div class="bcc-card-body">
                            <div class="worker360-timeline">
                                <div class="worker360-timeline-item">
                                    <div class="worker360-timeline-dot"></div>
                                    <span>@guest.CreatedDate.ToString("dd MMM yyyy HH:mm")</span>
                                    <strong>Guest record created</strong>
                                    <p>Guest ID: @guest.GuestNumber</p>
                                </div>

                                <div class="worker360-timeline-item">
                                    <div class="worker360-timeline-dot"></div>
                                    <span>@guest.VisitingDate.ToString("dd MMM yyyy")</span>
                                    <strong>First visit recorded</strong>
                                    <p>@DisplayText(guest.Service?.Name)</p>
                                </div>

                                @if (guest.UpdatedDate.HasValue)
                                {
                                    <div class="worker360-timeline-item">
                                        <div class="worker360-timeline-dot"></div>
                                        <span>@guest.UpdatedDate.Value.ToString("dd MMM yyyy HH:mm")</span>
                                        <strong>Record updated</strong>
                                        <p>Latest profile update captured.</p>
                                    </div>
                                }

                                @if (guest.IsSecondTimer)
                                {
                                    <div class="worker360-timeline-item">
                                        <div class="worker360-timeline-dot"></div>
                                        <span>Current status</span>
                                        <strong>Second timer</strong>
                                        <p>Guest has returned after first visit.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="bcc-card">
                        <div class="bcc-card-header">
                            <i class="fas fa-info-circle text-primary"></i>
                            <div>
                                <div class="bcc-card-title">System Summary</div>
                            </div>
                        </div>

                        <div class="bcc-card-body">
                            <div class="bcc-info-row">
                                <div class="bcc-info-label">Guest ID</div>
                                <div class="bcc-info-value">@guest.GuestNumber</div>
                            </div>

                            <div class="bcc-info-row">
                                <div class="bcc-info-label">Created</div>
                                <div class="bcc-info-value">@guest.CreatedDate.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>

                            <div class="bcc-info-row">
                                <div class="bcc-info-label">Updated</div>
                                <div class="bcc-info-value">@(guest.UpdatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "Not updated")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="guest360-v2-page">
        <div class="bcc-empty">
            <i class="fas fa-exclamation-triangle"></i>
            <h4>Please Log In</h4>
            <p>You need to be logged in to access Guest 360.</p>
            <a href="/login" class="bcc-btn bcc-btn-primary text-decoration-none">Go to Login</a>
        </div>
    </div>
}

@if (showDeleteModal)
{
    <div class="team-modal-backdrop">
        <div class="team-modal-card">
            <button class="team-modal-close" @onclick="CancelDelete">
                <i class="fas fa-times"></i>
            </button>

            <div class="text-center">
                <div class="guest-access-icon danger">
                    <i class="fas fa-trash-alt"></i>
                </div>

                <h4>Delete Guest Record?</h4>
                <p>This action cannot be undone.</p>
            </div>

            <div class="guest-access-box">
                <div>
                    <strong>Guest</strong>
                    <span>@guest?.Title @guest?.FirstName @guest?.Surname</span>
                </div>

                <div>
                    <strong>Guest ID</strong>
                    <span>@guest?.GuestNumber</span>
                </div>
            </div>

            <div class="team-modal-actions">
                <button type="button" class="bcc-btn guest-secondary-btn" @onclick="CancelDelete">
                    Cancel
                </button>

                <button type="button" class="bcc-btn guest-danger-btn" @onclick="ConfirmDelete" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    else
                    {
                        <i class="fas fa-trash me-1"></i>
                    }
                    Delete Guest
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Guest? guest;
    private bool isLoading = true;
    private bool isDeleting = false;
    private string errorMessage = "";
    private string successMessage = "";
    private bool showDeleteModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadGuestDetails();
    }

    private async Task LoadGuestDetails()
    {
        try
        {
            guest = await GuestService.GetGuestByIdAsync(Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading guest details: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool IsFIGDirectorateMember()
    {
        var worker = AuthService.CurrentWorker;
        if (worker == null) return false;

        var directorateName = worker.Directorate?.Name?.ToLowerInvariant() ?? "";
        var role = worker.Role?.ToLowerInvariant() ?? "";

        var isInFIG = directorateName.Contains("fig");

        var hasValidRole = role.Contains("head of directorate") ||
                           role.Contains("asst head of directorate") ||
                           role.Contains("directorate member") ||
                           AuthService.IsInRole("Church Admin") ||
                           AuthService.IsInRole("Pastor in Charge");

        return isInFIG && hasValidRole;
    }

    private void DeleteGuest()
    {
        showDeleteModal = true;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        isDeleting = true;

        try
        {
            var success = await GuestService.DeleteGuestAsync(Id);

            if (success)
            {
                successMessage = $"Guest {guest?.GuestNumber} deleted successfully.";
                showDeleteModal = false;

                await Task.Delay(2000);
                Navigation.NavigateTo("/guest/first-timer");
            }
            else
            {
                errorMessage = "Failed to delete guest. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting guest: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
        StateHasChanged();
    }

    private async Task MarkAsSecondTimer()
    {
        successMessage = "Use the Second Timer page to complete the second visit form for this guest.";
        StateHasChanged();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/guest/first-timer");
    }

    private void ClearSuccessMessage()
    {
        successMessage = "";
        StateHasChanged();
    }

    private void ClearErrorMessage()
    {
        errorMessage = "";
        StateHasChanged();
    }

    private string GetGuestInitials()
    {
        if (guest == null)
            return "G";

        var first = !string.IsNullOrWhiteSpace(guest.FirstName) ? guest.FirstName.Substring(0, 1).ToUpper() : "";
        var last = !string.IsNullOrWhiteSpace(guest.Surname) ? guest.Surname.Substring(0, 1).ToUpper() : "";

        var initials = $"{first}{last}";

        return string.IsNullOrWhiteSpace(initials) ? "G" : initials;
    }

    private string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not provided" : value;
    }
}