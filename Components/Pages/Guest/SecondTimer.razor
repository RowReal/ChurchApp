@page "/guest/second-timer"
@layout Components.Layout.MainLayout
@using ChurchApp.Services
@using ChurchApp.Models
@inject GuestService GuestService
@inject AuthService AuthService
@inject RecordNominationService RecordNominationService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Second Timer - BCC ServiceHub</PageTitle>

@if (AuthService.IsAuthenticated)
{
    @if (showNotNominatedModal)
    {
        <div class="team-modal-backdrop">
            <div class="team-modal-card text-center">
                <div class="guest-access-icon warning">
                    <i class="fas fa-user-clock"></i>
                </div>

                <h4>Access Restricted</h4>
                <p>You are not nominated to record guest second visits for today.</p>

                <div class="guest-access-box">
                    <div>
                        <strong>Date</strong>
                        <span>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
                    </div>
                </div>

                <p class="text-muted small mb-4">
                    Only nominated FIG members or FIG Directorate leaders can record guest second visits.
                </p>

                <button type="button" class="bcc-btn guest-secondary-btn w-100" @onclick="GoToGuestManagement">
                    <i class="fas fa-arrow-left me-1"></i>Back to Guest Centre
                </button>
            </div>
        </div>
    }

    @if (!IsFIGDirectorateMember() && !isUserNominated && !showNotNominatedModal)
    {
        <div class="guest-secondtimer-v2-page">
            <div class="bcc-empty">
                <i class="fas fa-lock"></i>
                <h4>Access Denied</h4>
                <p>This section is only accessible to FIG Directorate members or nominated record keepers.</p>
                <a href="/guest" class="bcc-btn bcc-btn-primary text-decoration-none">
                    <i class="fas fa-arrow-left me-1"></i>Back to Guest Centre
                </a>
            </div>
        </div>
    }
    else if (isLoading)
    {
        <div class="guest-secondtimer-v2-page">
            <div class="bcc-card">
                <div class="bcc-card-body text-center py-5">
                    <div class="spinner-border text-primary mb-3"></div>
                    <h5 class="fw-bold">Loading Second Timer...</h5>
                    <p class="text-muted mb-0">Please wait while we prepare the second visit workspace.</p>
                </div>
            </div>
        </div>
    }
    else if (isUserNominated || IsFIGDirectorateMember())
    {
        <div class="guest-secondtimer-v2-page">

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success profile-v2-alert alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    <strong>Success!</strong> @successMessage
                    <button type="button" class="btn-close" @onclick="ClearSuccessMessage"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger profile-v2-alert alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i> @errorMessage
                    <button type="button" class="btn-close" @onclick="ClearErrorMessage"></button>
                </div>
            }

            <div class="bcc-page-header">
                <div>
                    <div class="guest-page-kicker">
                        <i class="fas fa-user-check me-2"></i>BCC ServiceHub
                    </div>
                    <div class="bcc-page-title">Second Timer</div>
                    <div class="bcc-page-subtitle">
                        Search first-time guests and update their record when they return for a second visit.
                    </div>
                    <div class="guest-page-date">
                        <i class="fas fa-calendar-day me-2"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button class="bcc-btn guest-light-btn" @onclick="GoToGuestManagement">
                        <i class="fas fa-arrow-left me-1"></i>Guest Centre
                    </button>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="team-summary-card">
                        <span>Search Results</span>
                        <strong>@searchResults.Count</strong>
                        <i class="fas fa-search"></i>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="team-summary-card active">
                        <span>Authorized Status</span>
                        <strong>@(IsFIGDirectorateMember() ? "Leader" : "Nominated")</strong>
                        <i class="fas fa-user-shield"></i>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="team-summary-card directorate">
                        <span>Nominated Services</span>
                        <strong>@(IsFIGDirectorateMember() ? "All" : userNominations.Count)</strong>
                        <i class="fas fa-church"></i>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="team-summary-card inactive">
                        <span>Search Status</span>
                        <strong>@(hasSearched ? "Done" : "Ready")</strong>
                        <i class="fas fa-clipboard-check"></i>
                    </div>
                </div>
            </div>

            <div class="bcc-card">
                <div class="bcc-card-header guest-register-header">
                    <div>
                        <div class="bcc-card-title">
                            <i class="fas fa-search me-2 text-primary"></i>Find First Timer
                        </div>
                        <small class="text-muted">
                            Use any available detail to locate the guest’s first visit record.
                        </small>
                    </div>

                    @if (!IsFIGDirectorateMember())
                    {
                        <span class="bcc-status bcc-status-warning">Nominated Record Keeper</span>
                    }
                    else
                    {
                        <span class="bcc-status bcc-status-success">FIG Leader</span>
                    }
                </div>

                <div class="bcc-card-body">
                    <div class="guest-auth-card @(IsFIGDirectorateMember() ? "approved" : "neutral") mb-4">
                        <i class="fas @(IsFIGDirectorateMember() ? "fa-user-tie" : "fa-user-check")"></i>
                        <div>
                            @if (IsFIGDirectorateMember())
                            {
                                <strong>FIG Directorate Authorization</strong>
                                <span>You are authorized to record second visits for all services.</span>
                            }
                            else
                            {
                                <strong>Nominated Record Keeper</strong>
                                <span>You are authorized to record second visits only for your nominated services.</span>
                            }
                        </div>
                    </div>

                    <div class="guest-form-section">
                        <div class="guest-form-section-header blue">
                            <i class="fas fa-filter"></i>
                            <span>Search Criteria</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="bcc-form-field">
                                    <label class="bcc-form-label">Search by Name</label>
                                    <input type="text" class="form-control bcc-input" @bind="searchName"
                                           placeholder="First name, middle name or surname" />
                                    <span class="bcc-form-current">Searches first name, middle name and surname.</span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="bcc-form-field">
                                    <label class="bcc-form-label">Guest Number</label>
                                    <input type="text" class="form-control bcc-input" @bind="searchGuestNumber"
                                           placeholder="e.g. 151223/1" />
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="bcc-form-field">
                                    <label class="bcc-form-label">Date of First Visit</label>
                                    <input type="date" class="form-control bcc-input" @bind="searchDate"
                                           @bind:format="yyyy-MM-dd"
                                           max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="bcc-form-field">
                                    <label class="bcc-form-label">Year of First Visit</label>
                                    <select class="form-select bcc-input" @bind="searchYear">
                                        <option value="">Select Year</option>
                                        @for (int year = DateTime.Now.Year; year >= 2020; year--)
                                        {
                                            <option value="@year">@year</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="bcc-form-field">
                                    <label class="bcc-form-label">Month of First Visit</label>
                                    <select class="form-select bcc-input" @bind="searchMonth">
                                        <option value="">Select Month</option>
                                        <option value="1">January</option>
                                        <option value="2">February</option>
                                        <option value="3">March</option>
                                        <option value="4">April</option>
                                        <option value="5">May</option>
                                        <option value="6">June</option>
                                        <option value="7">July</option>
                                        <option value="8">August</option>
                                        <option value="9">September</option>
                                        <option value="10">October</option>
                                        <option value="11">November</option>
                                        <option value="12">December</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-4 d-flex align-items-end">
                                <div class="guest-search-actions w-100">
                                    <button class="bcc-btn guest-secondary-btn" @onclick="ResetSearch">
                                        <i class="fas fa-redo me-1"></i>Reset
                                    </button>

                                    <button class="bcc-btn bcc-btn-primary" @onclick="() => SearchGuests()" disabled="@isSearching">
                                        @if (isSearching)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-search me-1"></i>
                                        }
                                        Search
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (searchResults.Any())
                    {
                        <div class="guest-results-section">
                            <div class="guest-results-title">
                                <div>
                                    <h5><i class="fas fa-list me-2"></i>Search Results</h5>
                                    <p>@searchResults.Count first timer record(s) found.</p>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover mb-0 bcc-table">
                                    <thead>
                                        <tr>
                                            <th>Guest</th>
                                            <th>First Visit</th>
                                            <th>Service</th>
                                            <th>Contact</th>
                                            <th class="text-center">Actions</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var guest in searchResults)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center gap-3">
                                                        <div class="guest-avatar">
                                                            @GetGuestInitials(guest)
                                                        </div>

                                                        <div>
                                                            <div class="fw-bold text-dark">@guest.Title @guest.FirstName @guest.Surname</div>
                                                            <small class="text-muted">@guest.GuestNumber • @guest.Sex • @guest.AgeGroup</small>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td>
                                                    <span class="fw-bold text-dark">@guest.VisitingDate.ToString("dd-MMM-yyyy")</span>
                                                </td>

                                                <td>
                                                    <span class="fw-bold text-dark">@guest.Service?.Name</span>
                                                </td>

                                                <td>
                                                    @if (!string.IsNullOrEmpty(guest.PhoneNumber))
                                                    {
                                                        <div class="guest-contact-line">
                                                            <i class="fas fa-phone"></i>@guest.PhoneNumber
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Not provided</span>
                                                    }
                                                </td>

                                                <td class="text-center">
                                                    <div class="guest-row-actions">
                                                        <button class="team-action-btn" @onclick="() => ViewGuestDetails(guest.Id)">
                                                            <i class="fas fa-eye me-1"></i>View
                                                        </button>

                                                        <button class="team-success-btn"
                                                                @onclick="() => MarkAsSecondTimer(guest.Id)"
                                                                disabled="@(!CanRecordForService(guest.ServiceId))">
                                                            <i class="fas fa-user-check me-1"></i>Second Visit

                                                            @if (!CanRecordForService(guest.ServiceId) && !IsFIGDirectorateMember())
                                                            {
                                                                <span class="badge bg-warning ms-1">Not Nominated</span>
                                                            }
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else if (hasSearched)
                    {
                        <div class="guest-mini-empty mt-4">
                            <i class="fas fa-search"></i>
                            <h6>No first timers found</h6>
                            <p>Try changing the name, date, guest number, month or year.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (selectedGuest != null && showDetailsModal)
        {
            <div class="team-modal-backdrop">
                <div class="guest-secondtimer-workspace-modal">

                    <div class="workspace-modal-topbar">
                        <div>
                            <h5><i class="fas fa-user-circle me-2"></i>Guest Confirmation</h5>
                            <small>@selectedGuest.GuestNumber • @selectedGuest.Title @selectedGuest.FirstName @selectedGuest.Surname</small>
                        </div>

                        <div class="workspace-modal-actions">
                            <button type="button" class="bcc-btn guest-secondary-btn" @onclick="CloseDetailsModal">
                                Close
                            </button>

                            <button type="button"
                                    class="bcc-btn bcc-btn-primary"
                                    @onclick="() => MarkAsSecondTimer(selectedGuest.Id)"
                                    disabled="@(!CanRecordForService(selectedGuest.ServiceId))">
                                <i class="fas fa-user-check me-1"></i>Record Visit
                            </button>
                        </div>
                    </div>

                    <div class="workspace-guest-summary">
                        <div>
                            <span>Guest</span>
                            <strong>@selectedGuest.Title @selectedGuest.FirstName @selectedGuest.Surname</strong>
                        </div>

                        <div>
                            <span>Guest No</span>
                            <strong>@selectedGuest.GuestNumber</strong>
                        </div>

                        <div>
                            <span>Phone</span>
                            <strong>@DisplayText(selectedGuest.PhoneNumber)</strong>
                        </div>

                        <div>
                            <span>First Visit</span>
                            <strong>@selectedGuest.VisitingDate.ToString("dd-MMM-yyyy")</strong>
                        </div>

                        <div>
                            <span>Service</span>
                            <strong>@DisplayText(selectedGuest.Service?.Name)</strong>
                        </div>

                        <div>
                            <span>Sex / Age</span>
                            <strong>@selectedGuest.Sex / @selectedGuest.AgeGroup</strong>
                        </div>
                    </div>

                    @if (!CanRecordForService(selectedGuest.ServiceId))
                    {
                        <div class="alert alert-danger mb-0">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            You are not nominated to record second visits for @selectedGuest.Service?.Name.
                        </div>
                    }
                </div>
            </div>
        }

        @if (selectedGuest != null && showSecondTimerModal)
        {
            <div class="team-modal-backdrop">
                <div class="guest-secondtimer-workspace-modal">

                    <div class="workspace-modal-topbar">
                        <div>
                            <h5>
                                <i class="fas fa-user-check me-2"></i>Record Second Visit
                            </h5>
                            <small>
                                @selectedGuest.GuestNumber • @selectedGuest.Title @selectedGuest.FirstName @selectedGuest.Surname
                            </small>
                        </div>

                        <div class="workspace-modal-actions">
                            <button type="button" class="bcc-btn guest-secondary-btn" @onclick="CloseSecondTimerModal">
                                Cancel
                            </button>

                            <button type="button"
                                    class="bcc-btn bcc-btn-primary"
                                    @onclick="SubmitSecondTimer"
                                    disabled="@(!CanRecordForService(selectedGuest.ServiceId) || isSubmitting)">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                <span>Record Visit</span>
                            </button>
                        </div>
                    </div>

                    <div class="workspace-guest-summary">
                        <div>
                            <span>Guest</span>
                            <strong>@selectedGuest.Title @selectedGuest.FirstName @selectedGuest.Surname</strong>
                        </div>

                        <div>
                            <span>Phone</span>
                            <strong>@DisplayText(selectedGuest.PhoneNumber)</strong>
                        </div>

                        <div>
                            <span>First Visit</span>
                            <strong>@selectedGuest.VisitingDate.ToString("dd-MMM-yyyy")</strong>
                        </div>

                        <div>
                            <span>Service</span>
                            <strong>@DisplayText(selectedGuest.Service?.Name)</strong>
                        </div>
                    </div>

                    @if (!CanRecordForService(selectedGuest.ServiceId))
                    {
                        <div class="alert alert-danger mb-0">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            You are not nominated to record second visits for @selectedGuest.Service?.Name.
                        </div>
                    }
                    else
                    {
                        <div class="workspace-secondtimer-grid">

                            <div class="workspace-field">
                                <label>Phone Number</label>
                                <input type="tel" class="form-control bcc-input"
                                       @bind="secondTimerModel.CurrentPhoneNumber" />
                            </div>

                            <div class="workspace-field">
                                <label>Birth Month *</label>
                                <select class="form-select bcc-input" @bind="secondTimerModel.BirthMonth">
                                    <option value="">Select Month</option>
                                    <option value="January">January</option>
                                    <option value="February">February</option>
                                    <option value="March">March</option>
                                    <option value="April">April</option>
                                    <option value="May">May</option>
                                    <option value="June">June</option>
                                    <option value="July">July</option>
                                    <option value="August">August</option>
                                    <option value="September">September</option>
                                    <option value="October">October</option>
                                    <option value="November">November</option>
                                    <option value="December">December</option>
                                </select>
                                <span class="text-danger small">@GetSecondTimerValidationMessage(nameof(secondTimerModel.BirthMonth))</span>
                            </div>

                            <div class="workspace-question">
                                <label>Become BCC Member? *</label>
                                <div class="workspace-radio-row">
                                    <label><input type="radio" name="wantsMember" checked="@(secondTimerModel.WantsToBecomeMember == true)" @onchange="() => secondTimerModel.WantsToBecomeMember = true" /> Yes</label>
                                    <label><input type="radio" name="wantsMember" checked="@(secondTimerModel.WantsToBecomeMember == false)" @onchange="() => secondTimerModel.WantsToBecomeMember = false" /> No</label>
                                </div>
                                <span class="text-danger small">@GetSecondTimerValidationMessage(nameof(secondTimerModel.WantsToBecomeMember))</span>
                            </div>

                            <div class="workspace-question">
                                <label>Baptised by Water? *</label>
                                <div class="workspace-radio-row">
                                    <label><input type="radio" name="baptised" checked="@(secondTimerModel.IsBaptisedByWater == true)" @onchange="() => secondTimerModel.IsBaptisedByWater = true" /> Yes</label>
                                    <label><input type="radio" name="baptised" checked="@(secondTimerModel.IsBaptisedByWater == false)" @onchange="() => secondTimerModel.IsBaptisedByWater = false" /> No</label>
                                </div>
                                <span class="text-danger small">@GetSecondTimerValidationMessage(nameof(secondTimerModel.IsBaptisedByWater))</span>
                            </div>

                            <div class="workspace-question full">
                                <label>Join BCC Workforce? *</label>
                                <div class="workspace-radio-row">
                                    <label><input type="radio" name="joinWorkforce" checked="@(secondTimerModel.WantsToJoinWorkforce == true)" @onchange="() => secondTimerModel.WantsToJoinWorkforce = true" /> Yes</label>
                                    <label><input type="radio" name="joinWorkforce" checked="@(secondTimerModel.WantsToJoinWorkforce == false)" @onchange="() => secondTimerModel.WantsToJoinWorkforce = false" /> No</label>
                                </div>
                                <span class="text-danger small">@GetSecondTimerValidationMessage(nameof(secondTimerModel.WantsToJoinWorkforce))</span>
                            </div>

                        </div>
                    }
                </div>
            </div>
        }
    }
}
else
{
    <div class="guest-secondtimer-v2-page">
        <div class="bcc-empty">
            <i class="fas fa-exclamation-triangle"></i>
            <h4>Please Log In</h4>
            <p>You need to be logged in to access this page.</p>
            <a href="/login" class="bcc-btn bcc-btn-primary text-decoration-none">Go to Login</a>
        </div>
    </div>
}

@code {
    private List<Guest> searchResults = new();
    private Guest selectedGuest = null;
    private UpdateSecondTimerModel secondTimerModel = new();

    private string searchName = "";
    private DateTime? searchDate = null;
    private string searchGuestNumber = "";
    private int? searchYear = null;
    private int? searchMonth = null;

    private bool isLoading = true;
    private bool isSearching = false;
    private bool isSubmitting = false;
    private bool hasSearched = false;
    private bool showDetailsModal = false;
    private bool showSecondTimerModal = false;
    private bool showNotNominatedModal = false;
    private bool isUserNominated = false;
    private bool hasNominatedServiceToday = false;

    private Dictionary<int, bool> serviceAuthorizationCache = new();
    private List<RecordNominationDTO> userNominations = new();

    private string errorMessage = "";
    private string successMessage = "";
    private Dictionary<string, List<string>> secondTimerValidationErrors = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
            return;

        var isFIGDirectorateMember = IsFIGDirectorateMember();

        if (!isFIGDirectorateMember)
        {
            isUserNominated = await CheckUserNominationStatus();

            if (!isUserNominated)
            {
                showNotNominatedModal = true;
            }
            else
            {
                await LoadUserNominations();
            }
        }
        else
        {
            isUserNominated = true;
            hasNominatedServiceToday = true;
        }

        isLoading = false;
        StateHasChanged();
    }

    private async Task<bool> CheckUserNominationStatus()
    {
        try
        {
            var currentWorker = AuthService.CurrentWorker;
            if (currentWorker == null) return false;

            var today = DateTime.Today;
            var nominations = await RecordNominationService.GetNominationsForUserAsync(currentWorker.WorkerId, today);

            var guestRecordNominations = nominations.Where(n => n.RecordType == "Guest Record").ToList();

            hasNominatedServiceToday = guestRecordNominations.Any();

            return hasNominatedServiceToday;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking nomination status: {ex.Message}");
            return false;
        }
    }

    private async Task LoadUserNominations()
    {
        try
        {
            var currentWorker = AuthService.CurrentWorker;
            if (currentWorker == null) return;

            var today = DateTime.Today;
            var nominations = await RecordNominationService.GetNominationsForUserAsync(currentWorker.WorkerId, today);

            userNominations = nominations.Where(n => n.RecordType == "Guest Record").ToList();

            foreach (var nomination in userNominations)
            {
                if (nomination.ServiceId > 0)
                {
                    serviceAuthorizationCache[nomination.ServiceId] = true;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user nominations: {ex.Message}");
        }
    }

    private bool CanRecordForService(int? serviceId)
    {
        if (!serviceId.HasValue) return false;

        if (IsFIGDirectorateMember()) return true;

        if (serviceAuthorizationCache.ContainsKey(serviceId.Value))
        {
            return serviceAuthorizationCache[serviceId.Value];
        }

        var isNominated = userNominations.Any(n => n.ServiceId == serviceId.Value);
        serviceAuthorizationCache[serviceId.Value] = isNominated;

        return isNominated;
    }

    private bool IsFIGDirectorateMember()
    {
        var worker = AuthService.CurrentWorker;
        if (worker == null) return false;

        var directorateName = worker.Directorate?.Name?.ToLowerInvariant() ?? "";
        var departmentName = worker.Department?.Name?.ToLowerInvariant() ?? "";
        var role = worker.Role?.ToLowerInvariant() ?? "";

        var isInFIG = directorateName.Contains("fig");

        var hasValidRole = role.Contains("head of directorate") ||
                           role.Contains("asst head of directorate") ||
                           role.Contains("directorate member") ||
                           (role.Contains("head of department") && departmentName.Contains("membership assimilation")) ||
                           AuthService.IsInRole("Church Admin") ||
                           AuthService.IsInRole("Pastor in Charge");

        return isInFIG && hasValidRole;
    }

    private async Task SearchGuests()
    {
        isSearching = true;
        errorMessage = "";
        hasSearched = true;

        try
        {
            searchResults = await GuestService.SearchFirstTimersAsync(
                searchDate,
                searchGuestNumber,
                searchYear,
                searchMonth,
                searchName
            );
        }
        catch (Exception ex)
        {
            errorMessage = $"Error searching guests: {ex.Message}";
        }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

    private async Task ViewGuestDetails(int guestId)
    {
        try
        {
            selectedGuest = await GuestService.GetGuestByIdAsync(guestId);

            if (selectedGuest != null)
            {
                showDetailsModal = true;
            }
            else
            {
                errorMessage = "Guest not found";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading guest details: {ex.Message}";
        }
    }

    private async Task MarkAsSecondTimer(int guestId)
    {
        try
        {
            selectedGuest = await GuestService.GetGuestByIdAsync(guestId);

            if (selectedGuest != null)
            {
                if (selectedGuest.IsSecondTimer)
                {
                    errorMessage = $"Guest {selectedGuest.GuestNumber} is already marked as second timer";
                    return;
                }

                if (!CanRecordForService(selectedGuest.ServiceId))
                {
                    errorMessage = $"You are not authorized to record second visits for {selectedGuest.Service?.Name} service";
                    return;
                }

                secondTimerModel = new UpdateSecondTimerModel
                {
                    GuestId = guestId,
                    CurrentPhoneNumber = selectedGuest.PhoneNumber
                };

                showDetailsModal = false;
                showSecondTimerModal = true;
                secondTimerValidationErrors.Clear();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task SubmitSecondTimer()
    {
        if (selectedGuest == null) return;

        if (!CanRecordForService(selectedGuest.ServiceId))
        {
            errorMessage = "You are not authorized to record second visits for this service.";
            return;
        }

        secondTimerValidationErrors.Clear();

        if (!ValidateSecondTimerForm())
        {
            return;
        }

        isSubmitting = true;
        errorMessage = "";

        try
        {
            var currentWorker = AuthService.CurrentWorker;
            var updatedGuest = await GuestService.UpdateSecondTimerAsync(secondTimerModel, currentWorker);

            successMessage = $"Second visit recorded successfully for {updatedGuest.Title} {updatedGuest.FirstName} {updatedGuest.Surname}";

            await SearchGuests();

            CloseSecondTimerModal();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error recording second visit: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool ValidateSecondTimerForm()
    {
        secondTimerValidationErrors.Clear();

        if (string.IsNullOrWhiteSpace(secondTimerModel.BirthMonth))
            AddSecondTimerValidationError(nameof(secondTimerModel.BirthMonth), "Birth month is required");

        if (!secondTimerModel.WantsToBecomeMember.HasValue)
            AddSecondTimerValidationError(nameof(secondTimerModel.WantsToBecomeMember), "Please specify if the guest wants to become a member");

        if (!secondTimerModel.IsBaptisedByWater.HasValue)
            AddSecondTimerValidationError(nameof(secondTimerModel.IsBaptisedByWater), "Please specify if the guest has been baptised by water");

        if (!secondTimerModel.WantsToJoinWorkforce.HasValue)
            AddSecondTimerValidationError(nameof(secondTimerModel.WantsToJoinWorkforce), "Please specify if the guest wants to join the workforce");

        return !secondTimerValidationErrors.Any();
    }

    private void AddSecondTimerValidationError(string propertyName, string message)
    {
        if (!secondTimerValidationErrors.ContainsKey(propertyName))
            secondTimerValidationErrors[propertyName] = new List<string>();

        secondTimerValidationErrors[propertyName].Add(message);
    }

    private string GetSecondTimerValidationMessage(string propertyName)
    {
        if (secondTimerValidationErrors.ContainsKey(propertyName))
        {
            return string.Join("; ", secondTimerValidationErrors[propertyName]);
        }

        return "";
    }

    private void ResetSearch()
    {
        searchName = "";
        searchDate = null;
        searchGuestNumber = "";
        searchYear = null;
        searchMonth = null;
        searchResults.Clear();
        hasSearched = false;
        errorMessage = "";
        successMessage = "";
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedGuest = null;
        StateHasChanged();
    }

    private void CloseSecondTimerModal()
    {
        showSecondTimerModal = false;
        selectedGuest = null;
        secondTimerModel = new UpdateSecondTimerModel();
        secondTimerValidationErrors.Clear();
        StateHasChanged();
    }

    private void ClearSuccessMessage()
    {
        successMessage = "";
        StateHasChanged();
    }

    private void ClearErrorMessage()
    {
        errorMessage = "";
        StateHasChanged();
    }

    private void GoToGuestManagement()
    {
        Navigation.NavigateTo("/guest");
    }

    private string GetGuestInitials(Guest guest)
    {
        var first = !string.IsNullOrWhiteSpace(guest.FirstName) ? guest.FirstName.Substring(0, 1).ToUpper() : "";
        var last = !string.IsNullOrWhiteSpace(guest.Surname) ? guest.Surname.Substring(0, 1).ToUpper() : "";

        var initials = $"{first}{last}";

        return string.IsNullOrWhiteSpace(initials) ? "G" : initials;
    }

    private string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not provided" : value;
    }
}