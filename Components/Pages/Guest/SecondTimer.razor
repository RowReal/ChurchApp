@page "/guest/second-timer"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services

@inject GuestService GuestService
@inject ServiceRecordAccessService ServiceRecordAccessService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Second Timer - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to record second visits.</p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else if (isLoading)
{
    <div class="worker360-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-4">
                <div class="spinner-border text-primary"></div>
                <div class="mt-2 text-muted">
                    Loading second timer workspace...
                </div>
            </div>
        </div>
    </div>
}
else if (!canAccessGuestManagement)
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>

        <p>
            You must have the Guest Management privilege and either belong
            to the FIG Directorate, have FIG as your secondary department,
            or hold an authorised leadership role.
        </p>

        <button type="button"
                class="bcc-btn bcc-btn-primary"
                @onclick="GoBack">
            Return to Guest Management
        </button>
    </div>
}
else
{
    <div class="worker360-page second-timer-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success py-2">
                <i class="fas fa-check-circle me-2"></i>
                @successMessage
            </div>
        }

        <div class="bcc-page-header second-timer-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-user-check me-2"></i>
                    Guest Management
                </div>

                <div class="bcc-page-title">
                    Second Timer
                </div>

                <div class="bcc-page-subtitle">
                    Find a first-time guest and record a second visit.
                </div>
            </div>

            <button type="button"
                    class="bcc-btn profile-form-secondary-btn compact-btn"
                    @onclick="GoBack">
                <i class="fas fa-arrow-left me-2"></i>
                Back
            </button>
        </div>

        <div class="row g-3">

            <div class="col-12 col-xl-4">
                <div class="bcc-card h-100">
                    <div class="bcc-card-body p-3">

                        <div class="compact-section-heading">
                            <div>
                                <h6>
                                    <i class="fas fa-search me-2"></i>
                                    Search First Timer
                                </h6>

                                <p>
                                    Use any available detail to locate the guest.
                                </p>
                            </div>
                        </div>

                        <div class="row g-2">

                            <div class="col-12">
                                <label class="form-label compact-label">
                                    Guest Name
                                </label>

                                <InputText class="form-control form-control-sm"
                                           @bind-Value="searchName"
                                           placeholder="First, middle or surname" />
                            </div>

                            <div class="col-12">
                                <label class="form-label compact-label">
                                    Guest Number
                                </label>

                                <InputText class="form-control form-control-sm"
                                           @bind-Value="searchGuestNumber"
                                           placeholder="e.g. 151223/1" />
                            </div>

                            <div class="col-12">
                                <label class="form-label compact-label">
                                    Date of First Visit
                                </label>

                                <InputDate class="form-control form-control-sm"
                                           @bind-Value="searchDate" />
                            </div>

                            <div class="col-6">
                                <label class="form-label compact-label">
                                    Year
                                </label>

                                <select class="form-select form-select-sm"
                                        @bind="searchYear">
                                    <option value="">Select Year</option>

                                    @for (int year = DateTime.Now.Year;
                                                                    year >= 2020;
                                                                    year--)
                                    {
                                        <option value="@year">@year</option>
                                    }
                                </select>
                            </div>

                            <div class="col-6">
                                <label class="form-label compact-label">
                                    Month
                                </label>

                                <select class="form-select form-select-sm"
                                        @bind="searchMonth">
                                    <option value="">Select Month</option>
                                    <option value="1">January</option>
                                    <option value="2">February</option>
                                    <option value="3">March</option>
                                    <option value="4">April</option>
                                    <option value="5">May</option>
                                    <option value="6">June</option>
                                    <option value="7">July</option>
                                    <option value="8">August</option>
                                    <option value="9">September</option>
                                    <option value="10">October</option>
                                    <option value="11">November</option>
                                    <option value="12">December</option>
                                </select>
                            </div>

                        </div>

                        <div class="mt-3 d-flex justify-content-end gap-2">
                            <button type="button"
                                    class="bcc-btn profile-form-secondary-btn compact-btn"
                                    disabled="@isSearching"
                                    @onclick="ResetSearch">
                                Reset
                            </button>

                            <button type="button"
                                    class="bcc-btn bcc-btn-primary compact-btn"
                                    disabled="@isSearching"
                                    @onclick="SearchGuests">

                                @if (isSearching)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Searching...</span>
                                }
                                else
                                {
                                    <i class="fas fa-search me-2"></i>
                                    <span>Search</span>
                                }

                            </button>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-8">
                <div class="bcc-card">
                    <div class="bcc-card-body p-3">

                        <div class="result-heading">
                            <div>
                                <h6>Search Results</h6>
                                <p>@searchResults.Count record(s)</p>
                            </div>
                        </div>

                        @if (!hasSearched)
                        {
                            <div class="bcc-empty py-4">
                                <i class="fas fa-search"></i>
                                <h4>Ready to Search</h4>
                                <p>Enter any available guest detail on the left.</p>
                            </div>
                        }
                        else if (!searchResults.Any())
                        {
                            <div class="bcc-empty py-4">
                                <i class="fas fa-user-slash"></i>
                                <h4>No Guest Found</h4>
                                <p>Try changing the search criteria.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0 second-timer-table">
                                    <thead>
                                        <tr>
                                            <th>Guest</th>
                                            <th>Guest No.</th>
                                            <th>First Visit</th>
                                            <th>Service</th>
                                            <th>Phone</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var guest in searchResults)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="guest-name-cell">
                                                        <div class="guest-avatar">
                                                            @GetGuestInitials(guest)
                                                        </div>

                                                        <div>
                                                            <strong>
                                                                @guest.Title @guest.FirstName @guest.Surname
                                                            </strong>

                                                            <span>
                                                                @guest.Sex
                                                                @if (!string.IsNullOrWhiteSpace(guest.AgeGroup))
                                                                {
                                                                    <text> · @guest.AgeGroup</text>
                                                                }
                                                        </span>
                                                    </div>
                                                </div>
                                            </td>

                                            <td>@guest.GuestNumber</td>

                                            <td>
                                                @(guest.VisitingDate
                                                                                        .ToString("dd MMM yyyy"))
                                                                                                             </td>

                                            <td>
                                                @(guest.Service?.Name
                                                                                        ?? "Not available")
                                                                                                       </td>

                                            <td>
                                                @(string.IsNullOrWhiteSpace(guest.PhoneNumber)
                                                                                        ? "—"
                                                                                        : guest.PhoneNumber)
                                    </td>

                                                <td class="text-end">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary me-1"
                                                            title="View"
                                                            @onclick="() => OpenDetails(guest)">
                                                        <i class="fas fa-eye"></i>
                                                    </button>

                                                    <button type="button"
                                                            class="btn btn-sm btn-success"
                                                            title="Record Second Visit"
                                                            disabled="@guest.IsSecondTimer"
                                                            @onclick="() => OpenSecondVisit(guest)">
                                                        <i class="fas fa-user-check me-1"></i>
                                                        @(guest.IsSecondTimer ? "Recorded" : "Second Visit")
                                                    </button>
                                                </td>
                                            </tr>
                                                                }
                                    </tbody>
                                </table>
                            </div>
                        }

                    </div>
                </div>
            </div>

        </div>
    </div>
}

@if (showDetailsPopup && selectedGuest != null)
{
    <div class="second-timer-popup-backdrop">
        <div class="second-timer-popup-card">

            <div class="second-timer-popup-header">
                <div>
                    <h4>Guest Details</h4>
                    <p>@selectedGuest.GuestNumber</p>
                </div>

                <button type="button"
                        class="btn-close"
                        @onclick="ClosePopups">
                </button>
            </div>

            <div class="guest-detail-grid">

                <div>
                    <span>Guest</span>
                    <strong>
                        @selectedGuest.Title
                        @selectedGuest.FirstName
                        @selectedGuest.Surname
                    </strong>
                </div>

                <div>
                    <span>Phone</span>
                    <strong>@DisplayText(selectedGuest.PhoneNumber)</strong>
                </div>

                <div>
                    <span>First Visit</span>
                    <strong>
                        @(selectedGuest.VisitingDate
                                            .ToString("dd MMMM yyyy"))
                </strong>
            </div>

                <div>
                    <span>Service</span>
                    <strong>
                        @(selectedGuest.Service?.Name ?? "Not available")
                    </strong>
                </div>

                <div>
                    <span>Sex</span>
                    <strong>@DisplayText(selectedGuest.Sex)</strong>
                </div>

                <div>
                    <span>Age Group</span>
                    <strong>@DisplayText(selectedGuest.AgeGroup)</strong>
                </div>

            </div>

            <div class="mt-3 d-flex justify-content-end gap-2">
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        @onclick="ClosePopups">
                    Close
                </button>

            @if (!selectedGuest.IsSecondTimer)
                {
                    <button type="button"
                            class="bcc-btn bcc-btn-primary compact-btn"
                            @onclick="() => OpenSecondVisit(selectedGuest)">
                        <i class="fas fa-user-check me-2"></i>
                        Record Second Visit
                    </button>
                }
            </div>

        </div>
    </div>
}

@if (showSecondVisitPopup && selectedGuest != null)
{
    <div class="second-timer-popup-backdrop">
        <div class="second-timer-popup-card second-visit-popup">

            <div class="second-timer-popup-header">
                <div>
                    <h4>Record Second Visit</h4>
                    <p>
                        @selectedGuest.GuestNumber ·
                        @selectedGuest.FirstName
                        @selectedGuest.Surname
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        @onclick="ClosePopups">
                </button>
            </div>

            @if (secondTimerValidationErrors.Any())
            {
                <div class="alert alert-warning py-2">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Please complete the required fields.
                </div>
            }

            <div class="row g-2">

                <div class="col-12">
                    <label class="form-label compact-label">
                        Current Phone Number
                    </label>

                    <InputText class="form-control form-control-sm"
                               @bind-Value="secondTimerModel.CurrentPhoneNumber" />
                </div>

                <div class="col-12">
                    <label class="form-label compact-label">
                        Birth Month
                        <span class="text-danger">*</span>
                    </label>

                    <select class="form-select form-select-sm"
                            @bind="secondTimerModel.BirthMonth">
                        <option value="">Select Month</option>
                        <option value="January">January</option>
                        <option value="February">February</option>
                        <option value="March">March</option>
                        <option value="April">April</option>
                        <option value="May">May</option>
                        <option value="June">June</option>
                        <option value="July">July</option>
                        <option value="August">August</option>
                        <option value="September">September</option>
                        <option value="October">October</option>
                        <option value="November">November</option>
                        <option value="December">December</option>
                    </select>

                    <div class="text-danger small">
                        @GetSecondTimerValidationMessage(
                        nameof(secondTimerModel.BirthMonth))
                </div>
            </div>

            <div class="col-12">
                <div class="compact-question">
                    <span>Become BCC Member?</span>

                    <div>
                        <label>
                            <input type="radio"
                                   name="wantsMember"
                                   checked="@(secondTimerModel.WantsToBecomeMember == true)"
                                   @onchange="() => secondTimerModel.WantsToBecomeMember = true" />
                            Yes
                        </label>

                        <label>
                            <input type="radio"
                                   name="wantsMember"
                                   checked="@(secondTimerModel.WantsToBecomeMember == false)"
                                   @onchange="() => secondTimerModel.WantsToBecomeMember = false" />
                            No
                        </label>
                    </div>

                    <small class="text-danger">
                        @GetSecondTimerValidationMessage(
                                                nameof(secondTimerModel.WantsToBecomeMember))
                    </small>
                </div>
            </div>

            <div class="col-12">
                <div class="compact-question">
                    <span>Baptised by Water?</span>

                    <div>
                        <label>
                            <input type="radio"
                                   name="baptised"
                                   checked="@(secondTimerModel.IsBaptisedByWater == true)"
                                   @onchange="() => secondTimerModel.IsBaptisedByWater = true" />
                            Yes
                        </label>

                        <label>
                            <input type="radio"
                                   name="baptised"
                                   checked="@(secondTimerModel.IsBaptisedByWater == false)"
                                   @onchange="() => secondTimerModel.IsBaptisedByWater = false" />
                            No
                        </label>
                    </div>

                    <small class="text-danger">
                        @GetSecondTimerValidationMessage(
                                                nameof(secondTimerModel.IsBaptisedByWater))
                    </small>
                </div>
            </div>

            <div class="col-12">
                <div class="compact-question">
                    <span>Join BCC Workforce?</span>

                    <div>
                        <label>
                            <input type="radio"
                                   name="joinWorkforce"
                                   checked="@(secondTimerModel.WantsToJoinWorkforce == true)"
                                   @onchange="() => secondTimerModel.WantsToJoinWorkforce = true" />
                            Yes
                        </label>

                        <label>
                            <input type="radio"
                                   name="joinWorkforce"
                                   checked="@(secondTimerModel.WantsToJoinWorkforce == false)"
                                   @onchange="() => secondTimerModel.WantsToJoinWorkforce = false" />
                            No
                        </label>
                    </div>

                    <small class="text-danger">
                        @GetSecondTimerValidationMessage(
                                                nameof(secondTimerModel.WantsToJoinWorkforce))
                    </small>
                </div>
            </div>

        </div>

        <div class="mt-3 d-flex justify-content-end gap-2">
            <button type="button"
                    class="bcc-btn profile-form-secondary-btn compact-btn"
                    disabled="@isSubmitting"
                    @onclick="ClosePopups">
                Cancel
            </button>

            <button type="button"
                    class="bcc-btn bcc-btn-primary compact-btn"
                    disabled="@isSubmitting"
                    @onclick="SubmitSecondTimer">

                @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="fas fa-save me-2"></i>
                        <span>Record Visit</span>
                    }

                </button>
            </div>

        </div>
    </div>
}

@code {
    private List<Guest> searchResults = new();
    private Guest? selectedGuest;

    private UpdateSecondTimerModel secondTimerModel =
        new();

    private string searchName = string.Empty;
    private DateTime? searchDate;
    private string searchGuestNumber = string.Empty;
    private int? searchYear;
    private int? searchMonth;

    private bool isLoading = true;
    private bool isSearching;
    private bool isSubmitting;
    private bool hasSearched;
    private bool canAccessGuestManagement;
    private bool showDetailsPopup;
    private bool showSecondVisitPopup;

    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private Dictionary<string, List<string>>
        secondTimerValidationErrors = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var worker = AuthService.CurrentWorker;

            if (worker == null)
            {
                canAccessGuestManagement = false;
                return;
            }

            var access =
                await ServiceRecordAccessService
                    .GetAccessAsync(worker.Id);

            var hasGuestPrivilege =
                access.CanAccessGuestManagement;

            var isFigDirectorate =
                IsFigName(worker.Directorate?.Name);

            var isSecondaryDepartmentFig =
                IsFigName(worker.SecondaryDepartment?.Name);

            var hasAuthorisedRole =
                AuthService.IsInRole("Church Admin") ||
                AuthService.IsInRole("Head of Service") ||
                AuthService.IsInRole("Pastor in Charge");

            canAccessGuestManagement =
                hasGuestPrivilege &&
                (
                    isFigDirectorate ||
                    isSecondaryDepartmentFig ||
                    hasAuthorisedRole
                );
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load second timer workspace: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchGuests()
    {
        try
        {
            isSearching = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;
            hasSearched = true;

            searchResults =
                await GuestService.SearchFirstTimersAsync(
                    searchDate,
                    searchGuestNumber,
                    searchYear,
                    searchMonth,
                    searchName);
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to search guests: {ex.Message}";
        }
        finally
        {
            isSearching = false;
        }
    }

    private void OpenDetails(Guest guest)
    {
        selectedGuest = guest;
        showDetailsPopup = true;
        showSecondVisitPopup = false;
    }

    private void OpenSecondVisit(Guest guest)
    {
        if (guest.IsSecondTimer)
        {
            errorMessage =
                $"{guest.GuestNumber} is already marked as a second timer.";
            return;
        }

        selectedGuest = guest;

        secondTimerModel =
            new UpdateSecondTimerModel
            {
                GuestId = guest.Id,
                CurrentPhoneNumber =
                    guest.PhoneNumber
            };

        secondTimerValidationErrors.Clear();
        showDetailsPopup = false;
        showSecondVisitPopup = true;
    }

    private async Task SubmitSecondTimer()
    {
        if (selectedGuest == null)
            return;

        secondTimerValidationErrors.Clear();

        if (!ValidateSecondTimerForm())
            return;

        try
        {
            isSubmitting = true;
            errorMessage = string.Empty;

            var updatedGuest =
                await GuestService.UpdateSecondTimerAsync(
                    secondTimerModel,
                    AuthService.CurrentWorker);

            successMessage =
                $"Second visit recorded successfully for " +
                $"{updatedGuest.Title} {updatedGuest.FirstName} {updatedGuest.Surname}.";

            ClosePopups();
            await SearchGuests();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to record second visit: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool ValidateSecondTimerForm()
    {
        if (string.IsNullOrWhiteSpace(
            secondTimerModel.BirthMonth))
        {
            AddSecondTimerValidationError(
                nameof(secondTimerModel.BirthMonth),
                "Birth month is required.");
        }

        if (!secondTimerModel
            .WantsToBecomeMember.HasValue)
        {
            AddSecondTimerValidationError(
                nameof(secondTimerModel.WantsToBecomeMember),
                "Please select Yes or No.");
        }

        if (!secondTimerModel
            .IsBaptisedByWater.HasValue)
        {
            AddSecondTimerValidationError(
                nameof(secondTimerModel.IsBaptisedByWater),
                "Please select Yes or No.");
        }

        if (!secondTimerModel
            .WantsToJoinWorkforce.HasValue)
        {
            AddSecondTimerValidationError(
                nameof(secondTimerModel.WantsToJoinWorkforce),
                "Please select Yes or No.");
        }

        return !secondTimerValidationErrors.Any();
    }

    private void AddSecondTimerValidationError(
        string propertyName,
        string message)
    {
        if (!secondTimerValidationErrors
            .ContainsKey(propertyName))
        {
            secondTimerValidationErrors[propertyName] =
                new List<string>();
        }

        secondTimerValidationErrors[propertyName]
            .Add(message);
    }

    private string GetSecondTimerValidationMessage(
        string propertyName)
    {
        return secondTimerValidationErrors
            .TryGetValue(propertyName, out var messages)
                ? string.Join("; ", messages)
                : string.Empty;
    }

    private void ResetSearch()
    {
        searchName = string.Empty;
        searchDate = null;
        searchGuestNumber = string.Empty;
        searchYear = null;
        searchMonth = null;
        searchResults.Clear();
        hasSearched = false;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private void ClosePopups()
    {
        showDetailsPopup = false;
        showSecondVisitPopup = false;
        selectedGuest = null;
        secondTimerModel =
            new UpdateSecondTimerModel();

        secondTimerValidationErrors.Clear();
    }

    private static bool IsFigName(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        return string.Equals(
                   value.Trim(),
                   "FIG",
                   StringComparison.OrdinalIgnoreCase)
               ||
               value.Contains(
                   "FIG",
                   StringComparison.OrdinalIgnoreCase);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/guest");
    }

    private static string GetGuestInitials(
        Guest guest)
    {
        var first =
            !string.IsNullOrWhiteSpace(guest.FirstName)
                ? guest.FirstName[..1].ToUpperInvariant()
                : string.Empty;

        var last =
            !string.IsNullOrWhiteSpace(guest.Surname)
                ? guest.Surname[..1].ToUpperInvariant()
                : string.Empty;

        var initials = $"{first}{last}";

        return string.IsNullOrWhiteSpace(initials)
            ? "G"
            : initials;
    }

    private static string DisplayText(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Not provided"
            : value;
    }
}

<style>
    .second-timer-page {
        max-width: 1500px;
        margin: 0 auto;
    }

    .second-timer-header {
        margin-bottom: 14px;
    }

    .compact-btn {
        min-height: 32px;
        padding: 6px 11px;
        font-size: 0.78rem;
    }

    .compact-section-heading,
    .result-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

        .compact-section-heading h6,
        .result-heading h6 {
            margin: 0 0 2px;
            color: #0f172a;
            font-size: 0.9rem;
            font-weight: 800;
        }

        .compact-section-heading p,
        .result-heading p {
            margin: 0;
            color: #64748b;
            font-size: 0.72rem;
        }

    .compact-label {
        margin-bottom: 3px;
        color: #475569;
        font-size: 0.69rem;
        font-weight: 700;
    }

    .second-timer-page .form-control,
    .second-timer-page .form-select {
        min-height: 32px;
        font-size: 0.78rem;
    }

    .second-timer-table thead th {
        padding: 8px 9px;
        color: #475569;
        background: #f8fafc;
        font-size: 0.63rem;
        font-weight: 800;
        text-transform: uppercase;
