    }

    @@media(max-width:560px) {
        .guest-grid {
            grid-template-columns: 1fr
        }

            .guest-grid .wide {
                grid-column: auto
            }

        .guest-panel {
            padding: 17px
        }

        .guest-banner {
            padding: 22px 18px
        }
    }
</style>

@code {
    private CreateGuestModel model = new() { VisitingDate = DateTime.Today };
    private Service? currentService;
    private bool loading = true, submitting, completed;
    private string error = "", registeredNumber = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentService = await RegistrationAvailability.GetCurrentServiceAsync();
            if (currentService != null)
                model.ServiceId = currentService.Id;
        }
        catch { ShowError("Registration is temporarily unavailable. Please contact the welcome desk."); }
        finally { loading = false; }
    }

    private void ShowError(string message) => error = message;
    private void DismissError() => error = "";
    private void ShowValidationPopup(EditContext _) =>
        ShowError("Please review the form and complete all required fields before submitting.");

    private async Task SubmitAsync()
    {
        if (submitting || completed || currentService is null) return;
        error = "";
        if (model.ServiceId <= 0 || string.IsNullOrWhiteSpace(model.Title) ||
            string.IsNullOrWhiteSpace(model.FirstName) || string.IsNullOrWhiteSpace(model.Surname) ||
            string.IsNullOrWhiteSpace(model.Sex) || model.VisitingDate.Date > DateTime.Today ||
            model.VisitingDate.Date < DateTime.Today.AddDays(-30))
        { ShowError("Please complete all required fields and check your visiting date."); return; }
        try
        {
            submitting = true;
            // Never trust a ServiceId submitted by the browser. Re-evaluate at submission.
            var eligibleService = await RegistrationAvailability.GetCurrentServiceAsync();
            if (eligibleService is null || eligibleService.Id != currentService.Id)
            {
                ShowError("The registration window for this service has closed. Please contact the welcome team.");
                currentService = eligibleService;
                return;
            }
            model.ServiceId = eligibleService.Id;
            var guest = await GuestService.CreateSelfRegisteredGuestAsync(model);
            registeredNumber = guest.GuestNumber;
            completed = true;
        }
        catch (Exception)
        {
            // Do not disclose existing guest details or internal exception messages publicly.
            ShowError("We could not complete your registration. If you have registered before, please speak to the welcome desk.");
        }
        finally { submitting = false; }
    }
}
