@page "/guest/followup-report"
@layout Components.Layout.MainLayout
@using ChurchApp.Models
@using ChurchApp.Services
@inject GuestService GuestService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Guest Follow-up Report - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="guest-report-v2-page">
        <div class="bcc-empty">
            <i class="fas fa-exclamation-triangle"></i>
            <h4>Please Log In</h4>
            <p>You need to be logged in to access Guest Follow-up Report.</p>
            <a href="/login" class="bcc-btn bcc-btn-primary text-decoration-none">
                Go to Login
            </a>
        </div>
    </div>
}
else
{
    <div class="guest-report-v2-page">

        <div class="bcc-page-header">
            <div>
                <div class="guest-page-kicker">
                    <i class="fas fa-chart-line me-2"></i>BCC ServiceHub
                </div>
                <div class="bcc-page-title">Guest Follow-up Report</div>
                <div class="bcc-page-subtitle">
                    Monitor guest follow-up activities, phone call outcomes, visitation needs, and pending contacts.
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button class="bcc-btn guest-light-btn" @onclick="ResetFilters">
                    <i class="fas fa-redo me-1"></i>Reset
                </button>

                <button class="bcc-btn guest-warning-btn" @onclick="SearchReport" disabled="@isSearching">
                    @if (isSearching)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Searching...</span>
                    }
                    else
                    {
                        <i class="fas fa-search me-1"></i>
                        <span>Search Report</span>
                    }
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger profile-v2-alert">
                <i class="fas fa-exclamation-circle me-2"></i>@errorMessage
            </div>
        }

        <div class="bcc-card">
            <div class="bcc-card-header guest-register-header">
                <div>
                    <div class="bcc-card-title">
                        <i class="fas fa-filter me-2 text-primary"></i>Report Filters
                    </div>
                    <small class="text-muted">
                        Filter guest follow-up records by guest profile, visit date, follow-up status, call outcome, or officer.
                    </small>
                </div>

                <button class="bcc-btn guest-secondary-btn" @onclick="ResetFilters">
                    <i class="fas fa-redo me-1"></i>Reset Filters
                </button>
            </div>

            <div class="bcc-card-body">

                <div class="guest-form-section">
                    <div class="guest-form-section-header blue">
                        <i class="fas fa-user"></i>
                        <span>Guest Information</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="bcc-form-field">
                                <label class="bcc-form-label">Guest Name</label>
                                <input class="form-control bcc-input"
                                       @bind="searchName"
                                       placeholder="Search by name" />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="bcc-form-field">
                                <label class="bcc-form-label">Guest Number</label>
                                <input class="form-control bcc-input"
                                       @bind="guestNumber"
                                       placeholder="Guest number" />
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="bcc-form-field">
                                <label class="bcc-form-label">Sex</label>
                                <select class="form-select bcc-input" @bind="sex">
                                    <option value="">All</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="bcc-form-field">
                                <label class="bcc-form-label">Guest Type</label>
                                <select class="form-select bcc-input" @bind="guestType">
                                    <option value="">All Guests</option>
                                    <option value="first">First Timers</option>
                                    <option value="second">Second Timers</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="guest-form-section">
                    <div class="guest-form-section-header green">
                        <i class="fas fa-calendar-check"></i>
                        <span>Visit & Follow-up</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="bcc-form-field">
                                <label class="bcc-form-label">From Visit Date</label>
                                <input type="date" class="form-control bcc-input" @bind="fromVisitDate" />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="bcc-form-field">
                                <label class="bcc-form-label">To Visit Date</label>
                                <input type="date" class="form-control bcc-input" @bind="toVisitDate" />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="bcc-form-field">
                                <label class="bcc-form-label">Follow-up Status</label>
                                <select class="form-select bcc-input" @bind="followupStatus">
                                    <option value="">All</option>
                                    <option value="with">With Follow-up</option>
                                    <option value="without">Not Followed Up</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="bcc-form-field">
                                <label class="bcc-form-label">Needs Visitation</label>
                                <select class="form-select bcc-input" @bind="needsVisitation">
                                    <option value="">All</option>
                                    <option value="yes">Yes Only</option>
                                    <option value="no">No Only</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="guest-form-section mb-0">
                    <div class="guest-form-section-header purple">
                        <i class="fas fa-phone-volume"></i>
                        <span>Call Information</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-5">
                            <div class="bcc-form-field">
                                <label class="bcc-form-label">Call Outcome</label>
                                <select class="form-select bcc-input" @bind="callOutcome">
                                    <option value="">All Outcomes</option>
                                    <option value="Answered - Positive">Answered - Positive</option>
                                    <option value="Answered - Needs Prayer">Answered - Needs Prayer</option>
                                    <option value="Answered - Wants Visit">Answered - Wants Visit</option>
                                    <option value="Answered - Wants Counselling">Answered - Wants Counselling</option>
                                    <option value="Answered - Will Return">Answered - Will Return</option>
                                    <option value="Answered - Not Interested">Answered - Not Interested</option>
                                    <option value="No Answer">No Answer</option>
                                    <option value="Wrong Number">Wrong Number</option>
                                    <option value="Number Switched Off">Number Switched Off</option>
                                    <option value="Call Back Later">Call Back Later</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="bcc-form-field">
                                <label class="bcc-form-label">Called By</label>
                                <input class="form-control bcc-input"
                                       @bind="calledBy"
                                       placeholder="Officer name" />
                            </div>
                        </div>

                        <div class="col-md-3 d-flex align-items-end">
                            <button class="bcc-btn bcc-btn-primary w-100"
                                    @onclick="SearchReport"
                                    disabled="@isSearching">
                                @if (isSearching)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Searching...</span>
                                }
                                else
                                {
                                    <i class="fas fa-search me-1"></i>
                                    <span>Search Report</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        @if (hasSearched)
        {
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="team-summary-card">
                        <span>Total Guests</span>
                        <strong>@reportRows.Count</strong>
                        <i class="fas fa-users"></i>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="team-summary-card active">
                        <span>With Follow-up</span>
                        <strong>@reportRows.Count(x => x.HasFollowUp)</strong>
                        <i class="fas fa-phone-volume"></i>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="team-summary-card inactive">
                        <span>Not Followed Up</span>
                        <strong>@reportRows.Count(x => !x.HasFollowUp)</strong>
                        <i class="fas fa-user-clock"></i>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="team-summary-card directorate">
                        <span>Total Calls</span>
                        <strong>@reportRows.Sum(x => x.TotalCalls)</strong>
                        <i class="fas fa-headset"></i>
                    </div>
                </div>
            </div>
        }

        @if (reportRows.Any())
        {
            <div class="bcc-card">
                <div class="bcc-card-header guest-register-header">
                    <div>
                        <div class="bcc-card-title">
                            <i class="fas fa-table me-2 text-primary"></i>Follow-up Report Results
                        </div>
                        <small class="text-muted">
                            @reportRows.Count guest record(s) matched your search.
                        </small>
                    </div>
                </div>

                <div class="bcc-card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 bcc-table">
                            <thead>
                                <tr>
                                    <th>Guest</th>
                                    <th>First Visit</th>
                                    <th>Sex</th>
                                    <th>Total Calls</th>
                                    <th>Last Call</th>
                                    <th>Last Called By</th>
                                    <th>Last Outcome</th>
                                    <th style="width:160px;">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var row in reportRows)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="guest-avatar">
                                                    @GetGuestInitials(row.Guest)
                                                </div>

                                                <div>
                                                    <div class="fw-bold text-dark">
                                                        @row.Guest.Title @row.Guest.FirstName @row.Guest.Surname
                                                    </div>

                                                    <small class="text-muted">
                                                        @row.Guest.GuestNumber
                                                        @if (row.Guest.IsSecondTimer)
                                                        {
                                                            <span> • Second Timer</span>
                                                        }
                                                        else
                                                        {
                                                            <span> • First Timer</span>
                                                        }
                                                    </small>
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="fw-bold text-dark">
                                                @row.Guest.VisitingDate.ToString("dd-MMM-yyyy")
                                            </span>
                                        </td>

                                        <td>@row.Guest.Sex</td>

                                        <td>
                                            @if (row.TotalCalls > 0)
                                            {
                                                <span class="bcc-status bcc-status-success">
                                                    @row.TotalCalls call(s)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="bcc-status bcc-status-warning">
                                                    0 call
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @(row.LatestFollowUp?.CallDate.ToString("dd-MMM-yyyy") ?? "-")
                                        </td>

                                        <td>
                                            @(row.LatestFollowUp?.CalledByName ?? "-")
                                        </td>

                                        <td>
                                            @if (row.HasFollowUp)
                                            {
                                                <span class="bcc-status bcc-status-success">
                                                    @row.LatestFollowUp?.Outcome
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="bcc-status bcc-status-warning">
                                                    No Follow-up
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @if (row.HasFollowUp)
                                            {
                                                <button class="team-action-btn"
                                                        @onclick="() => ViewGuestHistory(row)">
                                                    <i class="fas fa-history me-1"></i>History
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="team-success-btn"
                                                        @onclick="() => RecordFollowUp(row.Guest.Id)">
                                                    <i class="fas fa-phone me-1"></i>Call
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="guest-table-footer">
                    <small class="text-muted">
                        Showing @reportRows.Count guest record(s)
                    </small>

                    <small class="text-primary fw-bold">
                        <i class="fas fa-chart-line me-1"></i>Follow-up report generated
                    </small>
                </div>
            </div>
        }
        else if (hasSearched)
        {
            <div class="bcc-empty guest-empty-state">
                <i class="fas fa-search"></i>
                <h4>No records found</h4>
                <p>Try changing your search parameters.</p>
            </div>
        }
    </div>
    @if (selectedRow != null && showHistoryModal)
    {
        <div class="team-modal-backdrop">
            <div class="guest-report-modal">
                <button class="team-modal-close" @onclick="CloseHistoryModal">
                    <i class="fas fa-times"></i>
                </button>

                <div class="guest360-header">
                    <div class="guest360-avatar">
                        @GetGuestInitials(selectedRow.Guest)
                    </div>

                    <div>
                        <h4>Phone Follow-up History</h4>
                        <p>
                            @selectedRow.Guest.Title @selectedRow.Guest.FirstName @selectedRow.Guest.Surname
                            • @selectedRow.TotalCalls call(s)
                        </p>

                        @if (selectedRow.Guest.IsSecondTimer)
                        {
                            <span class="bcc-status bcc-status-warning">Second Timer</span>
                        }
                        else
                        {
                            <span class="bcc-status bcc-status-success">First Timer</span>
                        }
                    </div>
                </div>

                <div class="guest-report-mini-profile">
                    <div>
                        <span>Guest No</span>
                        <strong>@selectedRow.Guest.GuestNumber</strong>
                    </div>

                    <div>
                        <span>First Visit</span>
                        <strong>@selectedRow.Guest.VisitingDate.ToString("dd-MMM-yyyy")</strong>
                    </div>

                    <div>
                        <span>Sex</span>
                        <strong>@DisplayText(selectedRow.Guest.Sex)</strong>
                    </div>
                </div>

                <div class="guest360-body">
                    <div class="guest-call-timeline">
                        @foreach (var call in selectedRow.FollowUps.OrderByDescending(x => x.CallDate))
                        {
                            <div class="guest-call-item">
                                <div class="guest-call-dot"></div>

                                <div class="guest-call-card">
                                    <div class="d-flex justify-content-between gap-2 flex-wrap">
                                        <div>
                                            <strong>@call.CallDate.ToString("dd-MMM-yyyy")</strong>
                                            <span>Called by @call.CalledByName</span>
                                        </div>

                                        @if (call.WasCallAnswered)
                                        {
                                            <span class="bcc-status bcc-status-success">Answered</span>
                                        }
                                        else
                                        {
                                            <span class="bcc-status bcc-status-warning">Not Answered</span>
                                        }
                                    </div>

                                    <p>@call.Outcome</p>

                                    <div class="guest-call-footer">
                                        <small>
                                            <i class="fas fa-calendar-check me-1"></i>
                                            Next: @(call.NextFollowUpDate?.ToString("dd-MMM-yyyy") ?? "Not set")
                                        </small>

                                        <button class="team-action-btn"
                                                @onclick="() => ViewCallDetail(call)">
                                            <i class="fas fa-eye me-1"></i>View Detail
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="guest360-actions">
                    <button type="button"
                            class="bcc-btn bcc-btn-primary"
                            @onclick="() => RecordFollowUp(selectedRow.Guest.Id)">
                        <i class="fas fa-phone me-1"></i>Record New Call
                    </button>

                    <button type="button"
                            class="bcc-btn guest-secondary-btn"
                            @onclick="CloseHistoryModal">
                        Close
                    </button>
                </div>
            </div>
        </div>
    }

    @if (selectedFollowUp != null && showDetailModal)
    {
        <div class="team-modal-backdrop">
            <div class="guest-followup-modal">
                <button class="team-modal-close" @onclick="CloseDetailModal">
                    <i class="fas fa-times"></i>
                </button>

                <div class="guest360-header">
                    <div class="guest360-avatar">
                        <i class="fas fa-phone-alt"></i>
                    </div>

                    <div>
                        <h4>Call Detail</h4>
                        <p>@selectedFollowUp.CallDate.ToString("dd-MMM-yyyy")</p>

                        @if (selectedFollowUp.WasCallAnswered)
                        {
                            <span class="bcc-status bcc-status-success">Answered</span>
                        }
                        else
                        {
                            <span class="bcc-status bcc-status-warning">Not Answered</span>
                        }
                    </div>
                </div>

                <div class="guest360-body">
                    <div class="guest-detail-grid">
                        <div class="guest-detail-item">
                            <span>Call Date</span>
                            <strong>@selectedFollowUp.CallDate.ToString("dd-MMM-yyyy")</strong>
                        </div>

                        <div class="guest-detail-item">
                            <span>Called By</span>
                            <strong>@selectedFollowUp.CalledByName</strong>
                        </div>

                        <div class="guest-detail-item">
                            <span>Call Answered</span>
                            <strong>@(selectedFollowUp.WasCallAnswered ? "Yes" : "No")</strong>
                        </div>

                        <div class="guest-detail-item">
                            <span>Duration</span>
                            <strong>@(selectedFollowUp.CallDurationMinutes.HasValue ? $"{selectedFollowUp.CallDurationMinutes} mins" : "-")</strong>
                        </div>

                        <div class="guest-detail-item full">
                            <span>Outcome</span>
                            <strong>@selectedFollowUp.Outcome</strong>
                        </div>

                        <div class="guest-detail-item">
                            <span>Will Guest Return?</span>
                            <strong>@FormatNullableBool(selectedFollowUp.WillGuestReturn)</strong>
                        </div>

                        <div class="guest-detail-item">
                            <span>Needs Visitation?</span>
                            <strong>@FormatNullableBool(selectedFollowUp.NeedsVisitation)</strong>
                        </div>

                        <div class="guest-detail-item">
                            <span>Wants to Meet Pastor?</span>
                            <strong>@FormatNullableBool(selectedFollowUp.WantsToMeetPastor)</strong>
                        </div>

                        <div class="guest-detail-item">
                            <span>Join Department?</span>
                            <strong>@FormatNullableBool(selectedFollowUp.WantsToJoinDepartment)</strong>
                        </div>

                        <div class="guest-detail-item full">
                            <span>Department Interest</span>
                            <strong>@DisplayText(selectedFollowUp.DepartmentInterest)</strong>
                        </div>

                        <div class="guest-detail-item full">
                            <span>Next Follow-up Date</span>
                            <strong>@(selectedFollowUp.NextFollowUpDate?.ToString("dd-MMM-yyyy") ?? "Not set")</strong>
                        </div>
                    </div>

                    <div class="guest-note-section">
                        <h6><i class="fas fa-praying-hands me-1"></i>Prayer Request</h6>
                        <p>@DisplayText(selectedFollowUp.PrayerRequest)</p>
                    </div>

                    <div class="guest-note-section">
                        <h6><i class="fas fa-comment-dots me-1"></i>Guest Feedback</h6>
                        <p>@DisplayText(selectedFollowUp.GuestFeedback)</p>
                    </div>

                    <div class="guest-note-section">
                        <h6><i class="fas fa-sticky-note me-1"></i>Remarks</h6>
                        <p>@DisplayText(selectedFollowUp.Remarks)</p>
                    </div>
                </div>

                <div class="guest360-actions">
                    <button type="button"
                            class="bcc-btn guest-secondary-btn"
                            @onclick="CloseDetailModal">
                        Close
                    </button>
                </div>
            </div>
        </div>
    }

@code {
    private string searchName = "";
    private string guestNumber = "";
    private DateTime? fromVisitDate;
    private DateTime? toVisitDate;
    private string followupStatus = "";
    private string sex = "";
    private string guestType = "";
    private string callOutcome = "";
    private string needsVisitation = "";
    private string calledBy = "";

    private bool isSearching = false;
    private bool hasSearched = false;
    private string errorMessage = "";

    private List<FollowupReportRow> reportRows = new();

    private FollowupReportRow? selectedRow;
    private GuestPhoneFollowUp? selectedFollowUp;

    private bool showHistoryModal = false;
    private bool showDetailModal = false;

    protected override async Task OnInitializedAsync()
    {
        await SearchReport();
    }

    private async Task SearchReport()
    {
        try
        {
            isSearching = true;
            hasSearched = true;
            errorMessage = "";
            reportRows.Clear();

            var guests = await GuestService.GetAllGuestsAsync();

            var query = guests.AsQueryable();

            if (!string.IsNullOrWhiteSpace(searchName))
            {
                var keyword = searchName.Trim();

                query = query.Where(g =>
                    (g.FirstName ?? "").Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                    (g.MiddleName ?? "").Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                    (g.Surname ?? "").Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                    (g.FullName ?? "").Contains(keyword, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(guestNumber))
            {
                var guestNoKeyword = guestNumber.Trim();

                query = query.Where(g =>
                    (g.GuestNumber ?? "").Contains(guestNoKeyword, StringComparison.OrdinalIgnoreCase));
            }

            if (fromVisitDate.HasValue)
                query = query.Where(g => g.VisitingDate.Date >= fromVisitDate.Value.Date);

            if (toVisitDate.HasValue)
                query = query.Where(g => g.VisitingDate.Date <= toVisitDate.Value.Date);

            if (!string.IsNullOrWhiteSpace(sex))
                query = query.Where(g => string.Equals(g.Sex, sex, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(guestType))
            {
                if (guestType == "first")
                    query = query.Where(g => !g.IsSecondTimer);
                else if (guestType == "second")
                    query = query.Where(g => g.IsSecondTimer);
            }

            foreach (var guest in query.OrderByDescending(g => g.VisitingDate).ToList())
            {
                var followUps = await GuestService.GetGuestPhoneFollowUpsAsync(guest.Id);

                var row = new FollowupReportRow
                {
                    Guest = guest,
                    FollowUps = followUps.OrderByDescending(f => f.CallDate).ToList()
                };

                row.LatestFollowUp = row.FollowUps.FirstOrDefault();

                reportRows.Add(row);
            }

            if (followupStatus == "with")
                reportRows = reportRows.Where(r => r.HasFollowUp).ToList();
            else if (followupStatus == "without")
                reportRows = reportRows.Where(r => !r.HasFollowUp).ToList();

            if (!string.IsNullOrWhiteSpace(callOutcome))
            {
                reportRows = reportRows
                    .Where(r => r.FollowUps.Any(f => f.Outcome == callOutcome))
                    .ToList();
            }

            if (!string.IsNullOrWhiteSpace(needsVisitation))
            {
                if (needsVisitation == "yes")
                    reportRows = reportRows.Where(r => r.FollowUps.Any(f => f.NeedsVisitation == true)).ToList();

                if (needsVisitation == "no")
                    reportRows = reportRows.Where(r => r.FollowUps.Any(f => f.NeedsVisitation == false)).ToList();
            }

            if (!string.IsNullOrWhiteSpace(calledBy))
            {
                var calledByKeyword = calledBy.Trim();

                reportRows = reportRows
                    .Where(r => r.FollowUps.Any(f =>
                        (f.CalledByName ?? "").Contains(calledByKeyword, StringComparison.OrdinalIgnoreCase)))
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error loading follow-up report: " + ex.Message;
        }
        finally
        {
            isSearching = false;
        }
    }

    private async Task ResetFilters()
    {
        searchName = "";
        guestNumber = "";
        fromVisitDate = null;
        toVisitDate = null;
        followupStatus = "";
        sex = "";
        guestType = "";
        callOutcome = "";
        needsVisitation = "";
        calledBy = "";

        await SearchReport();
    }

    private void ViewGuestHistory(FollowupReportRow row)
    {
        selectedRow = row;
        selectedFollowUp = null;
        showDetailModal = false;
        showHistoryModal = true;
    }

    private void CloseHistoryModal()
    {
        selectedRow = null;
        selectedFollowUp = null;
        showHistoryModal = false;
        showDetailModal = false;
    }

    private void ViewCallDetail(GuestPhoneFollowUp followUp)
    {
        selectedFollowUp = followUp;
        showDetailModal = true;
    }

    private void CloseDetailModal()
    {
        selectedFollowUp = null;
        showDetailModal = false;
    }

    private void RecordFollowUp(int guestId)
    {
        Navigation.NavigateTo($"/guest/phone-followup?guestId={guestId}");
    }

    private string FormatNullableBool(bool? value)
    {
        return value.HasValue ? (value.Value ? "Yes" : "No") : "Not Sure";
    }

    private string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not provided" : value;
    }

    private string GetGuestInitials(Guest guest)
    {
        var first = !string.IsNullOrWhiteSpace(guest.FirstName)
            ? guest.FirstName.Substring(0, 1).ToUpper()
            : "";

        var last = !string.IsNullOrWhiteSpace(guest.Surname)
            ? guest.Surname.Substring(0, 1).ToUpper()
            : "";

        var initials = $"{first}{last}";

        return string.IsNullOrWhiteSpace(initials) ? "G" : initials;
    }

    private class FollowupReportRow
    {
        public Guest Guest { get; set; } = new();
        public List<GuestPhoneFollowUp> FollowUps { get; set; } = new();
        public GuestPhoneFollowUp? LatestFollowUp { get; set; }
        public bool HasFollowUp => FollowUps.Any();
        public int TotalCalls => FollowUps.Count;
    }
}
