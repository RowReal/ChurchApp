@page "/guest/followup-report"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services

@inject GuestService GuestService
@inject ServiceRecordAccessService ServiceRecordAccessService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Guest Follow-up Report - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access Guest Follow-up Report.</p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else if (isLoading)
{
    <div class="worker360-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-4">
                <div class="spinner-border text-primary"></div>

                <div class="mt-2 text-muted">
                    Loading Guest Follow-up Report...
                </div>
            </div>
        </div>
    </div>
}
else if (!canAccessGuestManagement)
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>

        <p>
            You must have the Guest Management privilege and either belong
            to the FIG Directorate, have FIG as your secondary department,
            or hold an authorised leadership role.
        </p>

        <button type="button"
                class="bcc-btn bcc-btn-primary"
                @onclick="GoBack">
            Return to Guest Management
        </button>
    </div>
}
else
{
    <div class="worker360-page followup-report-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        <div class="bcc-page-header followup-page-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-chart-line me-2"></i>
                    Guest Management
                </div>

                <div class="bcc-page-title">
                    Guest Follow-up Report
                </div>

                <div class="bcc-page-subtitle">
                    Review calls, outcomes, visitation needs and pending follow-ups.
                </div>
            </div>

            <button type="button"
                    class="bcc-btn profile-form-secondary-btn compact-btn"
                    @onclick="GoBack">
                <i class="fas fa-arrow-left me-2"></i>
                Back
            </button>
        </div>

        <div class="followup-summary-strip mb-3">

            <div>
                <span>Total Guests</span>
                <strong>@reportRows.Count</strong>
            </div>

            <div>
                <span>With Follow-up</span>
                <strong>@reportRows.Count(x => x.HasFollowUp)</strong>
            </div>

            <div>
                <span>Not Followed Up</span>
                <strong>@reportRows.Count(x => !x.HasFollowUp)</strong>
            </div>

            <div class="calls">
                <span>Total Calls</span>
                <strong>@reportRows.Sum(x => x.TotalCalls)</strong>
            </div>

        </div>

        <div class="row g-3">

            <div class="col-12 col-xl-4">
                <div class="bcc-card h-100">
                    <div class="bcc-card-body p-3">

                        <div class="compact-section-heading">
                            <div>
                                <h6>
                                    <i class="fas fa-filter me-2"></i>
                                    Report Filters
                                </h6>

                                <p>
                                    Use one or more filters to narrow the report.
                                </p>
                            </div>
                        </div>

                        <div class="filter-group">
                            <div class="filter-group-title">
                                Guest Information
                            </div>

                            <div class="row g-2">

                                <div class="col-12">
                                    <label class="form-label compact-label">
                                        Guest Name
                                    </label>

                                    <input class="form-control form-control-sm"
                                           @bind="searchName"
                                           placeholder="First, middle or surname" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label compact-label">
                                        Guest Number
                                    </label>

                                    <input class="form-control form-control-sm"
                                           @bind="guestNumber"
                                           placeholder="Guest number" />
                                </div>

                                <div class="col-6">
                                    <label class="form-label compact-label">
                                        Sex
                                    </label>

                                    <select class="form-select form-select-sm"
                                            @bind="sex">
                                        <option value="">All</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                </div>

                                <div class="col-6">
                                    <label class="form-label compact-label">
                                        Guest Type
                                    </label>

                                    <select class="form-select form-select-sm"
                                            @bind="guestType">
                                        <option value="">All Guests</option>
                                        <option value="first">First Timers</option>
                                        <option value="second">Second Timers</option>
                                    </select>
                                </div>

                            </div>
                        </div>

                        <div class="filter-group">
                            <div class="filter-group-title">
                                Visit and Follow-up
                            </div>

                            <div class="row g-2">

                                <div class="col-6">
                                    <label class="form-label compact-label">
                                        From Date
                                    </label>

                                    <InputDate class="form-control form-control-sm"
                                               @bind-Value="fromVisitDate" />
                                </div>

                                <div class="col-6">
                                    <label class="form-label compact-label">
                                        To Date
                                    </label>

                                    <InputDate class="form-control form-control-sm"
                                               @bind-Value="toVisitDate" />
                                </div>

                                <div class="col-6">
                                    <label class="form-label compact-label">
                                        Follow-up Status
                                    </label>

                                    <select class="form-select form-select-sm"
                                            @bind="followupStatus">
                                        <option value="">All</option>
                                        <option value="with">With Follow-up</option>
                                        <option value="without">Not Followed Up</option>
                                    </select>
                                </div>

                                <div class="col-6">
                                    <label class="form-label compact-label">
                                        Needs Visitation
                                    </label>

                                    <select class="form-select form-select-sm"
                                            @bind="needsVisitation">
                                        <option value="">All</option>
                                        <option value="yes">Yes Only</option>
                                        <option value="no">No Only</option>
                                    </select>
                                </div>

                            </div>
                        </div>

                        <div class="filter-group mb-0">
                            <div class="filter-group-title">
                                Call Information
                            </div>

                            <div class="row g-2">

                                <div class="col-12">
                                    <label class="form-label compact-label">
                                        Call Outcome
                                    </label>

                                    <select class="form-select form-select-sm"
                                            @bind="callOutcome">
                                        <option value="">All Outcomes</option>
                                        <option value="Answered - Positive">Answered - Positive</option>
                                        <option value="Answered - Needs Prayer">Answered - Needs Prayer</option>
                                        <option value="Answered - Wants Visit">Answered - Wants Visit</option>
                                        <option value="Answered - Wants Counselling">Answered - Wants Counselling</option>
                                        <option value="Answered - Will Return">Answered - Will Return</option>
                                        <option value="Answered - Not Interested">Answered - Not Interested</option>
                                        <option value="No Answer">No Answer</option>
                                        <option value="Wrong Number">Wrong Number</option>
                                        <option value="Number Switched Off">Number Switched Off</option>
                                        <option value="Call Back Later">Call Back Later</option>
                                    </select>
                                </div>

                                <div class="col-12">
                                    <label class="form-label compact-label">
                                        Called By
                                    </label>

                                    <input class="form-control form-control-sm"
                                           @bind="calledBy"
                                           placeholder="Officer name" />
                                </div>

                            </div>
                        </div>

                        <div class="mt-3 d-flex justify-content-end gap-2">
                            <button type="button"
                                    class="bcc-btn profile-form-secondary-btn compact-btn"
                                    disabled="@isSearching"
                                    @onclick="ResetFilters">
                                Reset
                            </button>

                            <button type="button"
                                    class="bcc-btn bcc-btn-primary compact-btn"
                                    disabled="@isSearching"
                                    @onclick="SearchReport">

                                @if (isSearching)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Searching...</span>
                                }
                                else
                                {
                                    <i class="fas fa-search me-2"></i>
                                    <span>Search</span>
                                }

                            </button>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-8">
                <div class="bcc-card">
                    <div class="bcc-card-body p-3">

                        <div class="result-heading">
                            <div>
                                <h6>Follow-up Results</h6>
                                <p>
                                    @if (hasSearched)
                                    {
                                        <span>@reportRows.Count matching guest(s)</span>
                                    }
                                    else
                                    {
                                        <span>No search performed yet</span>
                                    }
                                </p>
                            </div>

                            @if (reportRows.Any())
                            {
                                <span class="result-count-badge">
                                    @reportRows.Count
                                </span>
                            }
                        </div>

                        @if (!reportRows.Any() && hasSearched)
                        {
                            <div class="bcc-empty py-4">
                                <i class="fas fa-search"></i>
                                <h4>No Records Found</h4>
                                <p>Try changing your search parameters.</p>
                            </div>
                        }
                        else if (reportRows.Any())
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0 followup-table">
                                    <thead>
                                        <tr>
                                            <th>Guest</th>
                                            <th>First Visit</th>
                                            <th>Calls</th>
                                            <th>Last Call</th>
                                            <th>Called By</th>
                                            <th>Outcome</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var row in reportRows)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="guest-name-cell">
                                                        <div class="guest-avatar">
                                                            @GetGuestInitials(row.Guest)
                                                        </div>

                                                        <div>
                                                            <strong>
                                                                @row.Guest.Title
                                                                @row.Guest.FirstName
                                                                @row.Guest.Surname
                                                            </strong>

                                                            <span>
                                                                @row.Guest.GuestNumber
                                                                ·
                                                                @(row.Guest.IsSecondTimer
                                                                                                                    ? "Second Timer"
                                                                                                                    : "First Timer")
                                                                                                                                </span>
                                                                                                                            </div>
                                                                                                                        </div>
                                                                                                                    </td>

                                                <td>
                                                    @(row.Guest.VisitingDate
                                                                                            .ToString("dd MMM yyyy"))
                                                                                                                 </td>

                                                <td>
                                                    <span class="call-count-badge
                                                                    @(row.TotalCalls > 0 ? "has-calls" : "")">
                                                        @row.TotalCalls
                                                    </span>
                                                </td>

                                                <td>
                                                    @(row.LatestFollowUp?.CallDate
                                                                                            .ToString("dd MMM yyyy")
                                                                                            ?? "—")
                                                                                               </td>

                                                <td>
                                                    @(row.LatestFollowUp?.CalledByName
                                                                                            ?? "—")
                                    </td>

                                                <td>
                                        @if (row.HasFollowUp)
                                                    {
                                                        <span class="outcome-badge">
                                                            @row.LatestFollowUp?.Outcome
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="no-followup-badge">
                                                            No Follow-up
                                                        </span>
                                                    }
                                                </td>

                                                <td class="text-end">
                                                    @if (row.HasFollowUp)
                                                    {
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-primary"
                                                                @onclick="() => ViewGuestHistory(row)">
                                                            <i class="fas fa-history me-1"></i>
                                                            History
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class="btn btn-sm btn-success"
                                                                @onclick="() => RecordFollowUp(row.Guest.Id)">
                                                            <i class="fas fa-phone me-1"></i>
                                                            Call
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                    </div>
                </div>
            </div>

        </div>
    </div>
}

@if (selectedRow != null && showHistoryModal)
{
    <div class="followup-popup-backdrop">
        <div class="followup-popup-card history-popup">

            <div class="followup-popup-header">
                <div>
                    <h4>Phone Follow-up History</h4>

                    <p>
                        @selectedRow.Guest.Title
                        @selectedRow.Guest.FirstName
                        @selectedRow.Guest.Surname
                        · @selectedRow.TotalCalls call(s)
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        @onclick="CloseHistoryModal">
                </button>
            </div>

            <div class="history-profile-strip">
                <div>
                    <span>Guest No.</span>
                    <strong>@selectedRow.Guest.GuestNumber</strong>
                </div>

                <div>
                    <span>First Visit</span>
                    <strong>
                        @(selectedRow.Guest.VisitingDate
                                            .ToString("dd MMM yyyy"))
                                                                 </strong>
                                                             </div>

                <div>
                    <span>Type</span>
                    <strong>
                        @(selectedRow.Guest.IsSecondTimer
                                            ? "Second Timer"
                                            : "First Timer")
                </strong>
            </div>
        </div>

            <div class="call-history-list">

            @foreach (var call in selectedRow.FollowUps
                        .OrderByDescending(x => x.CallDate))
                {
                    <div class="call-history-item">

                        <div class="call-history-top">
                            <div>
                                <strong>
                                    @(call.CallDate.ToString("dd MMM yyyy"))
                                </strong>

                                <span>
                                    Called by @call.CalledByName
                                </span>
                            </div>

                            <span class="answer-badge
                                        @(call.WasCallAnswered ? "answered" : "not-answered")">
                                @(call.WasCallAnswered ? "Answered" : "Not Answered")
                            </span>
                        </div>

                        <p>@call.Outcome</p>

                        <div class="call-history-footer">
                            <small>
                                Next:
                                @(call.NextFollowUpDate?
                                                        .ToString("dd MMM yyyy")
                                                        ?? "Not set")
                    </small>

                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    @onclick="() => ViewCallDetail(call)">
                                <i class="fas fa-eye me-1"></i>
                                View
                            </button>
                        </div>

                    </div>
                        }

            </div>

            <div class="mt-3 d-flex justify-content-end gap-2">
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        @onclick="CloseHistoryModal">
                    Close
                </button>

                <button type="button"
                        class="bcc-btn bcc-btn-primary compact-btn"
                        @onclick="() => RecordFollowUp(selectedRow.Guest.Id)">
                    <i class="fas fa-phone me-2"></i>
                    Record New Call
                </button>
            </div>

        </div>
    </div>
}

@if (selectedFollowUp != null && showDetailModal)
{
    <div class="followup-popup-backdrop">
        <div class="followup-popup-card detail-popup">

            <div class="followup-popup-header">
                <div>
                    <h4>Call Detail</h4>

                    <p>
                        @(selectedFollowUp.CallDate
                                            .ToString("dd MMM yyyy"))
                                                                 </p>
                                                             </div>

                <button type="button"
                        class="btn-close"
                        @onclick="CloseDetailModal">
                </button>
            </div>

            <div class="call-detail-grid">

                <div>
                    <span>Called By</span>
                    <strong>@selectedFollowUp.CalledByName</strong>
                </div>

                <div>
                    <span>Answered</span>
                    <strong>
                        @(selectedFollowUp.WasCallAnswered ? "Yes" : "No")
                    </strong>
                </div>

                <div>
                    <span>Duration</span>
                    <strong>
                        @(selectedFollowUp.CallDurationMinutes.HasValue
                                            ? $"{selectedFollowUp.CallDurationMinutes} mins"
                                            : "Not provided")
                                                         </strong>
                                                     </div>

                <div>
                    <span>Next Follow-up</span>
                    <strong>
                        @(selectedFollowUp.NextFollowUpDate?
                                            .ToString("dd MMM yyyy")
                                            ?? "Not set")
                </strong>
            </div>

                <div class="detail-wide">
                    <span>Outcome</span>
                    <strong>@DisplayText(selectedFollowUp.Outcome)</strong>
                </div>

                <div>
                    <span>Will Return?</span>
                    <strong>
                        @FormatNullableBool(selectedFollowUp.WillGuestReturn)
                    </strong>
                </div>

                <div>
                    <span>Needs Visitation?</span>
                    <strong>
                        @FormatNullableBool(selectedFollowUp.NeedsVisitation)
                    </strong>
                </div>

                <div>
                    <span>Meet Pastor?</span>
                    <strong>
                        @FormatNullableBool(selectedFollowUp.WantsToMeetPastor)
                    </strong>
                </div>

                <div>
                    <span>Join Department?</span>
                    <strong>
                        @FormatNullableBool(selectedFollowUp.WantsToJoinDepartment)
                    </strong>
                </div>

                <div class="detail-wide">
                    <span>Department Interest</span>
                    <strong>
                        @DisplayText(selectedFollowUp.DepartmentInterest)
                    </strong>
                </div>

                <div class="detail-wide note-detail">
                    <span>Prayer Request</span>
                    <strong>
                        @DisplayText(selectedFollowUp.PrayerRequest)
                    </strong>
                </div>

                <div class="detail-wide note-detail">
                    <span>Guest Feedback</span>
                    <strong>
                        @DisplayText(selectedFollowUp.GuestFeedback)
                    </strong>
                </div>

                <div class="detail-wide note-detail">
                    <span>Remarks</span>
                    <strong>
                        @DisplayText(selectedFollowUp.Remarks)
                    </strong>
                </div>

            </div>

            <div class="mt-3 d-flex justify-content-end">
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        @onclick="CloseDetailModal">
                    Close
                </button>
            </div>

        </div>
    </div>
}

@code {
    private string searchName = string.Empty;
    private string guestNumber = string.Empty;

    private DateTime? fromVisitDate;
    private DateTime? toVisitDate;

    private string followupStatus = string.Empty;
    private string sex = string.Empty;
    private string guestType = string.Empty;
    private string callOutcome = string.Empty;
    private string needsVisitation = string.Empty;
    private string calledBy = string.Empty;

    private bool isLoading = true;
    private bool isSearching;
    private bool hasSearched;
    private bool canAccessGuestManagement;

    private string errorMessage = string.Empty;

    private List<FollowupReportRow> reportRows = new();

    private FollowupReportRow? selectedRow;
    private GuestPhoneFollowUp? selectedFollowUp;

    private bool showHistoryModal;
    private bool showDetailModal;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var worker = AuthService.CurrentWorker;

            if (worker == null)
            {
                canAccessGuestManagement = false;
                return;
            }

            var access =
                await ServiceRecordAccessService
                    .GetAccessAsync(worker.Id);

            var hasGuestPrivilege =
                access.CanAccessGuestManagement;

            var isFigDirectorate =
                IsFigName(worker.Directorate?.Name);

            var isSecondaryDepartmentFig =
                IsFigName(worker.SecondaryDepartment?.Name);

            var hasAuthorisedRole =
                AuthService.IsInRole("Church Admin") ||
                AuthService.IsInRole("Head of Service") ||
                AuthService.IsInRole("Pastor in Charge");

            canAccessGuestManagement =
                hasGuestPrivilege &&
                (
                    isFigDirectorate ||
                    isSecondaryDepartmentFig ||
                    hasAuthorisedRole
                );

            if (!canAccessGuestManagement)
                return;

            await SearchReport();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load Guest Follow-up Report: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchReport()
    {
        try
        {
            isSearching = true;
            hasSearched = true;
            errorMessage = string.Empty;
            reportRows.Clear();

            var guests =
                await GuestService.GetAllGuestsAsync();

            var query = guests.AsQueryable();

            if (!string.IsNullOrWhiteSpace(searchName))
            {
                var keyword = searchName.Trim();

                query = query.Where(g =>
                    (g.FirstName ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase) ||

                    (g.MiddleName ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase) ||

                    (g.Surname ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase) ||

                    (g.FullName ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(guestNumber))
            {
                var keyword = guestNumber.Trim();

                query = query.Where(g =>
                    (g.GuestNumber ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase));
            }

            if (fromVisitDate.HasValue)
            {
                query = query.Where(g =>
                    g.VisitingDate.Date >=
                    fromVisitDate.Value.Date);
            }

            if (toVisitDate.HasValue)
            {
                query = query.Where(g =>
                    g.VisitingDate.Date <=
                    toVisitDate.Value.Date);
            }

            if (!string.IsNullOrWhiteSpace(sex))
            {
                query = query.Where(g =>
                    string.Equals(
                        g.Sex,
                        sex,
                        StringComparison.OrdinalIgnoreCase));
            }

            if (guestType == "first")
            {
                query = query.Where(g =>
                    !g.IsSecondTimer);
            }
            else if (guestType == "second")
            {
                query = query.Where(g =>
                    g.IsSecondTimer);
            }

            foreach (var guest in query
                .OrderByDescending(g => g.VisitingDate)
                .ToList())
            {
                var followUps =
                    await GuestService
                        .GetGuestPhoneFollowUpsAsync(
                            guest.Id);

                var orderedFollowUps =
                    followUps
                        .OrderByDescending(f => f.CallDate)
                        .ToList();

                reportRows.Add(
                    new FollowupReportRow
                    {
                        Guest = guest,
                        FollowUps = orderedFollowUps,
                        LatestFollowUp =
                            orderedFollowUps.FirstOrDefault()
                    });
            }

            if (followupStatus == "with")
            {
                reportRows =
                    reportRows
                        .Where(r => r.HasFollowUp)
                        .ToList();
            }
            else if (followupStatus == "without")
            {
                reportRows =
                    reportRows
                        .Where(r => !r.HasFollowUp)
                        .ToList();
            }

            if (!string.IsNullOrWhiteSpace(callOutcome))
            {
                reportRows =
                    reportRows
                        .Where(r =>
                            r.FollowUps.Any(f =>
                                f.Outcome == callOutcome))
                        .ToList();
            }

            if (needsVisitation == "yes")
            {
                reportRows =
                    reportRows
                        .Where(r =>
                            r.FollowUps.Any(f =>
                                f.NeedsVisitation == true))
                        .ToList();
            }
            else if (needsVisitation == "no")
            {
                reportRows =
                    reportRows
                        .Where(r =>
                            r.FollowUps.Any(f =>
                                f.NeedsVisitation == false))
                        .ToList();
            }

            if (!string.IsNullOrWhiteSpace(calledBy))
            {
                var keyword = calledBy.Trim();

                reportRows =
                    reportRows
                        .Where(r =>
                            r.FollowUps.Any(f =>
                                (f.CalledByName ?? string.Empty)
                                    .Contains(
                                        keyword,
                                        StringComparison.OrdinalIgnoreCase)))
                        .ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Error loading follow-up report: {ex.Message}";
        }
        finally
        {
            isSearching = false;
        }
    }

    private async Task ResetFilters()
    {
        searchName = string.Empty;
        guestNumber = string.Empty;
        fromVisitDate = null;
        toVisitDate = null;
        followupStatus = string.Empty;
        sex = string.Empty;
        guestType = string.Empty;
        callOutcome = string.Empty;
        needsVisitation = string.Empty;
        calledBy = string.Empty;

        await SearchReport();
    }

    private void ViewGuestHistory(
        FollowupReportRow row)
    {
        selectedRow = row;
        selectedFollowUp = null;
        showDetailModal = false;
        showHistoryModal = true;
    }

    private void CloseHistoryModal()
    {
        selectedRow = null;
        selectedFollowUp = null;
        showHistoryModal = false;
        showDetailModal = false;
    }

    private void ViewCallDetail(
        GuestPhoneFollowUp followUp)
    {
        selectedFollowUp = followUp;
        showDetailModal = true;
    }

    private void CloseDetailModal()
    {
        selectedFollowUp = null;
        showDetailModal = false;
    }

    private void RecordFollowUp(
        int guestId)
    {
        Navigation.NavigateTo(
            $"/guest/phone-followup?guestId={guestId}");
    }

    private static bool IsFigName(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        return string.Equals(
                   value.Trim(),
                   "FIG",
                   StringComparison.OrdinalIgnoreCase)
               ||
               value.Contains(
                   "FIG",
                   StringComparison.OrdinalIgnoreCase);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/guest");
    }

    private static string FormatNullableBool(
        bool? value)
    {
        return value.HasValue
            ? (value.Value ? "Yes" : "No")
            : "Not Sure";
    }

    private static string DisplayText(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Not provided"
            : value;
    }

    private static string GetGuestInitials(
        Guest guest)
    {
        var first =
            !string.IsNullOrWhiteSpace(guest.FirstName)
                ? guest.FirstName[..1].ToUpperInvariant()
                : string.Empty;

        var last =
            !string.IsNullOrWhiteSpace(guest.Surname)
                ? guest.Surname[..1].ToUpperInvariant()
                : string.Empty;

        var initials = $"{first}{last}";

        return string.IsNullOrWhiteSpace(initials)
            ? "G"
            : initials;
    }

    private sealed class FollowupReportRow
    {
        public Guest Guest { get; set; } = new();

        public List<GuestPhoneFollowUp> FollowUps
        {
            get;
            set;
        } = new();

        public GuestPhoneFollowUp? LatestFollowUp
        {
            get;
            set;
        }

        public bool HasFollowUp =>
            FollowUps.Any();

        public int TotalCalls =>
            FollowUps.Count;
    }
}

