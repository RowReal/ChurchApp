@page "/guest/phone-followup"
@layout Components.Layout.MainLayout
@using ChurchApp.Models
@using ChurchApp.Services
@inject GuestService GuestService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Phone Follow-up - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="container mt-5">
        <div class="alert alert-warning">Please log in to access this page.</div>
    </div>
}
else if (isLoading)
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-primary"></div>
        <p class="text-muted mt-2">Loading guest details...</p>
    </div>
}
else if (guest == null)
{
    <div class="container mt-5">
        <div class="alert alert-danger">Guest record not found.</div>
        <button class="btn btn-secondary" @onclick="GoBack">Back to Search</button>
    </div>
}
else
{
    <div class="container-fluid py-4">

        <div class="card mb-4">
            <div class="card-header bg-dark-blue text-white">
                <h5 class="mb-0">
                    <i class="fas fa-phone-alt me-2"></i>Guest Phone Follow-up
                </h5>
            </div>

            <div class="card-body">

                <!-- Guest Summary -->
                <div class="alert alert-light border mb-4">
                    <h5 class="mb-1">@guest.Title @guest.FirstName @guest.Surname</h5>
                    <div class="text-muted">
                        Guest No: <strong>@guest.GuestNumber</strong> |
                        Phone: <strong>@guest.PhoneNumber</strong> |
                        Visit Date: <strong>@guest.VisitingDate.ToString("dd-MMM-yyyy")</strong> |
                        Status: <strong>@(guest.IsSecondTimer ? "Second Timer" : "First Timer")</strong>
                    </div>
                </div>

                <!-- Previous Call Records -->
                <div class="card mb-4 border-0 followup-history-card">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">
                            <i class="fas fa-history me-1"></i>
                            Previous Phone Follow-ups
                        </h6>
                    </div>

                    <div class="card-body">
                        @if (previousFollowUps.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Called By</th>
                                            <th>Answered</th>
                                            <th>Outcome</th>
                                            <th>Next Follow-up</th>
                                            <th style="width:120px;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in previousFollowUps)
                                        {
                                            <tr>
                                                <td>@item.CallDate.ToString("dd-MMM-yyyy")</td>
                                                <td>@item.CalledByName</td>
                                                <td>
                                                    @if (item.WasCallAnswered)
                                                    {
                                                        <span class="badge bg-success">Yes</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">No</span>
                                                    }
                                                </td>
                                                <td>@item.Outcome</td>
                                                <td>@(item.NextFollowUpDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            @onclick="() => ViewFollowUpDetails(item)">
                                                        <i class="fas fa-eye me-1"></i>View
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                No phone follow-up has been recorded for this guest yet.
                            </p>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }

                @if (recordSaved)
                {
                    <div class="alert alert-success">
                        <h5 class="mb-2">
                            <i class="fas fa-check-circle me-2"></i>
                            Phone Follow-up Recorded Successfully
                        </h5>

                        <p class="mb-2">
                            The phone conversation for <strong>@guest.FirstName @guest.Surname</strong> has been saved successfully.
                        </p>

                        <div class="small">
                            <div><strong>Call Date:</strong> @followUpModel.CallDate.ToString("dd-MMM-yyyy")</div>
                            <div><strong>Outcome:</strong> @followUpModel.Outcome</div>
                            <div><strong>Next Follow-up:</strong> @(followUpModel.NextFollowUpDate?.ToString("dd-MMM-yyyy") ?? "Not set")</div>
                        </div>

                        <button class="btn btn-primary mt-3" @onclick="GoBack">
                            <i class="fas fa-arrow-left me-1"></i>
                            Return to Guest Search
                        </button>
                    </div>
                }

                <!-- New Call Form -->
                <EditForm Model="@followUpModel" OnValidSubmit="SaveFollowUp">
                    <DataAnnotationsValidator />

                    <fieldset disabled="@recordSaved">

                        <div class="followup-form-card">

                            <div class="section-title">
                                <i class="fas fa-phone-volume me-2"></i>
                                New Phone Call Record
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <label class="form-label">Date of Call</label>
                                    <InputDate class="form-control form-control-lg" @bind-Value="followUpModel.CallDate" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Was Call Answered?</label>
                                    <InputSelect class="form-select form-select-lg" @bind-Value="followUpModel.WasCallAnswered">
                                        <option value="true">Yes, call was answered</option>
                                        <option value="false">No, call was not answered</option>
                                    </InputSelect>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Duration</label>
                                    <div class="input-group input-group-lg">
                                        <InputNumber class="form-control" @bind-Value="followUpModel.CallDurationMinutes" />
                                        <span class="input-group-text">mins</span>
                                    </div>
                                </div>

                                <div class="col-md-8">
                                    <label class="form-label">Call Outcome</label>
                                    <InputSelect class="form-select form-select-lg" @bind-Value="followUpModel.Outcome">
                                        <option value="">Select call outcome</option>
                                        <option value="Answered - Positive">Answered - Positive</option>
                                        <option value="Answered - Needs Prayer">Answered - Needs Prayer</option>
                                        <option value="Answered - Wants Visit">Answered - Wants Visit</option>
                                        <option value="Answered - Wants Counselling">Answered - Wants Counselling</option>
                                        <option value="Answered - Will Return">Answered - Will Return</option>
                                        <option value="Answered - Not Interested">Answered - Not Interested</option>
                                        <option value="No Answer">No Answer</option>
                                        <option value="Wrong Number">Wrong Number</option>
                                        <option value="Number Switched Off">Number Switched Off</option>
                                        <option value="Call Back Later">Call Back Later</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => followUpModel.Outcome)" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Next Follow-up Date</label>
                                    <InputDate class="form-control form-control-lg" @bind-Value="followUpModel.NextFollowUpDate" />
                                </div>
                            </div>

                            <div class="section-title">
                                <i class="fas fa-clipboard-check me-2"></i>
                                Follow-up Response
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-3">
                                    <label class="form-label">Will Guest Return?</label>
                                    <InputSelect class="form-select" @bind-Value="followUpModel.WillGuestReturn">
                                        <option value="">Not Sure</option>
                                        <option value="true">Yes</option>
                                        <option value="false">No</option>
                                    </InputSelect>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Needs Visitation?</label>
                                    <InputSelect class="form-select" @bind-Value="followUpModel.NeedsVisitation">
                                        <option value="">Not Sure</option>
                                        <option value="true">Yes</option>
                                        <option value="false">No</option>
                                    </InputSelect>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Meet Pastor?</label>
                                    <InputSelect class="form-select" @bind-Value="followUpModel.WantsToMeetPastor">
                                        <option value="">Not Sure</option>
                                        <option value="true">Yes</option>
                                        <option value="false">No</option>
                                    </InputSelect>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Join Department?</label>
                                    <InputSelect class="form-select" @bind-Value="followUpModel.WantsToJoinDepartment">
                                        <option value="">Not Sure</option>
                                        <option value="true">Yes</option>
                                        <option value="false">No</option>
                                    </InputSelect>
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label">Department Interest</label>
                                    <InputText class="form-control"
                                               @bind-Value="followUpModel.DepartmentInterest"
                                               placeholder="e.g. Choir, Ushering, Media, Prayer Team" />
                                </div>
                            </div>

                            <div class="section-title">
                                <i class="fas fa-comment-dots me-2"></i>
                                Conversation Notes
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Prayer Request</label>
                                    <InputTextArea class="form-control note-box" rows="4" @bind-Value="followUpModel.PrayerRequest" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Guest Feedback</label>
                                    <InputTextArea class="form-control note-box" rows="4" @bind-Value="followUpModel.GuestFeedback" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Additional Remarks</label>
                                    <InputTextArea class="form-control note-box" rows="3" @bind-Value="followUpModel.Remarks" />
                                </div>
                            </div>

                        </div>

                        @if (!recordSaved)
                        {
                            <div class="mt-4 d-flex gap-2">
                                <button class="btn btn-success btn-lg px-4" type="submit" disabled="@isSaving">
                                    @if (isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Saving...</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-save me-1"></i>
                                        <span>Save Phone Record</span>
                                    }
                                </button>

                                <button class="btn btn-outline-secondary btn-lg" type="button" @onclick="GoBack">
                                    Back to Search
                                </button>
                            </div>
                        }

                    </fieldset>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Follow-up Detail Modal -->
@if (selectedFollowUp != null && showFollowUpModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.55);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable followup-detail-modal">
            <div class="modal-content">

                <div class="modal-header bg-dark-blue text-white py-2">
                    <div>
                        <h5 class="modal-title mb-0">
                            <i class="fas fa-phone-alt me-2"></i>
                            Phone Call Detail
                        </h5>
                        <small>
                            @guest?.FirstName @guest?.Surname -
                            @selectedFollowUp.CallDate.ToString("dd-MMM-yyyy")
                        </small>
                    </div>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseFollowUpModal">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="detail-grid">

                        <div class="detail-item">
                            <span>Call Date</span>
                            <strong>@selectedFollowUp.CallDate.ToString("dd-MMM-yyyy")</strong>
                        </div>

                        <div class="detail-item">
                            <span>Called By</span>
                            <strong>@selectedFollowUp.CalledByName</strong>
                        </div>

                        <div class="detail-item">
                            <span>Call Answered</span>
                            <strong>@(selectedFollowUp.WasCallAnswered ? "Yes" : "No")</strong>
                        </div>

                        <div class="detail-item">
                            <span>Duration</span>
                            <strong>@(selectedFollowUp.CallDurationMinutes.HasValue ? $"{selectedFollowUp.CallDurationMinutes} mins" : "-")</strong>
                        </div>

                        <div class="detail-item full">
                            <span>Outcome</span>
                            <strong>@selectedFollowUp.Outcome</strong>
                        </div>

                        <div class="detail-item">
                            <span>Will Guest Return?</span>
                            <strong>@FormatNullableBool(selectedFollowUp.WillGuestReturn)</strong>
                        </div>

                        <div class="detail-item">
                            <span>Needs Visitation?</span>
                            <strong>@FormatNullableBool(selectedFollowUp.NeedsVisitation)</strong>
                        </div>

                        <div class="detail-item">
                            <span>Wants to Meet Pastor?</span>
                            <strong>@FormatNullableBool(selectedFollowUp.WantsToMeetPastor)</strong>
                        </div>

                        <div class="detail-item">
                            <span>Join Department?</span>
                            <strong>@FormatNullableBool(selectedFollowUp.WantsToJoinDepartment)</strong>
                        </div>

                        <div class="detail-item full">
                            <span>Department Interest</span>
                            <strong>@DisplayText(selectedFollowUp.DepartmentInterest)</strong>
                        </div>

                        <div class="detail-item full">
                            <span>Next Follow-up Date</span>
                            <strong>@(selectedFollowUp.NextFollowUpDate?.ToString("dd-MMM-yyyy") ?? "Not set")</strong>
                        </div>

                    </div>

                    <div class="note-section mt-3">
                        <h6><i class="fas fa-praying-hands me-1"></i>Prayer Request</h6>
                        <p>@DisplayText(selectedFollowUp.PrayerRequest)</p>
                    </div>

                    <div class="note-section">
                        <h6><i class="fas fa-comment-dots me-1"></i>Guest Feedback</h6>
                        <p>@DisplayText(selectedFollowUp.GuestFeedback)</p>
                    </div>

                    <div class="note-section">
                        <h6><i class="fas fa-sticky-note me-1"></i>Remarks</h6>
                        <p>@DisplayText(selectedFollowUp.Remarks)</p>
                    </div>

                </div>

                <div class="modal-footer py-2">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="CloseFollowUpModal">
                        Close
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public int guestId { get; set; }

    private Guest? guest;
    private GuestPhoneFollowUp followUpModel = new();
    private List<GuestPhoneFollowUp> previousFollowUps = new();

    private GuestPhoneFollowUp? selectedFollowUp;
    private bool showFollowUpModal = false;

    private bool isLoading = true;
    private bool isSaving = false;
    private bool recordSaved = false;

    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadPageData();
    }

    private async Task LoadPageData()
    {
        try
        {
            isLoading = true;

            guest = await GuestService.GetGuestByIdAsync(guestId);

            if (guest != null)
            {
                previousFollowUps = await GuestService.GetGuestPhoneFollowUpsAsync(guest.Id);

                followUpModel = new GuestPhoneFollowUp
                {
                    GuestId = guest.Id,
                    CallDate = DateTime.Today,
                    WasCallAnswered = true
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error loading page: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveFollowUp()
    {
        if (guest == null)
            return;

        try
        {
            isSaving = true;
            errorMessage = "";

            var currentWorker = AuthService.CurrentWorker;

            followUpModel.GuestId = guest.Id;
            followUpModel.CalledByWorkerId = currentWorker?.Id;
            followUpModel.CalledByName = currentWorker == null
                ? "Unknown User"
                : $"{currentWorker.FirstName} {currentWorker.LastName}";

            await GuestService.AddPhoneFollowUpAsync(followUpModel);

            previousFollowUps = await GuestService.GetGuestPhoneFollowUpsAsync(guest.Id);

            recordSaved = true;
        }
        catch (Exception ex)
        {
            errorMessage = "Error saving phone follow-up: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ViewFollowUpDetails(GuestPhoneFollowUp followUp)
    {
        selectedFollowUp = followUp;
        showFollowUpModal = true;
    }

    private void CloseFollowUpModal()
    {
        showFollowUpModal = false;
        selectedFollowUp = null;
    }

    private string FormatNullableBool(bool? value)
    {
        return value.HasValue ? (value.Value ? "Yes" : "No") : "Not Sure";
    }

    private string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not provided" : value;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/guest/search");
    }
}

<style>
    .followup-history-card {
        border: 1px solid #e9ecef !important;
        border-radius: 12px;
        overflow: hidden;
    }

    .followup-form-card {
        background: #ffffff;
        border: 1px solid #e6e9ef;
        border-radius: 14px;
        padding: 24px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .section-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #0d6efd;
        border-bottom: 1px solid #eef1f5;
        padding-bottom: 8px;
        margin-bottom: 16px;
        margin-top: 6px;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
        font-size: 0.9rem;
    }

    .form-control,
    .form-select {
        border-radius: 8px;
    }

        .form-control:focus,
        .form-select:focus {
            box-shadow: 0 0 0 0.15rem rgba(13,110,253,.15);
        }

    .note-box {
        background-color: #fbfcfe;
    }

    fieldset[disabled] .followup-form-card {
        background-color: #f8f9fa;
        opacity: 0.75;
    }

    .followup-detail-modal {
        max-width: 720px;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .detail-item {
        background: #f8f9fa;
        border: 1px solid #edf0f3;
        border-radius: 10px;
        padding: 10px 12px;
    }

        .detail-item.full {
            grid-column: 1 / -1;
        }

        .detail-item span {
            display: block;
            color: #6c757d;
            font-size: 0.8rem;
            margin-bottom: 3px;
        }

        .detail-item strong {
            color: #212529;
            font-size: 0.92rem;
            word-break: break-word;
        }

    .note-section {
        border: 1px solid #edf0f3;
        border-radius: 10px;
        padding: 12px;
        margin-bottom: 10px;
        background: #ffffff;
    }

        .note-section h6 {
            font-size: 0.9rem;
            color: #0d6efd;
            margin-bottom: 6px;
            font-weight: 700;
        }

        .note-section p {
            margin-bottom: 0;
            color: #343a40;
            white-space: pre-wrap;
        }

    @@media (max-width: 576px) {
        .followup-form-card {
            padding: 16px;
        }

        .detail-grid {
            grid-template-columns: 1fr;
        }

        .followup-detail-modal {
            max-width: 95%;
            margin: 0.75rem auto;
        }
    }
</style>