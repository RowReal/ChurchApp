@page "/guest/phone-followup"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services

@inject GuestService GuestService
@inject ServiceRecordAccessService ServiceRecordAccessService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Phone Follow-up - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access phone follow-up.</p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else if (isLoading)
{
    <div class="worker360-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-4">
                <div class="spinner-border text-primary"></div>

                <div class="mt-2 text-muted">
                    Loading phone follow-up...
                </div>
            </div>
        </div>
    </div>
}
else if (!canAccessGuestManagement)
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>

        <p>
            You must have the Guest Management privilege and either belong
            to the FIG Directorate, have FIG as your secondary department,
            or hold an authorised leadership role.
        </p>

        <button type="button"
                class="bcc-btn bcc-btn-primary"
                @onclick="GoBack">
            Return to Guest Search
        </button>
    </div>
}
else if (guest == null)
{
    <div class="bcc-empty">
        <i class="fas fa-user-slash"></i>
        <h4>Guest Record Not Found</h4>
        <p>The selected guest record could not be found.</p>

        <button type="button"
                class="bcc-btn bcc-btn-primary"
                @onclick="GoBack">
            <i class="fas fa-arrow-left me-2"></i>
            Back to Guest Search
        </button>
    </div>
}
else
{
    <div class="worker360-page phone-followup-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        <div class="bcc-page-header phone-followup-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-phone-volume me-2"></i>
                    Guest Management
                </div>

                <div class="bcc-page-title">
                    Phone Follow-up
                </div>

                <div class="bcc-page-subtitle">
                    Record conversations, prayer needs, visit interest and next actions.
                </div>
            </div>

            <button type="button"
                    class="bcc-btn profile-form-secondary-btn compact-btn"
                    @onclick="GoBack">
                <i class="fas fa-arrow-left me-2"></i>
                Guest Search
            </button>
        </div>

        <div class="guest-profile-strip mb-3">

            <div class="guest-profile-main">
                <div class="guest-avatar-large">
                    @GetGuestInitials()
                </div>

                <div>
                    <h5>
                        @guest.Title @guest.FirstName @guest.Surname
                    </h5>

                    <div class="guest-profile-meta">
                        <span>
                            <i class="fas fa-id-card"></i>
                            @guest.GuestNumber
                        </span>

                        <span>
                            <i class="fas fa-phone"></i>
                            @DisplayText(guest.PhoneNumber)
                        </span>

                        <span>
                            <i class="fas fa-calendar-day"></i>
                            @(guest.VisitingDate.ToString("dd MMM yyyy"))
                        </span>
                    </div>
                </div>
            </div>

            <div class="guest-profile-status">
                <span class="guest-type-badge
                        @(guest.IsSecondTimer ? "second" : "first")">
                    @(guest.IsSecondTimer ? "Second Timer" : "First Timer")
                </span>

                <div class="previous-call-count">
                    <span>Previous Calls</span>
                    <strong>@previousFollowUps.Count</strong>
                </div>
            </div>

        </div>

        @if (recordSaved)
        {
            <div class="followup-success-banner mb-3">
                <div class="followup-success-icon">
                    <i class="fas fa-check-circle"></i>
                </div>

                <div>
                    <h6>Phone Follow-up Saved</h6>

                    <p>
                        The call record for
                        <strong>@guest.FirstName @guest.Surname</strong>
                        was saved successfully.
                    </p>

                    <div class="followup-success-details">
                        <span>
                            Call:
                            <strong>
                                @(followUpModel.CallDate.ToString("dd MMM yyyy"))
                            </strong>
                        </span>

                        <span>
                            Outcome:
                            <strong>@followUpModel.Outcome</strong>
                        </span>

                        <span>
                            Next:
                            <strong>
                                @(followUpModel.NextFollowUpDate?
                                                        .ToString("dd MMM yyyy")
                                                        ?? "Not set")
                    </strong>
                </span>
            </div>
        </div>
    </div>
        }

        <div class="row g-3">

            <div class="col-12 col-xl-4">
                <div class="bcc-card h-100">
                    <div class="bcc-card-body p-3">

                        <div class="compact-section-heading">
                            <div>
                                <h6>
                                    <i class="fas fa-history me-2"></i>
                                    Previous Calls
                                </h6>

                                <p>
                                    Earlier phone follow-up records.
                                </p>
                            </div>
                        </div>

                        @if (previousFollowUps.Any())
                        {
                            <div class="call-history-list">

                                @foreach (var item in previousFollowUps
                                                        .OrderByDescending(x => x.CallDate))
                                {
                                    <div class="call-history-item">

                                        <div class="call-history-top">
                                            <div>
                                                <strong>
                                                    @(item.CallDate
                                                                                            .ToString("dd MMM yyyy"))
                                                                                                                 </strong>

                                                <span>
                                                    Called by @item.CalledByName
                                                </span>
                                            </div>

                                            <span class="answer-badge
                                                            @(item.WasCallAnswered
                                                                                                      ? "answered"
                                                                                                      : "not-answered")">
                                                @(item.WasCallAnswered
                                                                                    ? "Answered"
                                                                                    : "No Answer")
                                                                                              </span>
                                                                                          </div>

                                        <p>@item.Outcome</p>

                                        <div class="call-history-footer">
                                            <small>
                                                Next:
                                                @(item.NextFollowUpDate?
                                                                                    .ToString("dd MMM yyyy")
                                                                                    ?? "Not set")
                                </small>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => ViewFollowUpDetails(item)">
                                                <i class="fas fa-eye me-1"></i>
                                                View
                                            </button>
                                        </div>

                                    </div>
                                                }

                            </div>
                        }
                        else
                        {
                            <div class="bcc-empty py-4">
                                <i class="fas fa-phone-slash"></i>
                                <h4>No Previous Calls</h4>
                                <p>This will be the first phone record for this guest.</p>
                            </div>
                        }

                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-8">
                <EditForm Model="@followUpModel"
                          OnValidSubmit="SaveFollowUp">

                    <DataAnnotationsValidator />

                    <fieldset disabled="@recordSaved">
                        <div class="bcc-card">
                            <div class="bcc-card-body p-3">

                                <div class="compact-section-heading">
                                    <div>
                                        <h6>
                                            <i class="fas fa-phone-alt me-2"></i>
                                            New Phone Call Record
                                        </h6>

                                        <p>
                                            Capture the result of the conversation.
                                        </p>
                                    </div>
                                </div>

                                <div class="form-section-panel">
                                    <div class="form-section-title">
                                        Call Information
                                    </div>

                                    <div class="row g-2">

                                        <div class="col-6 col-md-3">
                                            <label class="form-label compact-label">
                                                Call Date
                                            </label>

                                            <InputDate class="form-control form-control-sm"
                                                       @bind-Value="followUpModel.CallDate" />
                                        </div>

                                        <div class="col-6 col-md-3">
                                            <label class="form-label compact-label">
                                                Answered?
                                            </label>

                                            <InputSelect class="form-select form-select-sm"
                                                         @bind-Value="followUpModel.WasCallAnswered">
                                                <option value="true">Yes</option>
                                                <option value="false">No</option>
                                            </InputSelect>
                                        </div>

                                        <div class="col-6 col-md-3">
                                            <label class="form-label compact-label">
                                                Duration
                                            </label>

                                            <div class="input-group input-group-sm">
                                                <InputNumber class="form-control"
                                                             @bind-Value="followUpModel.CallDurationMinutes" />
                                                <span class="input-group-text">mins</span>
                                            </div>
                                        </div>

                                        <div class="col-6 col-md-3">
                                            <label class="form-label compact-label">
                                                Next Follow-up
                                            </label>

                                            <InputDate class="form-control form-control-sm"
                                                       @bind-Value="followUpModel.NextFollowUpDate" />
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label compact-label">
                                                Call Outcome
                                                <span class="text-danger">*</span>
                                            </label>

                                            <InputSelect class="form-select form-select-sm"
                                                         @bind-Value="followUpModel.Outcome">
                                                <option value="">Select outcome</option>
                                                <option value="Answered - Positive">Answered - Positive</option>
                                                <option value="Answered - Needs Prayer">Answered - Needs Prayer</option>
                                                <option value="Answered - Wants Visit">Answered - Wants Visit</option>
                                                <option value="Answered - Wants Counselling">Answered - Wants Counselling</option>
                                                <option value="Answered - Will Return">Answered - Will Return</option>
                                                <option value="Answered - Not Interested">Answered - Not Interested</option>
                                                <option value="No Answer">No Answer</option>
                                                <option value="Wrong Number">Wrong Number</option>
                                                <option value="Number Switched Off">Number Switched Off</option>
                                                <option value="Call Back Later">Call Back Later</option>
                                            </InputSelect>

                                            <ValidationMessage For="@(() => followUpModel.Outcome)" />
                                        </div>

                                    </div>
                                </div>

                                <div class="form-section-panel">
                                    <div class="form-section-title">
                                        Follow-up Response
                                    </div>

                                    <div class="row g-2">

                                        <div class="col-6 col-md-3">
                                            <label class="form-label compact-label">
                                                Will Return?
                                            </label>

                                            <InputSelect class="form-select form-select-sm"
                                                         @bind-Value="followUpModel.WillGuestReturn">
                                                <option value="">Not Sure</option>
                                                <option value="true">Yes</option>
                                                <option value="false">No</option>
                                            </InputSelect>
                                        </div>

                                        <div class="col-6 col-md-3">
                                            <label class="form-label compact-label">
                                                Needs Visit?
                                            </label>

                                            <InputSelect class="form-select form-select-sm"
                                                         @bind-Value="followUpModel.NeedsVisitation">
                                                <option value="">Not Sure</option>
                                                <option value="true">Yes</option>
                                                <option value="false">No</option>
                                            </InputSelect>
                                        </div>

                                        <div class="col-6 col-md-3">
                                            <label class="form-label compact-label">
                                                Meet Pastor?
                                            </label>

                                            <InputSelect class="form-select form-select-sm"
                                                         @bind-Value="followUpModel.WantsToMeetPastor">
                                                <option value="">Not Sure</option>
                                                <option value="true">Yes</option>
                                                <option value="false">No</option>
                                            </InputSelect>
                                        </div>

                                        <div class="col-6 col-md-3">
                                            <label class="form-label compact-label">
                                                Join Dept?
                                            </label>

                                            <InputSelect class="form-select form-select-sm"
                                                         @bind-Value="followUpModel.WantsToJoinDepartment">
                                                <option value="">Not Sure</option>
                                                <option value="true">Yes</option>
                                                <option value="false">No</option>
                                            </InputSelect>
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label compact-label">
                                                Department Interest
                                            </label>

                                            <InputText class="form-control form-control-sm"
                                                       @bind-Value="followUpModel.DepartmentInterest"
                                                       placeholder="e.g. Choir, Ushering, Media, Prayer Team" />
                                        </div>

                                    </div>
                                </div>

                                <div class="form-section-panel mb-0">
                                    <div class="form-section-title">
                                        Conversation Notes
                                    </div>

                                    <div class="row g-2">

                                        <div class="col-md-6">
                                            <label class="form-label compact-label">
                                                Prayer Request
                                            </label>

                                            <InputTextArea class="form-control form-control-sm"
                                                           rows="3"
                                                           @bind-Value="followUpModel.PrayerRequest" />
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label compact-label">
                                                Guest Feedback
                                            </label>

                                            <InputTextArea class="form-control form-control-sm"
                                                           rows="3"
                                                           @bind-Value="followUpModel.GuestFeedback" />
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label compact-label">
                                                Additional Remarks
                                            </label>

                                            <InputTextArea class="form-control form-control-sm"
                                                           rows="2"
                                                           @bind-Value="followUpModel.Remarks" />
                                        </div>

                                    </div>
                                </div>

                                @if (!recordSaved)
                                {
                                    <div class="mt-3 d-flex justify-content-end gap-2">

                                        <button type="button"
                                                class="bcc-btn profile-form-secondary-btn compact-btn"
                                                disabled="@isSaving"
                                                @onclick="GoBack">
                                            Cancel
                                        </button>

                                        <button type="submit"
                                                class="bcc-btn bcc-btn-primary compact-btn"
                                                disabled="@isSaving">

                                            @if (isSaving)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                                <span>Saving...</span>
                                            }
                                            else
                                            {
                                                <i class="fas fa-save me-2"></i>
                                                <span>Save Phone Record</span>
                                            }

                                        </button>

                                    </div>
                                }

                            </div>
                        </div>
                    </fieldset>

                </EditForm>
            </div>

        </div>
    </div>
}

@if (selectedFollowUp != null && showFollowUpModal)
{
    <div class="followup-popup-backdrop">
        <div class="followup-popup-card">

            <div class="followup-popup-header">
                <div>
                    <h4>Phone Call Detail</h4>

                    <p>
                        @guest?.FirstName @guest?.Surname ·
                        @(selectedFollowUp.CallDate.ToString("dd MMM yyyy"))
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        @onclick="CloseFollowUpModal">
                </button>
            </div>

            <div class="call-detail-grid">

                <div>
                    <span>Called By</span>
                    <strong>@selectedFollowUp.CalledByName</strong>
                </div>

                <div>
                    <span>Answered</span>
                    <strong>
                        @(selectedFollowUp.WasCallAnswered ? "Yes" : "No")
                    </strong>
                </div>

                <div>
                    <span>Duration</span>
                    <strong>
                        @(selectedFollowUp.CallDurationMinutes.HasValue
                                            ? $"{selectedFollowUp.CallDurationMinutes} mins"
                                            : "Not provided")
                                                         </strong>
                                                     </div>

                <div>
                    <span>Next Follow-up</span>
                    <strong>
                        @(selectedFollowUp.NextFollowUpDate?
                                            .ToString("dd MMM yyyy")
                                            ?? "Not set")
                </strong>
            </div>

                <div class="detail-wide">
                    <span>Outcome</span>
                    <strong>@DisplayText(selectedFollowUp.Outcome)</strong>
                </div>

                <div>
                    <span>Will Return?</span>
                    <strong>
                        @FormatNullableBool(selectedFollowUp.WillGuestReturn)
                    </strong>
                </div>

                <div>
                    <span>Needs Visitation?</span>
                    <strong>
                        @FormatNullableBool(selectedFollowUp.NeedsVisitation)
                    </strong>
                </div>

                <div>
                    <span>Meet Pastor?</span>
                    <strong>
                        @FormatNullableBool(selectedFollowUp.WantsToMeetPastor)
                    </strong>
                </div>

                <div>
                    <span>Join Department?</span>
                    <strong>
                        @FormatNullableBool(selectedFollowUp.WantsToJoinDepartment)
                    </strong>
                </div>

                <div class="detail-wide">
                    <span>Department Interest</span>
                    <strong>
                        @DisplayText(selectedFollowUp.DepartmentInterest)
                    </strong>
                </div>

                <div class="detail-wide note-detail">
                    <span>Prayer Request</span>
                    <strong>
                        @DisplayText(selectedFollowUp.PrayerRequest)
                    </strong>
                </div>

                <div class="detail-wide note-detail">
                    <span>Guest Feedback</span>
                    <strong>
                        @DisplayText(selectedFollowUp.GuestFeedback)
                    </strong>
                </div>

                <div class="detail-wide note-detail">
                    <span>Remarks</span>
                    <strong>
                        @DisplayText(selectedFollowUp.Remarks)
                    </strong>
                </div>

            </div>

            <div class="mt-3 d-flex justify-content-end">
                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        @onclick="CloseFollowUpModal">
                    Close
                </button>
            </div>

        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public int guestId { get; set; }

    private Guest? guest;

    private GuestPhoneFollowUp followUpModel =
        new();

    private List<GuestPhoneFollowUp> previousFollowUps =
        new();

    private GuestPhoneFollowUp? selectedFollowUp;

    private bool showFollowUpModal;
    private bool isLoading = true;
    private bool isSaving;
    private bool recordSaved;
    private bool canAccessGuestManagement;

    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageData();
    }

    private async Task LoadPageData()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var worker = AuthService.CurrentWorker;

            if (worker == null)
            {
                canAccessGuestManagement = false;
                return;
            }

            var access =
                await ServiceRecordAccessService
                    .GetAccessAsync(worker.Id);

            var hasGuestPrivilege =
                access.CanAccessGuestManagement;

            var isFigDirectorate =
                IsFigName(worker.Directorate?.Name);

            var isSecondaryDepartmentFig =
                IsFigName(worker.SecondaryDepartment?.Name);

            var hasAuthorisedRole =
                AuthService.IsInRole("Church Admin") ||
                AuthService.IsInRole("Head of Service") ||
                AuthService.IsInRole("Pastor in Charge");

            canAccessGuestManagement =
                hasGuestPrivilege &&
                (
                    isFigDirectorate ||
                    isSecondaryDepartmentFig ||
                    hasAuthorisedRole
                );

            if (!canAccessGuestManagement)
                return;

            guest =
                await GuestService
                    .GetGuestByIdAsync(guestId);

            if (guest == null)
                return;

            previousFollowUps =
                await GuestService
                    .GetGuestPhoneFollowUpsAsync(
                        guest.Id);

            followUpModel =
                new GuestPhoneFollowUp
                {
                    GuestId = guest.Id,
                    CallDate = DateTime.Today,
                    WasCallAnswered = true
                };
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Error loading page: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveFollowUp()
    {
        if (guest == null ||
            isSaving)
        {
            return;
        }

        try
        {
            isSaving = true;
            errorMessage = string.Empty;

            var currentWorker =
                AuthService.CurrentWorker;

            followUpModel.GuestId =
                guest.Id;

            followUpModel.CalledByWorkerId =
                currentWorker?.Id;

            followUpModel.CalledByName =
                currentWorker == null
                    ? "Unknown User"
                    : $"{currentWorker.FirstName} {currentWorker.LastName}";

            await GuestService
                .AddPhoneFollowUpAsync(
                    followUpModel);

            previousFollowUps =
                await GuestService
                    .GetGuestPhoneFollowUpsAsync(
                        guest.Id);

            recordSaved = true;
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Error saving phone follow-up: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ViewFollowUpDetails(
        GuestPhoneFollowUp followUp)
    {
        selectedFollowUp = followUp;
        showFollowUpModal = true;
    }

    private void CloseFollowUpModal()
    {
        showFollowUpModal = false;
        selectedFollowUp = null;
    }

    private static bool IsFigName(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        return string.Equals(
                   value.Trim(),
                   "FIG",
                   StringComparison.OrdinalIgnoreCase)
               ||
               value.Contains(
                   "FIG",
                   StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatNullableBool(
        bool? value)
    {
        return value.HasValue
            ? (value.Value ? "Yes" : "No")
            : "Not Sure";
    }

    private static string DisplayText(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Not provided"
            : value;
    }

    private string GetGuestInitials()
    {
        if (guest == null)
            return "G";

        var first =
            !string.IsNullOrWhiteSpace(guest.FirstName)
                ? guest.FirstName[..1].ToUpperInvariant()
                : string.Empty;

        var last =
            !string.IsNullOrWhiteSpace(guest.Surname)
                ? guest.Surname[..1].ToUpperInvariant()
                : string.Empty;

        var initials = $"{first}{last}";

        return string.IsNullOrWhiteSpace(initials)
            ? "G"
            : initials;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/guest/search");
    }
}

<style>
    .phone-followup-page {
        max-width: 1500px;
        margin: 0 auto;
    }

    .phone-followup-header {
        margin-bottom: 14px;
    }

    .compact-btn {
        min-height: 32px;
        padding: 6px 11px;
        font-size: 0.78rem;
    }

    .guest-profile-strip {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 12px 14px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
    }

    .guest-profile-main {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .guest-avatar-large {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 44px;
        width: 44px;
        height: 44px;
        color: #4338ca;
        background: #eef2ff;
        border: 1px solid #c7d2fe;
        border-radius: 12px;
        font-size: 0.82rem;
        font-weight: 800;
    }

    .guest-profile-main h5 {
        margin: 0 0 4px;
        color: #0f172a;
        font-size: 0.98rem;
        font-weight: 800;
    }

    .guest-profile-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 14px;
    }

        .guest-profile-meta span {
            color: #64748b;
            font-size: 0.68rem;
        }

        .guest-profile-meta i {
            margin-right: 4px;
            color: #4f46e5;
        }

    .guest-profile-status {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .guest-type-badge {
        display: inline-flex;
        padding: 4px 8px;
        border-radius: 999px;
        font-size: 0.66rem;
        font-weight: 800;
    }

        .guest-type-badge.first {
            color: #166534;
            background: #dcfce7;
        }

        .guest-type-badge.second {
