@page "/guest/phone-followup"
@layout Components.Layout.MainLayout
@using ChurchApp.Models
@using ChurchApp.Services
@inject GuestService GuestService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Phone Follow-up - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="guest-followup-v2-page">
        <div class="bcc-empty">
            <i class="fas fa-exclamation-triangle"></i>
            <h4>Please Log In</h4>
            <p>You need to be logged in to access phone follow-up.</p>
            <a href="/login" class="bcc-btn bcc-btn-primary text-decoration-none">Go to Login</a>
        </div>
    </div>
}
else if (isLoading)
{
    <div class="guest-followup-v2-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-5">
                <div class="spinner-border text-primary mb-3"></div>
                <h5 class="fw-bold">Loading Phone Follow-up...</h5>
                <p class="text-muted mb-0">Please wait while we load the guest record.</p>
            </div>
        </div>
    </div>
}
else if (guest == null)
{
    <div class="guest-followup-v2-page">
        <div class="bcc-empty">
            <i class="fas fa-user-slash"></i>
            <h4>Guest Record Not Found</h4>
            <p>The selected guest record could not be found.</p>
            <button class="bcc-btn bcc-btn-primary" @onclick="GoBack">
                <i class="fas fa-arrow-left me-1"></i>Back to Guest Search
            </button>
        </div>
    </div>
}
else
{
    <div class="guest-followup-v2-page">

        <div class="bcc-page-header">
            <div>
                <div class="guest-page-kicker">
                    <i class="fas fa-phone-volume me-2"></i>BCC ServiceHub
                </div>
                <div class="bcc-page-title">Phone Follow-up</div>
                <div class="bcc-page-subtitle">
                    Record guest phone conversations, prayer needs, visit interest, and next follow-up actions.
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button class="bcc-btn guest-light-btn" @onclick="GoBack">
                    <i class="fas fa-arrow-left me-1"></i>Guest Search
                </button>
            </div>
        </div>

        <div class="bcc-card">
            <div class="bcc-card-body">
                <div class="guest-followup-profile">
                    <div class="guest360-avatar">
                        @GetGuestInitials()
                    </div>

                    <div class="flex-grow-1">
                        <h3>@guest.Title @guest.FirstName @guest.Surname</h3>

                        <div class="guest-followup-meta">
                            <span><i class="fas fa-id-card"></i>@guest.GuestNumber</span>
                            <span><i class="fas fa-phone"></i>@DisplayText(guest.PhoneNumber)</span>
                            <span><i class="fas fa-calendar-day"></i>@guest.VisitingDate.ToString("dd-MMM-yyyy")</span>

                            @if (guest.IsSecondTimer)
                            {
                                <span class="status-warning"><i class="fas fa-user-check"></i>Second Timer</span>
                            }
                            else
                            {
                                <span class="status-success"><i class="fas fa-user-plus"></i>First Timer</span>
                            }
                        </div>
                    </div>

                    <div class="guest-followup-count">
                        <span>Previous Calls</span>
                        <strong>@previousFollowUps.Count</strong>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger profile-v2-alert">
                <i class="fas fa-exclamation-circle me-2"></i>@errorMessage
            </div>
        }

        @if (recordSaved)
        {
            <div class="guest-followup-success">
                <div class="guest-access-icon success">
                    <i class="fas fa-check-circle"></i>
                </div>

                <div>
                    <h4>Phone Follow-up Recorded Successfully</h4>
                    <p>
                        The phone conversation for <strong>@guest.FirstName @guest.Surname</strong> has been saved successfully.
                    </p>

                    <div class="guest-followup-success-grid">
                        <div>
                            <span>Call Date</span>
                            <strong>@followUpModel.CallDate.ToString("dd-MMM-yyyy")</strong>
                        </div>

                        <div>
                            <span>Outcome</span>
                            <strong>@followUpModel.Outcome</strong>
                        </div>

                        <div>
                            <span>Next Follow-up</span>
                            <strong>@(followUpModel.NextFollowUpDate?.ToString("dd-MMM-yyyy") ?? "Not set")</strong>
                        </div>
                    </div>

                    <button class="bcc-btn bcc-btn-primary mt-3" @onclick="GoBack">
                        <i class="fas fa-arrow-left me-1"></i>Return to Guest Search
                    </button>
                </div>
            </div>
        }

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="bcc-card h-100">
                    <div class="bcc-card-header">
                        <i class="fas fa-history text-primary"></i>
                        <div>
                            <div class="bcc-card-title">Previous Phone Follow-ups</div>
                            <small class="text-muted">View earlier call records for this guest.</small>
                        </div>
                    </div>

                    <div class="bcc-card-body">
                        @if (previousFollowUps.Any())
                        {
                            <div class="guest-call-timeline">
                                @foreach (var item in previousFollowUps.OrderByDescending(x => x.CallDate))
                                {
                                    <div class="guest-call-item">
                                        <div class="guest-call-dot"></div>

                                        <div class="guest-call-card">
                                            <div class="d-flex justify-content-between gap-2 flex-wrap">
                                                <div>
                                                    <strong>@item.CallDate.ToString("dd-MMM-yyyy")</strong>
                                                    <span>Called by @item.CalledByName</span>
                                                </div>

                                                @if (item.WasCallAnswered)
                                                {
                                                    <span class="bcc-status bcc-status-success">Answered</span>
                                                }
                                                else
                                                {
                                                    <span class="bcc-status bcc-status-warning">No Answer</span>
                                                }
                                            </div>

                                            <p>@item.Outcome</p>

                                            <div class="guest-call-footer">
                                                <small>
                                                    <i class="fas fa-calendar-check me-1"></i>
                                                    Next: @(item.NextFollowUpDate?.ToString("dd-MMM-yyyy") ?? "Not set")
                                                </small>

                                                <button class="team-action-btn" @onclick="() => ViewFollowUpDetails(item)">
                                                    <i class="fas fa-eye me-1"></i>View
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="guest-mini-empty">
                                <i class="fas fa-phone-slash"></i>
                                <h6>No phone follow-up yet</h6>
                                <p>This will be the first phone record for this guest.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <EditForm Model="@followUpModel" OnValidSubmit="SaveFollowUp">
                    <DataAnnotationsValidator />

                    <fieldset disabled="@recordSaved">
                        <div class="bcc-card">
                            <div class="bcc-card-header">
                                <i class="fas fa-phone-alt text-primary"></i>
                                <div>
                                    <div class="bcc-card-title">New Phone Call Record</div>
                                    <small class="text-muted">Capture the result of the phone conversation.</small>
                                </div>
                            </div>

                            <div class="bcc-card-body">

                                <div class="guest-form-section">
                                    <div class="guest-form-section-header blue">
                                        <i class="fas fa-phone-volume"></i>
                                        <span>Call Information</span>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div class="bcc-form-field">
                                                <label class="bcc-form-label">Date of Call</label>
                                                <InputDate class="form-control bcc-input" @bind-Value="followUpModel.CallDate" />
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="bcc-form-field">
                                                <label class="bcc-form-label">Was Call Answered?</label>
                                                <InputSelect class="form-select bcc-input" @bind-Value="followUpModel.WasCallAnswered">
                                                    <option value="true">Yes, answered</option>
                                                    <option value="false">No, not answered</option>
                                                </InputSelect>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="bcc-form-field">
                                                <label class="bcc-form-label">Duration</label>
                                                <div class="input-group">
                                                    <InputNumber class="form-control bcc-input" @bind-Value="followUpModel.CallDurationMinutes" />
                                                    <span class="input-group-text">mins</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-8">
                                            <div class="bcc-form-field">
                                                <label class="bcc-form-label">Call Outcome</label>
                                                <InputSelect class="form-select bcc-input" @bind-Value="followUpModel.Outcome">
                                                    <option value="">Select call outcome</option>
                                                    <option value="Answered - Positive">Answered - Positive</option>
                                                    <option value="Answered - Needs Prayer">Answered - Needs Prayer</option>
                                                    <option value="Answered - Wants Visit">Answered - Wants Visit</option>
                                                    <option value="Answered - Wants Counselling">Answered - Wants Counselling</option>
                                                    <option value="Answered - Will Return">Answered - Will Return</option>
                                                    <option value="Answered - Not Interested">Answered - Not Interested</option>
                                                    <option value="No Answer">No Answer</option>
                                                    <option value="Wrong Number">Wrong Number</option>
                                                    <option value="Number Switched Off">Number Switched Off</option>
                                                    <option value="Call Back Later">Call Back Later</option>
                                                </InputSelect>
                                                <ValidationMessage For="@(() => followUpModel.Outcome)" />
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="bcc-form-field">
                                                <label class="bcc-form-label">Next Follow-up Date</label>
                                                <InputDate class="form-control bcc-input" @bind-Value="followUpModel.NextFollowUpDate" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="guest-form-section">
                                    <div class="guest-form-section-header green">
                                        <i class="fas fa-clipboard-check"></i>
                                        <span>Follow-up Response</span>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-md-3">
                                            <div class="bcc-form-field">
                                                <label class="bcc-form-label">Will Return?</label>
                                                <InputSelect class="form-select bcc-input" @bind-Value="followUpModel.WillGuestReturn">
                                                    <option value="">Not Sure</option>
                                                    <option value="true">Yes</option>
                                                    <option value="false">No</option>
                                                </InputSelect>
                                            </div>
                                        </div>

                                        <div class="col-md-3">
                                            <div class="bcc-form-field">
                                                <label class="bcc-form-label">Needs Visitation?</label>
                                                <InputSelect class="form-select bcc-input" @bind-Value="followUpModel.NeedsVisitation">
                                                    <option value="">Not Sure</option>
                                                    <option value="true">Yes</option>
                                                    <option value="false">No</option>
                                                </InputSelect>
                                            </div>
                                        </div>

                                        <div class="col-md-3">
                                            <div class="bcc-form-field">
                                                <label class="bcc-form-label">Meet Pastor?</label>
                                                <InputSelect class="form-select bcc-input" @bind-Value="followUpModel.WantsToMeetPastor">
                                                    <option value="">Not Sure</option>
                                                    <option value="true">Yes</option>
                                                    <option value="false">No</option>
                                                </InputSelect>
                                            </div>
                                        </div>

                                        <div class="col-md-3">
                                            <div class="bcc-form-field">
                                                <label class="bcc-form-label">Join Dept?</label>
                                                <InputSelect class="form-select bcc-input" @bind-Value="followUpModel.WantsToJoinDepartment">
                                                    <option value="">Not Sure</option>
                                                    <option value="true">Yes</option>
                                                    <option value="false">No</option>
                                                </InputSelect>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="bcc-form-field">
                                                <label class="bcc-form-label">Department Interest</label>
                                                <InputText class="form-control bcc-input"
                                                           @bind-Value="followUpModel.DepartmentInterest"
                                                           placeholder="e.g. Choir, Ushering, Media, Prayer Team" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="guest-form-section">
                                    <div class="guest-form-section-header purple">
                                        <i class="fas fa-comment-dots"></i>
                                        <span>Conversation Notes</span>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="bcc-form-field">
                                                <label class="bcc-form-label">Prayer Request</label>
                                                <InputTextArea class="form-control bcc-input guest-note-box" rows="4" @bind-Value="followUpModel.PrayerRequest" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="bcc-form-field">
                                                <label class="bcc-form-label">Guest Feedback</label>
                                                <InputTextArea class="form-control bcc-input guest-note-box" rows="4" @bind-Value="followUpModel.GuestFeedback" />
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="bcc-form-field">
                                                <label class="bcc-form-label">Additional Remarks</label>
                                                <InputTextArea class="form-control bcc-input guest-note-box" rows="3" @bind-Value="followUpModel.Remarks" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            @if (!recordSaved)
                            {
                                <div class="guest-form-footer">
                                    <button class="bcc-btn guest-secondary-btn" type="button" @onclick="GoBack">
                                        <i class="fas fa-arrow-left me-1"></i>Back to Search
                                    </button>

                                    <button class="bcc-btn bcc-btn-primary" type="submit" disabled="@isSaving">
                                        @if (isSaving)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                            <span>Saving...</span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-save me-1"></i>
                                            <span>Save Phone Record</span>
                                        }
                                    </button>
                                </div>
                            }
                        </div>
                    </fieldset>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (selectedFollowUp != null && showFollowUpModal)
{
    <div class="team-modal-backdrop">
        <div class="guest-followup-modal">
            <button class="team-modal-close" @onclick="CloseFollowUpModal">
                <i class="fas fa-times"></i>
            </button>

            <div class="guest360-header">
                <div class="guest360-avatar">
                    @GetGuestInitials()
                </div>

                <div>
                    <h4>Phone Call Detail</h4>
                    <p>
                        @guest?.FirstName @guest?.Surname -
                        @selectedFollowUp.CallDate.ToString("dd-MMM-yyyy")
                    </p>

                    @if (selectedFollowUp.WasCallAnswered)
                    {
                        <span class="bcc-status bcc-status-success">Answered</span>
                    }
                    else
                    {
                        <span class="bcc-status bcc-status-warning">Not Answered</span>
                    }
                </div>
            </div>

            <div class="guest360-body">
                <div class="guest-detail-grid">
                    <div class="guest-detail-item">
                        <span>Call Date</span>
                        <strong>@selectedFollowUp.CallDate.ToString("dd-MMM-yyyy")</strong>
                    </div>

                    <div class="guest-detail-item">
                        <span>Called By</span>
                        <strong>@selectedFollowUp.CalledByName</strong>
                    </div>

                    <div class="guest-detail-item">
                        <span>Call Answered</span>
                        <strong>@(selectedFollowUp.WasCallAnswered ? "Yes" : "No")</strong>
                    </div>

                    <div class="guest-detail-item">
                        <span>Duration</span>
                        <strong>@(selectedFollowUp.CallDurationMinutes.HasValue ? $"{selectedFollowUp.CallDurationMinutes} mins" : "-")</strong>
                    </div>

                    <div class="guest-detail-item full">
                        <span>Outcome</span>
                        <strong>@selectedFollowUp.Outcome</strong>
                    </div>

                    <div class="guest-detail-item">
                        <span>Will Guest Return?</span>
                        <strong>@FormatNullableBool(selectedFollowUp.WillGuestReturn)</strong>
                    </div>

                    <div class="guest-detail-item">
                        <span>Needs Visitation?</span>
                        <strong>@FormatNullableBool(selectedFollowUp.NeedsVisitation)</strong>
                    </div>

                    <div class="guest-detail-item">
                        <span>Meet Pastor?</span>
                        <strong>@FormatNullableBool(selectedFollowUp.WantsToMeetPastor)</strong>
                    </div>

                    <div class="guest-detail-item">
                        <span>Join Department?</span>
                        <strong>@FormatNullableBool(selectedFollowUp.WantsToJoinDepartment)</strong>
                    </div>

                    <div class="guest-detail-item full">
                        <span>Department Interest</span>
                        <strong>@DisplayText(selectedFollowUp.DepartmentInterest)</strong>
                    </div>

                    <div class="guest-detail-item full">
                        <span>Next Follow-up Date</span>
                        <strong>@(selectedFollowUp.NextFollowUpDate?.ToString("dd-MMM-yyyy") ?? "Not set")</strong>
                    </div>
                </div>

                <div class="guest-note-section">
                    <h6><i class="fas fa-praying-hands me-1"></i>Prayer Request</h6>
                    <p>@DisplayText(selectedFollowUp.PrayerRequest)</p>
                </div>

                <div class="guest-note-section">
                    <h6><i class="fas fa-comment-dots me-1"></i>Guest Feedback</h6>
                    <p>@DisplayText(selectedFollowUp.GuestFeedback)</p>
                </div>

                <div class="guest-note-section">
                    <h6><i class="fas fa-sticky-note me-1"></i>Remarks</h6>
                    <p>@DisplayText(selectedFollowUp.Remarks)</p>
                </div>
            </div>

            <div class="guest360-actions">
                <button type="button" class="bcc-btn guest-secondary-btn" @onclick="CloseFollowUpModal">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public int guestId { get; set; }

    private Guest? guest;
    private GuestPhoneFollowUp followUpModel = new();
    private List<GuestPhoneFollowUp> previousFollowUps = new();

    private GuestPhoneFollowUp? selectedFollowUp;
    private bool showFollowUpModal = false;

    private bool isLoading = true;
    private bool isSaving = false;
    private bool recordSaved = false;

    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadPageData();
    }

    private async Task LoadPageData()
    {
        try
        {
            isLoading = true;

            guest = await GuestService.GetGuestByIdAsync(guestId);

            if (guest != null)
            {
                previousFollowUps = await GuestService.GetGuestPhoneFollowUpsAsync(guest.Id);

                followUpModel = new GuestPhoneFollowUp
                {
                    GuestId = guest.Id,
                    CallDate = DateTime.Today,
                    WasCallAnswered = true
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error loading page: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveFollowUp()
    {
        if (guest == null)
            return;

        try
        {
            isSaving = true;
            errorMessage = "";

            var currentWorker = AuthService.CurrentWorker;

            followUpModel.GuestId = guest.Id;
            followUpModel.CalledByWorkerId = currentWorker?.Id;
            followUpModel.CalledByName = currentWorker == null
                ? "Unknown User"
                : $"{currentWorker.FirstName} {currentWorker.LastName}";

            await GuestService.AddPhoneFollowUpAsync(followUpModel);

            previousFollowUps = await GuestService.GetGuestPhoneFollowUpsAsync(guest.Id);

            recordSaved = true;
        }
        catch (Exception ex)
        {
            errorMessage = "Error saving phone follow-up: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ViewFollowUpDetails(GuestPhoneFollowUp followUp)
    {
        selectedFollowUp = followUp;
        showFollowUpModal = true;
    }

    private void CloseFollowUpModal()
    {
        showFollowUpModal = false;
        selectedFollowUp = null;
    }

    private string FormatNullableBool(bool? value)
    {
        return value.HasValue ? (value.Value ? "Yes" : "No") : "Not Sure";
    }

    private string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not provided" : value;
    }

    private string GetGuestInitials()
    {
        if (guest == null)
            return "G";

        var first = !string.IsNullOrWhiteSpace(guest.FirstName) ? guest.FirstName.Substring(0, 1).ToUpper() : "";
        var last = !string.IsNullOrWhiteSpace(guest.Surname) ? guest.Surname.Substring(0, 1).ToUpper() : "";

        var initials = $"{first}{last}";

        return string.IsNullOrWhiteSpace(initials) ? "G" : initials;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/guest/search");
    }
}