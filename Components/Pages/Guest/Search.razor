@page "/guest/search"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services

@inject GuestService GuestService
@inject ServiceRecordAccessService ServiceRecordAccessService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Guest Search - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to search guest records.</p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else if (isLoading)
{
    <div class="worker360-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-4">
                <div class="spinner-border text-primary"></div>

                <div class="mt-2 text-muted">
                    Loading Guest Search...
                </div>
            </div>
        </div>
    </div>
}
else if (!canAccessGuestManagement)
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>

        <p>
            You must have the Guest Management privilege and either belong
            to the FIG Directorate, have FIG as your secondary department,
            or hold an authorised leadership role.
        </p>

        <button type="button"
                class="bcc-btn bcc-btn-primary"
                @onclick="GoBack">
            Return to Guest Management
        </button>
    </div>
}
else
{
    <div class="worker360-page guest-search-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        <div class="bcc-page-header guest-search-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-search me-2"></i>
                    Guest Management
                </div>

                <div class="bcc-page-title">
                    Guest Search
                </div>

                <div class="bcc-page-subtitle">
                    Search, view and follow up first timers and second timers.
                </div>
            </div>

            <button type="button"
                    class="bcc-btn profile-form-secondary-btn compact-btn"
                    @onclick="GoBack">
                <i class="fas fa-arrow-left me-2"></i>
                Back
            </button>
        </div>

        <div class="guest-summary-strip mb-3">

            <div>
                <span>Results</span>
                <strong>@searchResults.Count</strong>
            </div>

            <div>
                <span>First Timers</span>
                <strong>@searchResults.Count(g => !g.IsSecondTimer)</strong>
            </div>

            <div>
                <span>Second Timers</span>
                <strong>@searchResults.Count(g => g.IsSecondTimer)</strong>
            </div>

            <div class="today">
                <span>Today</span>
                <strong>
                    @searchResults.Count(g =>
                    g.VisitingDate.Date == DateTime.Today)
            </strong>
        </div>

    </div>

    <div class="row g-3">

        <div class="col-12 col-xl-4">
            <div class="bcc-card h-100">
                <div class="bcc-card-body p-3">

                    <div class="compact-section-heading">
                        <div>
                            <h6>
                                <i class="fas fa-filter me-2"></i>
                                Search Criteria
                            </h6>

                            <p>
                                Use one or more fields to find a guest.
                            </p>
                        </div>
                    </div>

                    <div class="search-tip">
                        <i class="fas fa-lightbulb"></i>

                        <span>
                            Guest number or phone usually gives the fastest result.
                        </span>
                    </div>

                    <div class="row g-2">

                        <div class="col-12">
                            <label class="form-label compact-label">
                                Guest Name
                            </label>

                            <InputText class="form-control form-control-sm"
                                       @bind-Value="searchName"
                                       placeholder="First name, surname or full name" />
                        </div>

                        <div class="col-12">
                            <label class="form-label compact-label">
                                Phone Number
                            </label>

                            <InputText class="form-control form-control-sm"
                                       @bind-Value="searchPhone"
                                       placeholder="Phone, WhatsApp or current number" />
                        </div>

                        <div class="col-12">
                            <label class="form-label compact-label">
                                Guest Number
                            </label>

                            <InputText class="form-control form-control-sm"
                                       @bind-Value="searchGuestNumber"
                                       placeholder="e.g. 151223/1" />
                        </div>

                        <div class="col-6">
                            <label class="form-label compact-label">
                                Guest Type
                            </label>

                            <select class="form-select form-select-sm"
                                    @bind="guestType">
                                <option value="">All Guests</option>
                                <option value="first">First Timers</option>
                                <option value="second">Second Timers</option>
                            </select>
                        </div>

                        <div class="col-6">
                            <label class="form-label compact-label">
                                Sort By
                            </label>

                            <select class="form-select form-select-sm"
                                    @bind="sortBy">
                                <option value="date">Date Newest</option>
                                <option value="name">Name A-Z</option>
                                <option value="number">Guest Number</option>
                            </select>
                        </div>

                        <div class="col-6">
                            <label class="form-label compact-label">
                                From Date
                            </label>

                            <InputDate class="form-control form-control-sm"
                                       @bind-Value="startDate" />
                        </div>

                        <div class="col-6">
                            <label class="form-label compact-label">
                                To Date
                            </label>

                            <InputDate class="form-control form-control-sm"
                                       @bind-Value="endDate" />
                        </div>

                    </div>

                    <div class="mt-3 d-flex justify-content-end gap-2">
                        <button type="button"
                                class="bcc-btn profile-form-secondary-btn compact-btn"
                                disabled="@isSearching"
                                @onclick="ResetSearch">
                            Reset
                        </button>

                        <button type="button"
                                class="bcc-btn bcc-btn-primary compact-btn"
                                disabled="@isSearching"
                                @onclick="SearchGuests">

                            @if (isSearching)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Searching...</span>
                                }
                                else
                                {
                                    <i class="fas fa-search me-2"></i>
                                    <span>Search</span>
                                }

                            </button>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-8">
                <div class="bcc-card">
                    <div class="bcc-card-body p-3">

                        <div class="result-heading">
                            <div>
                                <h6>Guest Results</h6>

                                <p>
                                    @if (hasSearched)
                                    {
                                        <span>@searchResults.Count matching guest(s)</span>
                                    }
                                    else
                                    {
                                        <span>No search performed yet</span>
                                    }
                                </p>
                            </div>

                            @if (searchResults.Any())
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <span class="result-count-badge">
                                        @searchResults.Count
                                    </span>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            @onclick="ExportToExcel">
                                        <i class="fas fa-download me-1"></i>
                                        Export
                                    </button>
                                </div>
                            }
                        </div>

                        @if (!hasSearched)
                        {
                            <div class="bcc-empty py-4">
                                <i class="fas fa-search"></i>
                                <h4>Search Guest Records</h4>
                                <p>Use the filters on the left to search.</p>
                            </div>
                        }
                        else if (!searchResults.Any())
                        {
                            <div class="bcc-empty py-4">
                                <i class="fas fa-user-slash"></i>
                                <h4>No Guests Found</h4>
                                <p>Try changing the search criteria.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0 guest-search-table">
                                    <thead>
                                        <tr>
                                            <th>Guest</th>
                                            <th>Contact</th>
                                            <th>Visit</th>
                                            <th>Service</th>
                                            <th>Status</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var guest in searchResults)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="guest-name-cell">
                                                        <div class="guest-avatar">
                                                            @GetInitials(guest)
                                                        </div>

                                                        <div>
                                                            <strong>
                                                                @guest.Title
                                                                @guest.FirstName
                                                                @guest.Surname
                                                            </strong>

                                                            <span>
                                                                @guest.GuestNumber
                                                                @if (!string.IsNullOrWhiteSpace(guest.Sex))
                                                                {
                                                                    <text> · @guest.Sex</text>
                                                                }

                                                                @if (!string.IsNullOrWhiteSpace(guest.AgeGroup))
                                                                {
                                                                    <text> · @guest.AgeGroup</text>
                                                                }
                                                            </span>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td>
                                                    <div class="contact-stack">
                                                        @if (!string.IsNullOrWhiteSpace(guest.PhoneNumber))
                                                        {
                                                            <span>
                                                                <i class="fas fa-phone"></i>
                                                                @guest.PhoneNumber
                                                            </span>
                                                        }

                                                        @if (!string.IsNullOrWhiteSpace(guest.Email))
                                                        {
                                                            <span>
                                                                <i class="fas fa-envelope"></i>
                                                                @guest.Email
                                                            </span>
                                                        }

                                                        @if (string.IsNullOrWhiteSpace(guest.PhoneNumber) &&
                                                                                                    string.IsNullOrWhiteSpace(guest.Email))
                                                        {
                                                            <span>—</span>
                                                        }
                                                </div>
                                            </td>

                                            <td>
                                                @(guest.VisitingDate
                                                                                        .ToString("dd MMM yyyy"))
                                                                                                             </td>

                                            <td>
                                                @(guest.Service?.Name
                                                                                        ?? "Not available")
                                                                                                       </td>

                                            <td>
                                                <span class="guest-type-badge
                                                                @(guest.IsSecondTimer ? "second" : "first")">
                                                    @(guest.IsSecondTimer
                                                                                                ? "Second Timer"
                                                                                                : "First Timer")
                                        </span>
                                    </td>

                                                <td class="text-end">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary me-1"
                                                            title="View Details"
                                                            @onclick="() => ViewGuestDetails(guest.Id)">
                                                        <i class="fas fa-eye"></i>
                                                    </button>

                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-success me-1"
                                                            title="Phone Follow-up"
                                                            @onclick="() => RecordPhoneFollowUp(guest.Id)">
                                                        <i class="fas fa-phone-alt"></i>
                                                    </button>

                                        @if (!guest.IsSecondTimer)
                                                    {
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-warning"
                                                                title="Record Second Visit"
                                                                @onclick="() => MarkAsSecondTimer(guest.Id)">
                                                            <i class="fas fa-user-check"></i>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                    </div>
                </div>
            </div>

        </div>
    </div>
}

@if (selectedGuest != null && showDetailsModal)
{
    <div class="guest-popup-backdrop"
         @onclick="CloseDetailsModal">

        <div class="guest-popup-card"
             @onclick:stopPropagation="true">

            <div class="guest-popup-header">
                <div class="guest-popup-profile">
                    <div class="guest-avatar-large">
                        @GetInitials(selectedGuest)
                    </div>

                    <div>
                        <h4>
                            @selectedGuest.Title
                            @selectedGuest.FirstName
                            @selectedGuest.Surname
                        </h4>

                        <p>@selectedGuest.GuestNumber</p>
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        @onclick="CloseDetailsModal">
                </button>
            </div>

            <div class="guest-popup-tabs">

                <button type="button"
                        class="@GetModalTabClass("overview")"
                        @onclick='() => SetModalTab("overview")'>
                    Overview
                </button>

                <button type="button"
                        class="@GetModalTabClass("contact")"
                        @onclick='() => SetModalTab("contact")'>
                    Contact
                </button>

                <button type="button"
                        class="@GetModalTabClass("church")"
                        @onclick='() => SetModalTab("church")'>
                    Church
                </button>

                @if (selectedGuest.IsSecondTimer)
                {
                    <button type="button"
                            class="@GetModalTabClass("second")"
                            @onclick='() => SetModalTab("second")'>
                        Second Visit
                    </button>
                }

            </div>

            <div class="guest-detail-grid">

                @if (modalTab == "overview")
                {
                    @DetailItem(
                    "Full Name",
                        $"{selectedGuest.Title} {selectedGuest.FirstName} {selectedGuest.MiddleName} {selectedGuest.Surname}")

            @DetailItem("Sex", selectedGuest.Sex)
            @DetailItem("Age Group", selectedGuest.AgeGroup)

            @DetailItem(
                        "First Visit",
                        selectedGuest.VisitingDate.ToString("dd MMM yyyy"))

            @DetailItem(
                        "Recorded By",
                        selectedGuest.RecordedByName)
                        }

                @if (modalTab == "contact")
                {
                    @DetailItem("Phone", selectedGuest.PhoneNumber)
                    @DetailItem("WhatsApp", selectedGuest.WhatsAppNumber)
                    @DetailItem("Email", selectedGuest.Email)
                    @DetailItem("Address", selectedGuest.Address)
                    @DetailItem("Landmark", selectedGuest.Landmark)
                }

                @if (modalTab == "church")
                {
                    @DetailItem(
                    "Service Attended",
                        selectedGuest.Service?.Name)

            @DetailItem(
                        "RCCG Member",
                        selectedGuest.IsRCCGMember ? "Yes" : "No")

            @DetailItem(
                        "Other Church",
                        selectedGuest.OtherChurch)

            @DetailItem(
                        "How Found Us",
                        selectedGuest.HowFoundUs)

            @DetailItem(
                        "Invited By",
                        selectedGuest.InvitedByName)
                        }

                @if (modalTab == "second" &&
                            selectedGuest.IsSecondTimer)
                {
                    @DetailItem(
                    "Second Visit Date",
                        selectedGuest.SecondVisitDate?
                        .ToString("dd MMM yyyy"))

            @DetailItem(
                        "Wants Membership",
                        FormatNullableBool(
                        selectedGuest.WantsToBecomeMember))

            @DetailItem(
                        "Birth Month",
                        selectedGuest.BirthMonth)

            @DetailItem(
                        "Baptised by Water",
                        FormatNullableBool(
                        selectedGuest.IsBaptisedByWater))

            @DetailItem(
                        "Join Workforce",
                        FormatNullableBool(
                        selectedGuest.WantsToJoinWorkforce))

            @DetailItem(
                        "Recorded By",
                        selectedGuest.SecondVisitRecordedByName)
                        }

            </div>

            <div class="mt-3 d-flex justify-content-end gap-2 flex-wrap">

                <button type="button"
                        class="bcc-btn profile-form-secondary-btn compact-btn"
                        @onclick="CloseDetailsModal">
                    Close
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-success"
                        @onclick="() => RecordPhoneFollowUp(selectedGuest.Id)">
                    <i class="fas fa-phone-alt me-1"></i>
                    Phone Follow-up
                </button>

                @if (!selectedGuest.IsSecondTimer)
                {
                    <button type="button"
                            class="btn btn-sm btn-warning"
                            @onclick="() => MarkAsSecondTimer(selectedGuest.Id)">
                        <i class="fas fa-user-check me-1"></i>
                        Record Second Visit
                    </button>
                }

            </div>

        </div>
    </div>
}

@code {
    private List<Guest> searchResults = new();

    private Guest? selectedGuest;

    private string searchName = string.Empty;
    private string searchPhone = string.Empty;
    private string searchGuestNumber = string.Empty;

    private DateTime? startDate;
    private DateTime? endDate;

    private string guestType = string.Empty;
    private string sortBy = "date";

    private bool isLoading = true;
    private bool isSearching;
    private bool hasSearched;
    private bool showDetailsModal;
    private bool canAccessGuestManagement;

    private string modalTab = "overview";
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            var worker = AuthService.CurrentWorker;

            if (worker == null)
            {
                canAccessGuestManagement = false;
                return;
            }

            var access =
                await ServiceRecordAccessService
                    .GetAccessAsync(worker.Id);

            var hasGuestPrivilege =
                access.CanAccessGuestManagement;

            var isFigDirectorate =
                IsFigName(worker.Directorate?.Name);

            var isSecondaryDepartmentFig =
                IsFigName(worker.SecondaryDepartment?.Name);

            var hasAuthorisedRole =
                AuthService.IsInRole("Church Admin") ||
                AuthService.IsInRole("Head of Service") ||
                AuthService.IsInRole("Pastor in Charge");

            canAccessGuestManagement =
                hasGuestPrivilege &&
                (
                    isFigDirectorate ||
                    isSecondaryDepartmentFig ||
                    hasAuthorisedRole
                );
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load Guest Search: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchGuests()
    {
        try
        {
            isSearching = true;
            hasSearched = true;
            errorMessage = string.Empty;

            var allGuests =
                await GuestService.GetAllGuestsAsync();

            var query =
                allGuests.AsQueryable();

            if (!string.IsNullOrWhiteSpace(searchName))
            {
                var keyword = searchName.Trim();

                query = query.Where(g =>
                    (g.FirstName ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase) ||

                    (g.Surname ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase) ||

                    (g.FullName ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(searchPhone))
            {
                var keyword = searchPhone.Trim();

                query = query.Where(g =>
                    (g.PhoneNumber ?? string.Empty)
                        .Contains(keyword) ||

                    (g.WhatsAppNumber ?? string.Empty)
                        .Contains(keyword) ||

                    (g.CurrentPhoneNumber ?? string.Empty)
                        .Contains(keyword));
            }

            if (!string.IsNullOrWhiteSpace(
                searchGuestNumber))
            {
                var keyword =
                    searchGuestNumber.Trim();

                query = query.Where(g =>
                    (g.GuestNumber ?? string.Empty)
                        .Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase));
            }

            if (startDate.HasValue)
            {
                query = query.Where(g =>
                    g.VisitingDate.Date >=
                    startDate.Value.Date);
            }

            if (endDate.HasValue)
            {
                query = query.Where(g =>
                    g.VisitingDate.Date <=
                    endDate.Value.Date);
            }

            if (guestType == "first")
            {
                query = query.Where(g =>
                    !g.IsSecondTimer);
            }
            else if (guestType == "second")
            {
                query = query.Where(g =>
                    g.IsSecondTimer);
            }

            searchResults =
                sortBy switch
                {
                    "name" =>
                        query
                            .OrderBy(g => g.Surname)
                            .ThenBy(g => g.FirstName)
                            .ToList(),

                    "number" =>
                        query
                            .OrderBy(g => g.GuestNumber)
                            .ToList(),

                    _ =>
                        query
                            .OrderByDescending(g =>
                                g.VisitingDate)
                            .ToList()
                };
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to search guests: {ex.Message}";
        }
        finally
        {
            isSearching = false;
        }
    }

    private void ResetSearch()
    {
        searchName = string.Empty;
        searchPhone = string.Empty;
        searchGuestNumber = string.Empty;
        startDate = null;
        endDate = null;
        guestType = string.Empty;
        sortBy = "date";

        searchResults.Clear();
        hasSearched = false;
        errorMessage = string.Empty;
    }

    private async Task ViewGuestDetails(
        int guestId)
    {
        selectedGuest =
            await GuestService
                .GetGuestByIdAsync(guestId);

        if (selectedGuest != null)
        {
            modalTab = "overview";
            showDetailsModal = true;
        }
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedGuest = null;
    }

    private void MarkAsSecondTimer(
        int guestId)
    {
        Navigation.NavigateTo(
            $"/guest/second-timer?guestId={guestId}");
    }

    private void RecordPhoneFollowUp(
        int guestId)
    {
        Navigation.NavigateTo(
            $"/guest/phone-followup?guestId={guestId}");
    }

    private void ExportToExcel()
    {
        Console.WriteLine(
            "Export to Excel functionality");
    }

    private void SetModalTab(
        string tab)
    {
        modalTab = tab;
    }

    private string GetModalTabClass(
        string tab)
    {
        return modalTab == tab
            ? "guest-popup-tab active"
            : "guest-popup-tab";
    }

    private static bool IsFigName(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        return string.Equals(
                   value.Trim(),
                   "FIG",
                   StringComparison.OrdinalIgnoreCase)
               ||
               value.Contains(
                   "FIG",
                   StringComparison.OrdinalIgnoreCase);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/guest");
    }

    private static string GetInitials(
        Guest guest)
    {
        var first =
            string.IsNullOrWhiteSpace(guest.FirstName)
                ? string.Empty
                : guest.FirstName[..1];

        var last =
            string.IsNullOrWhiteSpace(guest.Surname)
                ? string.Empty
                : guest.Surname[..1];

        var initials =
            $"{first}{last}".ToUpperInvariant();

        return string.IsNullOrWhiteSpace(initials)
            ? "G"
            : initials;
    }

    private static string FormatNullableBool(
        bool? value)
    {
        return value.HasValue
            ? (value.Value ? "Yes" : "No")
            : "Not provided";
    }

    private RenderFragment DetailItem(
        string label,
        string? value) => @<div class="guest-detail-item">
        <span>@label</span>
        <strong>
            @(string.IsNullOrWhiteSpace(value)
                ? "Not provided"
                : value)
                    </strong>
                </div>;
}

<style>
    .guest-search-page {
        max-width: 1500px;
        margin: 0 auto;
    }

    .guest-search-header {
        margin-bottom: 14px;
    }

    .compact-btn {
        min-height: 32px;
        padding: 6px 11px;
        font-size: 0.78rem;
    }

    .guest-summary-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
    }

        .guest-summary-strip > div {
            padding: 10px 12px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
        }

        .guest-summary-strip span {
            display: block;
            margin-bottom: 2px;
            color: #64748b;
            font-size: 0.66rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .guest-summary-strip strong {
            color: #0f172a;
            font-size: 1.02rem;
            font-weight: 800;
        }

        .guest-summary-strip .today {
            background: #eef2ff;
            border-color: #c7d2fe;
        }

            .guest-summary-strip .today strong {
                color: #4338ca;
            }

    .compact-section-heading,
    .result-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

