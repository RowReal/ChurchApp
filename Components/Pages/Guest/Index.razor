@page "/guest"
@layout Components.Layout.MainLayout

@using ChurchApp.Models
@using ChurchApp.Services

@inject GuestService GuestService
@inject AuthService AuthService
@inject ServiceRecordAccessService ServiceRecordAccessService
@inject NavigationManager Navigation

<PageTitle>Guest Management - BCC ServiceHub</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access Guest Management.</p>

        <a href="/login"
           class="bcc-btn bcc-btn-primary">
            Go to Login
        </a>
    </div>
}
else if (isLoading)
{
    <div class="worker360-page">
        <div class="bcc-card">
            <div class="bcc-card-body text-center py-4">
                <div class="spinner-border text-primary"></div>
                <div class="mt-2 text-muted">
                    Loading Guest Management...
                </div>
            </div>
        </div>
    </div>
}
else if (!canAccessGuestManagement)
{
    <div class="bcc-empty">
        <i class="fas fa-ban"></i>
        <h4>Access Denied</h4>

        <p>
            You must have the Guest Management privilege and meet at least
            one of these conditions: belong to the FIG Directorate, have FIG
            as your secondary department, or hold an authorised leadership role.
        </p>

        <button type="button"
                class="bcc-btn bcc-btn-primary"
                @onclick="GoBack">
            Return to Dashboard
        </button>
    </div>
}
else
{
    <div class="worker360-page guest-dashboard-page">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2">
                <i class="fas fa-exclamation-circle me-2"></i>
                @errorMessage
            </div>
        }

        <div class="bcc-page-header guest-page-header">
            <div>
                <div class="bcc-page-subtitle">
                    <i class="fas fa-user-friends me-2"></i>
                    Service Records
                </div>

                <div class="bcc-page-title">
                    Guest Management
                </div>

                <div class="bcc-page-subtitle">
                    Record guests, manage repeat visits and review follow-up activity.
                </div>
            </div>

            <button type="button"
                    class="bcc-btn profile-form-secondary-btn compact-btn"
                    @onclick="GoBack">
                <i class="fas fa-arrow-left me-2"></i>
                Back
            </button>
        </div>

        <div class="guest-summary-strip mb-3">

            <div class="guest-summary-item">
                <span>Total Guests</span>
                <strong>@(stats?.TotalGuests ?? 0)</strong>
            </div>

            <div class="guest-summary-item">
                <span>First Timers</span>
                <strong>@(stats?.FirstTimers ?? 0)</strong>
            </div>

            <div class="guest-summary-item">
                <span>Second Timers</span>
                <strong>@(stats?.SecondTimers ?? 0)</strong>
            </div>

            <div class="guest-summary-item conversion">
                <span>Conversion Rate</span>
                <strong>
                    @(stats?.ConversionRate.ToString("0.0") ?? "0.0")%
                </strong>
            </div>

        </div>

        <div class="bcc-card">
            <div class="bcc-card-body p-3">

                <div class="guest-actions-heading">
                    <div>
                        <h6>Guest Management Functions</h6>
                        <p>Select the function you want to open.</p>
                    </div>
                </div>

                <div class="row g-2">

                    <div class="col-12 col-md-6">
                        <a href="/guest/first-timer"
                           class="guest-action-card">

                            <div class="guest-action-icon first-timer">
                                <i class="fas fa-user-plus"></i>
                            </div>

                            <div class="guest-action-content">
                                <h6>Record First Timer</h6>
                                <p>
                                    Capture information for a guest visiting for the first time.
                                </p>
                            </div>

                            <i class="fas fa-chevron-right guest-action-arrow"></i>
                        </a>
                    </div>

                    <div class="col-12 col-md-6">
                        <a href="/guest/second-timer"
                           class="guest-action-card">

                            <div class="guest-action-icon second-timer">
                                <i class="fas fa-user-check"></i>
                            </div>

                            <div class="guest-action-content">
                                <h6>Record Second Timer</h6>
                                <p>
                                    Find an existing guest and record a second visit.
                                </p>
                            </div>

                            <i class="fas fa-chevron-right guest-action-arrow"></i>
                        </a>
                    </div>

                    <div class="col-12 col-md-6">
                        <a href="/guest/search"
                           class="guest-action-card">

                            <div class="guest-action-icon search">
                                <i class="fas fa-search"></i>
                            </div>

                            <div class="guest-action-content">
                                <h6>Search All Guests</h6>
                                <p>
                                    Search guest records by name, phone, date or guest number.
                                </p>
                            </div>

                            <i class="fas fa-chevron-right guest-action-arrow"></i>
                        </a>
                    </div>

                    <div class="col-12 col-md-6">
                        <a href="/guest/Followup-Report"
                           class="guest-action-card">

                            <div class="guest-action-icon follow-up">
                                <i class="fas fa-clipboard-check"></i>
                            </div>

                            <div class="guest-action-content">
                                <h6>Guest Follow-Up Report</h6>
                                <p>
                                    Review guest follow-up records and activity.
                                </p>
                            </div>

                            <i class="fas fa-chevron-right guest-action-arrow"></i>
                        </a>
                    </div>

                    <div class="col-12 col-md-6">
                        <a href="/guest/daily-list"
                           class="guest-action-card">

                            <div class="guest-action-icon daily">
                                <i class="fas fa-calendar-day"></i>
                            </div>

                            <div class="guest-action-content">
                                <h6>Today's Guest List</h6>
                                <p>
                                    View guests recorded for the current day.
                                </p>
                            </div>

                            <i class="fas fa-chevron-right guest-action-arrow"></i>
                        </a>
                    </div>

                </div>

            </div>
        </div>

        <div class="guest-footer-note mt-3">
            <span>
                <i class="fas fa-user-shield me-1"></i>
                Signed in as
                <strong>
                    @AuthService.CurrentWorker?.FirstName
                    @AuthService.CurrentWorker?.LastName
                </strong>
            </span>

            <span>
                <i class="fas fa-clock me-1"></i>
                Updated
                <strong>
                    @(DateTime.Now.ToString("dd MMM yyyy, hh:mm tt"))
                </strong>
            </span>
        </div>

    </div>
}

@code {
    private GuestStatistics? stats;

    private bool isLoading = true;
    private bool canAccessGuestManagement;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var worker = AuthService.CurrentWorker;

            if (worker == null)
            {
                canAccessGuestManagement = false;
                return;
            }

            var access =
                await ServiceRecordAccessService
                    .GetAccessAsync(worker.Id);

            var hasGuestPrivilege =
                access.CanAccessGuestManagement;

            var isFigDirectorate =
                IsFigName(worker.Directorate?.Name);

            var isSecondaryDepartmentFig =
                IsFigName(worker.SecondaryDepartment?.Name);

            var hasAuthorisedRole =
                AuthService.IsInRole("Church Admin") ||
                AuthService.IsInRole("Head of Service") ||
                AuthService.IsInRole("Pastor in Charge");

            canAccessGuestManagement =
                hasGuestPrivilege &&
                (
                    isFigDirectorate ||
                    isSecondaryDepartmentFig ||
                    hasAuthorisedRole
                );

            if (!canAccessGuestManagement)
                return;

            stats =
                await GuestService
                    .GetGuestStatisticsAsync();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load Guest Management: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static bool IsFigName(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        return string.Equals(
                   value.Trim(),
                   "FIG",
                   StringComparison.OrdinalIgnoreCase)
               ||
               value.Contains(
                   "FIG",
                   StringComparison.OrdinalIgnoreCase);
    }

    private void GoBack()
    {
        Navigation.NavigateTo(
            "/workspace/service-records");
    }
}

<style>
    .guest-dashboard-page {
        max-width: 1200px;
        margin: 0 auto;
    }

    .guest-page-header {
        margin-bottom: 14px;
    }

    .compact-btn {
        min-height: 32px;
        padding: 6px 11px;
        font-size: 0.78rem;
    }

    .guest-summary-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
    }

    .guest-summary-item {
        padding: 10px 12px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
    }

        .guest-summary-item span {
            display: block;
            margin-bottom: 2px;
            color: #64748b;
            font-size: 0.67rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .guest-summary-item strong {
            color: #0f172a;
            font-size: 1.05rem;
            font-weight: 800;
        }

        .guest-summary-item.conversion {
            background: #f0fdf4;
            border-color: #bbf7d0;
        }

            .guest-summary-item.conversion strong {
                color: #166534;
            }

    .guest-actions-heading {
        margin-bottom: 12px;
    }

        .guest-actions-heading h6 {
            margin: 0 0 2px;
            color: #0f172a;
            font-size: 0.9rem;
            font-weight: 800;
        }

        .guest-actions-heading p {
            margin: 0;
            color: #64748b;
            font-size: 0.72rem;
        }

    .guest-action-card {
        display: flex;
        align-items: center;
        gap: 11px;
        min-height: 88px;
        height: 100%;
        padding: 12px 14px;
        color: inherit;
        text-decoration: none;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }

        .guest-action-card:hover {
            color: inherit;
            text-decoration: none;
            border-color: #c7d2fe;
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
            transform: translateY(-2px);
        }

    .guest-action-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 42px;
        width: 42px;
        height: 42px;
        border-radius: 11px;
        font-size: 1rem;
    }

        .guest-action-icon.first-timer {
            color: #4338ca;
            background: #eef2ff;
        }

        .guest-action-icon.second-timer {
            color: #166534;
            background: #dcfce7;
        }

        .guest-action-icon.search {
            color: #b45309;
            background: #fef3c7;
        }

        .guest-action-icon.follow-up {
            color: #0369a1;
            background: #e0f2fe;
        }

        .guest-action-icon.daily {
            color: #7e22ce;
            background: #f3e8ff;
        }

    .guest-action-content {
        flex: 1;
        min-width: 0;
    }

        .guest-action-content h6 {
            margin: 0 0 3px;
            color: #0f172a;
            font-size: 0.85rem;
            font-weight: 800;
        }

        .guest-action-content p {
            margin: 0;
            color: #64748b;
            font-size: 0.72rem;
            line-height: 1.4;
        }

    .guest-action-arrow {
        flex-shrink: 0;
        color: #94a3b8;
        font-size: 0.75rem;
    }

    .guest-footer-note {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 9px 12px;
        color: #64748b;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        font-size: 0.7rem;
    }

        .guest-footer-note strong {
            color: #334155;
        }

    @@media (max-width: 768px) {
        .guest-summary-strip {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .guest-footer-note {
            flex-direction: column;
        }
    }

    @@media (max-width: 576px) {
        .guest-summary-strip {
            grid-template-columns: 1fr;
        }

        .guest-action-card {
            min-height: 82px;
            padding: 11px 12px;
        }
    }
</style>


<style>
    .hover-shadow:hover {
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        transform: translateY(-2px);
        transition: all 0.3s ease;
    }

    .bg-dark-blue {
        background-color: #2c3e50;
    }

    .card {
        transition: transform 0.2s;
    }

        .card:hover {
            transform: translateY(-3px);
        }

    .btn {
        transition: all 0.2s;
    }

        .btn:hover {
            transform: translateY(-1px);
        }
</style>
