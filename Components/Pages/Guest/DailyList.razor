@page "/guest/daily-list"
@layout Components.Layout.MainLayout
@using ChurchApp.Services
@using ChurchApp.Models
@inject GuestService GuestService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Daily Guest Register - BCC ServiceHub</PageTitle>

@if (AuthService.IsAuthenticated)
{
    @if (!IsFIGDirectorateMember())
    {
        <div class="bcc-empty">
            <i class="fas fa-lock"></i>
            <h4>Access Restricted</h4>
            <p>This section is only accessible to authorised FIG Directorate members.</p>
            <a href="/guest" class="bcc-btn bcc-btn-primary">Back to Guest Management</a>
        </div>
    }
    else
    {
        <div class="guest-search-v2-page">

            <div class="bcc-page-header">
                <div>
                    <div class="bcc-page-subtitle">
                        <i class="fas fa-users me-2"></i>
                        Guest Management
                    </div>
                    <div class="bcc-page-title">Daily Guest Register</div>
                    <div class="bcc-page-subtitle">
                        Review and manage guests recorded for @selectedDate.ToString("dddd, dd MMMM yyyy").
                    </div>
                </div>

                <a href="/guest/first-timer" class="bcc-btn bcc-btn-primary">
                    <i class="fas fa-user-plus me-2"></i>
                    Add New Guest
                </a>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="team-summary-card">
                        <span>Total Guests</span>
                        <strong>@guests.Count</strong>
                        <i class="fas fa-users"></i>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="team-summary-card directorate">
                        <span>First Timers</span>
                        <strong>@firstTimerCount</strong>
                        <i class="fas fa-user-plus"></i>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="team-summary-card active">
                        <span>Second Timers</span>
                        <strong>@secondTimerCount</strong>
                        <i class="fas fa-user-check"></i>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="team-summary-card inactive">
                        <span>Conversion</span>
                        <strong>@conversionRate.ToString("0.0")%</strong>
                        <i class="fas fa-chart-line"></i>
                    </div>
                </div>
            </div>

            <div class="bcc-card mb-4">
                <div class="bcc-card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="profile-form-label">Selected Date</label>
                            <input type="date"
                                   class="form-control bcc-input"
                                   @bind="selectedDate"
                                   @bind:format="yyyy-MM-dd"
                                   @bind:after="OnDateChanged" />
                        </div>

                        <div class="col-md-8">
                            <div class="d-flex gap-2 flex-wrap">
                                <button class="bcc-btn profile-form-secondary-btn" @onclick="PreviousDay">
                                    <i class="fas fa-chevron-left me-2"></i>
                                    Previous Day
                                </button>

                                <button class="bcc-btn bcc-btn-primary" @onclick="GoToToday">
                                    <i class="fas fa-calendar-day me-2"></i>
                                    Today
                                </button>

                                <button class="bcc-btn profile-form-secondary-btn" @onclick="NextDay">
                                    Next Day
                                    <i class="fas fa-chevron-right ms-2"></i>
                                </button>

                                <a href="/guest" class="bcc-btn profile-form-secondary-btn ms-auto">
                                    <i class="fas fa-arrow-left me-2"></i>
                                    Back
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bcc-card">
                <div class="bcc-card-header">
                    <div class="profile-v2-card-icon green">
                        <i class="fas fa-list-alt"></i>
                    </div>
                    <div class="bcc-card-title">
                        Guest List (@guests.Count)
                    </div>
                </div>

                <div class="bcc-card-body p-0">
                    @if (isLoading)
                    {
                        <div class="bcc-empty">
                            <div class="spinner-border text-primary"></div>
                            <p class="mt-3">Loading guest list...</p>
                        </div>
                    }
                    else if (guests.Any())
                    {
                        <div class="notice-table-wrapper">
                            <table class="table notice-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Guest</th>
                                        <th>Contact</th>
                                        <th>Service</th>
                                        <th>Recorded By</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var guest in guests)
                                    {
                                        <tr>
                                            <td>
                                                <div class="notice-title-cell">
                                                    <div class="guest-avatar">
                                                        @GetInitials(guest)
                                                    </div>

                                                    <div>
                                                        <strong>@guest.Title @guest.FirstName @guest.Surname</strong>
                                                        <span>@guest.GuestNumber • @guest.Sex • @guest.AgeGroup</span>
                                                    </div>
                                                </div>
                                            </td>

                                            <td>
                                                @if (!string.IsNullOrEmpty(guest.PhoneNumber))
                                                {
                                                    <div class="guest-contact-line">
                                                        <i class="fas fa-phone"></i>
                                                        @guest.PhoneNumber
                                                    </div>
                                                }

                                                @if (!string.IsNullOrEmpty(guest.WhatsAppNumber))
                                                {
                                                    <div class="guest-contact-line">
                                                        <i class="fab fa-whatsapp"></i>
                                                        @guest.WhatsAppNumber
                                                    </div>
                                                }
                                            </td>

                                            <td>
                                                <strong>@guest.Service?.Name</strong>
                                                <div class="church-update-muted">
                                                    @guest.VisitingDate.ToString("dd MMM yyyy")
                                                </div>
                                            </td>

                                            <td>
                                                <strong>@guest.RecordedByName</strong>
                                                <div class="church-update-muted">
                                                    @guest.RecordingDate.ToString("h:mm tt")
                                                </div>
                                            </td>

                                            <td>
                                                @if (guest.IsSecondTimer)
                                                {
                                                    <span class="notice-status active">
                                                        <i class="fas fa-user-check me-1"></i>
                                                        Second Timer
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="notice-status notice-prayer">
                                                        <i class="fas fa-user-plus me-1"></i>
                                                        First Timer
                                                    </span>
                                                }
                                            </td>

                                            <td class="text-end">
                                                <button class="notice-action-btn edit"
                                                        title="View Details"
                                                        @onclick="() => ViewGuestDetails(guest.Id)">
                                                    <i class="fas fa-eye"></i>
                                                </button>

                                                <button class="notice-action-btn toggle"
                                                        title="Phone Follow-up"
                                                        @onclick="() => RecordPhoneFollowUp(guest.Id)">
                                                    <i class="fas fa-phone-alt"></i>
                                                </button>

                                                <a class="notice-action-btn toggle"
                                                   title="Edit Guest"
                                                   href="/guest/edit/@guest.Id">
                                                    <i class="fas fa-pen"></i>
                                                </a>

                                                @if (!guest.IsSecondTimer)
                                                {
                                                    <button class="notice-action-btn delete"
                                                            title="Record Second Visit"
                                                            @onclick="() => MarkAsSecondTimer(guest.Id)">
                                                        <i class="fas fa-user-check"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="bcc-empty">
                            <i class="fas fa-users"></i>
                            <h4>No Guest Recorded Yet</h4>
                            <p>No guests have been recorded for @selectedDate.ToString("dd MMMM yyyy").</p>
                            <a href="/guest/first-timer" class="bcc-btn bcc-btn-primary">
                                <i class="fas fa-user-plus me-2"></i>
                                Record First Guest
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access this page.</p>
        <a href="/login" class="bcc-btn bcc-btn-primary">Go to Login</a>
    </div>
}

@if (selectedGuest != null && showDetailsModal)
{
    <div class="team-modal-backdrop" @onclick="CloseDetailsModal">
        <div class="guest360-modal" @onclick:stopPropagation="true">

            <button class="team-modal-close" @onclick="CloseDetailsModal">
                <i class="fas fa-times"></i>
            </button>

            <div class="guest360-header">
                <div class="guest360-avatar">
                    @GetInitials(selectedGuest)
                </div>

                <div>
                    <h4>@selectedGuest.Title @selectedGuest.FirstName @selectedGuest.Surname</h4>
                    <p>Guest No: @selectedGuest.GuestNumber</p>

                    @if (selectedGuest.IsSecondTimer)
                    {
                        <span class="notice-status active">Second Timer</span>
                    }
                    else
                    {
                        <span class="notice-status notice-prayer">First Timer</span>
                    }
                </div>
            </div>

            <div class="profile-form-v2-tabs guest360-tabs">
                <button type="button" class="@GetModalTabClass("overview")" @onclick='() => SetModalTab("overview")'>
                    <i class="fas fa-user"></i> Overview
                </button>

                <button type="button" class="@GetModalTabClass("contact")" @onclick='() => SetModalTab("contact")'>
                    <i class="fas fa-phone"></i> Contact
                </button>

                <button type="button" class="@GetModalTabClass("church")" @onclick='() => SetModalTab("church")'>
                    <i class="fas fa-church"></i> Church
                </button>

                @if (selectedGuest.IsSecondTimer)
                {
                    <button type="button" class="@GetModalTabClass("second")" @onclick='() => SetModalTab("second")'>
                        <i class="fas fa-user-check"></i> Second Visit
                    </button>
                }
            </div>

            <div class="guest360-body">
                @if (modalTab == "overview")
                {
                    @DetailRow("Full Name", $"{selectedGuest.Title} {selectedGuest.FirstName} {selectedGuest.MiddleName} {selectedGuest.Surname}")
                    @DetailRow("Sex", selectedGuest.Sex)
                    @DetailRow("Age Group", selectedGuest.AgeGroup)
                    @DetailRow("First Visit", selectedGuest.VisitingDate.ToString("dd MMM yyyy"))
                    @DetailRow("Recorded By", selectedGuest.RecordedByName)
                }

                @if (modalTab == "contact")
                {
                    @DetailRow("Phone", selectedGuest.PhoneNumber)
                    @DetailRow("WhatsApp", selectedGuest.WhatsAppNumber)
                    @DetailRow("Email", selectedGuest.Email)
                    @DetailRow("Address", selectedGuest.Address)
                    @DetailRow("Landmark", selectedGuest.Landmark)
                }

                @if (modalTab == "church")
                {
                    @DetailRow("Service Attended", selectedGuest.Service?.Name)
                    @DetailRow("RCCG Member", selectedGuest.IsRCCGMember ? "Yes" : "No")
                    @DetailRow("Other Church", selectedGuest.OtherChurch)
                    @DetailRow("How Found Us", selectedGuest.HowFoundUs)
                    @DetailRow("Invited By", selectedGuest.InvitedByName)
                }

                @if (modalTab == "second" && selectedGuest.IsSecondTimer)
                {
                    @DetailRow("Second Visit Date", selectedGuest.SecondVisitDate?.ToString("dd MMM yyyy"))
                    @DetailRow("Wants Membership", selectedGuest.WantsToBecomeMember == true ? "Yes" : "No")
                    @DetailRow("Birth Month", selectedGuest.BirthMonth)
                    @DetailRow("Baptised by Water", selectedGuest.IsBaptisedByWater == true ? "Yes" : "No")
                    @DetailRow("Join Workforce", selectedGuest.WantsToJoinWorkforce == true ? "Yes" : "No")
                    @DetailRow("Recorded By", selectedGuest.SecondVisitRecordedByName)
                }
            </div>

            <div class="guest360-actions">
                <button class="team-action-btn" @onclick="() => RecordPhoneFollowUp(selectedGuest.Id)">
                    <i class="fas fa-phone-alt me-1"></i>
                    Phone Follow-up
                </button>

                <a class="team-action-btn text-center" href="/guest/edit/@selectedGuest.Id">
                    <i class="fas fa-pen me-1"></i>
                    Edit
                </a>

                @if (!selectedGuest.IsSecondTimer)
                {
                    <button class="team-success-btn" @onclick="() => MarkAsSecondTimer(selectedGuest.Id)">
                        <i class="fas fa-user-check me-1"></i>
                        Record Second Visit
                    </button>
                }

                <button class="team-danger-btn" @onclick="CloseDetailsModal">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Guest> guests = new();
    private Guest? selectedGuest = null;

    private DateTime selectedDate = DateTime.Today;
    private bool isLoading = false;
    private bool showDetailsModal = false;
    private string errorMessage = "";

    private string modalTab = "overview";

    private int firstTimerCount => guests.Count(g => !g.IsSecondTimer);
    private int secondTimerCount => guests.Count(g => g.IsSecondTimer);
    private double conversionRate => guests.Count > 0 ? (double)secondTimerCount / guests.Count * 100 : 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadGuests();
    }

    private async Task LoadGuests()
    {
        isLoading = true;

        try
        {
            guests = await GuestService.GetGuestsByDateAsync(selectedDate);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading guests: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private bool IsFIGDirectorateMember()
    {
        var worker = AuthService.CurrentWorker;
        if (worker == null) return false;

        var directorateName = worker.Directorate?.Name?.ToLowerInvariant() ?? "";
        var departmentName = worker.Department?.Name?.ToLowerInvariant() ?? "";
        var secondaryDirectorateName = worker.SecondaryDirectorate?.Name?.ToLowerInvariant() ?? "";
        var secondaryDepartmentName = worker.SecondaryDepartment?.Name?.ToLowerInvariant() ?? "";
        var role = worker.Role?.ToLowerInvariant() ?? "";

        var isInFIG =
            directorateName.Contains("fig") ||
            secondaryDirectorateName.Contains("fig");

        var isMembershipAssimilation =
            departmentName.Contains("membership assimilation") ||
            secondaryDepartmentName.Contains("membership assimilation");

        var hasValidRole =
            role.Contains("head of directorate") ||
            role.Contains("asst head of directorate") ||
            role.Contains("directorate member") ||
            AuthService.IsInRole("Church Admin") ||
            AuthService.IsInRole("Pastor in Charge") ||
            (role.Contains("head of department") && isMembershipAssimilation);

        return (isInFIG || isMembershipAssimilation) && hasValidRole;
    }

    private async Task OnDateChanged()
    {
        await LoadGuests();
    }

    private async Task GoToToday()
    {
        selectedDate = DateTime.Today;
        await LoadGuests();
    }

    private async Task PreviousDay()
    {
        selectedDate = selectedDate.AddDays(-1);
        await LoadGuests();
    }

    private async Task NextDay()
    {
        selectedDate = selectedDate.AddDays(1);
        await LoadGuests();
    }

    private async Task ViewGuestDetails(int guestId)
    {
        try
        {
            selectedGuest = await GuestService.GetGuestByIdAsync(guestId);

            if (selectedGuest != null)
            {
                modalTab = "overview";
                showDetailsModal = true;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading guest details: {ex.Message}";
        }
    }

    private void SetModalTab(string tab) => modalTab = tab;

    private string GetModalTabClass(string tab)
    {
        return modalTab == tab ? "profile-form-tab active" : "profile-form-tab";
    }

    private void MarkAsSecondTimer(int guestId)
    {
        Navigation.NavigateTo($"/guest/second-timer?guestId={guestId}");
    }

    private void RecordPhoneFollowUp(int guestId)
    {
        Navigation.NavigateTo($"/guest/phone-followup?guestId={guestId}");
    }

    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedGuest = null;
    }

    private string GetInitials(Guest guest)
    {
        var first = string.IsNullOrWhiteSpace(guest.FirstName) ? "" : guest.FirstName[0].ToString();
        var last = string.IsNullOrWhiteSpace(guest.Surname) ? "" : guest.Surname[0].ToString();

        return $"{first}{last}".ToUpper();
    }

    private RenderFragment DetailRow(string label, string? value) => @<div class="bcc-info-row">
        <div class="bcc-info-label">@label</div>
        <div class="bcc-info-value">@(string.IsNullOrWhiteSpace(value) ? "Not provided" : value)</div>
    </div>;
}