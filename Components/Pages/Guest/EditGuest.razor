
@page "/guest/edit/{Id:int}"
@layout Components.Layout.MainLayout
@using ChurchApp.Services
@using ChurchApp.Models
@using ChurchApp.Components.Shared
@inject GuestService GuestService
@inject ServiceService ServiceService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Edit Guest - BCC ServiceHub</PageTitle>

@if (AuthService.IsAuthenticated)
{
    @if (!IsFIGDirectorateMember())
    {
        <div class="bcc-empty">
            <i class="fas fa-lock"></i>
            <h4>Access Restricted</h4>
            <p>This section is only accessible to authorised FIG Directorate members.</p>
            <a href="/guest/daily-list" class="bcc-btn bcc-btn-primary">Back to Daily List</a>
        </div>
    }
    else if (isLoading)
    {
        <div class="bcc-empty">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Loading guest information...</p>
        </div>
    }
    else if (guestNotFound)
    {
        <div class="bcc-empty">
            <i class="fas fa-user-slash"></i>
            <h4>Guest Not Found</h4>
            <p>The requested guest record could not be found.</p>
            <a href="/guest/daily-list" class="bcc-btn bcc-btn-primary">Back to Daily List</a>
        </div>
    }
    else
    {
        <div class="profile-form-v2-page guest-edit-v2-page">

            <div class="bcc-page-header">
                <div>
                    <div class="bcc-page-subtitle">
                        <i class="fas fa-user-edit me-2"></i>
                        Guest Management
                    </div>
                    <div class="bcc-page-title">Edit Guest</div>
                    <div class="bcc-page-subtitle">
                        Update guest record for <strong>@currentGuestName</strong> — @currentGuestNumber
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a href="/guest/daily-list" class="bcc-btn profile-form-secondary-btn">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </a>

                    <button class="bcc-btn team-danger-btn" @onclick="DeleteGuest">
                        <i class="fas fa-trash me-2"></i>Delete
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle me-2"></i>@successMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle me-2"></i>@errorMessage
                </div>
            }

            <div class="bcc-card profile-form-v2-hero">
                <div class="bcc-card-body">
                    <div class="row align-items-center g-4">
                        <div class="col-md-auto text-center">
                            <div class="guest360-avatar">
                                @GetInitials()
                            </div>
                        </div>

                        <div class="col">
                            <h3 class="profile-v2-name">@currentGuestName</h3>

                            <div class="profile-v2-meta">
                                <span><i class="fas fa-hashtag"></i>@currentGuestNumber</span>
                                <span><i class="fas fa-user"></i>@model.Sex</span>
                                <span><i class="fas fa-layer-group"></i>@model.AgeGroup</span>
                                <span><i class="fas fa-calendar"></i>@model.VisitingDate.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>

                        <div class="col-md-auto">
                            <div class="profile-v2-status-box">
                                <span>Guest Record</span>
                                <strong class="text-success">Editable</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <EditForm Model="model" OnValidSubmit="UpdateGuest">
                <DataAnnotationsValidator />

                <div class="bcc-card">
                    <div class="profile-form-v2-tabs">
                        <button type="button" class="@GetTabClass("personal")" @onclick='() => SetTab("personal")'>
                            <i class="fas fa-user"></i> Personal
                        </button>

                        <button type="button" class="@GetTabClass("contact")" @onclick='() => SetTab("contact")'>
                            <i class="fas fa-phone"></i> Contact
                        </button>

                        <button type="button" class="@GetTabClass("church")" @onclick='() => SetTab("church")'>
                            <i class="fas fa-church"></i> Church
                        </button>

                        <button type="button" class="@GetTabClass("service")" @onclick='() => SetTab("service")'>
                            <i class="fas fa-calendar-alt"></i> Service
                        </button>

                        <button type="button" class="@GetTabClass("review")" @onclick='() => SetTab("review")'>
                            <i class="fas fa-check-circle"></i> Review
                        </button>
                    </div>

                    <div class="bcc-card-body">

                        @if (activeTab == "personal")
                        {
                            <div class="profile-form-v2-section">
                                <h5><i class="fas fa-user"></i> Personal Information</h5>

                                <div class="row g-3">
                                    <BccFormField Label="Title" CurrentValue="@model.Title">
                                        <InputSelect @bind-Value="model.Title" class="form-select bcc-input">
                                            <option value="">Select Title</option>
                                            <option value="Mr">Mr</option>
                                            <option value="Mrs">Mrs</option>
                                            <option value="Miss">Miss</option>
                                            <option value="Dr">Dr</option>
                                            <option value="Pastor">Pastor</option>
                                            <option value="Rev">Rev</option>
                                            <option value="Prof">Prof</option>
                                            <option value="Engr">Engr</option>
                                        </InputSelect>
                                        <span class="text-danger small">@GetValidationMessage(nameof(model.Title))</span>
                                    </BccFormField>

                                    <BccFormField Label="First Name" CurrentValue="@model.FirstName">
                                        <InputText @bind-Value="model.FirstName" class="form-control bcc-input" />
                                        <span class="text-danger small">@GetValidationMessage(nameof(model.FirstName))</span>
                                    </BccFormField>

                                    <BccFormField Label="Middle Name" CurrentValue="@model.MiddleName">
                                        <InputText @bind-Value="model.MiddleName" class="form-control bcc-input" />
                                    </BccFormField>

                                    <BccFormField Label="Surname" CurrentValue="@model.Surname">
                                        <InputText @bind-Value="model.Surname" class="form-control bcc-input" />
                                        <span class="text-danger small">@GetValidationMessage(nameof(model.Surname))</span>
                                    </BccFormField>

                                    <BccFormField Label="Sex" CurrentValue="@model.Sex">
                                        <div class="d-flex gap-4">
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="sex"
                                                       checked="@(model.Sex == "Male")"
                                                       @onchange="@(() => model.Sex = "Male")" />
                                                <span class="form-check-label">Male</span>
                                            </label>

                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="sex"
                                                       checked="@(model.Sex == "Female")"
                                                       @onchange="@(() => model.Sex = "Female")" />
                                                <span class="form-check-label">Female</span>
                                            </label>
                                        </div>
                                        <span class="text-danger small">@GetValidationMessage(nameof(model.Sex))</span>
                                    </BccFormField>

                                    <BccFormField Label="Age Group" CurrentValue="@model.AgeGroup">
                                        <select class="form-select bcc-input" @bind="model.AgeGroup">
                                            <option value="">Select Age Group</option>
                                            <option value="below 30">Below 30</option>
                                            <option value="30-40">30-40</option>
                                            <option value="41-50">41-50</option>
                                            <option value="51-60">51-60</option>
                                            <option value="60 and above">60 and above</option>
                                        </select>
                                        <span class="text-danger small">@GetValidationMessage(nameof(model.AgeGroup))</span>
                                    </BccFormField>
                                </div>
                            </div>
                        }

                        @if (activeTab == "contact")
                        {
                            <div class="profile-form-v2-section">
                                <h5><i class="fas fa-address-book"></i> Contact Information</h5>

                                <div class="row g-3">
                                    <BccFormField Label="Phone Number" CurrentValue="@model.PhoneNumber">
                                        <input type="tel" class="form-control bcc-input" @bind="model.PhoneNumber" placeholder="080XXXXXXXX" />
                                        <span class="text-danger small">@phoneValidationMessage</span>
                                    </BccFormField>

                                    <BccFormField Label="WhatsApp Number" CurrentValue="@model.WhatsAppNumber">
                                        <input type="tel" class="form-control bcc-input" @bind="model.WhatsAppNumber" placeholder="080XXXXXXXX" />
                                    </BccFormField>

                                    <BccFormField Label="Email Address" CurrentValue="@model.Email">
                                        <input type="email" class="form-control bcc-input" @bind="model.Email" placeholder="email@example.com" />
                                        <span class="text-danger small">@emailValidationMessage</span>
                                    </BccFormField>

                                    <BccFormField Label="Landmark" CurrentValue="@model.Landmark">
                                        <input type="text" class="form-control bcc-input" @bind="model.Landmark" />
                                    </BccFormField>

                                    <BccFormField Label="Address" CurrentValue="@model.Address">
                                        <textarea class="form-control bcc-input" @bind="model.Address" rows="3"></textarea>
                                    </BccFormField>
                                </div>
                            </div>
                        }

                        @if (activeTab == "church")
                        {
                            <div class="profile-form-v2-section">
                                <h5><i class="fas fa-church"></i> Church Information</h5>

                                <div class="row g-3">
                                    <BccFormField Label="RCCG Member" CurrentValue="@(model.IsRCCGMember ? "Yes" : "No")">
                                        <div class="d-flex gap-4">
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="rccgMember"
                                                       checked="@(model.IsRCCGMember == true)"
                                                       @onchange="() => model.IsRCCGMember = true" />
                                                <span class="form-check-label">Yes</span>
                                            </label>

                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="rccgMember"
                                                       checked="@(model.IsRCCGMember == false)"
                                                       @onchange="() => model.IsRCCGMember = false" />
                                                <span class="form-check-label">No</span>
                                            </label>
                                        </div>
                                    </BccFormField>

                                    @if (!model.IsRCCGMember)
                                    {
                                        <BccFormField Label="Other Church" CurrentValue="@model.OtherChurch">
                                            <input type="text" class="form-control bcc-input" @bind="model.OtherChurch" />
                                        </BccFormField>
                                    }

                                    <BccFormField Label="How Found Us" CurrentValue="@model.HowFoundUs">
                                        <select class="form-select bcc-input" value="@model.HowFoundUs" @onchange="OnHowFoundUsChanged">
                                            <option value="">Select Option</option>
                                            <option value="Facebook">Facebook</option>
                                            <option value="Youtube">YouTube</option>
                                            <option value="Instagram">Instagram</option>
                                            <option value="X">X (Twitter)</option>
                                            <option value="looking around">Looking Around</option>
                                            <option value="invite">Invitation</option>
                                        </select>
                                        <span class="text-danger small">@GetValidationMessage(nameof(model.HowFoundUs))</span>
                                    </BccFormField>

                                    @if (model.HowFoundUs == "invite")
                                    {
                                        <BccFormField Label="Invited By" CurrentValue="@model.InvitedByName">
                                            <input type="text" class="form-control bcc-input" @bind="model.InvitedByName" />
                                        </BccFormField>
                                    }
                                </div>
                            </div>
                        }

                        @if (activeTab == "service")
                        {
                            <div class="profile-form-v2-section">
                                <h5><i class="fas fa-calendar-alt"></i> Service Information</h5>

                                <div class="row g-3">
                                    <BccFormField Label="Service Attended" CurrentValue="@GetServiceName(model.ServiceId)">
                                        <select class="form-select bcc-input" @bind="model.ServiceId">
                                            <option value="0">Select Service</option>
                                            @foreach (var service in services)
                                            {
                                                <option value="@service.Id">@service.Name</option>
                                            }
                                        </select>
                                        <span class="text-danger small">@GetValidationMessage(nameof(model.ServiceId))</span>
                                    </BccFormField>

                                    <BccFormField Label="Visiting Date" CurrentValue="@model.VisitingDate.ToString("dd MMM yyyy")">
                                        <input type="date"
                                               class="form-control bcc-input"
                                               @bind="model.VisitingDate"
                                               @bind:format="yyyy-MM-dd"
                                               max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                        <span class="text-danger small">@GetValidationMessage(nameof(model.VisitingDate))</span>
                                    </BccFormField>
                                </div>
                            </div>
                        }

                        @if (activeTab == "review")
                        {
                            <div class="profile-form-v2-section">
                                <h5><i class="fas fa-check-circle"></i> Review & Save</h5>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="profile-review-card">
                                            <h6>Guest</h6>
                                            <p><strong>Name:</strong> @model.Title @model.FirstName @model.MiddleName @model.Surname</p>
                                            <p><strong>Sex:</strong> @model.Sex</p>
                                            <p><strong>Age Group:</strong> @model.AgeGroup</p>
                                            <p><strong>Guest No:</strong> @currentGuestNumber</p>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="profile-review-card">
                                            <h6>Visit</h6>
                                            <p><strong>Service:</strong> @GetServiceName(model.ServiceId)</p>
                                            <p><strong>Date:</strong> @model.VisitingDate.ToString("dd MMM yyyy")</p>
                                            <p><strong>Phone:</strong> @model.PhoneNumber</p>
                                            <p><strong>How Found Us:</strong> @model.HowFoundUs</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="profile-form-v2-actions mt-4">
                                    <a href="/guest/daily-list" class="bcc-btn profile-form-secondary-btn">
                                        Cancel
                                    </a>

                                    <button type="submit" class="bcc-btn bcc-btn-primary" disabled="@isUpdating">
                                        @if (isUpdating)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                            <span>Updating...</span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-save me-2"></i>
                                            <span>Update Guest</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </EditForm>
        </div>
    }
}
else
{
    <div class="bcc-empty">
        <i class="fas fa-lock"></i>
        <h4>Please Log In</h4>
        <p>You need to be logged in to access this page.</p>
        <a href="/login" class="bcc-btn bcc-btn-primary">Go to Login</a>
    </div>
}

@if (showDeleteModal)
{
    <div class="team-modal-backdrop">
        <div class="team-modal-card">
            <button class="team-modal-close" @onclick="CancelDelete">
                <i class="fas fa-times"></i>
            </button>

            <div class="text-center">
                <div class="profile-v2-card-icon gold mx-auto mb-3">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>

                <h4>Confirm Delete</h4>
                <p>Are you sure you want to delete this guest record?</p>

                <div class="worker360-note text-start">
                    <strong>Guest:</strong> @currentGuestName<br />
                    <strong>Guest No:</strong> @currentGuestNumber
                </div>

                <div class="team-modal-actions mt-4">
                    <button class="team-action-btn" @onclick="CancelDelete">Cancel</button>

                    <button class="team-danger-btn" @onclick="ConfirmDelete" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Delete Guest
                    </button>
                </div>
            </div>
        </div>
    </div>
}
@code {
    [Parameter] public int Id { get; set; }

    private CreateGuestModel model = new();
    private List<Service> services = new();
    private bool isLoading = true;
    private bool isUpdating = false;
    private bool isDeleting = false;
    private bool guestNotFound = false;
    private string errorMessage = "";
    private string successMessage = "";
    private string phoneValidationMessage = "";
    private string emailValidationMessage = "";
    private bool showDeleteModal = false;

    private string currentGuestNumber = "";
    private string currentGuestName = "";

    private Dictionary<string, List<string>> validationErrors = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadServices();
            await LoadGuestForEdit();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error initializing page: {ex.Message}";
            isLoading = false;
        }
    }

    private async Task LoadServices()
    {
        try
        {
            services = await ServiceService.GetActiveServicesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading services: {ex.Message}";
        }
    }

    private async Task LoadGuestForEdit()
    {
        try
        {
            var guest = await GuestService.GetGuestByIdAsync(Id);
            if (guest == null)
            {
                guestNotFound = true;
                return;
            }

            currentGuestNumber = guest.GuestNumber;
            currentGuestName = $"{guest.FirstName} {guest.Surname}";

            var guestModel = await GuestService.GetGuestForEditAsync(Id);
            if (guestModel != null)
            {
                model = guestModel;
            }
            else
            {
                guestNotFound = true;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading guest: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool IsFIGDirectorateMember()
    {
        var worker = AuthService.CurrentWorker;
        if (worker == null) return false;

        var directorateName = worker.Directorate?.Name?.ToLowerInvariant() ?? "";
        var secondaryDirectorateName = worker.SecondaryDirectorate?.Name?.ToLowerInvariant() ?? "";
        var departmentName = worker.Department?.Name?.ToLowerInvariant() ?? "";
        var secondaryDepartmentName = worker.SecondaryDepartment?.Name?.ToLowerInvariant() ?? "";
        var role = worker.Role?.ToLowerInvariant() ?? "";

        var isPrimaryFIG = directorateName.Contains("fig");
        var isSecondaryFIG = secondaryDirectorateName.Contains("fig");

        var isMembershipAssimilation =
            departmentName.Contains("membership assimilation") ||
            secondaryDepartmentName.Contains("membership assimilation");

        var hasValidRole =
            role.Contains("head of directorate") ||
            role.Contains("asst head of directorate") ||
            role.Contains("directorate member") ||
            AuthService.IsInRole("Church Admin") ||
            AuthService.IsInRole("Pastor in Charge");

        return (isPrimaryFIG || isSecondaryFIG || isMembershipAssimilation) && hasValidRole;
    }
    private async Task UpdateGuest()
    {
        ClearValidationMessages();

        if (!ValidateModel())
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(model.PhoneNumber))
        {
            var isPhoneUnique = await GuestService.IsPhoneNumberUniqueAsync(model.PhoneNumber, Id);
            if (!isPhoneUnique)
            {
                phoneValidationMessage = "This phone number is already registered with another guest.";
                return;
            }
        }

        if (!string.IsNullOrWhiteSpace(model.Email))
        {
            var isEmailUnique = await GuestService.IsEmailUniqueAsync(model.Email, Id);
            if (!isEmailUnique)
            {
                emailValidationMessage = "This email address is already registered with another guest.";
                return;
            }
        }

        isUpdating = true;
        errorMessage = "";
        successMessage = "";

        try
        {
            var currentWorker = AuthService.CurrentWorker;
            var success = await GuestService.UpdateGuestAsync(Id, model, currentWorker);

            if (success)
            {
                // Redirect immediately to guest details page
                Navigation.NavigateTo($"/guest/details/{Id}");
            }
            else
            {
                errorMessage = "Failed to update guest. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating guest: {ex.Message}";
        }
        finally
        {
            isUpdating = false;
            StateHasChanged();
        }
    }

    private bool ValidateModel()
    {
        validationErrors.Clear();

        if (string.IsNullOrWhiteSpace(model.Title))
            AddValidationError(nameof(model.Title), "Title is required");

        if (string.IsNullOrWhiteSpace(model.FirstName))
            AddValidationError(nameof(model.FirstName), "First name is required");

        if (string.IsNullOrWhiteSpace(model.Surname))
            AddValidationError(nameof(model.Surname), "Surname is required");

        if (string.IsNullOrWhiteSpace(model.Sex))
            AddValidationError(nameof(model.Sex), "Sex is required");

        if (string.IsNullOrWhiteSpace(model.AgeGroup))
            AddValidationError(nameof(model.AgeGroup), "Age group is required");

        if (string.IsNullOrWhiteSpace(model.HowFoundUs))
            AddValidationError(nameof(model.HowFoundUs), "Please specify how you found us");

        if (model.ServiceId <= 0)
            AddValidationError(nameof(model.ServiceId), "Please select a service");

        if (model.VisitingDate > DateTime.Today)
            AddValidationError(nameof(model.VisitingDate), "Visiting date cannot be in the future");

        return !validationErrors.Any();
    }

    private void DeleteGuest()
    {
        showDeleteModal = true;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        isDeleting = true;
        try
        {
            var success = await GuestService.DeleteGuestAsync(Id);

            if (success)
            {
                showDeleteModal = false;
                Navigation.NavigateTo("/guest/daily-list");
            }
            else
            {
                errorMessage = "Failed to delete guest. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting guest: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
        StateHasChanged();
    }

    private void AddValidationError(string propertyName, string message)
    {
        if (!validationErrors.ContainsKey(propertyName))
            validationErrors[propertyName] = new List<string>();

        validationErrors[propertyName].Add(message);
    }

    private string GetValidationMessage(string propertyName)
    {
        if (validationErrors.ContainsKey(propertyName))
        {
            return string.Join("; ", validationErrors[propertyName]);
        }
        return "";
    }

    private void ClearValidationMessages()
    {
        validationErrors.Clear();
        phoneValidationMessage = "";
        emailValidationMessage = "";
        errorMessage = "";
    }

    private void ClearSuccessMessage()
    {
        successMessage = "";
        StateHasChanged();
    }

    private void ClearErrorMessage()
    {
        errorMessage = "";
        StateHasChanged();
    }

    private void OnHowFoundUsChanged(ChangeEventArgs e)
    {
        model.HowFoundUs = e.Value?.ToString() ?? "";
        if (model.HowFoundUs != "invite")
        {
            model.InvitedByName = "";
        }
        StateHasChanged();
    }
    private string activeTab = "personal";

    private void SetTab(string tab) => activeTab = tab;

    private string GetTabClass(string tab)
    {
        return activeTab == tab ? "profile-form-tab active" : "profile-form-tab";
    }

    private string GetInitials()
    {
        var first = string.IsNullOrWhiteSpace(model.FirstName) ? "" : model.FirstName[0].ToString();
        var last = string.IsNullOrWhiteSpace(model.Surname) ? "" : model.Surname[0].ToString();

        return $"{first}{last}".ToUpper();
    }

    private string GetServiceName(int serviceId)
    {
        var service = services.FirstOrDefault(s => s.Id == serviceId);
        return service?.Name ?? "Not selected";
    }
}

<style>
    /* Main Header */
    .main-header h2 {
        font-size: 1.6rem;
        font-weight: 700 !important;
        color: #2c3e50;
        margin-bottom: 0.25rem;
    }

    .guest-number-badge {
        font-size: 1.1rem;
        color: #17a2b8;
        font-weight: 700;
        background: rgba(23, 162, 184, 0.1);
        padding: 0.15rem 0.5rem;
        border-radius: 5px;
        margin-left: 0.5rem;
    }

    /* Compact Card Design */
    .card {
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 0;
    }

    /* Beautiful Color Highlights */
    .personal-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        padding: 0.6rem 1rem !important;
    }

    .contact-header {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%) !important;
        padding: 0.6rem 1rem !important;
    }

    .church-header {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%) !important;
        padding: 0.6rem 1rem !important;
