                                <a href="/admin/directorate-setup" class="bcc-nav-subitem @GetNavItemClass("/admin/directorate-setup")">
                                    <div class="bcc-nav-icon-container">
                                        <i class="fas fa-building"></i>
                                    </div>
                                    <span class="bcc-nav-text">Directorate Setup</span>
                                </a>

                                <a href="/admin/department-setup" class="bcc-nav-subitem @GetNavItemClass("/admin/department-setup")">
                                    <div class="bcc-nav-icon-container">
                                        <i class="fas fa-sitemap"></i>
                                    </div>
                                    <span class="bcc-nav-text">Department Setup</span>
                                </a>

                                <a href="/admin/role-setup" class="bcc-nav-subitem @GetNavItemClass("/admin/role-setup")">
                                    <div class="bcc-nav-icon-container">
                                        <i class="fas fa-user-tag"></i>
                                    </div>
                                    <span class="bcc-nav-text">Role Setup</span>
                                </a>

                                <a href="/admin/worker-cleanup" class="bcc-nav-subitem @GetNavItemClass("/admin/worker-cleanup")">
                                    <div class="bcc-nav-icon-container">
                                        <i class="fas fa-user-minus"></i>
                                    </div>
                                    <span class="bcc-nav-text">Remove Worker</span>
                                </a>
                                <a href="/admin/church-notices" class="bcc-nav-subitem @GetNavItemClass("/admin/church-notices")">
    <div class="bcc-nav-icon-container">
        <i class="fas fa-bullhorn"></i>
    </div>
    <span class="bcc-nav-text">Church Notices</span>
</a>
<a href="/admin/verse-of-the-day" class="bcc-nav-subitem @GetNavItemClass("/admin/verse-of-the-day")">
    <div class="bcc-nav-icon-container">
        <i class="fas fa-book-open"></i>
    </div>
    <span class="bcc-nav-text">Verse of the Day</span>
</a>
<a href="/admin/prayer-focus" class="bcc-nav-subitem @GetNavItemClass("/admin/prayer-focus")">
    <div class="bcc-nav-icon-container">
        <i class="fas fa-praying-hands"></i>
    </div>
    <span class="bcc-nav-text">Prayer Focus</span>
</a>
                            </div>
                        }
