@code {
    [Parameter]
    public bool IsVisible { get; set; }

    private bool canAccessBricks = false;
    private bool canAccessEventMenu = false;
    private bool showSetupMenu = false;
    private bool showWorkforceMenu = false;
    private bool showExcuseMenu = false;
    private bool showUsheringMenu = false;
    private bool showReportsMenu = false;
    private bool showGrowthHubMenu = false;

    private bool hasAuditorPrivilege = false;
    private int accountRemittancePendingCount = 0;
    private int pendingApprovalCount = 0;
    private int rejectionNotificationCount = 0;
    private int pendingExcuseCount = 0;
    private int pendingExcuseApprovals = 0;
    private int pendingBreakCount = 0;
    private int pendingBreakApprovals = 0;
    private int pendingOfferingCount = 0;
    private int rejectedOfferingsCount = 0;
    private bool showApprovalHubMenu = false;
    private int pendingApprovalInboxCount = 0;
    private int returnedRequestCount = 0;
    private int myDeskCount = 0;
    private bool isConfiguredClusterHead = false;

    private GrowthHubCounts growthHubCounts = new GrowthHubCounts();
    private ServiceRecordAccessModel serviceRecordAccess = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBricksAccessAsync();
        await LoadEventMenuAccessAsync();
        await LoadOrganizationalAccess();
        await LoadNotificationCounts();
        await LoadGrowthHubCounts();
        await LoadApprovalHubCounts();
        await LoadServiceRecordAccess();
        await LoadAuditorPrivilegeAsync();
        await LoadAccountRemittancePendingCountAsync();
    }

    private async Task LoadBricksAccessAsync()
    {
        canAccessBricks = false;
        var worker = AuthService.CurrentWorker;
        if (worker == null) return;
        try
        {
            canAccessBricks = AuthService.IsInRole("Pastor in Charge") || await BricksPrivileges.CanAccessAsync(worker.Id);
        }
        catch (Exception ex) { Console.WriteLine($"BRICKS access check failed: {ex.Message}"); }
    }

    private async Task LoadEventMenuAccessAsync()
    {
        canAccessEventMenu = false;
        var worker = AuthService.CurrentWorker;
        if (!AuthService.IsAuthenticated || worker == null)
            return;

        try
        {
            canAccessEventMenu =
                await PrivilegeService.HasPrivilegeAsync(worker.Id, "Access-Event-Management") ||
                await PrivilegeService.HasPrivilegeAsync(worker.Id, "Event-Assisted-CheckIn");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading Event Mgt menu access: {ex.Message}");
            canAccessEventMenu = false;
        }
    }

    private async Task LoadOrganizationalAccess()
    {
        isConfiguredClusterHead = false;

        if (!AuthService.IsAuthenticated ||
            AuthService.CurrentWorker == null)
        {
            return;
        }

        try
        {
            var organizationalAccessService =
                ScopedServices.GetRequiredService<OrganizationalAccessService>();

            isConfiguredClusterHead =
                await organizationalAccessService.IsClusterHeadAsync(
                    AuthService.CurrentWorker.Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error loading organizational access: {ex.Message}");

            isConfiguredClusterHead = false;
        }
    }
    private bool CanAccessWorkerManagementWorkspace()
    {
        if (!AuthService.IsAuthenticated ||
            AuthService.CurrentWorker == null)
        {
            return false;
        }

        if (AuthService.IsInRole("Church Admin") ||
            AuthService.IsInRole("Pastor in Charge"))
        {
            return true;
        }

        var currentWorker =
            AuthService.CurrentWorker;

        var isMeatDirectorate =
            string.Equals(
                currentWorker.Directorate?.Code,
                "MEAT",
                StringComparison.OrdinalIgnoreCase) ||
            string.Equals(
                currentWorker.Directorate?.Name,
                "MEAT",
                StringComparison.OrdinalIgnoreCase);

        var isMeatLeadership =
            AuthService.IsInRole("Head of Directorate") ||
            AuthService.IsInRole("Asst Head of Directorate") ||
            AuthService.IsInRole("Assistant Head of Directorate");

        return
            isMeatDirectorate &&
            isMeatLeadership;
    }

    private bool CanAccessSetupWorkspace()
    {
        if (!AuthService.IsAuthenticated)
            return false;

        return
            AuthService.IsInRole("Church Admin") ||
            AuthService.IsInRole("Pastor in Charge");
    }
    private async Task LoadServiceRecordAccess()
    {
        if (AuthService.IsAuthenticated &&
            AuthService.CurrentWorker != null)
        {
            try
            {
                serviceRecordAccess =
                    await ServiceRecordAccessService.GetAccessAsync(AuthService.CurrentWorker.Id);
            }
            catch (Exception ex)
            {
                Console.WriteLine(
                    $"Error loading Service Records access: {ex.Message}");

                serviceRecordAccess =
                    new ServiceRecordAccessModel();
            }
        }
        else
        {
            serviceRecordAccess =
                new ServiceRecordAccessModel();
        }
    }
    private async Task LoadApprovalHubCounts()
    {
        if (AuthService.IsAuthenticated && AuthService.CurrentWorker != null)
        {
            try
            {
                pendingApprovalInboxCount =
                    await ApprovalRequestService.GetPendingApprovalCountAsync(AuthService.CurrentWorker.Id);

                returnedRequestCount =
                    await ApprovalRequestService.GetReturnedRequestCountAsync(AuthService.CurrentWorker.Id);

                myDeskCount = pendingApprovalInboxCount + returnedRequestCount;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading approval hub counts: {ex.Message}");
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadOfferingCounts();
        }
    }
    private void ToggleApprovalHubMenu()
    {
        showApprovalHubMenu = !showApprovalHubMenu;
    }
    private bool CanViewGrowthReports()
    {
        return AuthService.IsInRole("Pastor in Charge") ||
               AuthService.IsInRole("Head of Service") ||
               AuthService.IsInRole("Church Admin") ||
               AuthService.CanAccessAdminPanel();
    }

    private bool CanApprovePermissionRequests()
    {
        var worker = AuthService.CurrentWorker;
        if (worker == null) return false;

        var role = worker.Role?.ToLowerInvariant() ?? "";

        return role.Contains("head of directorate") ||
               role.Contains("head of service") ||
               role.Contains("pastor in charge") ||
               role.Contains("senior pastor") ||
               AuthService.IsInRole("Church Admin") ||
               AuthService.CanAccessAdminPanel();
    }

    private bool CanAccessServiceNotes()
    {
        var worker = AuthService.CurrentWorker;
        if (worker == null) return false;

        var role = worker.Role?.ToLowerInvariant() ?? "";

        var isHeadOfDirectorate = role.Contains("head of directorate");

        var isAssistantHeadOfDirectorate =
            role.Contains("asst head of directorate") ||
            role.Contains("assistant head of directorate");

        var isPastorInCharge = role.Contains("pastor in charge");

        return isHeadOfDirectorate || isAssistantHeadOfDirectorate || isPastorInCharge;
    }

    private bool CanAccessServiceRecords()
    {
        var worker = AuthService.CurrentWorker;
        if (worker == null) return false;

        var role = worker.Role?.ToLowerInvariant() ?? "";

        var hasRoleAccess = role.Contains("pastor in charge") ||
                            role.Contains("senior pastor") ||
                            AuthService.IsInRole("Church Admin");

        var isFIGDirectorateMember = IsFIGDirectorateMember();
        var isHeadOfService = role.Contains("head of service");
        var canAccessServiceNotes = CanAccessServiceNotes();

        return hasRoleAccess || isFIGDirectorateMember || isHeadOfService || canAccessServiceNotes;
    }

    private bool CanRecordOfferings()
    {
        return CanAccessServiceRecords();
    }

    private bool CanApproveOfferings()
    {
        return AuthService.IsInRole("Church Admin") ||
               AuthService.IsInRole("Pastor in Charge");
    }

    private bool CanAccessOfferingSetup()
    {
        return AuthService.IsInRole("Church Admin") ||
               AuthService.IsInRole("Pastor in Charge");
    }

    private bool IsFIGDirectorateMember()
    {
        var worker = AuthService.CurrentWorker;
        if (worker == null) return false;

        var directorateName = worker.Directorate?.Name?.ToLowerInvariant() ?? "";
        var SecondaryDepartmentName = worker.SecondaryDepartment?.Name?.ToLowerInvariant() ?? "";

        return directorateName.Contains("fig") || SecondaryDepartmentName.Contains("membership assimilation");
    }

    private bool IsUsheringDepartment()
    {
        var worker = AuthService.CurrentWorker;
        if (worker?.Department == null)
        {
            return false;
        }

        var deptName = worker.Department.Name?.ToLowerInvariant() ?? "";

        return deptName.Contains("ushering") ||
               deptName.Contains("ushers") ||
               deptName.Contains("greeters") ||
               deptName.Contains("MAT") ||
               deptName.Contains("hospitality");
    }

    private bool CanAccessBudget()
    {
        return AuthService.IsInRole("Pastor in Charge") ||
               AuthService.IsInRole("Church Admin") ||
               AuthService.CanAccessAdminPanel() ||
               AuthService.IsInRole("Head of Service") ||
               AuthService.IsInRole("Head of Directorate");
    }

    private bool CanAccessRemittance()
    {
        return AuthService.IsInRole("Pastor in Charge") ||
               AuthService.IsInRole("Church Admin") ||
               hasAuditorPrivilege;
    }

    private async Task LoadAuditorPrivilegeAsync()
    {
        hasAuditorPrivilege = false;
        var worker = AuthService.CurrentWorker;
        if (!AuthService.IsAuthenticated || worker == null)
            return;
        try
        {
            hasAuditorPrivilege = await PrivilegeService.HasPrivilegeAsync(
                worker.Id, PrivilegeService.ApproveChurchExpenditure);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading Auditor privilege: {ex.Message}");
        }
    }

    #region Account and Remittance Badge

    private async Task LoadAccountRemittancePendingCountAsync()
    {
        accountRemittancePendingCount = 0;

        if (!AuthService.IsAuthenticated ||
            AuthService.CurrentWorker == null ||
            !CanAccessRemittance())
        {
            return;
        }

        try
        {
            using var scope = ScopedServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            if (AuthService.IsInRole(AuthService.Roles.PastorInCharge))
            {
                accountRemittancePendingCount = await db.BankAccountJournals
                    .AsNoTracking()
                    .CountAsync(entry =>
                        entry.Status == BankJournalStatus.PendingApproval);
            }
            else if (AuthService.IsInRole(AuthService.Roles.ChurchAdmin))
            {
                var workerId = AuthService.CurrentWorker.WorkerId;

                var returnedEntries = await db.BankAccountJournals
                    .AsNoTracking()
                    .CountAsync(entry =>
                        entry.InitiatedByWorkerId == workerId &&
                        (entry.Status == BankJournalStatus.Returned ||
                         entry.Status == BankJournalStatus.Rejected));

                var approvedCollectionsAwaitingPosting = await db.ChurchCollectionRecords
                    .AsNoTracking()
                    .CountAsync(collection =>
                        collection.Status == ChurchCollectionService.StatusApproved &&
                        !collection.IsRemoved &&
                        !db.BankAccountJournals.Any(entry =>
                            entry.SourceCollectionId == collection.Id));

                var accountsAwaitingOpeningBalance = await db.BankAccounts
                    .AsNoTracking()
                    .CountAsync(account =>
                        account.IsActive && !account.IsOpeningBalanceLocked);

                accountRemittancePendingCount = returnedEntries +
                    approvedCollectionsAwaitingPosting +
                    accountsAwaitingOpeningBalance;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading Account & Remittance badge: {ex.Message}");
        }
    }

    #endregion

    private async Task LoadNotificationCounts()
    {
        if (AuthService.IsAuthenticated && AuthService.CurrentWorker != null)
        {
            try
            {
                var workforceService = ScopedServices.GetRequiredService<WorkforceService>();
                var excuseService = ScopedServices.GetRequiredService<ExcuseService>();

                var pendingRequests = await workforceService.GetPendingApprovalsAsync(AuthService.CurrentWorker.Id);
                pendingApprovalCount = pendingRequests.Count;

                var rejectionNotifications = await workforceService.GetRejectionNotificationsAsync(AuthService.CurrentWorker.Id);
                rejectionNotificationCount = rejectionNotifications.Count;

                var myExcuses = await excuseService.GetMyExcuseRequestsAsync(AuthService.CurrentWorker.Id);
                pendingExcuseCount = myExcuses.Count(e => e.RequestStatus == "Pending");

                var myBreakRequests = await excuseService.GetMyBreakRequestsAsync(AuthService.CurrentWorker.Id);
                pendingBreakCount = myBreakRequests.Count(b => b.RequestStatus == "Pending");

                if (CanApprovePermissionRequests())
                {
                    var pendingExcuseRequests = await excuseService.GetPendingApprovalsAsync(AuthService.CurrentWorker.Id);
                    pendingExcuseApprovals = pendingExcuseRequests.Count;

                    var pendingBreakRequests = await excuseService.GetPendingBreakApprovalsAsync(AuthService.CurrentWorker.Id);
                    pendingBreakApprovals = pendingBreakRequests.Count;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading notification counts: {ex.Message}");
            }
        }
    }

    private async Task LoadGrowthHubCounts()
    {
        if (AuthService.IsAuthenticated && AuthService.CurrentWorker != null)
        {
            try
            {
                var accountabilityService = ScopedServices.GetRequiredService<AccountabilityService>();
                growthHubCounts = await accountabilityService.GetGrowthHubCountsAsync(AuthService.CurrentWorker.Id);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading growth hub counts: {ex.Message}");
            }
        }
    }

    private async Task LoadOfferingCounts()
    {
        try
        {
            if (AuthService.IsAuthenticated && AuthService.CurrentWorker != null)
            {
                var currentWorkerId = AuthService.CurrentWorker.WorkerId;

                if (CanApproveOfferings())
                {
                    var pendingOfferings = await OfferingService.GetPendingOfferingsAsync();
                    pendingOfferingCount = pendingOfferings.Count;
                }

                var rejectedOfferings = await OfferingService.GetRejectedOfferingsByUserAsync(currentWorkerId);
                rejectedOfferingsCount = rejectedOfferings.Count;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading offering counts: {ex.Message}");
        }

        StateHasChanged();
    }

    private string GetNavItemClass(string currentUri)
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri);
        return uri.Equals(currentUri.TrimStart('/'), StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";
    }

