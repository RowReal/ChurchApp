@using ChurchApp.Services
@using ChurchApp.Services.Bricks
@using ChurchApp.Models
@using ChurchApp.Data
@using ChurchApp.Models.Finance
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IServiceProvider ScopedServices
@inject OfferingService OfferingService
@inject AttendanceService AttendanceService
@inject ApprovalRequestService ApprovalRequestService
@inject ServiceRecordAccessService ServiceRecordAccessService
@inject PrivilegeService PrivilegeService
@inject BricksPrivilegeService BricksPrivileges

@if (AuthService.IsAuthenticated)
{
    <div class="bcc-sidebar @(IsVisible ? "show" : "")">
        <div class="bcc-sidebar-content">
            <nav class="bcc-nav-menu">

                <a href="/" class="bcc-nav-item @GetNavItemClass("/")">
                    <span class="bcc-nav-text">Dashboard</span>
                </a>

                <!-- MY PROFILE -->
                <div class="bcc-nav-section">
                    <a href="/workforce/my-profile"
                       class="bcc-nav-item @GetNavItemClass("/workforce/my-profile")">

                        <span class="bcc-nav-text">My Profile</span>
                    </a>
                </div>

                @if (CanAccessMyTeam())
                {
                    <div class="bcc-nav-section">
                        <a href="/workforce/my-team"
                           class="bcc-nav-item @GetNavItemClass("/workforce/my-team")">

                            <span class="bcc-nav-text">My Team</span>
                        </a>
                    </div>
                }

                @* My Approval Hub *@

                <!-- PROFILE APPROVAL -->
                <!-- PROFILE APPROVAL -->
                @if (CanAccessProfileApproval())
                {
                    <div class="bcc-nav-section">
                        <a href="/workforce/my-inbox"
                           class="bcc-nav-item @GetNavItemClass("/workforce/my-inbox")">

                            <span class="bcc-nav-text">
                                Profile Approval
                            </span>

                            @if (pendingApprovalCount > 0)
                            {
                                <span class="bcc-nav-badge">
                                    @pendingApprovalCount
                                </span>
                            }
                        </a>
                    </div>
                }
                <!-- MY TEAM -->
                <!-- APPROVAL REQUEST -->
                <div class="bcc-nav-section">
                    <a href="/workspace/my-desk"
                       class="bcc-nav-item @GetNavItemClass("/workspace/my-desk")">

                        <span class="bcc-nav-text">
                            Approval Request
                        </span>

                        @if (myDeskCount > 0)
                        {
                            <span class="bcc-nav-badge">
                                @myDeskCount
                            </span>
                        }
                    </a>
                </div>

                <div class="bcc-nav-section">
                    <div class="bcc-nav-section-header" @onclick="ToggleGrowthHubMenu">
                        <span class="bcc-nav-text">Growth Hub</span>

                        @if (growthHubCounts.Total > 0)
                        {
                            <span class="bcc-nav-badge">@growthHubCounts.Total</span>
                        }

                        <span class="bcc-menu-arrow @(showGrowthHubMenu ? "open" : "")"></span>
                    </div>

                    @if (showGrowthHubMenu)
                    {
                        <div class="bcc-nav-submenu">
                            <a href="/Workforce/feedback" class="bcc-nav-subitem @GetNavItemClass("/Workforce/feedback")">
                                <span class="bcc-nav-text">Feedback Report</span>
                                @if (growthHubCounts.MyFeedback > 0)
                                {
                                    <span class="bcc-nav-badge">@growthHubCounts.MyFeedback</span>
                                }
                            </a>

                            <a href="/Workforce/assigned" class="bcc-nav-subitem @GetNavItemClass("/Workforce/assigned")">
                                <span class="bcc-nav-text">My Feedback</span>
                                @if (growthHubCounts.AssignedToMe > 0)
                                {
                                    <span class="bcc-nav-badge">@growthHubCounts.AssignedToMe</span>
                                }
                            </a>

                            <a href="/Workforce/create-feedback" class="bcc-nav-subitem @GetNavItemClass("/Workforce/create-feedback")">
                                <span class="bcc-nav-text">Create Feedback</span>
                            </a>

                            @if (CanViewGrowthReports())
                            {
                                <a href="/Workforce/reports" class="bcc-nav-subitem @GetNavItemClass("/Workforce/reports")">
                                    <span class="bcc-nav-text">Growth Reports</span>
                                </a>
                            }
                        </div>
                    }
                </div>



                @if (serviceRecordAccess.HasAnyAccess)
                {
                    var pendingCount =
                    serviceRecordAccess.PendingOfferingApprovalCount +
                    serviceRecordAccess.PendingOfferingAmendmentCount;

                    <a href="/workspace/service-records"
                       class="bcc-nav-item @GetNavItemClass("/workspace/service-records")">

                        <span class="bcc-nav-text">
                            Service Records
                        </span>

                        @if (pendingCount > 0)
                        {
                            <span class="bcc-nav-badge">
                                @pendingCount
                            </span>
                        }
                    </a>
                }
                <div class="bcc-nav-section">
                    <a href="/workspace/reports"
                       class="bcc-nav-section-header @GetNavItemClass("/workspace/reports")">

                        <span class="bcc-nav-text">Reports</span>
                    </a>
                </div>
                @if (CanAccessBudget())
                {
                    <a href="/budget" class="bcc-nav-item @GetNavItemClass("/budget")">
                        <span class="bcc-nav-text">Church Budget</span>
                    </a>
                }

                @if (CanAccessRemittance())
                {
                    <a href="/workspace/account-remittance" class="bcc-nav-item @GetNavItemClass("/workspace/account-remittance")">
                        <span class="bcc-nav-text">Account &amp; Remittance</span>
                        @if (accountRemittancePendingCount > 0)
                        {
                            <span class="bcc-nav-badge" title="Account &amp; Remittance entries requiring your attention">
                                @accountRemittancePendingCount
                            </span>
                        }
                    </a>
                }

                @if (canAccessEventMenu)
                {
                    <div class="bcc-nav-section">
                        <a href="/workspace/event-hub"
                           class="bcc-nav-item @GetNavItemClass("/workspace/event-hub")">
                            <span class="bcc-nav-text">Event Mgt</span>
                        </a>
                    </div>
                }

                @if (CanAccessWorkerManagementWorkspace())
                {
                    <div class="bcc-nav-section">
                        <a href="/workspace/worker-management"
                           class="bcc-nav-item @GetNavItemClass("/workspace/worker-management")">

                            <span class="bcc-nav-text">
                                Worker Management
                            </span>
                        </a>
                    </div>
                }

                @if (canAccessBricks)
                {
                    <div class="bcc-nav-section">
                        <a href="/workspace/bricks" class="bcc-nav-item @GetNavItemClass("/workspace/bricks")">
                            <span class="bcc-nav-text">BRICKS</span>
                        </a>
                    </div>
                }

                @if (CanAccessSetupWorkspace())
                {
                    <div class="bcc-nav-section">
                        <a href="/workspace/setup"
                           class="bcc-nav-item @GetNavItemClass("/workspace/setup")">

                            <span class="bcc-nav-text">
                                Setup
                            </span>
                        </a>
                    </div>
                }
            </nav>
        </div>
    </div>
}

