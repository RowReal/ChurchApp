@inherits LayoutComponentBase
@using ChurchApp.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="bccv2-shell">

    <header class="bccv2-topbar">
        <div class="bccv2-brand">
            <div class="bccv2-logo-box">
                <img src="/images/bcc-logo.png" alt="BCC Logo" class="bccv2-logo" />
            </div>

            <div class="bccv2-brand-text">
                <strong>BCC ServiceHub</strong>
               <span>Church Workforce Management</span>
            </div>
        </div>

        <div class="bccv2-actions">
            @if (AuthService.IsAuthenticated)
            {
                <div class="bccv2-user">
                    <div class="bccv2-avatar">
                        @if (!string.IsNullOrWhiteSpace(AuthService.CurrentWorker?.PassportPhotoPath))
                        {
                            <img src="@GetPassportPhotoUrl(AuthService.CurrentWorker.PassportPhotoPath)"
                                 alt="@($"{AuthService.CurrentWorker?.FirstName} {AuthService.CurrentWorker?.LastName}")"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <span class="bccv2-avatar-initials" style="display:none;">@GetWorkerInitials()</span>
                        }
                        else
                        {
                            <span class="bccv2-avatar-initials">@GetWorkerInitials()</span>
                        }
                    </div>

                    <div class="bccv2-user-text">
                        <strong>@AuthService.CurrentWorker?.FirstName @AuthService.CurrentWorker?.LastName</strong>
                        <span>@AuthService.CurrentWorker?.Role</span>
                    </div>
                </div>

                <button class="bccv2-btn" @onclick="SignOut">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Sign Out</span>
                </button>

                <button type="button" class="bccv2-menu-btn" @onclick="ToggleSidebar">
                    <i class="fas fa-bars"></i>
                </button>
            }
            else
            {
                <a href="/login" class="bccv2-btn bccv2-login-btn">
    <i class="fas fa-right-to-bracket"></i>
    <span>Worker Login</span>
</a>
            }
        </div>
    </header>

    <div class="bccv2-body">
        @if (AuthService.IsAuthenticated)
        {
            <Sidebar IsVisible="@isSidebarVisible" />
        }

        <main class="bccv2-content @(!AuthService.IsAuthenticated ? "bccv2-content-full" : "")">
            @Body
        </main>
    </div>

    @if (AuthService.IsAuthenticated && isSidebarVisible)
    {
        <div class="bccv2-backdrop" @onclick="ToggleSidebar"></div>
    }
</div>

@code {
    private bool isSidebarVisible = false;

    private async Task ToggleSidebar()
    {
        isSidebarVisible = !isSidebarVisible;
        await InvokeAsync(StateHasChanged);
    }

    private string GetPassportPhotoUrl(string? photoPath)
    {
        if (string.IsNullOrWhiteSpace(photoPath))
            return string.Empty;

        var path = photoPath.Trim().Replace("\\", "/");

        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        if (path.StartsWith("/"))
            return path;

        if (path.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase))
            return "/" + path;

        return "/uploads/" + path;
    }

    private string GetWorkerInitials()
    {
        var first = AuthService.CurrentWorker?.FirstName?.Trim();
        var last = AuthService.CurrentWorker?.LastName?.Trim();

        var firstInitial = string.IsNullOrWhiteSpace(first) ? string.Empty : first[0].ToString();
        var lastInitial = string.IsNullOrWhiteSpace(last) ? string.Empty : last[0].ToString();
        var initials = (firstInitial + lastInitial).ToUpperInvariant();

        return string.IsNullOrWhiteSpace(initials) ? "U" : initials;
    }

    private void SignOut()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}

